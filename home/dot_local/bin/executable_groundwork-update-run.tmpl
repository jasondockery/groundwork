#!/usr/bin/env bash
set -euo pipefail

# The post-sync half of update-all. The launcher pulls the source
# (`chezmoi update --apply=false`, then one `chezmoi init`), preflights drift, installs and
# verifies this runner plus its lock library, then execs it — so every stage
# below, including the full `chezmoi apply` and its install hooks, runs the
# implementation the sync just delivered. Stages guard on `command -v`, so the
# same file works on macOS, Linux, and WSL2 whether or not a given manager is
# installed. Run update-all, not this file, for a refresh that includes the
# sync.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

usage() {
  cat <<'EOF'
Complete the post-sync half of update-all.

Usage:
  groundwork-update-run                    apply and refresh with maintenance
  groundwork-update-run --skip-maintenance apply and refresh without routine maintenance
  groundwork-update-run --allow-app-quit   permit Homebrew to quit running apps
                                            selected for cask replacement
  groundwork-update-run -h|--help          show this help

Run update-all for the normal full transaction. This runner is directly
invocable for repair and testing, so it validates the same arguments before
chezmoi apply or any update or maintenance operation. On macOS, a successful
transaction may offer a temporary, restored start of the selected Docker
backend for scratch maintenance, then ends with the same consent-gated
Karabiner health postflight. Without a terminal, neither service is restarted.
The final receipt classifies no-change, maintenance, review, warning, failure,
and pending-repair outcomes; raw Homebrew streams remain in Groundwork state.
Running applications are deferred by default. --allow-app-quit permits
Homebrew's normal quit-and-replace behavior for this invocation only.
EOF
}

skip_maintenance=0
allow_app_quit=0
while (($#)); do
  case "$1" in
    --skip-maintenance) skip_maintenance=1 ;;
    --allow-app-quit) allow_app_quit=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "groundwork-update-run: unknown option: $1" >&2
      echo "Run 'groundwork-update-run --help' for usage." >&2
      exit 64
      ;;
    *)
      echo "groundwork-update-run: unexpected argument: $1 (this command takes no positional arguments)" >&2
      exit 64
      ;;
  esac
  shift
done

# Preserve only an invocation that began with real interactive stdin and
# stderr. Earlier bounded updater stages may temporarily detach fd 0; keeping
# these exact descriptors lets later authorization and consent stay attached
# to the caller without falling back to /dev/tty for redirected or automated
# runs.
groundwork_interactive_tty_available=0
if [[ -t 0 && -t 2 ]]; then
  exec 6>&2 7<&0
  groundwork_interactive_tty_available=1
fi

applications_dir=""
{{- if eq .chezmoi.os "darwin" }}
mas_app_deadline="${GROUNDWORK_MAS_APP_DEADLINE_SECONDS:-1800}"
mas_auth_deadline="${GROUNDWORK_MAS_AUTH_DEADLINE_SECONDS:-120}"
mas_observe_deadline="${GROUNDWORK_MAS_OBSERVE_DEADLINE_SECONDS:-30}"
mas_auth_kill_grace="${GROUNDWORK_TEST_MAS_AUTH_KILL_GRACE_SECONDS:-1}"
applications_dir="${GROUNDWORK_APPLICATIONS_DIR:-/Applications}"
if [[ ! "$applications_dir" =~ ^/[^[:cntrl:]]+$ \
  || "$applications_dir" == */../* || "$applications_dir" == */.. \
  || "$applications_dir" == *//* || -L "$applications_dir" ]]; then
  echo "groundwork-update-run: the applications directory is unsafe: $applications_dir" >&2
  exit 64
fi
for mas_bound in "$mas_app_deadline" "$mas_auth_deadline" "$mas_observe_deadline"; do
  if [[ ! "$mas_bound" =~ ^[1-9][0-9]*$ ]]; then
    echo "groundwork-update-run: Mac App Store deadlines must be positive integers" >&2
    exit 64
  fi
done
[[ "$mas_auth_kill_grace" =~ ^(0|[1-9][0-9]*)([.][0-9]+)?$ ]] || {
  echo "groundwork-update-run: invalid test-only Mac App Store authorization grace: $mas_auth_kill_grace" >&2
  exit 64
}
{{- end }}

# Fail closed before any bootstrap apply or package stage: the support contract
# is macOS, native Linux, and WSL2 — never WSL1 or an unverifiable WSL
# environment. Existing v1.9 installations already have this detector even
# though they do not yet have the lock library introduced after v1.9.
if [[ ! -x "$HOME/.local/bin/groundwork-platform" ]]; then
  echo "Groundwork: the platform helper is missing: $HOME/.local/bin/groundwork-platform" >&2
  echo "Restore it from the source you already have (this cannot fetch an upstream fix):" >&2
  echo "  chezmoi apply --exclude=scripts ~/.local/bin/groundwork-platform" >&2
  exit 1
fi
platform="$("$HOME/.local/bin/groundwork-platform" 2>/dev/null || echo unknown)"
case "$platform" in
  darwin | linux | wsl2) ;;
  wsl1)
    echo "Groundwork requires WSL2; WSL1 is unsupported. From PowerShell: \`wsl --list --verbose\` to check versions, \`wsl --set-version <DistributionName> 2\` to convert." >&2
    exit 1
    ;;
  wsl-unknown)
    echo "Groundwork detected WSL but could not verify WSL2. From PowerShell, run \`wsl --list --verbose\`; convert with \`wsl --set-version <DistributionName> 2\` if needed." >&2
    exit 1
    ;;
  *)
    echo "Groundwork does not support this platform: $platform" >&2
    exit 1
    ;;
esac

# Direct runner invocations acquire the same lock as update-all. When the
# launcher execs this file, the inherited token proves the transaction is
# already locked. A v1.9 launcher installs only this freshly synchronized
# runner before exec, so restore the one new lock dependency narrowly when it
# is absent. Targeted apply excludes scripts and cannot run install hooks.
lock_lib="$HOME/.local/lib/groundwork/update-lock.sh"
if [[ ! -r "$lock_lib" ]]; then
  command -v chezmoi >/dev/null 2>&1 || {
    echo "Groundwork: cannot restore the update lock helper because chezmoi is unavailable." >&2
    exit 1
  }
  chezmoi apply --exclude=scripts "$lock_lib"
  if ! chezmoi verify "$lock_lib"; then
    echo "Groundwork: the restored update lock helper does not match the synchronized source." >&2
    echo "Refusing to continue. Review it with: chezmoi diff ~/.local/lib/groundwork/update-lock.sh" >&2
    exit 1
  fi
  if [[ ! -r "$lock_lib" ]]; then
    echo "Groundwork: chezmoi finished, but the update lock helper is still missing: $lock_lib" >&2
    exit 1
  fi
fi
# shellcheck source=/dev/null
source "$lock_lib"
groundwork_lock_acquire "groundwork-update-run" || exit $?
runner_temp=""
runner_temp_final=""
runner_receipt_dir=""
maintenance_receipt_work=""
maintenance_receipt_published=0
docker_backend_restore_required=0
runner_exit() {
  local status=$? restore_status=0
  trap - EXIT
  # An INT/TERM/HUP trap exits this shell directly, which skips the sweep inside
  # the attached Homebrew stage. Close any stage still live BEFORE restoring the
  # terminal, so the transaction never ends with brew, sudo, or an installer
  # still running against a pane nobody holds.
  local stage_cleanup_status=0
  if declare -F gw_brew_cleanup_active_stage >/dev/null 2>&1; then
    gw_brew_cleanup_active_stage || stage_cleanup_status=$?
    if [[ "$stage_cleanup_status" -ne 0 ]]; then
      # Outranks whatever set the status, including a signal. "Cancelled" and
      # "cancelled but Homebrew may still be running" are different outcomes,
      # and only the second one needs someone to look.
      echo "Groundwork: could not confirm the interrupted Homebrew stage stopped (exit $stage_cleanup_status)." >&2
      status="$stage_cleanup_status"
    fi
  fi
  # The Homebrew stage hands the caller's terminal to script(1), which disables
  # signal generation on it. Whatever stage this transaction died in, give the
  # pane back in the mode it was lent in — an unusable terminal is worse than a
  # failed update, because it takes away the means to react to one. A refresh
  # that could not give the terminal back has not fully succeeded, so an
  # otherwise clean run is downgraded rather than reported as success.
  local tty_restore_status=0
  if declare -F gw_brew_tty_restore >/dev/null 2>&1; then
    gw_brew_tty_restore || tty_restore_status=$?
    if [[ "$tty_restore_status" -ne 0 ]]; then
      echo "Groundwork: this terminal was not restored to its original mode (exit $tty_restore_status)." >&2
      echo "Run 'stty sane' in this pane to recover it." >&2
      status="$tty_restore_status"
    fi
  fi
  if [[ "$docker_backend_restore_required" -eq 1 ]] \
    && declare -F restore_docker_backend >/dev/null 2>&1; then
    restore_docker_backend || restore_status=$?
    if [[ "$restore_status" -ne 0 ]]; then
      echo "Groundwork: could not restore the Docker backend's original stopped state (exit $restore_status)." >&2
      [[ "$status" -ne 0 ]] || status=1
    fi
  fi
  if declare -F publish_maintenance_receipt >/dev/null 2>&1; then
    publish_maintenance_receipt "$status" || {
      echo "Groundwork: the durable maintenance receipt could not be published." >&2
      [[ "$status" -ne 0 ]] || status=1
    }
  fi
  groundwork_lock_release || true
  if [[ -n "$runner_temp" ]]; then
    if [[ -n "$runner_temp_final" ]]; then
      mv -f -- "$runner_temp" "$runner_temp_final" 2>/dev/null || true
    else
      rm -f -- "$runner_temp" || true
    fi
  fi
  if [[ -n "$runner_receipt_dir" ]]; then
    rm -f -- "$runner_receipt_dir/homebrew-bundle.tsv" \
      "$runner_receipt_dir/homebrew-upgrade.tsv" \
      "$runner_receipt_dir/package-maintenance.tsv" \
      "$runner_receipt_dir/maintenance.tsv" \
      "$runner_receipt_dir/actions.tsv" 2>/dev/null || true
    rm -f -- "$runner_receipt_dir"/homebrew-cask-* 2>/dev/null || true
    rm -f -- "$runner_receipt_dir"/action-casks* 2>/dev/null || true
    rm -f -- "$runner_receipt_dir"/homebrew-formula-* \
      "$runner_receipt_dir"/homebrew-pinned \
      "$runner_receipt_dir"/mas-* 2>/dev/null || true
    rmdir "$runner_receipt_dir" 2>/dev/null || true
  fi
  exit "$status"
}
trap runner_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# The update-all launcher decides color once for the whole run and exports
# GROUNDWORK_COLOR before the sync, so every stage and hook script inherits
# it. Recompute only when invoked directly (same rules: NO_COLOR off,
# FORCE_COLOR on, else a real terminal on stdout).
if [[ -z "${GROUNDWORK_COLOR:-}" ]]; then
  if [[ -n "${NO_COLOR:-}" ]]; then
    GROUNDWORK_COLOR=0
  elif [[ -n "${FORCE_COLOR:-}" && "${FORCE_COLOR}" != "0" ]]; then
    GROUNDWORK_COLOR=1
  elif [[ -t 1 ]]; then
    GROUNDWORK_COLOR=1
  else
    GROUNDWORK_COLOR=0
  fi
fi
export GROUNDWORK_COLOR
if [[ "$GROUNDWORK_COLOR" == "1" ]]; then
  # Homebrew decides color per-process from its own stdout; the run-wide
  # signal already decided. HOMEBREW_COLOR is Homebrew's documented switch
  # for exactly this (force color even when stdout is not a TTY), and
  # Homebrew itself still honors NO_COLOR above it.
  export HOMEBREW_COLOR=1
fi

# Homebrew asks for confirmation before installing or upgrading whenever its
# plan reaches past the named packages -- a new dependency, a dependent, a
# cask's own requirement -- and it asks ONLY when a terminal is attached. That
# is why every unattended proof stays green while a real person watching
# update-all gets a [y/n] and a run that stops until they answer. Groundwork
# already selected and classified this exact set and printed what it will do,
# so a second confirmation asks the person to re-approve a decision they made
# by running the command. HOMEBREW_NO_ASK is Homebrew's documented switch for
# that; it does not disable an explicit --ask, and it never widens the set.
export HOMEBREW_NO_ASK=1

# One private, transaction-scoped directory lets the Brewfile hook and
# package-maintenance child return small typed facts to this exact runner. Raw
# upstream logs live separately under the user's Groundwork state directory.
runner_receipt_dir="$(mktemp -d "${TMPDIR:-/tmp}/groundwork-update-receipt.XXXXXX")"
chmod 700 "$runner_receipt_dir"
export GROUNDWORK_UPDATE_RECEIPT_DIR="$runner_receipt_dir"

durable_receipt_dir="$HOME/.local/state/groundwork/receipts"
maintenance_receipt_final="$durable_receipt_dir/update-all-maintenance-latest.tsv"
action_receipt_final="$durable_receipt_dir/update-all-actions-latest.tsv"
maintenance_receipt_work="$runner_receipt_dir/maintenance.tsv"
mkdir -p "$durable_receipt_dir"
chmod 700 "$durable_receipt_dir"
update_started_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
update_invocation_id="${update_started_at//[-:]/}-$$-${RANDOM}${RANDOM}"
[[ "$update_invocation_id" =~ ^[0-9]{8}T[0-9]{6}Z-[1-9][0-9]*-[0-9]+$ ]] || {
  echo "Groundwork: could not create a safe update invocation identity." >&2
  exit 1
}
maintenance_receipt_named="$durable_receipt_dir/update-all-maintenance-$update_invocation_id.tsv"
action_receipt_named="$durable_receipt_dir/update-all-actions-$update_invocation_id.tsv"
maintenance_receipt_digest=""
printf 'schema\t2\ninvocation-id\t%s\nstarted-at\t%s\nplatform\t%s\n' \
  "$update_invocation_id" "$update_started_at" "$platform" \
  >"$maintenance_receipt_work"
chmod 600 "$maintenance_receipt_work"

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

receipt_field_safe() {
  [[ "$1" != *$'\t'* && "$1" != *$'\n'* && "$1" != *$'\r'* ]]
}

append_maintenance_receipt() {
  local field
  for field in "$@"; do
    receipt_field_safe "$field" || return 1
  done
  local first=1
  for field in "$@"; do
    if [[ "$first" -eq 1 ]]; then
      first=0
    else
      printf '\t' >>"$maintenance_receipt_work"
    fi
    printf '%s' "$field" >>"$maintenance_receipt_work"
  done
  printf '\n' >>"$maintenance_receipt_work"
}

publish_maintenance_receipt() {
  local result_status="$1" named_temporary latest_temporary
  [[ "$maintenance_receipt_published" -eq 0 ]] || return 0
  [[ -n "$maintenance_receipt_work" && -r "$maintenance_receipt_work" ]] || return 0
  [[ ! -e "$maintenance_receipt_named" ]] || return 1
  append_maintenance_receipt ended-at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    || return 1
  append_maintenance_receipt process-status "$result_status" || return 1
  named_temporary="${maintenance_receipt_named}.tmp.$$"
  latest_temporary="${maintenance_receipt_final}.tmp.$$"
  cp "$maintenance_receipt_work" "$named_temporary" || return 1
  chmod 600 "$named_temporary" || return 1
  mv -- "$named_temporary" "$maintenance_receipt_named" || return 1
  maintenance_receipt_digest="$(sha256_file "$maintenance_receipt_named")" \
    || return 1
  [[ "$maintenance_receipt_digest" =~ ^[0-9a-f]{64}$ ]] || return 1
  cp "$maintenance_receipt_named" "$latest_temporary" || return 1
  chmod 600 "$latest_temporary" || return 1
  mv -f -- "$latest_temporary" "$maintenance_receipt_final" || return 1
  maintenance_receipt_published=1
}

publish_action_receipt() {
  local action_work="$1" result_status="$2" named_temporary latest_temporary
  [[ ! -e "$action_receipt_named" ]] || return 1
  append_action_receipt ended-at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    || return 1
  append_action_receipt process-status "$result_status" || return 1
  named_temporary="${action_receipt_named}.tmp.$$"
  latest_temporary="${action_receipt_final}.tmp.$$"
  cp "$action_work" "$named_temporary" || return 1
  chmod 600 "$named_temporary" || return 1
  mv -- "$named_temporary" "$action_receipt_named" || return 1
  cp "$action_receipt_named" "$latest_temporary" || return 1
  chmod 600 "$latest_temporary" || return 1
  mv -f -- "$latest_temporary" "$action_receipt_final" || return 1
}

update_pending_dir="$HOME/.local/state/groundwork/update-all-pending"
mark_update_pending() {
  local stage="$1" message="$2" pending temporary
  pending="$update_pending_dir/$stage"
  temporary="${pending}.tmp.$$"
  mkdir -p "$update_pending_dir"
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$message" >"$temporary"
  mv -f -- "$temporary" "$pending"
}

clear_update_pending() {
  rm -f -- "$update_pending_dir/$1"
  rmdir "$update_pending_dir" 2>/dev/null || true
}

# The launcher installs this runner and its lock helper before exec'ing it; the
# FULL apply — configuration files and install hooks, the Homebrew bundle among
# them — runs here, under the freshly synchronized implementation. A hang or
# failure inside a large install now happens in a phase the fresh runner owns,
# not before it exists.
command -v chezmoi >/dev/null 2>&1 || {
  echo "Groundwork: chezmoi is not on PATH; cannot complete the synchronization." >&2
  exit 1
}
machine_app_action_count=0
homebrew_unverified_count=0
{{- if eq .chezmoi.os "darwin" }}
# Capture the installed version before the full apply: a changed Brewfile hook
# may replace Karabiner during `chezmoi apply`, before the explicit Homebrew
# upgrade lane begins. The postflight describes this only as a version change
# observed during update-all; it does not overclaim which updater caused it.
karabiner_version_before=""
karabiner_probe_before="$HOME/.local/share/groundwork/lib/karabiner.sh"
if [[ -r "$karabiner_probe_before" ]]; then
  # shellcheck source=/dev/null
  . "$karabiner_probe_before"
fi
if declare -F gw_karabiner_version >/dev/null 2>&1 \
  && candidate_version_before="$(gw_karabiner_version 2>/dev/null)" \
  && [[ "$candidate_version_before" =~ ^[0-9]+([.][0-9]+)*$ ]]; then
  karabiner_version_before="$candidate_version_before"
fi

# Detect the named field-failure case on every desktop Mac, including work
# profiles. A manual or MDM-ambiguous app is an action-required receipt item,
# not authority for update-all to adopt it and not a reason to suppress the
# remaining safe updater lanes. The Brewfile hook receives the exact conflicting
# cask token to omit from this apply; adoption stays a separate explicit command.
chatgpt_app="$applications_dir/ChatGPT.app"
chatgpt_info="$chatgpt_app/Contents/Info.plist"
chatgpt_owner="not-installed"
chatgpt_bundle_id=""
chatgpt_short_version=""
chatgpt_build_version=""
chatgpt_architecture=""
preapply_cask_inventory="$runner_receipt_dir/homebrew-cask-preapply"
preapply_cask_inventory_status=127
: >"$preapply_cask_inventory"
if command -v brew >/dev/null 2>&1; then
  preapply_cask_inventory_status=0
  HOMEBREW_NO_AUTO_UPDATE=1 brew list --cask >"$preapply_cask_inventory" 2>/dev/null \
    || preapply_cask_inventory_status=$?
  if [[ "$preapply_cask_inventory_status" -eq 0 ]] \
    && ! awk 'NF != 1 || $0 !~ /^[A-Za-z0-9@+._-]+$/ { exit 1 }' \
      "$preapply_cask_inventory"; then
    preapply_cask_inventory_status=65
  fi
fi
if [[ "$preapply_cask_inventory_status" -eq 0 ]] \
  && grep -qxF chatgpt "$preapply_cask_inventory"; then
  chatgpt_owner="homebrew"
elif [[ -e "$chatgpt_app" || -L "$chatgpt_app" ]]; then
  if [[ "$preapply_cask_inventory_status" -eq 0 ]]; then
    chatgpt_owner="external-unverified"
  else
    chatgpt_owner="ownership-unresolved"
  fi
  if [[ -d "$chatgpt_app" && -r "$chatgpt_info" ]] \
    && command -v plutil >/dev/null 2>&1; then
    chatgpt_bundle_id="$(plutil -extract CFBundleIdentifier raw "$chatgpt_info" 2>/dev/null || true)"
    chatgpt_short_version="$(plutil -extract CFBundleShortVersionString raw "$chatgpt_info" 2>/dev/null || true)"
    chatgpt_build_version="$(plutil -extract CFBundleVersion raw "$chatgpt_info" 2>/dev/null || true)"
    chatgpt_executable="$(plutil -extract CFBundleExecutable raw "$chatgpt_info" 2>/dev/null || true)"
    if [[ -n "$chatgpt_executable" && -f "$chatgpt_app/Contents/MacOS/$chatgpt_executable" ]]; then
      chatgpt_architecture="$(file "$chatgpt_app/Contents/MacOS/$chatgpt_executable" 2>/dev/null \
        | sed -E 's/^.*Mach-O [^ ]+ executable //' || true)"
    fi
  fi
fi
if [[ "$chatgpt_owner" == "external-unverified" \
  || "$chatgpt_owner" == "ownership-unresolved" ]]; then
  machine_app_action_count=$((machine_app_action_count + 1))
  export GROUNDWORK_BREWFILE_SKIP_CASKS="chatgpt"
fi
chatgpt_classic_app="$applications_dir/ChatGPT Classic.app"
chatgpt_classic_present=0
if [[ -e "$chatgpt_classic_app" || -L "$chatgpt_classic_app" ]]; then
  chatgpt_classic_present=1
  machine_app_action_count=$((machine_app_action_count + 1))
fi
{{- end }}
chezmoi apply

brew_lane_status="skipped"
brew_cask_review_count=0
brew_cask_pinned_count=0
brew_formula_pinned_count=0
brew_vendor_covered_count=0
brew_deprecated_count=0
brew_disabled_count=0
brew_deferred_running_count=0
brew_discovered_count=0
brew_inventory_current_count=0
brew_attempted_count=0
brew_verified_updated_count=0
homebrew_mutation_failed=0
homebrew_status=0
if command -v brew >/dev/null 2>&1; then
  brew_output_lib="$HOME/.local/share/groundwork/lib/brew-output.sh"
  if [[ ! -r "$brew_output_lib" ]]; then
    echo "Groundwork: Homebrew output classifier is missing: $brew_output_lib" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . "$brew_output_lib"
  # Homebrew owns everything in its installed inventory, regardless of which
  # workflow first installed it. Inventory formulae, casks, and pins before
  # metadata refresh; selection remains exact-token and trust classification
  # still happens before the first upgrade.
  formula_inventory="$runner_receipt_dir/homebrew-formula-installed"
  cask_inventory="$runner_receipt_dir/homebrew-cask-installed"
  formula_metadata="$runner_receipt_dir/homebrew-formula-metadata.json"
  formula_classification="$runner_receipt_dir/homebrew-formula-classification.tsv"
  formula_candidates="$runner_receipt_dir/homebrew-formula-candidates"
  : >"$formula_inventory"
  : >"$cask_inventory"
  if ! brew list --formula --full-name >"$formula_inventory" \
    || ! brew list --cask >"$cask_inventory"; then
    echo "Groundwork: Homebrew's installed inventory could not be read; no upgrade was attempted." >&2
    homebrew_status=1
  fi
  for brew_inventory_file in "$formula_inventory" "$cask_inventory"; do
    if ! awk 'NF != 1 || $0 !~ /^[A-Za-z0-9@+._-]+(\/[A-Za-z0-9@+._-]+){0,2}$/ { exit 1 }' \
      "$brew_inventory_file"; then
      echo "Groundwork: Homebrew returned a malformed installed or pinned token; no upgrade was attempted." >&2
      homebrew_status=1
    fi
  done
  brew_discovered_count=$(( $(wc -l <"$formula_inventory") + $(wc -l <"$cask_inventory") ))

  # Curl-level retries for the transient failures curl itself classifies as
  # retryable (timeouts, 5xx). The curl-92 stream errors it does NOT retry
  # are handled after the fact by groundwork-brew-refetch below.
  export HOMEBREW_CURL_RETRIES=3
  if [[ "$homebrew_status" -eq 0 ]]; then
    "$HOME/.local/bin/groundwork-brew-update" || homebrew_status=$?
  fi
  case "$homebrew_status" in
    124 | 125 | 129 | 130 | 143) exit "$homebrew_status" ;;
  esac
  : >"$formula_candidates"
  : >"$formula_classification"
  if [[ "$homebrew_status" -eq 0 && -s "$formula_inventory" ]]; then
    installed_formulae=()
    while IFS= read -r formula_token; do installed_formulae+=("$formula_token"); done <"$formula_inventory"
    if ! HOMEBREW_NO_AUTO_UPDATE=1 brew info --json=v2 --formula \
      "${installed_formulae[@]}" >"$formula_metadata"; then
      echo "Groundwork: Homebrew formula metadata could not be read; no Homebrew upgrade was attempted." >&2
      homebrew_status=1
    elif ! gw_brew_classify_formula_metadata \
      "$formula_metadata" "$formula_inventory" "$formula_classification"; then
      homebrew_status=1
    fi
  fi
  if [[ "$homebrew_status" -eq 0 ]]; then
    while IFS=$'\t' read -r formula_token formula_disposition formula_reason \
      formula_installed _formula_available formula_extra; do
      [[ -n "$formula_token" ]] || continue
      if [[ -n "$formula_extra" ]]; then
        echo "Groundwork: the classified Homebrew formula receipt is malformed; no Homebrew upgrade was attempted." >&2
        homebrew_status=1
        break
      fi
      case "$formula_disposition" in
        candidate) printf '%s\n' "$formula_token" >>"$formula_candidates" ;;
        pinned)
          brew_formula_pinned_count=$((brew_formula_pinned_count + 1))
          printf 'Groundwork pinned: formula %s %s remains pinned.\n' \
            "$formula_token" "$formula_installed"
          printf '  Optional owner action: brew unpin --formula %s\n' "$formula_token"
          ;;
        deprecated | disabled)
          brew_deprecated_count=$((brew_deprecated_count + 1))
          printf 'Groundwork owner action: formula %s is %s; review its replacement before removal.\n' \
            "$formula_token" "$formula_reason"
          ;;
        *)
          echo "Groundwork: the classified Homebrew formula disposition is unknown; no Homebrew upgrade was attempted." >&2
          homebrew_status=1
          break
          ;;
      esac
    done <"$formula_classification"
  fi
  # Use the metadata snapshot that just refreshed. A user-customized Homebrew
  # auto-update interval must not start a second, unwrapped update here.
  {{- if eq .chezmoi.os "darwin" }}
  ordinary_cask_file="$runner_receipt_dir/homebrew-cask-ordinary"
  auto_check_file="$runner_receipt_dir/homebrew-cask-auto-check"
  latest_check_file="$runner_receipt_dir/homebrew-cask-latest-check"
  cask_apps_file="$runner_receipt_dir/homebrew-cask-apps.tsv"
  : >"$ordinary_cask_file"
  : >"$auto_check_file"
  : >"$latest_check_file"
  : >"$cask_apps_file"
  if [[ "$homebrew_status" -eq 0 && -s "$cask_inventory" ]]; then
    vendor_updater_policy="$HOME/.local/share/groundwork/vendor-updater-casks.txt"
    cask_metadata="$(mktemp "$runner_receipt_dir/homebrew-cask-metadata.XXXXXX")"
    cask_classification="$(mktemp "$runner_receipt_dir/homebrew-cask-classification.XXXXXX")"
    chmod 600 "$cask_metadata" "$cask_classification"
    runner_temp="$cask_metadata"
    installed_casks=()
    while IFS= read -r cask_token; do installed_casks+=("$cask_token"); done <"$cask_inventory"
    if ! brew info --json=v2 --cask "${installed_casks[@]}" >"$cask_metadata"; then
      : >"$cask_classification"
      echo "Groundwork: Homebrew cask metadata could not be read; no cask upgrade was attempted." >&2
      homebrew_status=1
    elif ! gw_brew_classify_cask_metadata \
      "$cask_metadata" "$cask_inventory" "$vendor_updater_policy" \
      "$cask_classification"; then
      : >"$cask_classification"
      homebrew_status=1
    fi
    if [[ "$homebrew_status" -eq 0 ]] \
      && ! awk -F '\t' 'NF != 6 { exit 1 } { print $1 "\t" $6 }' \
        "$cask_classification" >"$cask_apps_file"; then
      echo "Groundwork: Homebrew cask app ownership metadata was malformed; no cask upgrade was attempted." >&2
      : >"$cask_apps_file"
      homebrew_status=1
    fi
    while [[ "$homebrew_status" -eq 0 ]] \
      && IFS=$'\t' read -r cask_token cask_disposition cask_reason \
      cask_installed cask_available cask_apps cask_extra; do
      if [[ -n "$cask_extra" \
        || ! "$cask_token" =~ ^[A-Za-z0-9@+._-]+(/[A-Za-z0-9@+._-]+){0,2}$ \
        || "$cask_apps" == *$'\t'* || "$cask_apps" == *$'\n'* ]]; then
        echo "Groundwork: the classified Homebrew cask receipt is malformed; no cask upgrade was attempted." >&2
        homebrew_status=1
        break
      fi
      case "$cask_disposition" in
        eligible)
          printf '%s\n' "$cask_token" >>"$ordinary_cask_file"
          ;;
        auto-check)
          printf '%s\n' "$cask_token" >>"$auto_check_file"
          ;;
        latest-check)
          printf '%s\n' "$cask_token" >>"$latest_check_file"
          ;;
        current)
          brew_inventory_current_count=$((brew_inventory_current_count + 1))
          ;;
        vendor-covered)
          brew_vendor_covered_count=$((brew_vendor_covered_count + 1))
          printf 'Groundwork vendor-covered: %s remains with its declared self-updater (%s installed; %s available in Homebrew).\n' \
            "$cask_token" "$cask_installed" "$cask_available"
          ;;
        deprecated)
          brew_deprecated_count=$((brew_deprecated_count + 1))
          if [[ "$cask_token" == "codex-app" ]]; then
            cat <<EOF
Groundwork owner action: deprecated cask codex-app remains installed and was not changed.
  Inspect exact ownership before optional removal: groundwork-app-remove codex-app
  Groundwork never blindly uninstalls, zaps, deletes, replaces, or conflates it with ChatGPT.
EOF
          else
            printf 'Groundwork owner action: deprecated cask %s remains installed; review its replacement before removal.\n' \
              "$cask_token"
          fi
          ;;
        disabled)
          brew_disabled_count=$((brew_disabled_count + 1))
          printf 'Groundwork owner action: disabled cask %s %s -> %s remains installed and unchanged.\n' \
            "$cask_token" "$cask_installed" "$cask_available"
          printf '  Review its supported replacement or run: brew uninstall --cask %s\n' \
            "$cask_token"
          ;;
        review)
          printf 'Groundwork review: %s %s -> %s was not upgraded automatically (%s).\n' \
            "$cask_token" "$cask_installed" "$cask_available" "$cask_reason"
          case "$cask_reason" in
            pinned)
              brew_cask_review_count=$((brew_cask_review_count + 1))
              brew_cask_pinned_count=$((brew_cask_pinned_count + 1))
              printf '  Optional owner action: brew unpin --cask %s\n' "$cask_token"
              ;;
            no-checksum-unresolved | latest-no-checksum | unverified-vendor-updater)
              brew_cask_review_count=$((brew_cask_review_count + 1))
              homebrew_unverified_count=$((homebrew_unverified_count + 1))
              printf '  No automatic mutation is safe until checksum or updater ownership is verified.\n'
              ;;
            *)
              brew_cask_review_count=$((brew_cask_review_count + 1))
              printf '  Quit it if running, then run: brew upgrade --cask --require-sha %s\n' "$cask_token"
              ;;
          esac
          ;;
        *)
          echo "Groundwork: the classified Homebrew cask disposition is unknown; no cask upgrade was attempted." >&2
          homebrew_status=1
          break
          ;;
      esac
    done <"$cask_classification"
    rm -f -- "$cask_metadata" "$cask_classification"
    runner_temp=""
  fi
  {{- else }}
  ordinary_cask_file="$runner_receipt_dir/homebrew-cask-ordinary"
  auto_check_file="$runner_receipt_dir/homebrew-cask-auto-check"
  latest_check_file="$runner_receipt_dir/homebrew-cask-latest-check"
  cask_apps_file="$runner_receipt_dir/homebrew-cask-apps.tsv"
  : >"$ordinary_cask_file"
  : >"$auto_check_file"
  : >"$latest_check_file"
  : >"$cask_apps_file"
  {{- end }}

  select_brew_outdated() {
    local label="$1" candidates_file="$2" selected_file="$3"
    shift 3
    local observed_file="${selected_file}.observed" observation_status=0
    : >"$selected_file"
    [[ -s "$candidates_file" ]] || return 0
    # Deliberately NO package arguments. `brew outdated <names>` uses its exit
    # status as a PREDICATE: it returns 1 when the named packages are outdated,
    # and 0 when they are current. Passing the candidate list therefore made
    # Homebrew report "failure" in exactly the case this command exists for --
    # having updates to install -- while succeeding whenever there was nothing
    # to do. Argument-free `brew outdated` reports every outdated package and
    # exits 0, so a nonzero status here is a real observation failure again.
    # The candidate intersection happens below, where it is ours to control.
    HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --quiet "$@" \
      >"$observed_file" || observation_status=$?
    if [[ "$observation_status" -ne 0 ]]; then
      printf 'Groundwork: %s could not be observed (exit %s).\n' "$label" "$observation_status" >&2
      rm -f -- "$observed_file"
      return "$observation_status"
    fi
    # Argument-free brew outdated reports EVERY outdated package, including the
    # ones this lane deliberately excluded: pinned formulae, deprecated casks,
    # and self-updating apps that Groundwork refuses to replace automatically.
    # Narrow to the candidate set here, because gw_brew_select_exact_tokens
    # rejects an observation containing anything outside it -- a correct rule
    # when the tokens were named, and an impossible one once they are not.
    # Its token-shape and duplicate checks still run on the narrowed result.
    if [[ -s "$observed_file" ]]; then
      LC_ALL=C sort "$observed_file" >"${observed_file}.all"
      LC_ALL=C sort -u "$candidates_file" >"${observed_file}.wanted"
      LC_ALL=C comm -12 "${observed_file}.all" "${observed_file}.wanted" >"$observed_file"
      rm -f -- "${observed_file}.all" "${observed_file}.wanted"
    fi
    if ! gw_brew_select_exact_tokens "$candidates_file" "$observed_file" "$selected_file"; then
      rm -f -- "$observed_file"
      return 1
    fi
    rm -f -- "$observed_file"
  }

  # Homebrew may quit an application while replacing its cask. The default
  # transaction observes the exact executable paths advertised by the cask's
  # app artifacts and removes running apps from the mutating argv. Every
  # remaining default cask mutation also carries --no-quit so an app launched
  # after this snapshot remains protected. An explicit --allow-app-quit applies
  # only to this invocation and never widens the set.
  cask_process_snapshot="$runner_receipt_dir/homebrew-cask-processes"
  cask_process_snapshot_status=0
  : >"$cask_process_snapshot"
  if [[ "$allow_app_quit" -eq 0 && -s "$cask_apps_file" ]]; then
    ps -axo command= >"$cask_process_snapshot" || cask_process_snapshot_status=$?
  fi
  defer_running_casks() {
    local selected_file="$1" ready_file="$2" token app_name app_prefix
    local matching_rows cask_is_running
    local cask_app_names=()
    : >"$ready_file"
    while IFS= read -r token; do
      [[ -n "$token" ]] || continue
      if [[ "$allow_app_quit" -eq 1 ]]; then
        printf '%s\n' "$token" >>"$ready_file"
        continue
      fi
      matching_rows="$(awk -F '\t' -v token="$token" '$1 == token { count++; value=$2 } END { if (count != 1) exit 1; print value }' \
        "$cask_apps_file")" || {
        echo "Groundwork: cask application metadata was missing for $token; it was not upgraded." >&2
        return 1
      }
      if [[ -z "$matching_rows" ]]; then
        printf '%s\n' "$token" >>"$ready_file"
        continue
      fi
      if [[ "$cask_process_snapshot_status" -ne 0 ]]; then
        printf 'Groundwork unresolved: running state for %s could not be observed; it was not upgraded.\n' \
          "$token" >&2
        return "$cask_process_snapshot_status"
      fi
      cask_is_running=0
      IFS='|' read -r -a cask_app_names <<<"$matching_rows"
      for app_name in "${cask_app_names[@]}"; do
        if [[ ! "$app_name" =~ ^[^/|[:cntrl:]]+[.]app$ ]]; then
          echo "Groundwork: Homebrew returned an unsafe app bundle name for $token; it was not upgraded." >&2
          return 1
        fi
        app_prefix="$applications_dir/$app_name/Contents/MacOS/"
        if awk -v prefix="$app_prefix" '
            { command=$0; sub(/^[[:space:]]+/, "", command) }
            index(command, prefix) == 1 { found=1 }
            END { exit !found }
          ' \
          "$cask_process_snapshot"; then
          cask_is_running=1
          break
        fi
      done
      if [[ "$cask_is_running" -eq 1 ]]; then
        brew_deferred_running_count=$((brew_deferred_running_count + 1))
        printf 'Groundwork deferred-running: %s is open and was not upgraded.\n' "$token"
        printf '  Save your work, then rerun: update-all --allow-app-quit\n'
      else
        printf '%s\n' "$token" >>"$ready_file"
      fi
    done <"$selected_file"
  }

  formula_outdated="$runner_receipt_dir/homebrew-formula-outdated"
  ordinary_casks="$runner_receipt_dir/homebrew-cask-ordinary-outdated"
  auto_casks="$runner_receipt_dir/homebrew-cask-auto-outdated"
  latest_casks="$runner_receipt_dir/homebrew-cask-latest-outdated"
  : >"$formula_outdated"
  : >"$ordinary_casks"
  : >"$auto_casks"
  : >"$latest_casks"
  if [[ "$homebrew_status" -eq 0 ]]; then
    select_brew_outdated "installed Homebrew formulae" \
      "$formula_candidates" "$formula_outdated" --formula || homebrew_status=$?
  else
    : >"$formula_outdated"
  fi
  {{- if eq .chezmoi.os "darwin" }}
  # Ordinary cask metadata already carries Homebrew's normal outdated decision.
  cp "$ordinary_cask_file" "$ordinary_casks"
  if [[ "$homebrew_status" -eq 0 ]]; then
    select_brew_outdated "self-updating Homebrew casks" \
      "$auto_check_file" "$auto_casks" --cask --greedy-auto-updates || homebrew_status=$?
  fi
  if [[ "$homebrew_status" -eq 0 ]]; then
    select_brew_outdated "Homebrew casks with version latest" \
      "$latest_check_file" "$latest_casks" --cask --greedy-latest || homebrew_status=$?
  fi
  {{- else }}
  : >"$ordinary_casks"
  : >"$auto_casks"
  : >"$latest_casks"
  {{- end }}
  if [[ "$homebrew_status" -eq 0 ]]; then
    formula_candidate_count="$(wc -l <"$formula_candidates" | tr -d ' ')"
    formula_outdated_count="$(wc -l <"$formula_outdated" | tr -d ' ')"
    auto_candidate_count="$(wc -l <"$auto_check_file" | tr -d ' ')"
    auto_outdated_count="$(wc -l <"$auto_casks" | tr -d ' ')"
    latest_candidate_count="$(wc -l <"$latest_check_file" | tr -d ' ')"
    latest_outdated_count="$(wc -l <"$latest_casks" | tr -d ' ')"
    brew_inventory_current_count=$((brew_inventory_current_count \
      + formula_candidate_count - formula_outdated_count \
      + auto_candidate_count - auto_outdated_count \
      + latest_candidate_count - latest_outdated_count))
  fi

  ordinary_casks_ready="$runner_receipt_dir/homebrew-cask-ordinary-ready"
  auto_casks_ready="$runner_receipt_dir/homebrew-cask-auto-ready"
  latest_casks_ready="$runner_receipt_dir/homebrew-cask-latest-ready"
  if [[ "$homebrew_status" -eq 0 ]]; then
    defer_running_casks "$ordinary_casks" "$ordinary_casks_ready" || homebrew_status=$?
  else
    : >"$ordinary_casks_ready"
  fi
  if [[ "$homebrew_status" -eq 0 ]]; then
    defer_running_casks "$auto_casks" "$auto_casks_ready" || homebrew_status=$?
  else
    : >"$auto_casks_ready"
  fi
  if [[ "$homebrew_status" -eq 0 ]]; then
    defer_running_casks "$latest_casks" "$latest_casks_ready" || homebrew_status=$?
  else
    : >"$latest_casks_ready"
  fi

  # Keep interactive cask work attached to a real terminal so cursor output and
  # password prompts remain coherent. The saved normalized log still gives the
  # repair helper Homebrew's own remediation hints. The per-cask "cannot be
  # upgraded as-is" warning does NOT fail the upgrade, so without this it
  # repeats on every refresh forever; the helper shows brew's exact suggested
  # command and only acts on a yes. A failed upgrade retries once after a repair
  # actually ran.
  brew_log_dir="$HOME/.local/state/groundwork/logs"
  mkdir -p "$brew_log_dir"
  upgrade_log_final="$brew_log_dir/homebrew-upgrade-latest.log"
  upgrade_log="$(mktemp "$brew_log_dir/homebrew-upgrade.XXXXXX")"
  chmod 600 "$upgrade_log"
  runner_temp="$upgrade_log"
  runner_temp_final="$upgrade_log_final"
  upgrade_receipt="$runner_receipt_dir/homebrew-upgrade.tsv"
  : >"$upgrade_log"
  : >"$upgrade_receipt"
  if [[ "$homebrew_status" -eq 0 ]]; then
    echo "Groundwork: upgrading the exact eligible items in Homebrew's installed inventory."
    mark_update_pending "homebrew-upgrade" \
      "Homebrew upgrade started, but completion has not been proven"
  else
    mark_update_pending "homebrew-upgrade" \
      "Homebrew inventory or classification failed before mutation"
  fi
  run_homebrew_upgrade_lane() {
    local label="$1" repair_allowed="$2"
    shift 2
    local lane_log lane_receipt lane_status=0 repair_status=0 retry_upgrade=0
    local lane_arg lane_tokens=""
    for lane_arg in "$@"; do
      case "$lane_arg" in brew | upgrade | --*) continue ;; esac
      if [[ -n "$lane_tokens" ]]; then
        lane_tokens="$lane_tokens, $lane_arg"
      else
        lane_tokens="$lane_arg"
      fi
    done
    [[ -n "$lane_tokens" ]] || lane_tokens="none"
    lane_log="$(mktemp "$brew_log_dir/homebrew-upgrade-lane.XXXXXX")"
    lane_receipt="$(mktemp "$runner_receipt_dir/homebrew-upgrade-lane.XXXXXX")"
    chmod 600 "$lane_log" "$lane_receipt"
    runner_temp="$lane_log"
    runner_temp_final="$upgrade_log_final"
    HOMEBREW_NO_AUTO_UPDATE=1 \
      gw_brew_run_logged "$lane_log" "$lane_receipt" reset "$label" -- "$@" \
      || lane_status=$?
    case "$lane_status" in
      124 | 125 | 129 | 130 | 143)
        cat "$lane_log" >>"$upgrade_log"
        cat "$lane_receipt" >>"$upgrade_receipt"
        rm -f -- "$lane_log" "$lane_receipt"
        runner_temp="$upgrade_log"
        mark_update_pending "homebrew-upgrade" \
          "$label was cancelled (exit $lane_status) and did not complete"
        printf 'Groundwork: %s cancelled; nothing further was started.\n' "$label" >&2
        return "$lane_status"
        ;;
    esac
    if [[ "$repair_allowed" -eq 1 ]]; then
      "$HOME/.local/bin/groundwork-brew-repair" "$lane_log" || repair_status=$?
      if [[ "$repair_status" -eq 0 && "$lane_status" -ne 0 ]]; then
        retry_upgrade=1
      elif [[ "$repair_status" -eq 3 ]]; then
        echo "Groundwork: the Homebrew repair you approved did not complete — review the output above."
        [[ "$lane_status" -ne 0 ]] || lane_status=1
      elif [[ "$repair_status" -ge 4 ]]; then
        echo "Groundwork: Homebrew printed a remediation Groundwork could not safely parse; review the log above and run it yourself."
      fi
    fi
    if [[ "$lane_status" -ne 0 ]] \
      && "$HOME/.local/bin/groundwork-brew-refetch" "$lane_log"; then
      retry_upgrade=1
    fi
    if [[ "$retry_upgrade" -eq 1 ]]; then
      lane_status=0
      HOMEBREW_NO_AUTO_UPDATE=1 \
        gw_brew_run_logged "$lane_log" "$lane_receipt" append "$label retry" -- "$@" \
        || lane_status=$?
    fi
    if [[ "$lane_status" -ne 0 ]]; then
      printf 'command-failure\t%s\t%s\t%s\n' \
        "$label" "$lane_status" "$lane_tokens" >>"$lane_receipt"
      printf 'Groundwork: %s failed for exact token(s): %s (exit %s).\n' \
        "$label" "$lane_tokens" "$lane_status" >&2
      echo 'Groundwork: bounded final Homebrew output follows:' >&2
      if [[ -s "$lane_log" ]]; then
        tail -n 20 "$lane_log" >&2
      else
        echo '  (Homebrew produced no output.)' >&2
      fi
      append_maintenance_receipt homebrew-lane "$label" "$lane_status" \
        "$lane_tokens" "$upgrade_log_final" || return 1
    fi
    cat "$lane_log" >>"$upgrade_log"
    cat "$lane_receipt" >>"$upgrade_receipt"
    rm -f -- "$lane_log" "$lane_receipt"
    runner_temp="$upgrade_log"
    case "$lane_status" in
      124 | 125 | 129 | 130 | 143)
        mark_update_pending "homebrew-upgrade" \
          "$label retry was cancelled (exit $lane_status) and did not complete"
        printf 'Groundwork: %s retry cancelled; nothing further was started.\n' "$label" >&2
        return "$lane_status"
        ;;
    esac
    return "$lane_status"
  }

  run_homebrew_cask_upgrade_lane() {
    local label="$1"
    shift
    if [[ "$allow_app_quit" -eq 1 ]]; then
      run_homebrew_upgrade_lane "$label" 1 \
        brew upgrade --cask --require-sha "$@"
    else
      run_homebrew_upgrade_lane "$label" 1 \
        brew upgrade --cask --require-sha --no-quit "$@"
    fi
  }

  upgrade_status="$homebrew_status"
  homebrew_upgrade_started=0
  formula_tokens=()
  ordinary_cask_tokens=()
  auto_cask_tokens=()
  latest_cask_tokens=()
  while IFS= read -r brew_token; do formula_tokens+=("$brew_token"); done <"$formula_outdated"
  while IFS= read -r brew_token; do ordinary_cask_tokens+=("$brew_token"); done <"$ordinary_casks_ready"
  while IFS= read -r brew_token; do auto_cask_tokens+=("$brew_token"); done <"$auto_casks_ready"
  while IFS= read -r brew_token; do latest_cask_tokens+=("$brew_token"); done <"$latest_casks_ready"
  if [[ "$homebrew_status" -eq 0 ]] && ((${#formula_tokens[@]} > 0)); then
    brew_attempted_count=$((brew_attempted_count + ${#formula_tokens[@]}))
    homebrew_upgrade_started=1
    if run_homebrew_upgrade_lane "Homebrew formula upgrade" 0 \
      brew upgrade --formula "${formula_tokens[@]}"; then
      :
    else
      upgrade_status=$?
    fi
  fi
  {{- if eq .chezmoi.os "darwin" }}
  if [[ "$upgrade_status" -eq 0 ]] && ((${#ordinary_cask_tokens[@]} > 0)); then
    brew_attempted_count=$((brew_attempted_count + ${#ordinary_cask_tokens[@]}))
    homebrew_upgrade_started=1
    if run_homebrew_cask_upgrade_lane "Homebrew cask upgrade" \
      "${ordinary_cask_tokens[@]}"; then
      :
    else
      upgrade_status=$?
    fi
  fi
  if [[ "$upgrade_status" -eq 0 ]] && ((${#auto_cask_tokens[@]} > 0)); then
    brew_attempted_count=$((brew_attempted_count + ${#auto_cask_tokens[@]}))
    homebrew_upgrade_started=1
    if run_homebrew_cask_upgrade_lane "Homebrew self-updating cask upgrade" \
      --greedy-auto-updates \
        "${auto_cask_tokens[@]}"; then
      :
    else
      upgrade_status=$?
    fi
  fi
  if [[ "$upgrade_status" -eq 0 ]] && ((${#latest_cask_tokens[@]} > 0)); then
    brew_attempted_count=$((brew_attempted_count + ${#latest_cask_tokens[@]}))
    homebrew_upgrade_started=1
    if run_homebrew_cask_upgrade_lane "Homebrew latest-version cask upgrade" \
      --greedy-latest \
        "${latest_cask_tokens[@]}"; then
      :
    else
      upgrade_status=$?
    fi
  fi
  {{- end }}
  mv -f -- "$upgrade_log" "$upgrade_log_final"
  runner_temp=""
  runner_temp_final=""
  gw_brew_report_classification \
    "Homebrew upgrade" "$upgrade_receipt" "$upgrade_log_final" "$upgrade_status"
  if [[ "$upgrade_status" -ne 0 && "$homebrew_upgrade_started" -eq 1 ]]; then
    homebrew_mutation_failed=1
    failed_cask="$(awk -F '\t' '$1 == "failed-cask" { print $2; exit }' "$upgrade_receipt")"
    pending_detail="Homebrew upgrade failed (exit $upgrade_status)"
    [[ -z "$failed_cask" ]] || pending_detail="$pending_detail; failed cask: $failed_cask"
    # The lane already records a more precise cancellation/retry-cancellation
    # disposition. Do not overwrite it with the generic failure summary after
    # the status unwinds to this transaction boundary.
    case "$upgrade_status" in
      124 | 125 | 129 | 130 | 143) ;;
      *) mark_update_pending "homebrew-upgrade" "$pending_detail" ;;
    esac
    case "$upgrade_status" in
      124 | 125 | 129 | 130 | 143) exit "$upgrade_status" ;;
    esac
    homebrew_status="$upgrade_status"
  elif [[ "$upgrade_status" -ne 0 ]]; then
    homebrew_status="$upgrade_status"
  fi

  # Re-run the same exact observations after mutation. A selected item that
  # remains outdated, or a query that can no longer be trusted, makes the
  # completeness claim fail closed.
  formula_remaining="$runner_receipt_dir/homebrew-formula-remaining"
  ordinary_remaining="$runner_receipt_dir/homebrew-cask-ordinary-remaining"
  auto_remaining="$runner_receipt_dir/homebrew-cask-auto-remaining"
  latest_remaining="$runner_receipt_dir/homebrew-cask-latest-remaining"
  : >"$formula_remaining"
  : >"$ordinary_remaining"
  : >"$auto_remaining"
  : >"$latest_remaining"
  if [[ "$homebrew_status" -eq 0 ]]; then
    select_brew_outdated "post-update Homebrew formulae" \
      "$formula_outdated" "$formula_remaining" --formula || homebrew_status=$?
  fi
  {{- if eq .chezmoi.os "darwin" }}
  if [[ "$homebrew_status" -eq 0 ]]; then
    select_brew_outdated "post-update ordinary Homebrew casks" \
      "$ordinary_casks_ready" "$ordinary_remaining" --cask || homebrew_status=$?
  fi
  if [[ "$homebrew_status" -eq 0 ]]; then
    select_brew_outdated "post-update self-updating Homebrew casks" \
      "$auto_casks_ready" "$auto_remaining" --cask --greedy-auto-updates || homebrew_status=$?
  fi
  if [[ "$homebrew_status" -eq 0 ]]; then
    select_brew_outdated "post-update latest-version Homebrew casks" \
      "$latest_casks_ready" "$latest_remaining" --cask --greedy-latest || homebrew_status=$?
  fi
  {{- end }}
  homebrew_remaining_count=0
  for remaining_file in "$formula_remaining" "$ordinary_remaining" \
    "$auto_remaining" "$latest_remaining"; do
    while IFS= read -r remaining_token; do
      [[ -n "$remaining_token" ]] || continue
      homebrew_remaining_count=$((homebrew_remaining_count + 1))
      printf 'Groundwork failed: Homebrew still reports %s outdated after its eligible update lane.\n' \
        "$remaining_token" >&2
    done <"$remaining_file"
  done
  if [[ "$homebrew_remaining_count" -ne 0 ]]; then
    if [[ "$homebrew_status" -eq 0 \
      && "$homebrew_remaining_count" -le "$brew_attempted_count" ]]; then
      brew_verified_updated_count=$((brew_attempted_count - homebrew_remaining_count))
    fi
    mark_update_pending "homebrew-upgrade" \
      "$homebrew_remaining_count eligible Homebrew item(s) remained outdated after update"
    homebrew_status=1
  elif [[ "$homebrew_status" -eq 0 ]]; then
    brew_verified_updated_count="$brew_attempted_count"
    clear_update_pending "homebrew-upgrade"
  fi
  {{- if and (eq .chezmoi.os "darwin") (not .headless) }}
  if [[ "$homebrew_status" -eq 0 ]]; then
    "$HOME/.local/bin/groundwork-apps-start" || true
  fi
  {{- end }}
  if [[ "$homebrew_status" -eq 0 ]]; then
    brew_lane_status="current-or-updated"
  else
    brew_lane_status="failed"
  fi
fi

mas_lane_status="skipped"
mas_status=0
mas_attempted_count=0
mas_verified_updated_count=0
mas_remaining_count=0
mas_timed_out_count=0
mas_failed_count=0
mas_action_required_count=0
mas_no_longer_outdated_count=0
mas_unexplained_count=0
{{- if eq .chezmoi.os "darwin" }}
if command -v mas >/dev/null 2>&1; then
  mas_runner_lib="$HOME/.local/share/groundwork/lib/maintenance-runner.sh"
  [[ -r "$mas_runner_lib" ]] || {
    echo "Groundwork: the bounded Mac App Store runner is missing: $mas_runner_lib" >&2
    exit 1
  }
  # shellcheck disable=SC2034 # Sourced runner API.
  declare deadline="$mas_app_deadline" observe_deadline="$mas_observe_deadline" \
    heartbeat="${GROUNDWORK_TEST_MAS_HEARTBEAT_SECONDS:-15}" \
    cancel_grace="${GROUNDWORK_TEST_MAS_CANCEL_GRACE_SECONDS:-2}" \
    poll_seconds=0.2 orphan_grace=5
  [[ "$heartbeat" =~ ^[1-9][0-9]*$ && "$cancel_grace" =~ ^[1-9][0-9]*$ ]] || {
    echo "Groundwork: invalid test-only Mac App Store runner timing override." >&2
    exit 64
  }
  # shellcheck source=/dev/null
  . "$mas_runner_lib"
  mas_installed="$(mktemp "$runner_receipt_dir/mas-installed.XXXXXX")"
  mas_outdated="$(mktemp "$runner_receipt_dir/mas-outdated.XXXXXX")"
  mas_post_installed="$(mktemp "$runner_receipt_dir/mas-post-installed.XXXXXX")"
  mas_remaining="$(mktemp "$runner_receipt_dir/mas-remaining.XXXXXX")"
  mas_installed_items="$runner_receipt_dir/mas-installed-items"
  mas_outdated_items="$runner_receipt_dir/mas-outdated-items"
  mas_remaining_items="$runner_receipt_dir/mas-remaining-items"
  mas_post_installed_items="$runner_receipt_dir/mas-post-installed-items"
  mas_installed_ids="$runner_receipt_dir/mas-installed-ids"
  mas_outdated_ids="$runner_receipt_dir/mas-outdated-ids"
  mas_remaining_ids="$runner_receipt_dir/mas-remaining-ids"
  mas_post_installed_ids="$runner_receipt_dir/mas-post-installed-ids"
  mas_attempted_ids="$runner_receipt_dir/mas-attempted-ids"
  mas_timed_out_ids="$runner_receipt_dir/mas-timed-out-ids"
  mas_failed_ids="$runner_receipt_dir/mas-failed-ids"
  mas_action_required_ids="$runner_receipt_dir/mas-action-required-ids"
  mas_outcomes="$runner_receipt_dir/mas-outcomes"
  chmod 600 "$mas_installed" "$mas_outdated" "$mas_post_installed" "$mas_remaining"
  : >"$mas_installed_items"
  : >"$mas_outdated_items"
  : >"$mas_remaining_items"
  : >"$mas_post_installed_items"
  : >"$mas_installed_ids"
  : >"$mas_outdated_ids"
  : >"$mas_remaining_ids"
  : >"$mas_post_installed_ids"
  : >"$mas_attempted_ids"
  : >"$mas_timed_out_ids"
  : >"$mas_failed_ids"
  : >"$mas_action_required_ids"
  : >"$mas_outcomes"
  run_foreground_mas_authorization() {
    local label="$1" seconds="$2" pid_file deadline_file done_file
    local watchdog status=0 timed_out=0 interrupted=0
    local saved_hup saved_int saved_term
    saved_hup="$(trap -p HUP || true)"
    saved_int="$(trap -p INT || true)"
    saved_term="$(trap -p TERM || true)"
    pid_file="$(mktemp "$runner_receipt_dir/mas-auth-pid.XXXXXX")"
    deadline_file="${pid_file}.deadline"
    done_file="${pid_file}.done"
    (
      local started now auth_pid descendants pid
      started="$(date +%s)"
      while [[ ! -s "$pid_file" && ! -e "$done_file" ]]; do
        now="$(date +%s)"
        if [[ "$now" -ge $((started + seconds)) ]]; then
          : >"$deadline_file"
          exit 0
        fi
        sleep 0.1
      done
      [[ ! -e "$done_file" && -s "$pid_file" ]] || exit 0
      auth_pid="$(cat "$pid_file" 2>/dev/null || true)"
      [[ "$auth_pid" =~ ^[1-9][0-9]*$ ]] || {
        : >"$deadline_file"
        exit 0
      }
      while kill -0 "$auth_pid" 2>/dev/null && [[ ! -e "$done_file" ]]; do
        now="$(date +%s)"
        if [[ "$now" -ge $((started + seconds)) ]]; then
          echo "  Groundwork: $label exceeded its ${seconds}s hard deadline; cancelling its owned process tree." >&2
          descendants="$(LC_ALL=C ps -eo pid=,ppid= 2>/dev/null | awk -v root="$auth_pid" '
            { pid[NR]=$1; parent[NR]=$2 }
            END {
              owned[root]=1
              for (pass=1; pass<=NR; pass++)
                for (i=1; i<=NR; i++)
                  if (owned[parent[i]]) owned[pid[i]]=1
              for (i=1; i<=NR; i++) if (owned[pid[i]] && pid[i] != root) print pid[i]
            }')"
          for pid in $descendants; do kill -TERM "$pid" 2>/dev/null || true; done
          kill -TERM "$auth_pid" 2>/dev/null || true
          sleep "$mas_auth_kill_grace"
          for pid in $descendants; do kill -KILL "$pid" 2>/dev/null || true; done
          kill -KILL "$auth_pid" 2>/dev/null || true
          : >"$deadline_file"
          exit 0
        fi
        sleep 0.1
      done
    ) &
    watchdog=$!
    trap 'interrupted=129' HUP
    trap 'interrupted=130' INT
    trap 'interrupted=143' TERM
    # This wrapper is deliberately foreground. It inherits the caller's
    # foreground terminal process group, records its exact PID for the bounded
    # watchdog, then execs sudo so password input never belongs to a background
    # job or a second pseudo-terminal.
    /bin/sh -c 'printf "%s\n" "$$" >"$1"; shift; exec "$@"' \
      groundwork-mas-auth "$pid_file" sudo -v <&7 >&6 2>&6 || status=$?
    : >"$done_file"
    wait "$watchdog" 2>/dev/null || true
    if [[ -n "$saved_hup" ]]; then eval "$saved_hup"; else trap - HUP; fi
    if [[ -n "$saved_int" ]]; then eval "$saved_int"; else trap - INT; fi
    if [[ -n "$saved_term" ]]; then eval "$saved_term"; else trap - TERM; fi
    [[ -e "$deadline_file" ]] && timed_out=1
    rm -f -- "$pid_file" "$deadline_file" "$done_file"
    if [[ "$interrupted" -ne 0 ]]; then
      return "$interrupted"
    fi
    if [[ "$timed_out" -eq 1 ]]; then
      return 124
    fi
    return "$status"
  }
  select_mas_installed_items() {
    local label="$1" input_file="$2" items_file="$3" ids_file="$4"
    if [[ ! -s "$input_file" ]]; then
      : >"$items_file"
    elif ! jq -er '
        def safe_text:
          type == "string" and length > 0 and
          (test("[\\x00-\\x1F\\x7F]") | not);
        # mas renamed these in 7.0.0: trackId -> adamID, trackName -> name.
        # Accept either spelling so one installed mas version does not decide
        # whether App Store updates run at all, and keep every validation --
        # the identifier must still be a whole number, and both text fields
        # must still be non-empty and free of control characters.
        (.adamID // .trackId) as $id
        | (.name // .trackName) as $label
        | if type == "object" and
            ($id | type == "number" and . == floor) and
            ($label | safe_text) and (.version | safe_text)
          then [($id | tostring), $label, .version] | @tsv
          else error("invalid mas installed object")
          end
      ' "$input_file" >"$items_file"; then
      printf 'Groundwork: Mac App Store returned a malformed %s item; no App Store update was attempted.\n' \
        "$label" >&2
      return 1
    fi
    cut -f 1 "$items_file" >"$ids_file"
    if [[ -n "$(LC_ALL=C sort "$ids_file" | uniq -d)" ]]; then
      printf 'Groundwork: Mac App Store returned a duplicate %s ID; no App Store update was attempted.\n' \
        "$label" >&2
      return 1
    fi
  }
  select_mas_outdated_items() {
    local label="$1" input_file="$2" items_file="$3" ids_file="$4"
    if [[ ! -s "$input_file" ]]; then
      : >"$items_file"
    elif ! jq -er '
        def safe_text:
          type == "string" and length > 0 and
          (test("[\\x00-\\x1F\\x7F]") | not);
        if type == "object" and
          (.trackId | type == "number" and . == floor) and
          (.trackName | safe_text) and (.version | safe_text) and
          (.newVersion | safe_text)
        then [(.trackId | tostring), .trackName, .version, .newVersion] | @tsv
        else error("invalid mas outdated object")
        end
      ' "$input_file" >"$items_file"; then
      printf 'Groundwork: Mac App Store returned a malformed %s item; no App Store update was attempted.\n' \
        "$label" >&2
      return 1
    fi
    cut -f 1 "$items_file" >"$ids_file"
    if [[ -n "$(LC_ALL=C sort "$ids_file" | uniq -d)" ]]; then
      printf 'Groundwork: Mac App Store returned a duplicate %s ID; no App Store update was attempted.\n' \
        "$label" >&2
      return 1
    fi
  }
  mas_version_status=0
  mas_version="$(mas version 2>/dev/null)" || mas_version_status=$?
  if [[ "$mas_version_status" -ne 0 || ! "$mas_version" =~ ^7[.] ]]; then
    printf 'Groundwork: Mac App Store JSON inventory requires reviewed mas 7.x; observed %s. No App Store update was attempted.\n' \
      "${mas_version:-unavailable}" >&2
    mas_status=1
  fi
  runner_temp="$mas_installed"
  if [[ "$mas_status" -eq 0 ]]; then
    run_bounded_internal "inventory Mac App Store applications" "$mas_observe_deadline" \
      "$mas_installed" mas list --json || mas_status=$?
  fi
  case "$mas_status" in 125 | 129 | 130 | 143) exit "$mas_status" ;; esac
  if [[ "$mas_status" -eq 0 ]]; then
    select_mas_installed_items "installed" "$mas_installed" "$mas_installed_items" \
      "$mas_installed_ids" || mas_status=$?
  fi
  if [[ "$mas_status" -eq 0 ]]; then
    run_bounded_internal "check Mac App Store updates" "$mas_observe_deadline" \
      "$mas_outdated" mas outdated --json --inaccurate || mas_status=$?
    case "$mas_status" in 125 | 129 | 130 | 143) exit "$mas_status" ;; esac
  fi
  if [[ "$mas_status" -eq 0 ]]; then
    select_mas_outdated_items "outdated" "$mas_outdated" "$mas_outdated_items" \
      "$mas_outdated_ids" || mas_status=$?
  fi
  if [[ "$mas_status" -eq 0 ]] \
    && [[ -n "$(comm -23 <(LC_ALL=C sort "$mas_outdated_ids") <(LC_ALL=C sort "$mas_installed_ids"))" ]]; then
    echo "Groundwork: Mac App Store's outdated result was outside the exact installed ID set; no App Store update was attempted." >&2
    mas_status=1
  fi
  if [[ "$mas_status" -eq 0 && -s "$mas_outdated_ids" ]]; then
    mark_update_pending "mac-app-store" \
      "Mac App Store update started, but completion has not been proven"
    while IFS= read -r mas_id; do
      [[ -n "$mas_id" ]] || continue
      mas_name="$(awk -F '\t' -v wanted="$mas_id" \
        '$1 == wanted { print $2; exit }' "$mas_installed_items")"
      mas_pre_version="$(awk -F '\t' -v wanted="$mas_id" \
        '$1 == wanted { print $3; exit }' "$mas_installed_items")"
      mas_outdated_name="$(awk -F '\t' -v wanted="$mas_id" \
        '$1 == wanted { print $2; exit }' "$mas_outdated_items")"
      mas_outdated_from="$(awk -F '\t' -v wanted="$mas_id" \
        '$1 == wanted { print $3; exit }' "$mas_outdated_items")"
      mas_target_version="$(awk -F '\t' -v wanted="$mas_id" \
        '$1 == wanted { print $4; exit }' "$mas_outdated_items")"
      [[ -n "$mas_name" && -n "$mas_pre_version" \
        && "$mas_outdated_name" == "$mas_name" \
        && "$mas_outdated_from" == "$mas_pre_version" \
        && -n "$mas_target_version" ]] || {
        printf 'Groundwork: Mac App Store app ID %s lost its installed identity before update.\n' \
          "$mas_id" >&2
        mas_unexplained_count=$((mas_unexplained_count + 1))
        printf '%s\tunexplained\t65\tidentity-mismatch\n' "$mas_id" >>"$mas_outcomes"
        [[ "$mas_status" -ne 0 ]] || mas_status=1
        continue
      }
      if [[ "$groundwork_interactive_tty_available" -ne 1 ]]; then
        printf '%s\n' "$mas_id" >>"$mas_action_required_ids"
        mas_action_required_count=$((mas_action_required_count + 1))
        printf 'Groundwork action required: Mac App Store update for %s (ID %s) needs an interactive terminal for macOS authorization.\n' \
          "$mas_name" "$mas_id" >&2
        printf '  Run interactively: sudo -v && sudo -n mas update %s\n' "$mas_id" >&2
        printf '%s\taction-required\t0\tnot-started\n' "$mas_id" >>"$mas_outcomes"
        [[ "$mas_status" -ne 0 ]] || mas_status=1
        continue
      fi
      if ! command -v sudo >/dev/null 2>&1; then
        printf '%s\n' "$mas_id" >>"$mas_action_required_ids"
        mas_action_required_count=$((mas_action_required_count + 1))
        printf 'Groundwork action required: attached authorization support is unavailable for Mac App Store update %s (ID %s).\n' \
          "$mas_name" "$mas_id" >&2
        printf '%s\taction-required\t127\tnot-started\n' "$mas_id" >>"$mas_outcomes"
        [[ "$mas_status" -ne 0 ]] || mas_status=1
        continue
      fi
      printf 'Groundwork: authorize Mac App Store update for %s (ID %s).\n' \
        "$mas_name" "$mas_id"
      mas_auth_status=0
      run_foreground_mas_authorization \
        "Mac App Store authorization for $mas_name (ID $mas_id)" \
        "$mas_auth_deadline" || mas_auth_status=$?
      case "$mas_auth_status" in
        125 | 129 | 130 | 143)
          append_maintenance_receipt mas-app "$mas_id" "$mas_name" \
            "$mas_pre_version" "$mas_target_version" cancelled \
            "$mas_auth_status" authorization "not-observed" unknown \
            || exit 1
          exit "$mas_auth_status"
          ;;
      esac
      if [[ "$mas_auth_status" -ne 0 ]]; then
        printf '%s\n' "$mas_id" >>"$mas_action_required_ids"
        mas_action_required_count=$((mas_action_required_count + 1))
        printf 'Groundwork action required: macOS authorization did not complete for %s (ID %s; exit %s); continuing with the next exact app.\n' \
          "$mas_name" "$mas_id" "$mas_auth_status" >&2
        printf '%s\taction-required\t%s\tauthorization\n' \
          "$mas_id" "$mas_auth_status" >>"$mas_outcomes"
        [[ "$mas_status" -ne 0 ]] || mas_status=1
        continue
      fi
      printf '%s\n' "$mas_id" >>"$mas_attempted_ids"
      mas_attempted_count=$((mas_attempted_count + 1))
      printf 'Groundwork: Mac App Store update: %s (ID %s; deadline %ss).\n' \
        "$mas_name" "$mas_id" "$mas_app_deadline"
      mark_update_pending "mac-app-store" \
        "Mac App Store app $mas_name (ID $mas_id) is being updated"
      mas_app_status=0
      run_bounded_internal "Mac App Store update for $mas_name (ID $mas_id)" \
        "$mas_app_deadline" "" sudo -n mas update "$mas_id" || mas_app_status=$?
      case "$mas_app_status" in
        0)
          printf '%s\tcommand-succeeded\t0\texited\n' "$mas_id" >>"$mas_outcomes"
          ;;
        124)
          printf '%s\n' "$mas_id" >>"$mas_timed_out_ids"
          mas_timed_out_count=$((mas_timed_out_count + 1))
          printf 'Groundwork: Mac App Store update timed out for %s (ID %s); continuing with the next exact app.\n' \
            "$mas_name" "$mas_id" >&2
          printf '%s\ttimed-out\t124\ttimed-out\n' "$mas_id" >>"$mas_outcomes"
          [[ "$mas_status" -ne 0 ]] || mas_status=1
          ;;
        125 | 129 | 130 | 143)
          append_maintenance_receipt mas-app "$mas_id" "$mas_name" \
            "$mas_pre_version" "$mas_target_version" cancelled \
            "$mas_app_status" mutation "not-observed" unknown \
            || exit 1
          exit "$mas_app_status"
          ;;
        *)
          printf '%s\n' "$mas_id" >>"$mas_failed_ids"
          mas_failed_count=$((mas_failed_count + 1))
          printf 'Groundwork: Mac App Store update failed for %s (ID %s; exit %s); continuing with the next exact app.\n' \
            "$mas_name" "$mas_id" "$mas_app_status" >&2
          printf '%s\tfailed\t%s\texited\n' "$mas_id" "$mas_app_status" >>"$mas_outcomes"
          [[ "$mas_status" -ne 0 ]] || mas_status="$mas_app_status"
          ;;
      esac
    done <"$mas_outdated_ids"
  fi
  mas_observe_status=0
  run_bounded_internal "re-inventory Mac App Store applications" "$mas_observe_deadline" \
    "$mas_post_installed" mas list --json || mas_observe_status=$?
  case "$mas_observe_status" in 125 | 129 | 130 | 143) exit "$mas_observe_status" ;; esac
  if [[ "$mas_observe_status" -eq 0 ]]; then
    select_mas_installed_items "post-update installed" "$mas_post_installed" \
      "$mas_post_installed_items" "$mas_post_installed_ids" \
      || mas_observe_status=$?
  fi
  if [[ "$mas_observe_status" -eq 0 ]]; then
    run_bounded_internal "verify Mac App Store updates" "$mas_observe_deadline" \
      "$mas_remaining" mas outdated --json --inaccurate || mas_observe_status=$?
  fi
  case "$mas_observe_status" in 125 | 129 | 130 | 143) exit "$mas_observe_status" ;; esac
  if [[ "$mas_observe_status" -eq 0 ]]; then
    select_mas_outdated_items "remaining outdated" "$mas_remaining" \
      "$mas_remaining_items" "$mas_remaining_ids" || mas_observe_status=$?
  fi
  if [[ "$mas_observe_status" -eq 0 ]]; then
    mas_unknown_ids="$(comm -23 <(LC_ALL=C sort "$mas_remaining_ids") \
      <(LC_ALL=C sort "$mas_post_installed_ids"))"
    if [[ -n "$mas_unknown_ids" ]]; then
      unknown_count="$(printf '%s\n' "$mas_unknown_ids" | awk 'NF { count++ } END { print count + 0 }')"
      mas_unexplained_count=$((mas_unexplained_count + unknown_count))
      echo "Groundwork: Mac App Store's post-update result contained IDs outside the authenticated post-update installed set." >&2
      [[ "$mas_status" -ne 0 ]] || mas_status=1
    fi
    while IFS= read -r mas_id; do
      [[ -n "$mas_id" ]] || continue
      mas_name="$(awk -F '\t' -v wanted="$mas_id" '$1 == wanted { print $2; exit }' \
        "$mas_installed_items")"
      mas_pre_version="$(awk -F '\t' -v wanted="$mas_id" '$1 == wanted { print $3; exit }' \
        "$mas_installed_items")"
      mas_target_version="$(awk -F '\t' -v wanted="$mas_id" '$1 == wanted { print $4; exit }' \
        "$mas_outdated_items")"
      mas_post_name="$(awk -F '\t' -v wanted="$mas_id" '$1 == wanted { print $2; exit }' \
        "$mas_post_installed_items")"
      mas_post_version="$(awk -F '\t' -v wanted="$mas_id" '$1 == wanted { print $3; exit }' \
        "$mas_post_installed_items")"
      mas_outcome_row="$(awk -F '\t' -v wanted="$mas_id" '$1 == wanted { count++; row=$0 } END { if (count == 1) print row; else exit 1 }' \
        "$mas_outcomes" 2>/dev/null || true)"
      IFS=$'\t' read -r _mas_outcome_id mas_command_outcome mas_command_status \
        mas_termination <<<"$mas_outcome_row"
      [[ -n "$mas_command_outcome" ]] || {
        mas_command_outcome="not-attempted"
        mas_command_status="0"
        mas_termination="not-started"
      }
      if [[ -z "$mas_post_name" || -z "$mas_post_version" \
        || "$mas_post_name" != "$mas_name" ]]; then
        mas_unexplained_count=$((mas_unexplained_count + 1))
        printf 'Groundwork: Mac App Store app %s (ID %s) lost or changed its installed identity after update.\n' \
          "$mas_name" "$mas_id" >&2
        append_maintenance_receipt mas-app "$mas_id" "$mas_name" \
          "$mas_pre_version" "$mas_target_version" "$mas_command_outcome" \
          "$mas_command_status" "$mas_termination" "missing-or-changed" unknown \
          || mas_observe_status=1
        [[ "$mas_status" -ne 0 ]] || mas_status=1
        continue
      fi
      if grep -qxF -- "$mas_id" "$mas_remaining_ids"; then
        mas_post_outdated=remaining
        mas_remaining_count=$((mas_remaining_count + 1))
        printf 'Groundwork failed: Mac App Store still reports %s (ID %s) outdated at installed version %s.\n' \
          "$mas_name" "$mas_id" "$mas_post_version" >&2
        [[ "$mas_status" -ne 0 ]] || mas_status=1
      else
        mas_post_outdated=not-reported
        if [[ "$mas_post_version" != "$mas_pre_version" ]]; then
          mas_verified_updated_count=$((mas_verified_updated_count + 1))
          printf 'Groundwork verified: %s (ID %s) changed from %s to %s and is no longer reported outdated.\n' \
            "$mas_name" "$mas_id" "$mas_pre_version" "$mas_post_version"
        else
          mas_no_longer_outdated_count=$((mas_no_longer_outdated_count + 1))
          printf 'Groundwork current: %s (ID %s) is no longer reported outdated; installed version remained %s, so no update is claimed.\n' \
            "$mas_name" "$mas_id" "$mas_post_version"
        fi
      fi
      append_maintenance_receipt mas-app "$mas_id" "$mas_name" \
        "$mas_pre_version" "$mas_target_version" "$mas_command_outcome" \
        "$mas_command_status" "$mas_termination" "$mas_post_version" \
        "$mas_post_outdated" || mas_observe_status=1
    done <"$mas_outdated_ids"
  else
    mas_unexplained_count=$((mas_unexplained_count + 1))
    [[ "$mas_status" -ne 0 ]] || mas_status="$mas_observe_status"
    echo "Groundwork: Mac App Store post-update installed/version state could not be verified." >&2
  fi
  [[ "$mas_observe_status" -eq 0 ]] || {
    [[ "$mas_status" -ne 0 ]] || mas_status="$mas_observe_status"
  }
  if [[ "$mas_status" -eq 0 && "$mas_remaining_count" -eq 0 \
    && "$mas_timed_out_count" -eq 0 && "$mas_failed_count" -eq 0 \
    && "$mas_action_required_count" -eq 0 && "$mas_unexplained_count" -eq 0 ]]; then
    clear_update_pending "mac-app-store"
    if [[ "$mas_verified_updated_count" -gt 0 ]]; then
      mas_lane_status="updated-and-verified"
    elif [[ "$mas_no_longer_outdated_count" -gt 0 ]]; then
      mas_lane_status="current-after-recheck"
    else
      mas_lane_status="current"
    fi
  else
    mark_update_pending "mac-app-store" \
      "Mac App Store incomplete: attempted=$mas_attempted_count verified=$mas_verified_updated_count remaining=$mas_remaining_count timed-out=$mas_timed_out_count failed=$mas_failed_count action-required=$mas_action_required_count unexplained=$mas_unexplained_count"
    mas_lane_status="failed"
  fi
  rm -f -- "$mas_installed" "$mas_outdated" "$mas_post_installed" "$mas_remaining" \
    "$mas_installed_items" "$mas_outdated_items" "$mas_post_installed_items" \
    "$mas_remaining_items" "$mas_installed_ids" "$mas_outdated_ids" \
    "$mas_post_installed_ids" "$mas_remaining_ids" \
    "$mas_attempted_ids" "$mas_timed_out_ids" "$mas_failed_ids" \
    "$mas_action_required_ids" "$mas_outcomes"
  runner_temp=""
  case "$mas_status" in 125 | 129 | 130 | 143) exit "$mas_status" ;; esac
fi
{{- end }}

update_status="$homebrew_status"
if [[ "$mas_status" -ne 0 && "$update_status" -eq 0 ]]; then
  update_status="$mas_status"
fi
mise_lane_status="skipped"
mise_status=0
if [[ "$homebrew_mutation_failed" -eq 1 ]]; then
  echo "Groundwork: mise upgrades were skipped because Homebrew mutation failed." >&2
elif command -v mise >/dev/null 2>&1; then
  # The same 5-day floor the renovate-config preset applies to repo
  # dependencies, now applied to the machine: don't adopt a release the world
  # has not had time to notice was poisoned. It filters only fuzzy versions
  # (`lts`, `latest`); an explicitly pinned version is exempt, which is the
  # escape hatch for a security fix that must land immediately.
  if ! mise upgrade --help 2>/dev/null | grep -q -- '--minimum-release-age'; then
    # Fail closed. A policy that steps aside whenever it cannot be enforced is
    # not a control. The escape hatch for an urgent release already exists and
    # is narrow: pin that one runtime to an exact version, which the floor
    # exempts by design — no need for a second hatch that ungates everything.
    cat >&2 <<'EOF'
Groundwork: this mise cannot enforce the 5-day release floor
(--minimum-release-age is missing), so runtime upgrades were skipped.

  Upgrade mise, then run update-all again:  brew upgrade mise
  Urgent security release? Pin that exact runtime version; pinned versions
  bypass the floor by design.
EOF
    mise_status=1
  else
    mise upgrade --minimum-release-age 5d || mise_status=$?
  fi
  case "$mise_status" in
    129 | 130 | 143) exit "$mise_status" ;;
  esac
  if [[ "$mise_status" -eq 0 ]]; then
    mise_lane_status="current-or-updated"
  else
    mise_lane_status="failed"
    [[ "$update_status" -ne 0 ]] || update_status="$mise_status"
  fi
fi

# Supported package-manager cleanup is one stage with one receipt and durable
# per-manager pending state. It runs after every required upgrade lane was
# attempted. A failed mise lane does not suppress safe Homebrew, npm, or pnpm
# maintenance; the final receipt remains nonzero for either kind of failure.
# Independent cleanup lanes continue after one fails; their helper returns
# nonzero only after recording every outcome. --skip-maintenance is the
# exceptional fast path and never clears older pending work.
maintenance_pending() {
  local pending_dir="$HOME/.local/state/groundwork/update-all-pending" pending_file
  [[ -f "$HOME/.local/state/groundwork/homebrew-cleanup-pending" ]] && return 0
  [[ -d "$pending_dir" ]] || return 1
  for pending_file in "$pending_dir"/*; do
    [[ -f "$pending_file" ]] && return 0
  done
  return 1
}

maintenance_manager_pending() {
  local pending_dir="$HOME/.local/state/groundwork/update-all-pending" pending_file
  [[ -d "$pending_dir" ]] || return 1
  for pending_file in "$pending_dir"/homebrew "$pending_dir"/npm "$pending_dir"/pnpm; do
    [[ -f "$pending_file" ]] && return 0
  done
  return 1
}

mark_maintenance_helper_pending() {
  local pending="$HOME/.local/state/groundwork/update-all-pending/maintenance-helper"
  local temporary="${pending}.tmp.$$"
  mkdir -p "$(dirname "$pending")"
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >"$temporary"
  mv -f -- "$temporary" "$pending"
}

clear_maintenance_helper_pending() {
  local pending_dir="$HOME/.local/state/groundwork/update-all-pending"
  rm -f -- "$pending_dir/maintenance-helper"
  rmdir "$pending_dir" 2>/dev/null || true
}

maintenance_status=0
maintenance_homebrew="skipped"
maintenance_npm="skipped"
maintenance_pnpm="skipped"
owner_review_count=0
if [[ "$homebrew_status" -ne 0 ]]; then
  maintenance_homebrew="skipped · Homebrew update failed"
  maintenance_npm="skipped · upstream update failed"
  maintenance_pnpm="skipped · upstream update failed"
  echo
  echo "Package-manager maintenance skipped because Homebrew inventory or update failed."
  if maintenance_pending; then
    maintenance_status=1
    echo "Groundwork: earlier package-manager maintenance is still pending." >&2
  fi
elif [[ "$skip_maintenance" -eq 1 ]]; then
  echo
  echo "Package-manager maintenance skipped for this exceptional refresh."
  if maintenance_pending; then
    maintenance_status=1
    echo "Groundwork: earlier package-manager maintenance is still pending." >&2
  fi
elif [[ -x "$HOME/.local/bin/groundwork-cleanup" ]]; then
  # Record helper-level intent before exec so an early crash cannot disappear
  # behind a still-fresh successful update timestamp.
  mark_maintenance_helper_pending "package-manager maintenance helper started but has not completed"
  cleanup_receipt="$runner_receipt_dir/package-maintenance.tsv"
  : >"$cleanup_receipt"
  exec 9>"$cleanup_receipt"
  GROUNDWORK_CLEANUP_RECEIPT_FD=9 \
    "$HOME/.local/bin/groundwork-cleanup" --yes || maintenance_status=$?
  exec 9>&-
  cleanup_receipt_valid=1
  receipt_homebrew_seen=0
  receipt_npm_seen=0
  receipt_pnpm_seen=0
  receipt_review_seen=0
  while IFS=$'\t' read -r receipt_key receipt_value receipt_extra; do
    if [[ -n "$receipt_extra" ]]; then
      cleanup_receipt_valid=0
      break
    fi
    case "$receipt_key:$receipt_value" in
      homebrew:completed | homebrew:not-installed | homebrew:failed)
        if [[ "$receipt_homebrew_seen" -eq 1 ]]; then
          cleanup_receipt_valid=0
        else
          maintenance_homebrew="$receipt_value"
          receipt_homebrew_seen=1
        fi
        ;;
      npm:completed | npm:not-installed | npm:failed)
        if [[ "$receipt_npm_seen" -eq 1 ]]; then
          cleanup_receipt_valid=0
        else
          maintenance_npm="$receipt_value"
          receipt_npm_seen=1
        fi
        ;;
      pnpm:completed | pnpm:not-due | pnpm:failed | pnpm:unknown)
        if [[ "$receipt_pnpm_seen" -eq 1 ]]; then
          cleanup_receipt_valid=0
        else
          maintenance_pnpm="$receipt_value"
          receipt_pnpm_seen=1
        fi
        ;;
      owner-review:[0-9]*)
        if [[ "$receipt_review_seen" -eq 1 ]]; then
          cleanup_receipt_valid=0
        else
          case "$receipt_value" in
            *[!0-9]*) cleanup_receipt_valid=0 ;;
            *) owner_review_count="$receipt_value"; receipt_review_seen=1 ;;
          esac
        fi
        ;;
      *)
        cleanup_receipt_valid=0
        ;;
    esac
  done <"$cleanup_receipt"
  if [[ "$cleanup_receipt_valid" -ne 1 || "$receipt_homebrew_seen" -ne 1 \
    || "$receipt_npm_seen" -ne 1 || "$receipt_pnpm_seen" -ne 1 \
    || "$receipt_review_seen" -ne 1 ]]; then
    [[ "$maintenance_status" -ne 0 ]] || maintenance_status=1
    mark_maintenance_helper_pending "package-manager maintenance returned a missing or malformed receipt"
    echo "Groundwork: package-manager maintenance returned a missing or malformed receipt." >&2
  fi
  if [[ "$maintenance_status" -eq 0 ]]; then
    clear_maintenance_helper_pending
  elif maintenance_manager_pending; then
    # The helper recorded a more precise per-manager failure.
    clear_maintenance_helper_pending
  else
    mark_maintenance_helper_pending "package-manager maintenance helper failed before recording a manager stage (exit $maintenance_status)"
  fi
else
  maintenance_status=1
  mark_maintenance_helper_pending "package-manager maintenance helper is missing"
  echo "Groundwork: the package-manager maintenance helper is missing: $HOME/.local/bin/groundwork-cleanup" >&2
fi
case "$maintenance_status" in
  129 | 130 | 143) exit "$maintenance_status" ;;
esac

# Docker scratch maintenance is a separate bounded lane. The helper owns the
# shared lock borrow, per-Docker-call deadlines and cancellation, candidate
# re-checks, durable pending state, and direct-repair clearing. Automatic mode
# uses only managed code, the canonical grace, and a verified local endpoint.
# Daemon-wide cleanup remains structurally absent from update-all.
docker_pending="$HOME/.local/state/groundwork/docker-tidy-pending"
docker_maintenance_result="skipped"
docker_backend="none"
{{- if and (eq .chezmoi.os "darwin") (not .headless) }}
{{- if .work }}
docker_backend="colima"
{{- else }}
docker_backend="docker-desktop"
{{- end }}
{{- end }}
docker_start_deadline="${GROUNDWORK_DOCKER_START_DEADLINE_SECONDS:-180}"
docker_stop_deadline="${GROUNDWORK_DOCKER_STOP_DEADLINE_SECONDS:-120}"
docker_ready_deadline="${GROUNDWORK_DOCKER_READY_DEADLINE_SECONDS:-90}"
docker_probe_deadline="${GROUNDWORK_DOCKER_PROBE_DEADLINE_SECONDS:-8}"
for docker_deadline in "$docker_start_deadline" "$docker_stop_deadline" \
  "$docker_ready_deadline" "$docker_probe_deadline"; do
  if [[ ! "$docker_deadline" =~ ^[0-9]+$ || "$docker_deadline" -lt 1 ]]; then
    echo "Groundwork: Docker lifecycle deadlines must be positive integers." >&2
    exit 64
  fi
done

docker_runner_lib="$HOME/.local/share/groundwork/lib/maintenance-runner.sh"
if [[ ! -r "$docker_runner_lib" ]]; then
  echo "Groundwork: the bounded Docker lifecycle runner is missing: $docker_runner_lib" >&2
  exit 1
fi
# shellcheck disable=SC2034 # These globals are the sourced runner library's API.
declare deadline="$docker_start_deadline" \
  observe_deadline="$docker_probe_deadline" \
  heartbeat=15 \
  cancel_grace=2 \
  poll_seconds=0.2 \
  orphan_grace=5
# shellcheck source=/dev/null
. "$docker_runner_lib"

mark_docker_pending() {
  local temporary="${docker_pending}.tmp.$$"
  mkdir -p "$(dirname "$docker_pending")"
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >"$temporary"
  mv -f -- "$temporary" "$docker_pending"
}

docker_backend_label() {
  case "$docker_backend" in
    docker-desktop) printf 'Docker Desktop' ;;
    colima) printf 'Colima' ;;
    *) printf 'Docker runtime' ;;
  esac
}

docker_context_is_canonical_local() {
  local context_output context_status=0
  [[ -z "${DOCKER_HOST:-}" && -z "${DOCKER_CONTEXT:-}" && -z "${DOCKER_CONFIG:-}" ]] || return 1
  command -v docker >/dev/null 2>&1 || return 1
  context_output="$(mktemp "${TMPDIR:-/tmp}/groundwork-docker-context.XXXXXX")"
  runner_temp="$context_output"
  run_bounded_internal "inspect the selected Docker context" "$docker_probe_deadline" \
    "$context_output" docker context inspect --format '{{"{{"}}.Endpoints.docker.Host{{"}}"}}' \
    || context_status=$?
  if [[ "$context_status" -eq 0 ]] \
    && ! LC_ALL=C grep -q '[[:cntrl:]]' "$context_output" \
    && grep -Eq '^unix://[^[:space:]]+$' "$context_output"; then
    rm -f -- "$context_output"
    runner_temp=""
    return 0
  fi
  rm -f -- "$context_output"
  runner_temp=""
  return 1
}

docker_backend_is_manageable() {
  local status=0
  case "$docker_backend" in
    docker-desktop)
      run_bounded_internal "verify Docker Desktop lifecycle support" "$docker_probe_deadline" "" \
        docker desktop start --help >/dev/null 2>&1 || status=$?
      ;;
    colima)
      command -v colima >/dev/null 2>&1 || return 1
      run_bounded_internal "verify Colima lifecycle support" "$docker_probe_deadline" "" \
        colima start --help >/dev/null 2>&1 || status=$?
      ;;
    *) return 1 ;;
  esac
  [[ "$status" -eq 0 ]]
}

prompt_start_docker_backend() {
  local answer
  [[ "$groundwork_interactive_tty_available" -eq 1 ]] || return 2
  while true; do
    printf 'Start %s temporarily for Groundwork scratch maintenance? [y/N] ' \
      "$(docker_backend_label)" >&6
    if ! read -r -u 7 answer; then
      echo >&6
      return 1
    fi
    case "$answer" in
      y | Y | [yY][eE][sS])
        return 0
        ;;
      "" | n | N | [nN][oO])
        return 1
        ;;
      *) echo "Please answer yes or no." >&6 ;;
    esac
  done
}

start_docker_backend() {
  docker_backend_restore_required=1
  case "$docker_backend" in
    docker-desktop)
      run_bounded_internal "start Docker Desktop" "$docker_start_deadline" "" \
        docker desktop start --timeout "$docker_start_deadline"
      ;;
    colima)
      # --runtime docker is stated here as well as in the template: this start
      # is unattended maintenance, and it must not depend on an existing
      # instance's stored runtime or on a template a user may have edited.
      run_bounded_internal "start Colima" "$docker_start_deadline" "" \
        colima start --runtime docker
      ;;
    *) return 1 ;;
  esac
}

restore_docker_backend() {
  local status=0
  [[ "$docker_backend_restore_required" -eq 1 ]] || return 0
  case "$docker_backend" in
    docker-desktop)
      run_bounded_internal "stop Docker Desktop" "$docker_stop_deadline" "" \
        docker desktop stop --timeout "$docker_stop_deadline" || status=$?
      ;;
    colima)
      run_bounded_internal "stop Colima" "$docker_stop_deadline" "" colima stop || status=$?
      ;;
    *) status=1 ;;
  esac
  if [[ "$status" -eq 0 ]]; then
    docker_backend_restore_required=0
    printf 'Groundwork: restored %s to its original stopped state.\n' "$(docker_backend_label)"
  fi
  return "$status"
}

wait_for_docker_ready() {
  local started now next_notice probe_status probe_output
  # Bash's monotonic per-process counter keeps the readiness budget independent
  # of wall-clock jumps and of the fixed policy clock used by fixtures.
  started="$SECONDS"
  next_notice=$((started + 15))
  probe_output="$(mktemp "${TMPDIR:-/tmp}/groundwork-docker-ready.XXXXXX")"
  runner_temp="$probe_output"
  while true; do
    probe_status=0
    run_bounded_internal "probe Docker readiness" "$docker_probe_deadline" \
      "$probe_output" docker info || probe_status=$?
    if [[ "$probe_status" -eq 0 ]]; then
      rm -f -- "$probe_output"
      runner_temp=""
      return 0
    fi
    case "$probe_status" in 125 | 129 | 130 | 143) return "$probe_status" ;; esac
    now="$SECONDS"
    if [[ "$now" -ge $((started + docker_ready_deadline)) ]]; then
      echo "Groundwork: Docker did not become ready within ${docker_ready_deadline}s." >&2
      rm -f -- "$probe_output"
      runner_temp=""
      return 124
    fi
    if [[ "$now" -ge "$next_notice" ]]; then
      echo "  Still waiting for Docker readiness ($((now - started))s elapsed)" >&2
      next_notice=$((now + 15))
    fi
    sleep 1
  done
}

docker_maintenance_status=0
if [[ "$homebrew_status" -ne 0 ]]; then
  docker_maintenance_result="skipped-upstream-failure"
  echo "Docker scratch maintenance skipped because the required Homebrew lane failed."
  if [[ -f "$docker_pending" ]]; then
    docker_maintenance_status=1
    echo "Groundwork: earlier Docker scratch maintenance is still pending." >&2
  fi
elif [[ "$skip_maintenance" -eq 1 ]]; then
  docker_maintenance_result="skipped"
  echo "Docker scratch maintenance skipped for this exceptional refresh."
  if [[ -f "$docker_pending" ]]; then
    docker_maintenance_status=1
    echo "Groundwork: earlier Docker scratch maintenance is still pending." >&2
  fi
elif [[ -x "$HOME/.local/bin/groundwork-docker-tidy" ]]; then
  docker_pending_before=0
  [[ -f "$docker_pending" ]] && docker_pending_before=1
  "$HOME/.local/bin/groundwork-docker-tidy" --automatic || docker_maintenance_status=$?
  if [[ "$docker_maintenance_status" -eq 3 ]]; then
    docker_maintenance_status=0
    if [[ "$docker_backend" != "none" ]] && docker_context_is_canonical_local \
      && docker_backend_is_manageable; then
      printf '%s is installed but not running.\n' "$(docker_backend_label)"
      prompt_status=0
      prompt_start_docker_backend || prompt_status=$?
      if [[ "$prompt_status" -eq 0 ]]; then
        start_status=0
        start_docker_backend || start_status=$?
        case "$start_status" in 125 | 129 | 130 | 143) exit "$start_status" ;; esac
        if [[ "$start_status" -eq 0 ]]; then
          wait_for_docker_ready || start_status=$?
        fi
        if [[ "$start_status" -eq 0 ]]; then
          "$HOME/.local/bin/groundwork-docker-tidy" --automatic \
            || docker_maintenance_status=$?
          if [[ "$docker_maintenance_status" -eq 0 ]]; then
            docker_maintenance_result="completed"
          fi
        else
          docker_maintenance_status="$start_status"
          mark_docker_pending "$(docker_backend_label) could not be started and verified for Docker scratch maintenance (exit $start_status)"
        fi
        restore_status=0
        restore_docker_backend || restore_status=$?
        if [[ "$restore_status" -ne 0 ]]; then
          [[ "$docker_maintenance_status" -ne 0 ]] || docker_maintenance_status="$restore_status"
          mark_docker_pending "$(docker_backend_label) could not be restored to its original stopped state (exit $restore_status)"
        fi
      elif [[ "$prompt_status" -eq 2 ]]; then
        echo "Groundwork: Docker scratch maintenance skipped because $(docker_backend_label) was stopped and no interactive terminal was available."
      else
        echo "Groundwork: Docker scratch maintenance skipped; $(docker_backend_label) remains stopped."
      fi
    else
      echo "Groundwork: Docker scratch maintenance skipped because no safe managed local backend was available."
    fi
    if [[ "$docker_maintenance_status" -eq 0 \
      && ( "$docker_pending_before" -eq 1 || -f "$docker_pending" ) ]]; then
      docker_maintenance_status=1
      echo "Groundwork: earlier Docker scratch maintenance remains pending." >&2
    elif [[ "$docker_maintenance_status" -eq 0 \
      && "$docker_maintenance_result" != "completed" ]]; then
      docker_maintenance_result="skipped-runtime-stopped"
      echo "Groundwork: no earlier Docker repair is pending."
    fi
  elif [[ "$docker_maintenance_status" -ne 0 && ! -f "$docker_pending" ]]; then
    mark_docker_pending "Docker scratch helper failed before recording its acting stage (exit $docker_maintenance_status)"
  elif [[ "$docker_maintenance_status" -eq 0 ]]; then
    docker_maintenance_result="completed"
  fi
else
  docker_maintenance_status=1
  mark_docker_pending "Docker scratch maintenance helper is missing"
  echo "Groundwork: the Docker scratch maintenance helper is missing: $HOME/.local/bin/groundwork-docker-tidy" >&2
fi
if [[ "$docker_maintenance_status" -ne 0 ]]; then
  docker_maintenance_result="pending-repair"
fi
case "$docker_maintenance_status" in
  124 | 125 | 129 | 130 | 143) exit "$docker_maintenance_status" ;;
esac

{{- if ne .chezmoi.os "darwin" }}

# Ownership boundary: Groundwork updates the developer environment it manages
# and never mutates the operating system it runs inside — no distro package
# upgrades on Linux, no Windows-host updates from WSL2.
case "$platform" in
  wsl2)
    echo "Groundwork updated the WSL2 development environment. Windows applications and Windows Update are managed separately on the host."
    ;;
  linux)
    echo "Groundwork updated its managed developer tools. Operating-system packages (apt, dnf, pacman) are managed separately by your distribution."
    ;;
esac
{{- end }}

{{- if and (hasKey . "xcode") .xcode (hasKey . "beta") .beta }}
# Beta channel is opt-in and only meaningful with Xcode. update-all never
# downloads betas because they require the developer's Apple Account.
if command -v xcodes >/dev/null 2>&1; then
  # shellcheck disable=SC2016 # Backticks are literal command formatting for the user.
  echo 'Groundwork: beta channel on. Xcode betas: `xcodes list` to see them, `xcodes install "<version>"` to add one, and `xcodes select` to switch.'
fi
{{- end }}

# An incomplete maintenance stage is an incomplete transaction. Earlier
# upgrades remain complete, but the success timestamp is withheld and callers
# see a nonzero status. Per-stage pending records keep the shell reminder active.
append_maintenance_receipt homebrew-summary "$homebrew_status" \
  "$brew_attempted_count" "$brew_verified_updated_count" \
  "${upgrade_log_final:-not-created}" || exit 1
append_maintenance_receipt mas-summary "$mas_status" "$mas_attempted_count" \
  "$mas_verified_updated_count" "$mas_remaining_count" "$mas_timed_out_count" \
  "$mas_failed_count" "$mas_action_required_count" \
  "$mas_no_longer_outdated_count" "$mas_unexplained_count" || exit 1
append_maintenance_receipt package-maintenance "$maintenance_status" \
  "$maintenance_homebrew" "$maintenance_npm" "$maintenance_pnpm" || exit 1
append_maintenance_receipt docker-maintenance "$docker_maintenance_status" \
  "$docker_maintenance_result" || exit 1
if [[ "$update_status" -ne 0 || "$maintenance_status" -ne 0 || "$docker_maintenance_status" -ne 0 ]]; then
  final_status="$update_status"
  [[ "$final_status" -ne 0 ]] || final_status="$maintenance_status"
  [[ "$final_status" -ne 0 ]] || final_status="$docker_maintenance_status"
  cat >&2 <<'EOF'

Groundwork update incomplete

Result
  FAILED · required work did not complete
EOF
  if [[ "$update_status" -ne 0 ]]; then
    echo "  A required upgrade stage failed (exit $update_status); run update-all again after repairing it." >&2
  fi
  if [[ "$homebrew_status" -ne 0 ]]; then
    echo "  Homebrew inventory, classification, update, or post-update verification is incomplete." >&2
    printf '  Homebrew attempted: %s exact eligible item(s)\n' \
      "$brew_attempted_count" >&2
    printf '  Homebrew verified updated: %s\n' \
      "$brew_verified_updated_count" >&2
  fi
  if [[ "$mas_status" -ne 0 ]]; then
    echo "  Mac App Store inventory or updates are incomplete." >&2
    printf '  Mac App Store attempted: %s\n' "$mas_attempted_count" >&2
    printf '  Mac App Store verified updated: %s\n' "$mas_verified_updated_count" >&2
    printf '  Mac App Store remaining: %s\n' "$mas_remaining_count" >&2
    printf '  Mac App Store timed out: %s\n' "$mas_timed_out_count" >&2
    printf '  Mac App Store failed: %s\n' "$mas_failed_count" >&2
    printf '  Mac App Store action required: %s\n' "$mas_action_required_count" >&2
    printf '  Mac App Store unexplained: %s\n' "$mas_unexplained_count" >&2
  fi
  if [[ "$maintenance_status" -ne 0 ]]; then
    cat >&2 <<'EOF'
  Package-manager maintenance is incomplete.

  Run update-all again to retry the normal maintenance transaction.

  To retry maintenance without repeating upgrades:
    groundwork-cleanup --yes

  See `groundwork-cleanup --help` for exceptional overrides.
EOF
  fi
  if [[ "$docker_maintenance_status" -ne 0 ]]; then
    cat >&2 <<'EOF'
  Docker scratch maintenance is incomplete.

  Run update-all again to retry the normal update and maintenance transaction.

  To retry only the label-scoped Docker scratch maintenance:
    groundwork-docker-tidy --yes

  If Docker was intentionally removed, acknowledge only the reminder with:
    groundwork-docker-tidy --yes --clear-pending

  Daemon-wide cleanup remains an owner-reviewed, separate command.
EOF
  fi
  if maintenance_pending || [[ -f "$docker_pending" ]]; then
    echo "  Pending repair: recorded for the next bounded retry." >&2
  fi
  exit "$final_status"
fi

{{- if eq .chezmoi.os "darwin" }}
# A successful update ends with an observable, consent-gated Karabiner health
# check. The postflight is quiet when no repair is indicated, prints the exact
# manual command without a terminal, and delegates any approved mutation to the
# helper that requires the root Core Service PID to change.
karabiner_postflight="$HOME/.local/bin/groundwork-karabiner-postflight"
if [[ ! -x "$karabiner_postflight" ]]; then
  echo "Groundwork: Karabiner postflight helper is missing: $karabiner_postflight" >&2
  echo "The refresh is not recorded as successful; run chezmoi apply, then update-all again." >&2
  exit 1
fi
karabiner_postflight_status=0
if [[ -n "$karabiner_version_before" ]]; then
  "$karabiner_postflight" --version-before "$karabiner_version_before" \
    || karabiner_postflight_status=$?
else
  "$karabiner_postflight" || karabiner_postflight_status=$?
fi
case "$karabiner_postflight_status" in
  0) ;;
  129 | 130 | 143) exit "$karabiner_postflight_status" ;;
  *)
    echo "Groundwork: the Karabiner postflight did not complete (exit $karabiner_postflight_status)." >&2
    echo "The refresh is not recorded as successful; review the output above, then run update-all again." >&2
    exit "$karabiner_postflight_status"
    ;;
esac
{{- end }}

# The reminder timestamp represents the complete transaction. Write a real UTC
# timestamp through an atomic rename so a failed or interrupted stage preserves
# the previous successful value.
timestamp="$HOME/.local/state/groundwork/last-update-all"
mkdir -p "$(dirname "$timestamp")"
temporary="${timestamp}.tmp.$$"
runner_temp="$temporary"
date -u '+%Y-%m-%dT%H:%M:%SZ' >"$temporary"
mv -f -- "$temporary" "$timestamp"
runner_temp=""

brew_current_count=0
brew_warning_count=0
for brew_receipt in "$runner_receipt_dir/homebrew-bundle.tsv" \
  "$runner_receipt_dir/homebrew-upgrade.tsv"; do
  [[ -r "$brew_receipt" ]] || continue
  receipt_count="$(gw_brew_classification_count current "$brew_receipt")"
  brew_current_count=$((brew_current_count + receipt_count))
  receipt_count="$(gw_brew_classification_count warning "$brew_receipt")"
  brew_warning_count=$((brew_warning_count + receipt_count))
done

cat <<EOF

Groundwork update complete

Updates
  Homebrew packages       $brew_lane_status
  Mac App Store apps      $mas_lane_status
  mise runtimes           $mise_lane_status

Mac App Store inventory
  Attempted               $mas_attempted_count
  Verified updated        $mas_verified_updated_count
  No longer outdated     $mas_no_longer_outdated_count (installed version unchanged; no update claimed)
  Remaining               $mas_remaining_count
  Timed out               $mas_timed_out_count
  Failed                  $mas_failed_count
  Action required         $mas_action_required_count
  Unexplained             $mas_unexplained_count

Homebrew inventory
  Discovered              $brew_discovered_count installed formulae and casks
  Current                 $brew_inventory_current_count
  Attempted               $brew_attempted_count exact eligible item(s)
  Verified updated        $brew_verified_updated_count
  Vendor-covered          $brew_vendor_covered_count self-updating cask(s)
  Pinned                  $((brew_formula_pinned_count + brew_cask_pinned_count))

Deferred
  Runtime releases        five-day maturity policy enforced when mise is selected; any deferred release was named above
  Running applications    $brew_deferred_running_count cask(s) left open and unchanged

Maintenance
  Homebrew                $maintenance_homebrew
  npm                     $maintenance_npm
  pnpm                    $maintenance_pnpm
  Docker scratch          $docker_maintenance_result
EOF
if [[ "$brew_current_count" -gt 0 ]]; then
  printf '\nCurrent\n  Homebrew                %s known no-change message(s) summarized\n' \
    "$brew_current_count"
fi
brew_cask_action_review_count=$((brew_cask_review_count - brew_cask_pinned_count))
if [[ "$owner_review_count" -gt 0 || "$brew_cask_action_review_count" -gt 0 \
  || "$machine_app_action_count" -gt 0 || "$brew_deprecated_count" -gt 0 \
  || "$brew_disabled_count" -gt 0 ]]; then
  printf '\nReview\n'
  if [[ "$machine_app_action_count" -gt 0 ]]; then
    printf '  Application ownership  %s manual/MDM-unresolved item(s) named above\n' \
      "$machine_app_action_count"
  fi
  if [[ "$brew_cask_action_review_count" -gt 0 ]]; then
    printf '  Homebrew casks          %s unresolved/privileged item(s) named above\n' \
      "$brew_cask_action_review_count"
  fi
  if [[ "$homebrew_unverified_count" -gt 0 ]]; then
    printf '  Unverified casks        %s checksum/updater-ownership item(s) named above\n' \
      "$homebrew_unverified_count"
  fi
  if [[ "$brew_deprecated_count" -gt 0 ]]; then
    printf '  Deprecated             %s item(s) require an owner decision\n' \
      "$brew_deprecated_count"
  fi
  if [[ "$brew_disabled_count" -gt 0 ]]; then
    printf '  Disabled               %s item(s) require replacement/removal review\n' \
      "$brew_disabled_count"
  fi
  if [[ "$owner_review_count" -gt 0 ]]; then
    printf '  Package state           %s owner-review item(s) · run groundwork-cleanup\n' \
      "$owner_review_count"
  fi
fi
if [[ "$brew_warning_count" -gt 0 ]]; then
  printf '\nWarning\n  Homebrew                %s unknown warning(s) preserved in the transcript and raw logs\n' \
    "$brew_warning_count"
fi
result_suffix=""
total_owner_review_count=$((owner_review_count + brew_cask_action_review_count \
  + machine_app_action_count + brew_deprecated_count + brew_disabled_count))
if [[ "$total_owner_review_count" -gt 0 ]]; then
  result_suffix="$result_suffix · $total_owner_review_count OWNER-REVIEW ITEM(S)"
fi
if [[ "$brew_deferred_running_count" -gt 0 ]]; then
  result_suffix="$result_suffix · $brew_deferred_running_count DEFERRED-RUNNING"
fi
if [[ "$brew_warning_count" -gt 0 ]]; then
  result_suffix="$result_suffix · $brew_warning_count WARNING(S)"
fi
printf '\nResult\n  SUCCESS%s\n' "$result_suffix"
echo "  The shell reminder will stay quiet until the next stale window."
if [[ "$brew_lane_status" != "skipped" ]]; then
  echo "  Homebrew details: ~/.local/state/groundwork/logs/homebrew-upgrade-latest.log"
fi
echo "  Maintenance receipt: ~/.local/state/groundwork/receipts/update-all-maintenance-latest.tsv"

# Maintenance has completed independently of any optional action below. Bind
# that truth durably before releasing its lock or asking for separate consent.
publish_maintenance_receipt 0 || {
  echo "Groundwork: the durable maintenance receipt could not be published." >&2
  exit 1
}

{{- if eq .chezmoi.os "darwin" }}
# Optional ownership cleanup is deliberately outside the completed updater
# transaction. Release the machine-wide lock and remove its inherited token
# before invoking either separately locked helper, otherwise update-all would
# deadlock against itself. The helpers revalidate every identity immediately
# before their own mutation.
groundwork_lock_release
unset GROUNDWORK_UPDATE_LOCK_HELD GROUNDWORK_UPDATE_LOCK_TOKEN

action_receipt_work="$runner_receipt_dir/actions.tsv"
[[ "$maintenance_receipt_published" -eq 1 \
  && "$maintenance_receipt_digest" =~ ^[0-9a-f]{64}$ ]] || {
  echo "Groundwork: the post-update action receipt cannot bind the completed maintenance receipt." >&2
  exit 1
}
printf 'schema\t2\ninvocation-id\t%s\nstarted-at\t%s\nmaintenance-status\tsucceeded\nmaintenance-receipt\t%s\nmaintenance-sha256\t%s\n' \
  "$update_invocation_id" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
  "$(basename "$maintenance_receipt_named")" "$maintenance_receipt_digest" \
  >"$action_receipt_work"
chmod 600 "$action_receipt_work"
append_action_receipt() {
  local field first=1
  for field in "$@"; do receipt_field_safe "$field" || return 1; done
  for field in "$@"; do
    if [[ "$first" -eq 1 ]]; then first=0; else printf '\t' >>"$action_receipt_work"; fi
    printf '%s' "$field" >>"$action_receipt_work"
  done
  printf '\n' >>"$action_receipt_work"
}

observe_action_casks() {
  local output="$1"
  HOMEBREW_NO_AUTO_UPDATE=1 brew list --cask >"$output" 2>/dev/null \
    || return 1
  awk 'NF != 1 || $0 !~ /^[A-Za-z0-9@+._-]+$/ { exit 1 }' "$output"
}

groundwork_action_confirm() {
  local prompt="$1" answer
  while true; do
    printf '%s [y/N] ' "$prompt" >&6
    if ! IFS= read -r -u 7 answer; then
      echo >&6
      return 1
    fi
    case "$answer" in
      y | Y | yes | Yes | YES) return 0 ;;
      "" | n | N | no | No | NO) return 1 ;;
      *) echo "Please answer yes or no." >&6 ;;
    esac
  done
}

action_cask_inventory="$runner_receipt_dir/action-casks"
action_cask_inventory_after="$runner_receipt_dir/action-casks-after"
chatgpt_owned_after=0
action_inventory_status=0
if command -v brew >/dev/null 2>&1; then
  observe_action_casks "$action_cask_inventory" || action_inventory_status=$?
else
  action_inventory_status=127
fi
if [[ "$action_inventory_status" -eq 0 ]] \
  && grep -qxF chatgpt "$action_cask_inventory"; then
  chatgpt_owned_after=1
fi
action_center_status=0
if [[ "$action_inventory_status" -ne 0 ]]; then
  append_action_receipt chatgpt-adoption not-offered \
    "homebrew-ownership-unresolved:$action_inventory_status" || exit 1
  echo "Groundwork: ChatGPT actions were not offered because Homebrew cask ownership could not be observed." >&2
elif [[ "$chatgpt_owner" == "ownership-unresolved" ]]; then
  append_action_receipt chatgpt-adoption not-offered ownership-unresolved || exit 1
  echo "Groundwork: ChatGPT actions were not offered because its pre-update ownership was unresolved." >&2
elif [[ "$chatgpt_owner" == "external-unverified" && "$chatgpt_owned_after" -eq 0 ]]; then
  cat <<EOF

Post-update action
  ChatGPT.app is installed but not package-manager-owned.
  Path:          $chatgpt_app
  Bundle ID:     ${chatgpt_bundle_id:-unreadable}
  Version:       ${chatgpt_short_version:-unreadable}
  Build:         ${chatgpt_build_version:-unreadable}
  Architecture:  ${chatgpt_architecture:-unreadable}
EOF
  if [[ "$groundwork_interactive_tty_available" -eq 1 ]]; then
    adopt_check_status=0
    "$HOME/.local/bin/groundwork-app-adopt" --check chatgpt \
      || adopt_check_status=$?
    case "$adopt_check_status" in
      0)
        chatgpt_owned_after=1
        append_action_receipt chatgpt-adoption not-applicable \
          became-homebrew-owned || exit 1
        echo "  ChatGPT.app became Homebrew-owned before consent; no adoption was offered."
        ;;
      3)
        if groundwork_action_confirm "Let Homebrew manage ChatGPT.app?"; then
        "$HOME/.local/bin/groundwork-app-adopt" --yes chatgpt \
          || action_center_status=$?
        action_inventory_after_status=0
        if [[ "$action_center_status" -eq 0 ]]; then
          observe_action_casks "$action_cask_inventory_after" \
            || action_inventory_after_status=$?
        fi
        if [[ "$action_center_status" -eq 0 \
          && "$action_inventory_after_status" -eq 0 ]] \
          && grep -qxF chatgpt "$action_cask_inventory_after"; then
          chatgpt_owned_after=1
          append_action_receipt chatgpt-adoption completed homebrew-owned || exit 1
        else
          [[ "$action_center_status" -ne 0 ]] || action_center_status=1
          append_action_receipt chatgpt-adoption failed "$action_center_status" \
            "ownership-observation:$action_inventory_after_status" || exit 1
          echo "Groundwork: ChatGPT adoption did not complete; Classic removal was not offered." >&2
        fi
        else
          append_action_receipt chatgpt-adoption declined unchanged || exit 1
          echo "  Kept current ChatGPT ownership unchanged."
        fi
        ;;
      *)
        append_action_receipt chatgpt-adoption not-offered \
          "eligibility-check:$adopt_check_status" || exit 1
        echo "Groundwork: ChatGPT adoption was not offered because current eligibility could not be verified." >&2
        ;;
    esac
  else
    append_action_receipt chatgpt-adoption not-offered noninteractive || exit 1
    echo "  Noninteractive run: no ownership change was attempted."
    echo "  Review interactively: groundwork-app-adopt chatgpt"
  fi
elif [[ "$chatgpt_owned_after" -eq 1 ]]; then
  append_action_receipt chatgpt-adoption not-applicable already-homebrew-owned || exit 1
else
  append_action_receipt chatgpt-adoption not-applicable not-installed || exit 1
fi

if [[ "$chatgpt_classic_present" -eq 1 && "$chatgpt_owned_after" -eq 1 ]]; then
  classic_check_status=0
  "$HOME/.local/bin/groundwork-app-remove" --check chatgpt-classic \
    || classic_check_status=$?
  case "$classic_check_status" in
    0)
      append_action_receipt chatgpt-classic-removal not-applicable \
        no-longer-installed || exit 1
      echo "  ChatGPT Classic.app is no longer installed; no removal was offered."
      ;;
    3)
      echo
      echo "ChatGPT Classic.app is also installed."
      echo "ChatGPT.app is preferred; keep Classic only for a known compatibility or Enterprise need."
      if [[ "$groundwork_interactive_tty_available" -eq 1 ]]; then
        if groundwork_action_confirm "Remove ChatGPT Classic.app while preserving shared data?"; then
        "$HOME/.local/bin/groundwork-app-remove" --yes chatgpt-classic \
          || action_center_status=$?
        if [[ "$action_center_status" -eq 0 ]]; then
          append_action_receipt chatgpt-classic-removal completed moved-or-uninstalled || exit 1
        else
          append_action_receipt chatgpt-classic-removal failed "$action_center_status" || exit 1
        fi
        else
          append_action_receipt chatgpt-classic-removal declined unchanged || exit 1
          echo "  Kept ChatGPT Classic.app unchanged."
        fi
      else
        append_action_receipt chatgpt-classic-removal not-offered noninteractive || exit 1
        echo "  Noninteractive run: no removal was attempted."
        echo "  Review interactively: groundwork-app-remove chatgpt-classic"
      fi
      ;;
    *)
      append_action_receipt chatgpt-classic-removal not-offered \
        "eligibility-check:$classic_check_status" || exit 1
      echo "Groundwork: ChatGPT Classic removal was not offered because its exact identity or ownership could not be verified." >&2
      ;;
  esac
elif [[ "$chatgpt_classic_present" -eq 1 ]]; then
  append_action_receipt chatgpt-classic-removal suppressed \
    current-chatgpt-not-homebrew-owned || exit 1
else
  append_action_receipt chatgpt-classic-removal not-applicable not-installed || exit 1
fi
if [[ "$action_center_status" -ne 0 ]]; then
  publish_action_receipt "$action_receipt_work" "$action_center_status" || {
    echo "Groundwork: the failed post-update action could not be recorded durably." >&2
    exit 1
  }
  printf '\nPost-update action result\n  Maintenance: succeeded\n  Requested action: failed (exit %s)\n' \
    "$action_center_status" >&2
  exit "$action_center_status"
fi
publish_action_receipt "$action_receipt_work" 0 || {
  echo "Groundwork: the durable post-update action receipt could not be published." >&2
  exit 1
}
echo "  Action receipt: ~/.local/state/groundwork/receipts/update-all-actions-latest.tsv"
{{- end }}
