#!/usr/bin/env bash
set -euo pipefail

# The post-sync half of update-all. The launcher pulls the source
# (`chezmoi update --init --apply=false`), preflights drift, installs and
# verifies just this file, then execs it — so every stage below, including
# the full `chezmoi apply` and its install hooks, runs the implementation the
# sync just delivered. Stages guard on `command -v`, so the same file works on
# macOS, Linux, and WSL2 whether or not a given manager is installed. Run
# update-all, not this file, for a refresh that includes the sync.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# The update-all launcher decides color once for the whole run and exports
# GROUNDWORK_COLOR before the sync, so every stage and hook script inherits
# it. Recompute only when invoked directly (same rules: NO_COLOR off,
# FORCE_COLOR on, else a real terminal on stdout).
if [[ -z "${GROUNDWORK_COLOR:-}" ]]; then
  if [[ -n "${NO_COLOR:-}" ]]; then
    GROUNDWORK_COLOR=0
  elif [[ -n "${FORCE_COLOR:-}" && "${FORCE_COLOR}" != "0" ]]; then
    GROUNDWORK_COLOR=1
  elif [[ -t 1 ]]; then
    GROUNDWORK_COLOR=1
  else
    GROUNDWORK_COLOR=0
  fi
fi
export GROUNDWORK_COLOR
if [[ "$GROUNDWORK_COLOR" == "1" ]]; then
  # Homebrew decides color per-process from its own stdout; the run-wide
  # signal already decided. HOMEBREW_COLOR is Homebrew's documented switch
  # for exactly this (force color even when stdout is not a TTY), and
  # Homebrew itself still honors NO_COLOR above it.
  export HOMEBREW_COLOR=1
fi

# Fail closed before any stage can mutate tools or the timestamp: the support
# contract is macOS, native Linux, and WSL2 — never WSL1 or an unverifiable
# WSL environment.
if [[ ! -x "$HOME/.local/bin/groundwork-platform" ]]; then
  echo "Groundwork: the platform helper is missing: $HOME/.local/bin/groundwork-platform" >&2
  echo "Restore it from the source you already have (this cannot fetch an upstream fix):" >&2
  echo "  chezmoi apply --exclude=scripts ~/.local/bin/groundwork-platform" >&2
  exit 1
fi
platform="$("$HOME/.local/bin/groundwork-platform" 2>/dev/null || echo unknown)"
case "$platform" in
  darwin | linux | wsl2) ;;
  wsl1)
    echo "Groundwork requires WSL2; WSL1 is unsupported. From PowerShell: \`wsl --list --verbose\` to check versions, \`wsl --set-version <DistributionName> 2\` to convert." >&2
    exit 1
    ;;
  wsl-unknown)
    echo "Groundwork detected WSL but could not verify WSL2. From PowerShell, run \`wsl --list --verbose\`; convert with \`wsl --set-version <DistributionName> 2\` if needed." >&2
    exit 1
    ;;
  *)
    echo "Groundwork does not support this platform: $platform" >&2
    exit 1
    ;;
esac

# The launcher installs only this runner before exec'ing it; the FULL apply —
# configuration files and install hooks, the Homebrew bundle among them —
# runs here, under the freshly synchronized implementation. A hang or failure
# inside a large install now happens in a phase the fresh runner owns, not
# before it exists.
command -v chezmoi >/dev/null 2>&1 || {
  echo "Groundwork: chezmoi is not on PATH; cannot complete the synchronization." >&2
  exit 1
}
chezmoi apply

if command -v brew >/dev/null 2>&1; then
  # Curl-level retries for the transient failures curl itself classifies as
  # retryable (timeouts, 5xx). The curl-92 stream errors it does NOT retry
  # are handled after the fact by groundwork-brew-refetch below.
  export HOMEBREW_CURL_RETRIES=3
  "$HOME/.local/bin/groundwork-brew-update"
  # Use the metadata snapshot that just refreshed. A user-customized Homebrew
  # auto-update interval must not start a second, unwrapped update here.
  {{- if eq .chezmoi.os "darwin" }}
  # --require-sha: refuse to upgrade a cask that ships no checksum. Every cask
  # Groundwork installs is versioned and checksummed today (the AI CLIs
  # included — `claude-code@latest` is a faster release CHANNEL, not Homebrew's
  # `version :latest`), so this costs nothing now and fails loudly if an
  # unverified artifact ever enters the upgrade set. A checksum failure must
  # stop here; never retry without the flag, which would turn a policy refusal
  # into a silent bypass.
  #
  # No --greedy-latest: it only adds `version :latest` casks, and Groundwork
  # installs none — it was a no-op justified by a wrong comment.
  # NO_UPGRADE_AUTO_UPDATES_CASKS still leaves self-updating GUI apps to their
  # own channels, so they are not re-downloaded and re-quarantined behind fresh
  # Gatekeeper prompts.
  # Tee the upgrade so groundwork-brew-repair can read Homebrew's own
  # remediation hints. The per-cask "cannot be upgraded as-is" warning does
  # NOT fail the upgrade, so without this it repeats on every refresh
  # forever; the helper shows brew's exact suggested command and only acts
  # on a yes. A failed upgrade retries once after a repair actually ran.
  upgrade_log="$(mktemp "${TMPDIR:-/tmp}/groundwork-brew-upgrade.XXXXXX")"
  trap 'rm -f -- "$upgrade_log"' EXIT
  upgrade_status=0
  HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1 \
    brew upgrade --require-sha 2>&1 | tee "$upgrade_log" || upgrade_status=$?
  repair_status=0
  "$HOME/.local/bin/groundwork-brew-repair" "$upgrade_log" || repair_status=$?
  retry_upgrade=0
  if [[ "$repair_status" -eq 0 && "$upgrade_status" -ne 0 ]]; then
    retry_upgrade=1
  elif [[ "$repair_status" -eq 3 ]]; then
    echo "Groundwork: the Homebrew repair you approved did not complete — review the output above."
    [[ "$upgrade_status" -ne 0 ]] || upgrade_status=1
  elif [[ "$repair_status" -ge 4 ]]; then
    echo "Groundwork: Homebrew printed a remediation Groundwork could not safely parse; review the log above and run it yourself."
  fi
  # Failed downloads (curl 92 and friends) are not retried by curl's
  # ordinary --retry; re-fetch just those artifacts serially, then retry
  # the upgrade so it picks them up from the cache.
  if [[ "$upgrade_status" -ne 0 ]] \
    && "$HOME/.local/bin/groundwork-brew-refetch" "$upgrade_log"; then
    retry_upgrade=1
  fi
  if [[ "$retry_upgrade" -eq 1 ]]; then
    upgrade_status=0
    HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1 \
      brew upgrade --require-sha || upgrade_status=$?
  fi
  rm -f -- "$upgrade_log"
  trap - EXIT
  [[ "$upgrade_status" -eq 0 ]] || exit "$upgrade_status"
  {{- else }}
  # Casks are a macOS concern; Homebrew on Linux/WSL2 upgrades formulae only.
  HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade
  {{- end }}
  # Remove formulae that were only ever dependencies and are no longer
  # needed — this clears deprecated leftovers (a versioned icu4c, an old
  # python) that otherwise warn on every upgrade forever.
  brew autoremove

  # Bytes under Homebrew's cache, or nothing at all when the query itself
  # fails — a failed observation is reported as unavailable, never as an
  # empty cache. du -sk is the portable form: -k on both BSD and GNU, and
  # GNU-only -b would report zero here on macOS.
  brew_cache_bytes() {
    local cache blocks
    cache="$(brew --cache 2>/dev/null)" || return 1
    [[ -n "$cache" ]] || return 1
    # A cache directory Homebrew has not created yet holds nothing; that is a
    # measurement, not a failed one.
    [[ -d "$cache" ]] || {
      printf '0\n'
      return 0
    }
    blocks="$(du -sk "$cache" 2>/dev/null | awk 'NR == 1 {print $1}')"
    [[ "$blocks" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$((blocks * 1024))"
  }

  # Binary units, labeled as binary: du reports 1024-byte blocks, so KiB/MiB
  # is what these numbers actually are.
  format_bytes() {
    if [[ -z "$1" ]]; then
      printf 'unavailable\n'
      return 0
    fi
    awk -v bytes="$1" 'BEGIN {
      split("B KiB MiB GiB TiB", unit, " ")
      index_ = 1
      while (bytes >= 1024 && index_ < 5) { bytes /= 1024; index_++ }
      if (index_ == 1) printf "%d %s\n", bytes, unit[index_]
      else printf "%.1f %s\n", bytes, unit[index_]
    }'
  }

  # Durable state, not just a message on a screen that scrolls away. Withholding
  # the success timestamp is NOT enough on its own: a refresh that succeeded
  # three days ago leaves a timestamp that is still inside the stale window, so
  # the reminder would stay quiet while the cache stayed full. The previous
  # timestamp is truthful history and is left alone; this marker is what says
  # something is still outstanding, and the shell reminder acts on it whatever
  # the timestamp's age. It is written the moment cleanup fails, so a later
  # stage that exits first cannot swallow the state.
  cleanup_pending_marker="$HOME/.local/state/groundwork/homebrew-cleanup-pending"
  mark_cleanup_pending() {
    local temporary
    mkdir -p "$(dirname "$cleanup_pending_marker")" || return 0
    temporary="${cleanup_pending_marker}.tmp.$$"
    printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >"$temporary" || return 0
    mv -f -- "$temporary" "$cleanup_pending_marker" || return 0
  }

  # Homebrew's default cleanup is deliberately conservative: it prunes stale
  # downloads and files older than 120 days, so a machine that refreshes often
  # accumulates gigabytes of downloads a successful update-all never touches.
  # --prune=all is Homebrew's documented option for removing all cached
  # downloads. What it removes is reproducible: cached downloads, superseded
  # formula versions, and stale lock files — never a package the user asked
  # for, though the `brew autoremove` above it may drop a dependency nothing
  # needs any more. Never substitute a raw recursive
  # deletion of the cache directory: brew's own command respects its locking,
  # its own reporting, and whatever it decides is not disposable.
  #
  # Placement is the contract: this runs only after the upgrade stage above
  # succeeded (a failed upgrade exits before here), so partial downloads stay
  # cached for the retry rather than being deleted out from under it.
  cache_before="$(brew_cache_bytes || true)"
  cleanup_status=0
  brew cleanup --prune=all || cleanup_status=$?
  case "$cleanup_status" in
    130 | 143)
      # Best-effort: this records the case where only the child died (brew
      # exited on the signal while this runner survived). A terminal Ctrl-C
      # signals the whole process group, which usually kills the runner
      # before it gets here — that path has no durable record.
      mark_cleanup_pending "brew cleanup --prune=all was interrupted (exit $cleanup_status)"
      exit "$cleanup_status"
      ;;
  esac
  cache_after="$(brew_cache_bytes || true)"
  # Cache-scoped by construction: this measures $(brew --cache) alone, while
  # the command it brackets also removes old formula versions and stale locks
  # outside the cache. Labeling the numbers "cache" keeps the receipt from
  # contradicting Homebrew's own wider report.
  echo "Homebrew cleanup (brew autoremove; brew cleanup --prune=all)"
  printf '  Cache before:    %s\n' "$(format_bytes "$cache_before")"
  printf '  Cache after:     %s\n' "$(format_bytes "$cache_after")"
  if [[ -z "$cache_before" || -z "$cache_after" ]]; then
    printf '  Cache reclaimed: not measured (cache size unavailable)\n'
  elif [[ "$cache_after" -lt "$cache_before" ]]; then
    printf '  Cache reclaimed: %s\n' "$(format_bytes "$((cache_before - cache_after))")"
  elif [[ "$cache_after" -eq "$cache_before" ]]; then
    printf '  Cache reclaimed: nothing to reclaim\n'
  else
    # Two observations, not one atomic measurement: another process can write
    # into the cache while cleanup runs. Say what was seen, not a negative
    # number dressed up as a reclaim.
    printf '  Cache reclaimed: indeterminate — the cache grew by %s during cleanup\n' \
      "$(format_bytes "$((cache_after - cache_before))")"
  fi
  echo "  Every formula and cask you asked for stays installed. autoremove may drop dependencies nothing needs any more; cleanup removes superseded versions, stale lock files, and the download cache."
  if [[ "$cleanup_status" -ne 0 ]]; then
    # Cleanup can delete part of the cache and then fail on one locked or
    # unreadable file, so never claim the cache was left untouched. The run
    # continues through the remaining stages — they are independent, and
    # discarding a completed upgrade would help nobody — but it records the
    # outstanding work durably and does not report a successful refresh.
    cleanup_warning="brew cleanup --prune=all was incomplete (exit $cleanup_status): some cached files may have been removed and others left behind. The upgrades above completed."
    mark_cleanup_pending "$cleanup_warning"
    echo "Groundwork: $cleanup_warning" >&2
  else
    rm -f -- "$cleanup_pending_marker"
  fi
  {{- if and (eq .chezmoi.os "darwin") (not .headless) }}
  "$HOME/.local/bin/groundwork-apps-start" || true
  {{- end }}
fi

# Docker hygiene: one line, and only when disposable build leftovers have
# piled up. Like shell adoption, deletion is never something a refresh does
# silently — groundwork-docker-tidy --yes is the explicit owner step, and the
# tidy only ever touches images that opted in with the ephemeral label. The
# helper owns docker CLI and daemon reachability itself (--summary stays
# silent when either is missing), so no probe is duplicated here — and
# daemon-wide cleanup stays owner-run only, never invoked from a refresh.
if [[ -x "$HOME/.local/bin/groundwork-docker-tidy" ]]; then
  "$HOME/.local/bin/groundwork-docker-tidy" --summary || true
fi

if command -v mise >/dev/null 2>&1; then
  # The same 5-day floor the renovate-config preset applies to repo
  # dependencies, now applied to the machine: don't adopt a release the world
  # has not had time to notice was poisoned. It filters only fuzzy versions
  # (`lts`, `latest`); an explicitly pinned version is exempt, which is the
  # escape hatch for a security fix that must land immediately.
  if ! mise upgrade --help 2>/dev/null | grep -q -- '--minimum-release-age'; then
    # Fail closed. A policy that steps aside whenever it cannot be enforced is
    # not a control. The escape hatch for an urgent release already exists and
    # is narrow: pin that one runtime to an exact version, which the floor
    # exempts by design — no need for a second hatch that ungates everything.
    cat >&2 <<'EOF'
Groundwork: this mise cannot enforce the 5-day release floor
(--minimum-release-age is missing), so runtime upgrades were skipped.

  Upgrade mise, then run update-all again:  brew upgrade mise
  Urgent security release? Pin that exact runtime version; pinned versions
  bypass the floor by design.
EOF
    exit 1
  fi
  mise upgrade --minimum-release-age 5d
fi

# npm's cache is content-addressed and self-healing; `verify` validates it and
# garbage-collects data that is no longer needed. That conservative,
# owner-provided operation belongs in every refresh; the full `npm cache clean
# --force` reclaim stays an explicit owner action. Groundwork's Node is owned
# by mise, whose shims are not on this script's PATH, so resolve npm through
# mise first and fall back to a PATH npm for machines that install Node
# another way. No npm anywhere is fine: there is nothing to verify.
#
# Every invocation runs from $HOME: update-all is machine maintenance, and the
# directory it happens to be launched from must not decide anything — a
# repository's mise config could select a different Node, and a project-local
# .npmrc could point "the cache" at a per-project directory. The cd neutralizes
# directory-based FILE lookup only: npm_config_* environment a shell exported
# (direnv, say) still applies, deliberately — distinguishing a project's
# ambient exports from the user's own configuration is not this stage's call.
if command -v mise >/dev/null 2>&1 && (cd "$HOME" && mise which npm >/dev/null 2>&1); then
  (cd "$HOME" && mise exec -- npm cache verify)
elif command -v npm >/dev/null 2>&1; then
  (cd "$HOME" && npm cache verify)
fi

{{- if ne .chezmoi.os "darwin" }}

# Ownership boundary: Groundwork updates the developer environment it manages
# and never mutates the operating system it runs inside — no distro package
# upgrades on Linux, no Windows-host updates from WSL2.
case "$platform" in
  wsl2)
    echo "Groundwork updated the WSL2 development environment. Windows applications and Windows Update are managed separately on the host."
    ;;
  linux)
    echo "Groundwork updated its managed developer tools. Operating-system packages (apt, dnf, pacman) are managed separately by your distribution."
    ;;
esac
{{- end }}

{{- if and (hasKey . "xcode") .xcode (hasKey . "beta") .beta }}
# Beta channel is opt-in and only meaningful with Xcode. update-all never
# downloads betas because they require the developer's Apple Account.
if command -v xcodes >/dev/null 2>&1; then
  # shellcheck disable=SC2016 # Backticks are literal command formatting for the user.
  echo 'Groundwork: beta channel on. Xcode betas: `xcodes list` to see them, `xcodes install "<version>"` to add one, and `xcodes select` to switch.'
fi
{{- end }}

# An incomplete cleanup is an incomplete transaction. The stages after it still
# ran — they are independent of the cache, and throwing away a completed upgrade
# would help nobody — but this run is not recorded as a successful refresh, and
# a script or agent sees a nonzero status. The pending marker written at the
# cleanup itself is what survives the process and keeps the shell reminder
# asking, no matter how recent the last fully successful refresh was.
if [[ -n "${cleanup_warning:-}" ]]; then
  cat >&2 <<EOF
Groundwork: completed with warnings, so this refresh is not recorded as successful.
  $cleanup_warning
  Inspect the cache, then run update-all again:  du -sh "\$(brew --cache)"
EOF
  exit 1
fi

# The reminder timestamp represents the complete transaction. Write a real UTC
# timestamp through an atomic rename so a failed or interrupted stage preserves
# the previous successful value.
timestamp="$HOME/.local/state/groundwork/last-update-all"
mkdir -p "$(dirname "$timestamp")"
temporary="${timestamp}.tmp.$$"
trap 'rm -f -- "$temporary"' EXIT
date -u '+%Y-%m-%dT%H:%M:%SZ' >"$temporary"
mv -f -- "$temporary" "$timestamp"
trap - EXIT

echo "Groundwork tools refreshed. The shell reminder will stay quiet until the next stale window."
