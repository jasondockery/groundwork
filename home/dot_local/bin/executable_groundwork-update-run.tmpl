#!/usr/bin/env bash
set -euo pipefail

# The post-sync half of update-all. The launcher pulls the source
# (`chezmoi update --init --apply=false`), preflights drift, installs and
# verifies this runner plus its lock library, then execs it — so every stage
# below, including the full `chezmoi apply` and its install hooks, runs the
# implementation the sync just delivered. Stages guard on `command -v`, so the
# same file works on macOS, Linux, and WSL2 whether or not a given manager is
# installed. Run update-all, not this file, for a refresh that includes the
# sync.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

usage() {
  cat <<'EOF'
Complete the post-sync half of update-all.

Usage:
  groundwork-update-run                    apply and refresh with maintenance
  groundwork-update-run --skip-maintenance apply and refresh without routine maintenance
  groundwork-update-run -h|--help          show this help

Run update-all for the normal full transaction. This runner is directly
invocable for repair and testing, so it validates the same arguments before
chezmoi apply or any update or maintenance operation.
EOF
}

skip_maintenance=0
while (($#)); do
  case "$1" in
    --skip-maintenance) skip_maintenance=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "groundwork-update-run: unknown option: $1" >&2
      echo "Run 'groundwork-update-run --help' for usage." >&2
      exit 64
      ;;
    *)
      echo "groundwork-update-run: unexpected argument: $1 (this command takes no positional arguments)" >&2
      exit 64
      ;;
  esac
  shift
done

# Fail closed before any bootstrap apply or package stage: the support contract
# is macOS, native Linux, and WSL2 — never WSL1 or an unverifiable WSL
# environment. Existing v1.9 installations already have this detector even
# though they do not yet have the lock library introduced after v1.9.
if [[ ! -x "$HOME/.local/bin/groundwork-platform" ]]; then
  echo "Groundwork: the platform helper is missing: $HOME/.local/bin/groundwork-platform" >&2
  echo "Restore it from the source you already have (this cannot fetch an upstream fix):" >&2
  echo "  chezmoi apply --exclude=scripts ~/.local/bin/groundwork-platform" >&2
  exit 1
fi
platform="$("$HOME/.local/bin/groundwork-platform" 2>/dev/null || echo unknown)"
case "$platform" in
  darwin | linux | wsl2) ;;
  wsl1)
    echo "Groundwork requires WSL2; WSL1 is unsupported. From PowerShell: \`wsl --list --verbose\` to check versions, \`wsl --set-version <DistributionName> 2\` to convert." >&2
    exit 1
    ;;
  wsl-unknown)
    echo "Groundwork detected WSL but could not verify WSL2. From PowerShell, run \`wsl --list --verbose\`; convert with \`wsl --set-version <DistributionName> 2\` if needed." >&2
    exit 1
    ;;
  *)
    echo "Groundwork does not support this platform: $platform" >&2
    exit 1
    ;;
esac

# Direct runner invocations acquire the same lock as update-all. When the
# launcher execs this file, the inherited token proves the transaction is
# already locked. A v1.9 launcher installs only this freshly synchronized
# runner before exec, so restore the one new lock dependency narrowly when it
# is absent. Targeted apply excludes scripts and cannot run install hooks.
lock_lib="$HOME/.local/lib/groundwork/update-lock.sh"
if [[ ! -r "$lock_lib" ]]; then
  command -v chezmoi >/dev/null 2>&1 || {
    echo "Groundwork: cannot restore the update lock helper because chezmoi is unavailable." >&2
    exit 1
  }
  chezmoi apply --exclude=scripts "$lock_lib"
  if ! chezmoi verify "$lock_lib"; then
    echo "Groundwork: the restored update lock helper does not match the synchronized source." >&2
    echo "Refusing to continue. Review it with: chezmoi diff ~/.local/lib/groundwork/update-lock.sh" >&2
    exit 1
  fi
  if [[ ! -r "$lock_lib" ]]; then
    echo "Groundwork: chezmoi finished, but the update lock helper is still missing: $lock_lib" >&2
    exit 1
  fi
fi
# shellcheck source=/dev/null
source "$lock_lib"
groundwork_lock_acquire "groundwork-update-run" || exit $?
runner_temp=""
runner_exit() {
  local status=$?
  groundwork_lock_release || true
  [[ -z "$runner_temp" ]] || rm -f -- "$runner_temp" || true
  exit "$status"
}
trap runner_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# The update-all launcher decides color once for the whole run and exports
# GROUNDWORK_COLOR before the sync, so every stage and hook script inherits
# it. Recompute only when invoked directly (same rules: NO_COLOR off,
# FORCE_COLOR on, else a real terminal on stdout).
if [[ -z "${GROUNDWORK_COLOR:-}" ]]; then
  if [[ -n "${NO_COLOR:-}" ]]; then
    GROUNDWORK_COLOR=0
  elif [[ -n "${FORCE_COLOR:-}" && "${FORCE_COLOR}" != "0" ]]; then
    GROUNDWORK_COLOR=1
  elif [[ -t 1 ]]; then
    GROUNDWORK_COLOR=1
  else
    GROUNDWORK_COLOR=0
  fi
fi
export GROUNDWORK_COLOR
if [[ "$GROUNDWORK_COLOR" == "1" ]]; then
  # Homebrew decides color per-process from its own stdout; the run-wide
  # signal already decided. HOMEBREW_COLOR is Homebrew's documented switch
  # for exactly this (force color even when stdout is not a TTY), and
  # Homebrew itself still honors NO_COLOR above it.
  export HOMEBREW_COLOR=1
fi

# The launcher installs this runner and its lock helper before exec'ing it; the
# FULL apply — configuration files and install hooks, the Homebrew bundle among
# them — runs here, under the freshly synchronized implementation. A hang or
# failure inside a large install now happens in a phase the fresh runner owns,
# not before it exists.
command -v chezmoi >/dev/null 2>&1 || {
  echo "Groundwork: chezmoi is not on PATH; cannot complete the synchronization." >&2
  exit 1
}
chezmoi apply

if command -v brew >/dev/null 2>&1; then
  # Select the exact Groundwork-owned candidate set BEFORE updating metadata or
  # packages. An unqualified `brew upgrade` also mutates user-installed apps
  # that are no longer in Groundwork, which would make removal from the Brewfile
  # meaningless. The same parsed arrays are reused for the retry.
  managed_brewfile="$HOME/.config/homebrew/Brewfile"
  [[ -f "$managed_brewfile" ]] || {
    echo "Groundwork: managed Brewfile is missing: $managed_brewfile" >&2
    exit 1
  }
  managed_formulae=()
  managed_casks=()
  brew_re='^brew[[:space:]]+"([A-Za-z0-9@+._-]+)"([[:space:]]|$)'
  cask_re='^cask[[:space:]]+"([A-Za-z0-9@+._-]+)"([[:space:]]|$)'
  mas_re='^mas[[:space:]]+"[^"]+",[[:space:]]+id:[[:space:]]+[0-9]+([[:space:]]|$)'
  while IFS= read -r brewfile_line; do
    case "$brewfile_line" in
      "" | \#*) continue ;;
    esac
    if [[ "$brewfile_line" =~ $brew_re ]]; then
      managed_formulae+=("${BASH_REMATCH[1]}")
    elif [[ "$brewfile_line" =~ $cask_re ]]; then
      managed_casks+=("${BASH_REMATCH[1]}")
    elif [[ "$brewfile_line" =~ $mas_re ]]; then
      continue
    else
      printf 'Groundwork: unsupported managed Brewfile entry: %s\n' "$brewfile_line" >&2
      exit 1
    fi
  done <"$managed_brewfile"
  ((${#managed_formulae[@]} > 0)) || {
    echo "Groundwork: managed Brewfile selected no formulae; refusing an empty upgrade scope." >&2
    exit 1
  }

  # Curl-level retries for the transient failures curl itself classifies as
  # retryable (timeouts, 5xx). The curl-92 stream errors it does NOT retry
  # are handled after the fact by groundwork-brew-refetch below.
  export HOMEBREW_CURL_RETRIES=3
  "$HOME/.local/bin/groundwork-brew-update"
  # Use the metadata snapshot that just refreshed. A user-customized Homebrew
  # auto-update interval must not start a second, unwrapped update here.
  {{- if eq .chezmoi.os "darwin" }}
  # --require-sha: refuse to upgrade a cask that ships no checksum. Every cask
  # in the checksum-safe Brewfile is versioned and checksummed (the AI CLIs
  # included — `claude-code@latest` is a faster release CHANNEL, not Homebrew's
  # `version :latest`), so this costs nothing now and fails loudly if an
  # unverified artifact ever enters the upgrade set. A checksum failure must
  # stop here; never retry without the flag, which would turn a policy refusal
  # into a silent bypass.
  #
  # No --greedy-latest: it only adds `version :latest` casks, and Groundwork
  # installs none — it was a no-op justified by a wrong comment.
  # NO_UPGRADE_AUTO_UPDATES_CASKS still leaves self-updating GUI apps to their
  # own channels, so they are not re-downloaded and re-quarantined behind fresh
  # Gatekeeper prompts.
  # Tee the upgrade so groundwork-brew-repair can read Homebrew's own
  # remediation hints. The per-cask "cannot be upgraded as-is" warning does
  # NOT fail the upgrade, so without this it repeats on every refresh
  # forever; the helper shows brew's exact suggested command and only acts
  # on a yes. A failed upgrade retries once after a repair actually ran.
  upgrade_log="$(mktemp "${TMPDIR:-/tmp}/groundwork-brew-upgrade.XXXXXX")"
  runner_temp="$upgrade_log"
  upgrade_status=0
  echo "Groundwork: upgrading the exact packages declared in the managed Brewfile."
  HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1 \
    brew upgrade --require-sha "${managed_formulae[@]}" "${managed_casks[@]}" \
      2>&1 | tee "$upgrade_log" || upgrade_status=$?
  repair_status=0
  "$HOME/.local/bin/groundwork-brew-repair" "$upgrade_log" || repair_status=$?
  retry_upgrade=0
  if [[ "$repair_status" -eq 0 && "$upgrade_status" -ne 0 ]]; then
    retry_upgrade=1
  elif [[ "$repair_status" -eq 3 ]]; then
    echo "Groundwork: the Homebrew repair you approved did not complete — review the output above."
    [[ "$upgrade_status" -ne 0 ]] || upgrade_status=1
  elif [[ "$repair_status" -ge 4 ]]; then
    echo "Groundwork: Homebrew printed a remediation Groundwork could not safely parse; review the log above and run it yourself."
  fi
  # Failed downloads (curl 92 and friends) are not retried by curl's
  # ordinary --retry; re-fetch just those artifacts serially, then retry
  # the upgrade so it picks them up from the cache.
  if [[ "$upgrade_status" -ne 0 ]] \
    && "$HOME/.local/bin/groundwork-brew-refetch" "$upgrade_log"; then
    retry_upgrade=1
  fi
  if [[ "$retry_upgrade" -eq 1 ]]; then
    upgrade_status=0
    HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1 \
      brew upgrade --require-sha "${managed_formulae[@]}" "${managed_casks[@]}" \
        || upgrade_status=$?
  fi
  rm -f -- "$upgrade_log"
  runner_temp=""
  [[ "$upgrade_status" -eq 0 ]] || exit "$upgrade_status"
  {{- else }}
  # Casks are a macOS concern; Homebrew on Linux/WSL2 upgrades the exact
  # Groundwork-managed formula list.
  HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade "${managed_formulae[@]}"
  {{- end }}
  {{- if and (eq .chezmoi.os "darwin") (not .headless) }}
  "$HOME/.local/bin/groundwork-apps-start" || true
  {{- end }}
fi

update_status=0
if command -v mise >/dev/null 2>&1; then
  # The same 5-day floor the renovate-config preset applies to repo
  # dependencies, now applied to the machine: don't adopt a release the world
  # has not had time to notice was poisoned. It filters only fuzzy versions
  # (`lts`, `latest`); an explicitly pinned version is exempt, which is the
  # escape hatch for a security fix that must land immediately.
  if ! mise upgrade --help 2>/dev/null | grep -q -- '--minimum-release-age'; then
    # Fail closed. A policy that steps aside whenever it cannot be enforced is
    # not a control. The escape hatch for an urgent release already exists and
    # is narrow: pin that one runtime to an exact version, which the floor
    # exempts by design — no need for a second hatch that ungates everything.
    cat >&2 <<'EOF'
Groundwork: this mise cannot enforce the 5-day release floor
(--minimum-release-age is missing), so runtime upgrades were skipped.

  Upgrade mise, then run update-all again:  brew upgrade mise
  Urgent security release? Pin that exact runtime version; pinned versions
  bypass the floor by design.
EOF
    update_status=1
  else
    mise upgrade --minimum-release-age 5d || update_status=$?
  fi
  case "$update_status" in
    129 | 130 | 143) exit "$update_status" ;;
  esac
fi

# Supported package-manager cleanup is one stage with one receipt and durable
# per-manager pending state. It runs after every required upgrade lane was
# attempted. A failed mise lane does not suppress safe Homebrew, npm, or pnpm
# maintenance; the final receipt remains nonzero for either kind of failure.
# Independent cleanup lanes continue after one fails; their helper returns
# nonzero only after recording every outcome. --skip-maintenance is the
# exceptional fast path and never clears older pending work.
maintenance_pending() {
  local pending_dir="$HOME/.local/state/groundwork/update-all-pending" pending_file
  [[ -f "$HOME/.local/state/groundwork/homebrew-cleanup-pending" ]] && return 0
  [[ -d "$pending_dir" ]] || return 1
  for pending_file in "$pending_dir"/*; do
    [[ -f "$pending_file" ]] && return 0
  done
  return 1
}

maintenance_manager_pending() {
  local pending_dir="$HOME/.local/state/groundwork/update-all-pending" pending_file
  [[ -d "$pending_dir" ]] || return 1
  for pending_file in "$pending_dir"/homebrew "$pending_dir"/npm "$pending_dir"/pnpm; do
    [[ -f "$pending_file" ]] && return 0
  done
  return 1
}

mark_maintenance_helper_pending() {
  local pending="$HOME/.local/state/groundwork/update-all-pending/maintenance-helper"
  local temporary="${pending}.tmp.$$"
  mkdir -p "$(dirname "$pending")"
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >"$temporary"
  mv -f -- "$temporary" "$pending"
}

clear_maintenance_helper_pending() {
  local pending_dir="$HOME/.local/state/groundwork/update-all-pending"
  rm -f -- "$pending_dir/maintenance-helper"
  rmdir "$pending_dir" 2>/dev/null || true
}

maintenance_status=0
if [[ "$skip_maintenance" -eq 1 ]]; then
  echo
  echo "Package-manager maintenance skipped for this exceptional refresh."
  if maintenance_pending; then
    maintenance_status=1
    echo "Groundwork: earlier package-manager maintenance is still pending." >&2
  fi
elif [[ -x "$HOME/.local/bin/groundwork-cleanup" ]]; then
  # Record helper-level intent before exec so an early crash cannot disappear
  # behind a still-fresh successful update timestamp.
  mark_maintenance_helper_pending "package-manager maintenance helper started but has not completed"
  "$HOME/.local/bin/groundwork-cleanup" --yes || maintenance_status=$?
  if [[ "$maintenance_status" -eq 0 ]]; then
    clear_maintenance_helper_pending
  elif maintenance_manager_pending; then
    # The helper recorded a more precise per-manager failure.
    clear_maintenance_helper_pending
  else
    mark_maintenance_helper_pending "package-manager maintenance helper failed before recording a manager stage (exit $maintenance_status)"
  fi
else
  maintenance_status=1
  mark_maintenance_helper_pending "package-manager maintenance helper is missing"
  echo "Groundwork: the package-manager maintenance helper is missing: $HOME/.local/bin/groundwork-cleanup" >&2
fi
case "$maintenance_status" in
  129 | 130 | 143) exit "$maintenance_status" ;;
esac

# Docker scratch maintenance is a separate bounded lane. The helper owns the
# shared lock borrow, per-Docker-call deadlines and cancellation, candidate
# re-checks, durable pending state, and direct-repair clearing. Automatic mode
# uses only managed code, the canonical grace, and a verified local endpoint.
# Daemon-wide cleanup remains structurally absent from update-all.
docker_pending="$HOME/.local/state/groundwork/docker-tidy-pending"
mark_docker_pending() {
  local temporary="${docker_pending}.tmp.$$"
  mkdir -p "$(dirname "$docker_pending")"
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >"$temporary"
  mv -f -- "$temporary" "$docker_pending"
}

docker_maintenance_status=0
if [[ "$skip_maintenance" -eq 1 ]]; then
  echo "Docker scratch maintenance skipped for this exceptional refresh."
  if [[ -f "$docker_pending" ]]; then
    docker_maintenance_status=1
    echo "Groundwork: earlier Docker scratch maintenance is still pending." >&2
  fi
elif [[ -x "$HOME/.local/bin/groundwork-docker-tidy" ]]; then
  docker_pending_before=0
  [[ -f "$docker_pending" ]] && docker_pending_before=1
  "$HOME/.local/bin/groundwork-docker-tidy" --automatic || docker_maintenance_status=$?
  if [[ "$docker_maintenance_status" -eq 3 ]]; then
    if [[ "$docker_pending_before" -eq 1 || -f "$docker_pending" ]]; then
      docker_maintenance_status=1
      echo "Groundwork: Docker is unavailable or unaccepted, so earlier Docker scratch maintenance remains pending." >&2
    else
      docker_maintenance_status=0
      echo "Groundwork: Docker scratch maintenance skipped because no canonical local daemon was available; no earlier repair is pending."
    fi
  elif [[ "$docker_maintenance_status" -ne 0 && ! -f "$docker_pending" ]]; then
    mark_docker_pending "Docker scratch helper failed before recording its acting stage (exit $docker_maintenance_status)"
  fi
else
  docker_maintenance_status=1
  mark_docker_pending "Docker scratch maintenance helper is missing"
  echo "Groundwork: the Docker scratch maintenance helper is missing: $HOME/.local/bin/groundwork-docker-tidy" >&2
fi
case "$docker_maintenance_status" in
  124 | 125 | 129 | 130 | 143) exit "$docker_maintenance_status" ;;
esac

{{- if ne .chezmoi.os "darwin" }}

# Ownership boundary: Groundwork updates the developer environment it manages
# and never mutates the operating system it runs inside — no distro package
# upgrades on Linux, no Windows-host updates from WSL2.
case "$platform" in
  wsl2)
    echo "Groundwork updated the WSL2 development environment. Windows applications and Windows Update are managed separately on the host."
    ;;
  linux)
    echo "Groundwork updated its managed developer tools. Operating-system packages (apt, dnf, pacman) are managed separately by your distribution."
    ;;
esac
{{- end }}

{{- if and (hasKey . "xcode") .xcode (hasKey . "beta") .beta }}
# Beta channel is opt-in and only meaningful with Xcode. update-all never
# downloads betas because they require the developer's Apple Account.
if command -v xcodes >/dev/null 2>&1; then
  # shellcheck disable=SC2016 # Backticks are literal command formatting for the user.
  echo 'Groundwork: beta channel on. Xcode betas: `xcodes list` to see them, `xcodes install "<version>"` to add one, and `xcodes select` to switch.'
fi
{{- end }}

# An incomplete maintenance stage is an incomplete transaction. Earlier
# upgrades remain complete, but the success timestamp is withheld and callers
# see a nonzero status. Per-stage pending records keep the shell reminder active.
if [[ "$update_status" -ne 0 || "$maintenance_status" -ne 0 || "$docker_maintenance_status" -ne 0 ]]; then
  cat >&2 <<EOF
Groundwork: completed with warnings, so this refresh is not recorded as successful.
EOF
  if [[ "$update_status" -ne 0 ]]; then
    echo "  A required upgrade stage failed (exit $update_status); run update-all again after repairing it." >&2
  fi
  if [[ "$maintenance_status" -ne 0 ]]; then
    cat >&2 <<'EOF'
  Package-manager maintenance is incomplete.

  Run update-all again to retry the normal maintenance transaction.

  To retry maintenance without repeating upgrades:
    groundwork-cleanup --yes

  See `groundwork-cleanup --help` for exceptional overrides.
EOF
  fi
  if [[ "$docker_maintenance_status" -ne 0 ]]; then
    cat >&2 <<'EOF'
  Docker scratch maintenance is incomplete.

  Run update-all again to retry the normal update and maintenance transaction.

  To retry only the label-scoped Docker scratch maintenance:
    groundwork-docker-tidy --yes

  If Docker was intentionally removed, acknowledge only the reminder with:
    groundwork-docker-tidy --yes --clear-pending

  Daemon-wide cleanup remains an owner-reviewed, separate command.
EOF
  fi
  exit 1
fi

# The reminder timestamp represents the complete transaction. Write a real UTC
# timestamp through an atomic rename so a failed or interrupted stage preserves
# the previous successful value.
timestamp="$HOME/.local/state/groundwork/last-update-all"
mkdir -p "$(dirname "$timestamp")"
temporary="${timestamp}.tmp.$$"
runner_temp="$temporary"
date -u '+%Y-%m-%dT%H:%M:%SZ' >"$temporary"
mv -f -- "$temporary" "$timestamp"
runner_temp=""

echo "Groundwork tools refreshed. The shell reminder will stay quiet until the next stale window."
