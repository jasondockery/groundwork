#!/usr/bin/env bash
set -euo pipefail

# groundwork-configure — review and selectively change your Groundwork setup
# answers, then preview and apply. This is the SETTINGS EDITOR.
#
# `chezmoi init` establishes the bootstrap-critical machine baseline and later
# only regenerates from saved answers. Mutable preferences, including release
# posture and beta channels, live here. This command shows current answers,
# changes only what you pick, previews the resulting dotfile diff, and applies
# only after you confirm.
#
# Safety: values are read and written with a JSON encoder (never sed on TOML);
# the candidate config is rendered in a fully isolated chezmoi environment; the
# real config is promoted atomically under a lock only after you confirm and only
# if it has not changed since the editor opened; a timestamped backup is kept.

prog="groundwork-configure"

usage() {
  cat <<EOF
Usage:
  $prog
  $prog --release-posture <current|preview>

Review and selectively change this machine's Groundwork configuration, then
preview and apply. The release-posture option opens the same safe transaction
with that one preference preselected.

Options:
  --release-posture <current|preview>
               Preselect the stable/current or preview application posture.
  -h, --help   Show this help and exit.
EOF
}

# --- argument contract (before any side effect) ---
target_posture=""
case "$#" in
  0) ;;
  1) case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "$prog: unknown argument: $1" >&2
      usage >&2
      exit 64
      ;;
  esac ;;
  2)
    if [[ "$1" != "--release-posture" ]]; then
      echo "$prog: unknown option: $1" >&2
      usage >&2
      exit 64
    fi
    case "$2" in
      current | preview) target_posture="$2" ;;
      *)
        echo "$prog: --release-posture expects current or preview." >&2
        exit 64
        ;;
    esac
    ;;
  *)
    echo "$prog: unexpected arguments." >&2
    usage >&2
    exit 64
    ;;
esac

# --- state-specific refusal, most fundamental first. Both refusals below depend
# only on the config file's existence and the TTY, so they stay deterministic on
# a bare CI runner. A MISSING config is a deeper problem than a non-interactive
# invocation: telling someone to edit a file that does not exist is not
# actionable, so the missing-config message wins even when stdin is not a TTY. ---
config_path="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/chezmoi.toml"
if [[ ! -f "$config_path" ]]; then
  echo "$prog: no Groundwork configuration exists at $config_path." >&2
  echo "Run the Groundwork setup from an interactive terminal first." >&2
  exit 1
fi
if [[ ! -t 0 || ! -t 1 ]]; then
  echo "$prog: this is an interactive settings editor; run it in a terminal." >&2
  echo "To change a setting non-interactively, edit $config_path and run 'chezmoi apply'." >&2
  exit 1
fi

# --- environment ---
command -v chezmoi >/dev/null 2>&1 || {
  echo "$prog: chezmoi is not installed." >&2
  exit 1
}
command -v python3 >/dev/null 2>&1 || {
  echo "$prog: python3 is required." >&2
  exit 1
}
config_dir="$(dirname "$config_path")"
source_path="$(chezmoi --config "$config_path" source-path 2>/dev/null || true)"
[[ -n "$source_path" && -d "$source_path" ]] || {
  echo "$prog: could not resolve the chezmoi source path." >&2
  exit 1
}

# --- one temp root, one cleanup trap ---
tmp_root="$(mktemp -d)"
lock_dir=""
cleanup() {
  [[ -z "$tmp_root" ]] || rm -rf -- "$tmp_root"
  [[ -z "$lock_dir" ]] || rmdir -- "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

data_json="$tmp_root/data.json"
chezmoi --config "$config_path" data --format=json >"$data_json" 2>/dev/null \
  || {
    echo "$prog: could not read the current configuration data." >&2
    exit 1
  }
# Digest at editor-open time; promotion aborts if the config changes under us.
config_digest_open="$(cksum <"$config_path")"

# --- field registry (parallel arrays: macOS ships Bash 3.2, no assoc arrays) ---
# key                  label                 kind    clearable
# Every mutable field is offered here even when bootstrap deliberately does not
# ask it. home/.chezmoi.toml.tmpl preserves stored values on every platform.
fields_key=(release_posture environment_role terminal_multiplexer beta work password_manager key_repeat code_dir name email_personal email_work game_dev xcode obsidian_vault_name signingkey)
fields_label=("Release posture" "Environment role" "Terminal multiplexer" "Xcode beta channel" "Work machine" "Password manager" "Key repeat" "Code directory" "Git name" "Personal email" "Work email" "Game-dev tools" "Xcode" "Obsidian vault" "SSH signing key")
fields_kind=(posture role multiplexer bool bool pw keyrepeat string string string string bool bool string string)
fields_clear=(no no no no no no no no no no yes no no yes yes)

posture_values=(current preview)
posture_labels=("Stable channels for posture-managed apps (currently Chrome stable)" "Preview channels for posture-managed apps (currently Chrome Beta + stable fallback)")
role_values=(personal managed disposable)
role_labels=("Personal" "Managed" "Disposable")
pw_values=(bitwarden 1password none)
keyrepeat_values=(fast standard aggressive)
keyrepeat_labels=("Fast (recommended)" "Standard (slower repeat)" "Aggressive (starts sooner)")
multiplexer_values=(herdr tmux both none)
multiplexer_labels=("Herdr (recommended; Apache-2.0)" "tmux (traditional and mature)" "Both (Herdr primary; Apache-2.0 Herdr; tmux fallback; no automatic nesting)" "None (preserve user-managed tooling)")

# All menu kinds differ only in their value/label lists, so they share one
# prompt, one display path, and one receipt formatter. `pw` has no separate
# labels: its stored values are already the words a user recognizes.
choice_values=()
choice_labels=()
load_choices() { # kind -> populates choice_values / choice_labels
  case "$1" in
    posture)
      choice_values=("${posture_values[@]}")
      choice_labels=("${posture_labels[@]}")
      ;;
    role)
      choice_values=("${role_values[@]}")
      choice_labels=("${role_labels[@]}")
      ;;
    keyrepeat)
      choice_values=("${keyrepeat_values[@]}")
      choice_labels=("${keyrepeat_labels[@]}")
      ;;
    multiplexer)
      choice_values=("${multiplexer_values[@]}")
      choice_labels=("${multiplexer_labels[@]}")
      ;;
    pw)
      choice_values=("${pw_values[@]}")
      choice_labels=("${pw_values[@]}")
      ;;
    *)
      choice_values=()
      choice_labels=()
      ;;
  esac
}
# Short display for a stored value: the label with any parenthetical gloss
# stripped, or the raw value if it is not a known choice.
choice_display() { # kind value
  local i
  # A config generated before a menu field existed has no value for it at all.
  # Show that as unset rather than as an empty column.
  [[ -z "$2" ]] && {
    echo "(none)"
    return
  }
  load_choices "$1"
  for ((i = 0; i < ${#choice_values[@]}; i++)); do
    [[ "${choice_values[i]}" == "$2" ]] && {
      echo "${choice_labels[i]%% (*}"
      return
    }
  done
  echo "$2"
}

# persisted value (from the loaded data JSON), typed as a display string
persisted() { # key
  python3 - "$data_json" "$1" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); v=d.get(sys.argv[2])
print("" if v is None else ("true" if v is True else "false" if v is False else str(v)))
PY
}

# pending overrides (parallel arrays); an entry exists only when it differs from persisted
pending_key=()
pending_val=()
pending_origin=()
pending_index() { # key -> echoes index or nothing; returns 1 if absent
  local i
  for ((i = 0; i < ${#pending_key[@]}; i++)); do
    [[ "${pending_key[i]}" == "$1" ]] && {
      echo "$i"
      return 0
    }
  done
  return 1
}
current_value() { # key -> pending value if present, else persisted
  local idx
  if idx="$(pending_index "$1")"; then printf '%s' "${pending_val[idx]}"; else persisted "$1"; fi
}
remove_pending() { # key
  local idx
  if idx="$(pending_index "$1")"; then
    unset 'pending_key[idx]' 'pending_val[idx]' 'pending_origin[idx]'
    # Bash 3.2 treats an empty array expansion as unbound under `set -u`.
    # Compact sparse arrays only while an entry remains; the zero-length arrays
    # are already in the correct state after unsetting their final element.
    if ((${#pending_key[@]} > 0)); then
      pending_key=("${pending_key[@]}")
      pending_val=("${pending_val[@]}")
      pending_origin=("${pending_origin[@]}")
    fi
  fi
}
stage_change() { # key newval [origin] — records only a real change; reverts drop the entry
  local key="$1" new="$2" origin="${3:-user}" idx
  if [[ "$new" == "$(persisted "$key")" ]]; then
    remove_pending "$key"
    return
  fi
  if idx="$(pending_index "$key")"; then
    pending_val[idx]="$new"
    pending_origin[idx]="$origin"
  else
    pending_key+=("$key")
    pending_val+=("$new")
    pending_origin+=("$origin")
  fi
}

reconcile_xcode_beta() {
  local beta_idx beta_origin
  if [[ "$(current_value xcode)" == "true" ]]; then
    if beta_idx="$(pending_index beta)"; then
      beta_origin="${pending_origin[beta_idx]}"
      case "$beta_origin" in
        dependency | migration-normalization) remove_pending beta ;;
      esac
    fi
  elif [[ "$(current_value beta)" == "true" ]]; then
    stage_change beta false dependency
  fi
}

display_of() { # key kind -> human display of the effective value
  local v
  v="$(current_value "$1")"
  case "$2" in
    bool) [[ "$v" == "true" ]] && echo "Yes" || echo "No" ;;
    posture | keyrepeat | multiplexer) choice_display "$2" "$v" ;;
    *) [[ -z "$v" ]] && echo "(none)" || echo "$v" ;;
  esac
}

# --- prompts (re-prompt on invalid; Enter = stated default; EOF = cancel editor) ---
cancel_editor() {
  echo
  echo "Cancelled; nothing changed."
  exit 130
}

edit_field() { # index
  local i="$1"
  local key="${fields_key[i]}" kind="${fields_kind[i]}" clear="${fields_clear[i]}" cur new op ans j
  cur="$(current_value "$key")"
  echo
  echo "Changing: ${fields_label[i]}  (currently: $(display_of "$key" "$kind"))"
  case "$kind" in
    bool)
      local defword
      [[ "$cur" == "true" ]] && defword="Yes" || defword="No"
      while true; do
        read -r -p "  New value [y/n] (Enter keeps ${defword}): " ans || cancel_editor
        case "$ans" in
          "")
            new="$cur"
            break
            ;;
          y | Y | yes | YES | t | T | true | 1)
            new=true
            break
            ;;
          n | N | no | NO | f | F | false | 0)
            new=false
            break
            ;;
          *) echo "  Please enter y or n." >&2 ;;
        esac
      done
      ;;
    posture | role | keyrepeat | multiplexer | pw)
      load_choices "$kind"
      for ((j = 0; j < ${#choice_values[@]}; j++)); do printf '  %d. %s\n' "$((j + 1))" "${choice_labels[j]}"; done
      while true; do
        read -r -p "  Choose 1-${#choice_values[@]} (Enter keeps current): " ans || cancel_editor
        if [[ -z "$ans" ]]; then
          new="$cur"
          break
        elif [[ "$ans" =~ ^[0-9]+$ ]] && ((ans >= 1 && ans <= ${#choice_values[@]})); then
          new="${choice_values[$((ans - 1))]}"
          break
        else echo "  Enter a number between 1 and ${#choice_values[@]}." >&2; fi
      done
      ;;
    string)
      if [[ "$clear" == "yes" ]]; then
        while true; do
          echo "  1. Enter a new value"
          echo "  2. Clear the value"
          echo "  3. Keep the current value"
          read -r -p "  Choose 1-3: " op || cancel_editor
          case "$op" in
            1)
              read -r -p "  New value: " new || cancel_editor
              break
              ;;
            2)
              new=""
              break
              ;;
            3 | "")
              new="$cur"
              break
              ;;
            *) echo "  Enter 1, 2, or 3." >&2 ;;
          esac
        done
      else
        read -r -p "  New value (Enter keeps '${cur}'): " ans || cancel_editor
        [[ -z "$ans" ]] && new="$cur" || new="$ans"
      fi
      ;;
  esac
  stage_change "$key" "$new" user
  # Reconcile from the transaction's final effective values. A dependency- or
  # migration-created beta change disappears when Xcode returns to enabled;
  # an explicit user beta choice remains.
  if [[ "$key" == "xcode" ]]; then
    reconcile_xcode_beta
  fi
}

# --- candidate render: build an isolated INPUT config with the pending changes
#     applied via a JSON encoder, then regenerate. Never edits TOML with sed. ---
render_candidate() { # out-path -> 0 ok
  local out="$1" input="$tmp_root/input.toml" i pairs=()
  for ((i = 0; i < ${#pending_key[@]}; i++)); do pairs+=("${pending_key[i]}=${pending_val[i]}"); done
  python3 - "$data_json" "$source_path" "$input" "${pairs[@]}" <<'PY'
import json, sys
data = json.load(open(sys.argv[1])); src = sys.argv[2]; out = sys.argv[3]
data.pop("chezmoi", None)
pending = {}
for arg in sys.argv[4:]:
    k, _, v = arg.partition("=")
    if isinstance(data.get(k), bool):
        pending[k] = (v == "true")
    else:
        pending[k] = v
data.update(pending)
lines = ["sourceDir = " + json.dumps(src), "[data]"]
for k in sorted(data):
    lines.append("    %s = %s" % (k, json.dumps(data[k])))
open(out, "w").write("\n".join(lines) + "\n")
PY
  # </dev/null: a missing (newly-added) answer must fail fast, never open a TTY.
  if ! chezmoi --config "$input" --source "$source_path" \
    --persistent-state "$tmp_root/state.boltdb" --cache "$tmp_root/cache" \
    init --config-path "$out" </dev/null 2>"$tmp_root/render.err"; then
    if grep -q '/dev/tty' "$tmp_root/render.err"; then
      echo "$prog: your configuration needs a new answer the template added." >&2
      echo "Run 'chezmoi init' once to answer it, then re-run $prog." >&2
    else
      echo "$prog: could not render the candidate configuration:" >&2
      cat "$tmp_root/render.err" >&2
    fi
    return 1
  fi
  return 0
}

print_receipt() { # structured, from the pending registry — no grepped TOML
  local i key kind
  echo "Proposed changes:"
  for ((i = 0; i < ${#pending_key[@]}; i++)); do
    key="${pending_key[i]}"
    local ki
    for ((ki = 0; ki < ${#fields_key[@]}; ki++)); do [[ "${fields_key[ki]}" == "$key" ]] && break; done
    kind="${fields_kind[ki]}"
    local oldv newv
    oldv="$(persisted "$key")"
    newv="${pending_val[i]}"
    printf '  %s:  %s → %s\n' "${fields_label[ki]}" "$(fmt "$oldv" "$kind")" "$(fmt "$newv" "$kind")"
  done
}
fmt() { # value kind -> display
  case "$2" in
    bool) [[ "$1" == "true" ]] && echo "Yes" || echo "No" ;;
    posture | role | keyrepeat | multiplexer) choice_display "$2" "$1" ;;
    *) [[ -z "$1" ]] && echo "(none)" || echo "$1" ;;
  esac
}

apply_changes() {
  if [[ ${#pending_key[@]} -eq 0 ]]; then
    echo "No changes to apply."
    return 0
  fi
  local candidate="$tmp_root/candidate.toml" ans
  render_candidate "$candidate" || return 1
  echo
  print_receipt
  echo
  # Preview the dotfile changes; a failed preview ABORTS (never apply blind).
  read -r -p "Preview the dotfiles this would change? [Y/n] " ans || cancel_editor
  case "$ans" in
    n | N | no | NO) : ;;
    *)
      echo
      if ! chezmoi --config "$candidate" --persistent-state "$tmp_root/diff-state.boltdb" \
        --cache "$tmp_root/diff-cache" --no-pager diff; then
        echo "$prog: could not compute the dotfile preview; nothing was applied." >&2
        return 1
      fi
      echo
      ;;
  esac
  read -r -p "Apply these changes? [y/N] " ans || cancel_editor
  case "$ans" in
    y | Y | yes | YES) ;;
    *)
      echo "Not applied; your configuration is unchanged."
      return 0
      ;;
  esac

  # --- atomic promotion under a lock, compare-before-swap ---
  lock_dir="$config_dir/.$prog.lock"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    echo "$prog: another $prog appears to be running (lock at $lock_dir)." >&2
    echo "If none is running, an interrupted run left it behind; remove it with:" >&2
    printf "  rmdir '%s'\n" "$lock_dir" >&2
    lock_dir=""
    return 1
  fi
  if [[ "$(cksum <"$config_path")" != "$config_digest_open" ]]; then
    echo "$prog: $config_path changed since this editor opened; not overwriting newer answers." >&2
    echo "Re-run $prog to start from the current values." >&2
    rmdir "$lock_dir" 2>/dev/null || true
    lock_dir=""
    return 1
  fi
  local backup swap
  backup="$config_dir/chezmoi.toml.groundwork-bak.$(date +%Y%m%d-%H%M%S)"
  swap="$config_dir/.chezmoi.toml.$prog.$$"
  cp -p "$config_path" "$backup" # same-dir backup, original mode
  cp "$candidate" "$swap"        # same-dir temp
  chmod 600 "$swap"
  mv -f "$swap" "$config_path" # atomic rename into place
  echo "Configuration updated (backup: $backup)."
  local rc=0
  if chezmoi --config "$config_path" apply; then
    echo "Dotfiles applied."
  else
    rc=$?
    echo "$prog: the config was updated, but 'chezmoi apply' did not complete." >&2
    echo "Some target files may already have changed; the new config stays active." >&2
    echo "Retry:   chezmoi --config '$config_path' apply" >&2
    echo "Backup:  $backup" >&2
  fi
  rmdir "$lock_dir" 2>/dev/null || true
  lock_dir=""
  return "$rc"
}

# Normalize a legacy or hand-edited impossible state transparently. The change
# remains pending until the user reviews the receipt and confirms it.
if [[ "$(current_value xcode)" != "true" && "$(current_value beta)" == "true" ]]; then
  echo "Stored Xcode beta was enabled while Xcode was disabled; applying this transaction will clear that inactive preference."
  stage_change beta false migration-normalization
fi

# --- focused shortcut or main menu loop ---
if [[ -n "$target_posture" ]]; then
  stage_change release_posture "$target_posture"
  apply_changes
  exit $?
fi

while true; do
  echo
  echo "Groundwork configuration"
  echo
  visible_indices=()
  for ((i = 0; i < ${#fields_key[@]}; i++)); do
    # Beta is a dependent preference. Once Xcode is enabled it appears on the
    # next menu render; otherwise the durable state is always false.
    if [[ "${fields_key[i]}" == "beta" && "$(current_value xcode)" != "true" ]]; then
      continue
    fi
    visible_indices+=("$i")
  done
  n=${#visible_indices[@]}
  for ((menu_i = 0; menu_i < n; menu_i++)); do
    i="${visible_indices[menu_i]}"
    marker=" "
    pending_index "${fields_key[i]}" >/dev/null 2>&1 && marker="*"
    printf ' %s%2d. %-22s %s\n' "$marker" "$((menu_i + 1))" "${fields_label[i]}" "$(display_of "${fields_key[i]}" "${fields_kind[i]}")"
  done
  echo "     ------"
  printf '  %2d. %s\n' "$((n + 1))" "Apply changes"
  printf '  %2d. %s\n' "$((n + 2))" "Exit without changes"
  echo "  (* = changed, not yet applied)"
  echo
  read -r -p "Choose a setting to change [$((n + 2))]: " choice || cancel_editor
  [[ -z "$choice" ]] && choice="$((n + 2))"
  if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
    echo "  Enter a number." >&2
    continue
  fi
  if ((choice >= 1 && choice <= n)); then
    edit_field "${visible_indices[$((choice - 1))]}"
  elif ((choice == n + 1)); then
    if apply_changes; then break; fi
  elif ((choice == n + 2)); then
    echo "Exited; nothing changed."
    break
  else echo "  Out of range." >&2; fi
done
