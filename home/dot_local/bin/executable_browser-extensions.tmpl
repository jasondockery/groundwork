#!/usr/bin/env bash
set -euo pipefail

catalog="${GROUNDWORK_BROWSER_EXTENSIONS_CATALOG:-$HOME/.local/share/groundwork/browser-extensions.tsv}"
password_manager="{{ .password_manager }}"
browser_navigation="{{ .browser_navigation }}"
release_posture="{{ .release_posture }}"
browser="chrome"
tier="recommended"
open_links="false"

usage() {
  cat <<'EOF'
Usage: browser-extensions [options]

List or open the Groundwork-recommended browser extensions.

Options:
  --browser chrome               Browser links to show/open (default: chrome).
                                  Under preview release posture, chrome also
                                  covers Chrome Beta automatically.
  --tier recommended|core|dev|privacy|optional|all
  --open                         Open matching store links
  -h, --help                     Show this help

Examples:
  browser-extensions
  browser-extensions --browser chrome --tier core --open
  browser-extensions --browser chrome --tier dev
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --browser)
      if [[ $# -lt 2 || "${2:-}" == --* ]]; then
        echo "missing value for --browser" >&2
        usage >&2
        exit 2
      fi
      browser="${2:-}"
      shift 2
      ;;
    --tier)
      if [[ $# -lt 2 || "${2:-}" == --* ]]; then
        echo "missing value for --tier" >&2
        usage >&2
        exit 2
      fi
      tier="${2:-}"
      shift 2
      ;;
    --open)
      open_links="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$browser" in
  chrome) ;;
  *)
    echo "unsupported browser: $browser" >&2
    exit 2
    ;;
esac

case "$tier" in
  recommended|core|dev|privacy|optional|all) ;;
  *)
    echo "unsupported tier: $tier" >&2
    exit 2
    ;;
esac

if [[ ! -f "$catalog" ]]; then
  echo "missing catalog: $catalog" >&2
  exit 1
fi

should_show() {
  local row_tier="$1"
  local row_scope="$2"

  case "$row_scope" in
    all) ;;
    chromium)
      [[ "$browser" == "chrome" ]] || return 1
      ;;
    1password|bitwarden)
      [[ "$password_manager" == "$row_scope" || "$tier" == "all" ]] || return 1
      ;;
    vimium)
      [[ "$browser_navigation" == "vimium" || "$tier" == "all" ]] || return 1
      ;;
    *)
      return 1
      ;;
  esac

  case "$tier" in
    recommended)
      [[ "$row_tier" == "core" || "$row_tier" == "privacy" || "$row_tier" == "dev" ]]
      ;;
    all)
      return 0
      ;;
    *)
      [[ "$row_tier" == "$tier" ]]
      ;;
  esac
}

app_for_browser() {
  case "$1" in
    chrome) printf '%s\n' "Google Chrome" ;;
    chrome-beta) printf '%s\n' "Google Chrome Beta" ;;
  esac
}

# The channel(s) a Chrome extension link applies to. One catalog row covers
# every channel: the Chrome Web Store URL is identical regardless of which
# Chrome channel installs it, so preview adds Chrome Beta here rather than a
# second catalog row or a second scope to maintain. A future Chromium channel
# only needs one more case here, not a change anywhere the catalog is read.
targets_for_browser() {
  case "$1" in
    chrome)
      if [[ "$release_posture" == "preview" ]]; then
        printf '%s\n%s\n' chrome chrome-beta
      else
        printf '%s\n' chrome
      fi
      ;;
  esac
}

url_for_browser() {
  printf '%s\n' "$2"
}

printed="false"
while IFS=$'\t' read -r row_tier row_scope name chromium_url notes; do
  [[ -z "${row_tier:-}" || "$row_tier" == \#* ]] && continue
  should_show "$row_tier" "$row_scope" || continue

  targets=()
  while IFS= read -r target_line; do
    [[ -n "$target_line" ]] && targets+=("$target_line")
  done < <(targets_for_browser "$browser")

  for target in "${targets[@]}"; do
    url="$(url_for_browser "$target" "$chromium_url")"
    [[ -n "$url" && "$url" != "-" ]] || continue
    printed="true"

    if [[ "$open_links" == "true" ]]; then
      open -a "$(app_for_browser "$target")" "$url" 2>/dev/null || open "$url"
    else
      printf '%-8s %-10s %s\n' "$target" "$row_tier" "$name"
      printf '  %s\n' "$url"
      printf '  %s\n\n' "$notes"
    fi
  done
done < "$catalog"

if [[ "$printed" == "false" ]]; then
  echo "no matching extension links found"
fi
