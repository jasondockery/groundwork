# Groundwork's Node/pnpm ownership model, as machine-readable data.
#
#   mise owns Node.  Corepack owns pnpm, and selects the version each repository
#   pins in its package.json "packageManager" field.
#
# Read by the apply-time converger (~/.local/share/chezmoi run_after_15). Kept
# here, under a managed data path, so the script and the docs cite ONE version
# rather than hardcoding "@latest". `groundwork-doctor --node-toolchain` reports
# the Corepack it FINDS; it does not currently assert that version against this
# pin.
#
# WHY Corepack rather than a global pnpm: a globally installed pnpm competes with
# every repository's packageManager pin, and PATH order silently decides which
# wins — so an interactive shell, an agent shell, and CI can disagree without any
# error. Corepack resolves per repository on every invocation, in parent AND
# nested processes (Turbo tasks, package scripts), which is the property that
# actually holds.

# Corepack is bundled with Node before v25 and was REMOVED from the Node
# distribution in v25. This is a FALLBACK pin: it is the version installed when
# no Corepack is present beside the active Node. Where Node still bundles one,
# that bundled version is accepted as-is rather than replaced. Bump deliberately — an unpinned "@latest" would make the toolchain
# non-reproducible across machines, which is the whole failure this replaces.
GROUNDWORK_COREPACK_VERSION=0.35.0

# The Node major at which Corepack stopped shipping with Node.
GROUNDWORK_COREPACK_UNBUNDLED_FROM_NODE_MAJOR=25
