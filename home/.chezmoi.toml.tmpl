{{- if eq .chezmoi.os "windows" -}}
{{- fail "Groundwork's terminal environment requires macOS, Linux, or WSL2. On Windows, install WSL2 with Ubuntu and run Groundwork inside WSL; native PowerShell/CMD is not part of the Groundwork v1 support contract. See https://jasondockery.github.io/groundwork/platforms.html" -}}
{{- end -}}
{{- /* Default WSL2 kernels carry "microsoft-standard" (newer ones also a
"WSL2" suffix); WSL1 kernels say "Microsoft" without either. Ambiguous WSL
(custom kernels) is gated at runtime by groundwork-platform. */ -}}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi "kernel") -}}
{{- $osrelease := lower (toString (get .chezmoi.kernel "osrelease")) -}}
{{- if and (contains "microsoft" $osrelease) (not (contains "microsoft-standard" $osrelease)) (not (contains "wsl2" $osrelease)) -}}
{{- fail "Groundwork supports WSL2, not WSL1: WSL1 filesystem and syscall behavior differ from real Linux. From PowerShell, check with `wsl --list --verbose` and convert with `wsl --set-version <DistributionName> 2`, then rerun setup." -}}
{{- end -}}
{{- end -}}
{{- /* Every yes/no question carries its own affordance: chezmoi's bool
prompt accepts y/yes/t/true/1 and n/no/f/false/0, shows only a dim
"bool, default <x>" hint, and takes the default on a bare Enter — so the
question itself must say what to type and name the default. */ -}}
{{- $work := promptBoolOnce . "work" "Is this a work machine (y/t = yes, n/f = no; Enter keeps the default: no)" false -}}
{{- $headless := false -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $headless = promptBoolOnce . "headless" "Is this a server or CI Mac with no desktop apps, which most Macs are not (y/t = yes, n/f = no; Enter keeps the default: no)" false -}}
{{- else -}}
{{- /* Native Linux is a supported desktop, not just a server: default to
headless only when nothing indicates a graphical session. A desktop Ubuntu
should not be defaulted into the server profile just for not being a Mac.
Two literal prompts, not one computed default, so the named default in the
question text always matches the real one. */ -}}
{{- $graphical := or (env "DISPLAY") (env "WAYLAND_DISPLAY") -}}
{{- if $graphical -}}
{{- $headless = promptBoolOnce . "headless" "Is this a headless server or container with no desktop apps (y/t = yes, n/f = no; Enter keeps the default: no)" false -}}
{{- else -}}
{{- $headless = promptBoolOnce . "headless" "Is this a headless server or container with no desktop apps (y/t = yes, n/f = no; Enter keeps the default: yes)" true -}}
{{- end -}}
{{- end -}}
{{- $name := promptStringOnce . "name" "What name should Git use for commits" -}}
{{- $emailPersonal := promptStringOnce . "email_personal" "What personal email should Git use for commits" -}}
{{- $emailWork := promptStringOnce . "email_work" "What work email should Git use (leave blank if none)" "" -}}
{{- $codeDir := promptStringOnce . "code_dir" "Where should projects live" "~/code" -}}
{{- $resetExisting := promptBoolOnce . "reset_existing_configs" "Reset old terminal, editor, and tmux state before applying (y/t = yes, n/f = no; Enter keeps the default: no)" false -}}
{{- $pwManagers := list "bitwarden" "1password" "none" -}}
{{- $pwManager := promptChoiceOnce . "password_manager" "Which password manager should Groundwork configure for SSH and Git signing" $pwManagers "bitwarden" -}}
{{- $signingKey := promptStringOnce . "signingkey" "What SSH public key should Git use for signing (leave blank to skip)" "" -}}
{{- $obsidianVault := promptStringOnce . "obsidian_vault_name" "What should the Obsidian vault be named (leave blank to skip)" "my_obsidian_vault" -}}
{{- /* An unchecked artifact is the user's call, not Groundwork's. Chrome is the
one cask Groundwork wants that ships `sha256 :no_check` (Google's own updater
owns the binary), so it cannot satisfy the --require-sha policy every other cask
is installed under. Default no: the safe lane is the default, and accepting a
weaker integrity path should be a decision someone makes on purpose. */ -}}
{{- $installChrome := false -}}
{{- if and (eq .chezmoi.os "darwin") (not $headless) -}}
{{- $installChrome = promptBoolOnce . "install_chrome" "Google's Chrome cask ships without a checksum because Google's own updater owns the binary, unlike every other app Groundwork installs, which are all checksum-verified. Install Google Chrome anyway (y/t installs, n/f skips; Enter keeps the default: no)" false -}}
{{- end -}}
{{- /* One preset question, not a personality quiz. The preset seeds two stored
fields: environment ROLE and release POSTURE. Posture seeds default application
channels through the tool catalog; it never names a vendor channel itself and
never touches AI-tool freshness, which is current by product contract, nor the
pnpm/Renovate/mise supply-chain floors, which address a different risk.

Personal Current is the recommended default: AI tools current on stable
foundations. That is not caution — an AI-assisted workflow already introduces
variance, and agents work best against a substrate whose behavior is
documented. See specs/environment-profiles-and-release-posture.md.

Headless machines install no desktop applications, so they are not asked and
stay on the stable channel. A work machine defaults to work-managed. */ -}}
{{- /* A NUMBERED menu, not a bare choice list. chezmoi's promptChoice is a
type-to-match field that auto-submits on a unique abbreviation, and our own
`personal-current`/`personal-preview` share a nine-character prefix, so the raw
values needed ten keystrokes to disambiguate while `w`/`d` submitted on one.
Numbers make every choice one keystroke and keep the stored `profile_preset`
values unchanged. See specs/interactive-cli-and-chezmoi-interview.md. */ -}}
{{- $presetByNum := dict "1" "personal-current" "2" "personal-preview" "3" "work-managed" "4" "disposable-experimental" -}}
{{- $numByPreset := dict "personal-current" "1" "personal-preview" "2" "work-managed" "3" "disposable-experimental" "4" -}}
{{- $defaultPreset := "personal-current" -}}
{{- if $work -}}
{{- $defaultPreset = "work-managed" -}}
{{- end -}}
{{- /* If a valid preset is already stored, offer ITS number as the default so a
forced `chezmoi init --prompt` (which replays with template defaults, not the
stored answer) never silently resets an existing choice. */ -}}
{{- $defaultNum := index $numByPreset $defaultPreset -}}
{{- if and (hasKey . "profile_preset") (hasKey $numByPreset (toString .profile_preset)) -}}
{{- $defaultNum = index $numByPreset (toString .profile_preset) -}}
{{- end -}}
{{- /* Seed from the STORED answer before the platform gate, not only inside it.
The question is asked on desktop macOS alone, but the answer is written on every
platform — so a machine that skips the prompt (Linux, WSL2, headless) must carry
its stored preset forward. Without this seed the value silently reverts to the
default on every regeneration, and `update-all` regenerates on every refresh:
a recorded answer would be discarded by routine maintenance. */ -}}
{{- $profilePreset := $defaultPreset -}}
{{- if and (hasKey . "profile_preset") (hasKey $numByPreset (toString .profile_preset)) -}}
{{- $profilePreset = toString .profile_preset -}}
{{- end -}}
{{- if and (eq .chezmoi.os "darwin") (not $headless) -}}
{{- $presetChoice := promptChoiceOnce . "profile_preset" (printf "Starting profile — type 1-4:\n  1. Personal current (recommended) — AI tools current on the latest stable apps\n  2. Personal preview — adds pre-release apps (VS Code Insiders, Zen Twilight, Chrome Beta); accepts occasional breakage\n  3. Work managed — never works around device policy\n  4. Disposable experimental — a rebuildable container or VM\nAI tools stay current in every profile (Enter keeps the default: %s)" $defaultNum) (list "1" "2" "3" "4") $defaultNum -}}
{{- /* Dual return domain: a fresh or --prompt run yields a digit; an existing
config has promptChoiceOnce return the stored value string directly. Accept both
and normalize to exactly one stored value. */ -}}
{{- if hasKey $presetByNum $presetChoice -}}
{{- $profilePreset = index $presetByNum $presetChoice -}}
{{- else if hasKey $numByPreset $presetChoice -}}
{{- $profilePreset = $presetChoice -}}
{{- else -}}
{{- $profilePreset = $defaultPreset -}}
{{- end -}}
{{- end -}}
{{- /* Role and posture are stored separately so a user can later change one
without the other, and so a preset is only ever a starting value. */ -}}
{{- $environmentRole := "personal" -}}
{{- $releasePosture := "current" -}}
{{- if eq $profilePreset "personal-preview" -}}
{{- $releasePosture = "preview" -}}
{{- else if eq $profilePreset "work-managed" -}}
{{- $environmentRole = "managed" -}}
{{- else if eq $profilePreset "disposable-experimental" -}}
{{- $environmentRole = "disposable" -}}
{{- $releasePosture = "preview" -}}
{{- end -}}
{{- /* A STORED role or posture wins over the preset-derived seed above. The
preset only chooses starting values; what is persisted is the concrete choice,
and specs/environment-profiles-and-release-posture.md requires role and posture
to be independently editable so they can diverge from the preset (a managed
machine may take preview posture without becoming personal). Deriving them on
every render made that impossible and silently reverted a hand-edited posture on
the next apply. groundwork-configure drops both keys when the user changes the
preset, which is exactly what re-seeds them from the new starting value. */ -}}
{{- if and (hasKey . "environment_role") (has (toString .environment_role) (list "personal" "managed" "disposable")) -}}
{{- $environmentRole = toString .environment_role -}}
{{- end -}}
{{- if and (hasKey . "release_posture") (has (toString .release_posture) (list "current" "preview")) -}}
{{- $releasePosture = toString .release_posture -}}
{{- end -}}
{{- /* Key repeat. Two independent knobs, both integers written to NSGlobalDomain:
KeyRepeat is the interval BETWEEN repeats and InitialKeyRepeat is the delay
BEFORE repeating starts; for both, a lower number is faster. They are described
here only in relative terms. The unit is not documented by Apple, the hidden
values do not map linearly onto the System Settings sliders, and this machine's
own IOKit values do not match the widely repeated "15ms per unit" folklore — so
naming millisecond equivalents would be inventing precision.

Fast is the default because holding a key is a primary motion in a terminal
(j/k in vim, arrow keys, backspace), not an edge case. Numbered menu for the
same reason as the profile preset above: promptChoice is a type-to-match field.

Asked on any DESKTOP, macOS or Linux, and on neither when headless. Key repeat
belongs to the machine holding the physical keyboard, not the machine being
typed into: in a container or over SSH the repeat comes from the operator's own
desktop, so there is nothing on the far end to set. WSL2 is the same case with
Windows owning the keyboard. Storing an answer that no surface can honor would
invite a claim Groundwork cannot keep. */ -}}
{{- $keyRepeatByNum := dict "1" "fast" "2" "standard" "3" "aggressive" -}}
{{- $numByKeyRepeat := dict "fast" "1" "standard" "2" "aggressive" "3" -}}
{{- $keyRepeatDefaultNum := "1" -}}
{{- if and (hasKey . "key_repeat") (hasKey $numByKeyRepeat (toString .key_repeat)) -}}
{{- $keyRepeatDefaultNum = index $numByKeyRepeat (toString .key_repeat) -}}
{{- end -}}
{{- /* Same stored-answer seed as the profile preset above: the question is
skipped on headless hosts and on WSL2, but the value is written everywhere, so
without this a stored answer reverts to "fast" on every regeneration. */ -}}
{{- $keyRepeat := "fast" -}}
{{- if and (hasKey . "key_repeat") (hasKey $numByKeyRepeat (toString .key_repeat)) -}}
{{- $keyRepeat = toString .key_repeat -}}
{{- end -}}
{{- /* WSL2 reaches here as a non-headless Linux desktop when WSLg sets a
display, but the keyboard is Windows'. Detect it once, and do not ask. */ -}}
{{- $wsl := false -}}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi "kernel") -}}
{{- if contains "microsoft" (lower (toString (get .chezmoi.kernel "osrelease"))) -}}
{{- $wsl = true -}}
{{- end -}}
{{- end -}}
{{- /* The closing line differs by platform because the honest caveat differs.
macOS always applies this; Linux applies it on GNOME (persistently) or an X11
session (until logout), and on other compositors Groundwork records the answer
and tells you where to set it rather than pretending it applied. Promising
"applied" to a sway or KDE-Wayland user would be the claim we cannot keep. */ -}}
{{- $keyRepeatNote := "Changing Keyboard settings in System Settings later overwrites this" -}}
{{- if ne .chezmoi.os "darwin" -}}
{{- $keyRepeatNote = "Applied on GNOME, or for the current session on X11; on other desktops Groundwork prints where to set it" -}}
{{- end -}}
{{- if and (not $headless) (not $wsl) -}}
{{- $keyRepeatChoice := promptChoiceOnce . "key_repeat" (printf "Key repeat when you hold a key down — type 1-3:\n  1. Fast (recommended) — starts repeating soon, repeats quickly\n  2. Standard — same start delay, slower repeat\n  3. Aggressive — same fast repeat, starts sooner; can repeat when you only meant to rest on a key\n%s (Enter keeps the default: %s)" $keyRepeatNote $keyRepeatDefaultNum) (list "1" "2" "3") $keyRepeatDefaultNum -}}
{{- /* Same dual return domain as profile_preset: a digit on a fresh or --prompt
run, the stored value string on an ordinary existing-config run. */ -}}
{{- if hasKey $keyRepeatByNum $keyRepeatChoice -}}
{{- $keyRepeat = index $keyRepeatByNum $keyRepeatChoice -}}
{{- else if hasKey $numByKeyRepeat $keyRepeatChoice -}}
{{- $keyRepeat = $keyRepeatChoice -}}
{{- end -}}
{{- end -}}
{{- $gameDev := promptBoolOnce . "game_dev" "Install optional Unity game development tools, a large download (y/t = yes, n/f = no; Enter keeps the default: no)" false -}}
{{- $xcode := promptBoolOnce . "xcode" "Install Xcode for native Apple and iOS development, large at ~15GB+ (y/t = yes, n/f = no; Enter keeps the default: no)" false -}}
{{- $beta := false -}}
{{- if $xcode -}}
{{- $beta = promptBoolOnce . "beta" "Also follow Apple's Xcode beta channel with the xcodes tool, where you sign in with your Apple Account, no paid membership, and choose versions yourself (y/t = yes, n/f = no; Enter keeps the default: no)" false -}}
{{- end -}}

sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    work = {{ $work }}
    headless = {{ $headless }}
    name = {{ $name | quote }}
    email_personal = {{ $emailPersonal | quote }}
    email_work = {{ $emailWork | quote }}
    code_dir = {{ $codeDir | quote }}
    reset_existing_configs = {{ $resetExisting }}
    password_manager = {{ $pwManager | quote }}
    signingkey = {{ $signingKey | quote }}
    obsidian_vault_name = {{ $obsidianVault | quote }}
    install_chrome = {{ $installChrome }}
    key_repeat = {{ $keyRepeat | quote }}
    profile_preset = {{ $profilePreset | quote }}
    environment_role = {{ $environmentRole | quote }}
    release_posture = {{ $releasePosture | quote }}
    game_dev = {{ $gameDev }}
    xcode = {{ $xcode }}
    beta = {{ $beta }}

[edit]
    command = "nvim"

[diff]
    pager = "delta"
