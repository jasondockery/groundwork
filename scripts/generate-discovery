#!/usr/bin/env python3
"""Generate search/AI discovery artifacts from the docs pages themselves.

Derives, so pages stay the single source of truth:
  - per-page meta descriptions (description, og:description,
    twitter:description) from each page's lead paragraph: the lead IS the
    search snippet, so write leads accordingly (skills/docs-alignment).
  - docs/sitemap.xml for search engines (submit once in Search Console;
    project pages cannot serve a root robots.txt, so the sitemap is
    registered there rather than referenced from robots).
  - docs/llms.txt for AI/IDE agents (Claude Code, Cursor, and peers fetch
    it when pointed at a docs site).
  - data/docs-fingerprints.json, the versioned registry recording each page's
    content digest and the date that content last changed. Sitemap lastmod
    reads from it, so freshness is a function of page bytes alone — not of
    commit dates, which a squash merge or rebase rewrites, and not of clone
    depth. `--check` therefore gives the same verdict on a branch that it will
    give on main after the merge.

Modes: --write (default) rewrites artifacts; --check exits 1 if a rewrite
would change anything (wired into scripts/validate-groundwork).
"""

import datetime
import hashlib
import html
import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
DOCS = ROOT / "docs"
BASE = "https://jasondockery.github.io/groundwork"
SITE = "Groundwork"
SUMMARY = (
    "An AI-native development foundation for Mac, Linux/WSL, and headless "
    "agent workspaces: tool setup plus the fundamentals that stay useful "
    "when tools change (shell, Git, project instructions, verification, "
    "and directing AI agents)."
)
MAX_DESC = 158

# Docs pages are simple single-segment .html filenames. Page names become
# registry keys and unescaped sitemap URL path segments, so main() restricts
# them to one predictable, portable alphabet.
SAFE_PAGE_NAME = re.compile(r"[A-Za-z0-9._-]+\.html")

LEAD_RE = re.compile(r'<p class="lead">(.*?)</p>', re.S)
FIRST_P_RE = re.compile(r'<div class="content">.*?<p[^>]*>(.*?)</p>', re.S)
TITLE_RE = re.compile(r"<title>(.*?)</title>", re.S)
TAG_RE = re.compile(r"<[^>]+>")

# Recorded content fingerprint and lastmod per page. This registry is what makes
# sitemap freshness deterministic: a page's lastmod moves when its bytes move,
# never because a commit happened to be dated a certain day. The answer is
# therefore identical before and after a squash merge or a rebase, and it is
# computed without reading git history at all, so a depth-1 clone is exactly as
# correct as a full one. Both properties are what let `--check` settle the
# question on a branch, before a merge exists.
REGISTRY = ROOT / "data" / "docs-fingerprints.json"
REGISTRY_VERSION = 1
SHA256_HEX = re.compile(r"[0-9a-f]{64}")
ISO_DATE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")


def page_description(text: str) -> str:
    m = LEAD_RE.search(text) or FIRST_P_RE.search(text)
    if not m:
        return SUMMARY
    raw = html.unescape(TAG_RE.sub("", m.group(1)))
    desc = " ".join(raw.split())
    if len(desc) > MAX_DESC:
        prefix = desc[: MAX_DESC - 1]
        if " " in prefix:
            prefix = prefix.rsplit(" ", 1)[0]
        prefix = prefix.rstrip(",;:")
        desc = prefix + "…"
    return desc


def page_title(text: str) -> str:
    m = TITLE_RE.search(text)
    return " ".join(m.group(1).split()) if m else SITE


def set_meta(text: str, pattern: str, replacement: str) -> str:
    return re.sub(
        pattern,
        lambda match: f"{match.group(1)}{replacement}{match.group(2)}",
        text,
        count=1,
    )


def fail(message: str) -> None:
    sys.stderr.write(f"generate-discovery: {message}\n")
    raise SystemExit(1)


def load_registry() -> dict[str, dict[str, str]]:
    """Page name -> {sha256, lastmod} from the tracked registry.

    Every shape error fails closed. An unreadable registry must never degrade
    into "stamp everything today": that would silently republish every page's
    date and bury whichever page actually changed."""
    where = REGISTRY.relative_to(ROOT)
    if not REGISTRY.exists():
        fail(
            f"{where} is missing. It is tracked and required; restore it from "
            "git rather than letting every date be recomputed."
        )
    try:
        raw = json.loads(REGISTRY.read_text())
    except json.JSONDecodeError as exc:
        fail(f"{where} is not valid JSON: {exc}")
    if not isinstance(raw, dict):
        fail(f"{where} must be a JSON object, not {type(raw).__name__}.")
    if raw.get("version") != REGISTRY_VERSION:
        fail(
            f"{where} is version {raw.get('version')!r}; this generator writes "
            f"version {REGISTRY_VERSION}. Migrate the file deliberately — a "
            "version this generator does not understand is not a date source."
        )
    pages = raw.get("pages")
    if not isinstance(pages, dict):
        fail(f"{where} has no 'pages' object.")
    for name, entry in pages.items():
        if not isinstance(entry, dict):
            fail(f"{where}: {name} is not an object.")
        digest, lastmod = entry.get("sha256"), entry.get("lastmod")
        if not isinstance(digest, str) or not SHA256_HEX.fullmatch(digest):
            fail(f"{where}: {name} has no valid lowercase sha256 digest.")
        if not isinstance(lastmod, str) or not ISO_DATE.fullmatch(lastmod):
            fail(f"{where}: {name} has no valid YYYY-MM-DD lastmod.")
    return pages


def is_site_page(path: pathlib.Path) -> bool:
    # Verification stubs (Search Console's google*.html and similar) live in
    # docs/ but are not pages: no Groundwork head, and they must never
    # appear in the sitemap or llms.txt.
    return 'property="og:site_name" content="Groundwork"' in path.read_text()


def main() -> int:
    check = "--check" in sys.argv
    registry = load_registry()
    pages = sorted(p for p in DOCS.glob("*.html") if is_site_page(p))
    for page in pages:
        if not SAFE_PAGE_NAME.fullmatch(page.name):
            fail(
                f"unsafe page filename {page.name!r}; docs pages must be "
                "simple [A-Za-z0-9._-].html names so they stay unambiguous as "
                "registry keys and sitemap URLs."
            )
    changed: list[str] = []
    entries = []

    for page in pages:
        text = page.read_text()
        desc_attr = html.escape(page_description(text), quote=True)
        new = text
        new = set_meta(
            new,
            r'(<meta name="description" content=")[^"]*(")',
            desc_attr,
        )
        new = set_meta(
            new,
            r'(<meta property="og:description" content=")[^"]*(")',
            desc_attr,
        )
        new = set_meta(
            new,
            r'(<meta name="twitter:description" content=")[^"]*(")',
            desc_attr,
        )
        if new != text:
            changed.append(f"docs/{page.name}")
            if not check:
                page.write_text(new)
        # `new`, not `text`: the fingerprint must cover the bytes this generator
        # would leave on disk, or a pending description rewrite would land later
        # as a phantom content change.
        entries.append((page, page_title(new), page_description(new), new))

    url_of = lambda p: f"{BASE}/" if p.name == "index.html" else f"{BASE}/{p.name}"

    today = datetime.date.today().isoformat()
    fingerprints: dict[str, dict[str, str]] = {}
    moved: list[str] = []

    def page_lastmod(page: pathlib.Path, text: str) -> str:
        digest = hashlib.sha256(text.encode()).hexdigest()
        recorded = registry.get(page.name)
        if recorded and recorded["sha256"] == digest:
            lastmod = recorded["lastmod"]
        else:
            lastmod = today
            why = "content changed" if recorded else "new page"
            moved.append(f"{page.name}: {why} -> {lastmod}")
        fingerprints[page.name] = {"sha256": digest, "lastmod": lastmod}
        return lastmod

    sitemap_lines = ['<?xml version="1.0" encoding="UTF-8"?>']
    sitemap_lines.append(
        '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">'
    )
    for page, _title, _desc, text in entries:
        sitemap_lines.append("  <url>")
        sitemap_lines.append(f"    <loc>{url_of(page)}</loc>")
        sitemap_lines.append(f"    <lastmod>{page_lastmod(page, text)}</lastmod>")
        sitemap_lines.append("  </url>")
    sitemap_lines.append("</urlset>")
    sitemap = "\n".join(sitemap_lines) + "\n"

    for gone in sorted(set(registry) - set(fingerprints)):
        moved.append(f"{gone}: page removed")
    registry_json = json.dumps(
        {"version": REGISTRY_VERSION, "pages": dict(sorted(fingerprints.items()))},
        indent=2,
    ) + "\n"

    llms_lines = [f"# {SITE}", "", f"> {SUMMARY}", ""]
    llms_lines.append(
        "Groundwork scaffolds the developer: environment, fundamentals, and"
    )
    llms_lines.append(
        "agent-direction skills. Its sibling, Roost, scaffolds an"
    )
    llms_lines.append(
        "organization's code and process. Repo:"
    )
    llms_lines.append("https://github.com/jasondockery/groundwork")
    llms_lines.append("")
    llms_lines.append("## Docs")
    llms_lines.append("")
    for page, title, desc, _text in entries:
        llms_lines.append(f"- [{title}]({url_of(page)}): {desc}")
    llms = "\n".join(llms_lines) + "\n"

    artifacts = (
        (DOCS / "sitemap.xml", "docs/sitemap.xml", sitemap),
        (DOCS / "llms.txt", "docs/llms.txt", llms),
        (REGISTRY, str(REGISTRY.relative_to(ROOT)), registry_json),
    )
    for path, label, content in artifacts:
        if not path.exists() or path.read_text() != content:
            changed.append(label)
            if not check:
                path.write_text(content)

    if check and changed:
        print("discovery artifacts stale; run scripts/generate-discovery:")
        for c in sorted(set(changed)):
            print(f"  {c}")
        if moved:
            # A date only moves when a page's bytes moved, so this list is the
            # whole reason the artifacts are stale. Naming each page separates a
            # real edit from a page that was added or removed without a rerun.
            print("lastmod changes (page: why -> date):")
            for line in moved:
                print(f"  {line}")
        return 1
    if changed:
        print(f"updated: {len(set(changed))} file(s)")
    else:
        print("discovery artifacts already current")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
