#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "$(uname -s)" != Darwin ]]; then
  echo "skip: Homebrew interactive terminal proof requires macOS script(1)"
  exit 0
fi

fixture="$(mktemp -d "${TMPDIR:-/tmp}/groundwork-brew-terminal.XXXXXX")"
cleanup() {
  rm -rf -- "$fixture"
}
trap cleanup EXIT

cat >"$fixture/prompt-command" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
[[ -t 0 && -t 1 && -t 2 ]] || exit 91
printf '\033[32m==> Preparing Docker Desktop\033[0m\r'
printf '==> Replacing Docker Desktop\n'
printf "%s\r\033[2K%s\n" \
  "==> Unlinking Bash Completion '/opt/homebrew/etc/bash_completion.d/docker'" \
  "==> Unlinking Fish Completion '/opt/homebrew/share/fish/vendor_completions.d/docker.fish'"
printf 'ordered stdout marker\n'
printf 'ordered stderr marker\n' >&2
terminal_state="$(stty -g)"
trap 'stty "$terminal_state"' EXIT
stty -echo
printf 'First password prompt: '
IFS= read -r first
printf '\n'
# sudo and Homebrew's privileged helpers may open the controlling terminal
# directly instead of consuming stdin. Model that separately from the first
# ordinary prompt so a PTY that only forwards stdin cannot satisfy this proof.
exec 3<>/dev/tty
printf 'Second password prompt: ' >&3
IFS= read -r second <&3
printf '\n' >&3
exec 3>&-
stty "$terminal_state"
trap - EXIT
[[ "$first" == alpha && "$second" == bravo ]] || exit 92
printf '\033[31m%s\033[0m\n' "Error: docker-desktop: It seems there is already an App at '/opt/homebrew/Caskroom/docker-desktop/4.85.0/Docker.app'."
exit 23
SH
chmod +x "$fixture/prompt-command"

python3 - "$repo" "$fixture" <<'PY'
import errno
import os
import pathlib
import pty
import select
import sys
import time

repo = pathlib.Path(sys.argv[1])
fixture = pathlib.Path(sys.argv[2])
library = repo / "home/dot_local/share/groundwork/lib/brew-output.sh"
command = fixture / "prompt-command"
log = fixture / "prompt.log"
receipt = fixture / "prompt.tsv"

shell = (
    f"source {library!s}; "
    "GROUNDWORK_BREW_POLL_SECONDS=0.05 "
    f"gw_brew_run_logged {log!s} {receipt!s} reset 'Homebrew prompt fixture' -- {command!s}"
)
pid, master = pty.fork()
if pid == 0:
    os.execve("/bin/bash", ["/bin/bash", "-c", shell], os.environ.copy())

captured = bytearray()
sent_first = False
sent_second = False
deadline = time.monotonic() + 15
while time.monotonic() < deadline:
    readable, _, _ = select.select([master], [], [], 0.1)
    if readable:
        try:
            chunk = os.read(master, 65536)
        except OSError as error:
            if error.errno == errno.EIO:
                chunk = b""
            else:
                raise
        if not chunk:
            break
        captured.extend(chunk)
        if not sent_first and b"First password prompt:" in captured:
            os.write(master, b"alpha\n")
            sent_first = True
        if sent_first and not sent_second and b"Second password prompt:" in captured:
            os.write(master, b"bravo\n")
            sent_second = True
    waited, status = os.waitpid(pid, os.WNOHANG)
    if waited == pid:
        break
else:
    os.kill(pid, 9)
    os.waitpid(pid, 0)
    raise SystemExit("interactive Homebrew fixture exceeded its 15-second test deadline")

if 'status' not in locals() or waited != pid:
    _, status = os.waitpid(pid, 0)
returncode = os.waitstatus_to_exitcode(status)
if returncode != 23:
    raise SystemExit(f"interactive Homebrew status changed from 23 to {returncode}\n{captured.decode(errors='replace')}")
text = captured.decode(errors="replace")
for expected in (
    "attached directly to this terminal",
    "First password prompt:",
    "Second password prompt:",
    "Error: docker-desktop:",
):
    if expected not in text:
        raise SystemExit(f"interactive output omitted {expected!r}\n{text}")
if "alpha" in text or "bravo" in text:
    raise SystemExit("terminal input was echoed into the live Homebrew transcript")
if text.index("ordered stdout marker") > text.index("ordered stderr marker"):
    raise SystemExit("interactive Homebrew output reversed stdout/stderr order")
PY

python3 - "$fixture/prompt.log" "$fixture/prompt.tsv" <<'PY'
import pathlib
import sys

log = pathlib.Path(sys.argv[1]).read_bytes()
if b"\x1b" in log or b"\r" in log:
    raise SystemExit("saved Homebrew log retained terminal control bytes")
if b"Error: docker-desktop:" not in log:
    raise SystemExit("saved Homebrew log omitted the child error")
for expected in (
    b"==> Unlinking Bash Completion '/opt/homebrew/etc/bash_completion.d/docker'",
    b"==> Unlinking Fish Completion '/opt/homebrew/share/fish/vendor_completions.d/docker.fish'",
):
    if expected not in log:
        raise SystemExit(f"saved Homebrew log omitted observed Docker transcript line {expected!r}")
if b"                                        ==> Unlinking" in log:
    raise SystemExit("saved Homebrew log converted cursor movement into shifting spaces")
if b"alpha" in log or b"bravo" in log:
    raise SystemExit("terminal input was persisted in the saved Homebrew log")
receipt = pathlib.Path(sys.argv[2]).read_text().splitlines()
if "error\t1" not in receipt or "failed-cask\tdocker-desktop" not in receipt:
    raise SystemExit(f"unexpected Homebrew receipt: {receipt!r}")
PY

cat >"$fixture/quiet-command" <<'SH'
#!/usr/bin/env bash
sleep 2
echo quiet-command-complete
SH
chmod +x "$fixture/quiet-command"

python3 - "$repo" "$fixture" <<'PY'
import errno
import os
import pathlib
import pty
import select
import sys
import time

repo = pathlib.Path(sys.argv[1])
fixture = pathlib.Path(sys.argv[2])
library = repo / "home/dot_local/share/groundwork/lib/brew-output.sh"
command = fixture / "quiet-command"
log = fixture / "quiet.log"
receipt = fixture / "quiet.tsv"
shell = (
    f"source {library!s}; "
    "GROUNDWORK_BREW_STALL_SECONDS=1 GROUNDWORK_BREW_DEADLINE_SECONDS=8 "
    "GROUNDWORK_BREW_POLL_SECONDS=0.05 "
    f"gw_brew_run_logged {log!s} {receipt!s} reset 'Homebrew quiet fixture' -- {command!s}"
)
pid, master = pty.fork()
if pid == 0:
    os.execve("/bin/bash", ["/bin/bash", "-c", shell], os.environ.copy())

captured = bytearray()
deadline = time.monotonic() + 12
status = None
while time.monotonic() < deadline:
    readable, _, _ = select.select([master], [], [], 0.1)
    if readable:
        try:
            chunk = os.read(master, 65536)
        except OSError as error:
            if error.errno == errno.EIO:
                chunk = b""
            else:
                raise
        captured.extend(chunk)
    waited, candidate = os.waitpid(pid, os.WNOHANG)
    if waited == pid:
        status = candidate
        break
if status is None:
    os.kill(pid, 9)
    os.waitpid(pid, 0)
    raise SystemExit("quiet Homebrew fixture exceeded its test deadline")
if os.waitstatus_to_exitcode(status) != 0:
    raise SystemExit(captured.decode(errors="replace"))
text = captured.decode(errors="replace")
if "still running; no output for" not in text:
    raise SystemExit(f"quiet child did not produce a stall diagnostic\n{text}")
if "quiet-command-complete" not in text:
    raise SystemExit(f"quiet child did not complete normally\n{text}")
PY

cat >"$fixture/timeout-command" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
echo "$$" >"$GROUNDWORK_TEST_CHILD_PID"
trap 'exit 0' TERM HUP
while :; do sleep 1; done
SH
chmod +x "$fixture/timeout-command"

python3 - "$repo" "$fixture" <<'PY'
import errno
import os
import pathlib
import pty
import re
import select
import signal
import sys
import termios
import time

repo = pathlib.Path(sys.argv[1])
fixture = pathlib.Path(sys.argv[2])
library = repo / "home/dot_local/share/groundwork/lib/brew-output.sh"
command = fixture / "timeout-command"
log = fixture / "timeout.log"
receipt = fixture / "timeout.tsv"
child_pid_file = fixture / "timeout-child.pid"
shell = (
    f"source {library!s}; "
    "GROUNDWORK_BREW_DEADLINE_SECONDS=2 GROUNDWORK_BREW_STALL_SECONDS=1 "
    "GROUNDWORK_BREW_CANCEL_GRACE_SECONDS=1 GROUNDWORK_BREW_POLL_SECONDS=0.05 "
    f"GROUNDWORK_TEST_CHILD_PID={child_pid_file!s} "
    f"gw_brew_run_logged {log!s} {receipt!s} reset 'Homebrew timeout fixture' -- {command!s}"
)
pid, master = pty.fork()
if pid == 0:
    os.execve("/bin/bash", ["/bin/bash", "-c", shell], os.environ.copy())

captured = bytearray()
deadline = time.monotonic() + 10
status = None
while time.monotonic() < deadline:
    readable, _, _ = select.select([master], [], [], 0.1)
    if readable:
        try:
            captured.extend(os.read(master, 65536))
        except OSError as error:
            if error.errno != errno.EIO:
                raise
    waited, candidate = os.waitpid(pid, os.WNOHANG)
    if waited == pid:
        status = candidate
        break
if status is None:
    os.kill(pid, signal.SIGKILL)
    os.waitpid(pid, 0)
    raise SystemExit("Homebrew timeout fixture exceeded its test deadline")
returncode = os.waitstatus_to_exitcode(status)
if returncode != 124:
    raise SystemExit(f"Homebrew timeout returned {returncode}, not 124\n{captured.decode(errors='replace')}")
text = captured.decode(errors="replace")
if "exceeded its 2s hard deadline; cancelling it" not in text:
    raise SystemExit(f"Homebrew timeout was not explained\n{text}")

child_pid = int(child_pid_file.read_text())
for _ in range(20):
    try:
        os.kill(child_pid, 0)
    except ProcessLookupError:
        break
    time.sleep(0.1)
else:
    raise SystemExit(f"timed-out Homebrew child {child_pid} survived bounded cancellation")
PY

# Ctrl-C is the cancellation the field actually reaches for, and it has to work
# through two layers that both fight it: script(1) disables signal generation on
# the real terminal, and bash forces SIGINT to SIG_IGN in an asynchronous child
# in a way that survives exec and cannot be reset from inside the child.
#
# The fixtures refuse SIGHUP so a collapsing pseudo-terminal cannot pass for
# cancellation — that substitution is exactly how this suite stayed green while
# the field defect was live. The grandchild models brew's own backgrounded
# helpers (sudo, installer, hdiutil): it inherits the same ignored interrupt and
# outlives the session leader Ctrl-C stops, and it refuses SIGTERM so only a
# real TERM-to-KILL escalation against the whole group can close it.
# A separate script, not a subshell: macOS still ships bash 3.2 as /bin/bash and
# BASHPID does not exist there, so a subshell cannot report its own pid. A
# backgrounded script's $$ is its own pid in every bash.
cat >"$fixture/stubborn-helper" <<'SH'
#!/usr/bin/env bash
set -uo pipefail
trap '' HUP INT TERM
echo "$$" >"$GROUNDWORK_TEST_GRANDCHILD_PID"
while :; do sleep 1; done
SH
chmod +x "$fixture/stubborn-helper"

cat >"$fixture/interrupt-command" <<'SH'
#!/usr/bin/env bash
set -uo pipefail
trap '' HUP
echo "$$" >"$GROUNDWORK_TEST_CHILD_PID"
"$GROUNDWORK_TEST_HELPER" &
echo "interrupt-fixture-ready"
while :; do sleep 1; done
SH
chmod +x "$fixture/interrupt-command"

# The hard deadline owes the same guarantees as Ctrl-C. Here even the session
# leader refuses HUP, INT, and TERM, so the deadline path is proven to escalate
# to KILL across the entire nested group rather than relying on cooperation.
cat >"$fixture/stubborn-command" <<'SH'
#!/usr/bin/env bash
set -uo pipefail
trap '' HUP INT TERM
"$GROUNDWORK_TEST_HELPER" &
echo "$$" >"$GROUNDWORK_TEST_CHILD_PID"
echo "stubborn-fixture-ready"
while :; do sleep 1; done
SH
chmod +x "$fixture/stubborn-command"

# Models real Homebrew for the printed group-recovery path: it refuses SIGHUP
# and SIGINT so a collapsing pseudo-terminal or a stray interrupt cannot pass
# for cancellation, but it honours SIGTERM the way brew, sudo, and installer do.
cat >"$fixture/signalable-helper" <<'SH'
#!/usr/bin/env bash
set -uo pipefail
trap '' HUP INT
echo "$$" >"$GROUNDWORK_TEST_GRANDCHILD_PID"
while :; do sleep 1; done
SH
chmod +x "$fixture/signalable-helper"

cat >"$fixture/signalable-command" <<'SH'
#!/usr/bin/env bash
set -uo pipefail
trap '' HUP INT
"$GROUNDWORK_TEST_HELPER" &
echo "$$" >"$GROUNDWORK_TEST_CHILD_PID"
echo "signalable-fixture-ready"
while :; do sleep 1; done
SH
chmod +x "$fixture/signalable-command"

# One driver for both cases. It records the caller's complete terminal mode and
# a distinctive caller trap before the attached stage, and reports both back
# afterwards, so the assertions can prove the pane and the caller's own
# cancellation behavior were returned exactly as they were borrowed.
cat >"$fixture/cancel-driver" <<'SH'
#!/usr/bin/env bash
set -uo pipefail
# shellcheck source=/dev/null
. "$GW_LIBRARY"
trap 'echo CALLER_INT_TRAP_FIRED' INT
trap 'echo CALLER_TERM_TRAP_FIRED' TERM
before="$(stty -g)"
printf 'GW_SUPERVISOR_PID=%s\n' "$$"
# Model the update runner: a signal trap that exits the shell directly, and an
# EXIT handler that closes any still-live attached stage before restoring the
# terminal. Without that handler the direct exit skips the in-function sweep.
driver_exit() {
  status=$?
  trap - EXIT
  printf 'GW_WATCHDOG_PID=%s\n' "$GW_BREW_ACTIVE_WATCHDOG"
  printf 'GW_RECORDER_PID=%s\n' "$GW_BREW_ACTIVE_RECORDER"
  active_pgid="$(gw_brew_verify_pgid "$GW_BREW_ACTIVE_PGID_FILE" "$GW_BREW_ACTIVE_OUTER_PGID" 2>/dev/null || true)"
  printf 'GW_NESTED_PGID=%s\n' "$active_pgid"
  gw_brew_cleanup_active_stage || status=$?
  gw_brew_tty_restore || status=$?
  after="$(stty -g)"
  if [[ "$before" == "$after" ]]; then
    printf '\nGW_STTY=identical\n'
  else
    printf '\nGW_STTY=changed\n  before=%s\n  after=%s\n' "$before" "$after"
  fi
  exit "$status"
}
if [[ -n "${GW_EXIT_ON_SIGNAL:-}" ]]; then
  trap driver_exit EXIT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
fi
gw_brew_run_logged "$GW_LOG" "$GW_RECEIPT" reset "$GW_LABEL" -- "$GW_COMMAND"
status=$?
after="$(stty -g)"
if [[ "$before" == "$after" ]]; then
  printf '\nGW_STTY=identical\n'
else
  printf '\nGW_STTY=changed\n  before=%s\n  after=%s\n' "$before" "$after"
fi
# Capture BEFORE piping. On bash 3.2 a pipeline inside command substitution
# runs in a subshell where SIGINT is SIG_IGN, so `trap -p INT` there reports
# nothing even though the trap is intact -- an artifact of the probe, not a
# lost trap. Plain command substitution reports it correctly.
trap_int="$(trap -p INT)"
trap_term="$(trap -p TERM)"
printf 'GW_TRAP_INT=%s\n' "$(printf '%s' "$trap_int" | tr -d '\n')"
printf 'GW_TRAP_TERM=%s\n' "$(printf '%s' "$trap_term" | tr -d '\n')"
exit "$status"
SH
chmod +x "$fixture/cancel-driver"

python3 - "$repo" "$fixture" <<'PY'
import errno
import os
import pathlib
import pty
import re
import select
import signal
import subprocess
import sys
import termios
import time

repo = pathlib.Path(sys.argv[1])
fixture = pathlib.Path(sys.argv[2])
library = repo / "home/dot_local/share/groundwork/lib/brew-output.sh"


def process_stopped(pid):
    result = subprocess.run(
        ["ps", "-o", "stat=", "-p", str(pid)],
        check=False, capture_output=True, text=True,
    )
    state = result.stdout.strip()
    return not state or state.startswith("Z")


def group_alive(pgid):
    result = subprocess.run(
        ["ps", "-axo", "pgid=,stat="],
        check=True, capture_output=True, text=True,
    )
    for line in result.stdout.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[0] == str(pgid) and not fields[1].startswith("Z"):
            return True
    return False


def require_stopped(description, pid, text, attempts=100):
    for _ in range(attempts):
        if process_stopped(pid):
            return
        time.sleep(0.1)
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return
    raise SystemExit(f"{description} {pid} remained live\n{text}")


def drive(case, environment, ready_marker, interrupt, expected_status, budget,
          trap_signals=("INT", "TERM")):
    """Run one cancellation case under a real controlling terminal."""
    child_pid_file = fixture / f"{case}-child.pid"
    grandchild_pid_file = fixture / f"{case}-grandchild.pid"
    for stale in (child_pid_file, grandchild_pid_file):
        if stale.exists():
            stale.unlink()
    passed = dict(os.environ)
    passed.update(
        {
            "GW_LIBRARY": str(library),
            "GW_LOG": str(fixture / f"{case}.log"),
            "GW_RECEIPT": str(fixture / f"{case}.tsv"),
            "GW_LABEL": f"Homebrew {case} fixture",
            "GW_COMMAND": str(fixture / f"{case}-command"),
            "GROUNDWORK_TEST_CHILD_PID": str(child_pid_file),
            "GROUNDWORK_TEST_GRANDCHILD_PID": str(grandchild_pid_file),
            "GROUNDWORK_TEST_HELPER": str(fixture / "stubborn-helper"),
        }
    )
    passed.update(environment)
    pid, master = pty.fork()
    if pid == 0:
        os.execve(str(fixture / "cancel-driver"), [str(fixture / "cancel-driver")], passed)

    captured = bytearray()
    sent = not interrupt
    status = None
    deadline = time.monotonic() + budget
    while time.monotonic() < deadline:
        readable, _, _ = select.select([master], [], [], 0.1)
        if readable:
            try:
                captured.extend(os.read(master, 65536))
            except OSError as error:
                if error.errno != errno.EIO:
                    raise
        if (not sent and ready_marker.encode() in captured
                and child_pid_file.exists() and grandchild_pid_file.exists()):
            # Both processes must have recorded themselves first, or the
            # interrupt races the fixture instead of testing cancellation. Then
            # let script(1) finish taking the terminal before it lands.
            time.sleep(0.5)
            os.write(master, b"\x03")
            sent = True
        waited, candidate = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            status = candidate
            break
    text = captured.decode(errors="replace")
    if status is None:
        os.kill(pid, signal.SIGKILL)
        os.waitpid(pid, 0)
        raise SystemExit(f"{case}: cancellation did not complete within the test budget\n{text}")

    returncode = os.waitstatus_to_exitcode(status)
    if returncode != expected_status:
        raise SystemExit(
            f"{case}: exit {returncode}, expected {expected_status}. update-all "
            f"distinguishes cancellation from an ordinary Homebrew failure by this "
            f"status; a wrong one sends it into repair and retry against a terminal "
            f"the user just asked to have back\n{text}"
        )
    if "GW_STTY=identical" not in text:
        raise SystemExit(
            f"{case}: the caller's terminal mode was not restored exactly as borrowed; "
            f"script(1) disables signal generation, so a pane left this way ignores "
            f"Ctrl-C and Ctrl-Z entirely\n{text}"
        )
    for signal_name in trap_signals:
        if f"CALLER_{signal_name}_TRAP_FIRED" not in text.split(f"GW_TRAP_{signal_name}=")[-1]:
            raise SystemExit(
                f"{case}: the caller's own {signal_name} trap did not survive the "
                f"attached stage; the rest of the transaction would run with the "
                f"cancellation behavior it declared silently removed\n{text}"
            )
    for name, pid_file in (("leader", child_pid_file), ("grandchild", grandchild_pid_file)):
        recorded = int(pid_file.read_text())
        for _ in range(40):
            try:
                os.kill(recorded, 0)
            except ProcessLookupError:
                break
            time.sleep(0.1)
        else:
            os.kill(recorded, signal.SIGKILL)
            raise SystemExit(
                f"{case}: Homebrew {name} {recorded} survived cancellation; the "
                f"nested process group was not closed\n{text}"
            )
    return text


drive(
    "interrupt",
    {
        "GROUNDWORK_BREW_POLL_SECONDS": "0.05",
        "GROUNDWORK_BREW_CANCEL_GRACE_SECONDS": "2",
    },
    "interrupt-fixture-ready",
    interrupt=True,
    expected_status=130,
    budget=40,
)

deadline_text = drive(
    "stubborn",
    {
        "GROUNDWORK_BREW_DEADLINE_SECONDS": "3",
        "GROUNDWORK_BREW_STALL_SECONDS": "1",
        "GROUNDWORK_BREW_CANCEL_GRACE_SECONDS": "1",
        "GROUNDWORK_BREW_POLL_SECONDS": "0.05",
    },
    "stubborn-fixture-ready",
    interrupt=False,
    expected_status=124,
    budget=40,
)
if "exceeded its 3s hard deadline" not in deadline_text:
    raise SystemExit(f"the hard deadline was not explained to the user\n{deadline_text}")


def drive_outer_signal(signal_name, signal_number, expected_status):
    """Signal only the /bin/bash 3.2 supervisor and prove EXIT cleanup."""
    case = f"outer-{signal_name.lower()}"
    child_pid_file = fixture / f"{case}-child.pid"
    grandchild_pid_file = fixture / f"{case}-grandchild.pid"
    log = fixture / f"{case}.log"
    for stale in (child_pid_file, grandchild_pid_file):
        if stale.exists():
            stale.unlink()
    passed = dict(os.environ)
    passed.update({
        "GW_LIBRARY": str(library),
        "GW_LOG": str(log),
        "GW_RECEIPT": str(fixture / f"{case}.tsv"),
        "GW_LABEL": f"Homebrew outer SIG{signal_name} fixture",
        "GW_COMMAND": str(fixture / "stubborn-command"),
        "GROUNDWORK_TEST_CHILD_PID": str(child_pid_file),
        "GROUNDWORK_TEST_GRANDCHILD_PID": str(grandchild_pid_file),
        "GROUNDWORK_TEST_HELPER": str(fixture / "stubborn-helper"),
        "GW_EXIT_ON_SIGNAL": "1",
        "GROUNDWORK_BREW_POLL_SECONDS": "0.05",
        "GROUNDWORK_BREW_CANCEL_GRACE_SECONDS": "1",
        "GROUNDWORK_BREW_STALL_SECONDS": "600",
        "GROUNDWORK_BREW_DEADLINE_SECONDS": "600",
    })
    pid, master = pty.fork()
    if pid == 0:
        # Explicitly exercise Apple's supported Bash 3.2 boundary, regardless
        # of which newer bash /usr/bin/env might find in the job's PATH.
        os.execve("/bin/bash", ["/bin/bash", str(fixture / "cancel-driver")], passed)

    captured = bytearray()
    signalled = False
    status = None
    deadline = time.monotonic() + 40
    while time.monotonic() < deadline:
        readable, _, _ = select.select([master], [], [], 0.1)
        if readable:
            try:
                captured.extend(os.read(master, 65536))
            except OSError as error:
                if error.errno != errno.EIO:
                    raise
        if (not signalled and b"stubborn-fixture-ready" in captured
                and child_pid_file.exists() and grandchild_pid_file.exists()):
            match = re.search(rb"GW_SUPERVISOR_PID=(\d+)", captured)
            if match:
                # The nested group is deliberately not signalled here. This is
                # the external caller path the prior test never exercised.
                os.kill(int(match.group(1)), signal_number)
                signalled = True
        waited, candidate = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            status = candidate
            break
    text = captured.decode(errors="replace")
    if status is None:
        os.kill(pid, signal.SIGKILL)
        os.waitpid(pid, 0)
        raise SystemExit(f"outer SIG{signal_name} did not complete\n{text}")
    if not signalled:
        raise SystemExit(f"outer SIG{signal_name} never found the supervisor\n{text}")
    returncode = os.waitstatus_to_exitcode(status)
    if returncode != expected_status:
        raise SystemExit(
            f"outer SIG{signal_name} returned {returncode}, expected "
            f"{expected_status}\n{text}")
    if "GW_STTY=identical" not in text:
        raise SystemExit(f"outer SIG{signal_name} did not restore the exact terminal\n{text}")

    identifiers = {}
    for key in ("WATCHDOG_PID", "RECORDER_PID", "NESTED_PGID"):
        match = re.search(rf"GW_{key}=(\d+)", text)
        if not match:
            raise SystemExit(f"outer SIG{signal_name} omitted {key}\n{text}")
        identifiers[key] = int(match.group(1))
    require_stopped("watchdog", identifiers["WATCHDOG_PID"], text)
    require_stopped("terminal recorder", identifiers["RECORDER_PID"], text)
    for _ in range(100):
        if not group_alive(identifiers["NESTED_PGID"]):
            break
        time.sleep(0.1)
    else:
        raise SystemExit(f"outer SIG{signal_name} left the nested group live\n{text}")
    require_stopped("Homebrew leader", int(child_pid_file.read_text()), text)
    require_stopped("Homebrew helper", int(grandchild_pid_file.read_text()), text)

    if not log.is_file():
        raise SystemExit(f"outer SIG{signal_name} lost the finalized diagnostic log")
    leftovers = []
    for suffix in ("pty", "cancel", "status"):
        leftovers.extend(log.parent.glob(f"{log.name}.{suffix}.*"))
    if leftovers:
        raise SystemExit(
            f"outer SIG{signal_name} retained private stage files: {leftovers}")


# Separate Bash 3.2 PTY cases for each outer signal. The stubborn workload
# proves that EXIT cleanup performs TERM-to-KILL escalation rather than merely
# observing a cooperative command exit.
drive_outer_signal("TERM", signal.SIGTERM, 143)
drive_outer_signal("HUP", signal.SIGHUP, 129)


def drive_group_fallback(signal_name, signal_number, expected_status):
    """Prove the recovery command Groundwork actually prints.

    The workload models real Homebrew: it refuses SIGHUP and SIGINT, so neither
    a collapsing pseudo-terminal nor a stray interrupt can pass for
    cancellation, but it honours SIGTERM the way brew, sudo, and installer do.
    The printed command must free the supervisor, leave no group member behind,
    and hand the terminal back exactly as it was lent.
    """
    case = "signalable"
    child_pid_file = fixture / f"{case}-child.pid"
    grandchild_pid_file = fixture / f"{case}-grandchild.pid"
    for stale in (child_pid_file, grandchild_pid_file):
        if stale.exists():
            stale.unlink()
    passed = dict(os.environ)
    passed.update({
        "GW_LIBRARY": str(library),
        "GW_LOG": str(fixture / f"external-{signal_name}.log"),
        "GW_RECEIPT": str(fixture / f"external-{signal_name}.tsv"),
        "GW_LABEL": f"Homebrew external {signal_name} fixture",
        "GW_COMMAND": str(fixture / f"{case}-command"),
        "GROUNDWORK_TEST_CHILD_PID": str(child_pid_file),
        "GROUNDWORK_TEST_GRANDCHILD_PID": str(grandchild_pid_file),
        "GROUNDWORK_TEST_HELPER": str(fixture / "signalable-helper"),
        "GW_EXIT_ON_SIGNAL": "1",
        "GROUNDWORK_BREW_STALL_SECONDS": "1",
        "GROUNDWORK_BREW_POLL_SECONDS": "0.05",
        "GROUNDWORK_BREW_CANCEL_GRACE_SECONDS": "2",
        "GROUNDWORK_BREW_DEADLINE_SECONDS": "600",
    })
    pid, master = pty.fork()
    if pid == 0:
        os.execve(str(fixture / "cancel-driver"), [str(fixture / "cancel-driver")], passed)

    captured = bytearray()
    signalled = False
    status = None
    deadline = time.monotonic() + 40
    while time.monotonic() < deadline:
        readable, _, _ = select.select([master], [], [], 0.1)
        if readable:
            try:
                captured.extend(os.read(master, 65536))
            except OSError as error:
                if error.errno != errno.EIO:
                    raise
        if not signalled and b"signalable-fixture-ready" in captured:
            # Take the process group from the recovery line the user is shown,
            # so a wrong or unusable instruction fails this test.
            match = re.search(rb"kill -TERM -- -(\d+)", captured)
            # Both processes must have recorded themselves first, or this would
            # race the fixture rather than test the recovery command.
            if match and child_pid_file.exists() and grandchild_pid_file.exists():
                os.killpg(int(match.group(1)), signal_number)
                signalled = True
        waited, candidate = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            status = candidate
            break
    text = captured.decode(errors="replace")
    if status is None:
        os.kill(pid, signal.SIGKILL)
        os.waitpid(pid, 0)
        raise SystemExit(
            f"the printed SIG{signal_name} group recovery never freed the "
            f"supervisor\n{text}")
    if not signalled:
        raise SystemExit(f"Groundwork never printed a group recovery command\n{text}")
    returncode = os.waitstatus_to_exitcode(status)
    if returncode != expected_status:
        raise SystemExit(
            f"the printed SIG{signal_name} group recovery produced exit "
            f"{returncode}, expected {expected_status}\n{text}")
    if "GW_STTY=identical" not in text:
        raise SystemExit(
            f"the printed SIG{signal_name} group recovery left the terminal "
            f"unrestored\n{text}")
    for name, pid_file in (("leader", child_pid_file),
                           ("grandchild", grandchild_pid_file)):
        recorded = int(pid_file.read_text())
        for _ in range(60):
            try:
                os.kill(recorded, 0)
            except ProcessLookupError:
                break
            time.sleep(0.1)
        else:
            os.kill(recorded, signal.SIGKILL)
            raise SystemExit(
                f"the printed SIG{signal_name} group recovery left Homebrew "
                f"{name} {recorded} running with no terminal attached")


# 143: the workload's own TERM handling records it, and the runner treats that
# as cancellation rather than an ordinary Homebrew failure.
drive_group_fallback("TERM", signal.SIGTERM, 143)

def drive_supervisor_killed():
    """A supervisor killed outright must not leave Homebrew running.

    SIGKILL is the case no trap can catch or defer, so no EXIT handler runs and
    the in-function sweep never happens. The watchdog is the only observer still
    alive, and closing the nested group is its job. The workload refuses HUP,
    INT, and TERM, so only a real TERM-to-KILL escalation against the whole
    group can close it.
    """
    case = "stubborn"
    child_pid_file = fixture / f"{case}-child.pid"
    grandchild_pid_file = fixture / f"{case}-grandchild.pid"
    for stale in (child_pid_file, grandchild_pid_file):
        if stale.exists():
            stale.unlink()
    passed = dict(os.environ)
    passed.update({
        "GW_LIBRARY": str(library),
        "GW_LOG": str(fixture / "killed.log"),
        "GW_RECEIPT": str(fixture / "killed.tsv"),
        "GW_LABEL": "Homebrew killed-supervisor fixture",
        "GW_COMMAND": str(fixture / f"{case}-command"),
        "GROUNDWORK_TEST_CHILD_PID": str(child_pid_file),
        "GROUNDWORK_TEST_GRANDCHILD_PID": str(grandchild_pid_file),
        "GROUNDWORK_TEST_HELPER": str(fixture / "stubborn-helper"),
        "GROUNDWORK_BREW_POLL_SECONDS": "0.05",
        "GROUNDWORK_BREW_CANCEL_GRACE_SECONDS": "2",
        "GROUNDWORK_BREW_STALL_SECONDS": "600",
        "GROUNDWORK_BREW_DEADLINE_SECONDS": "600",
    })
    marker_dir = fixture / "killed-markers"
    marker_dir.mkdir(exist_ok=True)
    passed["GW_LOG"] = str(marker_dir / "killed.log")
    pid, master = pty.fork()
    if pid == 0:
        os.execve(str(fixture / "cancel-driver"), [str(fixture / "cancel-driver")], passed)

    # The authoritative before/after is the terminal itself, read from the
    # master, not anything the dying supervisor could print.
    before_attributes = termios.tcgetattr(master)
    captured = bytearray()
    killed = False
    deadline = time.monotonic() + 40
    while time.monotonic() < deadline:
        readable, _, _ = select.select([master], [], [], 0.1)
        if readable:
            try:
                captured.extend(os.read(master, 65536))
            except OSError as error:
                if error.errno != errno.EIO:
                    raise
        if not killed and b"stubborn-fixture-ready" in captured:
            match = re.search(rb"GW_SUPERVISOR_PID=(\d+)", captured)
            if match:
                # Let the nested group publish itself, then remove the
                # supervisor without warning.
                time.sleep(1.0)
                os.kill(int(match.group(1)), signal.SIGKILL)
                killed = True
        waited, _ = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            break
    text = captured.decode(errors="replace")
    recorded_pids = {}
    for name, pid_file in (("leader", child_pid_file),
                           ("grandchild", grandchild_pid_file)):
        try:
            recorded_pids[name] = int(pid_file.read_text())
        except (OSError, ValueError):
            pass

    def stop_everything():
        for value in recorded_pids.values():
            try:
                os.kill(value, signal.SIGKILL)
            except ProcessLookupError:
                pass

    if not killed:
        stop_everything()
        raise SystemExit(f"the supervisor pid was never reported\n{text}")

    # The takeover receipt is the watchdog's only way to report: nothing is left
    # to receive an exit status.
    receipt = None
    for _ in range(200):
        matches = sorted(marker_dir.glob("*.takeover"))
        if matches:
            body = matches[0].read_text().strip()
            if body:
                receipt = body
                break
        time.sleep(0.1)
    if receipt != "0":
        stop_everything()
        raise SystemExit(
            f"the watchdog takeover did not confirm a clean close (receipt "
            f"{receipt!r}); it must close the group, stop the recorder, and "
            f"restore the terminal\n{text}")

    for name, recorded in recorded_pids.items():
        for _ in range(100):
            try:
                os.kill(recorded, 0)
            except ProcessLookupError:
                break
            time.sleep(0.1)
        else:
            stop_everything()
            raise SystemExit(
                f"a killed supervisor left Homebrew {name} {recorded} running "
                f"with no terminal and nothing watching it\n{text}")

    after_attributes = termios.tcgetattr(master)
    if after_attributes != before_attributes:
        stop_everything()
        raise SystemExit(
            "a killed supervisor left the terminal in a different mode. "
            "script(1) restores it only on its own clean exit, so the watchdog "
            "must restore it after killing the recorder -- otherwise the pane "
            f"is left unable to raise SIGINT.\nbefore={before_attributes}\n"
            f"after={after_attributes}\n{text}")


drive_supervisor_killed()
PY

echo "ok: interactive Homebrew output retains terminal ownership and bounded status"
echo "ok: Ctrl-C and the hard deadline close the nested process group, restore the terminal, and preserve caller traps"
echo "ok: outer TERM/HUP reach the Bash 3.2 supervisor and leave no watchdog, recorder, group, or private transcript"
echo "ok: the printed group-recovery command frees the supervisor and leaves no Homebrew processes"
echo "ok: a supervisor killed outright still leaves no Homebrew process group behind"
