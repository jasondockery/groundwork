  fi
  grep -qF 'signature failed strict verification' \
    "$adoption_fixture/signature-failed-after-consent"
  assert_not_contains '^brew install' "$adoption_fixture/commands.log" \
    "post-consent signature failure reached Homebrew adoption"

  rm -f "$adoption_home/.adopt-plutil-count" "$adoption_home/.adopt-ps-count"
  : >"$adoption_fixture/commands.log"
  printf 'yes\n' >"$adoption_fixture/launch-answer"
  if run_fixture_pty "$adoption_fixture/launched-after-consent" \
    "$adoption_fixture/launch-answer" env "${adoption_env[@]}" \
    ADOPT_LAUNCH_AFTER_CONSENT=1 \
    /bin/bash home/dot_local/bin/executable_groundwork-app-adopt chatgpt; then
    fail "groundwork-app-adopt missed an app launched while confirmation was open"
  fi
  grep -qF 'started after consent' "$adoption_fixture/launched-after-consent" \
    || fail "post-consent adoption running-state refusal was not actionable"
  assert_not_contains '^brew install' "$adoption_fixture/commands.log" \
    "post-consent running-state drift reached Homebrew adoption"

  rm -f "$adoption_home/.adopt-plutil-count" "$adoption_home/.adopt-ps-count"
  : >"$adoption_fixture/commands.log"
  if env "${adoption_env[@]}" ADOPT_INSTALL_STATUS=17 \
    /bin/bash home/dot_local/bin/executable_groundwork-app-adopt --yes chatgpt \
    >"$adoption_fixture/install-failed" 2>&1; then
    fail "groundwork-app-adopt hid Homebrew adoption failure"
  fi
  grep -qF 'did not force, remove, reinstall, delete, or zap' \
    "$adoption_fixture/install-failed" \
    || fail "failed adoption omitted its non-destructive disposition"
  ln -s "$adoption_fixture/missing.app" "$adoption_apps/Symlink.app"
  sed 's/ChatGPT[.]app/Symlink.app/' "$adoption_fixture/apps.tsv" \
    >"$adoption_fixture/symlink-apps.tsv"
  if env "${adoption_env[@]}" \
    GROUNDWORK_APP_ADOPTION_MAP="$adoption_fixture/symlink-apps.tsv" \
    /bin/bash home/dot_local/bin/executable_groundwork-app-adopt --yes chatgpt \
    >"$adoption_fixture/symlink" 2>&1; then
    fail "groundwork-app-adopt accepted a symlinked application bundle"
  fi

  check "explicit legacy application removal safety"
  removal_fixture="$out_dir/app-removal-fixture"
  mkdir -p "$removal_fixture"
  removal_fixture="$(cd "$removal_fixture" && pwd -P)"
  removal_home="$removal_fixture/home"
  removal_bin="$removal_home/.local/bin"
  removal_apps="$removal_fixture/Applications"
  removal_current="$removal_apps/ChatGPT.app"
  mkdir -p "$removal_bin" "$removal_current/Contents/MacOS" \
    "$removal_home/Library/Application Support/ChatGPT" \
    "$removal_home/.local/lib/groundwork" "$removal_home/.Trash"
  removal_apps="$(cd "$removal_apps" && pwd -P)"
  removal_current="$removal_apps/ChatGPT.app"
  : >"$removal_current/Contents/Info.plist"
  : >"$removal_current/Contents/MacOS/ChatGPT"
  chmod +x "$removal_current/Contents/MacOS/ChatGPT"
  : >"$removal_home/.chatgpt-receipt"
  printf 'preserve-user-data\n' \
    >"$removal_home/Library/Application Support/ChatGPT/keep.txt"
  cat >"$removal_fixture/apps.tsv" <<'EOF'
chatgpt-classic	ChatGPT Classic	chatgpt-classic	ChatGPT Classic.app	com.openai.chat	ChatGPT	2DC432GLL2	com.openai.chat	com.openai.chat-helper	chatgpt	ChatGPT.app	com.openai.codex	ChatGPT	2DC432GLL2	com.openai.codex	-
codex-app	deprecated Codex app	codex-app	Codex.app	com.openai.codex	Codex	2DC432GLL2	com.openai.codex	-	chatgpt	ChatGPT.app	com.openai.codex	ChatGPT	2DC432GLL2	com.openai.codex	-
EOF
  cat >"$removal_bin/uname" <<'SH'
#!/usr/bin/env bash
printf 'Darwin\n'
SH
  cat >"$removal_bin/plutil" <<'SH'
#!/usr/bin/env bash
key="${2:-}"
path="${4:-}"
case "$path" in
  */ChatGPT.app/*)
    case "$key" in
      CFBundleIdentifier) printf '%s\n' "${REMOVE_CURRENT_BUNDLE_ID:-com.openai.codex}" ;;
      CFBundleShortVersionString) printf '26.810.41047\n' ;;
      CFBundleVersion) printf '6570\n' ;;
      *) exit 1 ;;
    esac
    ;;
  */ChatGPT\ Classic.app/*)
    case "$key" in
      CFBundleIdentifier) printf '%s\n' "${REMOVE_CLASSIC_BUNDLE_ID:-com.openai.chat}" ;;
      CFBundleShortVersionString) printf '1.2026.160\n' ;;
      CFBundleVersion) printf '1781312926\n' ;;
      *) exit 1 ;;
    esac
    ;;
  */Codex.app/*)
    case "$key" in
      CFBundleIdentifier) printf 'com.openai.codex\n' ;;
      CFBundleShortVersionString) printf '26.623.141536\n' ;;
      CFBundleVersion) printf '623141536\n' ;;
      *) exit 1 ;;
    esac
    ;;
  *) exit 1 ;;
esac
SH
cat >"$removal_bin/profiles" <<'SH'
#!/usr/bin/env bash
[[ "${REMOVE_MDM_STATUS:-0}" == 0 ]] || exit "$REMOVE_MDM_STATUS"
if [[ "${REMOVE_MDM:-0}" == 1 ]]; then
  printf 'Enrolled via DEP: Yes\nMDM enrollment: Yes\n'
elif [[ "${REMOVE_MDM_AMBIGUOUS:-0}" == 1 ]]; then
  printf 'Enrollment state unavailable\n'
else
  printf 'Enrolled via DEP: No\nMDM enrollment: No\n'
fi
SH
  cat >"$removal_bin/codesign" <<'SH'
#!/usr/bin/env bash
app=""
for argument in "$@"; do app="$argument"; done
case "$app" in
  */ChatGPT.app | */ChatGPT\ Classic.app | */Codex.app) ;;
  *) exit 1 ;;
esac
if [[ "${1:-}" == --verify ]]; then
  count="$(cat "$HOME/.remove-codesign-verify-count" 2>/dev/null || echo 0)"
  count=$((count + 1))
  printf '%s\n' "$count" >"$HOME/.remove-codesign-verify-count"
  if [[ "${REMOVE_VERIFY_FAIL_AFTER_CONSENT:-0}" == 1 && "$count" -ge 3 ]]; then
    exit 17
  fi
  exit "${REMOVE_VERIFY_STATUS:-0}"
fi
if [[ "${1:-}" == -dv ]]; then
  printf 'TeamIdentifier=%s\n' "${REMOVE_TEAM_ID:-2DC432GLL2}" >&2
  exit 0
fi
exit 64
SH
  cat >"$removal_bin/ps" <<'SH'
#!/usr/bin/env bash
[[ "$#" -eq 2 && "$1" == -axo && "$2" == pid=,command= ]] || exit 64
ps_count="$(cat "$HOME/.remove-ps-count" 2>/dev/null || echo 0)"
ps_count=$((ps_count + 1))
printf '%s\n' "$ps_count" >"$HOME/.remove-ps-count"
[[ "${REMOVE_PS_STATUS:-0}" == 0 ]] || exit "$REMOVE_PS_STATUS"
if [[ "${REMOVE_PS_MALFORMED:-0}" == 1 ]]; then
  printf 'malformed process row\n'
  exit 0
fi
running="${REMOVE_RUNNING:-}"
if [[ "${REMOVE_LAUNCH_AFTER_CONSENT:-0}" == 1 && "$ps_count" -ge 2 ]]; then
  running=classic
fi
case "$running" in
  current) printf '4242 %s/ChatGPT.app/Contents/MacOS/ChatGPT --fixture\n' "$GROUNDWORK_APPLICATIONS_DIR" ;;
  classic) printf '4243 %s/ChatGPT Classic.app/Contents/MacOS/ChatGPT\n' "$GROUNDWORK_APPLICATIONS_DIR" ;;
  codex-caskroom) printf '4244 %s/codex-app/1.0/Codex.app/Contents/MacOS/Codex\n' "$REMOVE_CASKROOM_ROOT" ;;
esac
SH
  cat >"$removal_bin/brew" <<'SH'
#!/usr/bin/env bash
printf 'brew %s\n' "$*" >>"$REMOVE_LOG"
if [[ "${1:-}" == list && "${2:-}" == --cask ]]; then
  [[ "$#" -eq 2 ]] || exit 64
  [[ "${REMOVE_INVENTORY_STATUS:-0}" == 0 ]] || exit "$REMOVE_INVENTORY_STATUS"
  test ! -f "$HOME/.chatgpt-receipt" || printf 'chatgpt\n'
  test ! -f "$HOME/.classic-receipt" || printf 'chatgpt-classic\n'
  test ! -f "$HOME/.codex-receipt" || printf 'codex-app\n'
  exit 0
fi
if [[ "${1:-}" == info && "${2:-}" == --json=v2 && "${3:-}" == --cask ]]; then
  token="${4:-}"
  case "$token" in
    chatgpt) app=ChatGPT.app; quit=com.openai.codex; launchctl=- ;;
    chatgpt-classic) app='ChatGPT Classic.app'; quit=com.openai.chat; launchctl=com.openai.chat-helper ;;
    codex-app)
      if [[ "${REMOVE_CODEX_OWNS_CURRENT:-0}" == 1 ]]; then
        app=ChatGPT.app
      else
        app=Codex.app
      fi
      quit=com.openai.codex
      launchctl=-
      ;;
    *) exit 1 ;;
  esac
  info_count_file="$HOME/.remove-info-$token"
  info_count="$(cat "$info_count_file" 2>/dev/null || echo 0)"
  info_count=$((info_count + 1))
  printf '%s\n' "$info_count" >"$info_count_file"
  variant=stable
  if [[ "${REMOVE_METADATA_CHANGE_AFTER_CONSENT:-}" == "$token" \
    && "$info_count" -ge 2 ]]; then
    variant=changed
  fi
  if [[ "$launchctl" == - ]]; then
    uninstall="{\"quit\":\"$quit\"}"
  else
    uninstall="{\"launchctl\":\"$launchctl\",\"quit\":\"$quit\"}"
  fi
  extra_artifact=""
  if [[ "${REMOVE_EXTRA_ARTIFACT_FOR:-}" == "$token" ]]; then
    extra_artifact=',{"pkg":["Unexpected.pkg"]}'
  fi
  printf '{"formulae":[],"casks":[{"token":"%s","fixture_variant":"%s","artifacts":[{"uninstall":[%s]},{"app":["%s"]},{"zap":[{"trash":["~/Library/Application Support/fixture"]}]}%s]}]}\n' \
    "$token" "$variant" "$uninstall" "$app" "$extra_artifact"
  exit 0
fi
if [[ "${1:-}" == --caskroom && -n "${2:-}" ]]; then
  printf '%s/%s\n' "$REMOVE_CASKROOM_ROOT" "$2"
  exit 0
fi
if [[ "${1:-}" == uninstall && "${2:-}" == --cask && -n "${3:-}" && "$#" -eq 3 ]]; then
  case "$3" in
    chatgpt-classic)
      rm -rf -- "$GROUNDWORK_APPLICATIONS_DIR/ChatGPT Classic.app"
      rm -f "$HOME/.classic-receipt"
      ;;
    codex-app)
      rm -rf -- "$GROUNDWORK_APPLICATIONS_DIR/Codex.app"
      rm -f "$HOME/.codex-receipt"
      ;;
    *) exit 64 ;;
  esac
  exit 0
fi
exit 64
SH
  cat >"$removal_home/.local/lib/groundwork/update-lock.sh" <<'SH'
#!/usr/bin/env bash
groundwork_lock_acquire() {
  printf 'lock acquire %s\n' "$1" >>"$REMOVE_LOG"
  [[ "${REMOVE_LOCK_BUSY:-0}" != 1 ]] || return 75
  groundwork_lock_owned=1
}
groundwork_lock_release() {
  printf 'lock release\n' >>"$REMOVE_LOG"
  groundwork_lock_owned=0
}
SH
  chmod +x "$removal_bin"/*
  removal_env=(
    HOME="$removal_home"
    PATH="/usr/bin:/bin"
    GROUNDWORK_APP_REMOVAL_MAP="$removal_fixture/apps.tsv"
    GROUNDWORK_APPLICATIONS_DIR="$removal_apps"
    GROUNDWORK_TRASH_DIR="$removal_home/.Trash"
    REMOVE_CASKROOM_ROOT="$removal_fixture/Caskroom"
    REMOVE_LOG="$removal_fixture/commands.log"
  )
  : >"$removal_fixture/commands.log"
  env "${removal_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-app-remove --help \
    >"$removal_fixture/help"
  if env "${removal_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-app-remove \
    'chatgpt-classic;touch-owned' >"$removal_fixture/invalid" 2>&1; then
    fail "groundwork-app-remove accepted an injection-like app name"
  fi
  assert_not_contains '^brew uninstall|--zap' "$removal_fixture/commands.log" \
    "help or invalid app arguments reached removal"

  env "${removal_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-app-remove \
    chatgpt-classic >"$removal_fixture/current-only"
  grep -qF 'ChatGPT Classic is not installed' "$removal_fixture/current-only" \
    || fail "current-only ChatGPT cleanup was not idempotent"

  mv "$removal_current" "$removal_fixture/current-away"
  if env "${removal_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-app-remove \
    --yes chatgpt-classic >"$removal_fixture/classic-only" 2>&1; then
    fail "groundwork-app-remove accepted Classic without an identity- and ownership-verified current app"
  fi
  mv "$removal_fixture/current-away" "$removal_current"

  classic_app="$removal_apps/ChatGPT Classic.app"
  mkdir -p "$classic_app/Contents/MacOS"
  : >"$classic_app/Contents/Info.plist"
  : >"$classic_app/Contents/MacOS/ChatGPT"
  chmod +x "$classic_app/Contents/MacOS/ChatGPT"
  env "${removal_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-app-remove \
    --check chatgpt-classic >"$removal_fixture/check-only"
  grep -qF 'ready for a separate consent-gated removal' \
    "$removal_fixture/check-only" \
    || fail "groundwork-app-remove --check did not report its nonmutating result"
  test -d "$classic_app" \
    || fail "groundwork-app-remove --check mutated the verified Classic app"
  assert_not_contains '^brew uninstall' "$removal_fixture/commands.log" \
    "groundwork-app-remove --check reached mutation"
  if env "${removal_env[@]}" CI=1 \
    /bin/bash home/dot_local/bin/executable_groundwork-app-remove chatgpt-classic \
    </dev/null >"$removal_fixture/noninteractive" \
    2>"$removal_fixture/noninteractive-error"; then
    fail "groundwork-app-remove prompted or removed with redirected streams"
  fi
  grep -qF 'requires interactive stdin and stderr' \
    "$removal_fixture/noninteractive-error" \
    || fail "redirected removal did not explain its noninteractive refusal"
  test -d "$classic_app" \
    || fail "redirected or CI-style removal changed ChatGPT Classic"
  assert_not_contains '^brew uninstall' "$removal_fixture/commands.log" \
    "redirected or CI-style removal reached mutation"
  printf 'no\n' >"$removal_fixture/no-answer"
  run_fixture_pty "$removal_fixture/kept" "$removal_fixture/no-answer" \
    env "${removal_env[@]}" \
    /bin/bash home/dot_local/bin/executable_groundwork-app-remove chatgpt-classic
  grep -qF 'Remove ChatGPT Classic? [y/N]' "$removal_fixture/kept" \
    || fail "the Classic removal prompt was not literal and explicit"
  test -d "$classic_app" || fail "the explicit keep choice removed ChatGPT Classic"

  uninstall_count_before="$(grep -c '^brew uninstall' "$removal_fixture/commands.log" || true)"
  if env "${removal_env[@]}" REMOVE_LOCK_BUSY=1 \
    /bin/bash home/dot_local/bin/executable_groundwork-app-remove --yes chatgpt-classic \
    >"$removal_fixture/lock-busy" 2>&1; then
    fail "groundwork-app-remove ignored machine-maintenance lock contention"
  fi
  [[ "$(grep -c '^brew uninstall' "$removal_fixture/commands.log" || true)" -eq "$uninstall_count_before" ]] \
    || fail "lock contention reached application removal"
  test -d "$classic_app" || fail "lock contention changed ChatGPT Classic"

  if env "${removal_env[@]}" REMOVE_TEAM_ID=HOSTILETEAM \
    /bin/bash home/dot_local/bin/executable_groundwork-app-remove --yes chatgpt-classic \
    >"$removal_fixture/signature-mismatch" 2>&1; then
    fail "groundwork-app-remove accepted a signing-team mismatch"
  fi
  test -d "$classic_app" || fail "signing-team refusal changed ChatGPT Classic"
  rm -f "$removal_home/.remove-codesign-verify-count"
  if env "${removal_env[@]}" REMOVE_VERIFY_STATUS=17 \
    /bin/bash home/dot_local/bin/executable_groundwork-app-remove --yes chatgpt-classic \
    >"$removal_fixture/signature-verification-failed" 2>&1; then
    fail "groundwork-app-remove accepted a displayable but invalid signature"
  fi
  grep -qF 'signature failed strict verification' \
    "$removal_fixture/signature-verification-failed"
  test -d "$classic_app" || fail "failed strict signature verification changed Classic"

  for refusal in running mdm wrong-bundle; do
    refusal_status=0
    case "$refusal" in
      running) refusal_env=(REMOVE_RUNNING=classic) ;;
      mdm) refusal_env=(REMOVE_MDM=1) ;;
      wrong-bundle) refusal_env=(REMOVE_CLASSIC_BUNDLE_ID=com.example.hostile) ;;
    esac
    env "${removal_env[@]}" "${refusal_env[@]}" \
      /bin/bash home/dot_local/bin/executable_groundwork-app-remove --yes chatgpt-classic \
      >"$removal_fixture/$refusal" 2>&1 && refusal_status=1
    [[ "$refusal_status" -eq 0 ]] \
      || fail "groundwork-app-remove accepted the $refusal refusal case"
    test -d "$classic_app" || fail "$refusal refusal removed ChatGPT Classic"
  done
  for process_case in failed malformed; do
    case "$process_case" in
      failed) process_env=(REMOVE_PS_STATUS=9) ;;
      malformed) process_env=(REMOVE_PS_MALFORMED=1) ;;
    esac
    if env "${removal_env[@]}" "${process_env[@]}" \
      /bin/bash home/dot_local/bin/executable_groundwork-app-remove --yes chatgpt-classic \
      >"$removal_fixture/process-$process_case" 2>&1; then
      fail "groundwork-app-remove treated $process_case process observation as stopped"
    fi
    grep -qF 'running application state could not be observed' \
      "$removal_fixture/process-$process_case"
    test -d "$classic_app" || fail "$process_case process observation changed Classic"
  done
  for ownership_case in mdm-command-failed mdm-ambiguous inventory-failed; do
    ownership_env=()
    case "$ownership_case" in
      mdm-command-failed) ownership_env=(REMOVE_MDM_STATUS=9) ;;
      mdm-ambiguous) ownership_env=(REMOVE_MDM_AMBIGUOUS=1) ;;
      inventory-failed) ownership_env=(REMOVE_INVENTORY_STATUS=9) ;;
    esac
    if env "${removal_env[@]}" "${ownership_env[@]}" \
      /bin/bash home/dot_local/bin/executable_groundwork-app-remove --yes chatgpt-classic \
      >"$removal_fixture/$ownership_case" 2>&1; then
      fail "groundwork-app-remove treated $ownership_case as safe ownership"
    fi
    test -d "$classic_app" || fail "$ownership_case removed ChatGPT Classic"
  done

  rm -f "$removal_home/.remove-ps-count"
  printf 'yes\n' >"$removal_fixture/yes-answer"
  if run_fixture_pty "$removal_fixture/launched-after-consent" \
    "$removal_fixture/yes-answer" env "${removal_env[@]}" \
    REMOVE_LAUNCH_AFTER_CONSENT=1 \
    /bin/bash home/dot_local/bin/executable_groundwork-app-remove chatgpt-classic; then
    fail "groundwork-app-remove missed an app launched while confirmation was open"
  fi
  grep -qF 'started after consent' "$removal_fixture/launched-after-consent" \
    || fail "post-consent running-state refusal was not actionable"
  test -d "$classic_app" || fail "post-consent running-state refusal changed Classic"

  : >"$removal_home/.classic-receipt"
  if env "${removal_env[@]}" REMOVE_EXTRA_ARTIFACT_FOR=chatgpt-classic \
    /bin/bash home/dot_local/bin/executable_groundwork-app-remove --yes chatgpt-classic \
    >"$removal_fixture/extra-cask-artifact" 2>&1; then
    fail "groundwork-app-remove accepted unexpected cask artifacts or uninstall hooks"
  fi
  test -f "$removal_home/.classic-receipt" && test -d "$classic_app" \
    || fail "unexpected cask artifacts reached removal"
  rm -f "$removal_home/.remove-info-chatgpt" \
    "$removal_home/.remove-info-chatgpt-classic"
  if env "${removal_env[@]}" REMOVE_METADATA_CHANGE_AFTER_CONSENT=chatgpt-classic \
    /bin/bash home/dot_local/bin/executable_groundwork-app-remove --yes chatgpt-classic \
    >"$removal_fixture/metadata-changed-after-consent" 2>&1; then
    fail "groundwork-app-remove acted after cask metadata changed"
  fi
  grep -qF 'metadata changed after consent' \
    "$removal_fixture/metadata-changed-after-consent" \
    || fail "post-consent cask metadata drift was not named"
  test -f "$removal_home/.classic-receipt" && test -d "$classic_app" \
    || fail "post-consent metadata drift reached removal"
  rm -f "$removal_home/.remove-codesign-verify-count"
  if env "${removal_env[@]}" REMOVE_VERIFY_FAIL_AFTER_CONSENT=1 \
    /bin/bash home/dot_local/bin/executable_groundwork-app-remove --yes chatgpt-classic \
    >"$removal_fixture/signature-failed-after-consent" 2>&1; then
    fail "groundwork-app-remove did not repeat strict signature verification after consent"
  fi
  grep -qF 'signature failed strict verification' \
    "$removal_fixture/signature-failed-after-consent"
  test -f "$removal_home/.classic-receipt" && test -d "$classic_app" \
    || fail "post-consent signature failure reached removal"
  rm -f "$removal_home/.classic-receipt"

  : >"$removal_home/.codex-receipt"
  if env "${removal_env[@]}" REMOVE_CODEX_OWNS_CURRENT=1 \
    /bin/bash home/dot_local/bin/executable_groundwork-app-remove --yes codex-app \
    >"$removal_fixture/codex-owns-current" 2>&1; then
    fail "groundwork-app-remove uninstalled codex-app when its cask metadata owned ChatGPT.app"
  fi
  test -f "$removal_home/.codex-receipt" \
    || fail "ambiguous codex-app ownership removed its receipt"

  env "${removal_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-app-remove \
    --yes codex-app >"$removal_fixture/stale-codex"
  grep -qxF 'brew uninstall --cask codex-app' "$removal_fixture/commands.log" \
    || fail "a demonstrably stale codex-app receipt did not use exact cask removal"
  test ! -f "$removal_home/.codex-receipt" \
    || fail "the stale codex-app receipt remained after accepted cleanup"
  test -d "$removal_current" && test -f "$removal_home/.chatgpt-receipt" \
    || fail "stale codex-app cleanup disturbed the current ChatGPT app"

  : >"$removal_fixture/commands.log"
  mkdir -p "$removal_home/.Trash/ChatGPT Classic.app"
  printf 'existing-trash-item\n' \
    >"$removal_home/.Trash/ChatGPT Classic.app/keep.txt"
  env "${removal_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-app-remove \
    --yes chatgpt-classic >"$removal_fixture/manual-classic-removed"
  test ! -e "$classic_app" || fail "accepted manual Classic cleanup left the app bundle"
  grep -qxF 'existing-trash-item' \
    "$removal_home/.Trash/ChatGPT Classic.app/keep.txt" \
    || fail "a Trash name collision overwrote an existing item"
  [[ "$(find "$removal_home/.Trash" -maxdepth 1 -type d \
    -name 'ChatGPT Classic (Groundwork *).app' | wc -l | tr -d ' ')" -eq 1 ]] \
    || fail "manual Classic cleanup did not choose one recoverable collision-safe Trash name"
  grep -qxF 'preserve-user-data' \
    "$removal_home/Library/Application Support/ChatGPT/keep.txt" \
    || fail "manual Classic cleanup changed ChatGPT user data"
  assert_not_contains '--zap|Application Support|Preferences|credentials|chats|rm -rf' \
    "$removal_fixture/commands.log" \
    "manual Classic cleanup delegated user-data deletion to Homebrew"
  env "${removal_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-app-remove \
    --yes chatgpt-classic >"$removal_fixture/manual-second-run"
  grep -qF 'No change was made' "$removal_fixture/manual-second-run" \
    || fail "a second Classic cleanup was not idempotent"

  mkdir -p "$classic_app/Contents/MacOS"
  : >"$classic_app/Contents/Info.plist"
  : >"$classic_app/Contents/MacOS/ChatGPT"
  chmod +x "$classic_app/Contents/MacOS/ChatGPT"
  : >"$removal_home/.classic-receipt"
  : >"$removal_fixture/commands.log"
  env "${removal_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-app-remove \
    --yes chatgpt-classic >"$removal_fixture/homebrew-classic-removed"
  grep -qxF 'brew uninstall --cask chatgpt-classic' "$removal_fixture/commands.log" \
    || fail "Homebrew-owned Classic cleanup did not remove the exact mapped cask"
  assert_not_contains '--zap|--force' \
    "$removal_fixture/commands.log" \
    "Classic cleanup used a destructive Homebrew flag"
  assert_not_contains '^brew uninstall --cask chatgpt$' \
    "$removal_fixture/commands.log" \
    "Classic cleanup widened into current ChatGPT removal"
  test -d "$removal_current" && test -x "$removal_current/Contents/MacOS/ChatGPT" \
    || fail "Classic cleanup did not preserve a launchable current ChatGPT app"

  check "update-all launcher handoff and runner transaction"
  update_all_fixture="$out_dir/update-all-fixture"
  update_all_home="$update_all_fixture/home"
  update_all_bin="$update_all_home/.local/bin"
  mkdir -p "$update_all_bin" "$update_all_home/.local/lib/groundwork" \
    "$update_all_home/.local/share/groundwork/lib" \
    "$update_all_home/.local/state/groundwork" \
    "$update_all_home/.config/groundwork" "$update_all_home/.config/homebrew" \
    "$update_all_home/code" "$update_all_fixture/Applications"
  local GROUNDWORK_APPLICATIONS_DIR
  GROUNDWORK_APPLICATIONS_DIR="$(cd "$update_all_fixture/Applications" && pwd -P)"
  export GROUNDWORK_APPLICATIONS_DIR
  cat >"$update_all_home/.config/homebrew/Brewfile" <<'EOF'
brew "git"
cask "ghostty"
mas "Anybox", id: 1593408455
EOF
  update_all_saved_xdg_config="${XDG_CONFIG_HOME-}"
  update_all_saved_xdg_cache="${XDG_CACHE_HOME-}"
  update_all_had_xdg_config="${XDG_CONFIG_HOME+x}"
  update_all_had_xdg_cache="${XDG_CACHE_HOME+x}"
  export XDG_CONFIG_HOME="$update_all_home/.config"
  export XDG_CACHE_HOME="$update_all_home/.cache"
  cp home/dot_local/bin/executable_groundwork-repos \
    "$update_all_bin/groundwork-repos"
  cat >"$update_all_home/.config/groundwork/repos.conf" <<EOF
root = $update_all_home/code
max_depth = 2
include_worktrees = true
cache_ttl_seconds = 0
EOF
  # The current launcher under test is deliberately an already-open copy outside
  # $HOME/.local/bin, proving a stale process still hands off to whatever the sync
  # just installed. The exact v1.9 launcher separately proves the migration from
  # the latest release that did not yet install the shared lock helper.
  cp home/dot_local/bin/executable_update-all "$update_all_fixture/old-launcher"
  git cat-file -e v1.9.0:home/dot_local/bin/executable_update-all 2>/dev/null \
    || fail "update-all migration proof requires the v1.9.0 tag and file history"
  git show v1.9.0:home/dot_local/bin/executable_update-all \
    >"$update_all_fixture/v1.9-launcher"
  render linux false amd64 home/dot_local/bin/executable_groundwork-update-run.tmpl \
    "$update_all_fixture/rendered-runner"
  chmod +x "$update_all_fixture/old-launcher" \
    "$update_all_fixture/v1.9-launcher" "$update_all_fixture/rendered-runner"

  # The stub mirrors the real contract: ONLY a successful `apply` installs the
  # runner — an update or status call installing it would let the fixture pass
  # while the real flow ran a stale runner.
  cat >"$update_all_bin/chezmoi" <<'SH'
#!/usr/bin/env bash
printf 'chezmoi %s color=%s\n' "$*" "${GROUNDWORK_COLOR:-unset}" >>"$GROUNDWORK_TEST_LOG"
if [[ "${CHEZMOI_CONFIG_WARNING:-0}" == 1 && "${1:-}" != init \
  && ! -f "$HOME/.chezmoi-config-initialized" ]]; then
  echo 'chezmoi: warning: configuration template changed; run chezmoi init' >&2
fi
if [[ -n "${GROUNDWORK_BREWFILE_SKIP_CASKS:-}" ]]; then
  printf 'chezmoi skip-casks=%s\n' "$GROUNDWORK_BREWFILE_SKIP_CASKS" >>"$GROUNDWORK_TEST_LOG"
fi
[[ "${CHEZMOI_STATUS:-0}" == "0" ]] || exit "$CHEZMOI_STATUS"
case "${1:-}" in
  init)
    : >"$HOME/.chezmoi-config-initialized"
    ;;
  status)
    [[ "${CHEZMOI_STATUS_FAIL:-0}" == "0" ]] || exit 1
    [[ -z "${CHEZMOI_DRIFT:-}" ]] || printf '%s\n' "$CHEZMOI_DRIFT"
    ;;
  verify)
    exit "${CHEZMOI_VERIFY_STATUS:-0}"
    ;;
  apply)
    [[ "${CHEZMOI_APPLY_FAIL:-0}" == "0" ]] || exit 1
    if [[ "${CHEZMOI_INSTALL_RUNNER:-0}" == "1" ]]; then
      cp "$FRESH_RUNNER" "$HOME/.local/bin/groundwork-update-run"
      chmod +x "$HOME/.local/bin/groundwork-update-run"
    fi
    for target in "$@"; do
      if [[ "$target" == "$HOME/.local/lib/groundwork/update-lock.sh" &&
        -n "${FRESH_LOCK_HELPER:-}" ]]; then
        mkdir -p "$HOME/.local/lib/groundwork"
        cp "$FRESH_LOCK_HELPER" "$target"
      fi
    done
    ;;
esac
SH
  cat >"$update_all_fixture/fresh-runner" <<'SH'
#!/usr/bin/env bash
printf 'fresh runner color=%s\n' "${GROUNDWORK_COLOR:-unset}" >>"$GROUNDWORK_TEST_LOG"
for arg in "$@"; do
  printf 'arg=%s\n' "$arg" >>"$GROUNDWORK_TEST_LOG"
done
exit "${FRESH_RUNNER_STATUS:-0}"
SH
  cat >"$update_all_home/.local/bin/groundwork-brew-update" <<'SH'
#!/usr/bin/env bash
printf 'brew-update\n' >>"$GROUNDWORK_TEST_LOG"
rm -f -- "$HOME/.brew-updated-tokens"
exit "${BREW_UPDATE_STATUS:-0}"
SH
  # Default to "nothing actionable" (1); tests override to prove each outcome
  # of the repair/refetch contract actually drives the runner's behavior.
  cat >"$update_all_home/.local/bin/groundwork-brew-repair" <<'SH'
#!/usr/bin/env bash
printf 'brew-repair\n' >>"$GROUNDWORK_TEST_LOG"
exit "${REPAIR_STATUS:-1}"
