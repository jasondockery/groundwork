    || fail "workflow receipt policy is not structurally consistent"
  # Cancellation policy. A superseded PR push is worth cancelling; a landed main
  # commit is not. Unconditional cancel-in-progress lets two quick pushes to main
  # leave the FIRST commit with no receipt at all, and both the release gate and
  # the reusable-proof contract depend on an exact-SHA receipt existing for the
  # commit that landed. Any workflow triggered by a push to main must gate it.
  for workflow_file in .github/workflows/*.yml; do
    awk -v file="$workflow_file" '
      /^on:/ { in_on = 1; next }
      in_on && /^[^ \t#]/ { in_on = 0 }
      in_on && /^[ \t]+push:/ { push_trigger = 1 }
      /^[ \t]*cancel-in-progress:[ \t]*true[ \t]*$/ { unconditional = 1 }
      END {
        if (push_trigger && unconditional) {
          printf "%s: cancel-in-progress must be conditional when the workflow runs on push (a landed commit needs its own receipt)\n", file
          exit 1
        }
      }
    ' "$workflow_file" || fail "workflow cancellation policy violated in $workflow_file"
  done
  unset workflow_file
