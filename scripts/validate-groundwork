  assert_not_contains '^brew install' "$adoption_fixture/commands.log" \
    "a signing-team mismatch reached Homebrew adoption"
  rm -f "$adoption_home/.adopt-codesign-verify-count"
  if env "${adoption_env[@]}" ADOPT_VERIFY_STATUS=17 \
