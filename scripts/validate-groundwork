  chmod +x "$update_all_home/.local/bin/groundwork-brew-repair" \
    "$update_all_home/.local/bin/groundwork-brew-refetch"
  cat >"$update_all_bin/brew" <<'SH'
#!/usr/bin/env bash
case "${1:-}" in
  --cache)
    # A size query, not a stage: it stays out of the command log so the
    # ordering fixtures keep asserting stages only.
    [[ "${BREW_CACHE_FAIL:-0}" == "0" ]] || exit 1
    printf '%s\n' "${BREW_CACHE_DIR:-$HOME/absent-brew-cache}"
    exit 0
    ;;
  list)
    shift
    case "${1:-}" in
      --formula)
        [[ "${2:-}" == "--full-name" && "$#" -eq 2 ]] || exit 64
        installed_formulae="${BREW_FORMULAE-git}"
        [[ -z "$installed_formulae" ]] || printf '%s\n' $installed_formulae
        ;;
      --pinned)
        # Real Homebrew accepts `brew list --pinned`, but rejects the tempting
        # `--pinned --full-name` combination. Production gets pin state from
        # full-name formula metadata instead.
        [[ "$#" -eq 1 ]] || exit 64
        [[ -z "${BREW_PINNED:-}" ]] || printf '%s\n' $BREW_PINNED
        ;;
      --cask)
        shift
        if [[ "$#" -eq 0 ]]; then
          [[ "${BREW_CASK_INVENTORY_STATUS:-0}" == 0 ]] \
            || exit "$BREW_CASK_INVENTORY_STATUS"
          installed_casks="${BREW_CASKS-ghostty}"
          [[ -z "$installed_casks" ]] || printf '%s\n' $installed_casks
          [[ ! -f "$HOME/.chatgpt-adopted" ]] || printf 'chatgpt\n'
        else
          for wanted in "$@"; do
            found=0
            for installed in ${BREW_CASKS-ghostty}; do
              [[ "$installed" == "$wanted" ]] && found=1
            done
            [[ "$wanted" == chatgpt && -f "$HOME/.chatgpt-adopted" ]] && found=1
            [[ "$found" -eq 1 ]] || exit 1
          done
        fi
        ;;
      *) exit 64 ;;
    esac
    exit 0
    ;;
  info)
    [[ "${2:-}" == "--json=v2" ]] || exit 64
    info_kind="${3:-}"
    [[ "$info_kind" == "--formula" || "$info_kind" == "--cask" ]] || exit 64
    if [[ "$info_kind" == "--formula" ]]; then
      [[ "${BREW_FORMULA_INFO_STATUS:-${BREW_INFO_STATUS:-0}}" == "0" ]] \
        || exit "${BREW_FORMULA_INFO_STATUS:-${BREW_INFO_STATUS:-0}}"
    else
      [[ "${BREW_CASK_INFO_STATUS:-${BREW_INFO_STATUS:-0}}" == "0" ]] \
        || exit "${BREW_CASK_INFO_STATUS:-${BREW_INFO_STATUS:-0}}"
    fi
    shift 3
    if [[ "$info_kind" == "--formula" ]]; then
      printf '{"formulae":['
      separator=''
      for token in "$@"; do
        printf '%s' "$separator"
        separator=,
        formula_pinned=false
        formula_outdated=false
        for pinned in ${BREW_PINNED:-}; do
          [[ "$pinned" == "$token" ]] && formula_pinned=true
        done
        for outdated in ${BREW_FORMULA_OUTDATED-$token}; do
          [[ "$outdated" == "$token" ]] && formula_outdated=true
        done
        printf '{"full_name":"%s","installed":[{"version":"1.0.0"}],"versions":{"stable":"1.1.0"},"pinned":%s,"outdated":%s,"deprecated":false,"disabled":false}' \
          "$token" "$formula_pinned" "$formula_outdated"
      done
      printf '],"casks":[]}\n'
      exit 0
    fi
    printf '{"formulae":[],"casks":['
    separator=''
    for token in "$@"; do
      printf '%s' "$separator"
      separator=,
      case "$token" in
        docker-desktop)
          printf '%s' '{"token":"docker-desktop","installed":"4.85.0,235549","version":"4.86.0,236216","sha256":"fixture-sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[{"uninstall":[{"launchctl":["com.docker.helper"],"delete":["/Library/PrivilegedHelperTools/com.docker.vmnetd"]}]}]}'
          ;;
        chatgpt)
          printf '%s' '{"token":"chatgpt","installed":"1.0.0","version":"1.1.0","sha256":"fixture-sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[{"app":["ChatGPT.app"]},{"uninstall":[{"quit":["com.openai.codex"]}]}]}'
          ;;
        cursor | claude | obsidian)
          case "$token" in
            cursor) app_name='Cursor.app' ;;
            claude) app_name='Claude.app' ;;
            *) app_name='Obsidian.app' ;;
          esac
          printf '{"token":"%s","installed":"1.0.0","version":"1.1.0","sha256":"fixture-sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[{"app":["%s"]}]}' "$token" "$app_name"
          ;;
        self-current)
          printf '%s' '{"token":"self-current","installed":"1.1.0","version":"1.1.0","sha256":"fixture-sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[{"app":["Self Current.app"]}]}'
          ;;
        google-chrome | google-chrome@beta)
          case "$token" in
            google-chrome) app_name='Google Chrome.app' ;;
            *) app_name='Google Chrome Beta.app' ;;
          esac
          printf '{"token":"%s","installed":"1.0.0","version":"1.1.0","sha256":"no_check","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[{"app":["%s"]}]}' "$token" "$app_name"
          ;;
        unknown-vendor)
          printf '%s' '{"token":"unknown-vendor","installed":"1.0.0","version":"1.1.0","sha256":"no_check","auto_updates":true,"pinned":false,"outdated":true,"deprecated":false,"disabled":false,"artifacts":[{"app":["Unknown Vendor.app"]}]}'
          ;;
        disabled-cask)
          printf '%s' '{"token":"disabled-cask","installed":"1.0.0","version":"1.1.0","sha256":"fixture-sha","auto_updates":false,"pinned":false,"outdated":true,"deprecated":false,"disabled":true,"artifacts":[{"app":["Disabled.app"]}]}'
          ;;
        latest-cask)
          printf '%s' '{"token":"latest-cask","installed":"0","version":"latest","sha256":"fixture-sha","auto_updates":false,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[]}'
          ;;
        codex-app)
          printf '%s' '{"token":"codex-app","installed":"1.0.0","version":"1.0.0","sha256":"fixture-sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":true,"disabled":false,"artifacts":[{"app":["Codex.app"]}]}'
          ;;
        appcleaner | karabiner-elements | zoom)
          printf '{"token":"%s","installed":"1.1.0","version":"1.1.0","sha256":"fixture-sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[{"uninstall":[{"launchctl":["fixture.helper"],"delete":["/Library/PrivilegedHelperTools/fixture"]}]}]}' "$token"
          ;;
        privileged-outdated)
          printf '%s' '{"token":"privileged-outdated","installed":"1.0.0","version":"1.1.0","sha256":"fixture-sha","auto_updates":false,"pinned":false,"outdated":true,"deprecated":false,"disabled":false,"artifacts":[{"uninstall":[{"launchctl":["fixture.helper"]}]}]}'
          ;;
        *)
          printf '{"token":"%s","installed":"1.0.0","version":"1.1.0","sha256":"fixture-sha","auto_updates":false,"pinned":false,"outdated":true,"deprecated":false,"disabled":false,"artifacts":[]}' "$token"
          ;;
      esac
    done
    printf ']}\n'
    exit 0
    ;;
  outdated)
    shift
    mode=ordinary-cask
    candidates=()
    for arg in "$@"; do
      case "$arg" in
        --quiet | --cask) ;;
        --formula) mode=formula ;;
        --greedy-auto-updates) mode=auto ;;
        --greedy-latest) mode=latest ;;
        *) candidates+=("$arg") ;;
      esac
    done
    [[ "${BREW_OUTDATED_STATUS:-0}" == 0 ]] || exit "$BREW_OUTDATED_STATUS"
    for token in "${candidates[@]}"; do
      remain_outdated=0
      [[ "${BREW_REMAIN_OUTDATED:-0}" == 1 ]] && remain_outdated=1
      for retained in ${BREW_REMAIN_OUTDATED_TOKENS:-}; do
        [[ "$retained" == "$token" ]] && remain_outdated=1
      done
      if [[ "$remain_outdated" -eq 0 ]] \
        && grep -qxF "$token" "$HOME/.brew-updated-tokens" 2>/dev/null; then
        continue
      fi
      case "$mode" in
        formula) wanted="${BREW_FORMULA_OUTDATED-$token}" ;;
        auto) wanted="${BREW_AUTO_OUTDATED:-}" ;;
        latest) wanted="${BREW_LATEST_OUTDATED:-}" ;;
        *) wanted="${BREW_CASK_OUTDATED:-}" ;;
      esac
      for outdated in $wanted; do
        [[ "$outdated" == "$token" ]] && printf '%s\n' "$token"
      done
    done
    exit 0
    ;;
  upgrade)
    saw_cask=0
    saw_no_quit=0
    for arg in "$@"; do
      [[ "$arg" == "--cask" ]] && saw_cask=1
      [[ "$arg" == "--no-quit" ]] && saw_no_quit=1
    done
    printf 'brew %s auto=%s casks=%s hb-color=%s\n' "$*" \
      "${HOMEBREW_NO_AUTO_UPDATE:-unset}" \
      "${HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS:-unset}" \
      "${HOMEBREW_COLOR:-unset}" >>"$GROUNDWORK_TEST_LOG"
    if [[ "${BREW_LAUNCH_AFTER_SNAPSHOT:-0}" == 1 \
      && "$saw_cask" -eq 1 && "$saw_no_quit" -ne 1 ]]; then
      echo 'Error: fixture application launched after the process snapshot and Homebrew was allowed to quit it.' >&2
      exit 73
    fi
    for token in "$@"; do
      case "$token" in --*) continue ;; esac
      printf '%s\n' "$token" >>"$HOME/.brew-updated-tokens"
    done
    [[ "${BREW_NOTHING_TO_UPGRADE:-0}" == "0" ]] || echo "Already up-to-date."
    if [[ "${BREW_CLASSIFICATION_FIXTURE:-0}" == 1 ]]; then
      echo 'Warning: git 2.51.0 already installed'
      echo 'Warning: Not upgrading ghostty, the latest version is already installed'
      echo 'Warning: unfamiliar Homebrew condition remains actionable'
    fi
    if [[ "${BREW_CASKROOM_COLLISION:-0}" == 1 ]]; then
      echo "'com.bitwarden.desktop'..."
      echo "Application 'com.bitwarden.desktop' quit successfully."
      echo "Error: bitwarden: It seems there is already an App at '/opt/homebrew/Caskroom/bitwarden/2026.6.0/Bitwarden.app'." >&2
      echo '==> Purging files for version 2026.7.0 of Cask bitwarden'
    fi
    # Lets a case model a cancelled or deadline-killed upgrade, which the
    # bounded runner surfaces as 124/125/129/130/143. A sequence gives each
    # successive call its own status, so the RETRY path can be cancelled while
    # the first attempt merely fails. Falls back to the shared stage status so
    # cases that only set BREW_STAGE_STATUS behave as before.
    if [[ -n "${BREW_UPGRADE_STATUS_SEQUENCE:-}" ]]; then
      brew_upgrade_count_file="${BREW_UPGRADE_COUNT_FILE:-$HOME/.brew-upgrade-count}"
      brew_upgrade_call="$(cat "$brew_upgrade_count_file" 2>/dev/null || echo 0)"
      brew_upgrade_call=$((brew_upgrade_call + 1))
      printf '%s' "$brew_upgrade_call" >"$brew_upgrade_count_file"
      brew_upgrade_status="$(printf '%s' "$BREW_UPGRADE_STATUS_SEQUENCE" \
        | awk -v n="$brew_upgrade_call" '{ print ($n == "" ? 0 : $n) }')"
      exit "${brew_upgrade_status:-0}"
    fi
    exit "${BREW_UPGRADE_STATUS:-${BREW_STAGE_STATUS:-0}}"
    ;;
  shellenv)
    # Records that the hook took its environment from THIS Homebrew. A fixture
    # whose log lacks this line drove the machine's real Homebrew instead.
    printf 'brew-shellenv\n' >>"$GROUNDWORK_TEST_LOG"
    printf 'export PATH=%s:${PATH}\n' "$(cd "$(dirname "$0")" && pwd)"
    exit 0
    ;;
  bundle)
    printf 'brew-bundle\n' >>"$GROUNDWORK_TEST_LOG"
    if [[ -n "${BREW_BUNDLE_CAPTURE_FILE:-}" ]]; then
      for bundle_arg in "$@"; do
        case "$bundle_arg" in
          --file=*) cp "${bundle_arg#--file=}" "$BREW_BUNDLE_CAPTURE_FILE" ;;
        esac
      done
    fi
    # A sequence gives each successive call its own status so the RETRY path can
    # be cancelled while the first attempt merely fails.
    if [[ -n "${BREW_BUNDLE_STATUS_SEQUENCE:-}" ]]; then
      brew_bundle_count_file="${BREW_BUNDLE_COUNT_FILE:-$HOME/.brew-bundle-count}"
      brew_bundle_call="$(cat "$brew_bundle_count_file" 2>/dev/null || echo 0)"
      brew_bundle_call=$((brew_bundle_call + 1))
      printf '%s' "$brew_bundle_call" >"$brew_bundle_count_file"
      brew_bundle_status="$(printf '%s' "$BREW_BUNDLE_STATUS_SEQUENCE" \
        | awk -v n="$brew_bundle_call" '{ print ($n == "" ? 0 : $n) }')"
      exit "${brew_bundle_status:-0}"
    fi
    exit "${BREW_BUNDLE_STATUS:-0}"
    ;;
  autoremove)
    if [[ "${ASSERT_UPDATE_LOCK_DURING_MAINTENANCE:-0}" == "1" ]]; then
      test -s "$HOME/.local/state/groundwork/update-all.lock/pid"
      test -s "$HOME/.local/state/groundwork/update-all.lock/token"
      printf 'lock observed during brew autoremove\n' >>"$GROUNDWORK_TEST_LOG"
    fi
    printf 'brew %s\n' "$*" >>"$GROUNDWORK_TEST_LOG"
    exit "${BREW_AUTOREMOVE_STATUS:-0}"
    ;;
  cleanup)
    if [[ "${ASSERT_UPDATE_LOCK_DURING_MAINTENANCE:-0}" == "1" ]]; then
      test -s "$HOME/.local/state/groundwork/update-all.lock/pid"
      test -s "$HOME/.local/state/groundwork/update-all.lock/token"
      printf 'lock observed during brew cleanup\n' >>"$GROUNDWORK_TEST_LOG"
    fi
    printf 'brew %s\n' "$*" >>"$GROUNDWORK_TEST_LOG"
    # A cleanup that removes some files and then fails on one it cannot read:
    # the shape the "left as it was" wording would have described wrongly.
    if [[ "${BREW_CLEANUP_PARTIAL:-0}" != "0" ]]; then
      find "${BREW_CACHE_DIR}/downloads" -mindepth 1 -delete
      echo "Error: Permission denied @ rb_sysopen - locked download" >&2
      exit 1
    fi
    if [[ "${BREW_CLEANUP_STATUS:-0}" != "0" ]]; then
      echo "Error: Permission denied @ rb_sysopen - cached download" >&2
      exit "${BREW_CLEANUP_STATUS}"
    fi
    # Another process writing into the cache while cleanup runs: the two size
    # observations are not one atomic measurement.
    if [[ "${BREW_CLEANUP_GROWS:-0}" != "0" ]]; then
      dd if=/dev/urandom of="${BREW_CACHE_DIR}/downloads/arrived-during-cleanup" \
        bs=1024 count=2048 >/dev/null 2>&1
      exit 0
    fi
    # Models one successful cleanup whose measured cache shrinks — not a claim
    # about what any future Homebrew leaves behind.
    if [[ -n "${BREW_CACHE_DIR:-}" && -d "${BREW_CACHE_DIR}" ]]; then
      find "${BREW_CACHE_DIR}" -mindepth 1 -delete
    fi
    ;;
  *)
    printf 'brew %s\n' "$*" >>"$GROUNDWORK_TEST_LOG"
    ;;
esac
exit "${BREW_STAGE_STATUS:-0}"
SH
  cat >"$update_all_bin/ps" <<'SH'
#!/usr/bin/env bash
if [[ "$#" -eq 2 && "${1:-}" == -axo && "${2:-}" == command= ]]; then
  if [[ -n "${BREW_PS_TRACE_FILE:-}" ]]; then
    printf 'args=%s %s\nrunning=%s\n' "$1" "$2" "${BREW_RUNNING_COMMANDS:-}" \
      >"$BREW_PS_TRACE_FILE"
  fi
  [[ -z "${BREW_RUNNING_COMMANDS:-}" ]] || printf '%s\n' "$BREW_RUNNING_COMMANDS"
  exit "${BREW_PS_STATUS:-0}"
fi
exec /bin/ps "$@"
SH
cat >"$update_all_bin/mas" <<'SH'
#!/usr/bin/env bash
case "${1:-}" in
  version)
    [[ "$#" -eq 1 ]] || exit 64
    printf '%s\n' "${MAS_VERSION:-7.0.0}"
    ;;
  list)
    [[ "$#" -eq 2 && "${2:-}" == --json ]] || exit 64
    mas_installed_output="${MAS_INSTALLED:-}"
    shopt -s nullglob
    mas_markers=("$HOME"/.mas-updated-*)
    shopt -u nullglob
    if ((${#mas_markers[@]} > 0)) && [[ -n "${MAS_POST_INSTALLED+x}" ]]; then
      mas_installed_output="${MAS_POST_INSTALLED:-}"
    fi
    [[ -z "$mas_installed_output" ]] || printf '%s\n' "$mas_installed_output"
    exit "${MAS_LIST_STATUS:-0}"
    ;;
  outdated)
    [[ "$#" -eq 3 && "${2:-}" == --json && "${3:-}" == --accurate ]] || exit 64
    if [[ -n "${MAS_OUTDATED:-}" ]]; then
      while IFS= read -r mas_line; do
        [[ -n "$mas_line" ]] || continue
        mas_id="$(printf '%s\n' "$mas_line" \
          | sed -n 's/.*"trackId"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')"
        [[ "$mas_id" =~ ^[0-9]+$ ]] || exit 65
        [[ -f "$HOME/.mas-updated-$mas_id" ]] || printf '%s\n' "$mas_line"
      done <<<"$MAS_OUTDATED"
    fi
    exit "${MAS_OUTDATED_STATUS:-0}"
    ;;
  update)
    shift
    [[ "$#" -eq 1 && "$1" =~ ^[0-9]+$ ]] || exit 64
    app_id="$1"
    {
      printf 'mas update'
      for app_id in "$@"; do printf ' %s' "$app_id"; done
      printf '\n'
    } >>"$GROUNDWORK_TEST_LOG"
    if [[ "${MAS_HANG_ID:-}" == "$app_id" ]]; then
      sleep 60 &
      child=$!
      printf '%s\n' "$child" >"$HOME/.mas-owned-child-$app_id"
      wait "$child"
    fi
    app_status="${MAS_UPDATE_STATUS:-0}"
    [[ "${MAS_FAIL_ID:-}" == "$app_id" ]] && app_status="${MAS_FAIL_STATUS:-17}"
    [[ "$app_status" == 0 ]] && : >"$HOME/.mas-updated-$app_id"
    exit "$app_status"
    ;;
  *) exit 64 ;;
esac
SH
  chmod +x "$update_all_bin/mas"
  cat >"$update_all_bin/sudo" <<'SH'
#!/usr/bin/env bash
case "${1:-}" in
  -v)
    [[ "$#" -eq 1 ]] || exit 64
    printf 'sudo -v\n' >>"$GROUNDWORK_TEST_LOG"
    auth_count_file="$HOME/.mas-auth-count"
    auth_count="$(cat "$auth_count_file" 2>/dev/null || echo 0)"
    auth_count=$((auth_count + 1))
    printf '%s\n' "$auth_count" >"$auth_count_file"
    if [[ "${SUDO_AUTH_CHILD:-0}" == 1 ]]; then
      sleep 60 &
      auth_child=$!
      printf '%s\n' "$auth_child" >"$HOME/.mas-auth-owned-child"
    fi
    [[ "${SUDO_AUTH_PROMPT:-0}" != 1 ]] || printf 'Password:' >&2
    if [[ "${SUDO_AUTH_READ:-0}" == 1 ]]; then
      IFS= read -r password || exit 19
      [[ "$password" == fixture-password ]] || exit 20
      printf 'sudo auth pgid=%s tpgid=%s\n' \
        "$(ps -o pgid= -p $$ | tr -d ' ')" \
        "$(ps -o tpgid= -p $$ | tr -d ' ')" >>"$GROUNDWORK_TEST_LOG"
    fi
    if [[ "${SUDO_AUTH_HANG:-0}" == 1 \
      || ("${SUDO_AUTH_HANG_ONCE:-0}" == 1 && "$auth_count" -eq 1) ]]; then
      if [[ -z "${auth_child:-}" ]]; then
        sleep 60 &
        auth_child=$!
        printf '%s\n' "$auth_child" >"$HOME/.mas-auth-owned-child"
      fi
      wait "$auth_child"
    fi
    exit "${SUDO_AUTH_STATUS:-0}"
    ;;
  -n)
    shift
    {
      printf 'sudo -n'
      printf ' %s' "$@"
      printf '\n'
    } >>"$GROUNDWORK_TEST_LOG"
    exec "$@"
    ;;
  *) exit 64 ;;
esac
SH
  chmod +x "$update_all_bin/sudo"
  cat >"$update_all_bin/cp" <<'SH'
#!/usr/bin/env bash
if [[ "${FAIL_ACTION_RECEIPT_CP:-0}" == 1 && "${1:-}" == */actions.tsv ]]; then
  exit 19
fi
exec /bin/cp "$@"
SH
  chmod +x "$update_all_bin/cp"
  cat >"$update_all_bin/plutil" <<'SH'
#!/usr/bin/env bash
case "${2:-}" in
  CFBundleIdentifier) printf '%s\n' "${CHATGPT_BUNDLE_ID:-com.openai.codex}" ;;
  CFBundleShortVersionString) printf '%s\n' "${CHATGPT_SHORT_VERSION:-26.803.81509}" ;;
  CFBundleVersion) printf '%s\n' "${CHATGPT_BUILD_VERSION:-81509}" ;;
  CFBundleExecutable) printf 'ChatGPT\n' ;;
  *) exit 1 ;;
esac
SH
  cat >"$update_all_bin/file" <<'SH'
#!/usr/bin/env bash
printf '%s: Mach-O 64-bit executable arm64\n' "${1:-unknown}"
SH
  chmod +x "$update_all_bin/plutil" "$update_all_bin/file"
  cat >"$update_all_bin/groundwork-platform" <<'SH'
#!/usr/bin/env bash
echo "${FAKE_PLATFORM:-linux}"
SH
  cat >"$update_all_bin/mise" <<'SH'
#!/usr/bin/env bash
if [[ "${1:-}" == "upgrade" && "${2:-}" == "--help" ]]; then
  [[ "${MISE_HAS_RELEASE_AGE:-1}" == "1" ]] && echo "      --minimum-release-age <MINIMUM_RELEASE_AGE>"
  exit 0
fi
if [[ "${1:-}" == "which" ]]; then
  # A query, not a stage: unlogged, like brew --cache. Defaults to "no npm"
  # so the fixtures that predate the npm stage keep their exact logs.
  exit "${MISE_WHICH_NPM_STATUS:-1}"
fi
if [[ "${1:-}" == "exec" ]]; then
  if [[ "${2:-}" == "--" && "${3:-}" == "npm" && "${4:-}" == "config" && "${5:-}" == "get" && "${6:-}" == "cache" ]]; then
    printf '%s\n' "${NPM_CACHE_DIR:-$HOME/.npm}"
    exit 0
  fi
  # pwd is part of the contract: machine maintenance must run from $HOME, not
  # from whatever repository update-all was launched in.
  printf 'mise %s pwd=%s\n' "$*" "$PWD" >>"$GROUNDWORK_TEST_LOG"
  exit "${NPM_VERIFY_STATUS:-0}"
fi
printf 'mise %s\n' "$*" >>"$GROUNDWORK_TEST_LOG"
exit "${MISE_STATUS:-0}"
SH
  # Always present, silent by default: the runner's npm fallback would otherwise
  # find the HOST's npm (the runner deliberately prepends the real Homebrew
  # paths) and run a real `npm cache verify` from inside these fixtures. The
  # stub absorbs that; the npm-stage check turns logging on to prove the branch.
  cat >"$update_all_bin/npm" <<'SH'
#!/usr/bin/env bash
if [[ "${1:-}" == "config" && "${2:-}" == "get" && "${3:-}" == "cache" ]]; then
  printf '%s\n' "${NPM_CACHE_DIR:-$HOME/.npm}"
  exit 0
fi
[[ "${NPM_STUB_LOG:-0}" == "0" ]] || printf 'npm %s pwd=%s\n' "$*" "$PWD" >>"$GROUNDWORK_TEST_LOG"
SH
  cp home/dot_local/bin/executable_groundwork-cleanup "$update_all_bin/groundwork-cleanup"
  cp home/dot_local/share/groundwork/lib/brew-output.sh \
    "$update_all_home/.local/share/groundwork/lib/brew-output.sh"
  cp home/dot_local/share/groundwork/lib/reset-signals.c \
    "$update_all_home/.local/share/groundwork/lib/reset-signals.c"
  cp home/dot_local/share/groundwork/vendor-updater-casks.txt \
    "$update_all_home/.local/share/groundwork/vendor-updater-casks.txt"
  install_fixture_watchdog_runner \
    "$update_all_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_policy_clock "$update_all_bin/date"
  cat >"$update_all_bin/groundwork-docker-tidy" <<'SH'
#!/usr/bin/env bash
printf 'docker-tidy %s\n' "$*" >>"$GROUNDWORK_TEST_LOG"
pending="$HOME/.local/state/groundwork/docker-tidy-pending"
status="${DOCKER_TIDY_STATUS:-0}"
if [[ -n "${DOCKER_RUNTIME_STATE_FILE:-}" && -f "$DOCKER_RUNTIME_STATE_FILE" ]] \
  && grep -qxF running "$DOCKER_RUNTIME_STATE_FILE"; then
  status="${DOCKER_TIDY_RUNNING_STATUS:-0}"
  if [[ "${DOCKER_TIDY_SIGNAL_PARENT:-0}" == 1 ]]; then
    kill -TERM "$PPID"
    sleep 1
    exit 143
  fi
fi
if [[ "$status" -eq 0 ]]; then
  rm -f -- "$pending"
elif [[ "$status" -ne 3 && "${DOCKER_TIDY_RECORD_PENDING:-1}" -eq 1 ]]; then
  mkdir -p "$(dirname "$pending")"
  printf 'Docker scratch maintenance failed (exit %s)\n' "$status" >"$pending"
fi
exit "$status"
SH
  cat >"$update_all_bin/docker" <<'SH'
#!/usr/bin/env bash
if [[ "${1:-}" == context && "${2:-}" == inspect ]]; then
  [[ "${DOCKER_CONTEXT_STATUS:-0}" == 0 ]] || exit "$DOCKER_CONTEXT_STATUS"
  printf '%s\n' "${DOCKER_CONTEXT_HOST:-unix:///private/tmp/groundwork-docker.sock}"
  exit 0
fi
if [[ "${1:-}" == desktop && "${2:-}" == start && "${3:-}" == --help ]]; then
  exit "${DOCKER_DESKTOP_CAPABILITY_STATUS:-0}"
fi
if [[ "${1:-}" == desktop && "${2:-}" == start ]]; then
  printf 'docker-desktop-start\n' >>"$GROUNDWORK_TEST_LOG"
  if [[ "${DOCKER_START_PARTIAL:-0}" == 1 || "${DOCKER_START_STATUS:-0}" == 0 ]]; then
    printf 'running\n' >"$DOCKER_RUNTIME_STATE_FILE"
  fi
  exit "${DOCKER_START_STATUS:-0}"
fi
if [[ "${1:-}" == desktop && "${2:-}" == stop ]]; then
  printf 'docker-desktop-stop\n' >>"$GROUNDWORK_TEST_LOG"
  if [[ "${DOCKER_STOP_STATUS:-0}" == 0 ]]; then
    printf 'stopped\n' >"$DOCKER_RUNTIME_STATE_FILE"
  fi
  exit "${DOCKER_STOP_STATUS:-0}"
fi
if [[ "${1:-}" == info ]]; then
  printf 'docker-info\n' >>"$GROUNDWORK_TEST_LOG"
  grep -qxF running "$DOCKER_RUNTIME_STATE_FILE" || exit 1
  exit "${DOCKER_INFO_STATUS:-0}"
fi
exit 64
SH
  cat >"$update_all_bin/colima" <<'SH'
#!/usr/bin/env bash
if [[ "${1:-}" == start && "${2:-}" == --help ]]; then
  exit "${COLIMA_CAPABILITY_STATUS:-0}"
fi
if [[ "${1:-}" == start ]]; then
  if [[ "$#" -ne 3 || "${2:-}" != --runtime || "${3:-}" != docker ]]; then
    printf 'colima refused unexpected start arguments: %s\n' "$*" >&2
    exit 64
  fi
  printf 'colima %s\n' "$*" >>"$GROUNDWORK_TEST_LOG"
  if [[ "${DOCKER_START_PARTIAL:-0}" == 1 || "${DOCKER_START_STATUS:-0}" == 0 ]]; then
    printf 'running\n' >"$DOCKER_RUNTIME_STATE_FILE"
  fi
  exit "${DOCKER_START_STATUS:-0}"
fi
if [[ "${1:-}" == stop ]]; then
  [[ "$#" -eq 1 ]] || exit 64
  printf 'colima %s\n' "$*" >>"$GROUNDWORK_TEST_LOG"
  if [[ "${DOCKER_STOP_STATUS:-0}" == 0 ]]; then
    printf 'stopped\n' >"$DOCKER_RUNTIME_STATE_FILE"
  fi
  exit "${DOCKER_STOP_STATUS:-0}"
fi
exit 64
SH
  chmod +x "$update_all_bin/chezmoi" "$update_all_bin/brew" "$update_all_bin/ps" "$update_all_bin/mise" \
    "$update_all_bin/npm" "$update_all_bin/groundwork-cleanup" \
    "$update_all_bin/groundwork-docker-tidy" \
    "$update_all_bin/groundwork-repos" "$update_all_bin/groundwork-brew-update" \
    "$update_all_bin/groundwork-platform" "$update_all_bin/docker" \
    "$update_all_bin/colima" \
    "$update_all_fixture/fresh-runner"
  if HOME="$update_all_home" PATH="$update_all_bin:/usr/bin:/bin" \
    "$update_all_bin/brew" list --pinned --full-name >/dev/null 2>&1; then
    fail "the strict Homebrew fixture accepted the impossible pinned/full-name command"
  fi

  update_all_log="$update_all_fixture/commands.log"
  update_all_stamp="$update_all_home/.local/state/groundwork/last-update-all"
  update_all_path="/usr/bin:/bin"
  update_all_lock_path="$update_all_home/.local/lib/groundwork/update-lock.sh"
  update_all_runner_path="$update_all_home/.local/bin/groundwork-update-run"

  # Exact previous-release migration: v1.9 synchronizes source and applies only
  # the new runner. Begin without the post-v1.9 lock library and prove that the
  # fresh runner narrowly applies + verifies it before acquiring the transaction
  # lock and completing the full apply.
  test ! -e "$update_all_lock_path" \
    || fail "the v1.9 migration fixture was pre-seeded with the new lock helper"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    CHEZMOI_INSTALL_RUNNER=1 FRESH_RUNNER="$update_all_fixture/rendered-runner" \
    FRESH_LOCK_HELPER="$PWD/home/dot_local/lib/groundwork/update-lock.sh" \
    "$update_all_fixture/v1.9-launcher" --skip-maintenance \
    >"$update_all_fixture/v1.9-migration" 2>&1 \
    || {
      cat "$update_all_fixture/v1.9-migration" >&2
      fail "the v1.9 launcher could not migrate to the lock-dependent runner"
    }
  test -r "$update_all_lock_path" \
    || fail "the v1.9 migration did not install the synchronized lock helper"
  grep -qF "chezmoi apply $update_all_runner_path color=0" "$update_all_log"
  grep -qF "chezmoi apply --exclude=scripts $update_all_lock_path color=0" "$update_all_log"
  grep -qF "chezmoi verify $update_all_lock_path color=0" "$update_all_log"
  grep -qxF 'chezmoi apply color=0' "$update_all_log" \
    || fail "the v1.9 migration did not reach the runner-owned full apply"
  test ! -d "$update_all_home/.local/state/groundwork/update-all.lock" \
    || fail "the migrated runner did not release its newly bootstrapped lock"
  rm -f "$update_all_stamp"

  # An old launcher process validates the supported flag, syncs once, then hands
  # that same invocation to the runner the sync just installed, with exit status
  # intact.
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    CHEZMOI_INSTALL_RUNNER=1 FRESH_RUNNER="$update_all_fixture/fresh-runner" \
    FRESH_RUNNER_STATUS=42 "$update_all_fixture/old-launcher" --skip-maintenance \
    >"$update_all_fixture/handoff-output" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -eq 42 ]] || fail "update-all did not preserve the freshly installed runner's exit status"
  # color=0 on the chezmoi line proves the launcher decided color BEFORE the
  # sync (hook scripts inherit it), and on the runner line that the exec'd
  # runner inherits the same decision; stdout is a file here, so it is 0.
  cat >"$update_all_fixture/expected-handoff" <<EOF
chezmoi update --apply=false color=0
chezmoi init color=0
chezmoi status color=0
chezmoi apply $update_all_lock_path $update_all_runner_path color=0
chezmoi verify $update_all_lock_path $update_all_runner_path color=0
fresh runner color=0
arg=--skip-maintenance
EOF
  diff -u "$update_all_fixture/expected-handoff" "$update_all_log"

  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    CHEZMOI_INSTALL_RUNNER=1 FRESH_RUNNER="$update_all_fixture/fresh-runner" \
    "$update_all_fixture/old-launcher" --allow-app-quit \
    >"$update_all_fixture/app-quit-handoff" 2>&1 \
    || fail "the stable launcher rejected the explicit app-quit option"
  grep -qxF 'arg=--allow-app-quit' "$update_all_log" \
    || fail "the stable launcher did not forward --allow-app-quit to the fresh runner"

  # A synchronized config-template change may produce one pre-init warning.
  # Pull first, then initialize once so status/apply/verify cannot repeat it.
  rm -f "$update_all_home/.chezmoi-config-initialized"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    CHEZMOI_CONFIG_WARNING=1 CHEZMOI_INSTALL_RUNNER=1 \
    FRESH_RUNNER="$update_all_fixture/fresh-runner" \
    "$update_all_fixture/old-launcher" \
    >"$update_all_fixture/config-warning-once" 2>&1 \
    || fail "the one-boundary chezmoi config refresh failed"
  [[ "$(grep -cF 'configuration template changed' \
    "$update_all_fixture/config-warning-once")" -eq 1 ]] \
    || fail "a config-template change emitted more than one warning"
  [[ "$(grep -cxF 'chezmoi init color=0' "$update_all_log")" -eq 1 ]] \
    || fail "update-all did not initialize the synchronized config exactly once"

  # Exercise the complete launcher -> exec'd real runner -> nested real cleanup
  # ownership chain. The exec keeps the launcher's PID and must adopt the lock;
  # cleanup is its direct child and must borrow it without removing it.
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    ASSERT_UPDATE_LOCK_DURING_MAINTENANCE=1 \
    CHEZMOI_INSTALL_RUNNER=1 FRESH_RUNNER="$update_all_fixture/rendered-runner" \
    "$update_all_fixture/old-launcher" >"$update_all_fixture/real-handoff" 2>&1 \
    || {
      cat "$update_all_fixture/real-handoff" >&2
      fail "the full launcher-to-runner lock handoff failed"
    }
  grep -qxF 'lock observed during brew autoremove' "$update_all_log" \
    || fail "the nested cleanup did not observe the runner-owned lock"
  grep -qxF 'lock observed during brew cleanup' "$update_all_log" \
    || fail "the nested cleanup removed the runner-owned lock between stages"
  test ! -d "$update_all_home/.local/state/groundwork/update-all.lock" \
    || fail "the exec'd runner did not release the adopted update lock"
  rm -f "$update_all_stamp"

  # --help and hostile arguments are resolved before sync or any mutation.
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    "$update_all_fixture/old-launcher" --help >/dev/null
  test ! -s "$update_all_log" || fail "update-all --help invoked external commands"
  for hostile in --greedy extra "two words"; do
    : >"$update_all_log"
    set +e
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
      "$update_all_fixture/old-launcher" "$hostile" >/dev/null 2>&1
    update_all_status=$?
    set -e
    [[ "$update_all_status" -eq 64 ]] \
      || fail "update-all '$hostile' must exit 64, got $update_all_status"
    test ! -s "$update_all_log" \
      || fail "update-all hostile argument '$hostile' invoked external commands"
  done

  # Drift preflight: an MM file (changed locally AND changed by this update) is
  # named and the overwrite question explained BEFORE chezmoi can ask it. With
  # a usable terminal (the GROUNDWORK_PROMPT_TTY seam) the run continues into
  # the runner, which owns the full apply.
  printf '\n' >"$update_all_fixture/tty-drift"
  : >"$update_all_log"
  printf '' | env HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    GROUNDWORK_PROMPT_TTY="$update_all_fixture/tty-drift" \
    CHEZMOI_DRIFT='MM .config/karabiner/karabiner.json' \
    CHEZMOI_INSTALL_RUNNER=1 FRESH_RUNNER="$update_all_fixture/fresh-runner" \
    "$update_all_fixture/old-launcher" >"$update_all_fixture/drift-output" 2>&1 \
    || {
      cat "$update_all_fixture/drift-output" >&2
      fail "update-all failed on the drift-with-terminal preflight case"
    }
  grep -qF 'chezmoi will ask about each one' "$update_all_fixture/drift-output" \
    || fail "the drift preflight must explain the upcoming overwrite question"
  grep -qF '.config/karabiner/karabiner.json' "$update_all_fixture/drift-output" \
    || fail "the drift preflight must name the drifted file"
  grep -qF 'fresh runner color=0' "$update_all_log" \
    || fail "the run must continue into the runner after the drift preflight"

  # Drift with NO usable terminal stops BEFORE any apply with the documented
  # review-required status (2): an agent or cron run must never leave chezmoi
  # hanging on (or failing through) an overwrite question nobody can answer.
  : >"$update_all_log"
  set +e
  printf '' | env HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    GROUNDWORK_PROMPT_TTY=/nonexistent-groundwork-tty \
    CHEZMOI_DRIFT='MM .config/karabiner/karabiner.json' \
    "$update_all_fixture/old-launcher" >"$update_all_fixture/drift-no-tty" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -eq 2 ]] \
    || fail "drift without a terminal must exit 2 (review required), got $update_all_status"
  grep -qF 'stopping before the apply' "$update_all_fixture/drift-no-tty" \
    || fail "the no-terminal drift stop must say it stopped before the apply"
  assert_not_contains 'chezmoi apply' "$update_all_log" \
    "drift without a terminal must not reach any chezmoi apply"

  # A failed `chezmoi status` fails CLOSED before any apply: it means the
  # source cannot be rendered against this machine, and applying anyway would
  # run install hooks against a state nobody inspected.
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    CHEZMOI_STATUS_FAIL=1 "$update_all_fixture/old-launcher" \
    >"$update_all_fixture/status-failure" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] || fail "update-all continued after chezmoi status failed"
  grep -qF 'could not inspect managed-file drift' "$update_all_fixture/status-failure" \
    || fail "a status failure must be reported, not silently treated as no drift"
  assert_not_contains 'chezmoi apply' "$update_all_log" \
    "a status failure must stop the run before any chezmoi apply"

  # A runner that fails verification (a kept local edit) is refused: the
  # handoff contract promises the FRESHLY applied runner, never a stale copy
  # wearing its name.
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    CHEZMOI_VERIFY_STATUS=1 CHEZMOI_INSTALL_RUNNER=1 FRESH_RUNNER="$update_all_fixture/fresh-runner" \
    "$update_all_fixture/old-launcher" >"$update_all_fixture/stale-runner" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] || fail "update-all executed a runner that failed verification"
  grep -qF 'Refusing to run a stale updater' "$update_all_fixture/stale-runner" \
    || fail "a verification failure must refuse the stale runner explicitly"
  assert_not_contains 'fresh runner' "$update_all_log" \
    "a runner that failed verification must never be executed"

  # A failed apply of the runner target stops the handoff.
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    CHEZMOI_APPLY_FAIL=1 "$update_all_fixture/old-launcher" \
    >"$update_all_fixture/apply-failure" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] || fail "update-all continued after the runner apply failed"
  assert_not_contains 'fresh runner' "$update_all_log" \
    "a failed runner apply must not execute any runner"

  # The 2026 color-override contract on the one run-wide decision: FORCE_COLOR
  # turns the signal on without a terminal, NO_COLOR beats FORCE_COLOR, and a
  # caller's explicit GROUNDWORK_COLOR passes through untouched.
  for color_case in 'FORCE_COLOR=1 NO_COLOR= GROUNDWORK_COLOR=:1' \
    'FORCE_COLOR=1 NO_COLOR=1 GROUNDWORK_COLOR=:0' \
    'FORCE_COLOR= NO_COLOR=1 GROUNDWORK_COLOR=1:1'; do
    color_env="${color_case%:*}"
    color_expected="${color_case#*:}"
    : >"$update_all_log"
    # shellcheck disable=SC2086
    env HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
      $color_env CHEZMOI_INSTALL_RUNNER=1 FRESH_RUNNER="$update_all_fixture/fresh-runner" \
      "$update_all_fixture/old-launcher" >/dev/null 2>&1 \
      || fail "update-all failed under color overrides: $color_env"
    grep -qxF "chezmoi update --apply=false color=$color_expected" "$update_all_log" \
      || fail "the launcher must decide color=$color_expected before the sync under: $color_env"
    grep -qxF "chezmoi init color=$color_expected" "$update_all_log" \
      || fail "the launcher must rebuild the synchronized config exactly once"
    grep -qxF "fresh runner color=$color_expected" "$update_all_log" \
      || fail "the exec'd runner must inherit color=$color_expected under: $color_env"
  done

  # The launcher gates the platform BEFORE syncing: chezmoi update runs the
  # install hooks (Homebrew bootstrap, brew bundle, every run_ script), so an
  # unsupported platform must never reach it. A gate that only lives in the
  # runner fires after the machine has already been mutated.
  for launcher_platform in wsl1 wsl-unknown freebsd; do
    : >"$update_all_log"
    set +e
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
      FAKE_PLATFORM="$launcher_platform" "$update_all_fixture/old-launcher" \
      >"$update_all_fixture/launcher-$launcher_platform" 2>&1
    update_all_status=$?
    set -e
    [[ "$update_all_status" -ne 0 ]] \
      || fail "update-all launcher proceeded on unsupported platform $launcher_platform"
    test ! -s "$update_all_log" \
      || fail "update-all launcher ran chezmoi update on unsupported platform $launcher_platform"
  done
  grep -qF 'WSL1 is unsupported' "$update_all_fixture/launcher-wsl1"
  grep -qF 'wsl --list --verbose' "$update_all_fixture/launcher-wsl-unknown"

  # Synchronization failure prevents the handoff and every package/runtime stage.
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    CHEZMOI_STATUS=1 "$update_all_fixture/old-launcher" \
    >"$update_all_fixture/sync-failure-output" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] || fail "update-all continued after chezmoi update failed"
  diff -u <(printf 'chezmoi update --apply=false color=0\n') "$update_all_log"

  # A successful sync that does not deliver the runner fails loudly instead of
  # continuing through stale logic.
  rm -f "$update_all_bin/groundwork-update-run"
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    "$update_all_fixture/old-launcher" >"$update_all_fixture/missing-output" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] || fail "update-all continued without the freshly installed runner"
  grep -qF 'update runner is missing or not executable' "$update_all_fixture/missing-output"
  diff -u <(printf 'chezmoi update --apply=false color=0\nchezmoi init color=0\nchezmoi status color=0\nchezmoi apply %s %s color=0\nchezmoi verify %s %s color=0\n' \
    "$update_all_lock_path" "$update_all_runner_path" \
    "$update_all_lock_path" "$update_all_runner_path") "$update_all_log"

  # The remaining transactions exercise the rendered runner directly, exactly as
  # the launcher execs it. Unsupported platforms fail closed before ANY stage:
  # no Homebrew, no mise, no timestamp — a warning after mutation is not
  # fail-closed.
  for unsupported_platform in wsl1 wsl-unknown freebsd; do
    : >"$update_all_log"
    set +e
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
      FAKE_PLATFORM="$unsupported_platform" "$update_all_fixture/rendered-runner" \
      >"$update_all_fixture/unsupported-$unsupported_platform" 2>&1
    update_all_status=$?
    set -e
    [[ "$update_all_status" -ne 0 ]] \
      || fail "update-all runner proceeded on unsupported platform $unsupported_platform"
    test ! -s "$update_all_log" \
      || fail "update-all runner mutated tools on unsupported platform $unsupported_platform"
    test ! -e "$update_all_stamp" \
      || fail "update-all runner wrote the timestamp on unsupported platform $unsupported_platform"
  done
  grep -qF 'WSL1 is unsupported' "$update_all_fixture/unsupported-wsl1" \
    || fail "the WSL1 refusal must explain itself"
  grep -qF 'wsl --list --verbose' "$update_all_fixture/unsupported-wsl-unknown" \
    || fail "the ambiguous-WSL refusal must point at wsl --list --verbose"

  # Installed inventory is validated before metadata refresh or package
  # mutation. A hostile token cannot widen a later exact-token command.
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    BREW_FORMULAE='git;touch-owned' "$update_all_fixture/rendered-runner" \
    >"$update_all_fixture/hostile-brew-inventory" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "update-all accepted an injection-like installed Homebrew token"
  diff -u <(printf 'chezmoi apply color=0\nmise upgrade --minimum-release-age 5d\n') \
    "$update_all_log" \
    || fail "an invalid Homebrew inventory suppressed an independent safe lane"
  assert_not_contains '^brew-update$|^brew upgrade' "$update_all_log" \
    "update-all mutated Homebrew before validating installed inventory"
  grep -qF 'malformed installed or pinned token' "$update_all_fixture/hostile-brew-inventory"

  # Failed Homebrew metadata refresh blocks Homebrew mutation but does not
  # suppress an independent mise observation/update lane. Package-manager and
  # Docker maintenance stay skipped because they would add mutation after the
  # updater authority failed closed.
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    BREW_UPDATE_STATUS=1 "$update_all_fixture/rendered-runner" \
    >"$update_all_fixture/failure-output" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] || fail "a failed Homebrew refresh produced a false complete result"
  diff -u <(printf 'chezmoi apply color=0\nbrew-update\nmise upgrade --minimum-release-age 5d\n') "$update_all_log"
  grep -qF 'Package-manager maintenance skipped because Homebrew inventory or update failed' \
    "$update_all_fixture/failure-output" \
    || fail "Homebrew failure did not explain why later package-manager mutation was skipped"
  grep -qF 'Docker scratch maintenance skipped because the required Homebrew lane failed' \
    "$update_all_fixture/failure-output" \
    || fail "Homebrew failure did not isolate Docker maintenance"
  test ! -e "$update_all_stamp"

  # An authoritative Homebrew exit is an error even when Homebrew prints no
  # literal `Error:` line. Preserve the exact sub-lane, token, status, and the
  # bounded tail disposition instead of claiming that no error was observed.
  rm -rf "$update_all_home/.local/state/groundwork/update-all-pending"
  : >"$update_all_log"
  silent_brew_exit=0
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_UPGRADE_STATUS=1 "$update_all_fixture/rendered-runner" \
    >"$update_all_fixture/silent-brew-failure" 2>&1 || silent_brew_exit=$?
  [[ "$silent_brew_exit" -eq 1 ]] \
    || fail "a silent Homebrew exit 1 surfaced as $silent_brew_exit"
  grep -qF 'Errors: 1 authoritative command failure' \
    "$update_all_fixture/silent-brew-failure" \
    || fail "a silent Homebrew exit did not become an explicit error"
  grep -qF 'Failed sub-lane: Homebrew formula upgrade (exit 1)' \
    "$update_all_fixture/silent-brew-failure"
  grep -qF 'Failed exact package token(s): git' \
    "$update_all_fixture/silent-brew-failure"
  grep -qF '(Homebrew produced no output.)' \
    "$update_all_fixture/silent-brew-failure" \
    || fail "a silent Homebrew failure omitted its bounded-output disposition"
  assert_not_contains 'Errors: none observed' \
    "$update_all_fixture/silent-brew-failure" \
    "an authoritative Homebrew failure claimed that no error was observed"
  test ! -e "$update_all_stamp"
  rm -rf "$update_all_home/.local/state/groundwork/update-all-pending"

  # Ctrl-C and termination statuses from a managed stage propagate unchanged.
  for interrupt_status in 129 130 143; do
    : >"$update_all_log"
    set +e
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
      NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
      BREW_UPDATE_STATUS="$interrupt_status" "$update_all_fixture/rendered-runner" \
      >/dev/null 2>&1
    update_all_status=$?
    set -e
    [[ "$update_all_status" -eq "$interrupt_status" ]] \
      || fail "update-all runner changed stage status $interrupt_status to $update_all_status"
    diff -u <(printf 'chezmoi apply color=0\nbrew-update\n') "$update_all_log"
    test ! -e "$update_all_stamp"
  done

  # A complete success runs in order against the approved metadata snapshot and
  # only then atomically writes a UTC timestamp. The Linux render must not carry
  # the macOS cask policy, and it reports the OS-ownership boundary: distro
  # packages on Linux, the Windows host on WSL2, are never Groundwork's to touch.
  : >"$update_all_log"
  dynamic_exit=0
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    "$update_all_fixture/rendered-runner" >"$update_all_fixture/success-output" 2>&1
  cat >"$update_all_fixture/expected-success" <<'EOF'
chezmoi apply color=0
brew-update
brew upgrade --formula git auto=1 casks=unset hb-color=unset
mise upgrade --minimum-release-age 5d
brew autoremove
brew cleanup --prune=all
docker-tidy --automatic
EOF
  diff -u "$update_all_fixture/expected-success" "$update_all_log"
  test -f "$update_all_stamp"
  grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' "$update_all_stamp"
  update_all_temps=("${update_all_stamp}.tmp."*)
  ((${#update_all_temps[@]} == 0)) || fail "update-all runner left a temporary timestamp behind"
  grep -qF 'managed separately by your distribution' "$update_all_fixture/success-output"
  grep -qF 'Groundwork update complete' "$update_all_fixture/success-output" \
    || fail "a successful update omitted its final receipt"
  grep -qF 'Homebrew                completed' "$update_all_fixture/success-output" \
    || fail "the final receipt omitted Homebrew maintenance status"
  grep -qF 'Docker scratch          completed' "$update_all_fixture/success-output" \
    || fail "the final receipt omitted Docker maintenance status"
  grep -qF '  SUCCESS' "$update_all_fixture/success-output" \
    || fail "the final receipt did not classify the successful transaction"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=wsl2 "$update_all_fixture/rendered-runner" \
    >"$update_all_fixture/wsl-success-output" 2>&1
  diff -u "$update_all_fixture/expected-success" "$update_all_log"
  grep -qF 'managed separately on the host' "$update_all_fixture/wsl-success-output"

  # The real runner collapses only the exact known no-change Homebrew shapes,
  # keeps an unknown warning in the live transcript, counts both classes in the
  # final receipt, and preserves the complete raw stream for diagnosis.
  rm -f "$update_all_stamp"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    BREW_CLASSIFICATION_FIXTURE=1 "$update_all_fixture/rendered-runner" \
    >"$update_all_fixture/brew-classified-run" 2>&1 \
    || fail "the runner failed while classifying Homebrew output"
  assert_not_contains 'Warning: git 2.51.0 already installed|Warning: Not upgrading ghostty' \
    "$update_all_fixture/brew-classified-run" \
    "known Homebrew no-change messages leaked into the live warning stream"
  grep -qF 'Warning: unfamiliar Homebrew condition remains actionable' \
    "$update_all_fixture/brew-classified-run" \
    || fail "the runner hid an unfamiliar Homebrew warning"
  grep -qF 'Homebrew                2 known no-change message(s) summarized' \
    "$update_all_fixture/brew-classified-run" \
    || fail "the final receipt omitted the Homebrew current count"
  grep -qF 'Homebrew                1 unknown warning(s) preserved' \
    "$update_all_fixture/brew-classified-run" \
    || fail "the final receipt omitted the preserved Homebrew warning count"
  raw_upgrade_log="$update_all_home/.local/state/groundwork/logs/homebrew-upgrade-latest.log"
  grep -qF 'Warning: git 2.51.0 already installed' "$raw_upgrade_log" \
    || fail "the raw Homebrew log omitted a collapsed no-change message"
  grep -qF 'Warning: unfamiliar Homebrew condition remains actionable' "$raw_upgrade_log" \
    || fail "the raw Homebrew log omitted an unfamiliar warning"

  # Docker scratch maintenance is part of the normal transaction, after package
  # maintenance. Its failure preserves earlier stages and the previous success
  # timestamp, records durable pending state, and names the same label-scoped
  # helper for maintenance-only repair. The exceptional skip neither runs nor
  # clears that pending work; an ordinary update-all later repairs it.
  docker_pending="$update_all_home/.local/state/groundwork/docker-tidy-pending"
  printf 'previous-docker-success\n' >"$update_all_stamp"
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    DOCKER_TIDY_STATUS=9 "$update_all_fixture/rendered-runner" \
    >"$update_all_fixture/docker-tidy-failure" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "a failed Docker scratch tidy was reported as a successful refresh"
  grep -qxF 'docker-tidy --automatic' "$update_all_log"
  test -f "$docker_pending" || fail "a failed Docker scratch tidy recorded no pending state"
  grep -qF 'failed (exit 9)' "$docker_pending"
  grep -qF 'groundwork-docker-tidy --yes' "$update_all_fixture/docker-tidy-failure"
  grep -qF 'Daemon-wide cleanup remains an owner-reviewed, separate command.' \
    "$update_all_fixture/docker-tidy-failure"
  grep -qxF 'previous-docker-success' "$update_all_stamp"

  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    "$update_all_fixture/rendered-runner" --skip-maintenance \
    >"$update_all_fixture/docker-tidy-skip-pending" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "--skip-maintenance hid pending Docker scratch maintenance"
  assert_not_contains 'docker-tidy' "$update_all_log" \
    "--skip-maintenance invoked the Docker tidy while preserving its pending record"
  test -f "$docker_pending" || fail "--skip-maintenance cleared Docker pending state"

  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    "$update_all_fixture/rendered-runner" \
    >"$update_all_fixture/docker-tidy-repaired" 2>&1 \
    || fail "ordinary update-all did not repair pending Docker scratch maintenance"
  test ! -e "$docker_pending" || fail "successful Docker scratch maintenance left pending state"

  # Docker unavailability is not a cleanup result. With no older repair the
  # transaction records an honest skip and may still succeed; with older pending
  # state the exact record survives and the transaction remains incomplete.
  rm -f "$docker_pending" "$update_all_stamp"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    DOCKER_TIDY_STATUS=3 "$update_all_fixture/rendered-runner" \
    >"$update_all_fixture/docker-unavailable-clean" 2>&1 \
    || fail "Docker unavailability without pending repair failed update-all"
  grep -qF 'Docker scratch maintenance skipped because no safe managed local backend was available' \
    "$update_all_fixture/docker-unavailable-clean"
  grep -qF 'Docker scratch          skipped-runtime-stopped' \
    "$update_all_fixture/docker-unavailable-clean" \
    || fail "the final receipt did not classify the unavailable Docker lane as skipped"
  test ! -e "$docker_pending" || fail "an unavailable Docker lane invented pending state"
  test -f "$update_all_stamp" || fail "an honest Docker-unavailable skip withheld update-all success"

  printf 'older Docker failure must survive\n' >"$docker_pending"
  printf 'previous-success\n' >"$update_all_stamp"
  rm -f "$update_all_home"/.mas-updated-*
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    DOCKER_TIDY_STATUS=3 "$update_all_fixture/rendered-runner" \
    >"$update_all_fixture/docker-unavailable-pending" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "Docker unavailability hid an older pending repair"
  grep -qxF 'older Docker failure must survive' "$docker_pending" \
    || fail "Docker unavailability rewrote or cleared the older pending record"
  grep -qF 'earlier Docker scratch maintenance remains pending' \
    "$update_all_fixture/docker-unavailable-pending"
  grep -qxF 'previous-success' "$update_all_stamp"
  rm -f "$docker_pending"

  # The run-wide color signal reaches the brew stages: with GROUNDWORK_COLOR=1
  # the runner forces Homebrew's documented HOMEBREW_COLOR through any capture,
  # and with the signal off (or NO_COLOR set and no signal) it forces nothing —
  # redirecting the whole run to a file stays monochrome.
  for runner_color_case in 'GROUNDWORK_COLOR=1 NO_COLOR= FORCE_COLOR=:1' \
    'GROUNDWORK_COLOR=0 NO_COLOR= FORCE_COLOR=:unset' \
    'GROUNDWORK_COLOR= NO_COLOR=1 FORCE_COLOR=:unset' \
    'GROUNDWORK_COLOR= NO_COLOR= FORCE_COLOR=1:1'; do
    runner_color_env="${runner_color_case%:*}"
    runner_color_expected="${runner_color_case#*:}"
    rm -f "$update_all_stamp"
    : >"$update_all_log"
    # shellcheck disable=SC2086
    env HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
      HOMEBREW_COLOR= $runner_color_env "$update_all_fixture/rendered-runner" >/dev/null 2>&1 \
      || fail "update-all runner failed under color settings: $runner_color_env"
    grep -qxF "brew upgrade --formula git auto=1 casks=unset hb-color=$runner_color_expected" "$update_all_log" \
      || fail "brew must see HOMEBREW_COLOR=$runner_color_expected under: $runner_color_env"
  done

  # A later mise failure leaves the previous timestamp untouched, but it does not
  # suppress safe package-manager maintenance after the successful Homebrew lane.
  printf 'previous-success\n' >"$update_all_stamp"
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    MISE_STATUS=1 "$update_all_fixture/rendered-runner" \
    >"$update_all_fixture/mise-failure-output" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] || fail "update-all runner recorded success after mise upgrade failed"
  diff -u <(printf 'chezmoi apply color=0\nbrew-update\nbrew upgrade --formula git auto=1 casks=unset hb-color=unset\nmise upgrade --minimum-release-age 5d\nbrew autoremove\nbrew cleanup --prune=all\ndocker-tidy --automatic\n') \
    "$update_all_log"
  grep -qxF 'previous-success' "$update_all_stamp"

  # The machine-side 5-day floor: mise must be age-gated in the normal path, the
  # same policy the renovate-config preset applies to repo dependencies. An older
  # mise without the flag still upgrades, but must say so rather than pretend.
  grep -qF 'mise upgrade --minimum-release-age 5d' "$update_all_fixture/expected-success" \
    || fail "update-all must apply the 5-day release floor to mise upgrades"
  # A mise that cannot enforce the floor must FAIL CLOSED: the runtime stage is
  # skipped, the run exits nonzero, and no success timestamp is written. Do NOT
  # "restore" an ungated fallback here — a policy that steps aside whenever it
  # cannot be enforced is not a policy.
  rm -f "$update_all_stamp"
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    MISE_HAS_RELEASE_AGE=0 "$update_all_fixture/rendered-runner" \
    >"$update_all_fixture/mise-old" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "update-all succeeded on a mise that cannot enforce the 5-day release floor"
  assert_not_contains '^mise upgrade$' "$update_all_log" \
    "update-all ran an UNGATED mise upgrade when the release floor was unavailable"
  grep -qF 'cannot enforce the 5-day release floor' "$update_all_fixture/mise-old"
  grep -qF 'brew upgrade mise' "$update_all_fixture/mise-old" \
    || fail "the mise floor refusal must say how to fix it"
  grep -qxF 'brew autoremove' "$update_all_log" \
    || fail "a mise policy refusal suppressed independent Homebrew maintenance"
  grep -qxF 'brew cleanup --prune=all' "$update_all_log" \
    || fail "a mise policy refusal suppressed independent Homebrew cache cleanup"
  test ! -e "$update_all_stamp" \
    || fail "update-all recorded success although the release floor was skipped"
  rm -f "$update_all_stamp"

  # macOS is the primary platform, so run the transaction against the darwin
  # render too — not just grep it. The cask policy and the app relaunch only
  # exist in that branch.
  render darwin false arm64 home/dot_local/bin/executable_groundwork-update-run.tmpl \
    "$update_all_fixture/darwin-runner"
  render darwin false arm64 home/dot_local/bin/executable_groundwork-update-run.tmpl \
    "$update_all_fixture/darwin-work-runner" true false false false bitwarden \
    work-managed managed current
  chmod +x "$update_all_fixture/darwin-runner" \
    "$update_all_fixture/darwin-work-runner"
  cat >"$update_all_bin/groundwork-apps-start" <<'SH'
#!/usr/bin/env bash
printf 'apps-start\n' >>"$GROUNDWORK_TEST_LOG"
exit "${APPS_START_STATUS:-0}"
SH
  cat >"$update_all_bin/groundwork-karabiner-postflight" <<'SH'
#!/usr/bin/env bash
printf 'karabiner-postflight' >>"$GROUNDWORK_TEST_LOG"
for arg in "$@"; do
  printf ' arg=%s' "$arg" >>"$GROUNDWORK_TEST_LOG"
done
printf '\n' >>"$GROUNDWORK_TEST_LOG"
if [[ "${KARABINER_ROOT_SERVICE_PRESENT:-1}" == 0 ]]; then
  echo 'Groundwork postflight: Karabiner is installed, but its root Core Service is not running.' >&2
  exit 9
fi
exit "${KARABINER_POSTFLIGHT_STATUS:-0}"
SH
  cat >"$update_all_bin/groundwork-app-adopt" <<'SH'
#!/usr/bin/env bash
printf 'app-adopt %s\n' "$*" >>"$GROUNDWORK_TEST_LOG"
test ! -d "$HOME/.local/state/groundwork/update-all.lock"
test -z "${GROUNDWORK_UPDATE_LOCK_HELD:-}"
test -z "${GROUNDWORK_UPDATE_LOCK_TOKEN:-}"
case "$*" in
  '--check chatgpt') exit "${ACTION_ADOPT_CHECK_STATUS:-0}" ;;
  '--yes chatgpt')
    [[ "${ACTION_ADOPT_STATUS:-0}" == 0 ]] || exit "$ACTION_ADOPT_STATUS"
    : >"$HOME/.chatgpt-adopted"
    ;;
  *) exit 64 ;;
esac
SH
  cat >"$update_all_bin/groundwork-app-remove" <<'SH'
#!/usr/bin/env bash
printf 'app-remove %s\n' "$*" >>"$GROUNDWORK_TEST_LOG"
test ! -d "$HOME/.local/state/groundwork/update-all.lock"
test -z "${GROUNDWORK_UPDATE_LOCK_HELD:-}"
test -z "${GROUNDWORK_UPDATE_LOCK_TOKEN:-}"
case "$*" in
  '--check chatgpt-classic') exit "${ACTION_REMOVE_CHECK_STATUS:-0}" ;;
  '--yes chatgpt-classic')
    [[ "${ACTION_REMOVE_STATUS:-0}" == 0 ]] || exit "$ACTION_REMOVE_STATUS"
    mv "$GROUNDWORK_APPLICATIONS_DIR/ChatGPT Classic.app" \
      "$HOME/.Trash/ChatGPT Classic.app"
    ;;
  *) exit 64 ;;
esac
SH
  cat >"$update_all_home/.local/share/groundwork/lib/karabiner.sh" <<'SH'
gw_karabiner_version() {
  [[ -n "${KARABINER_VERSION_BEFORE:-}" ]] || return 1
  printf '%s\n' "$KARABINER_VERSION_BEFORE"
}
SH
  chmod +x "$update_all_bin/groundwork-apps-start" \
    "$update_all_bin/groundwork-karabiner-postflight" \
    "$update_all_bin/groundwork-app-adopt" \
    "$update_all_bin/groundwork-app-remove"
  grep -qF "karabiner_postflight=\"\$HOME/.local/bin/groundwork-karabiner-postflight\"" \
    "$update_all_fixture/darwin-runner" \
    || fail "the macOS runner render omitted the Karabiner postflight"
  test -x "$update_all_bin/groundwork-karabiner-postflight" \
    || fail "the update fixture did not install an executable Karabiner postflight"
  rm -f "$update_all_stamp"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-success" 2>&1
  cat >"$update_all_fixture/expected-darwin" <<'EOF'
chezmoi apply color=0
brew-update
brew upgrade --formula git auto=1 casks=unset hb-color=unset
brew upgrade --cask --require-sha --no-quit ghostty auto=1 casks=unset hb-color=unset
brew-repair
apps-start
mise upgrade --minimum-release-age 5d
brew autoremove
brew cleanup --prune=all
docker-tidy --automatic
karabiner-postflight
EOF
  diff -u "$update_all_fixture/expected-darwin" "$update_all_log" \
    || fail "the successful macOS transaction omitted or reordered its Karabiner postflight"
  test -f "$update_all_stamp"
  assert_not_contains 'docker-desktop-(start|stop)|colima-(start|stop)' "$update_all_log" \
    "an already-available Docker lane changed backend lifecycle state"

  # Dynamic installed metadata, not a product-specific allowlist, drives the
  # expensive self-updating and version-latest lanes. Multiple apps must enter
  # one exact-token command; a current self-updating app must stay out, while
  # no-checksum and deprecated casks remain visible review outcomes.
  rm -f "$update_all_stamp"
  : >"$update_all_log"
  dynamic_exit=0
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_CASKS='ghostty chatgpt cursor claude obsidian self-current google-chrome google-chrome@beta unknown-vendor disabled-cask latest-cask codex-app' \
    BREW_AUTO_OUTDATED='chatgpt cursor claude obsidian' \
    BREW_LATEST_OUTDATED='latest-cask' \
    BREW_LAUNCH_AFTER_SNAPSHOT=1 \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-dynamic-casks" 2>&1 || dynamic_exit=$?
  [[ "$dynamic_exit" -eq 0 ]] \
    || fail "accepted vendor/deprecated cask outcomes surfaced as exit $dynamic_exit"
  grep -qxF \
    'brew upgrade --cask --require-sha --no-quit --greedy-auto-updates chatgpt claude cursor obsidian auto=1 casks=unset hb-color=unset' \
    "$update_all_log" \
    || fail "the targeted self-updating lane omitted an exact installed outdated cask"
  grep -qxF \
    'brew upgrade --cask --require-sha --no-quit --greedy-latest latest-cask auto=1 casks=unset hb-color=unset' \
    "$update_all_log" \
    || fail "the checksummed version-latest lane omitted its exact outdated cask"
  assert_not_contains '^brew upgrade .*self-current' "$update_all_log" \
    "a current self-updating cask was upgraded needlessly"
  assert_not_contains '^brew upgrade --greedy([[:space:]]|$)|^brew upgrade --cask --greedy([[:space:]]|$)' \
    "$update_all_log" \
    "update-all invoked an unscoped global greedy upgrade"
  grep -qF 'Groundwork vendor-covered: google-chrome remains with its declared self-updater' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "a no-checksum vendor-updated cask disappeared from the coverage receipt"
  grep -qF 'Groundwork vendor-covered: google-chrome@beta remains with its declared self-updater' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "the Chrome Beta vendor-updater coverage disappeared"
  grep -qF 'Inspect exact ownership before optional removal: groundwork-app-remove codex-app' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "the deprecated codex-app was not distinguished from current ChatGPT"
  grep -qF 'Vendor-covered          2 self-updating cask(s)' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "the accepted vendor-updater coverage was not summarized"
  grep -qF 'Groundwork review: unknown-vendor 1.0.0 -> 1.1.0 was not upgraded automatically (unverified-vendor-updater).' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "an unknown no-checksum self-updater was incorrectly trusted"
  grep -qF 'Unverified casks        1 checksum/updater-ownership item(s) named above' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "the unverified updater count was absent from the final receipt"
  grep -qF 'Groundwork owner action: disabled cask disabled-cask 1.0.0 -> 1.1.0 remains installed and unchanged.' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "the disabled cask did not receive its distinct disposition"
  grep -qF 'Review its supported replacement or run: brew uninstall --cask disabled-cask' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "the disabled cask omitted replacement/removal guidance"
  assert_not_contains 'brew upgrade .*disabled-cask|brew upgrade --cask --require-sha disabled-cask' \
    "$update_all_log" \
    "a disabled cask entered a mutating command"
  grep -qF 'Discovered              13 installed formulae and casks' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "the Homebrew discovery count omitted a formula or cask"
  grep -qF 'Current                 1' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "the Homebrew current count did not match the classified inventory"
  grep -qF 'Attempted               7 exact eligible item(s)' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "the Homebrew attempted count did not match the exact mutating argv"
  grep -qF 'Verified updated        7' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "the Homebrew verified-update count did not match reconciliation"
  grep -qF 'SUCCESS · 3 OWNER-REVIEW ITEM(S)' \
    "$update_all_fixture/darwin-dynamic-casks" \
    || fail "the deprecated cask was not kept distinct from an updater failure"
  test -f "$update_all_stamp" \
    || fail "accepted vendor coverage incorrectly withheld the success timestamp"

  # Running applications are removed from the mutating argv by default while
  # unrelated casks continue. The explicit flag permits Homebrew's normal quit
  # behavior only for that invocation and does not widen the selected tokens.
  rm -f "$update_all_stamp"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_CASKS='ghostty chatgpt cursor' BREW_AUTO_OUTDATED='chatgpt cursor' \
    BREW_RUNNING_COMMANDS="$GROUNDWORK_APPLICATIONS_DIR/Cursor.app/Contents/MacOS/Cursor --reuse-window" \
    BREW_PS_TRACE_FILE="$update_all_fixture/running-cask-ps.trace" \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-running-cask" 2>&1 \
    || fail "deferring one running cask failed the otherwise safe update"
  diff -u <(printf '%s\n%s\n' 'args=-axo command=' \
    "running=$GROUNDWORK_APPLICATIONS_DIR/Cursor.app/Contents/MacOS/Cursor --reuse-window") \
    "$update_all_fixture/running-cask-ps.trace" \
    || fail "the running-cask fixture did not exercise the production ps snapshot seam"
  grep -qxF \
    'brew upgrade --cask --require-sha --no-quit --greedy-auto-updates chatgpt auto=1 casks=unset hb-color=unset' \
    "$update_all_log" || {
    sed -n '1,120p' "$update_all_log" >&2
    sed -n '1,220p' "$update_all_fixture/darwin-running-cask" >&2
    fail "a running cask prevented an unrelated self-updating cask upgrade"
  }
  assert_not_contains '^brew upgrade .*cursor' "$update_all_log" \
    "a running application entered the default mutating cask argv"
  grep -qF 'Groundwork deferred-running: cursor is open and was not upgraded.' \
    "$update_all_fixture/darwin-running-cask" \
    || fail "the running cask was not reported as deferred"
  grep -qF 'Save your work, then rerun: update-all --allow-app-quit' \
    "$update_all_fixture/darwin-running-cask" \
    || fail "the running cask omitted its exact opt-in rerun action"
  grep -qF 'SUCCESS · 1 DEFERRED-RUNNING' \
    "$update_all_fixture/darwin-running-cask" \
    || fail "running-app deferral was conflated with updater failure"

  rm -f "$update_all_stamp"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_CASKS='ghostty chatgpt cursor' BREW_AUTO_OUTDATED='chatgpt cursor' \
    BREW_RUNNING_COMMANDS="$GROUNDWORK_APPLICATIONS_DIR/Cursor.app/Contents/MacOS/Cursor --reuse-window" \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" --allow-app-quit \
    >"$update_all_fixture/darwin-running-cask-opt-in" 2>&1 \
    || fail "the explicit app-quit invocation failed"
  grep -qxF \
    'brew upgrade --cask --require-sha --greedy-auto-updates chatgpt cursor auto=1 casks=unset hb-color=unset' \
    "$update_all_log" \
    || fail "--allow-app-quit did not preserve the exact selected cask argv"
  assert_not_contains 'deferred-running' "$update_all_fixture/darwin-running-cask-opt-in" \
    "the explicit app-quit invocation still claimed a deferral"

  # Privileged replacement metadata is only relevant when an update is due.
  # Current AppCleaner, Karabiner, and Zoom equivalents must be quiet/current.
  rm -f "$update_all_stamp"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_CASKS='ghostty appcleaner karabiner-elements zoom' \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-current-privileged-casks" 2>&1 \
    || fail "current privileged casks failed the otherwise safe update"
  assert_not_contains 'Groundwork review: (appcleaner|karabiner-elements|zoom)' \
    "$update_all_fixture/darwin-current-privileged-casks" \
    "current privileged casks created recurring review noise"
  assert_not_contains '^brew upgrade .*(appcleaner|karabiner-elements|zoom)' \
    "$update_all_log" \
    "a current privileged cask entered a mutating command"
  grep -qF 'Current                 3' \
    "$update_all_fixture/darwin-current-privileged-casks" \
    || fail "current privileged casks were not counted as current"
  [[ -z "$(tail -c 1 "$update_all_fixture/darwin-current-privileged-casks")" ]] \
    || fail "update-all left a partial non-newline-terminated status line"
  assert_not_contains 'kUsage:|[^[:space:]]Usage:' \
    "$update_all_fixture/darwin-current-privileged-casks" \
    "update-all output contained a spliced usage fragment"

  rm -f "$update_all_stamp"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULAE='git owner/tap/tool' \
    BREW_PINNED='owner/tap/tool' BREW_FORMULA_OUTDATED='git owner/tap/tool' \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-pinned-formula" 2>&1 \
    || fail "a pinned formula failed the otherwise safe update"
  grep -qF 'Groundwork pinned: formula owner/tap/tool 1.0.0 remains pinned.' \
    "$update_all_fixture/darwin-pinned-formula" \
    || fail "a tapped pinned formula disappeared from the formula receipt"
  grep -qF 'Optional owner action: brew unpin --formula owner/tap/tool' \
    "$update_all_fixture/darwin-pinned-formula" \
    || fail "the tapped pinned formula omitted its exact optional action"
  grep -qxF 'brew upgrade --formula git auto=1 casks=unset hb-color=unset' \
    "$update_all_log" \
    || fail "pin normalization removed an unrelated formula from mutation"
  assert_not_contains '^brew upgrade --formula .*owner/tap/tool' "$update_all_log" \
    "a tapped pinned formula entered the mutating upgrade lane"
  grep -qF 'Pinned                  1' \
    "$update_all_fixture/darwin-pinned-formula" \
    || fail "the formula pin was counted outside the pinned outcome"

  rm -f "$update_all_home"/.mas-updated-* "$update_all_stamp"
  : >"$update_all_log"
  : >"$update_all_fixture/pty-empty-input"
  printf 'fixture-password\nfixture-password\n' \
    >"$update_all_fixture/pty-mas-passwords"
  mas_xcode_264='{"trackId":497799835,"trackName":"Xcode","version":"26.4"}'
  mas_xcode_265='{"trackId":497799835,"trackName":"Xcode","version":"26.5"}'
  mas_xcode_outdated='{"trackId":497799835,"trackName":"Xcode","version":"26.4","newVersion":"26.5"}'
  mas_anybox_10='{"trackId":1593408455,"trackName":"Anybox (Research)","version":"1.0"}'
  mas_anybox_11='{"trackId":1593408455,"trackName":"Anybox (Research)","version":"1.1"}'
  mas_anybox_outdated='{"trackId":1593408455,"trackName":"Anybox (Research)","version":"1.0","newVersion":"1.1"}'
  mas_installed_both="$mas_xcode_264"$'\n'"$mas_anybox_10"
  mas_outdated_both="$mas_xcode_outdated"$'\n'"$mas_anybox_outdated"
  mas_updated_both="$mas_xcode_265"$'\n'"$mas_anybox_11"
  mas_partial_both="$mas_xcode_264"$'\n'"$mas_anybox_11"

  # JSON is a reviewed mas 7.x interface, not an ambient assumption about an
  # arbitrary older or future CLI. An unsupported major and a malformed JSON
  # stream both fail the MAS lane before authorization or mutation while the
  # independent mise lane still runs.
  : >"$update_all_log"
  mas_version_exit=0
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
    MAS_VERSION=6.0.1 MAS_INSTALLED="$mas_xcode_264" \
    MAS_OUTDATED="$mas_xcode_outdated" FAKE_PLATFORM=darwin \
    "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-mas-unsupported-json-contract" 2>&1 \
    || mas_version_exit=$?
  [[ "$mas_version_exit" -ne 0 ]] \
    || fail "an unsupported mas JSON contract produced a false complete result"
  grep -qF 'requires reviewed mas 7.x; observed 6.0.1' \
    "$update_all_fixture/darwin-mas-unsupported-json-contract"
  assert_not_contains '^sudo -v$|^sudo -n mas update|^mas update' "$update_all_log" \
    "an unsupported mas JSON contract reached authorization or mutation"
  grep -qxF 'mise upgrade --minimum-release-age 5d' "$update_all_log" \
    || fail "an unsupported mas JSON contract suppressed the independent mise lane"

  : >"$update_all_log"
  mas_malformed_json_exit=0
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
    MAS_INSTALLED='{"trackId":497799835,"trackName":"Xcode (broken)","version":}' \
    MAS_OUTDATED="$mas_xcode_outdated" FAKE_PLATFORM=darwin \
    "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-mas-malformed-json" 2>&1 \
    || mas_malformed_json_exit=$?
  [[ "$mas_malformed_json_exit" -ne 0 ]] \
    || fail "a malformed mas JSON stream produced a false complete result"
  grep -qF 'returned a malformed installed item' \
    "$update_all_fixture/darwin-mas-malformed-json"
  assert_not_contains '^sudo -v$|^sudo -n mas update|^mas update' "$update_all_log" \
    "a malformed mas JSON stream reached authorization or mutation"
  grep -qxF 'mise upgrade --minimum-release-age 5d' "$update_all_log" \
    || fail "a malformed mas JSON stream suppressed the independent mise lane"

  install_fixture_runtime_runner \
    "$update_all_home/.local/share/groundwork/lib/maintenance-runner.sh"
  if ! run_fixture_pty "$update_all_fixture/darwin-mas-exact" \
    "$update_all_fixture/pty-mas-passwords" env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
    MAS_INSTALLED="$mas_installed_both" MAS_OUTDATED="$mas_outdated_both" \
    MAS_POST_INSTALLED="$mas_updated_both" \
    SUDO_AUTH_PROMPT=1 SUDO_AUTH_READ=1 \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    ; then
    cat "$update_all_fixture/darwin-mas-exact" >&2
    fail "the exact Mac App Store update fixture failed"
  fi
  [[ "$(grep -c '^sudo -v$' "$update_all_log")" -eq 2 ]] \
    || fail "each exact Mac App Store mutation did not establish fresh authorization"
  [[ "$(grep -c '^sudo auth pgid=' "$update_all_log")" -eq 2 ]] \
    || fail "the real PTY fixture did not authenticate twice through foreground sudo"
  awk -F'[ =]' '/^sudo auth pgid=/ { if ($4 != $6) exit 1; count++ } END { exit count != 2 }' \
    "$update_all_log" \
    || fail "sudo password input was not owned by the foreground terminal process group"
  grep -qxF 'sudo -n mas update 497799835' "$update_all_log"
  grep -qxF 'sudo -n mas update 1593408455' "$update_all_log"
  grep -qxF 'mas update 497799835' "$update_all_log" \
    || fail "Xcode was not updated by its exact discovered ID"
  grep -qxF 'mas update 1593408455' "$update_all_log" \
    || fail "Anybox was not updated by its exact discovered ID"
  grep -qF 'Mac App Store apps      updated-and-verified' \
    "$update_all_fixture/darwin-mas-exact" \
    || fail "the Mac App Store exact-ID lane was not reflected in the final receipt"
  rm -f "$update_all_home"/.mas-updated-*

  # An item disappearing from `mas outdated` proves only that it is no longer
  # reported outdated. If its installed version did not change, the receipt
  # must not count or describe an update.
  : >"$update_all_log"
  run_fixture_pty "$update_all_fixture/darwin-mas-no-version-change" \
    "$update_all_fixture/pty-empty-input" env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
    MAS_INSTALLED="$mas_xcode_264" MAS_OUTDATED="$mas_xcode_outdated" \
    MAS_POST_INSTALLED="$mas_xcode_264" \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    || fail "a no-longer-outdated unchanged MAS app failed the honest receipt path"
  grep -qF 'installed version remained 26.4, so no update is claimed' \
    "$update_all_fixture/darwin-mas-no-version-change"
  grep -qF 'Verified updated        0' \
    "$update_all_fixture/darwin-mas-no-version-change"
  grep -qF 'No longer outdated     1' \
    "$update_all_fixture/darwin-mas-no-version-change"
  grep -qF $'mas-app\t497799835\tXcode\t26.4\t26.5\tcommand-succeeded\t0\texited\t26.4\tnot-reported' \
    "$update_all_home/.local/state/groundwork/receipts/update-all-maintenance-latest.tsv"
  rm -f "$update_all_home"/.mas-updated-*

  # A successful command cannot launder a missing or changed post-update app
  # identity into verification.
  : >"$update_all_log"
  mas_missing_post_exit=0
  run_fixture_pty "$update_all_fixture/darwin-mas-missing-post-identity" \
    "$update_all_fixture/pty-empty-input" env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
    MAS_INSTALLED="$mas_xcode_264" MAS_OUTDATED="$mas_xcode_outdated" \
    MAS_POST_INSTALLED='' \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    || mas_missing_post_exit=$?
  [[ "$mas_missing_post_exit" -ne 0 ]] \
    || fail "a missing post-update MAS identity produced a false complete result"
  grep -qF 'lost or changed its installed identity after update' \
    "$update_all_fixture/darwin-mas-missing-post-identity"
  grep -qF $'mas-app\t497799835\tXcode\t26.4\t26.5\tcommand-succeeded\t0\texited\tmissing-or-changed\tunknown' \
    "$update_all_home/.local/state/groundwork/receipts/update-all-maintenance-latest.tsv"
  rm -f "$update_all_home"/.mas-updated-*

  # A visible authorization refusal is isolated to the exact app. No mutation
  # starts, the app is action-required, and later independent lanes continue.
  : >"$update_all_log"
  mas_auth_exit=0
  run_fixture_pty "$update_all_fixture/darwin-mas-auth-refused" \
    "$update_all_fixture/pty-empty-input" env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
    MAS_INSTALLED="$mas_xcode_264" MAS_OUTDATED="$mas_xcode_outdated" \
    SUDO_AUTH_PROMPT=1 SUDO_AUTH_STATUS=1 FAKE_PLATFORM=darwin \
    "$update_all_fixture/darwin-runner" || mas_auth_exit=$?
  [[ "$mas_auth_exit" -ne 0 ]] \
    || fail "refused Mac App Store authorization produced a false complete result"
  grep -qF 'Password:' "$update_all_fixture/darwin-mas-auth-refused"
  grep -qF 'Mac App Store action required: 1' \
    "$update_all_fixture/darwin-mas-auth-refused"
  assert_not_contains '^sudo -n mas update|^mas update' "$update_all_log" \
    "failed authorization reached a Mac App Store mutation"
  grep -qxF 'mise upgrade --minimum-release-age 5d' "$update_all_log" \
    || fail "failed Mac App Store authorization suppressed the independent mise lane"

  # Authorization has its own deadline and owned process group. A silent
  # password helper times out without reaching mas, then the next exact app can
  # authorize and update. The unrelated process and owned-child checks prove
  # the cancellation boundary.
  rm -f "$update_all_home/.mas-auth-count" "$update_all_home/.mas-auth-owned-child" \
    "$update_all_home"/.mas-updated-*
  : >"$update_all_log"
  /bin/sleep 20 &
  mas_auth_unrelated_pid=$!
  mas_auth_timeout_exit=0
  run_fixture_pty "$update_all_fixture/darwin-mas-auth-timeout" \
    "$update_all_fixture/pty-mas-passwords" env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
    GROUNDWORK_TEST_REALTIME_CLOCK=1 \
    GROUNDWORK_MAS_AUTH_DEADLINE_SECONDS=1 \
    MAS_INSTALLED="$mas_installed_both" MAS_OUTDATED="$mas_outdated_both" \
    MAS_POST_INSTALLED="$mas_partial_both" \
    SUDO_AUTH_READ=1 SUDO_AUTH_HANG_ONCE=1 FAKE_PLATFORM=darwin \
    "$update_all_fixture/darwin-runner" || mas_auth_timeout_exit=$?
  [[ "$mas_auth_timeout_exit" -ne 0 ]] \
    || fail "a timed-out authorization produced a false complete result"
  kill -0 "$mas_auth_unrelated_pid" 2>/dev/null \
    || fail "the authorization timeout terminated an unrelated process"
  kill "$mas_auth_unrelated_pid" 2>/dev/null || true
  wait "$mas_auth_unrelated_pid" 2>/dev/null || true
  mas_auth_owned_pid="$(cat "$update_all_home/.mas-auth-owned-child")"
  ! kill -0 "$mas_auth_owned_pid" 2>/dev/null \
    || fail "the authorization timeout left its owned child running"
  assert_not_contains '^mas update 497799835$' "$update_all_log" \
    "timed-out authorization reached the first MAS mutation"
  if ! grep -qxF 'mas update 1593408455' "$update_all_log"; then
    cat "$update_all_fixture/darwin-mas-auth-timeout" >&2
    cat "$update_all_log" >&2
    fail "timed-out authorization suppressed the next exact MAS app"
  fi
  grep -qF 'Mac App Store action required: 1' \
    "$update_all_fixture/darwin-mas-auth-timeout"

  # A literal terminal interrupt while fake sudo is reading its password is
  # delivered to the foreground terminal group. The runner propagates 130,
  # records the exact app, and leaves no owned authorization child behind.
  rm -f "$update_all_home/.mas-auth-count" \
    "$update_all_home/.mas-auth-owned-child" "$update_all_home"/.mas-updated-*
  : >"$update_all_log"
  mas_auth_cancel_exit=0
  run_fixture_pty_after "$update_all_fixture/darwin-mas-auth-cancelled" \
    'Password:' '\x03' env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
    MAS_INSTALLED="$mas_xcode_264" MAS_OUTDATED="$mas_xcode_outdated" \
    SUDO_AUTH_PROMPT=1 SUDO_AUTH_READ=1 SUDO_AUTH_CHILD=1 \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    || mas_auth_cancel_exit=$?
  [[ "$mas_auth_cancel_exit" -eq 130 ]] \
    || fail "foreground sudo cancellation surfaced as $mas_auth_cancel_exit"
  mas_auth_cancelled_child="$(cat "$update_all_home/.mas-auth-owned-child")"
  ! kill -0 "$mas_auth_cancelled_child" 2>/dev/null \
    || fail "foreground sudo cancellation left its owned child running"
  assert_not_contains '^sudo -n mas update|^mas update|^mise upgrade' \
    "$update_all_log" \
    "foreground sudo cancellation continued into later mutation"
  grep -qF $'mas-app\t497799835\tXcode\t26.4\t26.5\tcancelled\t130\tauthorization' \
    "$update_all_home/.local/state/groundwork/receipts/update-all-maintenance-latest.tsv" \
    || fail "foreground sudo cancellation left no exact per-app receipt"

  # Cleanup-uncertain and terminal signal statuses propagate immediately from
  # authorization. They cannot be laundered into action-required continuation.
  for auth_terminal_status in 125 129 130 143; do
    rm -f "$update_all_home/.mas-auth-count" "$update_all_home"/.mas-updated-*
    : >"$update_all_log"
    auth_terminal_exit=0
    run_fixture_pty "$update_all_fixture/darwin-mas-auth-terminal-$auth_terminal_status" \
      "$update_all_fixture/pty-empty-input" env \
      HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
      NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
      BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
      MAS_INSTALLED="$mas_xcode_264" MAS_OUTDATED="$mas_xcode_outdated" \
      SUDO_AUTH_STATUS="$auth_terminal_status" FAKE_PLATFORM=darwin \
      "$update_all_fixture/darwin-runner" || auth_terminal_exit=$?
    [[ "$auth_terminal_exit" -eq "$auth_terminal_status" ]] \
      || fail "authorization status $auth_terminal_status surfaced as $auth_terminal_exit"
    assert_not_contains '^sudo -n mas update|^mas update|^mise upgrade' "$update_all_log" \
      "terminal authorization status $auth_terminal_status continued into later mutation"
    grep -qF $'mas-app\t497799835\tXcode\t26.4\t26.5\tcancelled' \
      "$update_all_home/.local/state/groundwork/receipts/update-all-maintenance-latest.tsv" \
      || fail "terminal authorization status $auth_terminal_status left no durable per-ID receipt"
    grep -qF $'process-status\t'"$auth_terminal_status" \
      "$update_all_home/.local/state/groundwork/receipts/update-all-maintenance-latest.tsv"
  done

  # One hung App Store app owns one bounded process group. Its timeout must not
  # kill an unrelated process or suppress the next exact app, and the receipt
  # must separate attempted, verified, remaining, and timed-out outcomes.
  printf 'previous-success\n' >"$update_all_stamp"
  : >"$update_all_log"
  /bin/sleep 20 &
  mas_unrelated_pid=$!
  mas_timeout_exit=0
  run_fixture_pty "$update_all_fixture/darwin-mas-timeout" \
    "$update_all_fixture/pty-empty-input" env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
    GROUNDWORK_TEST_REALTIME_CLOCK=1 \
    GROUNDWORK_MAS_APP_DEADLINE_SECONDS=1 \
    MAS_INSTALLED="$mas_installed_both" MAS_OUTDATED="$mas_outdated_both" \
    MAS_POST_INSTALLED="$mas_partial_both" \
    MAS_HANG_ID=497799835 FAKE_PLATFORM=darwin \
    "$update_all_fixture/darwin-runner" || mas_timeout_exit=$?
  [[ "$mas_timeout_exit" -ne 0 ]] \
    || fail "a timed-out App Store app produced a false complete result"
  kill -0 "$mas_unrelated_pid" 2>/dev/null \
    || fail "the MAS timeout terminated an unrelated process"
  kill "$mas_unrelated_pid" 2>/dev/null || true
  wait "$mas_unrelated_pid" 2>/dev/null || true
  mas_owned_pid="$(cat "$update_all_home/.mas-owned-child-497799835")"
  ! kill -0 "$mas_owned_pid" 2>/dev/null \
    || fail "the MAS timeout left its owned child process running"
  grep -qxF 'mas update 497799835' "$update_all_log"
  grep -qxF 'mas update 1593408455' "$update_all_log" \
    || fail "one hung App Store app suppressed the next exact app"
  grep -qF 'Mac App Store update: Xcode (ID 497799835; deadline 1s)' \
    "$update_all_fixture/darwin-mas-timeout" \
    || fail "the timed App Store lane omitted its authenticated app identity"
  grep -qF 'Mac App Store attempted: 2' "$update_all_fixture/darwin-mas-timeout"
  grep -qF 'Mac App Store verified updated: 1' "$update_all_fixture/darwin-mas-timeout"
  grep -qF 'Mac App Store remaining: 1' "$update_all_fixture/darwin-mas-timeout"
  grep -qF 'Mac App Store timed out: 1' "$update_all_fixture/darwin-mas-timeout"
  grep -qxF 'previous-success' "$update_all_stamp" \
    || fail "an incomplete MAS lane replaced the prior success timestamp"
  rm -f "$update_all_home"/.mas-updated-* "$update_all_home"/.mas-owned-child-*

  # A non-timeout failure is isolated the same way and remains distinct from a
  # later app that updated and verified successfully.
  : >"$update_all_log"
  mas_partial_exit=0
  run_fixture_pty "$update_all_fixture/darwin-mas-partial-failure" \
    "$update_all_fixture/pty-empty-input" env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
    MAS_INSTALLED="$mas_installed_both" MAS_OUTDATED="$mas_outdated_both" \
    MAS_POST_INSTALLED="$mas_partial_both" \
    MAS_FAIL_ID=497799835 MAS_FAIL_STATUS=17 FAKE_PLATFORM=darwin \
    "$update_all_fixture/darwin-runner" || mas_partial_exit=$?
  [[ "$mas_partial_exit" -ne 0 ]] || fail "a partial MAS failure was reported complete"
  grep -qF 'Mac App Store failed: 1' "$update_all_fixture/darwin-mas-partial-failure"
  grep -qF 'Mac App Store verified updated: 1' \
    "$update_all_fixture/darwin-mas-partial-failure"
  grep -qxF 'mas update 1593408455' "$update_all_log" \
    || fail "a failed App Store app suppressed the next exact app"
  rm -f "$update_all_home"/.mas-updated-*

  # Redirected, CI, and cron-style execution may retain a controlling terminal,
  # but without interactive stdin AND stderr no authorization prompt is safe.
  # Every exact app remains visible/action-required and independent safe lanes
  # continue without invoking sudo or mas mutation.
  printf 'previous-success\n' >"$update_all_stamp"
  : >"$update_all_log"
  mas_noninteractive_exit=0
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    CI=1 NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULA_OUTDATED='' BREW_CASKS='' \
    MAS_INSTALLED="$mas_xcode_264" MAS_OUTDATED="$mas_xcode_outdated" \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    </dev/null >"$update_all_fixture/darwin-mas-noninteractive" \
    2>&1 || mas_noninteractive_exit=$?
  [[ "$mas_noninteractive_exit" -ne 0 ]] \
    || fail "a noninteractive outstanding App Store update produced a false complete result"
  assert_not_contains '^sudo -v$|^sudo -n mas update|^mas update' "$update_all_log" \
    "a noninteractive App Store lane reached authorization or mutation"
  grep -qF 'Mac App Store action required: 1' \
    "$update_all_fixture/darwin-mas-noninteractive"
  grep -qF 'Run interactively: sudo -v && sudo -n mas update 497799835' \
    "$update_all_fixture/darwin-mas-noninteractive"
  grep -qxF 'mise upgrade --minimum-release-age 5d' "$update_all_log" \
    || fail "noninteractive App Store authorization suppressed the independent mise lane"
  grep -qxF 'previous-success' "$update_all_stamp" \
    || fail "an action-required App Store update replaced the prior success timestamp"

  # Sanitized work-laptop journey: Homebrew returns 1 without literal Error
  # output, MAS visibly requests authorization, then one exact app becomes
  # silent long enough to emit an elapsed heartbeat. Its bounded cancellation
  # closes only that owned tree and the next exact MAS app still runs. The
  # retained work-laptop Homebrew log is unavailable on this personal machine,
  # so this proves diagnostics and isolation only; it does not diagnose or
  # close the original Homebrew root cause.
  printf 'previous-success\n' >"$update_all_stamp"
  : >"$update_all_log"
  rm -f "$update_all_home"/.mas-updated-* "$update_all_home"/.mas-owned-child-*
  /bin/sleep 120 &
  combined_unrelated_pid=$!
  combined_exit=0
  run_fixture_pty "$update_all_fixture/work-laptop-sanitized" \
    "$update_all_fixture/pty-empty-input" env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_FORMULAE='git' BREW_FORMULA_OUTDATED='git' BREW_CASKS='' BREW_UPGRADE_STATUS=1 \
    GROUNDWORK_TEST_REALTIME_CLOCK=1 \
    GROUNDWORK_MAS_APP_DEADLINE_SECONDS=16 \
    MAS_INSTALLED="$mas_installed_both" MAS_OUTDATED="$mas_outdated_both" \
    MAS_POST_INSTALLED="$mas_partial_both" \
    MAS_HANG_ID=497799835 SUDO_AUTH_PROMPT=1 FAKE_PLATFORM=darwin \
    "$update_all_fixture/darwin-runner" || combined_exit=$?
  [[ "$combined_exit" -ne 0 ]] \
    || fail "the sanitized work-laptop partial failure produced a false complete result"
  kill -0 "$combined_unrelated_pid" 2>/dev/null \
    || fail "the sanitized MAS cancellation terminated an unrelated process"
  kill "$combined_unrelated_pid" 2>/dev/null || true
  wait "$combined_unrelated_pid" 2>/dev/null || true
  combined_owned_pid="$(cat "$update_all_home/.mas-owned-child-497799835")"
  ! kill -0 "$combined_owned_pid" 2>/dev/null \
    || fail "the sanitized MAS cancellation left its owned child running"
  grep -qF 'Errors: 1 authoritative command failure' \
    "$update_all_fixture/work-laptop-sanitized"
  grep -qF 'Failed sub-lane: Homebrew formula upgrade (exit 1)' \
    "$update_all_fixture/work-laptop-sanitized"
  grep -qF 'Failed exact package token(s): git' \
    "$update_all_fixture/work-laptop-sanitized"
  grep -qF '(Homebrew produced no output.)' "$update_all_fixture/work-laptop-sanitized"
  assert_not_contains 'Errors: none observed' "$update_all_fixture/work-laptop-sanitized" \
    "a silent Homebrew exit 1 still produced a false no-error receipt"
  grep -qF 'Password:' "$update_all_fixture/work-laptop-sanitized" \
    || fail "the sanitized MAS journey omitted its visible authentication request"
  grep -qF 'Still running: Mac App Store update for Xcode (ID 497799835)' \
    "$update_all_fixture/work-laptop-sanitized" \
    || fail "the silent MAS journey omitted exact authenticated elapsed progress"
  grep -qF 'Mac App Store timed out: 1' "$update_all_fixture/work-laptop-sanitized"
  grep -qxF 'mas update 1593408455' "$update_all_log" \
    || fail "the silent MAS timeout suppressed the next exact App Store app"
  grep -qxF 'previous-success' "$update_all_stamp" \
    || fail "the sanitized partial failure replaced the prior success timestamp"
  rm -f "$update_all_home"/.mas-updated-* "$update_all_home"/.mas-owned-child-*
  install_fixture_watchdog_runner \
    "$update_all_home/.local/share/groundwork/lib/maintenance-runner.sh"

  printf 'previous-success\n' >"$update_all_stamp"
  : >"$update_all_log"
  mas_foreign_exit=0
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    MAS_INSTALLED="$mas_xcode_264" MAS_OUTDATED="$mas_anybox_outdated" \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-mas-foreign-id" 2>&1 || mas_foreign_exit=$?
  [[ "$mas_foreign_exit" -eq 1 ]] \
    || fail "a Mac App Store ID outside the installed inventory surfaced as exit $mas_foreign_exit"
  assert_not_contains '^mas update' "$update_all_log" \
    "a Mac App Store ID outside the installed inventory reached mutation"
  grep -qF "outside the exact installed ID set" \
    "$update_all_fixture/darwin-mas-foreign-id" \
    || fail "the Mac App Store ownership mismatch was not actionable"
  grep -qxF 'previous-success' "$update_all_stamp" \
    || fail "an untrusted Mac App Store observation replaced the prior success timestamp"

  printf 'previous-success\n' >"$update_all_stamp"
  : >"$update_all_log"
  rm -f "$update_all_home/.brew-updated-tokens"
  remaining_exit=0
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_REMAIN_OUTDATED_TOKENS=git BREW_FORMULA_OUTDATED=git \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-managed-remains-outdated" 2>&1 || remaining_exit=$?
  [[ "$remaining_exit" -eq 1 ]] \
    || fail "a managed item remaining outdated surfaced as exit $remaining_exit"
  grep -qF 'Homebrew still reports git outdated' \
    "$update_all_fixture/darwin-managed-remains-outdated" \
    || fail "the post-update completeness check omitted the remaining managed item"
  grep -qF 'Homebrew attempted: 2 exact eligible item(s)' \
    "$update_all_fixture/darwin-managed-remains-outdated" || {
    sed -n '1,220p' "$update_all_fixture/darwin-managed-remains-outdated" >&2
    fail "the incomplete update receipt omitted the exact attempted count"
  }
  grep -qF 'Homebrew verified updated: 1' \
    "$update_all_fixture/darwin-managed-remains-outdated" \
    || fail "an item that remained outdated was counted as verified updated"
  assert_not_contains 'Homebrew verified updated:[[:space:]]+2' \
    "$update_all_fixture/darwin-managed-remains-outdated" \
    "upgrade exit zero was mistaken for two verified updates"
  grep -qxF 'previous-success' "$update_all_stamp" \
    || fail "a false incomplete update replaced the prior success timestamp"
  grep -qF 'eligible Homebrew item(s) remained outdated' \
    "$update_all_home/.local/state/groundwork/update-all-pending/homebrew-upgrade" \
    || fail "remaining managed items did not leave a bounded retry record"
  rm -rf "$update_all_home/.local/state/groundwork/update-all-pending"

  # Exact work-laptop regression: a vendor/manual ChatGPT bundle is present on
  # a work profile while Homebrew owns other software. It must be reported and
  # omitted from the Brewfile apply, but every safe managed lane still runs.
  # Ownership review is a successful-but-actionable receipt, not updater failure.
  manual_apps="$update_all_fixture/Work Applications"
  manual_chatgpt="$manual_apps/ChatGPT.app"
  mkdir -p "$manual_chatgpt/Contents/MacOS"
  manual_apps="$(cd "$manual_apps" && pwd -P)"
  manual_chatgpt="$manual_apps/ChatGPT.app"
  : >"$manual_chatgpt/Contents/Info.plist"
  : >"$manual_chatgpt/Contents/MacOS/ChatGPT"
  mkdir -p "$manual_apps/ChatGPT Classic.app/Contents/MacOS"
  : >"$manual_apps/ChatGPT Classic.app/Contents/Info.plist"
  : >"$manual_apps/ChatGPT Classic.app/Contents/MacOS/ChatGPT"
  printf 'previous-success\n' >"$update_all_stamp"
  : >"$update_all_log"
  manual_exit=0
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    GROUNDWORK_APPLICATIONS_DIR="$manual_apps" BREW_CASKS='ghostty' \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-work-runner" \
    >"$update_all_fixture/darwin-work-manual-chatgpt" 2>&1 || manual_exit=$?
  [[ "$manual_exit" -eq 0 ]] \
    || fail "manual ChatGPT on a work profile surfaced as exit $manual_exit instead of action-required"
  grep -qF 'ChatGPT.app is installed but not package-manager-owned' \
    "$update_all_fixture/darwin-work-manual-chatgpt" \
    || fail "the exact work-laptop manual ChatGPT case was silent"
  grep -qF "Path:          $manual_chatgpt" \
    "$update_all_fixture/darwin-work-manual-chatgpt" \
    || fail "the manual ChatGPT receipt omitted its exact application path"
  grep -qF 'Review interactively: groundwork-app-adopt chatgpt' \
    "$update_all_fixture/darwin-work-manual-chatgpt" \
    || fail "noninteractive update-all omitted the safe ChatGPT adoption route"
  assert_not_contains 'Remove ChatGPT Classic[.]app while preserving shared data' \
    "$update_all_fixture/darwin-work-manual-chatgpt" \
    "Classic removal was offered before current ChatGPT ownership was verified"
  grep -qxF 'chezmoi skip-casks=chatgpt' "$update_all_log" \
    || fail "manual ChatGPT was not omitted from the conflicting Brewfile apply"
  grep -qxF 'brew upgrade --formula git auto=1 casks=unset hb-color=unset' \
    "$update_all_log" \
    || fail "manual ChatGPT prevented an unrelated managed formula update"
  grep -qxF 'brew upgrade --cask --require-sha --no-quit ghostty auto=1 casks=unset hb-color=unset' \
    "$update_all_log" \
    || fail "manual ChatGPT prevented an unrelated managed cask update"
  grep -qxF 'mise upgrade --minimum-release-age 5d' "$update_all_log" \
    || fail "manual ChatGPT prevented the later managed runtime lane"
  assert_not_contains '^groundwork-app-(adopt|remove)|brew install .*--adopt|brew uninstall' "$update_all_log" \
    "update-all invoked a separate ownership or removal command"
  grep -qF 'Application ownership  2 manual/MDM-unresolved item(s) named above' \
    "$update_all_fixture/darwin-work-manual-chatgpt" \
    || fail "the manual/current and Classic application choices were absent from the final review receipt"
  grep -qF 'SUCCESS · 2 OWNER-REVIEW ITEM(S)' \
    "$update_all_fixture/darwin-work-manual-chatgpt" \
    || fail "manual and Classic application choices were conflated with updater failure"
  grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T' "$update_all_stamp" \
    || fail "a completed update with ownership review did not refresh the success timestamp"

  # Interactive actions run only after the transaction lock is released. A
  # literal yes adopts current ChatGPT first, re-observes Homebrew ownership,
  # then offers the separate Classic-to-Trash action. The helper stubs fail if
  # either the lock directory or inherited lock token still exists.
  rm -f "$update_all_home/.chatgpt-adopted"
  mkdir -p "$update_all_home/.Trash"
  : >"$update_all_log"
  awk '/groundwork_interactive_tty_available=0/ { found=1 } found { print }' \
    "$update_all_fixture/darwin-work-runner" \
    >"$update_all_fixture/action-center-render"
  assert_not_contains 'GROUNDWORK_PROMPT_TTY|/dev/tty' \
    "$update_all_fixture/action-center-render" \
    "the post-update action center retained a file-backed prompt path"
  run_fixture_pty_after "$update_all_fixture/darwin-chatgpt-actions" \
    'Let Homebrew manage ChatGPT.app? [y/N]' 'yes\nyes\n' env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    GROUNDWORK_APPLICATIONS_DIR="$manual_apps" BREW_FORMULAE='' BREW_CASKS='ghostty' \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-work-runner" \
    || fail "the consent-gated ChatGPT action sequence failed"
  grep -qF 'Let Homebrew manage ChatGPT.app? [y/N]' \
    "$update_all_fixture/darwin-chatgpt-actions"
  grep -qF 'Remove ChatGPT Classic.app while preserving shared data? [y/N]' \
    "$update_all_fixture/darwin-chatgpt-actions"
  grep -qxF 'app-adopt --check chatgpt' "$update_all_log"
  grep -qxF 'app-adopt --yes chatgpt' "$update_all_log"
  grep -qxF 'app-remove --check chatgpt-classic' "$update_all_log"
  grep -qxF 'app-remove --yes chatgpt-classic' "$update_all_log"
  test -f "$update_all_home/.chatgpt-adopted" \
    || fail "accepted ChatGPT adoption did not establish fixture ownership"
  test ! -e "$manual_apps/ChatGPT Classic.app" \
    || fail "accepted Classic cleanup did not move the verified bundle"
  test -d "$update_all_home/.Trash/ChatGPT Classic.app" \
    || fail "accepted Classic cleanup was not recoverable through Trash"
  grep -qF $'process-status\t0' \
    "$update_all_home/.local/state/groundwork/receipts/update-all-maintenance-latest.tsv" \
    || fail "successful maintenance left no independent durable receipt"
  grep -qF $'chatgpt-adoption\tcompleted\thomebrew-owned' \
    "$update_all_home/.local/state/groundwork/receipts/update-all-actions-latest.tsv"
  grep -qF $'chatgpt-classic-removal\tcompleted\tmoved-or-uninstalled' \
    "$update_all_home/.local/state/groundwork/receipts/update-all-actions-latest.tsv"
  maintenance_receipt_latest="$update_all_home/.local/state/groundwork/receipts/update-all-maintenance-latest.tsv"
  action_receipt_latest="$update_all_home/.local/state/groundwork/receipts/update-all-actions-latest.tsv"
  maintenance_invocation="$(awk -F '\t' '$1 == "invocation-id" { print $2; exit }' \
    "$maintenance_receipt_latest")"
  action_invocation="$(awk -F '\t' '$1 == "invocation-id" { print $2; exit }' \
    "$action_receipt_latest")"
  [[ -n "$maintenance_invocation" && "$action_invocation" == "$maintenance_invocation" ]] \
    || fail "maintenance and action receipts were not bound to one invocation ID"
  bound_maintenance_name="$(awk -F '\t' '$1 == "maintenance-receipt" { print $2; exit }' \
    "$action_receipt_latest")"
  bound_maintenance_digest="$(awk -F '\t' '$1 == "maintenance-sha256" { print $2; exit }' \
    "$action_receipt_latest")"
  bound_maintenance_path="$update_all_home/.local/state/groundwork/receipts/$bound_maintenance_name"
  [[ "$bound_maintenance_name" == "update-all-maintenance-$maintenance_invocation.tsv" \
    && -f "$bound_maintenance_path" ]] \
    || fail "the action receipt did not name its immutable maintenance receipt"
  [[ "$(shasum -a 256 "$bound_maintenance_path" | awk '{print $1}')" \
    == "$bound_maintenance_digest" ]] \
    || fail "the action receipt did not bind the exact maintenance receipt digest"
  cmp -s "$maintenance_receipt_latest" "$bound_maintenance_path" \
    || fail "latest maintenance truth drifted from the invocation-bound receipt"

  # Decline is the default and a failed adoption suppresses every Classic
  # removal action. Neither route may run automatically.
  mv "$update_all_home/.Trash/ChatGPT Classic.app" \
    "$manual_apps/ChatGPT Classic.app"
  rm -f "$update_all_home/.chatgpt-adopted"
  : >"$update_all_log"
  run_fixture_pty_after "$update_all_fixture/darwin-chatgpt-declined" \
    'Let Homebrew manage ChatGPT.app? [y/N]' '\n' env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    GROUNDWORK_APPLICATIONS_DIR="$manual_apps" BREW_FORMULAE='' BREW_CASKS='ghostty' \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-work-runner" \
    || fail "declining ChatGPT adoption failed the completed updater"
  grep -qxF 'app-adopt --check chatgpt' "$update_all_log" \
    || fail "the action center prompted without a fresh adoption eligibility check"
  assert_not_contains '^app-adopt --yes|^app-remove' "$update_all_log" \
    "the default-no action center invoked a mutating helper"
  : >"$update_all_log"
  action_failed_exit=0
  run_fixture_pty_after "$update_all_fixture/darwin-chatgpt-adoption-failed" \
    'Let Homebrew manage ChatGPT.app? [y/N]' 'yes\nyes\n' env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    GROUNDWORK_APPLICATIONS_DIR="$manual_apps" BREW_FORMULAE='' BREW_CASKS='ghostty' \
    ACTION_ADOPT_STATUS=17 FAKE_PLATFORM=darwin \
    "$update_all_fixture/darwin-work-runner" || action_failed_exit=$?
  [[ "$action_failed_exit" -eq 17 ]] \
    || fail "a requested ChatGPT adoption failure surfaced as $action_failed_exit"
  grep -qF 'Maintenance: succeeded' \
    "$update_all_fixture/darwin-chatgpt-adoption-failed" \
    || fail "a failed optional action retroactively obscured successful maintenance"
  grep -qF 'Requested action: failed (exit 17)' \
    "$update_all_fixture/darwin-chatgpt-adoption-failed" \
    || fail "the optional action failure was not reported separately"
  grep -qF $'process-status\t0' \
    "$update_all_home/.local/state/groundwork/receipts/update-all-maintenance-latest.tsv" \
    || fail "an optional action failure rewrote the maintenance receipt"
  grep -qF $'chatgpt-adoption\tfailed\t17' \
    "$update_all_home/.local/state/groundwork/receipts/update-all-actions-latest.tsv"
  grep -qF $'process-status\t17' \
    "$update_all_home/.local/state/groundwork/receipts/update-all-actions-latest.tsv"
  grep -qxF 'app-adopt --check chatgpt' "$update_all_log"
  grep -qxF 'app-adopt --yes chatgpt' "$update_all_log"
  assert_not_contains '^app-remove' "$update_all_log" \
    "failed ChatGPT adoption still offered or invoked Classic removal"
  test -d "$manual_apps/ChatGPT Classic.app" \
    || fail "failed ChatGPT adoption changed Classic"

  : >"$update_all_log"
  run_fixture_pty "$update_all_fixture/darwin-chatgpt-adoption-check-failed" \
    "$update_all_fixture/pty-empty-input" env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    GROUNDWORK_APPLICATIONS_DIR="$manual_apps" BREW_FORMULAE='' BREW_CASKS='ghostty' \
    ACTION_ADOPT_CHECK_STATUS=18 FAKE_PLATFORM=darwin \
    "$update_all_fixture/darwin-work-runner" \
    || fail "an ineligible ChatGPT adoption failed otherwise completed maintenance"
  grep -qxF 'app-adopt --check chatgpt' "$update_all_log"
  assert_not_contains '^app-adopt --yes|^app-remove' "$update_all_log" \
    "failed ChatGPT eligibility still reached adoption or Classic removal"

  : >"$update_all_log"
  action_receipt_failure_exit=0
  run_fixture_pty_after "$update_all_fixture/darwin-action-receipt-failure" \
    'Let Homebrew manage ChatGPT.app? [y/N]' '\n' env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    GROUNDWORK_APPLICATIONS_DIR="$manual_apps" BREW_FORMULAE='' BREW_CASKS='ghostty' \
    FAIL_ACTION_RECEIPT_CP=1 FAKE_PLATFORM=darwin \
    "$update_all_fixture/darwin-work-runner" || action_receipt_failure_exit=$?
  [[ "$action_receipt_failure_exit" -eq 1 ]] \
    || fail "action-receipt publication failure surfaced as $action_receipt_failure_exit"
  grep -qF 'durable post-update action receipt could not be published' \
    "$update_all_fixture/darwin-action-receipt-failure" \
    || fail "action-receipt publication failure was not explicit"
  assert_not_contains '^app-adopt --yes|^app-remove' "$update_all_log" \
    "receipt publication failure followed an unapproved optional mutation"
  rm -rf "$manual_apps"

  # A cancelled Homebrew upgrade must end the transaction, not fall through into
  # repair, refetch, and a retry. Those all prompt or start more Homebrew work
  # against a terminal the person just asked to have back, which is the field
  # failure this whole path exists to prevent. 124 is the hard deadline, 125 a
  # cancellation that could not be confirmed, 129/130/143 HUP/INT/TERM.
  for cancel_status in 124 125 129 130 143; do
    rm -f "$update_all_stamp"
    # Clear the pending record BEFORE each case so one iteration's marker can
    # never satisfy the next iteration's assertion.
    rm -rf "$update_all_home/.local/state/groundwork/update-all-pending"
    : >"$update_all_log"
    cancel_output="$update_all_fixture/darwin-cancel-$cancel_status"
    cancel_exit=0
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
      NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
      BREW_UPGRADE_STATUS="$cancel_status" \
      FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
      >"$cancel_output" 2>&1 || cancel_exit=$?
    [[ "$cancel_exit" -eq "$cancel_status" ]] \
      || fail "a Homebrew upgrade cancelled with $cancel_status surfaced as exit $cancel_exit"
    assert_not_contains '^brew-repair$' "$update_all_log" \
      "a cancelled Homebrew upgrade ($cancel_status) still ran the repair prompt"
    assert_not_contains '^brew-refetch$' "$update_all_log" \
      "a cancelled Homebrew upgrade ($cancel_status) still re-fetched artifacts"
    assert_not_contains 'Homebrew upgrade retry' "$update_all_log" \
      "a cancelled Homebrew upgrade ($cancel_status) still retried the upgrade"
    assert_not_contains '^(mise upgrade|brew autoremove|brew cleanup|docker-tidy)' \
      "$update_all_log" \
      "a cancelled Homebrew upgrade ($cancel_status) continued into later stages"
    grep -qF 'cancelled' "$cancel_output" \
      || fail "a cancelled Homebrew upgrade ($cancel_status) did not say so"
    test ! -f "$update_all_stamp" \
      || fail "a cancelled Homebrew upgrade ($cancel_status) recorded a successful refresh"
    grep -qF 'did not complete' \
      "$update_all_home/.local/state/groundwork/update-all-pending/homebrew-upgrade" \
      || fail "a cancelled Homebrew upgrade ($cancel_status) left no pending-repair record"
  done

  # The retry lane needs the same guard. A first attempt that merely FAILS is
  # allowed to reach repair and retry; the retry itself being cancelled must end
  # the transaction there, not continue into later stages.
  for cancel_status in 124 125 130; do
    rm -f "$update_all_stamp" "$update_all_home/.brew-upgrade-count"
    rm -rf "$update_all_home/.local/state/groundwork/update-all-pending"
    : >"$update_all_log"
    retry_output="$update_all_fixture/darwin-retry-cancel-$cancel_status"
    retry_exit=0
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
      NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
      BREW_FORMULA_OUTDATED='' \
      BREW_UPGRADE_STATUS_SEQUENCE="1 $cancel_status" REPAIR_STATUS=0 \
      FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
      >"$retry_output" 2>&1 || retry_exit=$?
    [[ "$retry_exit" -eq "$cancel_status" ]] \
      || fail "a cancelled Homebrew upgrade RETRY ($cancel_status) surfaced as exit $retry_exit"
    grep -cxF 'brew-repair' "$update_all_log" | grep -qx 1 \
      || fail "the cancelled retry case did not run repair exactly once before retrying"
    assert_not_contains '^(mise upgrade|brew autoremove|brew cleanup|docker-tidy)' \
      "$update_all_log" \
      "a cancelled Homebrew upgrade retry ($cancel_status) continued into later stages"
    test ! -f "$update_all_stamp" \
      || fail "a cancelled Homebrew upgrade retry ($cancel_status) recorded a successful refresh"
    grep -qF 'did not complete' \
      "$update_all_home/.local/state/groundwork/update-all-pending/homebrew-upgrade" \
      || fail "a cancelled Homebrew upgrade retry ($cancel_status) left no pending-repair record"
  done
  rm -f "$update_all_home/.brew-upgrade-count"
  rm -rf "$update_all_home/.local/state/groundwork/update-all-pending"

  # The Brewfile install hook runs the same attached Homebrew stage as the
  # upgrade lane, so it owes the same proof. Render it against this fixture home
  # and actually RUN it: an ordering assertion can show the guard sits above the
  # repair call, but only an execution shows that a cancelled bundle stops.
  # The hook runs UNMODIFIED. GROUNDWORK_BREW_BIN is its explicit seam for
  # selecting a controlled Homebrew; without it the hook would pick the
  # machine's real one. Every case below asserts the stub is what answered.
  render darwin false arm64 home/run_onchange_after_10-brew-bundle.sh.tmpl \
    "$update_all_fixture/darwin-bundle-hook"
  chmod +x "$update_all_fixture/darwin-bundle-hook"
  # The browser lane runs after a successful bundle and needs its own manifest.
  cat >"$update_all_home/.config/homebrew/Brewfile.browser" <<'EOF'
cask "google-chrome"
EOF
  for cancel_status in 124 125 129 130 143; do
    rm -f "$update_all_home/.brew-bundle-count"
    : >"$update_all_log"
    bundle_output="$update_all_fixture/darwin-bundle-cancel-$cancel_status"
    bundle_exit=0
    HOME="$update_all_home" PATH="$update_all_bin:$update_all_path" \
      GROUNDWORK_TEST_LOG="$update_all_log" \
      NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
      GROUNDWORK_BREW_BIN="$update_all_bin/brew" \
      BREW_BUNDLE_STATUS="$cancel_status" REPAIR_STATUS=0 \
      "$update_all_fixture/darwin-bundle-hook" >"$bundle_output" 2>&1 || bundle_exit=$?
    [[ "$bundle_exit" -eq "$cancel_status" ]] \
      || fail "a Homebrew bundle cancelled with $cancel_status surfaced as exit $bundle_exit"
    grep -qxF 'brew-shellenv' "$update_all_log" \
      || fail "the cancelled bundle case took its environment from the machine's real Homebrew, not the fixture stub"
    grep -qxF 'brew-bundle' "$update_all_log" \
      || fail "the cancelled bundle case never reached brew bundle"
    assert_not_contains '^brew-repair$' "$update_all_log" \
      "a cancelled Homebrew bundle ($cancel_status) still ran the repair prompt"
    assert_not_contains '^brew-refetch$' "$update_all_log" \
      "a cancelled Homebrew bundle ($cancel_status) still re-fetched artifacts"
    assert_not_contains '^apps-start$' "$update_all_log" \
      "a cancelled Homebrew bundle ($cancel_status) continued into app relaunch"
    [[ "$(grep -cxF 'brew-bundle' "$update_all_log")" -eq 1 ]] \
      || fail "a cancelled Homebrew bundle ($cancel_status) retried the bundle"
    grep -qF 'cancelled' "$bundle_output" \
      || fail "a cancelled Homebrew bundle ($cancel_status) did not say so"
  done

  # The retry lane too: a first attempt that merely FAILS may reach repair and
  # retry, but a cancelled retry must stop there.
  for cancel_status in 124 125 130; do
    rm -f "$update_all_home/.brew-bundle-count"
    : >"$update_all_log"
    bundle_output="$update_all_fixture/darwin-bundle-retry-cancel-$cancel_status"
    bundle_exit=0
    HOME="$update_all_home" PATH="$update_all_bin:$update_all_path" \
      GROUNDWORK_TEST_LOG="$update_all_log" \
      NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
      GROUNDWORK_BREW_BIN="$update_all_bin/brew" \
      BREW_BUNDLE_STATUS_SEQUENCE="1 $cancel_status" REPAIR_STATUS=0 \
      "$update_all_fixture/darwin-bundle-hook" >"$bundle_output" 2>&1 || bundle_exit=$?
    [[ "$bundle_exit" -eq "$cancel_status" ]] \
      || fail "a cancelled Homebrew bundle RETRY ($cancel_status) surfaced as exit $bundle_exit"
    grep -qxF 'brew-shellenv' "$update_all_log" \
      || fail "the cancelled bundle retry case did not run against the fixture stub"
    [[ "$(grep -cxF 'brew-repair' "$update_all_log")" -eq 1 ]] \
      || fail "the cancelled bundle retry case did not run repair exactly once before retrying"
    [[ "$(grep -cxF 'brew-bundle' "$update_all_log")" -eq 2 ]] \
      || fail "the cancelled bundle retry case did not retry the bundle exactly once"
    assert_not_contains '^apps-start$' "$update_all_log" \
      "a cancelled Homebrew bundle retry ($cancel_status) continued into app relaunch"
  done

  # Control: an ORDINARY bundle failure must still reach repair and retry. The
  # guard has to be selective about cancellation, not a blanket early exit.
  rm -f "$update_all_home/.brew-bundle-count"
  : >"$update_all_log"
  bundle_exit=0
  HOME="$update_all_home" PATH="$update_all_bin:$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    GROUNDWORK_BREW_BIN="$update_all_bin/brew" \
    BREW_BUNDLE_STATUS_SEQUENCE="1 0" REPAIR_STATUS=0 \
    "$update_all_fixture/darwin-bundle-hook" \
    >"$update_all_fixture/darwin-bundle-ordinary-failure" 2>&1 || bundle_exit=$?
  [[ "$bundle_exit" -eq 0 ]] \
    || fail "an ordinary bundle failure repaired and retried but still exited $bundle_exit"
  grep -qxF 'brew-shellenv' "$update_all_log" \
    || fail "the ordinary bundle failure case did not run against the fixture stub"
  grep -qxF 'brew-repair' "$update_all_log" \
    || fail "an ordinary bundle failure skipped the repair helper"
  [[ "$(grep -cxF 'brew-bundle' "$update_all_log")" -eq 2 ]] \
    || fail "an ordinary bundle failure did not retry after a successful repair"
  rm -f "$update_all_home/.brew-bundle-count"

  cp "$update_all_home/.config/homebrew/Brewfile" \
    "$update_all_fixture/Brewfile.before-manual-skip"
  cat >"$update_all_home/.config/homebrew/Brewfile" <<'EOF'
brew "git"
cask "chatgpt"
cask "ghostty"
EOF
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_bin:$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" GROUNDWORK_BREW_BIN="$update_all_bin/brew" \
    GROUNDWORK_BREWFILE_SKIP_CASKS=chatgpt \
    BREW_BUNDLE_CAPTURE_FILE="$update_all_fixture/Brewfile.filtered" \
    "$update_all_fixture/darwin-bundle-hook" \
    >"$update_all_fixture/darwin-bundle-manual-skip" 2>&1 \
    || fail "the exact manual-app Brewfile omission failed"
  assert_not_contains '^cask "chatgpt"$' "$update_all_fixture/Brewfile.filtered" \
    "manual ChatGPT remained in the mutating Brewfile input"
  grep -qxF 'cask "ghostty"' "$update_all_fixture/Brewfile.filtered" \
    || fail "the manual-app omission removed an unrelated cask"
  grep -qxF 'cask "chatgpt"' "$update_all_home/.config/homebrew/Brewfile" \
    || fail "the temporary manual-app omission rewrote the managed Brewfile"
  bundle_count_before="$(grep -cxF 'brew-bundle' "$update_all_log")"
  if HOME="$update_all_home" PATH="$update_all_bin:$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" GROUNDWORK_BREW_BIN="$update_all_bin/brew" \
    GROUNDWORK_BREWFILE_SKIP_CASKS=$'chatgpt\nbad;token' \
    "$update_all_fixture/darwin-bundle-hook" \
    >"$update_all_fixture/darwin-bundle-hostile-skip" 2>&1; then
    fail "the Brewfile hook accepted a malformed cask-skip token"
  fi
  [[ "$(grep -cxF 'brew-bundle' "$update_all_log")" -eq "$bundle_count_before" ]] \
    || fail "a malformed cask-skip token reached Homebrew bundle"
  mv "$update_all_fixture/Brewfile.before-manual-skip" \
    "$update_all_home/.config/homebrew/Brewfile"

  # The production Docker Desktop transcript stopped after Homebrew entered its
  # privileged launchctl teardown. A cask that owns its updater or removes
  # privileged helpers is therefore review-only in update-all: the exact token
  # never reaches the automatic brew upgrade command, while an ordinary cask
  # from the same managed set still does.
  cp "$update_all_home/.config/homebrew/Brewfile" \
    "$update_all_fixture/Brewfile.before-privileged-cask"
  cat >"$update_all_home/.config/homebrew/Brewfile" <<'EOF'
brew "git"
cask "ghostty"
cask "docker-desktop"
EOF
  rm -f "$update_all_stamp"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    BREW_CASKS='ghostty docker-desktop' \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-privileged-cask-review" 2>&1 \
    || fail "a review-only privileged cask failed the otherwise safe update"
  grep -qxF 'brew upgrade --cask --require-sha --no-quit ghostty auto=1 casks=unset hb-color=unset' \
    "$update_all_log" \
    || fail "the safe cask did not retain its automatic update lane"
  assert_not_contains '^brew upgrade .*docker-desktop' "$update_all_log" \
    "Docker Desktop entered automatic privileged replacement"
  grep -qF 'docker-desktop 4.85.0,235549 -> 4.86.0,236216 was not upgraded automatically (self-updating+privileged-replacement)' \
    "$update_all_fixture/darwin-privileged-cask-review" \
    || fail "the Docker Desktop review omitted the exact observed versions and reason"
  grep -qF 'Quit it if running, then run: brew upgrade --cask --require-sha docker-desktop' \
    "$update_all_fixture/darwin-privileged-cask-review" \
    || fail "the Docker Desktop review omitted owner-run recovery"
  grep -qF 'Homebrew casks          1 unresolved/privileged item(s) named above' \
    "$update_all_fixture/darwin-privileged-cask-review" \
    || fail "the final receipt omitted the deferred privileged cask"
  grep -qF 'SUCCESS · 1 OWNER-REVIEW ITEM(S)' \
    "$update_all_fixture/darwin-privileged-cask-review" \
    || fail "a safe privileged-cask deferral was not summarized as owner review"
  test -f "$update_all_stamp" \
    || fail "a safe privileged-cask deferral withheld an otherwise complete update"
  mv "$update_all_fixture/Brewfile.before-privileged-cask" \
    "$update_all_home/.config/homebrew/Brewfile"

  # Missing or malformed metadata fails before brew upgrade, preserves the old
  # success timestamp, and cannot silently widen the candidate set.
  printf 'previous-success\n' >"$update_all_stamp"
  rm -f "$update_all_home"/.mas-updated-*
  : >"$update_all_log"
  update_all_status=0
  run_fixture_pty "$update_all_fixture/darwin-cask-metadata-failure" \
    "$update_all_fixture/pty-empty-input" env \
    HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin BREW_CASK_INFO_STATUS=19 \
    MAS_INSTALLED="$mas_xcode_264" MAS_OUTDATED="$mas_xcode_outdated" \
    "$update_all_fixture/darwin-runner" || update_all_status=$?
  [[ "$update_all_status" -ne 0 ]] \
    || fail "a failed cask metadata observation was reported as success"
  assert_not_contains '^brew upgrade' "$update_all_log" \
    "update-all mutated packages after cask metadata became unknown"
  grep -qxF 'mas update 497799835' "$update_all_log" \
    || fail "Homebrew inventory failure suppressed the independent App Store lane"
  grep -qxF 'mise upgrade --minimum-release-age 5d' "$update_all_log" \
    || fail "Homebrew inventory failure suppressed the independent mise lane"
  assert_not_contains 'brew autoremove|brew cleanup|docker-tidy' "$update_all_log" \
    "Homebrew inventory failure continued into later mutating maintenance"
  grep -qF 'no cask upgrade was attempted' \
    "$update_all_fixture/darwin-cask-metadata-failure"
  grep -qxF 'previous-success' "$update_all_stamp"
  rm -f "$update_all_home"/.mas-updated-*

  # An interrupted/half-installed cask can quit the old app successfully, find
  # an unexpected app inside the old Caskroom, emit Error:, then purge the new
  # version. The Homebrew child status remains authoritative through the output
  # classifier. The receipt names the error and cask separately from warnings,
  # withholds the success timestamp, records a retry, and offers only owner-run
  # recovery without --zap or an automatic force removal.
  cp "$update_all_home/.config/homebrew/Brewfile" \
    "$update_all_fixture/Brewfile.before-caskroom-collision"
  cat >"$update_all_home/.config/homebrew/Brewfile" <<'EOF'
brew "git"
cask "bitwarden"
EOF
  printf 'previous-success\n' >"$update_all_stamp"
  rm -rf "$update_all_home/.local/state/groundwork/update-all-pending"
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin BREW_CASKROOM_COLLISION=1 BREW_STAGE_STATUS=17 \
    "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-caskroom-collision" 2>&1
  update_all_status=$?
  set -e
  mv "$update_all_fixture/Brewfile.before-caskroom-collision" \
    "$update_all_home/.config/homebrew/Brewfile"
  if [[ "$update_all_status" -ne 17 ]]; then
    sed -n '1,200p' "$update_all_fixture/darwin-caskroom-collision" >&2
    fail "a Caskroom collision changed Homebrew status 17 to $update_all_status"
  fi
  grep -qF 'Result: failed (exit 17)' \
    "$update_all_fixture/darwin-caskroom-collision" \
    || fail "the Caskroom collision omitted the authoritative failed result"
  grep -qF 'Errors: 1 preserved above' \
    "$update_all_fixture/darwin-caskroom-collision" \
    || fail "the Caskroom collision was not counted separately from warnings"
  grep -qF 'Failed cask: bitwarden' \
    "$update_all_fixture/darwin-caskroom-collision" \
    || fail "the Caskroom collision did not name bitwarden"
  grep -qF 'brew remove --force --cask bitwarden' \
    "$update_all_fixture/darwin-caskroom-collision" \
    || fail "the Caskroom collision omitted owner-run force-remove recovery"
  grep -qF 'brew install --cask bitwarden' \
    "$update_all_fixture/darwin-caskroom-collision" \
    || fail "the Caskroom collision omitted owner-run reinstall recovery"
  grep -qF 'brew list --cask --versions bitwarden' \
    "$update_all_fixture/darwin-caskroom-collision" \
    || fail "the Caskroom collision omitted post-repair verification"
  grep -qF "Error: bitwarden: It seems there is already an App at '/opt/homebrew/Caskroom/bitwarden/2026.6.0/Bitwarden.app'." \
    "$update_all_fixture/darwin-caskroom-collision" \
    || fail "the Caskroom Error was absent from the live update transcript"
  assert_not_contains 'Groundwork update complete|--zap' \
    "$update_all_fixture/darwin-caskroom-collision" \
    "the failed Caskroom collision used destructive recovery or claimed success"
  grep -qxF 'previous-success' "$update_all_stamp" \
    || fail "the failed Caskroom collision replaced the previous success timestamp"
  caskroom_pending="$update_all_home/.local/state/groundwork/update-all-pending/homebrew-upgrade"
  test -f "$caskroom_pending" \
    || fail "the failed Caskroom collision left no durable update retry"
  grep -qF 'bitwarden' "$caskroom_pending" \
    || fail "the Caskroom collision pending record omitted the failed cask"
  caskroom_pending_temps=("${caskroom_pending}.tmp."*)
  ((${#caskroom_pending_temps[@]} == 0)) \
    || fail "the Homebrew upgrade pending record was not written atomically"
  assert_not_contains 'mise upgrade|brew autoremove|brew cleanup|brew remove|brew install' \
    "$update_all_log" \
    "the failed Caskroom collision continued or executed owner-only recovery"
  grep -qF "'com.bitwarden.desktop'..." "$raw_upgrade_log"
  grep -qF "Application 'com.bitwarden.desktop' quit successfully." "$raw_upgrade_log"
  grep -qF "already an App at '/opt/homebrew/Caskroom/bitwarden/2026.6.0/Bitwarden.app'" \
    "$raw_upgrade_log"
  grep -qF 'Purging files for version 2026.7.0 of Cask bitwarden' "$raw_upgrade_log"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-caskroom-retry" 2>&1 \
    || fail "a normal successful retry did not close the Caskroom collision"
  test ! -e "$caskroom_pending" \
    || fail "a successful Homebrew retry left the upgrade pending record"

  # A stopped selected backend is an explicit, reversible update-all repair.
  # Consent is required, noninteractive runs remain stopped, and Groundwork
  # restores the original state after success, ordinary failure, timeout, or a
  # real TERM delivered by the acting tidy child. Personal renders own Docker
  # Desktop; work renders own Colima. The nonselected backend must stay inert.
  docker_runtime_state="$update_all_fixture/docker-runtime-state"

  printf 'stopped\n' >"$docker_runtime_state"
  rm -f "$update_all_stamp" "$docker_pending"
  : >"$update_all_log"
  run_fixture_pty_after "$update_all_fixture/docker-declined" \
    'temporarily for Groundwork scratch maintenance? [y/N]' 'no\n' env \
    HOME="$update_all_home" PATH="$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" FAKE_PLATFORM=darwin \
    DOCKER_RUNTIME_STATE_FILE="$docker_runtime_state" DOCKER_TIDY_STATUS=3 \
    "$update_all_fixture/darwin-runner" \
    || fail "declining a temporary Docker Desktop start failed update-all"
  grep -qxF 'stopped' "$docker_runtime_state"
  [[ "$(grep -c '^docker-tidy --automatic$' "$update_all_log")" -eq 1 ]] \
    || fail "a declined Docker lifecycle prompt retried scratch maintenance"
  assert_not_contains 'docker-desktop-start|docker-desktop-stop|colima (start|stop)' \
    "$update_all_log" "declining Docker lifecycle consent changed a backend"

  printf 'stopped\n' >"$docker_runtime_state"
  rm -f "$update_all_stamp" "$docker_pending"
  : >"$update_all_log"
  env HOME="$update_all_home" PATH="$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" FAKE_PLATFORM=darwin \
    DOCKER_RUNTIME_STATE_FILE="$docker_runtime_state" DOCKER_TIDY_STATUS=3 \
    "$update_all_fixture/darwin-runner" \
    </dev/null >"$update_all_fixture/docker-noninteractive" 2>&1 \
    || fail "a noninteractive stopped Docker lane failed without pending work"
  grep -qF 'no interactive terminal was available' \
    "$update_all_fixture/docker-noninteractive"
  assert_not_contains 'docker-desktop-start|docker-desktop-stop|colima (start|stop)' \
    "$update_all_log" "a noninteractive update started a Docker backend"

  printf 'stopped\n' >"$docker_runtime_state"
  rm -f "$update_all_stamp" "$docker_pending"
  : >"$update_all_log"
  run_fixture_pty_after "$update_all_fixture/docker-personal-approved" \
    'temporarily for Groundwork scratch maintenance? [y/N]' 'yes\n' env \
    HOME="$update_all_home" PATH="$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" FAKE_PLATFORM=darwin \
    DOCKER_RUNTIME_STATE_FILE="$docker_runtime_state" DOCKER_TIDY_STATUS=3 \
    DOCKER_TIDY_RUNNING_STATUS=0 "$update_all_fixture/darwin-runner" \
    || fail "an approved temporary Docker Desktop maintenance cycle failed"
  grep -qxF 'stopped' "$docker_runtime_state" \
    || fail "Docker Desktop was not restored to its original stopped state"
  [[ "$(grep -c '^docker-tidy --automatic$' "$update_all_log")" -eq 2 ]] \
    || fail "approved Docker maintenance did not retry the tidy exactly once"
  grep -qxF 'docker-desktop-start' "$update_all_log"
  grep -qxF 'docker-info' "$update_all_log"
  grep -qxF 'docker-desktop-stop' "$update_all_log"
  assert_not_contains 'colima (start|stop)' "$update_all_log" \
    "the personal profile changed the nonselected Colima backend"
  grep -qF 'Docker scratch          completed' \
    "$update_all_fixture/docker-personal-approved" \
    || fail "the final receipt did not classify completed Docker maintenance"

  printf 'stopped\n' >"$docker_runtime_state"
  rm -f "$update_all_stamp" "$docker_pending"
  : >"$update_all_log"
  run_fixture_pty_after "$update_all_fixture/docker-work-approved" \
    'temporarily for Groundwork scratch maintenance? [y/N]' 'yes\n' env \
    HOME="$update_all_home" PATH="$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" FAKE_PLATFORM=darwin \
    DOCKER_RUNTIME_STATE_FILE="$docker_runtime_state" DOCKER_TIDY_STATUS=3 \
    DOCKER_TIDY_RUNNING_STATUS=0 "$update_all_fixture/darwin-work-runner" \
    || fail "an approved temporary Colima maintenance cycle failed"
  grep -qxF 'stopped' "$docker_runtime_state" \
    || fail "Colima was not restored to its original stopped state"
  grep -qxF 'colima start --runtime docker' "$update_all_log" \
    || fail "the approved maintenance cycle did not start Colima with the exact Docker runtime"
  grep -qxF 'colima stop' "$update_all_log"
  assert_not_contains 'docker-desktop-start|docker-desktop-stop' "$update_all_log" \
    "the work profile changed the nonselected Docker Desktop backend"

  printf 'running\n' >"$docker_runtime_state"
  rm -f "$update_all_stamp" "$docker_pending"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" FAKE_PLATFORM=darwin \
    DOCKER_RUNTIME_STATE_FILE="$docker_runtime_state" DOCKER_TIDY_STATUS=0 \
    "$update_all_fixture/darwin-work-runner" \
    >"$update_all_fixture/docker-work-running" 2>&1 \
    || fail "a work update with running Colima failed"
  grep -qxF 'running' "$docker_runtime_state" \
    || fail "update-all stopped a Colima backend that was already running"
  assert_not_contains 'colima (start|stop)|docker-desktop-start|docker-desktop-stop' \
    "$update_all_log" "an already-running work backend changed lifecycle state"

  printf 'stopped\n' >"$docker_runtime_state"
  rm -f "$update_all_stamp" "$docker_pending"
  : >"$update_all_log"
  run_fixture_pty_after "$update_all_fixture/docker-work-declined" \
    'temporarily for Groundwork scratch maintenance? [y/N]' 'no\n' env \
    HOME="$update_all_home" PATH="$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" FAKE_PLATFORM=darwin \
    DOCKER_RUNTIME_STATE_FILE="$docker_runtime_state" DOCKER_TIDY_STATUS=3 \
    "$update_all_fixture/darwin-work-runner" \
    || fail "declining a temporary Colima start failed update-all"
  grep -qxF 'stopped' "$docker_runtime_state"
  assert_not_contains 'colima (start|stop)|docker-desktop-start|docker-desktop-stop' \
    "$update_all_log" "declining Colima lifecycle consent changed a backend"

  printf 'stopped\n' >"$docker_runtime_state"
  printf 'previous-success\n' >"$update_all_stamp"
  rm -f "$docker_pending"
  : >"$update_all_log"
  update_all_status=0
  run_fixture_pty_after "$update_all_fixture/docker-start-timeout" \
    'temporarily for Groundwork scratch maintenance? [y/N]' 'yes\n' env \
    HOME="$update_all_home" PATH="$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" FAKE_PLATFORM=darwin \
    DOCKER_RUNTIME_STATE_FILE="$docker_runtime_state" DOCKER_TIDY_STATUS=3 \
    DOCKER_START_PARTIAL=1 DOCKER_START_STATUS=124 \
    "$update_all_fixture/darwin-runner" || update_all_status=$?
  [[ "$update_all_status" -eq 124 ]] \
    || fail "a Docker backend start timeout exited $update_all_status instead of 124"
  grep -qxF 'stopped' "$docker_runtime_state" \
    || fail "a partial timed-out Docker start was not restored"
  grep -qxF 'docker-desktop-stop' "$update_all_log"
  grep -qxF 'previous-success' "$update_all_stamp"

  printf 'stopped\n' >"$docker_runtime_state"
  printf 'previous-success\n' >"$update_all_stamp"
  rm -f "$docker_pending"
  : >"$update_all_log"
  update_all_status=0
  run_fixture_pty_after "$update_all_fixture/docker-readiness-timeout" \
    'temporarily for Groundwork scratch maintenance? [y/N]' 'yes\n' env \
    HOME="$update_all_home" PATH="$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" FAKE_PLATFORM=darwin \
    GROUNDWORK_DOCKER_READY_DEADLINE_SECONDS=1 \
    GROUNDWORK_DOCKER_PROBE_DEADLINE_SECONDS=1 \
    DOCKER_RUNTIME_STATE_FILE="$docker_runtime_state" DOCKER_TIDY_STATUS=3 \
    DOCKER_INFO_STATUS=1 "$update_all_fixture/darwin-runner" \
    || update_all_status=$?
  [[ "$update_all_status" -eq 124 ]] \
    || fail "a Docker readiness timeout exited $update_all_status instead of 124"
  grep -qF 'did not become ready within 1s' \
    "$update_all_fixture/docker-readiness-timeout"
  grep -qxF 'stopped' "$docker_runtime_state" \
    || fail "a Docker readiness timeout did not restore the stopped backend"
  grep -qxF 'docker-desktop-stop' "$update_all_log"
  grep -qxF 'previous-success' "$update_all_stamp"

  printf 'stopped\n' >"$docker_runtime_state"
  printf 'previous-success\n' >"$update_all_stamp"
  rm -f "$docker_pending"
  : >"$update_all_log"
  update_all_status=0
  run_fixture_pty_after "$update_all_fixture/docker-cleanup-failure" \
    'temporarily for Groundwork scratch maintenance? [y/N]' 'yes\n' env \
    HOME="$update_all_home" PATH="$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" FAKE_PLATFORM=darwin \
    DOCKER_RUNTIME_STATE_FILE="$docker_runtime_state" DOCKER_TIDY_STATUS=3 \
    DOCKER_TIDY_RUNNING_STATUS=9 "$update_all_fixture/darwin-runner" \
    || update_all_status=$?
  [[ "$update_all_status" -ne 0 ]] \
    || fail "a failed tidy after temporary backend start reported success"
  grep -qxF 'stopped' "$docker_runtime_state" \
    || fail "a Docker tidy failure did not restore the stopped backend"
  test -f "$docker_pending" || fail "a failed temporary tidy recorded no pending repair"
  grep -qxF 'previous-success' "$update_all_stamp"

  printf 'stopped\n' >"$docker_runtime_state"
  printf 'previous-success\n' >"$update_all_stamp"
  rm -f "$docker_pending"
  : >"$update_all_log"
  update_all_status=0
  run_fixture_pty_after "$update_all_fixture/docker-signal" \
    'temporarily for Groundwork scratch maintenance? [y/N]' 'yes\n' env \
    HOME="$update_all_home" PATH="$update_all_path" \
    GROUNDWORK_TEST_LOG="$update_all_log" FAKE_PLATFORM=darwin \
    DOCKER_RUNTIME_STATE_FILE="$docker_runtime_state" DOCKER_TIDY_STATUS=3 \
    DOCKER_TIDY_SIGNAL_PARENT=1 "$update_all_fixture/darwin-runner" \
    || update_all_status=$?
  [[ "$update_all_status" -eq 143 ]] \
    || fail "TERM during temporary Docker maintenance exited $update_all_status instead of 143"
  grep -qxF 'stopped' "$docker_runtime_state" \
    || fail "TERM during Docker maintenance did not restore the stopped backend"
  grep -qxF 'docker-desktop-stop' "$update_all_log"
  grep -qxF 'previous-success' "$update_all_stamp"
  rm -f "$docker_pending"

  # The runner snapshots Karabiner before the full apply, because that apply can
  # run a changed Brewfile hook before the explicit upgrade lane. The observed
  # version is passed to the postflight without claiming which updater changed it.
  rm -f "$update_all_stamp"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin KARABINER_VERSION_BEFORE=16.0.0 \
    "$update_all_fixture/darwin-runner" >"$update_all_fixture/darwin-version-before" 2>&1
  grep -qxF 'karabiner-postflight arg=--version-before arg=16.0.0' "$update_all_log" \
    || fail "update-all did not pass the pre-apply Karabiner version to its postflight"
  test -f "$update_all_stamp"

  # If a user-approved postflight repair fails, the runner must preserve the old
  # success timestamp and propagate failure rather than calling the update done.
  printf 'previous-success\n' >"$update_all_stamp"
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin KARABINER_POSTFLIGHT_STATUS=7 \
    "$update_all_fixture/darwin-runner" >"$update_all_fixture/darwin-postflight-fail" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -eq 7 ]] \
    || fail "update-all changed Karabiner postflight failure 7 to $update_all_status"
  grep -qF 'Karabiner postflight did not complete (exit 7)' \
    "$update_all_fixture/darwin-postflight-fail"
  grep -qxF 'previous-success' "$update_all_stamp"

  # An empty state directory is not pending work. The exceptional fast path
  # still succeeds and records the completed refresh while skipping maintenance.
  rm -f "$update_all_stamp"
  mkdir -p "$update_all_home/.local/state/groundwork/update-all-pending"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" --skip-maintenance \
    >"$update_all_fixture/darwin-skip-maintenance" 2>&1 \
    || fail "an empty pending directory must not make --skip-maintenance fail"
  assert_not_contains 'brew cleanup|npm cache verify|pnpm store prune' "$update_all_log" \
    "--skip-maintenance ran package-manager maintenance"
  assert_not_contains 'docker-tidy' "$update_all_log" \
    "--skip-maintenance ran Docker scratch maintenance"
  test -f "$update_all_stamp" \
    || fail "--skip-maintenance did not record an otherwise complete refresh"

  # Skipping maintenance never clears earlier work. Its failure guidance keeps
  # the full transaction and cadence-respecting maintenance-only retry primary.
  rm -f "$update_all_stamp"
  mkdir -p "$update_all_home/.local/state/groundwork/update-all-pending"
  printf 'recorded Homebrew maintenance failure\n' \
    >"$update_all_home/.local/state/groundwork/update-all-pending/homebrew"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin "$update_all_fixture/darwin-runner" --skip-maintenance \
    >"$update_all_fixture/darwin-skip-with-pending" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "--skip-maintenance reported success while earlier maintenance was pending"
  assert_recovery_hierarchy "$update_all_fixture/darwin-skip-with-pending" \
    "the skip-pending runner output"
  rm -rf "$update_all_home/.local/state/groundwork/update-all-pending"

  # BEHAVIOR, not wiring text: a failed upgrade whose downloads re-fetch (exit
  # 0 from refetch) is retried exactly once; a still-failing retry fails the
  # run and writes no timestamp.
  rm -f "$update_all_stamp"
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin BREW_FORMULA_OUTDATED='' BREW_STAGE_STATUS=1 REFETCH_STATUS=0 \
    "$update_all_fixture/darwin-runner" >"$update_all_fixture/darwin-refetch-retry" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "a retried upgrade that still fails must fail the run"
  [[ "$(grep -c '^brew upgrade --cask --require-sha' "$update_all_log")" -eq 2 ]] \
    || fail "a successful re-fetch must retry the failed upgrade exactly once"
  diff -u <(printf '%s\n%s\n' \
    'brew upgrade --cask --require-sha --no-quit ghostty auto=1 casks=unset hb-color=unset' \
    'brew upgrade --cask --require-sha --no-quit ghostty auto=1 casks=unset hb-color=unset') \
    <(grep '^brew upgrade --cask --require-sha' "$update_all_log") \
    || fail "the Homebrew retry changed the selected managed candidate set"
  grep -qxF 'brew-refetch' "$update_all_log" \
    || fail "a failed upgrade must consult groundwork-brew-refetch"
  assert_not_contains 'brew cleanup' "$update_all_log" \
    "a failed upgrade must not clean the download cache — its partial downloads are what the retry needs"
  test ! -e "$update_all_stamp"

  # An APPROVED repair that failed (exit 3) must fail the run even though the
  # upgrade itself exited 0 — a broken machine must never be reported updated.
  rm -f "$update_all_stamp"
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin REPAIR_STATUS=3 \
    "$update_all_fixture/darwin-runner" >"$update_all_fixture/darwin-repair-fail" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "a failed approved repair must fail the run, not be reported as success"
  grep -qF 'did not complete' "$update_all_fixture/darwin-repair-fail" \
    || fail "a failed approved repair must be reported in the output"
  test ! -e "$update_all_stamp"
  # A failed app relaunch must not fail the refresh because it is best-effort.
  rm -f "$update_all_stamp"
  : >"$update_all_log"
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin APPS_START_STATUS=1 "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-apps-fail" 2>&1 \
    || fail "a failed app relaunch must not fail update-all (it is best-effort)"
  diff -u "$update_all_fixture/expected-darwin" "$update_all_log" \
    || fail "a best-effort app relaunch failure suppressed the Karabiner postflight"
  test -f "$update_all_stamp"

  # The app relaunch remains best-effort, but the health postflight is not: an
  # absent privileged Core Service must prevent a fresh success timestamp.
  printf 'previous-success\n' >"$update_all_stamp"
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
    FAKE_PLATFORM=darwin APPS_START_STATUS=1 KARABINER_ROOT_SERVICE_PRESENT=0 \
    "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-apps-fail-core-absent" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -eq 9 ]] \
    || fail "an absent Karabiner Core Service exited $update_all_status instead of 9"
  grep -qF 'Karabiner is installed, but its root Core Service is not running' \
    "$update_all_fixture/darwin-apps-fail-core-absent"
  grep -qxF 'previous-success' "$update_all_stamp"
  grep -qxF 'apps-start' "$update_all_log"
  grep -qxF 'karabiner-postflight' "$update_all_log"

  rm -f "$update_all_stamp"
  : >"$update_all_log"
  set +e
  HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
    NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' \
    FAKE_PLATFORM=darwin BREW_UPDATE_STATUS=1 "$update_all_fixture/darwin-runner" \
    >"$update_all_fixture/darwin-brew-fail" 2>&1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] || fail "the darwin runner reported a failed metadata refresh as complete"
  diff -u <(printf 'chezmoi apply color=0\nbrew-update\nmise upgrade --minimum-release-age 5d\n') "$update_all_log"
  grep -qF 'Package-manager maintenance skipped because Homebrew inventory or update failed' \
    "$update_all_fixture/darwin-brew-fail" \
    || fail "Homebrew failure did not isolate later package-manager mutation on macOS"
  test ! -e "$update_all_stamp"

  check "update-all Homebrew download-cache cleanup"
  # Homebrew's DEFAULT cleanup is conservative by design: it prunes stale
  # downloads and files older than 120 days, and keeps downloads for currently
  # installed packages. That is how a successful update-all left 6.3 GB in
  # ~/Library/Caches/Homebrew/downloads. The aggressive form is the contract
  # here, and every claim below is measured rather than announced.
  cache_dir="$update_all_fixture/cache with spaces"
  # The path deliberately contains spaces: cache accounting must not depend on
  # a tidy path, and a broken quote here would be a deletion bug elsewhere.
  seed_cache() {
    rm -rf "$cache_dir"
    mkdir -p "$cache_dir/downloads" "$cache_dir/api"
    # Random bytes, not zeros: a transparently compressing filesystem (btrfs,
    # zfs) would make a zero-filled file measure far below its nominal size and
    # turn the size assertions below into a portability trap. The api/ entry is
    # what a PARTIAL cleanup leaves behind.
    dd if=/dev/urandom of="$cache_dir/downloads/artifact.bottle.tar.gz" bs=1024 count=4096 \
      >/dev/null 2>&1
    dd if=/dev/urandom of="$cache_dir/api/formula.jws.json" bs=1024 count=512 \
      >/dev/null 2>&1
  }
  cleanup_marker="$update_all_home/.local/state/groundwork/update-all-pending/homebrew"
  run_cleanup_case_keeping_state() {
    local output="$1"
    shift
    : >"$update_all_log"
    env HOME="$update_all_home" PATH="$update_all_path" GROUNDWORK_TEST_LOG="$update_all_log" \
      NO_COLOR='' FORCE_COLOR='' GROUNDWORK_COLOR='' HOMEBREW_COLOR='' \
      "$@" "$update_all_fixture/rendered-runner" >"$output" 2>&1
  }
  run_cleanup_case() {
    rm -f "$update_all_stamp" "$cleanup_marker"
    run_cleanup_case_keeping_state "$@"
  }

  # A populated cache is emptied, and the receipt reports measured cache bytes
  # before, after, and reclaimed. The assertions are relational — magnitude and
  # unit, not an exact figure derived from the host filesystem's block accounting.
  seed_cache
  run_cleanup_case "$update_all_fixture/cache-receipt" BREW_CACHE_DIR="$cache_dir" \
    || fail "update-all failed while cleaning a populated Homebrew cache"
  cat >"$update_all_fixture/expected-cleanup-transaction" <<'EOF'
chezmoi apply color=0
brew-update
brew upgrade --formula git auto=1 casks=unset hb-color=unset
mise upgrade --minimum-release-age 5d
brew autoremove
brew cleanup --prune=all
docker-tidy --automatic
EOF
  diff -u "$update_all_fixture/expected-cleanup-transaction" "$update_all_log" \
    || fail "the successful maintenance transaction changed its approved command set"
  grep -qxF 'brew cleanup --prune=all' "$update_all_log" \
    || fail "the Homebrew phase must end with brew cleanup --prune=all"
  grep -qxF 'docker-tidy --automatic' "$update_all_log" \
    || fail "update-all must run the label-scoped Docker scratch tidy automatically"
  grep -qE '^  Cache before:    [0-9.]+ MiB$' "$update_all_fixture/cache-receipt" \
    || fail "the cleanup receipt must report the measured cache size before cleanup"
  grep -qE '^  Cache after:     (0 B|[0-9.]+ KiB)$' "$update_all_fixture/cache-receipt" \
    || fail "the cleanup receipt must report the measured cache size after cleanup"
  grep -qE '^  Cache reclaimed: [0-9.]+ MiB$' "$update_all_fixture/cache-receipt" \
    || fail "the cleanup receipt must report the reclaimed cache bytes"
  # Units are binary because du reports 1024-byte blocks; labeling them MB would
  # misstate a disk figure by 5%.
  assert_not_contains '(MB|GB|KB)$' "$update_all_fixture/cache-receipt" \
    "the receipt labels 1024-based sizes with decimal units"
  # The receipt is explicitly cache-scoped: the command it brackets also removes
  # old formula versions and stale locks, so the numbers must not read as the
  # total the cleanup reclaimed.
  grep -qF 'Cache before' "$update_all_fixture/cache-receipt" \
    || fail "the receipt must label its measurement as cache-scoped"
  grep -qF 'Requested formulae and casks stay installed' "$update_all_fixture/cache-receipt" \
    || fail "the receipt must say what cleanup retains"
  grep -qF 'may remove installed orphan formula dependencies' "$update_all_fixture/cache-receipt" \
    || fail "the receipt must not overclaim that installed dependencies are retained"
  test -z "$(find "$cache_dir" -mindepth 1 -name '*.bottle.tar.gz' -print -quit)" \
    || fail "the cached download survived brew cleanup --prune=all"
  test -f "$update_all_stamp" || fail "a clean cleanup must still record the successful refresh"

  # Ordering is the safety property: cleanup runs AFTER the upgrade stages, never
  # before them, so a run that fails mid-upgrade still has its downloads.
  cleanup_line="$(grep -n 'brew cleanup --prune=all' "$update_all_log" | cut -d: -f1)"
  upgrade_line="$(grep -n '^brew upgrade' "$update_all_log" | tail -1 | cut -d: -f1)"
  [[ "$cleanup_line" -gt "$upgrade_line" ]] \
    || fail "brew cleanup --prune=all ran before the upgrade stage it must follow"

  # A run with nothing to upgrade still cleans: the cache is disposable whether
  # or not this refresh changed a package.
  seed_cache
  run_cleanup_case "$update_all_fixture/cache-no-upgrades" BREW_CACHE_DIR="$cache_dir" \
    BREW_NOTHING_TO_UPGRADE=1 \
    || fail "update-all failed when there was nothing to upgrade"
  grep -qxF 'brew cleanup --prune=all' "$update_all_log" \
    || fail "a run with no upgrades must still clean the download cache"
  grep -qE '^  Cache reclaimed: [0-9.]+ MiB$' "$update_all_fixture/cache-no-upgrades" \
    || fail "a no-upgrade run must still report what it reclaimed"

  # An already-empty cache is a successful measurement of zero, not a failure.
  seed_cache
  find "$cache_dir" -mindepth 1 -delete
  run_cleanup_case "$update_all_fixture/cache-empty" BREW_CACHE_DIR="$cache_dir" \
    || fail "update-all failed on an already-empty Homebrew cache"
  grep -qE '^  Cache reclaimed: nothing to reclaim$' "$update_all_fixture/cache-empty" \
    || fail "an empty cache must report nothing to reclaim"

  # A cache directory Homebrew has not created yet holds nothing.
  run_cleanup_case "$update_all_fixture/cache-missing" \
    BREW_CACHE_DIR="$update_all_fixture/never-created-cache" \
    || fail "update-all failed on a missing Homebrew cache directory"
  grep -qE '^  Cache before:    0 B$' "$update_all_fixture/cache-missing" \
    || fail "a missing cache directory must measure as empty"

  # A FAILED size query is unavailable, never zero: an observation that broke
  # must not be reported as a clean, empty cache.
  run_cleanup_case "$update_all_fixture/cache-unknown" BREW_CACHE_FAIL=1 \
    || fail "update-all failed when the cache size could not be queried"
  grep -qE '^  Cache before:    unavailable$' "$update_all_fixture/cache-unknown" \
    || fail "an unqueryable cache size must be reported as unavailable"
  grep -qE '^  Cache reclaimed: not measured' "$update_all_fixture/cache-unknown" \
    || fail "unmeasurable bytes must not be reported as a reclaim figure"
  grep -qxF 'brew cleanup --prune=all' "$update_all_log" \
    || fail "a failed size query must not skip the cleanup itself"

  # A cache that GREW between the two observations (another process downloading
  # while cleanup ran) is reported as indeterminate. Two observations are not one
  # atomic measurement, and a negative reclaim is not "nothing to reclaim".
  seed_cache
  run_cleanup_case "$update_all_fixture/cache-grew" BREW_CACHE_DIR="$cache_dir" \
    BREW_CLEANUP_GROWS=1 \
    || fail "update-all failed when the cache grew during cleanup"
  grep -qE '^  Cache reclaimed: indeterminate — the cache grew by [0-9.]+ MiB during cleanup$' \
    "$update_all_fixture/cache-grew" \
    || fail "a cache that grew during cleanup must be reported as indeterminate, not as nothing to reclaim"

  # A PARTIAL cleanup — some cached files removed, then a failure — must not be
  # described as a cache left untouched, and must not record a successful refresh.
  seed_cache
  set +e
  run_cleanup_case "$update_all_fixture/cache-partial" BREW_CACHE_DIR="$cache_dir" \
    BREW_CLEANUP_PARTIAL=1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "a partial cleanup must not be reported as a successful refresh"
  grep -qF 'was incomplete (exit 1)' "$update_all_fixture/cache-partial" \
    || fail "a partial cleanup must be described as incomplete, naming the status"
  grep -qF 'some cached files may have been removed and others left behind' \
    "$update_all_fixture/cache-partial" \
    || fail "a partial cleanup must not claim the cache was left as it was"
  grep -qE '^  Cache before:    [0-9.]+ MiB$' "$update_all_fixture/cache-partial" \
    || fail "a partial cleanup must still report the measurement it took"
  grep -qE '^  Cache after:     [0-9.]+ KiB$' "$update_all_fixture/cache-partial" \
    || fail "a partial cleanup must report the smaller cache it actually left"
  test -f "$cache_dir/api/formula.jws.json" \
    || fail "the partial-cleanup fixture must leave something behind to measure"
  test ! -e "$update_all_stamp" \
    || fail "a partial cleanup must not record a successful refresh"

  # A failed cleanup keeps the upgrades it cannot undo, shows the exact error,
  # runs the independent stages after it, and still refuses to record success.
  #
  # The state this starts from is the point: a refresh that succeeded RECENTLY.
  # Withholding today's timestamp proves nothing on its own — yesterday's is
  # still well inside the stale window, so an age-only reminder would stay quiet
  # while the cache stayed full. The durable marker is what has to appear.
  seed_cache
  rm -f "$cleanup_marker"
  printf 'yesterdays-success\n' >"$update_all_stamp"
  set +e
  run_cleanup_case_keeping_state "$update_all_fixture/cache-cleanup-fail" \
    BREW_CACHE_DIR="$cache_dir" BREW_CLEANUP_STATUS=1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "a failed cache cleanup must not exit 0; nothing else would tell a script"
  grep -qF 'Groundwork update incomplete' "$update_all_fixture/cache-cleanup-fail" \
    || fail "a failed cache cleanup must be classified as an incomplete refresh"
  grep -qF 'FAILED · required work did not complete' \
    "$update_all_fixture/cache-cleanup-fail" \
    || fail "a failed cache cleanup must carry a failed final result"
  grep -qF 'brew cleanup --prune=all was incomplete (exit 1)' "$update_all_fixture/cache-cleanup-fail" \
    || fail "a failed cache cleanup must name the command and its status"
  grep -qF 'Permission denied' "$update_all_fixture/cache-cleanup-fail" \
    || fail "Homebrew's own cleanup error must reach the user"
  assert_recovery_hierarchy "$update_all_fixture/cache-cleanup-fail" \
    "the nested real-cleanup runner output"
  diff -u "$update_all_fixture/expected-cleanup-transaction" "$update_all_log" \
    || fail "recovery-guidance ownership changed the package-manager command set"
  grep -qxF 'mise upgrade --minimum-release-age 5d' "$update_all_log" \
    || fail "a failed cache cleanup must not stop the independent stages after it"
  test -f "$cleanup_marker" \
    || fail "a failed cleanup must leave durable state; a message on a screen that scrolls away is not state"
  grep -qF 'brew cleanup --prune=all was incomplete (exit 1)' "$cleanup_marker" \
    || fail "the pending marker must record what was left outstanding"
  grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z ' "$cleanup_marker" \
    || fail "the pending marker must record when the cleanup failed"
  grep -qxF 'yesterdays-success' "$update_all_stamp" \
    || fail "a failed cleanup must leave the last successful refresh recorded as the truthful history it is"
  cleanup_marker_temps=("${cleanup_marker}.tmp."*)
  ((${#cleanup_marker_temps[@]} == 0)) || fail "the pending marker was not written atomically"

  # The marker is state the machine reads, so prove the surface that consumes it:
  # with a FRESH timestamp (age 0, nowhere near the stale window) the reminder
  # still speaks, because outstanding work beats a recent success.
  reminder_dir="$update_all_fixture/reminder"
  mkdir -p "$reminder_dir/zdot"
  render darwin false arm64 home/dot_zshrc.tmpl "$reminder_dir/rendered-zshrc"
  sed -n '/^groundwork-update-reminder() {/,/^unfunction groundwork-update-reminder$/p' \
    "$reminder_dir/rendered-zshrc" >"$reminder_dir/zdot/.zshrc"
  test -s "$reminder_dir/zdot/.zshrc" \
    || fail "could not extract the update reminder from the rendered zshrc"
  run_reminder() {
    # The once-a-day throttle is a separate contract; clear it so each case here
    # measures the decision under test.
    rm -f "$update_all_home/.local/state/groundwork/update-reminder-last-shown"
    env -u CI HOME="$update_all_home" ZDOTDIR="$reminder_dir/zdot" \
      GROUNDWORK_UPDATE_REMINDER=1 zsh -i -c 'true' >"$1" 2>&1
  }
  run_reminder "$reminder_dir/pending-output"
  grep -qF "could not finish package-manager maintenance" "$reminder_dir/pending-output" \
    || fail "a pending cleanup must be reported however recent the last successful refresh is"
  grep -qF 'was incomplete (exit 1)' "$reminder_dir/pending-output" \
    || fail "the reminder must repeat what the marker recorded"
  assert_recovery_hierarchy "$reminder_dir/pending-output" \
    "the pending-maintenance shell reminder"
  grep -qF "See \`groundwork-cleanup --help\` for exceptional overrides." \
    "$reminder_dir/pending-output" \
    || fail "the shell reminder must keep exceptional commands discoverable"
  assert_not_contains 'repair maintenance only with:' "$reminder_dir/pending-output" \
    "the reminder must not present --force as the routine maintenance repair"

  # The next clean run clears the state on its own: the marker is removed, the
  # refresh is recorded again, and the reminder goes quiet.
  seed_cache
  run_cleanup_case_keeping_state "$update_all_fixture/cache-recovered" BREW_CACHE_DIR="$cache_dir" \
    || fail "a clean run after a failed cleanup must succeed"
  test -f "$update_all_stamp" \
    || fail "a clean run after a failed cleanup must record the refresh again"
  test ! -e "$cleanup_marker" \
    || fail "a clean cleanup must clear the pending marker; nothing else ever will"
  assert_not_contains 'completed with warnings' "$update_all_fixture/cache-recovered" \
    "a recovered run still reported the previous cleanup warning"
  run_reminder "$reminder_dir/recovered-output"
  assert_not_contains "could not finish" "$reminder_dir/recovered-output" \
    "the reminder still reports a cleanup that a later clean run completed"

  # A failed package upgrade shares the durable pending namespace but is not a
  # cleanup lane. Its reminder must send the user back through update-all and
  # must not suggest that groundwork-cleanup can complete the missing upgrade.
  mkdir -p "$update_all_home/.local/state/groundwork/update-all-pending"
  printf '2001-01-01T00:00:00Z Homebrew upgrade failed (exit 17); failed cask: bitwarden\n' \
    >"$update_all_home/.local/state/groundwork/update-all-pending/homebrew-upgrade"
  run_reminder "$reminder_dir/upgrade-pending-output"
  grep -qF 'could not finish a required Homebrew upgrade' \
    "$reminder_dir/upgrade-pending-output" \
    || fail "a pending Homebrew upgrade was mislabeled as package maintenance"
  grep -qF 'homebrew-upgrade: 2001-01-01T00:00:00Z Homebrew upgrade failed (exit 17); failed cask: bitwarden' \
    "$reminder_dir/upgrade-pending-output" \
    || fail "the Homebrew upgrade reminder omitted its durable failure detail"
  grep -qF 'Run update-all again to retry the complete update transaction.' \
    "$reminder_dir/upgrade-pending-output" \
    || fail "the Homebrew upgrade reminder omitted its effective retry"
  assert_not_contains 'groundwork-cleanup|retry maintenance without repeating upgrades' \
    "$reminder_dir/upgrade-pending-output" \
    "a Homebrew upgrade reminder recommended an ineffective cleanup-only repair"
  rm -f "$update_all_home/.local/state/groundwork/update-all-pending/homebrew-upgrade"
  rmdir "$update_all_home/.local/state/groundwork/update-all-pending" 2>/dev/null || true

  # Docker scratch maintenance has its own pending record and repair route; it
  # must not masquerade as package-manager maintenance or recommend the
  # daemon-wide cache tidy.
  printf '2001-01-01T00:00:00Z Docker scratch maintenance failed (exit 9)\n' \
    >"$docker_pending"
  run_reminder "$reminder_dir/docker-pending-output"
  grep -qF 'could not finish Docker scratch maintenance' \
    "$reminder_dir/docker-pending-output"
  grep -qF 'groundwork-docker-tidy --yes' "$reminder_dir/docker-pending-output"
  grep -qF 'Daemon-wide Docker cleanup remains owner-reviewed and separate.' \
    "$reminder_dir/docker-pending-output"
  assert_not_contains 'groundwork-docker-cache-tidy|package-manager maintenance' \
    "$reminder_dir/docker-pending-output" \
    "the Docker-only reminder crossed into a broader or unrelated cleanup lane"
  rm -f "$docker_pending"
  run_reminder "$reminder_dir/docker-recovered-output"
  assert_not_contains 'Docker scratch maintenance' "$reminder_dir/docker-recovered-output" \
    "the Docker reminder survived after its pending record was cleared"

  # An interrupted cleanup records the marker before propagating — in the one
  # shape this models: brew died on the signal while the runner survived. A real
  # terminal Ctrl-C usually kills the runner too, and that path keeps no record.
  seed_cache
  rm -f "$cleanup_marker" "$update_all_stamp"
  set +e
  run_cleanup_case_keeping_state "$update_all_fixture/cache-interrupt-marker" \
    BREW_CACHE_DIR="$cache_dir" BREW_CLEANUP_STATUS=130
  update_all_status=$?
  set -e
  [[ "$update_all_status" -eq 130 ]] \
    || fail "an interrupted cleanup must propagate 130, got $update_all_status"
  grep -qF 'was interrupted (exit 130)' "$cleanup_marker" \
    || fail "an interrupted cleanup must record that it did not finish"
  test ! -e "$update_all_stamp" \
    || fail "an interrupted cleanup must not record a successful refresh"

  # brew autoremove and cleanup are independent supported operations inside one
  # Homebrew receipt. A failed autoremove is durable failure state, but cleanup
  # still gets its own attempt and completed runtime/npm upgrades stay complete.
  seed_cache
  set +e
  run_cleanup_case "$update_all_fixture/cache-autoremove-fail" BREW_CACHE_DIR="$cache_dir" \
    BREW_AUTOREMOVE_STATUS=1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "a failed brew autoremove must fail the run"
  grep -qxF 'brew autoremove' "$update_all_log" \
    || fail "the autoremove-failure fixture must actually reach autoremove"
  grep -qxF 'brew cleanup --prune=all' "$update_all_log" \
    || fail "a failed autoremove must not suppress the independent cleanup operation"
  grep -qxF 'mise upgrade --minimum-release-age 5d' "$update_all_log" \
    || fail "maintenance failure must preserve the completed runtime upgrade"
  test -f "$cleanup_marker" \
    || fail "a failed autoremove must leave durable per-stage pending state"
  test ! -e "$update_all_stamp" \
    || fail "a failed autoremove must not record a successful refresh"

  # Ctrl-C during cleanup is an interruption, not a warning to walk past.
  for interrupt_status in 130 143; do
    set +e
    run_cleanup_case "$update_all_fixture/cache-interrupt-$interrupt_status" \
      BREW_CACHE_DIR="$cache_dir" BREW_CLEANUP_STATUS="$interrupt_status"
    update_all_status=$?
    set -e
    [[ "$update_all_status" -eq "$interrupt_status" ]] \
      || fail "an interrupted cleanup ($interrupt_status) must propagate, got $update_all_status"
    test ! -e "$update_all_stamp" \
      || fail "an interrupted cleanup must not record a successful refresh"
  done
  rm -rf "$cache_dir"
  rm -f "$update_all_stamp"

  # The size formatter, tested with fixed numbers instead of whatever the host
  # filesystem happens to allocate: exact output belongs in an exact test.
  format_probe="$update_all_fixture/format-bytes-probe"
  {
    printf 'set -euo pipefail\n'
    sed -n '/^format_bytes() {/,/^}/p' home/dot_local/bin/executable_groundwork-cleanup
    # shellcheck disable=SC2016 # "$@" is the probe script's own argument list, expanded when the probe runs.
    printf 'for value in "$@"; do format_bytes "$value"; done\n'
  } >"$format_probe"
  grep -qF 'awk -v bytes=' "$format_probe" \
    || fail "could not extract format_bytes from groundwork-cleanup"
  format_probe_output="$(/bin/bash "$format_probe" '' 0 1023 1024 4194304 6764573491 1099511627776)"
  diff -u <(printf 'unavailable\n0 B\n1023 B\n1.0 KiB\n4.0 MiB\n6.3 GiB\n1.0 TiB\n') \
    <(printf '%s\n' "$format_probe_output") \
    || fail "format_bytes must label 1024-based sizes in binary units, and an unmeasured size as unavailable"

  # Source-level locks on the cleanup path: the aggressive
  # form only, and never a raw deletion of Homebrew's cache directory.
  cleanup_invocation_pattern='^[[:space:]]*run_bounded "brew cleanup --prune=all" brew cleanup'
  cleanup_render=home/dot_local/bin/executable_groundwork-cleanup
  # EXACTLY ONE invocation, and exactly the approved one. Counting rejects a
  # duplicate or an extra `brew cleanup --dry-run`/`--scrub` that a later patch
  # might add beside it; matching the whole line rejects a weaker form.
  # NOT mapfile: macOS ships Bash 3.2, where it does not exist.
  cleanup_invocations=()
  while IFS= read -r cleanup_line_text; do
    [[ -n "$cleanup_line_text" ]] || continue
    cleanup_invocations+=("$cleanup_line_text")
  done < <(grep -E "$cleanup_invocation_pattern" "$cleanup_render" || true)
  [[ "${#cleanup_invocations[@]}" -eq 1 ]] \
    || fail "$cleanup_render must invoke brew cleanup exactly once, found ${#cleanup_invocations[@]}: ${cleanup_invocations[*]:-none}"
  cleanup_invocation="${cleanup_invocations[0]#"${cleanup_invocations[0]%%[![:space:]]*}"}"
  [[ "$cleanup_invocation" == 'run_bounded "brew cleanup --prune=all" brew cleanup --prune=all || cleanup_status=$?' ]] \
    || fail "$cleanup_render invokes an unapproved cleanup: $cleanup_invocation (Homebrew's default 120-day policy is what left gigabytes behind)"
  assert_not_contains 'rm -rf.*brew --cache|rm -rf.*Caches/Homebrew' "$cleanup_render" \
    "raw deletion of Homebrew's cache in $cleanup_render — use brew cleanup, which respects Homebrew's locking"
  assert_not_contains 'sudo' "$cleanup_render" \
    "update-all must never escalate privileges: $cleanup_render"

  check "update-all npm cache verify stage"
  # npm's cache verify is conservative, owner-provided garbage collection —
  # appropriate for every refresh. Node is mise-owned, so npm resolves through
  # mise first; a machine with neither runs no npm stage at all (the default in
  # every fixture above, which is why their logs did not change).
  run_cleanup_case "$update_all_fixture/npm-verify" MISE_WHICH_NPM_STATUS=0 \
    || fail "update-all failed with a mise-owned npm present"
  # pwd=$HOME proves neutrality: launched from anywhere, the maintenance runs
  # from the home directory, out of reach of a repository's mise config or a
  # project-local .npmrc redirecting the cache. Compare the cd-normalized form:
  # macOS TMPDIR ends in a slash, so the raw fixture path carries a double
  # slash that cd collapses out of $PWD.
  update_all_home_pwd="$(cd "$update_all_home" && pwd)"
  grep -qxF "mise exec -- npm cache verify pwd=$update_all_home_pwd" "$update_all_log" \
    || fail "a mise-owned npm must be verified via mise exec, from \$HOME"
  test -f "$update_all_stamp" \
    || fail "a successful npm verify must not block the success timestamp"
  # The stage runs AFTER the runtime upgrades it depends on.
  npm_line="$(grep -n 'npm cache verify' "$update_all_log" | cut -d: -f1)"
  mise_line="$(grep -n '^mise upgrade' "$update_all_log" | cut -d: -f1)"
  [[ "$npm_line" -gt "$mise_line" ]] \
    || fail "npm cache verify must run after the mise upgrade stage"

  # A failed verify is a failed stage: nonzero, no success timestamp.
  set +e
  run_cleanup_case "$update_all_fixture/npm-verify-fail" MISE_WHICH_NPM_STATUS=0 \
    NPM_VERIFY_STATUS=1
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] \
    || fail "a failed npm cache verify must fail the run"
  test ! -e "$update_all_stamp" \
    || fail "a failed npm cache verify must not record a successful refresh"

  # When mise owns no npm but a PATH npm exists, the fallback branch verifies it
  # directly. (A machine with no mise at all cannot be modeled here: the runner
  # deliberately prepends the real Homebrew paths, so removing the mise stub
  # would leak to the host's mise — the stub stays, reporting no npm.)
  run_cleanup_case "$update_all_fixture/npm-verify-path" NPM_STUB_LOG=1 \
    || fail "update-all failed with a PATH npm and a mise that owns no npm"
  grep -qxF "npm cache verify pwd=$update_all_home_pwd" "$update_all_log" \
    || fail "a PATH npm must be verified when mise owns no npm, from \$HOME"
  assert_not_contains 'mise exec' "$update_all_log" \
    "the mise exec branch may not run when mise owns no npm"

  # No npm anywhere: no stage runs, and the refresh still succeeds. The stub is
  # moved aside, not chmod -x'd — Linux bash's command -v reports even a
  # non-executable file, which would then fail with 126. On a host whose real
  # Homebrew paths carry an npm the fallback can still find that one (harmless,
  # unlogged, against the fixture HOME) — the strict absence proof lands on
  # CI's Linux runner, where those paths do not exist.
  mv "$update_all_bin/npm" "$update_all_fixture/npm.hidden"
  run_cleanup_case "$update_all_fixture/npm-absent" \
    || fail "update-all must succeed with no npm anywhere"
  assert_not_contains 'npm cache verify' "$update_all_log" \
    "an npm stage ran although no npm was present"
  test -f "$update_all_stamp" \
    || fail "a machine without npm must still record a successful refresh"
  mv "$update_all_fixture/npm.hidden" "$update_all_bin/npm"

  # Helper-level failures are durable even with a recent prior success. Missing
  # and early-crashing helpers create the generic record; a later successful
  # maintenance pass clears it.
  rm -rf "$update_all_home/.local/state/groundwork/update-all-pending"
  printf 'recent-success\n' >"$update_all_stamp"
  mv "$update_all_bin/groundwork-cleanup" "$update_all_fixture/groundwork-cleanup.real"
  set +e
  run_cleanup_case_keeping_state "$update_all_fixture/cleanup-helper-missing"
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] || fail "a missing maintenance helper returned success"
  helper_pending="$update_all_home/.local/state/groundwork/update-all-pending/maintenance-helper"
  grep -qF 'maintenance helper is missing' "$helper_pending" \
    || fail "a missing helper did not create generic durable pending state"
  grep -qxF 'recent-success' "$update_all_stamp" \
    || fail "a helper-level failure overwrote prior successful history"
  assert_recovery_hierarchy "$update_all_fixture/cleanup-helper-missing" \
    "the missing-helper runner output"
  run_reminder "$reminder_dir/helper-pending-output"
  grep -qF 'maintenance-helper:' "$reminder_dir/helper-pending-output" \
    || fail "generic helper pending state did not override a fresh reminder timestamp"

  cat >"$update_all_bin/groundwork-cleanup" <<'SH'
#!/usr/bin/env bash
exit 70
SH
  chmod +x "$update_all_bin/groundwork-cleanup"
  set +e
  run_cleanup_case_keeping_state "$update_all_fixture/cleanup-helper-crash"
  update_all_status=$?
  set -e
  [[ "$update_all_status" -ne 0 ]] || fail "an early-crashing maintenance helper returned success"
  grep -qF 'failed before recording a manager stage (exit 70)' "$helper_pending" \
    || fail "an early helper crash did not preserve generic pending state"
  assert_recovery_hierarchy "$update_all_fixture/cleanup-helper-crash" \
    "the crashing-helper runner output"
  assert_not_contains 'run groundwork-cleanup --yes --force|Repair pending package-manager maintenance:' \
    "$update_all_fixture/darwin-runner" \
    "the runner source must not preserve force-first recovery guidance"

  mv "$update_all_fixture/groundwork-cleanup.real" "$update_all_bin/groundwork-cleanup"
  run_cleanup_case_keeping_state "$update_all_fixture/cleanup-helper-recovered" \
    || fail "a restored maintenance helper did not repair generic pending state"
  test ! -e "$helper_pending" \
    || fail "a successful maintenance helper did not clear generic pending state"

  if [[ -n "$update_all_had_xdg_config" ]]; then
    export XDG_CONFIG_HOME="$update_all_saved_xdg_config"
  else
    unset XDG_CONFIG_HOME
  fi
  if [[ -n "$update_all_had_xdg_cache" ]]; then
    export XDG_CACHE_HOME="$update_all_saved_xdg_cache"
  else
    unset XDG_CACHE_HOME
  fi

  check "groundwork-cleanup fixture setup"
  cleanup_fixture="$out_dir/package-maintenance-fixture"
  cleanup_home="$cleanup_fixture/home"
  cleanup_bin="$cleanup_home/.local/bin"
  cleanup_code="$cleanup_home/code"
  cleanup_log="$cleanup_fixture/commands.log"
  cleanup_command="$PWD/home/dot_local/bin/executable_groundwork-cleanup"
  mkdir -p "$cleanup_bin" "$cleanup_home/.local/lib/groundwork" \
    "$cleanup_home/.local/share/groundwork/lib" \
    "$cleanup_home/.config/groundwork" \
    "$cleanup_code/repo-a" "$cleanup_code/repo-b" \
    "$cleanup_code/repo-c" "$cleanup_code/repo-offline" \
    "$cleanup_code/repo-version-fail" "$cleanup_code/repo-custom" \
    "$cleanup_code/repo-control" "$cleanup_code/repo-escape" \
    "$cleanup_code/repo-prerelease" "$cleanup_code/repo-absent-store" \
    "$cleanup_code/repo-absent-untrusted" "$cleanup_code/repo-absent-malformed" \
    "$cleanup_code/repo-dangling-store" \
    "$cleanup_code/false-marker/.git" \
    "$cleanup_code/no-pin" \
    "$cleanup_home/Library/pnpm/store/v9/files" \
    "$cleanup_fixture/stores/v11/files" "$cleanup_fixture/stores/v10/files" \
    "$cleanup_fixture/custom-store/v11/files" \
    "$cleanup_fixture/unrelated"
  # macOS exposes the temporary directory through both /var and /private/var.
  # Canonicalize once so report assertions compare the paths emitted by git.
  cleanup_fixture="$(cd "$cleanup_fixture" && pwd -P)"
  cleanup_home="$cleanup_fixture/home"
  cleanup_bin="$cleanup_home/.local/bin"
  cleanup_code="$cleanup_home/code"
  cleanup_log="$cleanup_fixture/commands.log"
  mkdir -p "$cleanup_fixture/external-generation/files" \
    "$cleanup_fixture/stores/version-backup" \
    "$cleanup_fixture/stores/v11-escape" \
    "$cleanup_fixture/stores/"$'v12\033unsafe'
  ln -s "$cleanup_fixture/external-generation" "$cleanup_fixture/stores/v99"
  ln -s "$cleanup_fixture/missing-store-generation" "$cleanup_fixture/stores/v14"
  for cleanup_repo in repo-a repo-b repo-c repo-offline repo-version-fail repo-custom \
    repo-control repo-escape repo-prerelease repo-absent-store \
    repo-absent-untrusted repo-absent-malformed repo-dangling-store no-pin; do
    git -C "$cleanup_code/$cleanup_repo" init -q
  done
  cp home/dot_local/lib/groundwork/update-lock.sh \
    "$cleanup_home/.local/lib/groundwork/update-lock.sh"
  install_fixture_watchdog_runner \
    "$cleanup_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_policy_clock "$cleanup_bin/date"

  check "validator-only policy watchdog hostile process groups"
  policy_runner="$cleanup_home/.local/share/groundwork/lib/maintenance-runner.sh"
  policy_harness="$cleanup_fixture/policy-runner-harness"
  cat >"$policy_harness" <<'SH'
#!/usr/bin/env bash
set -u
runner="$1"
label="$2"
shift 2
deadline=1
observe_deadline=1
# shellcheck disable=SC1090 # validator-owned generated runner
source "$runner"
run_bounded "$label" "$@"
SH
  policy_hostile="$cleanup_fixture/policy-hostile"
  cat >"$policy_hostile" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$$" >"$GROUNDWORK_POLICY_PID_FILE"
trap '' TERM
while :; do sleep 1; done
SH
  policy_delayed_failure="$cleanup_fixture/policy-delayed-failure"
  cat >"$policy_delayed_failure" <<'SH'
#!/usr/bin/env bash
sleep 0.05
exit 1
SH
  policy_grandchild="$cleanup_fixture/policy-grandchild"
  cat >"$policy_grandchild" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$$" >"$GROUNDWORK_POLICY_PID_FILE"
(trap '' TERM; while :; do sleep 1; done) &
printf '%s\n' "$!" >"$GROUNDWORK_POLICY_DESCENDANT_FILE"
exit 0
SH
  policy_failed_grandchild="$cleanup_fixture/policy-failed-grandchild"
  cat >"$policy_failed_grandchild" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$$" >"$GROUNDWORK_POLICY_PID_FILE"
(trap '' TERM; while :; do sleep 1; done) &
printf '%s\n' "$!" >"$GROUNDWORK_POLICY_DESCENDANT_FILE"
exit 3
SH
  policy_launch_interrupt="$cleanup_fixture/policy-launch-interrupt"
  cat >"$policy_launch_interrupt" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$$" >"$GROUNDWORK_POLICY_PID_FILE"
kill -TERM "$GROUNDWORK_POLICY_RUNNER_PID"
trap '' TERM
while :; do sleep 1; done
SH
  chmod +x "$policy_harness" "$policy_hostile" "$policy_delayed_failure" \
    "$policy_grandchild" "$policy_failed_grandchild" "$policy_launch_interrupt"

  policy_pid_file="$cleanup_fixture/policy.pid"
  # Normal completion and failure use the full fixture meta-watchdog. They
  # return immediately after the observed child exit, while avoiding a race
  # between a two-tick hostile-test deadline and process startup on a loaded
  # runner. Only deliberately hostile cases below accelerate the tick ceiling
  # after they publish a readiness receipt.
  "$policy_harness" "$policy_runner" "completed command" /usr/bin/true \
    >"$cleanup_fixture/policy-completed" 2>&1 \
    || fail "the fixture policy watchdog did not reap a completed command"
  set +e
  "$policy_harness" "$policy_runner" "failed command" /usr/bin/false \
    >"$cleanup_fixture/policy-failed" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 1 ]] \
    || fail "the fixture policy watchdog changed command status 1 to $cleanup_status"
  set +e
  "$policy_harness" "$policy_runner" "delayed failed command" "$policy_delayed_failure" \
    >"$cleanup_fixture/policy-delayed-failed" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 1 ]] \
    || fail "the fixture policy watchdog changed a delayed command status 1 to $cleanup_status"

  rm -f -- "$policy_pid_file"
  set +e
  GROUNDWORK_POLICY_COMMAND_DEADLINE_TICKS=2 \
    GROUNDWORK_POLICY_CANCEL_GRACE_TICKS=2 \
    GROUNDWORK_POLICY_PID_FILE="$policy_pid_file" \
    GROUNDWORK_TEST_POLICY_READY_FILE="$policy_pid_file" \
    "$policy_harness" "$policy_runner" "hanging command" "$policy_hostile" \
    >"$cleanup_fixture/policy-timeout" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 124 ]] \
    || fail "the fixture policy watchdog returned $cleanup_status instead of timeout 124"
  test -s "$policy_pid_file" \
    || fail "the hostile fixture did not publish its process-group receipt"
  policy_pgid="$(<"$policy_pid_file")"
  ! kill -0 -- "-$policy_pgid" 2>/dev/null \
    || fail "a TERM-resistant fixture survived the policy watchdog"

  policy_descendant_file="$cleanup_fixture/policy-descendant.pid"
  rm -f -- "$policy_pid_file" "$policy_descendant_file"
  set +e
  GROUNDWORK_POLICY_COMMAND_DEADLINE_TICKS=2 \
    GROUNDWORK_POLICY_CANCEL_GRACE_TICKS=2 \
    GROUNDWORK_POLICY_PID_FILE="$policy_pid_file" \
    GROUNDWORK_TEST_POLICY_READY_FILE="$policy_pid_file" \
    GROUNDWORK_POLICY_DESCENDANT_FILE="$policy_descendant_file" \
    "$policy_harness" "$policy_runner" "surviving grandchild" "$policy_grandchild" \
    >"$cleanup_fixture/policy-grandchild-timeout" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 70 ]] \
    || fail "a successful fixture that leaked a grandchild returned $cleanup_status instead of 70"
  test -s "$policy_pid_file" \
    || fail "the grandchild fixture did not publish its process-group receipt"
  policy_pgid="$(<"$policy_pid_file")"
  test -s "$policy_descendant_file" \
    || fail "the fixture watchdog did not reach the grandchild case"
  ! kill -0 -- "-$policy_pgid" 2>/dev/null \
    || fail "a fixture grandchild survived process-group cancellation"

  rm -f -- "$policy_pid_file" "$policy_descendant_file"
  set +e
  GROUNDWORK_POLICY_COMMAND_DEADLINE_TICKS=2 \
    GROUNDWORK_POLICY_CANCEL_GRACE_TICKS=2 \
    GROUNDWORK_POLICY_PID_FILE="$policy_pid_file" \
    GROUNDWORK_TEST_POLICY_READY_FILE="$policy_pid_file" \
    GROUNDWORK_POLICY_DESCENDANT_FILE="$policy_descendant_file" \
    "$policy_harness" "$policy_runner" "failed leader with grandchild" \
    "$policy_failed_grandchild" >"$cleanup_fixture/policy-failed-grandchild-output" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 3 ]] \
    || fail "a failed fixture leader with a grandchild lost original status 3 as $cleanup_status"
  grep -qF 'preserving original child status 3' \
    "$cleanup_fixture/policy-failed-grandchild-output" \
    || fail "the fixture watchdog did not report its preserved child status"
  test -s "$policy_pid_file" \
    || fail "the failed grandchild fixture did not publish its process-group receipt"
  policy_pgid="$(<"$policy_pid_file")"
  ! kill -0 -- "-$policy_pgid" 2>/dev/null \
    || fail "a failed fixture leader left its grandchild after cleanup"

  rm -f -- "$policy_pid_file"
  set +e
  GROUNDWORK_POLICY_COMMAND_DEADLINE_TICKS=20 \
    GROUNDWORK_POLICY_CANCEL_GRACE_TICKS=2 \
    GROUNDWORK_POLICY_PID_FILE="$policy_pid_file" \
    GROUNDWORK_TEST_POLICY_READY_FILE="$policy_pid_file" \
    "$policy_harness" "$policy_runner" "launch interruption" \
    "$policy_launch_interrupt" >"$cleanup_fixture/policy-launch-interrupt-output" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 143 ]] \
    || fail "an interruption during fixture launch returned $cleanup_status instead of 143"
  test -s "$policy_pid_file" \
    || fail "the launch-interruption fixture did not publish its process-group receipt"
  policy_pgid="$(<"$policy_pid_file")"
  ! kill -0 -- "-$policy_pgid" 2>/dev/null \
    || fail "an interrupted fixture launch left its process group running"

  rm -f -- "$policy_pid_file"
  set +e
  GROUNDWORK_POLICY_COMMAND_DEADLINE_TICKS=2 \
    GROUNDWORK_POLICY_CANCEL_GRACE_TICKS=2 \
    GROUNDWORK_TEST_POLICY_SHUTDOWN_UNCONFIRMED=1 \
    GROUNDWORK_POLICY_PID_FILE="$policy_pid_file" \
    GROUNDWORK_TEST_POLICY_READY_FILE="$policy_pid_file" \
    "$policy_harness" "$policy_runner" "unconfirmed fixture cleanup" "$policy_hostile" \
    >"$cleanup_fixture/policy-cleanup-unconfirmed" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 125 ]] \
    || fail "an unconfirmed fixture cleanup returned $cleanup_status instead of 125"
  test -s "$policy_pid_file" \
    || fail "the unconfirmed-cleanup fixture did not publish its process-group receipt"
  policy_pgid="$(<"$policy_pid_file")"
  kill -KILL -- "-$policy_pgid" 2>/dev/null || true
  for _ in {1..20}; do
    ! kill -0 -- "-$policy_pgid" 2>/dev/null && break
    sleep 0.05
  done
  ! kill -0 -- "-$policy_pgid" 2>/dev/null \
    || fail "the validator could not clean up its deliberately surviving fixture group"

  rm -f -- "$policy_pid_file" "$policy_descendant_file"
  set +e
  GROUNDWORK_POLICY_COMMAND_DEADLINE_TICKS=2 \
    GROUNDWORK_POLICY_CANCEL_GRACE_TICKS=2 \
    GROUNDWORK_TEST_POLICY_SHUTDOWN_UNCONFIRMED=1 \
    GROUNDWORK_POLICY_PID_FILE="$policy_pid_file" \
    GROUNDWORK_TEST_POLICY_READY_FILE="$policy_pid_file" \
    GROUNDWORK_POLICY_DESCENDANT_FILE="$policy_descendant_file" \
    "$policy_harness" "$policy_runner" "unconfirmed failed fixture cleanup" \
    "$policy_failed_grandchild" >"$cleanup_fixture/policy-failed-unconfirmed" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 125 ]] \
    || fail "an unconfirmed failed-fixture cleanup returned $cleanup_status instead of 125"
  grep -qF 'original child status: 3' "$cleanup_fixture/policy-failed-unconfirmed" \
    || fail "unconfirmed fixture cleanup lost original child status 3"
  test -s "$policy_descendant_file" \
    || fail "the failed unconfirmed-cleanup fixture did not publish its descendant receipt"
  policy_descendant="$(<"$policy_descendant_file")"
  kill -KILL "$policy_descendant" 2>/dev/null || true
  for _ in {1..20}; do
    ! kill -0 "$policy_descendant" 2>/dev/null && break
    sleep 0.05
  done
  ! kill -0 "$policy_descendant" 2>/dev/null \
    || fail "the validator could not clean up the failed fixture's surviving group"

  install_fixture_policy_runner \
    "$cleanup_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_policy_clock "$cleanup_bin/date"

  check "validator-only policy runner is direct and shell-isolated"
  policy_direct_bin="$cleanup_fixture/policy-direct-bin"
  policy_direct_ps_marker="$cleanup_fixture/policy-direct-ps-called"
  policy_direct_output="$cleanup_fixture/policy-direct-output"
  mkdir -p "$policy_direct_bin"
  cat >"$policy_direct_bin/ps" <<'SH'
#!/usr/bin/env bash
: >"$GROUNDWORK_POLICY_DIRECT_PS_MARKER"
exit 99
SH
  cat >"$cleanup_fixture/policy-direct-harness" <<'SH'
#!/usr/bin/env bash
set -u
runner="$1"
output="$2"
policy_state=before
policy_mutate() {
  policy_state=after
  printf 'fixture output\n'
  return 3
}
deadline=1
observe_deadline=1
# shellcheck disable=SC1090 # validator-owned generated runner
source "$runner"
status=0
run_bounded_capture "direct policy command" "$output" policy_mutate || status=$?
[[ "$status" -eq 3 ]]
[[ "$policy_state" == before ]]
SH
  chmod +x "$policy_direct_bin/ps" "$cleanup_fixture/policy-direct-harness"
  GROUNDWORK_POLICY_DIRECT_PS_MARKER="$policy_direct_ps_marker" \
    PATH="$policy_direct_bin:$PATH" \
    "$cleanup_fixture/policy-direct-harness" "$policy_runner" "$policy_direct_output" \
    || fail "the direct policy runner lost status or leaked shell state"
  grep -qxF 'fixture output' "$policy_direct_output" \
    || fail "the direct policy runner did not preserve captured output"
  test ! -e "$policy_direct_ps_marker" \
    || fail "the direct policy runner inspected the process table"

  check "groundwork-cleanup: read-only report, cadence, store discovery, partial repair"

  cp home/dot_local/bin/executable_groundwork-repos \
    "$cleanup_bin/groundwork-repos"
  cat >"$cleanup_home/.config/groundwork/repos.conf" <<EOF
root = $cleanup_code
max_depth = 3
include_worktrees = true
cache_ttl_seconds = 30
exclude = node_modules
trusted_pnpm_store_root = $cleanup_fixture/stores
EOF
  cat >"$cleanup_home/.config/groundwork/repos.local.conf" <<'EOF'
trusted_pnpm_store_root = relative/store
EOF
  printf '{"packageManager":"pnpm@11.1.0+sha512.fixture"}\n' >"$cleanup_code/repo-a/package.json"
  printf '{"packageManager":"pnpm@11.2.0"}\n' >"$cleanup_code/repo-b/package.json"
  printf '{"packageManager":"pnpm@10.0.0"}\n' >"$cleanup_code/repo-c/package.json"
  printf '{"packageManager":"pnpm@9.9.9"}\n' >"$cleanup_code/repo-offline/package.json"
  printf '{"packageManager":"pnpm@12.0.0"}\n' >"$cleanup_code/repo-version-fail/package.json"
  printf '{"packageManager":"pnpm@11.3.0"}\n' >"$cleanup_code/repo-custom/package.json"
  printf '{"packageManager":"pnpm@13.0.0"}\n' >"$cleanup_code/repo-absent-store/package.json"
  printf '{"packageManager":"pnpm@13.1.0"}\n' >"$cleanup_code/repo-absent-untrusted/package.json"
  printf '{"packageManager":"pnpm@13.2.0"}\n' >"$cleanup_code/repo-absent-malformed/package.json"
  printf '{"packageManager":"pnpm@14.0.0"}\n' >"$cleanup_code/repo-dangling-store/package.json"
  printf '%s\n' '{"packageManager":"pnpm@11.2.0\nforged"}' \
    >"$cleanup_code/repo-control/package.json"
  printf '%s\n' '{"packageManager":"pnpm@11.2.0\u001b[31m"}' \
    >"$cleanup_code/repo-escape/package.json"
  printf '{"packageManager":"pnpm@11.4.0-rc.1"}\n' \
    >"$cleanup_code/repo-prerelease/package.json"
  printf '{"packageManager":"pnpm@13.0.0"}\n' >"$cleanup_code/false-marker/package.json"
  printf '{"packageManager":"yarn@4.0.0"}\n' >"$cleanup_code/no-pin/package.json"
  mkdir -p "$cleanup_fixture/brew-cache" "$cleanup_fixture/npm-cache"

  cat >"$cleanup_bin/brew" <<'SH'
#!/usr/bin/env bash
case "${1:-}" in
  --cache)
    [[ -z "${BREW_CACHE_SENTINEL:-}" ]] || : >"$BREW_CACHE_SENTINEL"
    [[ -z "${BREW_CACHE_DELAY:-}" ]] || sleep "$BREW_CACHE_DELAY"
    [[ "${BREW_CACHE_STATUS:-0}" == "0" ]] || exit "$BREW_CACHE_STATUS"
    printf '%s\n' "$CLEANUP_BREW_CACHE"
    ;;
  autoremove | cleanup)
    printf 'brew %s\n' "$*" >>"$GROUNDWORK_TEST_LOG"
    if [[ "${BREW_SIGNAL_PARENT_ON_START:-0}" == "1" && "${1:-}" == "autoremove" ]]; then
      kill -TERM "$PPID"
      sleep 2
    fi
    if [[ "${BREW_EXIT_WITH_DESCENDANT:-0}" == "1" && "${1:-}" == "autoremove" ]]; then
      (trap '' TERM; sleep 30) &
      descendant=$!
      printf '%s\n' "$descendant" >"$BREW_DESCENDANT_PID_FILE"
      exit "${BREW_DESCENDANT_LEADER_STATUS:-0}"
    fi
    if [[ "${BREW_EXIT_WITH_SHORT_DESCENDANT:-0}" == "1" && "${1:-}" == "autoremove" ]]; then
      (sleep "${BREW_SHORT_DESCENDANT_DELAY:-1}") &
      descendant=$!
      [[ -z "${BREW_DESCENDANT_PID_FILE:-}" ]] \
        || printf '%s\n' "$descendant" >"$BREW_DESCENDANT_PID_FILE"
      exit "${BREW_DESCENDANT_LEADER_STATUS:-0}"
    fi
    if [[ "${BREW_RESIST_TERM:-0}" == "1" && "${1:-}" == "autoremove" ]]; then
      trap '' TERM
      printf '%s\n' "$$" >"$BREW_PARENT_PID_FILE"
      (trap '' TERM; sleep 30) &
      descendant=$!
      printf '%s\n' "$descendant" >"$BREW_DESCENDANT_PID_FILE"
      wait "$descendant"
    fi
    if [[ -n "${BREW_MAINTENANCE_DELAY:-}" ]]; then
      sleep "$BREW_MAINTENANCE_DELAY"
    fi
    if [[ "${BREW_SPAWN_DESCENDANT:-0}" == "1" && "${1:-}" == "autoremove" ]]; then
      sleep 30 &
      descendant=$!
      printf '%s\n' "$descendant" >"$BREW_DESCENDANT_PID_FILE"
      wait "$descendant"
    fi
    if [[ "${1:-}" == "cleanup" && -n "${BREW_CLEANUP_SUCCESS_SENTINEL:-}" ]]; then
      : >"$BREW_CLEANUP_SUCCESS_SENTINEL"
      [[ -z "${BREW_CLEANUP_POST_SUCCESS_DELAY:-}" ]] \
        || sleep "$BREW_CLEANUP_POST_SUCCESS_DELAY"
    fi
    exit "${BREW_MAINTENANCE_STATUS:-0}"
    ;;
esac
SH
  cat >"$cleanup_bin/mise" <<'SH'
#!/usr/bin/env bash
if [[ "${1:-}" == "which" && "${2:-}" == "npm" ]]; then
  exit "${MISE_WHICH_STATUS:-0}"
