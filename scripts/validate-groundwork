  check "workflow timeout checker behaves as specified"
  # The checker is proven against fixtures rather than by mutating live workflow
  # files: an earlier red-proof did exactly that and left a workflow temporarily
  # broken when its own unbounded loop was killed. Each fixture pins one branch.
  timeout_fixtures="tests/fixtures/workflow-timeouts"
  expect_timeout_check() {
    local want="$1" dir="$2" needle="$3" out rc
    set +e
    out="$(scripts/check-workflow-timeouts "$timeout_fixtures/$dir" 2>&1)"
    rc=$?
    set -e
    if [[ "$rc" != "$want" ]]; then
      echo "workflow-timeout checker: $dir exited $rc, expected $want" >&2
      echo "$out" >&2
      exit 1
    fi
    if [[ "$needle" != "-" && "$out" != *"$needle"* ]]; then
      echo "workflow-timeout checker: $dir output missing \"$needle\"" >&2
      echo "$out" >&2
      exit 1
    fi
  }
  expect_timeout_check 0 valid "ok: every job"
  expect_timeout_check 0 valid-yaml-ext "ok: every job"
  expect_timeout_check 0 reusable "ok: every job"
  expect_timeout_check 1 missing "has no timeout-minutes"
  expect_timeout_check 1 noninteger "must be a positive integer"
  expect_timeout_check 1 zero "must be greater than zero"
  expect_timeout_check 1 over-max "exceeds the 60-minute ceiling"
  expect_timeout_check 1 reusable-unpinned "not pinned to a full 40-character SHA"
  expect_timeout_check 1 reusable-with-timeout "must not declare timeout-minutes"
  expect_timeout_check 1 multi "has no timeout-minutes"

  check "every CI job declares a bounded timeout"
  scripts/check-workflow-timeouts >/dev/null

  check "workflow toolchain checker behaves as specified"
  # Same fixture discipline as the timeout checker: never mutate live workflow
  # files to produce a red proof. The fixture scripts also prove the reaching-set
  # fixpoint, because the job calls a wrapper rather than the Node tooling.
  toolchain_fixtures="tests/fixtures/workflow-toolchain"
  expect_workflow_toolchain() {
    local want="$1" dir="$2" needle="$3" out rc
    set +e
    out="$(scripts/check-workflow-toolchain "$toolchain_fixtures/$dir" "$toolchain_fixtures" 2>&1)"
    rc=$?
    set -e
    if [[ "$rc" != "$want" ]]; then
      echo "workflow-toolchain checker: $dir exited $rc, expected $want" >&2
      echo "$out" >&2
      exit 1
    fi
    if [[ "$needle" != "-" && "$out" != *"$needle"* ]]; then
      echo "workflow-toolchain checker: $dir output missing \"$needle\"" >&2
      echo "$out" >&2
      exit 1
    fi
  }
  expect_workflow_toolchain 0 provisioned "ok: every job"
  expect_workflow_toolchain 0 unrelated "ok: every job"
  expect_workflow_toolchain 1 unprovisioned "without actions/setup-node"
  expect_workflow_toolchain 1 no-corepack "without enabling Corepack"
  expect_workflow_toolchain 1 literal-version "single Node authority"

  check "every CI job running repository Node tooling provisions it"
  scripts/check-workflow-toolchain >/dev/null

  check "repository hooks fail closed and stay inside their budget"
  # Hooks are opt-in (git config core.hooksPath .githooks), so nothing else
  # notices when one rots. The budget itself is the contract
  # (specs/verification-and-proof.md → Hook budget): a hook that grows into the
  # full suite makes every commit pay for proof the validator runs again.
  for hook in .githooks/pre-commit .githooks/pre-push; do
    [[ -f "$hook" ]] || fail "$hook is missing"
    # Without the executable bit git skips the hook silently, which reads
    # exactly like a passing gate.
    [[ -x "$hook" ]] || fail "$hook is not executable"
    grep -qx 'set -euo pipefail' "$hook" || fail "$hook does not fail closed"
    grep -qF 'git rev-parse --show-toplevel' "$hook" \
      || fail "$hook does not bind to the repository root"
    # Compare against what the hook runs, not what its comments explain.
    hook_commands="$(grep -vE '^[[:space:]]*(#|$)' "$hook")"
    grep -qF 'validate-groundwork' <<<"$hook_commands" \
      && fail "$hook must not run the full validator; that is an explicit command"
    grep -qE 'check:outdated|show-outdated' <<<"$hook_commands" \
      && fail "$hook must not run network-backed proof"
  done
  grep -qF 'node --test' .githooks/pre-commit \
    && fail "pre-commit must stay cheap; the test suite belongs in pre-push"
  true

  check "environment profile: browser resolution, reporting, and hostile arguments"
  # The browser vertical slice consumes the stored posture while preserving the
  # safe-mutating contract: show/set/help and invalid input do not change state.
  profile_dir="$out_dir/profile"
  mkdir -p "$profile_dir"
  render_profile() {
    local posture="$1" work="$2" headless="$3" output="$4"
    local role="$5" preset="$6"
    local xcode="${7:-false}" beta="${8:-false}"
    local data="{${base_data%%,\"profile_preset\"*},\"profile_preset\":\"${preset}\",\"environment_role\":\"${role}\",\"release_posture\":\"${posture}\",\"terminal_multiplexer\":\"herdr\",\"work\":${work},\"headless\":${headless},\"xcode\":${xcode},\"beta\":${beta},\"chezmoi\":{\"os\":\"darwin\",\"arch\":\"arm64\",\"osRelease\":{}}}"
    chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" \
      --override-data "$data" execute-template \
      <home/dot_local/bin/executable_groundwork-profile.tmpl >"$output"
    chmod +x "$output"
  }

  render_profile current false false "$profile_dir/personal-current" personal personal-current
  render_profile preview false false "$profile_dir/personal-preview" personal personal-preview
  render_profile current true false "$profile_dir/managed" managed work-managed
  render_profile preview false false "$profile_dir/disposable" disposable disposable-experimental
  render_profile current false true "$profile_dir/headless" personal personal-current
  render_profile current false false "$profile_dir/xcode-beta" personal personal-current true true
  render_profile current false false "$profile_dir/xcode-beta-inactive" personal personal-current false true

  # The role is derived from the existing `work` answer, never asked twice.
  # Role is stored, not derived: a bool could not express three roles.
  grep -q '^role="personal"' "$profile_dir/personal-current"
  grep -q '^role="managed"' "$profile_dir/managed"
  grep -q '^role="disposable"' "$profile_dir/disposable"
  grep -q '^posture="preview"' "$profile_dir/personal-preview"

  # `show` reports the stored posture and the invariants that posture cannot
  # change. Capture to a file first: `cmd | grep -q` closes the pipe on the first
  # match, and the SIGPIPE that kills the producer surfaces through pipefail.
  profile_out() {
    HOME="$profile_home" PATH="$profile_stub_bin:$PATH" GROUNDWORK_PROFILE_CONFIGURE_LOG="$profile_configure_log" \
      "$1" "${@:2}" >"$profile_dir/output" 2>&1
    cat "$profile_dir/output"
  }
  profile_home="$profile_dir/home"
  profile_stub_bin="$profile_home/.local/bin"
  profile_configure_log="$profile_dir/configure-invoked"
  mkdir -p "$profile_stub_bin"
  cat >"$profile_stub_bin/groundwork-configure" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >"${GROUNDWORK_PROFILE_CONFIGURE_LOG}"
echo "configuration transaction delegated"
STUB
  chmod +x "$profile_stub_bin/groundwork-configure"
  profile_out "$profile_dir/personal-preview" show | grep -Fq 'Release posture   preview'
  profile_out "$profile_dir/xcode-beta" show | grep -Fq 'Xcode             enabled'
  profile_out "$profile_dir/xcode-beta" show | grep -Fq 'Xcode beta        enabled'
  profile_out "$profile_dir/xcode-beta-inactive" show | grep -Fq 'Xcode beta        inactive (stored enabled)'
  profile_out "$profile_dir/personal-current" show | grep -Fq 'Xcode beta        disabled'
  profile_out "$profile_dir/personal-current" show | grep -Fq 'Release posture   current'
  profile_out "$profile_dir/personal-current" show | grep -Fq 'Multiplexer       herdr'
  profile_out "$profile_dir/managed" show | grep -Fq 'Role              managed'
  profile_out "$profile_dir/disposable" show | grep -Fq 'Role              disposable'
  # A managed machine must say policy outranks the profile, never imply a bypass.
  profile_out "$profile_dir/managed" show | grep -Fq 'never works around policy'
  profile_out "$profile_dir/personal-current" show | grep -Fq 'Bootstrap seed    personal-current'
  profile_out "$profile_dir/headless" show | grep -Fq 'no desktop apps, so posture has no effect'
  profile_out "$profile_dir/personal-preview" show | grep -Fq 'AI tools (no intentional release delay)'
  profile_out "$profile_dir/personal-preview" show | grep -Fq 'release-age floors'
  profile_out "$profile_dir/personal-current" show | grep -Fq 'Managed browser   Google Chrome stable'
  profile_out "$profile_dir/personal-preview" show | grep -Fq 'Managed browser   Google Chrome Beta'
  profile_out "$profile_dir/personal-preview" show | grep -Fq 'Browser fallback  Google Chrome stable'
  profile_out "$profile_dir/managed" show | grep -Fq 'Managed browser   Google Chrome stable'
  profile_out "$profile_dir/headless" show | grep -Fq 'Managed browser   none (headless)'

  # `set` is the narrow shortcut into the same guarded settings transaction.
  rm -f "$profile_configure_log"
  profile_out "$profile_dir/personal-current" set preview | grep -Fq 'configuration transaction delegated'
  grep -qx -- '--release-posture preview' "$profile_configure_log" \
    || fail "groundwork-profile set preview must delegate the exact posture to groundwork-configure"
  # Idempotent: setting the active posture changes nothing.
  rm -f "$profile_configure_log"
  profile_out "$profile_dir/personal-preview" set preview | grep -Fq 'already preview'
  [[ ! -e "$profile_configure_log" ]] \
    || fail "groundwork-profile must not open a configuration transaction for an already-active posture"

  expect_profile_exit() {
    local want="$1" name="$2"
    shift 2
    local rc=0
    HOME="$profile_home" PATH="$profile_stub_bin:$PATH" GROUNDWORK_PROFILE_CONFIGURE_LOG="$profile_configure_log" \
      "$profile_dir/personal-current" "$@" >/dev/null 2>&1 || rc=$?
    if [[ "$rc" != "$want" ]]; then
      echo "groundwork-profile $name exited $rc, expected $want" >&2
      exit 1
    fi
  }
  expect_profile_exit 0 "--help" --help
  expect_profile_exit 0 "show" show
  expect_profile_exit 64 "unknown option" --bogus
  expect_profile_exit 64 "unknown command" frobnicate
  expect_profile_exit 64 "invalid posture" set sideways
  expect_profile_exit 64 "set with no posture" set
  expect_profile_exit 64 "no command"
  expect_profile_exit 64 "extra positional argument" show extra junk

  # Help, show, and invalid input must not touch chezmoi or the settings editor.
  # Stubs that log calls prove it rather than merely reading the code.
  cat >"$profile_stub_bin/chezmoi" <<'STUB'
#!/usr/bin/env bash
echo "chezmoi was invoked" >"${GROUNDWORK_PROFILE_STUB_LOG}"
exit 0
STUB
  chmod +x "$profile_stub_bin/chezmoi"
  profile_stub_log="$profile_dir/chezmoi-invoked"
  for profile_case in --help show --bogus frobnicate "set sideways"; do
    rm -f "$profile_stub_log" "$profile_configure_log"
    # shellcheck disable=SC2086
    HOME="$profile_home" PATH="$profile_stub_bin:$PATH" GROUNDWORK_PROFILE_STUB_LOG="$profile_stub_log" \
      GROUNDWORK_PROFILE_CONFIGURE_LOG="$profile_configure_log" \
      "$profile_dir/personal-current" $profile_case >/dev/null 2>&1 || true
    if [[ -f "$profile_stub_log" ]]; then
      echo "groundwork-profile $profile_case invoked chezmoi; only 'edit' may" >&2
      exit 1
    fi
    if [[ -f "$profile_configure_log" ]]; then
      echo "groundwork-profile $profile_case invoked groundwork-configure before accepting a valid change" >&2
      exit 1
    fi
  done

  check "doctor: managed browser report follows profile and remains read-only"
  browser_doctor="$profile_dir/browser-doctor"
  mkdir -p "$browser_doctor/bin"
  cat >"$browser_doctor/bin/uname" <<'SH'
#!/usr/bin/env bash
echo Darwin
SH
  cat >"$browser_doctor/bin/chezmoi" <<'SH'
#!/usr/bin/env bash
[[ "$*" == "data --format=json" ]] || exit 2
printf '%s\n' "$DOCTOR_BROWSER_DATA"
SH
  cat >"$browser_doctor/bin/brew" <<'SH'
#!/usr/bin/env bash
[[ "${1:-} ${2:-}" == "list --cask" ]] || exit 2
case " ${INSTALLED_CASKS:-} " in
  *" ${3:-} "*) exit 0 ;;
  *) exit 1 ;;
esac
SH
  chmod +x "$browser_doctor/bin/uname" "$browser_doctor/bin/chezmoi" "$browser_doctor/bin/brew"
  run_browser_doctor() {
    env PATH="$browser_doctor/bin:$PATH" DOCTOR_BROWSER_DATA="$1" INSTALLED_CASKS="$2" \
      /bin/bash home/dot_local/bin/executable_groundwork-doctor --browser
  }
  browser_doctor_out="$(run_browser_doctor \
    '{"headless":false,"release_posture":"current","environment_role":"personal","xcode":false,"beta":false}' \
    'google-chrome')"
  grep -qF 'Current release posture: stable' <<<"$browser_doctor_out"
  grep -qF 'Xcode: disabled' <<<"$browser_doctor_out"
  grep -qF 'Xcode beta channel: disabled' <<<"$browser_doctor_out"
  grep -qF 'ok    Google Chrome stable is installed' <<<"$browser_doctor_out"
  assert_not_contains 'Chrome Beta is installed' <(printf '%s\n' "$browser_doctor_out") \
    "current browser doctor reported Beta as managed"
  browser_doctor_out="$(run_browser_doctor \
    '{"headless":false,"release_posture":"preview","environment_role":"personal","xcode":true,"beta":true}' \
    'google-chrome google-chrome@beta')"
  grep -qF 'Current release posture: preview' <<<"$browser_doctor_out"
  grep -qF 'Xcode: enabled' <<<"$browser_doctor_out"
  grep -qF 'Xcode beta channel: enabled' <<<"$browser_doctor_out"
  grep -qF 'Chrome Beta is installed as the primary preview browser' <<<"$browser_doctor_out"
  grep -qF 'stable Chrome remains installed as the compatibility fallback' <<<"$browser_doctor_out"
  browser_doctor_out="$(run_browser_doctor \
    '{"headless":false,"release_posture":"current","environment_role":"managed","xcode":false,"beta":true}' \
    'google-chrome')"
  grep -qF 'device policy outrank this selection' <<<"$browser_doctor_out"
  grep -qF 'Xcode beta is enabled while Xcode is disabled' <<<"$browser_doctor_out"
  browser_doctor_out="$(run_browser_doctor \
    '{"headless":false,"release_posture":"broken","environment_role":"personal","xcode":false,"beta":true}' \
    'google-chrome')"
  grep -qF "release_posture is 'broken'" <<<"$browser_doctor_out" \
    || fail "doctor must report an invalid release posture"
  grep -qF 'Xcode beta is enabled while Xcode is disabled' <<<"$browser_doctor_out" \
    || fail "invalid posture must not suppress the independent Xcode beta diagnostic"
  assert_not_contains 'Google Chrome stable is installed' <(printf '%s\n' "$browser_doctor_out") \
    "invalid posture must suppress browser-installation claims"
  browser_doctor_out="$(run_browser_doctor \
    '{"headless":true,"release_posture":"preview","environment_role":"disposable","xcode":false,"beta":false}' '')"
  grep -qF 'Current release posture: preview' <<<"$browser_doctor_out"
  grep -qF 'headless profile selects no GUI browser' <<<"$browser_doctor_out"
  grep -qF -- '--browser' < <(/bin/bash home/dot_local/bin/executable_groundwork-doctor --help)

  check "doctor: a version-alias symlink is one owner, not two"
  # Real-machine regression, 2026-07-27. mise exposes installs/node/lts as a
  # symlink to the concrete version, so the SAME Corepack shim is reachable as
  # .../node/lts/bin/pnpm and .../node/24.18.0/bin/pnpm. Comparing those literally
  # made a correctly-migrated machine report "2 distinct pnpm owners" and "the node
  # on PATH is NOT mise's". Every scratch fixture used concrete directories, so
  # only the live migration exposed it — this keeps that evidence.
  alias_fixture="$out_dir/doctor-symlink-alias"
  mkdir -p "$alias_fixture/installs/node/24.18.0/bin" "$alias_fixture/stub"
  ln -sfn 24.18.0 "$alias_fixture/installs/node/lts"

  for alias_tool in node corepack pnpm; do
    printf '#!/bin/sh\necho stub\n' >"$alias_fixture/installs/node/24.18.0/bin/$alias_tool"
    chmod +x "$alias_fixture/installs/node/24.18.0/bin/$alias_tool"
  done

  # `mise which` answers with the CONCRETE path while PATH exposes the alias —
  # exactly the shape that produced the false positives.
  cat >"$alias_fixture/stub/mise" <<SH
#!/bin/sh
[ "\$1 \$2" = "which node" ] && echo "$alias_fixture/installs/node/24.18.0/bin/node"
exit 0
SH
  chmod +x "$alias_fixture/stub/mise"

  alias_resolved="$(
    PATH="$alias_fixture/installs/node/lts/bin:$alias_fixture/stub:/usr/bin:/bin" \
      /bin/bash -c '
      . /dev/stdin <<SOURCED
$(sed -n "/^pnpm_resolve()/,/^}/p" home/dot_local/bin/executable_groundwork-doctor)
SOURCED
      pnpm_resolve "'"$alias_fixture"'/installs/node/lts/bin/pnpm"
    ' 2>/dev/null || true
  )"
  alias_concrete="$(readlink -f "$alias_fixture/installs/node/24.18.0/bin/pnpm" 2>/dev/null || true)"
  [ -n "$alias_resolved" ] && [ "$alias_resolved" = "$alias_concrete" ] \
    || fail "pnpm_resolve must canonicalize a version-alias symlink to the concrete path (got '${alias_resolved:-none}', expected '$alias_concrete') — otherwise one owner reads as two"

  # And the doctor as a whole must not warn about competing owners in that shape.
  # Isolated PATH on purpose: with the real $PATH appended, the machine's own pnpm
  # is a genuine second owner and the check would fail for the wrong reason.
  PATH="$alias_fixture/installs/node/lts/bin:$alias_fixture/stub:/usr/bin:/bin" \
    /bin/bash home/dot_local/bin/executable_groundwork-doctor --node-toolchain \
    >"$out_dir/doctor-alias-out" 2>&1 || true
  if grep -qF 'distinct pnpm owners' "$out_dir/doctor-alias-out"; then
    fail "the doctor reported competing pnpm owners for one shim reached through a version alias"
  fi
  if grep -qF "is NOT mise's" "$out_dir/doctor-alias-out"; then
    fail "the doctor reported the managed Node as unmanaged when reached through a version alias"
  fi

  PNPM_HOME="$alias_fixture/pnpm-global/bin" \
    PATH="$alias_fixture/installs/node/lts/bin:$alias_fixture/stub:/usr/bin:/bin" \
    /bin/bash home/dot_local/bin/executable_groundwork-doctor --node-toolchain \
    >"$out_dir/doctor-global-bin-out" 2>&1 || true
  grep -qF "pnpm's global executable directory is outside PATH: $alias_fixture/pnpm-global/bin" \
    "$out_dir/doctor-global-bin-out" \
    || fail "the doctor did not identify a configured pnpm global executable directory outside PATH"
  grep -qF "Do not run 'pnpm setup'" "$out_dir/doctor-global-bin-out" \
    || fail "the doctor did not protect Groundwork-owned shell configuration from pnpm setup"
  grep -qF "pnpm add -D <package>" "$out_dir/doctor-global-bin-out" \
    || fail "the doctor did not recommend project-local Node CLI ownership"
  grep -qF 'mise use --minimum-release-age 5d --path' "$out_dir/doctor-global-bin-out" \
    || fail "the doctor did not recommend mise's personal npm-tool lane"
  grep -qF "compiler command is 'tsc'" "$out_dir/doctor-global-bin-out" \
    || fail "the doctor did not distinguish TypeScript's package and executable names"

  doctor_mise_repo="$alias_fixture/repo-with-competing-mise"
  doctor_groundwork_root="$PWD"
  mkdir -p "$doctor_mise_repo"
  printf '%s\n' '[tools]' 'node = "98.76.54"' 'pnpm = "87.65.43"' >"$doctor_mise_repo/mise.toml"
  printf '%s\n' '{"packageManager":"pnpm@87.65.43"}' >"$doctor_mise_repo/package.json"
  (
    cd "$doctor_mise_repo"
    PATH="$alias_fixture/installs/node/lts/bin:$alias_fixture/stub:/usr/bin:/bin" \
      /bin/bash "$doctor_groundwork_root/home/dot_local/bin/executable_groundwork-doctor" --node-toolchain
  ) >"$out_dir/doctor-competing-mise-out" 2>&1 || true
  grep -qF 'declares tools.pnpm' "$out_dir/doctor-competing-mise-out" \
    || fail "the doctor did not reject a repository mise.toml that declares pnpm"
  grep -qF 'package.json#packageManager is this repository' "$out_dir/doctor-competing-mise-out" \
    || fail "the doctor did not identify packageManager as the pnpm authority"

  check "Node/pnpm launcher: parent and nested child resolve one toolchain"
  # The defect this pins: a top-level pnpm can be correct while a nested process
  # (a Turbo task, a package script) re-resolves bare `pnpm` from PATH and gets a
  # DIFFERENT one. Groundwork's model is mise-owns-Node, Corepack-owns-pnpm; this
  # proves the model holds across the process boundary, not just at the prompt.
  #
  # A package script is the faithful minimum: it is exactly how Turbo children
  # re-resolve. Using Turbo itself would add an install without changing what is
  # being proven.
  launcher_node="$(mise which node 2>/dev/null || command -v node 2>/dev/null || true)"
  if [ -z "$launcher_node" ] || [ ! -x "$launcher_node" ]; then
    if [[ "${GROUNDWORK_REQUIRE_NODE_TOOLCHAIN:-0}" == "1" ]]; then
      fail "the required Node launcher fixture has no executable Node"
    fi
    skip_current_check requires-node-toolchain \
      "no Node available for the launcher fixture"
  elif ! "$(dirname "$launcher_node")/corepack" --version >/dev/null 2>&1; then
    # Corepack is the owner in this model; without it there is nothing to assert.
    if [[ "${GROUNDWORK_REQUIRE_NODE_TOOLCHAIN:-0}" == "1" ]]; then
      fail "the required Node launcher fixture has no Corepack beside the active Node"
    fi
    skip_current_check requires-corepack \
      "Corepack is not present beside the active Node"
  else
    launcher_dir="$out_dir/launcher-fixture"
    # Corepack fetches a pinned pnpm on demand; keep that out of the user's cache
    # so the validator neither depends on nor mutates real machine state.
    export COREPACK_HOME="$out_dir/launcher-corepack-home"
    launcher_bin="$launcher_dir/bin"
    mkdir -p "$launcher_bin" "$launcher_dir/repo"
    # Deliberately not the version any ambient pnpm reports: if resolution is
    # wrong, the assertion must fail rather than coincidentally pass.
    launcher_pnpm_version="11.9.0"
    node_bin_dir="$(cd "$(dirname "$launcher_node")" && pwd)"

    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 "$node_bin_dir/corepack" enable pnpm \
      --install-directory "$launcher_bin" >/dev/null 2>&1 \
      || fail "corepack must be able to install a pnpm shim into a scratch directory"

    # PATH the fixture runs under: the Corepack shim first, the managed Node next,
    # and every mise standalone pnpm removed — i.e. the converged model.
    launcher_path="$launcher_bin:$node_bin_dir:$(
      printf '%s' "$PATH" | tr ':' '\n' | awk '!/\/mise\/installs\/pnpm\// && length' | paste -sd: -
    )"

    # The child script re-resolves BARE pnpm and node, exactly as a Turbo task does.
    cat >"$launcher_dir/repo/package.json" <<'LAUNCHER_JSON'
{
  "name": "groundwork-launcher-fixture",
  "private": true,
  "packageManager": "pnpm@LAUNCHER_PNPM_VERSION",
  "scripts": {
    "child": "pnpm --version && node --version"
  }
}
LAUNCHER_JSON
    # Render the single source of truth into the manifest.
    sed -i.bak "s/LAUNCHER_PNPM_VERSION/$launcher_pnpm_version/" "$launcher_dir/repo/package.json"
    rm -f "$launcher_dir/repo/package.json.bak"

    launcher_parent_pnpm="$(
      cd "$launcher_dir/repo" && PATH="$launcher_path" COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
        pnpm --version 2>/dev/null || true
    )"
    [ "$launcher_parent_pnpm" = "$launcher_pnpm_version" ] \
      || fail "bare pnpm must honor the fixture's packageManager pin (got '${launcher_parent_pnpm:-none}', expected $launcher_pnpm_version)"

    launcher_child="$(
      cd "$launcher_dir/repo" && PATH="$launcher_path" COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
        pnpm run --silent child 2>/dev/null || true
    )"
    launcher_child_pnpm="$(printf '%s\n' "$launcher_child" | sed -n '1p')"
    launcher_child_node="$(printf '%s\n' "$launcher_child" | sed -n '2p')"
    launcher_parent_node="$("$launcher_node" --version 2>/dev/null || true)"

    [ "$launcher_child_pnpm" = "$launcher_parent_pnpm" ] \
      || fail "a nested package script resolved pnpm '${launcher_child_pnpm:-none}' but the parent resolved '$launcher_parent_pnpm' — nested processes must not re-resolve a different pnpm"
    [ "$launcher_child_node" = "$launcher_parent_node" ] \
      || fail "a nested package script resolved node '${launcher_child_node:-none}' but the parent resolved '$launcher_parent_node'"

    # The negative case builds its OWN competing pnpm. Depending on the host
    # already having a stray install would make this silently vanish after a
    # successful migration or in clean CI — exactly when it matters most.
    launcher_bad_bin="$launcher_dir/bad-bin"
    mkdir -p "$launcher_bad_bin"
    cat >"$launcher_bad_bin/pnpm" <<'LAUNCHER_BAD'
#!/bin/sh
echo "0.0.0-competing"
LAUNCHER_BAD
    chmod +x "$launcher_bad_bin/pnpm"

    launcher_shadowed="$(
      cd "$launcher_dir/repo" && PATH="$launcher_bad_bin:$launcher_path" \
        COREPACK_ENABLE_DOWNLOAD_PROMPT=0 pnpm --version 2>/dev/null || true
    )"
    [ "$launcher_shadowed" = "0.0.0-competing" ] \
      || fail "the fixture cannot demonstrate shadowing (got '${launcher_shadowed:-none}') — it would pass even when the ownership model is broken"

    # …and the positive path must still hold immediately afterwards, so the
    # negative case cannot leave the fixture in a state that fakes success.
    launcher_recheck="$(
      cd "$launcher_dir/repo" && PATH="$launcher_path" COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
        pnpm --version 2>/dev/null || true
    )"
    [ "$launcher_recheck" = "$launcher_pnpm_version" ] \
      || fail "after the shadowing case the Corepack path must still resolve $launcher_pnpm_version (got '${launcher_recheck:-none}')"
  fi

  check "line endings stay LF"
  grep -q '^\* text=auto eol=lf$' .gitattributes
  assert_no_matches "CRLF line endings found in tracked files" git grep -Il $'\r' -- .

  check "common secret patterns"
  assert_no_matches "secret-like pattern found" git grep -n -E '(-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35})'

  if [[ -n "${GROUNDWORK_PUBLIC_DENYLIST_PATTERN:-}" ]]; then
    check "local public denylist env pattern"
    assert_no_matches "local public denylist env pattern matched" rg -n "$GROUNDWORK_PUBLIC_DENYLIST_PATTERN" . --hidden -g '!.git' -g '!node_modules'
  fi

  if [[ -f .groundwork-public-denylist ]]; then
    check "local public denylist file"
    while IFS= read -r pattern; do
      [[ -z "$pattern" || "$pattern" == \#* ]] && continue
      assert_no_matches "local public denylist file pattern matched" rg -n "$pattern" . --hidden -g '!.git' -g '!node_modules' -g '!.groundwork-public-denylist'
    done <.groundwork-public-denylist
  fi

  check "update-flow safety contract"
  # `chezmoi apply --force` would turn the overwrite question into silent data
  # loss: local drift gets clobbered with no prompt. The drift preflight in
  # update-all names the files and chezmoi asks — force is never the answer.
  assert_no_matches "chezmoi apply --force silently clobbers local drift; the apply must ask" \
    rg -n -g '!validate-groundwork' 'chezmoi (apply|update)[^#]*--force' home bootstrap-mac.sh docker scripts
  # Disabling Homebrew's tap-trust check would reopen the supply-chain gate it
  # exists to close; per-formula `brew trust` is the documented narrow path.
  assert_no_matches "never disable Homebrew tap trust; trust specific formulae instead" \
    rg -n 'HOMEBREW_NO_REQUIRE_TAP_TRUST' home bootstrap-mac.sh docker
  # The declined-reset branch is the steady state on most machines and must be
  # SILENT on routine updates — a future template edit must not quietly bring
  # back per-run no-op chatter. (Static guard first: this render must be the
  # declined branch, so running it can never move real files.)
  render linux false amd64 home/run_before_06-reset-conflicting-configs.sh.tmpl \
    "$out_dir/reset-declined.sh"
  if grep -qF 'move_path' "$out_dir/reset-declined.sh"; then
    fail "the reset render unexpectedly produced the ACTIVE branch; refusing to run it"
  fi
  reset_declined_home="$out_dir/reset-declined-home"
  mkdir -p "$reset_declined_home"
  HOME="$reset_declined_home" bash "$out_dir/reset-declined.sh" \
    >"$out_dir/reset-declined-out" 2>&1 \
    || fail "the declined reset branch must exit 0"
  test ! -s "$out_dir/reset-declined-out" \
    || fail "the declined reset branch must produce no output on routine updates"

  check "old name residue"
  assert_no_matches "old name residue found" rg -n "Primer|primer|mac-dev-primer|Mac Dev|MAC_DEV_PRIMER|validate-primer|jasondockery/mac-dev-primer|PRIMER" . --hidden -g '!.git' -g '!node_modules' -g '!scripts/validate-groundwork'

  check "discovery artifacts current (descriptions, sitemap, llms.txt)"
  scripts/generate-discovery --check

  check "discovery generator: fingerprint registry, lifecycle, and git independence"
  # Replaces the old shallow-clone contract. Sitemap freshness now comes from
  # each page's content digest in data/docs-fingerprints.json, so git history is
  # not an input at all: a squash merge, a rebase, and a depth-1 clone each
  # produce byte-identical artifacts. The suite also pins the fail-closed
  # registry behavior — an untrusted registry must stop the run rather than
  # restamp every page. See tests/test_generate_discovery.py.
  python3 tests/test_generate_discovery.py

  # The real checkout must also be depth-1 correct, not just the fixtures: the
  # working-tree generator run inside a shallow clone of this repository has to
  # agree with the full checkout it was cloned from. file:// forces the
  # transport that honors --depth (a plain path hardlink-clones and ignores it).
  shallow_dir="$(mktemp -d "${TMPDIR:-/tmp}/groundwork-shallow.XXXXXX")"
  git clone --quiet --depth 1 "file://$PWD/.git" "$shallow_dir/repo"
  cp scripts/generate-discovery "$shallow_dir/repo/scripts/generate-discovery"
  if ! (cd "$shallow_dir/repo" && python3 scripts/generate-discovery --check) \
    >"$shallow_dir/out" 2>&1; then
    echo "generate-discovery disagreed with the full checkout in a depth-1 clone" >&2
    cat "$shallow_dir/out" >&2
    rm -rf "$shallow_dir"
    exit 1
  fi
  rm -rf "$shallow_dir"

  check "whitespace"
  git diff --check
}

validate_platform_native_processes() {
  local platform_apply_destination platform_fixture platform_home process_start
  local modified canonical_sh deadline observe_deadline heartbeat cancel_grace
  local poll_seconds orphan_grace

  check "macOS representative rendered apply smoke"
  if [[ "$(uname -s)" == "Darwin" ]]; then
    platform_apply_destination="$out_dir/platform-macos-apply-home"
    chezmoi --config "$empty_config" --source "$PWD" \
      --destination "$platform_apply_destination" \
      --override-data '{"headless":false,"chezmoi":{"os":"darwin","arch":"arm64"}}' \
      apply --dry-run --verbose --no-tty --source-path home/dot_config/ghostty/config.tmpl \
      >"$out_dir/platform-macos-apply.diff" 2>"$out_dir/platform-macos-apply.err" \
      || fail "the representative macOS apply dry-run failed"
    grep -qF 'copy-on-select = false' "$out_dir/platform-macos-apply.diff" \
      || fail "the representative macOS apply dry-run did not render the platform contract"
    test ! -e "$platform_apply_destination/.config/ghostty/config" \
      || fail "the representative macOS dry-run mutated its destination"
  elif [[ "$suite" == "platform-macos" && "${GROUNDWORK_FULL_COMPOSITION:-0}" != "1" ]]; then
    fail "the platform-macos suite must run on a macOS host"
  else
    skip_current_check requires-macos-native-host \
      "macOS representative apply smoke requires macOS"
  fi

  check "macOS native process and filesystem primitives"
  if [[ "$(uname -s)" != "Darwin" ]]; then
    if [[ "$suite" == "platform-macos" && "${GROUNDWORK_FULL_COMPOSITION:-0}" != "1" ]]; then
      fail "the platform-macos suite must run on a macOS host"
    fi
    skip_current_check requires-macos-native-host \
      "macOS native process and filesystem primitives require macOS"
    skip_platform_only_check "Homebrew interactive terminal ownership" \
      requires-macos-native-host \
      "Homebrew interactive terminal ownership requires macOS"
    return
  fi

  platform_fixture="$out_dir/platform-macos-native"
  platform_home="$platform_fixture/home"
  mkdir -p "$platform_home/.local/state/groundwork" "$platform_fixture/bin"

  # Exercise the production BSD-compatible primitives instead of a GNU-shaped
  # stub: process identity comes from macOS ps, mtime falls through to BSD stat,
  # and canonicalization follows the real /usr/bin/readlink implementation.
  local HOME="$platform_home"
  # The absolute source path is runtime-selected from the checkout root.
  # shellcheck disable=SC1091
  source "$repo/home/dot_local/lib/groundwork/update-lock.sh"
  process_start="$(groundwork_lock_process_start "$$")"
  [[ -n "$process_start" ]] \
    || fail "macOS ps did not return a process-start identity"
  # Assigned by the production library above.
  # shellcheck disable=SC2154
  mkdir -p "$groundwork_lock_dir"
  modified="$(groundwork_lock_mtime "$groundwork_lock_dir")"
  [[ "$modified" =~ ^[0-9]+$ && "$modified" -gt 0 ]] \
    || fail "macOS stat did not return a numeric lock mtime"

  # shellcheck disable=SC1091
  source "$repo/home/dot_local/share/groundwork/lib/docker-scan.sh"
  canonical_sh="$(gw_docker_canonical_executable /bin/sh)"
  [[ "$canonical_sh" == /* && -x "$canonical_sh" ]] \
    || fail "macOS readlink canonicalization rejected /bin/sh"

  cat >"$platform_fixture/bin/brew" <<'SH'
#!/usr/bin/env bash
(sleep 1) &
exit 0
SH
  chmod +x "$platform_fixture/bin/brew"

  # These are the production library's documented runtime knobs.
  # shellcheck disable=SC2034
  local deadline=8 observe_deadline=8 heartbeat=2 cancel_grace=1 poll_seconds=0.1 orphan_grace=3
  # shellcheck disable=SC1091
  source "$repo/home/dot_local/share/groundwork/lib/maintenance-runner.sh"
  run_bounded_internal "brew autoremove descendant-drain regression" 8 \
    "$platform_fixture/brew-output" "$platform_fixture/bin/brew" autoremove \
    || fail "a naturally draining Homebrew descendant failed on macOS"

  check "Homebrew interactive terminal ownership"
  "$repo/scripts/test-brew-terminal-output" \
    || fail "interactive Homebrew output lost terminal ownership or bounded status"
}

validate_static() {
  validate_static_foundation
  validate_static_configuration
  validate_static_runtime
  validate_static_helpers
  validate_static_repository
}

validate_platform_macos() {
  validate_platform_terminal
  validate_platform_tmux
  validate_platform_native_processes
}

validate_full() {
  # Full composes the public focused entry points concurrently in fresh Bash
  # processes. Each focused invocation owns a separate temporary state root, so
  # independent suites share one outer deadline without sharing fixture state.
  # Receipts are still checked and merged in registry order after every child
  # finishes, keeping the final evidence deterministic.
  local entry focused_suite child_report child_status child_pid child_index=0
  local child_receipt_ok child_receipt_reason
  local -a focused_suites=() child_reports=() child_pids=() child_statuses=()
  for entry in "${suite_registry[@]}"; do
    IFS='|' read -r focused_suite _ <<<"$entry"
    child_report="$out_dir/full-$focused_suite.json"
    focused_suites+=("$focused_suite")
    child_reports+=("$child_report")
    GROUNDWORK_VALIDATION_DEADLINE_PARENT="$$" \
      GROUNDWORK_FULL_COMPOSITION=1 GROUNDWORK_SUPPRESS_SUMMARY=1 \
      "$repo/scripts/run-validation-child" -- \
      "$repo/scripts/validate-groundwork" --suite "$focused_suite" \
      --report "$child_report" &
    child_pids+=("$!")
  done

  for child_pid in "${child_pids[@]}"; do
    child_status=0
    wait "$child_pid" || child_status=$?
    child_statuses+=("$child_status")
  done

  for focused_suite in "${focused_suites[@]}"; do
    child_report="${child_reports[$child_index]}"
    child_status="${child_statuses[$child_index]}"
    if [[ ! -f "$child_report" ]]; then
      printf 'focused suite %s\t0\tfailed\t\tfocused suite produced no receipt\n' \
        "$focused_suite" >>"$timing_rows"
      fail "full composition received no receipt from focused suite $focused_suite"
    fi
    IFS=$'\t' read -r child_receipt_ok child_receipt_reason < <(
      python3 - "$child_report" "$timing_rows" "$focused_suite" "$source_before" "$repo" <<'PY'
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(sys.argv[5]) / "scripts"))
from ci_receipt import import_validation_child_receipt

passed, reason = import_validation_child_receipt(
    pathlib.Path(sys.argv[1]),
    pathlib.Path(sys.argv[2]),
    sys.argv[3],
    pathlib.Path(sys.argv[4]),
)
print(f"{'passed' if passed else 'failed'}\t{reason}")
PY
    )
    if [[ "$child_receipt_ok" != "passed" ]]; then
      fail "focused suite $focused_suite failed during full composition: $child_receipt_reason"
    fi
    if [[ "$child_status" -ne 0 ]]; then
      printf 'focused suite %s\t0\tfailed\t\tchild process exited %s despite a passing receipt\n' \
        "$focused_suite" "$child_status" >>"$timing_rows"
      fail "focused suite $focused_suite exited $child_status despite a passing receipt"
    fi
    child_index=$((child_index + 1))
  done
}

if [[ "$suite" == "full" ]]; then
  validate_full
else
  lookup_suite "$suite" || fail "suite registry changed after intent validation"
  "$suite_function"
fi

if [[ "$suite" == "full" ]]; then
  echo "ok: Groundwork validation passed"
else
  printf 'ok: Groundwork validation passed (suite: %s)\n' "$suite"
fi
