    fail "groundwork-app-adopt accepted a displayable but invalid signature"
  fi
  grep -qF 'signature failed strict verification' \
    "$adoption_fixture/signature-verification-failed"
  assert_not_contains '^brew install' "$adoption_fixture/commands.log" \
    "failed strict signature verification reached Homebrew adoption"
  for process_case in failed malformed; do
    case "$process_case" in
      failed) process_env=(ADOPT_PS_STATUS=9) ;;
      malformed) process_env=(ADOPT_PS_MALFORMED=1) ;;
    esac
