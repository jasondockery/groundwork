  [[ "$(grep -cF 'Please answer yes or no.' "$adoption_fixture/adopted")" -eq 2 ]] \
    || fail "groundwork-app-adopt treated nonliteral consent as authorization"
  grep -qxF 'brew install --cask --require-sha --adopt chatgpt' \
    "$adoption_fixture/commands.log" \
    || fail "groundwork-app-adopt did not use the exact safe adoption command"
  assert_not_contains '(^|[[:space:]])(--force|--zap|uninstall|remove|delete|reinstall)([[:space:]]|$)' \
    "$adoption_fixture/commands.log" \
    "groundwork-app-adopt reached a destructive Homebrew operation"
  rm -f "$adoption_home/.chatgpt-adopted"

  rm -f "$adoption_home/.adopt-plutil-count" "$adoption_home/.adopt-ps-count"
  : >"$adoption_fixture/commands.log"
  printf 'yes\n' >"$adoption_fixture/change-answer"
  if run_fixture_pty "$adoption_fixture/changed-after-consent" \
    "$adoption_fixture/change-answer" env "${adoption_env[@]}" \
    ADOPT_IDENTITY_CHANGE_AFTER_CONSENT=1 \
    /bin/bash home/dot_local/bin/executable_groundwork-app-adopt chatgpt; then
    fail "groundwork-app-adopt acted after bundle identity changed"
  fi
  grep -qF 'identity changed after consent' \
    "$adoption_fixture/changed-after-consent" \
    || fail "post-consent adoption identity drift was not named"
  assert_not_contains '^brew install' "$adoption_fixture/commands.log" \
    "post-consent adoption identity drift reached mutation"

  rm -f "$adoption_home/.adopt-codesign-verify-count" \
    "$adoption_home/.adopt-plutil-count" "$adoption_home/.adopt-ps-count"
  : >"$adoption_fixture/commands.log"
