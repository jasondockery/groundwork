#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/validate-groundwork [--suite <name>] [--report <path>]
       [--deadline-seconds <seconds>]
       scripts/validate-groundwork --list-suites

Suites:
  static          Source, rendered-profile, documentation, and helper contracts
  update          Update and package-manager maintenance contracts
  docker          Docker ownership, cleanup, and verification contracts
  platform-macos  Native macOS tmux, PTY, and process-runtime contracts
  full            Every canonical suite in dependency-preserving order (default)

Options:
  --report <path>                 Write the concise JSON receipt to this path
  --deadline-seconds <seconds>    Whole-suite hard deadline (suite-specific default)
  --list-suites                   List check families without running setup;
                                  parameterized cases remain symbolic
EOF
}

# One registry owns the public suite name, dispatcher, and check-list owners.
# Bash 3.2 has indexed arrays but not portable associative arrays, so each row
# is a pipe-delimited record whose fields are validated before any setup.
suite_registry=(
  'static|validate_static|validate_static_foundation validate_static_configuration validate_static_runtime validate_static_helpers validate_static_repository'
  'update|validate_update|validate_update'
  'docker|validate_docker|validate_docker'
  'platform-macos|validate_platform_macos|validate_platform_terminal validate_platform_tmux validate_platform_native_processes'
)
suite_function=""
suite_owners=""

lookup_suite() {
  local requested="$1" entry name function owners
  for entry in "${suite_registry[@]}"; do
    IFS='|' read -r name function owners <<<"$entry"
    if [[ "$name" == "$requested" ]]; then
      suite_function="$function"
      suite_owners="$owners"
      return 0
    fi
  done
  return 1
}

validate_suite_registry() {
  local expected='static update docker platform-macos' entry name function owners
  local actual="" owner
  for entry in "${suite_registry[@]}"; do
    [[ "$entry" != *$'\n'* && "$entry" != *$'\t'* ]] || return 64
    IFS='|' read -r name function owners <<<"$entry"
    [[ -n "$name" && -n "$function" && -n "$owners" ]] || return 64
    actual="${actual:+$actual }$name"
    case "$name:$function" in
      static:validate_static | update:validate_update | docker:validate_docker | \
        platform-macos:validate_platform_macos) ;;
      *) return 64 ;;
    esac
    for owner in $owners; do
      [[ "$owner" == validate_* ]] || return 64
    done
  done
  [[ "$actual" == "$expected" ]] || return 64
}

if ! validate_suite_registry; then
  echo "validate-groundwork: invalid canonical suite registry" >&2
  exit 64
fi

list_suite_checks() {
  local requested="$1" wanted entry name function owners
  if [[ "$requested" == "full" ]]; then
    for entry in "${suite_registry[@]}"; do
      IFS='|' read -r name function owners <<<"$entry"
      list_suite_checks "$name"
    done
    return
  fi
  lookup_suite "$requested" || return 64
  wanted=" $suite_owners "
  awk -v wanted="$wanted" '
    /^validate_[a-z0-9_]+\(\) \{/ {
      function_name = $1
      sub(/\(\)$/, "", function_name)
      active = index(wanted, " " function_name " ") > 0
      next
    }
    active && /^[[:space:]]*check "[^"]+"/ {
      line = $0
      sub(/^[[:space:]]*check "/, "", line)
      sub(/".*$/, "", line)
      print "  - " line
    }
  ' "${BASH_SOURCE[0]}"
}

canonical_check_observations_match() {
  local requested="$1" rows="$2" expected="$3" observed="$4"
  list_suite_checks "$requested" | sed 's/^  - //' >"$expected"
  cut -f 1 "$rows" >"$observed"
  cmp -s "$expected" "$observed"
}

list_suites() {
  local listed_suite entry function owners
  for entry in "${suite_registry[@]}"; do
    IFS='|' read -r listed_suite function owners <<<"$entry"
    printf '%s\n' "$listed_suite"
    list_suite_checks "$listed_suite"
  done
  printf 'full\n'
  list_suite_checks full
}

suite="full"
suite_set=0
report_path=""
report_set=0
deadline_seconds=""
deadline_set=0
list_requested=0
original_arguments=("$@")
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --help | -h)
      usage
      exit 0
      ;;
    --suite)
      [[ "$#" -ge 2 && -n "${2:-}" ]] || {
        usage >&2
        exit 64
      }
      suite="$2"
      suite_set=1
      shift 2
      ;;
    --report)
      [[ "$#" -ge 2 && -n "${2:-}" ]] || {
        usage >&2
        exit 64
      }
      report_path="$2"
      report_set=1
      shift 2
      ;;
    --deadline-seconds)
      [[ "$#" -ge 2 && -n "${2:-}" ]] || {
        usage >&2
        exit 64
      }
      deadline_seconds="$2"
      deadline_set=1
      shift 2
      ;;
    --list-suites)
      list_requested=1
      shift
      ;;
    *)
      usage >&2
      exit 64
      ;;
  esac
done
if [[ "$suite" != "full" ]] && ! lookup_suite "$suite"; then
  printf 'validate-groundwork: unknown suite: %s\n' "$suite" >&2
  usage >&2
  exit 64
fi
if [[ "$list_requested" -eq 1 ]]; then
  if [[ "$suite_set" -eq 1 || "$report_set" -eq 1 || "$deadline_set" -eq 1 ]]; then
    echo "validate-groundwork: --list-suites cannot be combined with a validation run" >&2
    exit 64
  fi
  list_suites
  exit 0
fi
if [[ "$deadline_set" -eq 1 ]]; then
  [[ "$deadline_seconds" =~ ^[1-9][0-9]*$ ]] || {
    echo "validate-groundwork: --deadline-seconds must be a positive integer" >&2
    exit 64
  }
else
  case "$suite" in
    static | docker) deadline_seconds=540 ;;
    update | platform-macos) deadline_seconds=840 ;;
    full) deadline_seconds=300 ;;
  esac
fi

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo"
shopt -s nullglob
timing_output="${report_path:-${GROUNDWORK_TIMING_OUTPUT:-}}"
if [[ -n "$timing_output" ]]; then
  python3 - "$repo" "$timing_output" <<'PY' || exit 64
import pathlib
import sys

repo = pathlib.Path(sys.argv[1]).resolve()
output = pathlib.Path(sys.argv[2]).expanduser().resolve()
if not output.parent.is_dir():
    print(f"validate-groundwork: report parent does not exist: {output.parent}", file=sys.stderr)
    raise SystemExit(1)
if output == repo or repo in output.parents:
    print("validate-groundwork: --report must be outside the tested repository", file=sys.stderr)
    raise SystemExit(1)
PY
fi
# This PID marker is an internal recursion guard, not a hostile-input security
# boundary or a supported way to disable the supervisor. The child receives it
# from run-validation-deadline and the exact parent relationship is checked.
if [[ "${GROUNDWORK_VALIDATION_DEADLINE_PARENT:-}" != "$PPID" ]]; then
  exec scripts/run-validation-deadline \
    --seconds "$deadline_seconds" --grace-seconds 5 -- \
    "$repo/scripts/validate-groundwork" \
    ${original_arguments[@]+"${original_arguments[@]}"}
fi
out_dir="$(mktemp -d "${TMPDIR:-/tmp}/groundwork-rendered.XXXXXX")"
timing_rows="$out_dir/validation-timings.tsv"
: >"$timing_rows"
copylast_control_pids=()
validation_started_epoch="$(date +%s)"
source_before="$out_dir/source-before.json"
source_after="$out_dir/source-after.json"
scripts/tree-fingerprint --repo "$repo" >"$source_before"
current_check_started_epoch="$validation_started_epoch"
current_check_active=0
current_check_skip_reason=""
current_check_skip_code=""
suite_hard_deadline_seconds="$deadline_seconds"
case "$suite" in
  static)
    suite_budget_seconds=55
    suite_scope="lint, docs, rendered profiles, and repository policy"
    proof_type="focused deterministic and rendered-artifact proof"
    exercises_real_clock=false
    exercises_real_processes=false
    ;;
  update)
    suite_budget_seconds=90
    suite_scope="update orchestration and package-manager maintenance"
    proof_type="focused fixture integration with real deadline and signal cases"
    exercises_real_clock=true
    exercises_real_processes=true
    ;;
  docker)
    suite_budget_seconds=75
    suite_scope="Docker lifecycle selection, cleanup, and image verification"
    proof_type="focused fixture integration with real deadline and signal cases"
    exercises_real_clock=true
    exercises_real_processes=true
    ;;
  platform-macos)
    suite_budget_seconds=15
    suite_scope="tmux, PTY, BSD primitives, and Homebrew process behavior"
    proof_type="focused native macOS integration proof"
    exercises_real_clock=true
    exercises_real_processes=true
    ;;
  full)
    suite_budget_seconds=270
    suite_scope="every canonical Groundwork validator suite"
    proof_type="complete single-host validator proof"
    exercises_real_clock=true
    exercises_real_processes=true
    ;;
esac

# GitHub-aware failure reporting. Locally this is inert: the EXIT trap only
# cleans up, `check` only echoes the progress line, and `fail` behaves exactly
# like the echo >&2 + exit 1 it replaces. In GitHub Actions the trap turns a
# failure into one ::error annotation naming the failing check, and appends a
# pass/fail summary to $GITHUB_STEP_SUMMARY. Summary/annotation writes are
# fail-open: they never change the script's exit status.
current_check="startup"
fail_reason=""

finish_current_check_timing() {
  local requested_result="$1" reason="${2:-}" skip_code="${3:-}" result now duration
  [[ "$current_check_active" -eq 1 ]] || return 0
  result="$requested_result"
  if [[ "$requested_result" == "passed" && -n "$current_check_skip_reason" ]]; then
    result="skipped"
    reason="$current_check_skip_reason"
    skip_code="$current_check_skip_code"
  fi
  now="$(date +%s)"
  duration=$((now - current_check_started_epoch))
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$current_check" "$duration" "$result" "$skip_code" "$reason" >>"$timing_rows"
  current_check_active=0
  current_check_skip_reason=""
  current_check_skip_code=""
}

check() {
  finish_current_check_timing passed
  current_check="$1"
  current_check_started_epoch="$(date +%s)"
  current_check_active=1
  current_check_skip_reason=""
  current_check_skip_code=""
  echo "check: $1"
}

mark_current_check_skipped() {
  local skip_code="$1" reason="$2"
  [[ "$current_check_active" -eq 1 && -n "$skip_code" && -n "$reason" ]] \
    || fail "invalid skipped-check lifecycle"
  [[ "$skip_code" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] \
    || fail "a skipped-check code is invalid: $skip_code"
  [[ "$reason" != *$'\n'* && "$reason" != *$'\r'* && "$reason" != *$'\t'* ]] \
    || fail "a skipped-check reason contains a control character"
  current_check_skip_code="$skip_code"
  current_check_skip_reason="$reason"
  printf '  skip [%s]: %s\n' "$skip_code" "$reason"
}

skip_current_check() {
  mark_current_check_skipped "$1" "$2"
  finish_current_check_timing skipped "$current_check_skip_reason" "$current_check_skip_code"
}

skip_platform_only_check() {
  local name="$1" skip_code="$2" reason="$3"
  check "$name"
  skip_current_check "$skip_code" "$reason"
}

fail() {
  fail_reason="$1"
  echo "$1" >&2
  exit 1
}

# Toolkit-exact annotation escaping (@actions/core's escapeData/escapeProperty).
#
# The contract and its test vectors live in Roost's `@roost/ci-diagnostics`
# (packages/ci-diagnostics/src/diagnostics.ts — escapeWorkflowData,
# escapeWorkflowProperty, capWorkflowPayload — with the shared cases in that
# package's src/vectors.json). This shell mirrors that TypeScript rather than
# vendoring it: a Node toolchain does not belong in a shell-first repo, so what
# travels between the repos is the contract, not the package. When the contract
# changes, change it there first and mirror it here.
#
# Order matters. `%` is escaped FIRST, or the `%` that the later escapes
# introduce would itself be escaped again (`\n` -> `%0A` -> `%250A`). CR and LF
# become %0D/%0A rather than being collapsed to spaces: both forms are
# injection-safe, since a workflow command is only recognized at the start of a
# line and neither form lets content open one, but the encoded form is also
# lossless — GitHub renders the annotation as the multi-line text it was.
# U+2028/U+2029 terminate a line for the runner's command parser exactly like
# LF, so they escape to %0A too.
annotation_max_length=500

# bash counts CODE POINTS in ${#s} and ${s:o:n} only under a multibyte locale;
# under C/POSIX it counts BYTES, and a cut at 499 bytes can land inside a
# multibyte character. A runner with no LANG set (GitHub's macOS images) is
# exactly that case, so the cap forces a locale of its own rather than inheriting
# whatever the caller happened to have. Assigning LC_ALL re-runs setlocale in the
# current shell — no subshell needed, and none wanted, since the capped string
# has to come back out.
annotation_saved_lc_all=""
annotation_saved_lc_all_set=0
annotation_force_locale() {
  annotation_saved_lc_all=""
  annotation_saved_lc_all_set=0
  if [[ -n "${LC_ALL+set}" ]]; then
    annotation_saved_lc_all="$LC_ALL"
    annotation_saved_lc_all_set=1
  fi
  LC_ALL="$1"
}

annotation_restore_locale() {
  if [[ "$annotation_saved_lc_all_set" -eq 1 ]]; then
    LC_ALL="$annotation_saved_lc_all"
  else
    unset LC_ALL
  fi
}

# Resolve a usable UTF-8 locale once, probing with a real 2-byte character rather
# than trusting a locale's name: an unknown name leaves setlocale on C, where the
# probe is 2 characters long instead of 1. Empty means this machine has none.
annotation_utf8_locale=""
for annotation_locale_candidate in "${LC_ALL:-}" "${LC_CTYPE:-}" "${LANG:-}" C.UTF-8 en_US.UTF-8; do
  [[ -n "$annotation_locale_candidate" ]] || continue
  annotation_force_locale "$annotation_locale_candidate"
  annotation_locale_probe=$'\303\251'
  if [[ ${#annotation_locale_probe} -eq 1 ]]; then
    annotation_restore_locale
    annotation_utf8_locale="$annotation_locale_candidate"
    break
  fi
  annotation_restore_locale
done
unset annotation_locale_candidate annotation_locale_probe

# Caps the RAW payload (before escaping), so the limit is a content limit rather
# than an escaped-length limit and both emitters truncate at the same character.
# Answers in the global `annotation_capped` instead of on stdout: a message may
# legitimately end in a newline (it becomes %0A), and $(...) would eat it.
annotation_capped=""
annotation_cap() {
  local s="$1" keep=$((annotation_max_length - 1)) last
  if [[ -n "$annotation_utf8_locale" ]]; then
    annotation_force_locale "$annotation_utf8_locale"
    [[ ${#s} -le $annotation_max_length ]] || s="${s:0:$keep}…"
    annotation_restore_locale
    annotation_capped="$s"
    return
  fi
  # No UTF-8 locale exists on this machine. Force C so the semantics are known to
  # be BYTES (rather than assuming it of whatever the caller had), cut at 499
  # bytes, then back off any trailing partial character: drop trailing
  # continuation bytes (0x80-0xBF), then a trailing lead byte (0xC0+), which at
  # the end of the string can only be a sequence whose continuations were cut.
  # Stricter than the 499-code-point contract — it can drop one extra whole
  # character — but it can never emit a split one. Unreachable on a supported
  # platform: macOS and Ubuntu both ship a UTF-8 locale.
  annotation_force_locale C
  if [[ ${#s} -gt $annotation_max_length ]]; then
    s="${s:0:$keep}"
    while [[ -n "$s" ]]; do
      last="${s:$((${#s} - 1)):1}"
      [[ "$last" == [$'\200'-$'\277'] ]] || break
      s="${s:0:$((${#s} - 1))}"
    done
    if [[ -n "$s" ]]; then
      last="${s:$((${#s} - 1)):1}"
      [[ "$last" != [$'\300'-$'\375'] ]] || s="${s:0:$((${#s} - 1))}"
    fi
    # Braced deliberately: under a UTF-8 locale bash 3.2 scans the ellipsis bytes
    # as part of an unbraced variable name.
    s="${s}…"
  fi
  annotation_restore_locale
  annotation_capped="$s"
}

annotation_escape_message() {
  local cr=$'\r' nl=$'\n' ls=$'\342\200\250' ps=$'\342\200\251' s
  annotation_cap "$1"
  s="$annotation_capped"
  s="${s//%/%25}"
  s="${s//"$cr"/%0D}"
  s="${s//"$nl"/%0A}"
  s="${s//"$ls"/%0A}"
  s="${s//"$ps"/%0A}"
  printf '%s' "$s"
}

annotation_escape_title() {
  local s
  s="$(annotation_escape_message "$1")"
  s="${s//:/%3A}"
  s="${s//,/%2C}"
  printf '%s' "$s"
}

stop_copylast_control_clients() {
  local control_pid
  for control_pid in ${copylast_control_pids[@]+"${copylast_control_pids[@]}"}; do
    kill -TERM "$control_pid" 2>/dev/null || true
  done
  for control_pid in ${copylast_control_pids[@]+"${copylast_control_pids[@]}"}; do
    wait "$control_pid" 2>/dev/null || true
  done
  copylast_control_pids=()
}

report_and_cleanup() {
  local status="${1:-0}" failed_line="${2:-unknown}" failed_command="${3:-unknown}"
  local reason title validation_finished_epoch total_duration platform_name
  local platform_label platform_arch budget_state report_failed tree_changed
  local passed_count skipped_count failed_count source_observation_complete tree_summary
  local canonical_checks_expected canonical_checks_observed
  if [[ "$status" -ne 0 && -z "$fail_reason" ]]; then
    fail_reason="line $failed_line exited $status: $failed_command"
    echo "validate-groundwork: $current_check failed at line $failed_line: $failed_command (exit $status)" >&2
  fi
  if [[ "$status" -eq 0 ]]; then
    finish_current_check_timing passed
  else
    finish_current_check_timing failed
  fi
  stop_copylast_control_clients
  if [[ -n "${copylast_socket:-}" ]]; then
    tmux -L "$copylast_socket" kill-server 2>/dev/null || true
  fi
  validation_finished_epoch="$(date +%s)"
  total_duration=$((validation_finished_epoch - validation_started_epoch))
  case "$(uname -s 2>/dev/null || true)" in
    Darwin) platform_name="macos" ;;
    Linux) platform_name="linux" ;;
    *) platform_name="unknown" ;;
  esac
  platform_label="${ImageOS:-$platform_name}"
  platform_arch="${RUNNER_ARCH:-$(uname -m 2>/dev/null || printf unknown)}"
  if [[ "$total_duration" -gt "$suite_budget_seconds" ]]; then
    budget_state="exceeded"
  else
    budget_state="within"
  fi

  source_observation_complete=1
  if ! scripts/tree-fingerprint --repo "$repo" >"$source_after"; then
    status=1
    fail_reason="the final working-tree fingerprint could not be captured"
    source_observation_complete=0
    rm -f "$source_after"
  fi
  if [[ "$source_observation_complete" -eq 1 ]]; then
    tree_changed="$(
      python3 - "$source_before" "$source_after" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    before = json.load(source)
with open(sys.argv[2], encoding="utf-8") as source:
    after = json.load(source)
print("true" if before["treeFingerprint"] != after["treeFingerprint"] else "false")
PY
    )"
  else
    tree_changed=unknown
  fi
  if [[ "$tree_changed" == "true" ]]; then
    status=1
    fail_reason="the working tree changed during validation; this receipt is invalid"
  fi

  if [[ "$status" -eq 0 && "$suite" == "platform-macos" ]]; then
    canonical_checks_expected="$out_dir/canonical-checks-expected"
    canonical_checks_observed="$out_dir/canonical-checks-observed"
    if ! canonical_check_observations_match "$suite" "$timing_rows" \
      "$canonical_checks_expected" "$canonical_checks_observed"; then
      status=1
      fail_reason="the successful suite did not observe every canonical check exactly once"
      diff -u "$canonical_checks_expected" "$canonical_checks_observed" >&2 || true
    fi
  fi

  if [[ "$status" -ne 0 ]] && ! awk -F '\t' '$3 == "failed" { found = 1 } END { exit !found }' "$timing_rows"; then
    printf 'validator runtime\t0\tfailed\t\tvalidator exited before a named check recorded the failure\n' \
      >>"$timing_rows"
  fi

  report_failed=0
  if [[ -n "$timing_output" ]]; then
    if ! python3 - "$timing_rows" "$timing_output" "$suite" "$platform_name" \
      "$validation_started_epoch" "$validation_finished_epoch" "$status" \
      "$suite_budget_seconds" "$suite_scope" "$proof_type" \
      "$exercises_real_clock" "$exercises_real_processes" "$platform_label" \
      "$platform_arch" "$source_before" "$source_after" \
      "$source_observation_complete" "$suite_hard_deadline_seconds" \
      "$deadline_set" "$repo" <<'PY'; then
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(sys.argv[-1]) / "scripts"))
from ci_receipt import atomic_write_json, common_envelope

(
    rows_path,
    output_path,
    suite,
    platform,
    started_epoch,
    finished_epoch,
    status,
    budget,
    scope,
    proof_type,
    real_clock,
    real_processes,
    platform_label,
    platform_arch,
    source_before_path,
    source_after_path,
    source_observation_complete,
    hard_deadline,
    deadline_explicit,
    repo_path,
) = sys.argv[1:]
checks = []
with open(rows_path, encoding="utf-8") as rows:
    for line in rows:
        name, seconds, result, skip_code, reason = line.rstrip("\n").split("\t")
        check = {"name": name, "durationSeconds": int(seconds), "result": result}
        if skip_code:
            check["skipCode"] = skip_code
        if reason:
            check["reason"] = reason
        checks.append(check)
with open(source_before_path, encoding="utf-8") as source:
    source_before = json.load(source)
source_after = None
if source_observation_complete == "1":
    with open(source_after_path, encoding="utf-8") as source:
        source_after = json.load(source)
started = int(started_epoch)
finished = int(finished_epoch)
duration = finished - started
payload = common_envelope(
    repo=pathlib.Path(repo_path),
    receipt_kind="validation-suite",
    result="passed" if int(status) == 0 else "failed",
    started_epoch=started,
    finished_epoch=finished,
    platform_os=platform,
    platform_image=platform_label,
    platform_arch=platform_arch,
    source_before=source_before,
    source_after=source_after,
    tree_observation_complete=source_observation_complete == "1",
)
counts = {name: sum(check["result"] == name for check in checks) for name in ("passed", "skipped", "failed")}
budget_value = int(budget)
command = f"scripts/validate-groundwork --suite {suite} --report <path>"
if deadline_explicit == "1":
    command += f" --deadline-seconds {hard_deadline}"
payload["body"] = {
    "suite": suite,
    "scope": scope,
    "proofType": proof_type,
    "cacheState": "unavailable",
    "exercisesRealClock": real_clock == "true",
    "exercisesRealProcesses": real_processes == "true",
    "suiteDurationSeconds": duration,
    "suiteBudgetSeconds": budget_value,
    "suiteBudgetState": "within" if duration <= budget_value else "exceeded",
    "hardDeadlineSeconds": int(hard_deadline) if hard_deadline else None,
    "checkCount": len(checks),
    "passedCount": counts["passed"],
    "skippedCount": counts["skipped"],
    "failedCount": counts["failed"],
    "checks": checks,
    "commands": {"localEquivalent": command},
}
atomic_write_json(pathlib.Path(output_path), payload)
PY
      echo "validate-groundwork: requested timing JSON could not be written" >&2
      report_failed=1
    fi
  fi
  if [[ "$report_failed" -eq 1 && "$status" -eq 0 ]]; then
    status=1
    fail_reason="the requested timing JSON could not be written"
  fi

  reason="$(annotation_escape_message "${fail_reason:-see the failing check output in the job log}")"
  title="$(annotation_escape_title "$current_check")"
  passed_count="$(awk -F '\t' '$3 == "passed" { count++ } END { print count + 0 }' "$timing_rows")"
  skipped_count="$(awk -F '\t' '$3 == "skipped" { count++ } END { print count + 0 }' "$timing_rows")"
  failed_count="$(awk -F '\t' '$3 == "failed" { count++ } END { print count + 0 }' "$timing_rows")"
  if [[ "$status" -ne 0 && "${GITHUB_ACTIONS:-}" == "true" ]]; then
    printf '::error title=validate-groundwork %s failed::%s. Local equivalent: scripts/validate-groundwork --suite %s\n' \
      "$title" "$reason" "$suite" || true
  fi
  if [[ -n "${GITHUB_STEP_SUMMARY:-}" && "${GROUNDWORK_SUPPRESS_SUMMARY:-0}" != "1" ]]; then
    {
      printf '## validate-groundwork · %s\n' "$suite"
      echo
      if [[ "$status" -eq 0 ]]; then
        printf '**Pass** — %s passed, %s skipped, %s failed.\n' \
          "$passed_count" "$skipped_count" "$failed_count"
      else
        printf '**Fail** — %s passed, %s skipped, %s failed.\n' \
          "$passed_count" "$skipped_count" "$failed_count"
        echo
        echo "Reason: ${reason//|/\\|}"
      fi
      echo
      printf 'Suite duration: **%ss**\n' "$total_duration"
      printf 'Advisory suite budget: **%ss** · %s\n' "$suite_budget_seconds" "$budget_state"
      echo
      printf "Platform: \`%s\` / \`%s\` / \`%s\`\n" "$platform_name" "$platform_label" "$platform_arch"
      case "$tree_changed" in
        false) tree_summary=match ;;
        true) tree_summary=changed ;;
        *) tree_summary=unavailable ;;
      esac
      printf "Exact-tree fingerprint before/after: \`%s\`\n" "$tree_summary"
      printf "Proof: %s. Real clock: \`%s\`; real processes: \`%s\`.\n" \
        "$proof_type" "$exercises_real_clock" "$exercises_real_processes"
      echo
      echo '### Slowest checks'
      echo
      echo '| Check | Seconds | Result | Skip code | Reason |'
      echo '| --- | ---: | --- | --- | --- |'
      sort -t $'\t' -k2,2nr "$timing_rows" >"$out_dir/validation-timings-sorted.tsv"
      head -n 5 "$out_dir/validation-timings-sorted.tsv" \
        >"$out_dir/validation-timings-slowest.tsv"
      while IFS=$'\t' read -r timing_name timing_seconds timing_result timing_skip_code timing_reason; do
        printf '| %s | %s | %s | %s | %s |\n' "${timing_name//|/\\|}" "$timing_seconds" \
          "$timing_result" "$timing_skip_code" "${timing_reason//|/\\|}"
      done <"$out_dir/validation-timings-slowest.tsv"
      echo
      printf "Local equivalent: \`scripts/validate-groundwork --suite %s --report '<path>'\`\n" "$suite"
    } >>"$GITHUB_STEP_SUMMARY" || true
  fi
  rm -rf "$out_dir"
  exit "$status"
}
trap 'report_and_cleanup "$?" "$LINENO" "$BASH_COMMAND"' EXIT

# In GitHub Actions, gcc format feeds the shellcheck-gcc problem matcher
# (.github/problem-matchers/shellcheck-gcc.json) so findings surface as
# file/line annotations; locally keep shellcheck's readable tty output.
run_shellcheck() {
  # Use the SAME pinned ShellCheck the shell-lint gate uses (resolved once, then
  # memoized), so this rendered-template check can never disagree with it. Fall
  # back to a PATH shellcheck only if the pinned resolver is unavailable.
  if [[ -z "${_gw_shellcheck_bin:-}" ]]; then
    _gw_shellcheck_bin="$(scripts/ensure-shell-tools 2>/dev/null | sed -n 's/^SHELLCHECK_BIN=//p')"
    [[ -x "$_gw_shellcheck_bin" ]] || _gw_shellcheck_bin=shellcheck
  fi
  if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    "$_gw_shellcheck_bin" --format=gcc "$@"
  else
    "$_gw_shellcheck_bin" "$@"
  fi
}

# Render hermetically: without --config, chezmoi merges the developer's real
# ~/.config/chezmoi data under --override-data, so keys a test omits on purpose
# (like xcode) leak in from the local machine and pass/fail differs from CI.
empty_config="$out_dir/empty-config.toml"
: >"$empty_config"

base_data='"name":"CI User","email_personal":"ci@example.com","email_work":"","code_dir":"~/code","reset_existing_configs":false,"password_manager":"bitwarden","signingkey":"","obsidian_vault_name":"ci","game_dev":false,"profile_preset":"personal-current","environment_role":"personal","release_posture":"current"'

render() {
  local os="$1" headless="$2" arch="${3:-arm64}" input="$4" output="$5"
  local work="${6:-false}"
  local xcode="${7:-false}"
  local beta="${8:-false}"
  local game_dev="${9:-false}"
  local password_manager="${10:-bitwarden}"
  local profile_preset="${11:-personal-current}"
  local environment_role="${12:-personal}"
  local release_posture="${13:-current}"
  local os_release='{}'
  [[ "$os" == "linux" ]] && os_release='{"ID":"ubuntu"}'
  local data="{${base_data},\"work\":${work},\"headless\":${headless},\"xcode\":${xcode},\"beta\":${beta},\"game_dev\":${game_dev},\"password_manager\":\"${password_manager}\",\"profile_preset\":\"${profile_preset}\",\"environment_role\":\"${environment_role}\",\"release_posture\":\"${release_posture}\",\"chezmoi\":{\"os\":\"${os}\",\"arch\":\"${arch}\",\"osRelease\":${os_release}}}"
  chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" --override-data "$data" execute-template <"$input" >"$output"
}

render_without_xcode_key() {
  local os="$1" headless="$2" arch="${3:-arm64}" input="$4" output="$5"
  local work="${6:-false}"
  local os_release='{}'
  [[ "$os" == "linux" ]] && os_release='{"ID":"ubuntu"}'
  local data="{${base_data},\"work\":${work},\"headless\":${headless},\"chezmoi\":{\"os\":\"${os}\",\"arch\":\"${arch}\",\"osRelease\":${os_release}}}"
  chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" --override-data "$data" execute-template <"$input" >"$output"
}

assert_not_contains() {
  local pattern="$1" file="$2" message="$3"
  if grep -Eq -- "$pattern" "$file"; then
    fail_reason="$message"
    echo "$message" >&2
    sed -n '1,160p' "$file" >&2
    exit 1
  fi
}

assert_recovery_hierarchy() {
  local file="$1" context="$2"
  local normal_count maintenance_count command_count
  local normal_line maintenance_line command_line force_line force_explanation_line

  normal_count="$(awk 'index($0, "Run update-all again to retry the normal maintenance transaction.") { count++ } END { print count + 0 }' "$file")"
  maintenance_count="$(awk 'index($0, "To retry maintenance without repeating upgrades:") { count++ } END { print count + 0 }' "$file")"
  command_count="$(awk '$0 ~ /^[[:space:]]*groundwork-cleanup --yes$/ { count++ } END { print count + 0 }' "$file")"
  if [[ "$normal_count" -ne 1 || "$maintenance_count" -ne 1 || "$command_count" -ne 1 ]]; then
    fail "$context must print one recovery hierarchy (normal=$normal_count maintenance=$maintenance_count command=$command_count)"
  fi

  normal_line="$(awk 'index($0, "Run update-all again to retry the normal maintenance transaction.") { print NR; exit }' "$file")"
  maintenance_line="$(awk 'index($0, "To retry maintenance without repeating upgrades:") { print NR; exit }' "$file")"
  command_line="$(awk '$0 ~ /^[[:space:]]*groundwork-cleanup --yes$/ { print NR; exit }' "$file")"
  if [[ "$normal_line" -ge "$maintenance_line" || "$maintenance_line" -ge "$command_line" ]]; then
    fail "$context must present update-all before the maintenance-only retry"
  fi

  force_line="$(awk '$0 ~ /^[[:space:]]*groundwork-cleanup --yes --force$/ { print NR; exit }' "$file")"
  if [[ -n "$force_line" ]]; then
    force_explanation_line="$(awk 'index($0, "Use --force only") { print NR; exit }' "$file")"
    if [[ -z "$force_explanation_line" || "$force_explanation_line" -ge "$force_line" ]]; then
      fail "$context must explain force as exceptional before naming its command"
    fi
  fi
}

assert_no_matches() {
  local message="$1" status
  shift
  if "$@"; then
    fail "$message"
  else
    status=$?
    if [[ "$status" -gt 1 ]]; then
      fail_reason="failed while checking: $message"
      echo "$fail_reason" >&2
      exit "$status"
    fi
  fi
}

# Policy matrices need the production command and its outputs, not its timing
# or process-supervision semantics. Run those bounded fixture commands directly;
# the focused suite's outer deadline still prevents an unbounded validator.
# Named runtime groups separately prove real clocks, signals, process groups,
# deadlines, descendant drain, locks, and TERM-to-KILL escalation.
install_fixture_policy_runner() {
  local target="$1"
  mkdir -p "$(dirname "$target")"
  cat >"$target" <<'SH'
#!/usr/bin/env bash

run_bounded_internal() {
  local label="$1" seconds="$2" output="$3" status=0
  shift 3
  : "$seconds"
  if [[ -n "${GROUNDWORK_TEST_RUNNER_125_MATCH:-}" &&
    "$label" == *"$GROUNDWORK_TEST_RUNNER_125_MATCH"* ]]; then
    return 125
  fi
  if [[ -n "$output" ]]; then
    ("$@" </dev/null >"$output") || status=$?
  else
    ("$@" </dev/null) || status=$?
  fi
  return "$status"
}

run_bounded() {
  local label="$1"
  shift
  echo "  Running: $label (fixture policy runner; Ctrl-C cancels)"
  run_bounded_internal "$label" "${deadline:-1}" "" "$@"
}

run_bounded_capture() {
  local label="$1" output="$2"
  shift 2
  run_bounded_internal "$label" "${observe_deadline:-1}" "$output" "$@"
}

exit_if_terminal_status() {
  case "$1" in
    125 | 129 | 130 | 143) exit "$1" ;;
  esac
}
SH
  chmod +x "$target"
}

# One validator-only hostile group proves the fixture meta-watchdog itself, so
# a broken direct-runner stub cannot silently redefine process cleanup. Keep
# this expensive boundary out of the policy matrices that it protects.
install_fixture_watchdog_runner() {
  local target="$1"
  mkdir -p "$(dirname "$target")"
  cat >"$target" <<'SH'
#!/usr/bin/env bash

policy_live_group_members() {
  local pgid="$1" snapshot
  if policy_child_running "$pgid"; then
    return 0
  fi
  if ! snapshot="$(LC_ALL=C ps -eo pgid=,stat= 2>/dev/null)"; then
    kill -0 -- "-$pgid" 2>/dev/null
    return
  fi
  awk -v wanted="$pgid" \
    '$1 == wanted && $2 !~ /^Z/ { found = 1 } END { exit !found }' \
    <<<"$snapshot"
}

policy_child_running() {
  local child="$1" state
  kill -0 "$child" 2>/dev/null || return 1
  state="$(ps -o stat= -p "$child" 2>/dev/null | tr -d '[:space:]' || true)"
  if [[ -z "$state" ]]; then
    kill -0 "$child" 2>/dev/null
    return
  fi
  [[ "$state" != Z* ]]
}

policy_restore_traps() {
  local saved_hup="$1" saved_int="$2" saved_term="$3"
  if [[ -n "$saved_hup" ]]; then eval "$saved_hup"; else trap - HUP; fi
  if [[ -n "$saved_int" ]]; then eval "$saved_int"; else trap - INT; fi
  if [[ -n "$saved_term" ]]; then eval "$saved_term"; else trap - TERM; fi
}

policy_collect_child_status() {
  local child="$1" status=0
  wait "$child" || status=$?
  policy_child_status="$status"
  policy_child_status_available=1
}

policy_shutdown() {
  local child="$1" pgid="$2" leader_exited="$3" ticks=0 grace_ticks
  grace_ticks="${GROUNDWORK_POLICY_CANCEL_GRACE_TICKS:-100}"
  [[ "$grace_ticks" =~ ^[1-9][0-9]*$ ]] || return 125
  kill -TERM -- "-$pgid" 2>/dev/null || true
  if [[ "${GROUNDWORK_TEST_POLICY_SHUTDOWN_UNCONFIRMED:-0}" == "1" ]]; then
    if [[ "$leader_exited" -eq 1 ]]; then
      policy_collect_child_status "$child"
    fi
    return 1
  fi
  while policy_live_group_members "$pgid" && [[ "$ticks" -lt "$grace_ticks" ]]; do
    sleep 0.01
    ticks=$((ticks + 1))
  done
  if policy_live_group_members "$pgid"; then
    kill -KILL -- "-$pgid" 2>/dev/null || true
  fi
  ticks=0
  while policy_live_group_members "$pgid" && [[ "$ticks" -lt "$grace_ticks" ]]; do
    sleep 0.01
    ticks=$((ticks + 1))
  done
  if policy_live_group_members "$pgid"; then
    echo "  Groundwork: fixture policy process tree could not be stopped." >&2
    return 1
  fi
  policy_collect_child_status "$child"
  return 0
}

policy_report_unconfirmed() {
  local label="$1" status_text=unavailable
  if [[ "$policy_child_status_available" -eq 1 ]]; then
    status_text="$policy_child_status"
  fi
  echo "  Groundwork: $label cleanup could not be confirmed; original child status: $status_text" >&2
}

run_bounded_internal() {
  local label="$1" seconds="$2" output="$3" status=0
  local child="" pgid="" interrupted=0 ticks=0 deadline_ticks monitor_was_on=0
  local ready_file="" ready_ticks=0
  local leader_exited=0 policy_child_status=0 policy_child_status_available=0
  local saved_hup saved_int saved_term
  shift 3
  : "$seconds"
  if [[ -n "${GROUNDWORK_TEST_RUNNER_125_MATCH:-}" &&
    "$label" == *"$GROUNDWORK_TEST_RUNNER_125_MATCH"* ]]; then
    return 125
  fi
  deadline_ticks="${GROUNDWORK_POLICY_COMMAND_DEADLINE_TICKS:-2000}"
  [[ "$deadline_ticks" =~ ^[1-9][0-9]*$ ]] || return 64
  saved_hup="$(trap -p HUP || true)"
  saved_int="$(trap -p INT || true)"
  saved_term="$(trap -p TERM || true)"
  trap 'interrupted=129; [[ -z "$pgid" ]] || kill -TERM -- "-$pgid" 2>/dev/null || true' HUP
  trap 'interrupted=130; [[ -z "$pgid" ]] || kill -TERM -- "-$pgid" 2>/dev/null || true' INT
  trap 'interrupted=143; [[ -z "$pgid" ]] || kill -TERM -- "-$pgid" 2>/dev/null || true' TERM
  case "$-" in
    *m*) monitor_was_on=1 ;;
  esac
  set -m
  if [[ -n "$output" ]]; then
    GROUNDWORK_POLICY_RUNNER_PID="$$" "$@" </dev/null >"$output" &
  else
    GROUNDWORK_POLICY_RUNNER_PID="$$" "$@" </dev/null &
  fi
  child=$!
  pgid="$child"
  if [[ "$monitor_was_on" -eq 1 ]]; then
    set -m
  else
    set +m
  fi
  ready_file="${GROUNDWORK_TEST_POLICY_READY_FILE:-}"
  if [[ -n "$ready_file" ]]; then
    while [[ ! -s "$ready_file" ]] && policy_live_group_members "$pgid" &&
      [[ "$ready_ticks" -lt 500 ]]; do
      sleep 0.01
      ready_ticks=$((ready_ticks + 1))
    done
  fi
  while policy_live_group_members "$pgid"; do
    if [[ "$leader_exited" -eq 0 ]] && ! policy_child_running "$child"; then
      leader_exited=1
    fi
    if [[ "$interrupted" -ne 0 ]]; then
      trap '' HUP INT TERM
      if ! policy_shutdown "$child" "$pgid" "$leader_exited"; then
        policy_report_unconfirmed "$label"
        policy_restore_traps "$saved_hup" "$saved_int" "$saved_term"
        return 125
      fi
      policy_restore_traps "$saved_hup" "$saved_int" "$saved_term"
      return "$interrupted"
    fi
    if [[ "$ticks" -ge "$deadline_ticks" ]]; then
      echo "  Groundwork: $label exceeded the fixture policy meta-watchdog; cancelling its process tree." >&2
      trap '' HUP INT TERM
      if ! policy_shutdown "$child" "$pgid" "$leader_exited"; then
        policy_report_unconfirmed "$label"
        policy_restore_traps "$saved_hup" "$saved_int" "$saved_term"
        return 125
      fi
      policy_restore_traps "$saved_hup" "$saved_int" "$saved_term"
      if [[ "$leader_exited" -eq 1 ]]; then
        if [[ "$policy_child_status" -ne 0 ]]; then
          echo "  Groundwork: $label failed before leaking a fixture process; preserving original child status $policy_child_status." >&2
          return "$policy_child_status"
        fi
        echo "  Groundwork: $label succeeded but leaked a fixture process; returning 70." >&2
        return 70
      fi
      return 124
    fi
    sleep 0.01
    ticks=$((ticks + 1))
  done
  if [[ "$interrupted" -ne 0 ]]; then
    trap '' HUP INT TERM
    if ! policy_shutdown "$child" "$pgid" "$leader_exited"; then
      policy_report_unconfirmed "$label"
      policy_restore_traps "$saved_hup" "$saved_int" "$saved_term"
      return 125
    fi
    policy_restore_traps "$saved_hup" "$saved_int" "$saved_term"
    return "$interrupted"
  fi
  policy_collect_child_status "$child"
  status="$policy_child_status"
  policy_restore_traps "$saved_hup" "$saved_int" "$saved_term"
  return "$status"
}

run_bounded() {
  local label="$1"
  shift
  echo "  Running: $label (fixture policy meta-watchdog; Ctrl-C cancels)"
  run_bounded_internal "$label" "${deadline:-1}" "" "$@"
}

run_bounded_capture() {
  local label="$1" output="$2"
  shift 2
  run_bounded_internal "$label" "${observe_deadline:-1}" "$output" "$@"
}

exit_if_terminal_status() {
  case "$1" in
    125 | 129 | 130 | 143) exit "$1" ;;
  esac
}
SH
  chmod +x "$target"
}

install_fixture_runtime_runner() {
  local target="$1"
  cp "$repo/home/dot_local/share/groundwork/lib/maintenance-runner.sh" "$target"
  chmod +x "$target"
}

fixture_clock_epoch=1893456000
install_fixture_policy_clock() {
  local target="$1"
  mkdir -p "$(dirname "$target")"
  cat >"$target" <<'SH'
#!/usr/bin/env bash
if [[ "${GROUNDWORK_TEST_REALTIME_CLOCK:-0}" == 1 ]]; then
  exec /bin/date "$@"
fi
case "$*" in
  '+%s' | '-u +%s') printf '1893456000\n' ;;
  "-u +%Y-%m-%dT%H:%M:%SZ") printf '2030-01-01T00:00:00Z\n' ;;
  *) printf 'fixture date: unsupported arguments: %s\n' "$*" >&2; exit 64 ;;
esac
SH
  chmod +x "$target"
}

install_fixture_runtime_clock() {
  rm -f -- "$1"
}

line_number() {
  local pattern="$1" file="$2" line
  line="$(grep -nF -m1 "$pattern" "$file" | cut -d: -f1 || true)"
  if [[ -z "$line" ]]; then
    echo "$file: missing expected line: $pattern" >&2
    exit 1
  fi
  printf '%s\n' "$line"
}

validate_static_foundation() {
  local canonical_rows canonical_expected canonical_observed

  check "repository Node/pnpm authority contract"
  node tools/check-toolchain.mjs

  check "GitHub external configuration registry"
  node tools/github-external-config.mjs

  check "toolchain sync, checker, and reporter regressions"
  # The checker proves this checkout is consistent; these tests prove the
  # checker and the sync it depends on still reject drift, unsupported TOML,
  # and partial rollbacks. A guard with no negative test proves nothing.
  node --test tools/*.test.mjs

  check "shell scripts (syntax, format, lint)"
  # Single authoritative gate: bash -n + the pinned shfmt + the pinned ShellCheck
  # over every tracked/untracked Bash script (scripts/ensure-shell-tools supplies
  # the exact pinned analyzers). CI and local dev call this same entry point, so no
  # distro-packaged analyzer defines "clean" (see scripts/lint-shell).
  scripts/lint-shell
  # BSD-stat-first with a GNU fallback is a trap this repo has hit twice: GNU
  # stat treats -f as "filesystem status" and SUCCEEDS with the wrong output, so
  # the fallback never runs on Linux. Try stat -c first (BSD stat rejects it and
  # fails cleanly), or validate the output like groundwork-repos does.
  assert_no_matches "BSD-first stat fallback found; GNU stat treats -f as filesystem status and succeeds with the wrong output — put the -c form first" \
    rg -n 'stat -f[^|]*\|\|[^|]*stat -c' scripts home

  check "validator suite CLI and complete full composition"
  assert_no_matches "a production fast-test bypass was added instead of isolating fixtures" \
    rg -n 'GROUNDWORK_FAST[_]TESTS' home scripts bootstrap-mac.sh
  validator_cli_fixture="$out_dir/validator-cli"
  mkdir -p "$validator_cli_fixture/tmp"
  scripts/validate-groundwork --list-suites >"$validator_cli_fixture/suites"
  for validator_suite_name in static update docker platform-macos full; do
    grep -qxF "$validator_suite_name" "$validator_cli_fixture/suites" \
      || fail "--list-suites omitted $validator_suite_name"
  done
  grep -qF '  - shell scripts (syntax, format, lint)' "$validator_cli_fixture/suites"
  grep -qF '  - repository Docker image verification transaction' "$validator_cli_fixture/suites"
  grep -qF '  - macOS native process and filesystem primitives' "$validator_cli_fixture/suites"

  awk '
  /^static$|^update$|^docker$|^platform-macos$/ { focused = 1; full = 0; next }
  /^full$/ { focused = 0; full = 1; next }
  /^  - / {
    line = substr($0, 5)
    if (focused) print line > focused_file
    if (full) print line > full_file
  }
' focused_file="$validator_cli_fixture/focused" full_file="$validator_cli_fixture/full" \
    "$validator_cli_fixture/suites"
  sort "$validator_cli_fixture/focused" >"$validator_cli_fixture/focused.sorted"
  sort "$validator_cli_fixture/full" >"$validator_cli_fixture/full.sorted"
  diff -u "$validator_cli_fixture/focused.sorted" "$validator_cli_fixture/full.sorted" \
    || fail "the full suite does not compose every focused-suite check exactly once"
  test ! -s <(sort "$validator_cli_fixture/focused" | uniq -d) \
    || fail "a canonical validation check has more than one focused-suite owner"
  grep -qF 'GROUNDWORK_FULL_COMPOSITION=1 GROUNDWORK_SUPPRESS_SUMMARY=1' \
    scripts/validate-groundwork \
    || fail "the full suite must compose focused CLI entry points in isolated subprocesses"

  canonical_rows="$validator_cli_fixture/canonical-rows"
  canonical_expected="$validator_cli_fixture/canonical-expected"
  canonical_observed="$validator_cli_fixture/canonical-observed"
  while IFS= read -r canonical_name; do
    canonical_name="${canonical_name#  - }"
    printf '%s\t0\tpassed\t\t\n' "$canonical_name"
  done < <(list_suite_checks platform-macos) >"$canonical_rows"
  canonical_check_observations_match platform-macos "$canonical_rows" \
    "$canonical_expected" "$canonical_observed" \
    || fail "a complete canonical runtime check inventory was rejected"
  sed '$d' "$canonical_rows" >"$validator_cli_fixture/canonical-rows-missing"
  if canonical_check_observations_match platform-macos "$validator_cli_fixture/canonical-rows-missing" \
    "$canonical_expected" "$canonical_observed"; then
    fail "a successful suite could omit a canonical runtime check"
  fi

  validation_child="$validator_cli_fixture/signal-child"
  validation_child_ready="$validator_cli_fixture/signal-child.ready"
  cat >"$validation_child" <<'SH'
#!/usr/bin/env bash
trap 'exit 130' INT
: >"$1"
while :; do sleep 1; done
SH
  chmod +x "$validation_child"
  scripts/run-validation-child -- "$validation_child" "$validation_child_ready" &
  validation_child_pid=$!
  for _ in {1..50}; do
    [[ -f "$validation_child_ready" ]] && break
    sleep 0.1
  done
  test -f "$validation_child_ready" \
    || fail "the full-composition signal child never became ready"
  kill -INT "$validation_child_pid"
  validation_child_status=0
  wait "$validation_child_pid" || validation_child_status=$?
  [[ "$validation_child_status" -eq 130 ]] \
    || fail "the full-composition child inherited ignored INT (exit $validation_child_status)"

  check "whole-suite hard deadlines and process-group cleanup"
  scripts/test-validation-deadline

  for registry_mutation in omitted duplicate unknown dispatcher; do
    registry_mutant="$validator_cli_fixture/validate-groundwork-$registry_mutation"
    python3 - scripts/validate-groundwork "$registry_mutant" "$registry_mutation" <<'PY'
import pathlib
import sys

source = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
target = pathlib.Path(sys.argv[2])
mutation = sys.argv[3]
docker = "  'docker|validate_docker|validate_docker'\n"
static = "  'static|validate_static|validate_static_foundation validate_static_configuration validate_static_runtime validate_static_helpers validate_static_repository'\n"
if mutation == "omitted":
    source = source.replace(docker, "", 1)
elif mutation == "duplicate":
    source = source.replace(static, static + static, 1)
elif mutation == "unknown":
    source = source.replace(docker, "  'surprise|validate_docker|validate_docker'\n", 1)
elif mutation == "dispatcher":
    source = source.replace(docker, "  'docker|validate_static|validate_docker'\n", 1)
else:
    raise SystemExit(f"unknown mutation: {mutation}")
target.write_text(source, encoding="utf-8")
PY
    set +e
    TMPDIR="$validator_cli_fixture/tmp" /bin/bash "$registry_mutant" --list-suites \
      >"$validator_cli_fixture/$registry_mutation-out" \
      2>"$validator_cli_fixture/$registry_mutation-err"
    registry_status=$?
    set -e
    [[ "$registry_status" -eq 64 ]] \
      || fail "the $registry_mutation suite-registry mutation returned $registry_status instead of 64"
    grep -qF 'invalid canonical suite registry' "$validator_cli_fixture/$registry_mutation-err"
  done

  set +e
  TMPDIR="$validator_cli_fixture/tmp" scripts/validate-groundwork --suite unknown \
    >"$validator_cli_fixture/unknown-out" 2>"$validator_cli_fixture/unknown-err"
  validator_cli_status=$?
  set -e
  [[ "$validator_cli_status" -eq 64 ]] \
    || fail "an unknown validator suite returned $validator_cli_status instead of 64"
  grep -qF 'unknown suite: unknown' "$validator_cli_fixture/unknown-err"
  if compgen -G "$validator_cli_fixture/tmp/groundwork-rendered.*" >/dev/null; then
    fail "an unknown validator suite created fixture state before rejecting intent"
  fi

  check "validator fixture clock accepted argument forms"
  validator_clock="$validator_cli_fixture/date"
  install_fixture_policy_clock "$validator_clock"
  [[ "$("$validator_clock" +%s)" == "1893456000" ]] \
    || fail "the fixture clock rejected its local epoch form"
  [[ "$("$validator_clock" -u +%s)" == "1893456000" ]] \
    || fail "the fixture clock rejected its UTC epoch form"
  [[ "$("$validator_clock" -u +%Y-%m-%dT%H:%M:%SZ)" == "2030-01-01T00:00:00Z" ]] \
    || fail "the fixture clock rejected its UTC RFC3339 form"
  set +e
  "$validator_clock" +%Y >"$validator_cli_fixture/date-unsupported-out" \
    2>"$validator_cli_fixture/date-unsupported-err"
  validator_clock_status=$?
  set -e
  [[ "$validator_clock_status" -eq 64 ]] \
    || fail "the fixture clock accepted an unsupported date form"
  grep -qF 'fixture date: unsupported arguments: +%Y' \
    "$validator_cli_fixture/date-unsupported-err" \
    || fail "the fixture clock did not explain its closed argument contract"

  check "CI receipt schema, exact-tree identity, atomicity, and hostile arguments"
  scripts/test-ci-receipts
  scripts/test-aggregate-ci-receipts
}

validate_update() {
  run_fixture_pty() { # output input-file command [args...]
    local output="$1" input_file="$2"
    shift 2
    python3 - "$output" "$input_file" "$@" <<'PY'
import errno
import os
import pty
import select
import signal
import sys
import time

output_path, input_path, *command = sys.argv[1:]
if not command:
    raise SystemExit(64)
payload = open(input_path, "rb").read()
pid, master = pty.fork()
if pid == 0:
    os.execvp(command[0], command)

deadline = time.monotonic() + 90
chunks = []
if payload:
    os.write(master, payload)
status = None
try:
    while True:
        ready, _, _ = select.select([master], [], [], 0.1)
        if ready:
            try:
                chunk = os.read(master, 65536)
            except OSError as exc:
                if exc.errno != errno.EIO:
                    raise
                chunk = b""
            if chunk:
                chunks.append(chunk)
        waited, candidate = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            status = candidate
            break
        if time.monotonic() >= deadline:
            os.killpg(pid, signal.SIGTERM)
            time.sleep(0.5)
            try:
                os.killpg(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            _, status = os.waitpid(pid, 0)
            chunks.append(b"\nfixture PTY deadline expired\n")
            break
    # A child can exit while the kernel still has its final receipt buffered on
    # the PTY master. Drain that bounded tail so the fixture proves the same
    # terminal output a person would see instead of racing process exit.
    drain_deadline = time.monotonic() + 1
    while time.monotonic() < drain_deadline:
        ready, _, _ = select.select([master], [], [], 0.05)
        if not ready:
            break
        try:
            chunk = os.read(master, 65536)
        except OSError as exc:
            if exc.errno != errno.EIO:
                raise
            break
        if not chunk:
            break
        chunks.append(chunk)
finally:
    try:
        os.close(master)
    except OSError:
        pass
with open(output_path, "wb") as stream:
    stream.write(b"".join(chunks))
raise SystemExit(os.waitstatus_to_exitcode(status))
PY
  }

  run_fixture_pty_after() { # output needle payload command [args...]
    local output="$1" needle="$2" payload="$3"
    shift 3
    python3 - "$output" "$needle" "$payload" "$@" <<'PY'
import errno
import os
import pty
import select
import signal
import sys
import time

output_path, needle_text, payload_text, *command = sys.argv[1:]
needle = needle_text.encode()
payload = payload_text.encode().decode("unicode_escape").encode("latin1")
pid, master = pty.fork()
if pid == 0:
    os.execvp(command[0], command)
deadline = time.monotonic() + 30
chunks = []
sent = False
status = None
try:
    while True:
        ready, _, _ = select.select([master], [], [], 0.1)
        if ready:
            try:
                chunk = os.read(master, 65536)
            except OSError as exc:
                if exc.errno != errno.EIO:
                    raise
                chunk = b""
            if chunk:
                chunks.append(chunk)
                if not sent and needle in b"".join(chunks):
                    os.write(master, payload)
                    sent = True
        waited, candidate = os.waitpid(pid, os.WNOHANG)
        if waited == pid:
            status = candidate
            break
        if time.monotonic() >= deadline:
            os.killpg(pid, signal.SIGTERM)
            time.sleep(0.5)
            try:
                os.killpg(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            _, status = os.waitpid(pid, 0)
            chunks.append(b"\nfixture PTY dialog deadline expired\n")
            break
finally:
    try:
        os.close(master)
    except OSError:
        pass
with open(output_path, "wb") as stream:
    stream.write(b"".join(chunks))
if not sent:
    raise SystemExit(66)
raise SystemExit(os.waitstatus_to_exitcode(status))
PY
  }

  check "Homebrew update retry helper"
  test -x home/dot_local/bin/executable_groundwork-brew-update
  brew_retry_bin="$out_dir/brew-retry-bin"
  mkdir -p "$brew_retry_bin"
  cat >"$brew_retry_bin/brew" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$BREW_COMMANDS_FILE"
count=0
[[ ! -f "$BREW_ATTEMPTS_FILE" ]] || count="$(<"$BREW_ATTEMPTS_FILE")"
count=$((count + 1))
printf '%s\n' "$count" >"$BREW_ATTEMPTS_FILE"
echo "fake brew update attempt $count"
[[ -z "${BREW_FORCE_STATUS:-}" ]] || exit "$BREW_FORCE_STATUS"
[[ "$count" -ge "${BREW_SUCCEED_ON:-3}" ]]
SH
  cat >"$brew_retry_bin/sleep" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$1" >>"$BREW_SLEEPS_FILE"
SH
  chmod +x "$brew_retry_bin/brew" "$brew_retry_bin/sleep"

  # First-attempt success performs one update and no sleep.
  BREW_SUCCEED_ON=1 BREW_ATTEMPTS_FILE="$out_dir/brew-attempts" \
    BREW_COMMANDS_FILE="$out_dir/brew-commands" BREW_SLEEPS_FILE="$out_dir/brew-sleeps" \
    PATH="$brew_retry_bin:$PATH" home/dot_local/bin/executable_groundwork-brew-update >/dev/null 2>&1
  grep -qxF '1' "$out_dir/brew-attempts"
  diff -u <(printf 'update\n') "$out_dir/brew-commands"
  test ! -e "$out_dir/brew-sleeps"

  # Second-attempt success sleeps once; third-attempt success uses both delays.
  rm -f "$out_dir/brew-attempts" "$out_dir/brew-commands"
  BREW_SUCCEED_ON=2 BREW_ATTEMPTS_FILE="$out_dir/brew-attempts" \
    BREW_COMMANDS_FILE="$out_dir/brew-commands" BREW_SLEEPS_FILE="$out_dir/brew-sleeps" \
    PATH="$brew_retry_bin:$PATH" home/dot_local/bin/executable_groundwork-brew-update >/dev/null 2>&1
  grep -qxF '2' "$out_dir/brew-attempts"
  diff -u <(printf 'update\nupdate\n') "$out_dir/brew-commands"
  diff -u <(printf '3\n') "$out_dir/brew-sleeps"

  rm -f "$out_dir/brew-attempts" "$out_dir/brew-commands" "$out_dir/brew-sleeps"
  BREW_SUCCEED_ON=3 BREW_ATTEMPTS_FILE="$out_dir/brew-attempts" \
    BREW_COMMANDS_FILE="$out_dir/brew-commands" BREW_SLEEPS_FILE="$out_dir/brew-sleeps" \
    PATH="$brew_retry_bin:$PATH" home/dot_local/bin/executable_groundwork-brew-update \
    >"$out_dir/brew-retry-output" 2>&1
  grep -qxF '3' "$out_dir/brew-attempts"
  diff -u <(printf 'update\nupdate\nupdate\n') "$out_dir/brew-commands"
  diff -u <(printf '3\n6\n') "$out_dir/brew-sleeps"

  # Persistent failures stop after three exact `brew update` commands.
  rm -f "$out_dir/brew-attempts" "$out_dir/brew-commands" "$out_dir/brew-sleeps"
  if BREW_SUCCEED_ON=99 BREW_ATTEMPTS_FILE="$out_dir/brew-attempts" \
    BREW_COMMANDS_FILE="$out_dir/brew-commands" BREW_SLEEPS_FILE="$out_dir/brew-sleeps" \
    PATH="$brew_retry_bin:$PATH" home/dot_local/bin/executable_groundwork-brew-update \
    >"$out_dir/brew-retry-failure" 2>&1; then
    fail "groundwork-brew-update succeeded after three failed attempts"
  fi
  grep -qxF '3' "$out_dir/brew-attempts"
  diff -u <(printf 'update\nupdate\nupdate\n') "$out_dir/brew-commands"
  grep -qF 'stopped before package upgrades' "$out_dir/brew-retry-failure"

  # Ctrl-C/termination statuses are authoritative: one attempt, no retry sleep.
  for interrupt_status in 129 130 143; do
    rm -f "$out_dir/brew-attempts" "$out_dir/brew-commands" "$out_dir/brew-sleeps"
    set +e
    BREW_FORCE_STATUS="$interrupt_status" BREW_ATTEMPTS_FILE="$out_dir/brew-attempts" \
      BREW_COMMANDS_FILE="$out_dir/brew-commands" BREW_SLEEPS_FILE="$out_dir/brew-sleeps" \
      PATH="$brew_retry_bin:$PATH" home/dot_local/bin/executable_groundwork-brew-update >/dev/null 2>&1
    helper_status=$?
    set -e
    [[ "$helper_status" -eq "$interrupt_status" ]] \
      || fail "groundwork-brew-update changed interrupt status $interrupt_status to $helper_status"
    grep -qxF '1' "$out_dir/brew-attempts"
    diff -u <(printf 'update\n') "$out_dir/brew-commands"
    test ! -e "$out_dir/brew-sleeps"
  done

  # A missing brew command fails immediately with the documented error.
  no_brew_bin="$out_dir/no-brew-bin"
  mkdir -p "$no_brew_bin"
  if PATH="$no_brew_bin" /bin/bash home/dot_local/bin/executable_groundwork-brew-update \
    >"$out_dir/brew-missing" 2>&1; then
    fail "groundwork-brew-update succeeded without brew on PATH"
  fi
  grep -qF 'Homebrew is not on PATH' "$out_dir/brew-missing"

  check "Homebrew output classification"
  brew_output_fixture="$out_dir/brew-output-fixture"
  mkdir -p "$brew_output_fixture"
  printf '\033[33mWarning: direnv 2.37.1 already installed\033[0m\n%s\n%s\n%s\n' \
    'Warning: Not upgrading ghostty, the latest version is already installed' \
    'Warning: actionable upstream condition' \
    'Warning: direnv already installed with unexpected wording' \
    >"$brew_output_fixture/input"
  # shellcheck source=/dev/null
  . home/dot_local/share/groundwork/lib/brew-output.sh
  gw_brew_classify_stream "$brew_output_fixture/raw" "$brew_output_fixture/receipt" reset \
    <"$brew_output_fixture/input" >"$brew_output_fixture/visible"
  assert_not_contains 'direnv 2.37.1 already installed|Not upgrading ghostty' \
    "$brew_output_fixture/visible" \
    "known exact Homebrew no-change messages remained visible as warnings"
  grep -qxF 'Warning: actionable upstream condition' "$brew_output_fixture/visible" \
    || fail "an unfamiliar Homebrew warning was hidden"
  grep -qxF 'Warning: direnv already installed with unexpected wording' \
    "$brew_output_fixture/visible" \
    || fail "a near-match Homebrew warning was incorrectly treated as benign"
  cmp "$brew_output_fixture/input" "$brew_output_fixture/raw" \
    || fail "the Homebrew classifier did not preserve its exact raw stream"
  grep -qx $'current\t2' "$brew_output_fixture/receipt" \
    || fail "the Homebrew classifier did not count exact no-change messages"
  grep -qx $'warning\t2' "$brew_output_fixture/receipt" \
    || fail "the Homebrew classifier did not count preserved warnings"

  printf '\033[31mError: generic Homebrew failure\033[0m\n%s\n%s\n' \
    "Error: bitwarden: It seems there is already an App at '/opt/homebrew/Caskroom/bitwarden/2026.6.0/Bitwarden.app'." \
    'Error: a second generic Homebrew failure' \
    >"$brew_output_fixture/error-input"
  gw_brew_classify_stream \
    "$brew_output_fixture/error-raw" "$brew_output_fixture/error-receipt" reset \
    <"$brew_output_fixture/error-input" >"$brew_output_fixture/error-visible"
  cmp "$brew_output_fixture/error-input" "$brew_output_fixture/error-visible" \
    || fail "Homebrew Error lines did not remain visible in the live transcript"
  cmp "$brew_output_fixture/error-input" "$brew_output_fixture/error-raw" \
    || fail "Homebrew Error lines were not preserved byte-for-byte in the raw log"
  grep -qx $'error\t3' "$brew_output_fixture/error-receipt" \
    || fail "plain and ANSI Homebrew errors were not normalized into one count"
  grep -qx $'failed-cask\tbitwarden' "$brew_output_fixture/error-receipt" \
    || fail "the classifier did not safely identify the Caskroom token"
  gw_brew_report_classification \
    "Homebrew hostile fixture" "$brew_output_fixture/error-receipt" \
    "$brew_output_fixture/error-raw" 23 >"$brew_output_fixture/error-report"
  grep -qF 'Result: failed (exit 23)' "$brew_output_fixture/error-report"
  grep -qF 'Errors: 3 preserved above' "$brew_output_fixture/error-report"
  grep -qF 'Failed cask: bitwarden' "$brew_output_fixture/error-report"
  grep -qF 'brew remove --force --cask bitwarden' "$brew_output_fixture/error-report"

  printf '%s\n' 'Error: Permission denied while linking a formula' \
    >"$brew_output_fixture/generic-error-input"
  gw_brew_classify_stream \
    "$brew_output_fixture/generic-error-raw" \
    "$brew_output_fixture/generic-error-receipt" reset \
    <"$brew_output_fixture/generic-error-input" \
    >"$brew_output_fixture/generic-error-visible"
  gw_brew_report_classification \
    "Homebrew generic failure" "$brew_output_fixture/generic-error-receipt" \
    "$brew_output_fixture/generic-error-raw" 9 \
    >"$brew_output_fixture/generic-error-report"
  grep -qF 'Errors: 1 preserved above' "$brew_output_fixture/generic-error-report"
  assert_not_contains 'Failed cask:|brew remove --force|brew install --cask' \
    "$brew_output_fixture/generic-error-report" \
    "a generic non-cask Homebrew error received force-removal advice"

  printf '%s\n' \
    "Error: hostile: It seems there is already an App at '/opt/homebrew/Caskroom/bitwarden\$(touch-owned)/2026.6.0/Bitwarden.app'." \
    >"$brew_output_fixture/hostile-cask-input"
  gw_brew_classify_stream \
    "$brew_output_fixture/hostile-cask-raw" \
    "$brew_output_fixture/hostile-cask-receipt" reset \
    <"$brew_output_fixture/hostile-cask-input" \
    >"$brew_output_fixture/hostile-cask-visible"
  gw_brew_report_classification \
    "Homebrew hostile cask token" "$brew_output_fixture/hostile-cask-receipt" \
    "$brew_output_fixture/hostile-cask-raw" 8 \
    >"$brew_output_fixture/hostile-cask-report"
  grep -qx $'error\t1' "$brew_output_fixture/hostile-cask-receipt"
  assert_not_contains '^failed-cask[[:space:]]' \
    "$brew_output_fixture/hostile-cask-receipt" \
    "an injection-like Caskroom token entered the typed receipt"
  assert_not_contains 'Failed cask:|brew remove --force|brew install --cask' \
    "$brew_output_fixture/hostile-cask-report" \
    "an injection-like Caskroom token received executable recovery advice"

  noninteractive_status=0
  gw_brew_run_logged \
    "$brew_output_fixture/noninteractive-log" \
    "$brew_output_fixture/noninteractive-receipt" reset \
    "Homebrew noninteractive fixture" -- \
    /bin/bash -c 'printf "%s\n" "Error: exact child status"; exit 17' \
    >"$brew_output_fixture/noninteractive-visible" 2>&1 \
    || noninteractive_status=$?
  [[ "$noninteractive_status" -eq 17 ]] \
    || fail "the noninteractive Homebrew runner changed child exit 17 to $noninteractive_status"
  grep -qxF 'Error: exact child status' "$brew_output_fixture/noninteractive-visible" \
    || fail "the noninteractive Homebrew runner hid a child error"
  grep -qx $'error\t1' "$brew_output_fixture/noninteractive-receipt" \
    || fail "the noninteractive Homebrew runner did not classify a child error"

  if GROUNDWORK_BREW_DEADLINE_SECONDS=0 gw_brew_run_logged \
    "$brew_output_fixture/invalid-bound-log" \
    "$brew_output_fixture/invalid-bound-receipt" reset \
    "Homebrew invalid bound fixture" -- /usr/bin/true \
    >"$brew_output_fixture/invalid-bound-visible" 2>&1; then
    fail "the Homebrew runner accepted an invalid hard deadline"
  fi
  test ! -e "$brew_output_fixture/invalid-bound-log" \
    || fail "an invalid Homebrew deadline mutated the log"
  test ! -e "$brew_output_fixture/invalid-bound-receipt" \
    || fail "an invalid Homebrew deadline mutated the receipt"

  cat >"$brew_output_fixture/formula-expected" <<'EOF'
git
homebrew/core/ripgrep
owner/tap/tool
EOF
  cat >"$brew_output_fixture/formula-metadata.json" <<'EOF'
{
  "formulae": [
    {"full_name":"git","installed":[{"version":"2.51.0"}],"versions":{"stable":"2.52.0"},"pinned":true,"outdated":true,"deprecated":false,"disabled":false},
    {"full_name":"homebrew/core/ripgrep","installed":[{"version":"14.1.1"}],"versions":{"stable":"14.1.1"},"pinned":false,"outdated":false,"deprecated":false,"disabled":false},
    {"full_name":"owner/tap/tool","installed":[{"version":"1.0"}],"versions":{"stable":"1.1"},"pinned":false,"outdated":true,"deprecated":false,"disabled":false}
  ],
  "casks": []
}
EOF
  gw_brew_classify_formula_metadata \
    "$brew_output_fixture/formula-metadata.json" \
    "$brew_output_fixture/formula-expected" \
    "$brew_output_fixture/formula-classification.tsv" \
    || fail "valid full-name Homebrew formula metadata did not classify"
  cat >"$brew_output_fixture/formula-classification.expected" <<'EOF'
git	pinned	pinned	2.51.0	2.52.0
homebrew/core/ripgrep	candidate	current-or-check	14.1.1	14.1.1
owner/tap/tool	candidate	outdated	1.0	1.1
EOF
  diff -u "$brew_output_fixture/formula-classification.expected" \
    "$brew_output_fixture/formula-classification.tsv" \
    || fail "Homebrew formula full-name/pin classification changed"
  printf '%s\n' git git homebrew/core/ripgrep owner/tap/tool \
    >"$brew_output_fixture/formula-duplicate-set"
  if gw_brew_classify_formula_metadata \
    "$brew_output_fixture/formula-metadata.json" \
    "$brew_output_fixture/formula-duplicate-set" \
    "$brew_output_fixture/formula-duplicate.tsv" >/dev/null 2>&1; then
    fail "duplicate formula identities were accepted"
  fi

  cat >"$brew_output_fixture/cask-expected" <<'EOF'
ordinary-outdated
ordinary-current
docker-desktop
self-current
chatgpt
cursor
claude
obsidian
privileged-only
pinned-cask
latest-cask
latest-unchecked
chatgpt-classic
unknown-vendor
unchecked-cask
disabled-cask
deprecated-cask
EOF
  cat >"$brew_output_fixture/cask-metadata.json" <<'EOF'
{
  "formulae": [],
  "casks": [
    {"token":"ordinary-outdated","installed":"1.0","version":"1.1","sha256":"sha","auto_updates":false,"pinned":false,"outdated":true,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"ordinary-current","installed":"1.1","version":"1.1","sha256":"sha","auto_updates":null,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"docker-desktop","installed":"4.85.0,235549","version":"4.86.0,236216","sha256":"sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[{"uninstall":[{"launchctl":["com.docker.helper"],"delete":["/Library/PrivilegedHelperTools/com.docker.vmnetd"]}]}]},
    {"token":"self-current","installed":"2.0","version":"2.0","sha256":"sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"chatgpt","installed":"1.0","version":"1.1","sha256":"sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"cursor","installed":"1.0","version":"1.1","sha256":"sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[{"app":["Cursor.app"]}]},
    {"token":"claude","installed":"1.0","version":"1.1","sha256":"sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"obsidian","installed":"1.0","version":"1.1","sha256":"sha","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"privileged-only","installed":"3.0","version":"3.1","sha256":"sha","auto_updates":false,"pinned":false,"outdated":true,"deprecated":false,"disabled":false,"artifacts":[{"uninstall":[{"launchctl":["example.helper"]}]}]},
    {"token":"pinned-cask","installed":"1.0","version":"1.1","sha256":"sha","auto_updates":false,"pinned":true,"outdated":true,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"latest-cask","installed":"0","version":"latest","sha256":"sha","auto_updates":false,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"latest-unchecked","installed":"0","version":"latest","sha256":"no_check","auto_updates":false,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"chatgpt-classic","installed":"1.2026.184","version":"1.2026.184","sha256":"no_check","auto_updates":true,"pinned":false,"outdated":false,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"unknown-vendor","installed":"1.0","version":"1.1","sha256":"no_check","auto_updates":true,"pinned":false,"outdated":true,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"unchecked-cask","installed":"1.0","version":"1.1","sha256":"no_check","auto_updates":false,"pinned":false,"outdated":true,"deprecated":false,"disabled":false,"artifacts":[]},
    {"token":"disabled-cask","installed":"1.0","version":"1.1","sha256":"sha","auto_updates":false,"pinned":false,"outdated":true,"deprecated":false,"disabled":true,"artifacts":[]},
    {"token":"deprecated-cask","installed":"1.0","version":"1.1","sha256":"sha","auto_updates":false,"pinned":false,"outdated":true,"deprecated":true,"disabled":false,"artifacts":[]}
  ]
}
EOF
  cp home/dot_local/share/groundwork/vendor-updater-casks.txt \
    "$brew_output_fixture/vendor-updater-casks.txt"
