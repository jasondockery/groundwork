  cat >"$adoption_bin/plutil" <<'SH'
#!/usr/bin/env bash
count="$(cat "$HOME/.adopt-plutil-count" 2>/dev/null || echo 0)"
count=$((count + 1))
printf '%s\n' "$count" >"$HOME/.adopt-plutil-count"
case "${2:-}" in
  CFBundleIdentifier) printf '%s\n' "${ADOPT_BUNDLE_ID:-com.openai.codex}" ;;
  CFBundleShortVersionString)
