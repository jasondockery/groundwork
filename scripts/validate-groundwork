  cat >"$adoption_bin/codesign" <<'SH'
#!/usr/bin/env bash
app=""
for argument in "$@"; do app="$argument"; done
[[ "$app" == */ChatGPT.app ]] || exit 1
if [[ "${1:-}" == --verify ]]; then
  count="$(cat "$HOME/.adopt-codesign-verify-count" 2>/dev/null || echo 0)"
  count=$((count + 1))
  printf '%s\n' "$count" >"$HOME/.adopt-codesign-verify-count"
