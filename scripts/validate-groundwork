if [[ "${1:-}" == "exec" && "${2:-}" == "--" && "${3:-}" == "npm" &&
  "${4:-}" == "config" ]]; then
  [[ "${NPM_CONFIG_STATUS:-0}" == "0" ]] || exit "$NPM_CONFIG_STATUS"
