      fail "groundwork-app-adopt treated $process_case process observation as stopped"
    fi
    grep -qF 'running application state could not be observed' \
      "$adoption_fixture/process-$process_case"
  done

  rm -f "$adoption_home/.adopt-plutil-count" "$adoption_home/.adopt-ps-count"
  : >"$adoption_fixture/commands.log"
  if env "${adoption_env[@]}" CI=1 \
    /bin/bash home/dot_local/bin/executable_groundwork-app-adopt chatgpt \
