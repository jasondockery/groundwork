exit 1
SH
  cat >"$cleanup_bin/pnpm" <<SH
#!/usr/bin/env bash
explicit_store_base=""
if [[ "\${1:-}" == "--store-dir" ]]; then
  explicit_store_base="\${2:-}"
  shift 2
fi
case "\$PWD" in
  */repo-offline) exit 1 ;;
  */repo-version-fail)
    version=unavailable
    store="$cleanup_fixture/custom-store/v11"
    ;;
  */repo-custom)
    version=11.3.0
    store="$cleanup_fixture/custom-store/v11"
    ;;
  */repo-absent-store)
    # pnpm names where the store WOULD be. This one is deliberately never
    # created, which is the ordinary state of a machine that has not run an
    # install for this generation yet.
    version=13.0.0
    store="$cleanup_fixture/stores/v13"
    ;;
  */repo-absent-untrusted)
    version=13.1.0
    store="$cleanup_fixture/untrusted-store/v13"
    ;;
  */repo-absent-malformed)
    version=13.2.0
    store="$cleanup_fixture/stores/v-not-created"
    ;;
  */repo-dangling-store)
    version=14.0.0
    store="$cleanup_fixture/stores/v14"
    ;;
  */repo-conflict)
    version=10.1.0
    store="$cleanup_fixture/stores/v11"
    ;;
  */false-marker)
    printf 'false marker queried\n' >>"\$GROUNDWORK_TEST_LOG"
    version=13.0.0
    store="$cleanup_fixture/stores/v11"
    ;;
  */repo-c)
    version=10.0.0
    store="$cleanup_fixture/stores/v10"
    ;;
  */repo-b)
    version=11.2.0
    store="$cleanup_fixture/stores/v11"
    ;;
  *)
    version=11.1.0
    store="$cleanup_fixture/stores/v11"
    ;;
esac
if [[ -n "\$explicit_store_base" && "\$version" != "unavailable" ]]; then
  store="\$explicit_store_base/v\${version%%.*}"
fi
if [[ "\${1:-}" == "--version" ]]; then
  [[ "\${PNPM_VERSION_OBSERVE_STATUS:-0}" == "0" ]] || exit "\$PNPM_VERSION_OBSERVE_STATUS"
  [[ "\$version" != "unavailable" ]] || exit 1
  printf '%s\n' "\$version"
  exit 0
fi
if [[ "\${1:-}" == "store" && "\${2:-}" == "path" ]]; then
  [[ "\${PNPM_STORE_PATH_STATUS:-0}" == "0" ]] || exit "\$PNPM_STORE_PATH_STATUS"
  printf '%s\n' "\$store"
  exit 0
fi
if [[ "\${1:-}" == "store" && "\${2:-}" == "prune" ]]; then
  if [[ "\${PNPM_DRAIN_STDIN:-0}" == "1" ]]; then
    cat >/dev/null
  fi
  printf 'pnpm store prune version=%s store=%s base=%s pwd=%s net=%s\n' \
    "\$version" "\$store" "\$explicit_store_base" "\$PWD" \
    "\${COREPACK_ENABLE_NETWORK:-unset}" >>"\$GROUNDWORK_TEST_LOG"
  if [[ "\$version" == "10.0.0" && "\${PNPM_V10_STATUS:-0}" != "0" ]]; then
    exit "\$PNPM_V10_STATUS"
  fi
fi
SH
  cat >"$cleanup_bin/du" <<'SH'
#!/usr/bin/env bash
[[ "${DU_STATUS:-0}" == "0" ]] || exit "$DU_STATUS"
if [[ -n "${DU_CALL_COUNT_FILE:-}" ]]; then
  du_call_count=0
  [[ ! -f "$DU_CALL_COUNT_FILE" ]] || du_call_count="$(<"$DU_CALL_COUNT_FILE")"
  du_call_count=$((du_call_count + 1))
  printf '%s\n' "$du_call_count" >"$DU_CALL_COUNT_FILE"
  if [[ "$du_call_count" -eq "${DU_SIGNAL_ON_CALL:-0}" ]]; then
    exit "${DU_SIGNAL_STATUS:-130}"
  fi
fi
if [[ "${LOG_DU:-0}" == "1" ]]; then
  printf 'du %s\n' "${@: -1}" >>"$GROUNDWORK_TEST_LOG"
fi
if [[ -n "${FAKE_DU_BLOCKS:-}" ]]; then
  printf '%s\t%s\n' "$FAKE_DU_BLOCKS" "${@: -1}"
else
  exec /usr/bin/du "$@"
fi
SH
  chmod +x "$cleanup_bin/brew" "$cleanup_bin/mise" "$cleanup_bin/pnpm" \
    "$cleanup_bin/du" "$cleanup_bin/groundwork-repos"

  cleanup_env=(
    HOME="$cleanup_home"
    XDG_CACHE_HOME="$cleanup_home/.cache"
    XDG_CONFIG_HOME="$cleanup_home/.config"
    PATH="/usr/bin:/bin"
    GROUNDWORK_TEST_LOG="$cleanup_log"
    CLEANUP_BREW_CACHE="$cleanup_fixture/brew-cache"
    CLEANUP_NPM_CACHE="$cleanup_fixture/npm-cache"
    GROUNDWORK_MAINTENANCE_DEADLINE_SECONDS=5
    GROUNDWORK_MAINTENANCE_OBSERVE_DEADLINE_SECONDS=5
    GROUNDWORK_MAINTENANCE_HEARTBEAT_SECONDS=1
    GROUNDWORK_MAINTENANCE_CANCEL_GRACE_SECONDS=1
    GROUNDWORK_MAINTENANCE_POLL_SECONDS=0.05
    GROUNDWORK_MAINTENANCE_ORPHAN_GRACE_SECONDS=3
  )

  # Help and invalid intent are decided before every external query or mutation.
  : >"$cleanup_log"
  env "${cleanup_env[@]}" "$cleanup_command" --help >"$cleanup_fixture/help"
  test ! -s "$cleanup_log" || fail "groundwork-cleanup --help invoked external commands"
  grep -qF 'groundwork-cleanup --yes --force  exceptional: attempt Homebrew/npm and every eligible pnpm candidate now' \
    "$cleanup_fixture/help" \
    || fail "groundwork-cleanup help must keep force available as an exceptional override"
  grep -qF 'Use --force only to ignore' "$cleanup_fixture/help" \
    || fail "groundwork-cleanup help must not present force as the routine retry"
  for hostile in --nope extra --force; do
    : >"$cleanup_log"
    set +e
    env "${cleanup_env[@]}" "$cleanup_command" "$hostile" >/dev/null 2>&1
    cleanup_status=$?
    set -e
    [[ "$cleanup_status" -eq 64 ]] \
      || fail "groundwork-cleanup '$hostile' must exit 64, got $cleanup_status"
    test ! -s "$cleanup_log" || fail "hostile cleanup argument '$hostile' invoked external commands"
  done
  for clear_args in \
    "--clear-pending" \
    "--clear-pending homebrew" \
    "--yes --clear-pending unknown" \
    "--yes --force --clear-pending homebrew"; do
    : >"$cleanup_log"
    set +e
    # shellcheck disable=SC2086 # Each fixed fixture intentionally supplies multiple argv words.
    env "${cleanup_env[@]}" "$cleanup_command" $clear_args >/dev/null 2>&1
    cleanup_status=$?
    set -e
    [[ "$cleanup_status" -eq 64 ]] \
      || fail "groundwork-cleanup '$clear_args' must exit 64, got $cleanup_status"
    test ! -s "$cleanup_log" \
      || fail "invalid clear-pending intent '$clear_args' invoked external commands"
  done
  for invalid_deadline in 0 nope; do
    : >"$cleanup_log"
    set +e
    env "${cleanup_env[@]}" GROUNDWORK_MAINTENANCE_DEADLINE_SECONDS="$invalid_deadline" \
      "$cleanup_command" --yes >/dev/null 2>&1
    cleanup_status=$?
    set -e
    [[ "$cleanup_status" -eq 64 ]] \
      || fail "invalid maintenance deadline '$invalid_deadline' must exit 64"
    test ! -s "$cleanup_log" \
      || fail "invalid maintenance deadline '$invalid_deadline' invoked external commands"
  done
  for invalid_orphan_grace in 0 nope; do
    : >"$cleanup_log"
    set +e
    env "${cleanup_env[@]}" \
      GROUNDWORK_MAINTENANCE_ORPHAN_GRACE_SECONDS="$invalid_orphan_grace" \
      "$cleanup_command" --yes >/dev/null 2>&1
    cleanup_status=$?
    set -e
    [[ "$cleanup_status" -eq 64 ]] \
      || fail "invalid maintenance orphan grace '$invalid_orphan_grace' must exit 64"
    test ! -s "$cleanup_log" \
      || fail "invalid maintenance orphan grace '$invalid_orphan_grace' invoked external commands"
  done
  for invalid_poll in 0 nope 0.0 0.001 1.01 10; do
    : >"$cleanup_log"
    set +e
    env "${cleanup_env[@]}" GROUNDWORK_MAINTENANCE_POLL_SECONDS="$invalid_poll" \
      "$cleanup_command" --yes >/dev/null 2>&1
    cleanup_status=$?
    set -e
    [[ "$cleanup_status" -eq 64 ]] \
      || fail "invalid maintenance poll '$invalid_poll' must exit 64"
    test ! -s "$cleanup_log" \
      || fail "invalid maintenance poll '$invalid_poll' invoked external commands"
  done

  # Default report: canonical Git repositories and exact pins yield two trusted
  # candidates. Same-major selectors choose the highest pin deterministically;
  # offline, unknown-version, custom-root, false-marker, and whole-generation
  # cases stay review-only.
  : >"$cleanup_log"
  (cd "$cleanup_fixture/unrelated" && env "${cleanup_env[@]}" "$cleanup_command") \
    >"$cleanup_fixture/report"
  grep -qF 'Automatic candidates: 2' "$cleanup_fixture/report" \
    || {
      cat "$cleanup_fixture/report" >&2
      fail "cleanup discovery must deduplicate two pnpm versions sharing one canonical store"
    }
  grep -qF "Representative: $cleanup_code/repo-b" "$cleanup_fixture/report" \
    || {
      cat "$cleanup_fixture/report" >&2
      fail "same-major selectors must choose the highest exact pin deterministically"
    }
  grep -qF "Also selected by: $cleanup_code/repo-a (pnpm 11.1.0)" "$cleanup_fixture/report" \
    || fail "the report must list every repository sharing an automatic store"
  grep -qF "$cleanup_fixture/stores/v11" "$cleanup_fixture/report" \
    || fail "the report must name each exact automatic store"
  grep -qF "$cleanup_code/repo-offline" "$cleanup_fixture/report" \
    || fail "an offline-unavailable repository pin must be reported for review"
  grep -qF 'resolved a store but its pnpm version was unavailable' "$cleanup_fixture/report" \
    || fail "a store with an unmeasurable pnpm version must stay review-only"
  grep -qF 'custom store root is not trusted' "$cleanup_fixture/report" \
    || fail "a repository-controlled custom store must stay review-only"
  grep -qF 'packageManager contains a control character' "$cleanup_fixture/report" \
    || fail "a control-character packageManager value was not refused"
  grep -qF "$cleanup_code/repo-escape/package.json" "$cleanup_fixture/report" \
    || fail "an escape-bearing packageManager value was not refused"
  grep -qF 'prerelease pnpm pins are review-only' "$cleanup_fixture/report" \
    || fail "a prerelease pnpm pin entered unattended maintenance"
  grep -qF 'trusted_pnpm_store_root must be absolute' "$cleanup_fixture/report" \
    || fail "a relative trusted pnpm store root was not rejected explicitly"
  env "${cleanup_env[@]}" "$cleanup_command" >"$cleanup_fixture/report-other-cwd"
  grep -qF 'Automatic candidates: 2' "$cleanup_fixture/report-other-cwd" \
    || fail "relative trusted roots changed meaning with the launch directory"
  grep -qF 'trusted_pnpm_store_root must be absolute' "$cleanup_fixture/report-other-cwd" \
    || fail "relative trusted-root diagnostics changed with the launch directory"
  grep -qF 'pnpm v9 store' "$cleanup_fixture/report" \
    || fail "an unmatched whole store generation must be reported, never deleted"
  # A trusted v<number> path pnpm merely NAMES is not suspect. Every other
  # absent shape remains review-only, including malformed/untrusted paths and
  # dangling generation symlinks.
  assert_not_contains "$cleanup_fixture/stores/v13" "$cleanup_fixture/report" \
    "a trusted absent v<number> store was reported for review"
  test ! -e "$cleanup_fixture/stores/v13" \
    || fail "read-only maintenance created a trusted pnpm store directory that did not exist"
  grep -qF "$cleanup_fixture/untrusted-store/v13" "$cleanup_fixture/report" \
    || fail "a nonexistent untrusted pnpm store path bypassed owner review"
  grep -qF 'nonexistent store outside the trusted v<number> layout' "$cleanup_fixture/report" \
    || fail "nonexistent untrusted and malformed pnpm store paths lacked a trust-boundary diagnosis"
  grep -qF "$cleanup_fixture/stores/v-not-created" "$cleanup_fixture/report" \
    || fail "a malformed absent pnpm store generation bypassed owner review"
  grep -qF "$cleanup_fixture/stores/v14" "$cleanup_fixture/report" \
    || fail "a dangling pnpm store symlink bypassed owner review"
  grep -qF 'returned a dangling store symlink' "$cleanup_fixture/report" \
    || fail "a dangling pnpm store symlink lacked an explicit refusal reason"
  test -L "$cleanup_fixture/stores/v14" \
    || fail "read-only maintenance replaced the dangling pnpm store symlink"
  test ! -e "$cleanup_fixture/missing-store-generation" \
    || fail "read-only maintenance created the dangling pnpm store target"
  assert_not_contains 'false marker queried' "$cleanup_log" \
    "a false .git marker was trusted as a repository"
  test ! -s "$cleanup_log" || fail "the read-only cleanup report invoked a mutating command"
  test ! -e "$cleanup_home/.local/state/groundwork/pnpm-prune-last-success" \
    || fail "the read-only cleanup report changed cadence state"

  # Review-only generation discovery accepts only real v<major> directories.
  # It never follows a generation symlink out of the trusted root, measures
  # malformed v* names, or emits a control-bearing filesystem name.
  : >"$cleanup_log"
  env "${cleanup_env[@]}" LOG_DU=1 "$cleanup_command" \
    >"$cleanup_fixture/generation-safety" 2>&1
  grep -qF 'Store-generation symlinks are not followed' \
    "$cleanup_fixture/generation-safety" \
    || fail "a pnpm generation symlink was not reported safely"
  assert_not_contains 'external-generation|v11-escape|version-backup' "$cleanup_log" \
    "review-only generation discovery measured an escaped or malformed v* entry"
  if LC_ALL=C grep -q $'\033' "$cleanup_fixture/generation-safety"; then
    fail "a control-bearing pnpm generation name reached the terminal receipt"
  fi

  # Cache observations resolve relative package-manager paths against the same
  # $HOME boundary used for the query, and reject multi-line/control-bearing
  # values instead of measuring from the launch directory.
  mkdir -p "$cleanup_home/relative-brew-cache" "$cleanup_home/relative-npm-cache"
  : >"$cleanup_log"
  (cd "$cleanup_fixture/unrelated" && env "${cleanup_env[@]}" LOG_DU=1 \
    CLEANUP_BREW_CACHE=relative-brew-cache CLEANUP_NPM_CACHE=relative-npm-cache \
    "$cleanup_command") >"$cleanup_fixture/relative-cache-paths"
  grep -qF "du $cleanup_home/relative-brew-cache" "$cleanup_log" \
    || fail "a relative Homebrew cache path was measured from the launch directory"
  grep -qF "du $cleanup_home/relative-npm-cache" "$cleanup_log" \
    || fail "a relative npm cache path was measured from the launch directory"
  : >"$cleanup_log"
  env "${cleanup_env[@]}" CLEANUP_BREW_CACHE=$'line-one\nline-two' \
    CLEANUP_NPM_CACHE=$'unsafe\033path' "$cleanup_command" \
    >"$cleanup_fixture/unsafe-cache-paths" 2>&1
  grep -qF 'Homebrew cache query returned an unsupported multi-line value' \
    "$cleanup_fixture/unsafe-cache-paths"
  grep -qF 'npm cache query returned an empty or control-bearing path' \
    "$cleanup_fixture/unsafe-cache-paths"
  assert_not_contains 'unsafe.*path|line-one|line-two' "$cleanup_fixture/unsafe-cache-paths" \
    "an unsafe cache value reached the maintenance receipt"

  # First automatic pass is due, runs each canonical store exactly once from a
  # representative repository (not the unrelated launch directory), disables
  # Corepack networking, and records success even though the stub reclaims zero.
  : >"$cleanup_log"
  (cd "$cleanup_fixture/unrelated" && env "${cleanup_env[@]}" "$cleanup_command" --yes) \
    >"$cleanup_fixture/first-pass"
  [[ "$(grep -c '^pnpm store prune' "$cleanup_log")" -eq 2 ]] \
    || fail "the due pass must prune two distinct canonical stores exactly once each"
  grep -qE '^pnpm store prune version=11\.2\.0 store=.*/stores/v11 base=.*/stores pwd=.*/code/repo-b net=0$' \
    "$cleanup_log" \
    || fail "a shared pnpm store must prune through the deterministic highest exact pin"
  assert_not_contains "pwd=$cleanup_fixture/unrelated" "$cleanup_log" \
    "pnpm maintenance depended on update-all's incidental working directory"
  grep -qF 'net=0' "$cleanup_log" \
    || fail "automatic pnpm maintenance must keep Corepack networking disabled"
  test -f "$cleanup_home/.local/state/groundwork/pnpm-prune-last-success" \
    || fail "a successful no-op pnpm prune must advance cadence"

  # Failure to measure npm's cache must not suppress npm's supported verification.
  : >"$cleanup_log"
  env "${cleanup_env[@]}" NPM_CONFIG_STATUS=1 \
    "$cleanup_command" --yes >"$cleanup_fixture/npm-path-unavailable"
  grep -qE '^npm cache verify pwd=.*/package-maintenance-fixture/home$' "$cleanup_log" \
    || fail "an unavailable npm cache path must not skip npm cache verify"
  grep -qF 'Reclaimed: not measured' "$cleanup_fixture/npm-path-unavailable" \
    || fail "an unavailable npm cache path must produce an honest unmeasured receipt"

  # A second pass inside the cadence still maintains Homebrew/npm but skips pnpm;
  # --force is the explicit immediate path.
  : >"$cleanup_log"
  env "${cleanup_env[@]}" LOG_DU=1 "$cleanup_command" --yes >"$cleanup_fixture/not-due"
  assert_not_contains '^pnpm store prune' "$cleanup_log" \
    "pnpm was pruned again immediately after a successful no-op"
  assert_not_contains '^du .*(/stores/|/pnpm/store/)' "$cleanup_log" \
    "a non-due automatic run eagerly measured pnpm stores"
  grep -qF 'Maintenance not due' "$cleanup_fixture/not-due"
  touch -t 202001010000 "$cleanup_home/.local/state/groundwork/pnpm-prune-last-success"
  env "${cleanup_env[@]}" "$cleanup_command" >"$cleanup_fixture/content-cadence"
  grep -qF 'Maintenance: not due' "$cleanup_fixture/content-cadence" \
    || fail "pnpm cadence followed restored file mtime instead of its recorded timestamp"
  : >"$cleanup_log"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >"$cleanup_fixture/forced"
  [[ "$(grep -c '^pnpm store prune' "$cleanup_log")" -eq 2 ]] \
    || fail "--yes --force must prune every resolved store regardless of cadence"

  # Bounded children never inherit the record loop as stdin. A first pnpm that
  # drains stdin must not consume the remaining store records.
  : >"$cleanup_log"
  env "${cleanup_env[@]}" PNPM_DRAIN_STDIN=1 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/stdin-drain"
  [[ "$(grep -c '^pnpm store prune' "$cleanup_log")" -eq 2 ]] \
    || fail "a maintenance child consumed later pnpm store records from stdin"

  # Monthly and high-water triggers are independently observable.
  printf '946684800 2000-01-01T00:00:00Z\n' \
    >"$cleanup_home/.local/state/groundwork/pnpm-prune-last-success"
  touch "$cleanup_home/.local/state/groundwork/pnpm-prune-last-success"
  env "${cleanup_env[@]}" "$cleanup_command" >"$cleanup_fixture/monthly"
  grep -qF 'Maintenance: due (machine-wide success was' "$cleanup_fixture/monthly" \
    || fail "a success older than the monthly cadence must be due"
  printf '%s now\n' "$fixture_clock_epoch" \
    >"$cleanup_home/.local/state/groundwork/pnpm-prune-last-success"
  rm -f "$cleanup_home/.local/state/groundwork/pnpm-prune-last-attempt"
  env "${cleanup_env[@]}" FAKE_DU_BLOCKS=2097152 GROUNDWORK_PNPM_HIGH_WATER_GIB=1 \
    "$cleanup_command" >"$cleanup_fixture/high-water"
  grep -qF 'exceed the 1 GiB high-water mark' "$cleanup_fixture/high-water" \
    || fail "the high-water trigger must be reported when its attempt floor permits"

  # A failed high-water pass records a recent attempt, but pending repair
  # overrides that retry floor. The next normal --yes run retries and clears it.
  printf '%s now\n' "$fixture_clock_epoch" \
    >"$cleanup_home/.local/state/groundwork/pnpm-prune-last-success"
  rm -f "$cleanup_home/.local/state/groundwork/pnpm-prune-last-attempt" \
    "$cleanup_home/.local/state/groundwork/update-all-pending/pnpm"
  set +e
  env "${cleanup_env[@]}" FAKE_DU_BLOCKS=2097152 GROUNDWORK_PNPM_HIGH_WATER_GIB=1 \
    PNPM_V10_STATUS=1 "$cleanup_command" --yes >"$cleanup_fixture/high-water-failed" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -ne 0 ]] || fail "the simulated high-water failure returned success"
  test -f "$cleanup_home/.local/state/groundwork/update-all-pending/pnpm"
  : >"$cleanup_log"
  env "${cleanup_env[@]}" "$cleanup_command" --yes >"$cleanup_fixture/pending-retried"
  grep -qF 'pending repair' "$cleanup_fixture/pending-retried" \
    || fail "pending pnpm state did not override its recent high-water attempt floor"
  grep -qF 'pnpm store prune' "$cleanup_log" \
    || fail "ordinary --yes did not retry pending pnpm maintenance"
  test ! -e "$cleanup_home/.local/state/groundwork/update-all-pending/pnpm" \
    || fail "ordinary --yes did not clear repaired pnpm state"

  # Exact-pin discovery fails closed when the ambient jq command cannot parse:
  # the fixture replaces jq through PATH, never through an installed override.
  cat >"$cleanup_bin/jq" <<'SH'
#!/usr/bin/env bash
exit 1
SH
  chmod +x "$cleanup_bin/jq"
  : >"$cleanup_log"
  env "${cleanup_env[@]}" "$cleanup_command" >"$cleanup_fixture/jq-failure-report"
  grep -qF 'Automatic candidates: 0' "$cleanup_fixture/jq-failure-report"
  grep -qF 'jq failed its bounded self-check' "$cleanup_fixture/jq-failure-report"
  set +e
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force \
    >"$cleanup_fixture/jq-failure-run" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -ne 0 ]] || fail "failed exact-pin parsing was reported as complete"
  assert_not_contains '^pnpm store prune' "$cleanup_log" \
    "pnpm mutated a store while exact-pin parsing failed"
  rm -f "$cleanup_bin/jq"
  env "${cleanup_env[@]}" "$cleanup_command" --yes >/dev/null

  # Strict maintenance discovery rejects a partial repository stream whose
  # traversal exits nonzero. The partial row cannot create a candidate, pnpm is
  # untouched, and acting mode records the incomplete inventory durably.
  mv "$cleanup_bin/groundwork-repos" "$cleanup_fixture/groundwork-repos.strict-real"
  cat >"$cleanup_bin/groundwork-repos" <<'SH'
#!/usr/bin/env bash
printf '%s\t-\n' "${STRICT_PARTIAL_REPO:?}"
exit 7
SH
  chmod +x "$cleanup_bin/groundwork-repos"
  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" STRICT_PARTIAL_REPO="$cleanup_code/repo-a" \
    "$cleanup_command" --yes --force >"$cleanup_fixture/strict-partial-discovery" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -ne 0 ]] \
    || fail "partial strict repository discovery returned success"
  assert_not_contains '^pnpm store prune' "$cleanup_log" \
    "partial strict repository discovery produced an automatic pnpm mutation"
  grep -qF 'exact repository discovery is unavailable' \
    "$cleanup_home/.local/state/groundwork/update-all-pending/pnpm" \
    || fail "partial strict discovery did not record incomplete pnpm inventory"
  mv "$cleanup_fixture/groundwork-repos.strict-real" "$cleanup_bin/groundwork-repos"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null

  # No exact pnpm pin means no automatic candidate and, specifically, no ambient
  # HOME launcher fallback.
  cp "$cleanup_home/.config/groundwork/repos.conf" "$cleanup_fixture/repos.conf.saved"
  cat >"$cleanup_home/.config/groundwork/repos.conf" <<EOF
root = $cleanup_code/no-pin
max_depth = 1
include_worktrees = true
cache_ttl_seconds = 30
trusted_pnpm_store_root = $cleanup_fixture/stores
EOF
  : >"$cleanup_log"
  env "${cleanup_env[@]}" "$cleanup_command" >"$cleanup_fixture/no-pins"
  grep -qF 'Automatic candidates: 0' "$cleanup_fixture/no-pins"
  : >"$cleanup_log"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force \
    >"$cleanup_fixture/no-pins-force"
  assert_not_contains '^pnpm store prune' "$cleanup_log" \
    "forced maintenance treated an unpinned HOME launcher as a candidate"

  # --force means "run every supported candidate now", not "invent a pnpm
  # candidate". With pnpm absent or with only an untrusted custom store, it is a
  # successful no-op after the independent Homebrew/npm stages.
  mv "$cleanup_bin/pnpm" "$cleanup_fixture/pnpm.saved"
  : >"$cleanup_log"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force \
    >"$cleanup_fixture/no-pnpm-force" \
    || fail "--yes --force failed merely because pnpm is not installed"
  assert_not_contains '^pnpm store prune' "$cleanup_log" \
    "forced maintenance invoked pnpm while pnpm was absent"
  mv "$cleanup_fixture/pnpm.saved" "$cleanup_bin/pnpm"
  cat >"$cleanup_home/.config/groundwork/repos.conf" <<EOF
root = $cleanup_code/repo-custom
max_depth = 1
include_worktrees = true
cache_ttl_seconds = 30
trusted_pnpm_store_root = $cleanup_fixture/stores
EOF
  : >"$cleanup_log"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force \
    >"$cleanup_fixture/untrusted-only-force" \
    || fail "--yes --force failed with only review-required pnpm stores"
  assert_not_contains '^pnpm store prune' "$cleanup_log" \
    "forced maintenance pruned an untrusted custom store"

  # Existing pending state is different: it remains a repair failure until a
  # trusted exact-pinned candidate is available or the owner clears the reminder.
  mkdir -p "$cleanup_home/.local/state/groundwork/update-all-pending"
  printf 'recorded pnpm failure\n' \
    >"$cleanup_home/.local/state/groundwork/update-all-pending/pnpm"
  set +e
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force \
    >"$cleanup_fixture/pending-without-candidate" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -ne 0 ]] \
    || fail "pending pnpm repair was cleared without a trusted candidate"
  test -f "$cleanup_home/.local/state/groundwork/update-all-pending/pnpm"
  rm -f "$cleanup_home/.local/state/groundwork/update-all-pending/pnpm"
  mv "$cleanup_fixture/repos.conf.saved" "$cleanup_home/.config/groundwork/repos.conf"

  # One canonical store selected by different pnpm majors is review-only. The
  # unrelated trusted v10 store remains eligible.
  mkdir -p "$cleanup_code/repo-conflict"
  git -C "$cleanup_code/repo-conflict" init -q
  printf '{"packageManager":"pnpm@10.1.0"}\n' >"$cleanup_code/repo-conflict/package.json"
  env "${cleanup_env[@]}" "$cleanup_command" >"$cleanup_fixture/conflicting-majors"
  grep -qF 'conflicting pnpm majors (10,11)' "$cleanup_fixture/conflicting-majors" \
    || fail "same-store conflicting pnpm majors were not refused"
  grep -qF 'Automatic candidates: 1' "$cleanup_fixture/conflicting-majors" \
    || fail "a conflicting store suppressed an unrelated trusted candidate"
  : >"$cleanup_log"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null
  [[ "$(grep -c '^pnpm store prune' "$cleanup_log")" -eq 1 ]] \
    || fail "a conflicting pnpm-major store was pruned automatically"
  grep -qF "store=$cleanup_fixture/stores/v10" "$cleanup_log"
  mv "$cleanup_code/repo-conflict" "$cleanup_fixture/repo-conflict.hidden"

  # Independent failures become per-stage state. Retrying with pnpm repaired but
  # npm still failing clears only pnpm's record and remains nonzero for npm.
  rm -f "$cleanup_home/.local/state/groundwork/pnpm-prune-last-success"
  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" NPM_MAINTENANCE_STATUS=1 PNPM_V10_STATUS=1 \
    "$cleanup_command" --yes >"$cleanup_fixture/partial" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -ne 0 ]] || fail "partial package maintenance must exit nonzero"
  test -f "$cleanup_home/.local/state/groundwork/update-all-pending/npm"
  test -f "$cleanup_home/.local/state/groundwork/update-all-pending/pnpm"
  assert_recovery_hierarchy "$cleanup_fixture/partial" \
    "the direct cleanup failure output"
  assert_not_contains 'Repair with:|or run maintenance only:' "$cleanup_command" \
    "the cleanup source must not preserve force-first recovery guidance"
  [[ "$(grep -c '^pnpm store prune' "$cleanup_log")" -eq 2 ]] \
    || fail "one failed pnpm store prevented a later independent store attempt"
  printf '%s\n' "$fixture_clock_epoch" \
    >"$cleanup_home/.local/state/groundwork/pnpm-prune-last-success"
  set +e
  env "${cleanup_env[@]}" NPM_MAINTENANCE_STATUS=1 \
    "$cleanup_command" --yes >"$cleanup_fixture/retry" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -ne 0 ]] || fail "an unrepaired npm stage must keep the retry nonzero"
  test -f "$cleanup_home/.local/state/groundwork/update-all-pending/npm"
  grep -qF 'a previous pnpm maintenance attempt is pending repair' \
    "$cleanup_fixture/retry" \
    || fail "ordinary --yes did not let pending pnpm repair override fresh cadence"
  test ! -e "$cleanup_home/.local/state/groundwork/update-all-pending/pnpm" \
    || fail "ordinary --yes must repair pnpm pending state without --force"

  # An old Homebrew-only marker migrates into generalized state. A still-failing
  # Homebrew repair remains nonzero and visible until a later pass completes it.
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null
  printf 'old cleanup failed\n' >"$cleanup_home/.local/state/groundwork/homebrew-cleanup-pending"
  set +e
  env "${cleanup_env[@]}" BREW_MAINTENANCE_STATUS=1 \
    "$cleanup_command" --yes >"$cleanup_fixture/legacy-pending" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -ne 0 ]] \
    || fail "a still-failing package manager must not silently clear its pending maintenance"
  test -f "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "the legacy Homebrew marker was not migrated into per-stage state"
  test ! -e "$cleanup_home/.local/state/groundwork/homebrew-cleanup-pending" \
    || fail "the legacy marker remained after its state was migrated"
  env "${cleanup_env[@]}" "$cleanup_command" >"$cleanup_fixture/pending-report"
  grep -qF 'Pending repair' "$cleanup_fixture/pending-report" \
    || fail "the read-only cleanup report must expose pending repair state"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null
  test ! -e "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "a later successful Homebrew pass did not clear migrated pending state"

  # When a manager has intentionally disappeared, only the owner-confirmed
  # acknowledgement clears Groundwork's reminder. It performs no maintenance and
  # preserves an audit note naming the unresolved record.
  mkdir -p "$cleanup_home/.local/state/groundwork/update-all-pending"
  printf 'recorded Homebrew failure\n' \
    >"$cleanup_home/.local/state/groundwork/update-all-pending/homebrew"
  : >"$cleanup_log"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --clear-pending homebrew \
    >"$cleanup_fixture/clear-pending"
  test ! -e "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "owner-confirmed pending acknowledgement did not clear its reminder"
  test ! -s "$cleanup_log" \
    || fail "--clear-pending ran package-manager maintenance"
  grep -qF 'No package-manager maintenance was performed' "$cleanup_fixture/clear-pending"
  grep -qF 'stage=homebrew' \
    "$cleanup_home/.local/state/groundwork/update-all-pending-cleared.log" \
    || fail "--clear-pending did not preserve an audit note"

  check "groundwork-cleanup: real lock contention runtime"
  install_fixture_runtime_runner \
    "$cleanup_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_runtime_clock "$cleanup_bin/date"

  # Direct maintenance is single-writer. The second process fails fast with 75
  # while the first owns the lock, and only the owner executes mutations.
  : >"$cleanup_log"
  env "${cleanup_env[@]}" GROUNDWORK_MAINTENANCE_POLL_SECONDS=0.1 \
    BREW_MAINTENANCE_DELAY=2 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/concurrent-owner" 2>&1 &
  cleanup_owner_pid=$!
  for _ in {1..50}; do
    [[ -d "$cleanup_home/.local/state/groundwork/update-all.lock" ]] && break
    sleep 0.1
  done
  set +e
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force \
    >"$cleanup_fixture/concurrent-refused" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 75 ]] \
    || fail "a concurrent cleanup must fail with 75, got $cleanup_status"
  grep -qF 'already active' "$cleanup_fixture/concurrent-refused"
  wait "$cleanup_owner_pid"
  [[ "$(grep -c '^brew ' "$cleanup_log")" -eq 2 ]] \
    || fail "the refused concurrent cleanup executed package-manager mutations"

  check "groundwork-cleanup: lock and terminal-status policy matrices"
  install_fixture_policy_runner \
    "$cleanup_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_policy_clock "$cleanup_bin/date"

  # Dead owners are reclaimed. A live PID with a different recorded process
  # start is also stale rather than blocking forever after PID reuse.
  cleanup_lock="$cleanup_home/.local/state/groundwork/update-all.lock"
  mkdir -p "$cleanup_lock"
  TZ=UTC touch -t 203001010000 "$cleanup_lock"
  set +e
  env "${cleanup_env[@]}" GROUNDWORK_UPDATE_LOCK_INCOMPLETE_GRACE_SECONDS=2 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/young-incomplete-lock" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 75 ]] \
    || fail "a young incomplete maintenance lock must fail fast with 75"
  touch -t 200001010000 "$cleanup_lock"
  env "${cleanup_env[@]}" GROUNDWORK_UPDATE_LOCK_INCOMPLETE_GRACE_SECONDS=1 \
    "$cleanup_command" --yes --force >/dev/null \
    || fail "an old incomplete maintenance lock was not reclaimed"
  mkdir -p "$cleanup_lock"
  printf '%s\n' "$$" >"$cleanup_lock/pid"
  printf 'partial\n' >"$cleanup_lock/operation"
  touch -t 200001010000 "$cleanup_lock"
  env "${cleanup_env[@]}" GROUNDWORK_UPDATE_LOCK_INCOMPLETE_GRACE_SECONDS=1 \
    "$cleanup_command" --yes --force >/dev/null \
    || fail "old partial metadata with a live or reused PID blocked forever"
  mkdir -p "$cleanup_lock"
  printf '99999999\n' >"$cleanup_lock/pid"
  printf '2000-01-01T00:00:00Z\n' >"$cleanup_lock/started-at"
  printf 'fixture-dead-owner\n' >"$cleanup_lock/operation"
  printf 'old\n' >"$cleanup_lock/process-start"
  printf 'stale-token\n' >"$cleanup_lock/token"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null \
    || fail "a dead-owner maintenance lock was not reclaimed"
  mkdir -p "$cleanup_lock"
  printf '%s\n' "$$" >"$cleanup_lock/pid"
  printf '2000-01-01T00:00:00Z\n' >"$cleanup_lock/started-at"
  printf 'fixture-reused-pid\n' >"$cleanup_lock/operation"
  printf 'not-the-current-process-start\n' >"$cleanup_lock/process-start"
  printf 'reused-token\n' >"$cleanup_lock/token"
  cat >"$cleanup_bin/ps" <<'SH'
#!/usr/bin/env bash
if [[ "$*" == *"lstart="* && "$*" == *"-p ${LOCK_REUSED_PID:?}"* ]]; then
  echo "current-process-start"
  exit 0
fi
exec /bin/ps "$@"
SH
  chmod +x "$cleanup_bin/ps"
  env "${cleanup_env[@]}" LOCK_REUSED_PID="$$" \
    "$cleanup_command" --yes --force >/dev/null \
    || fail "a reused-PID maintenance lock was not reclaimed"
  rm -f "$cleanup_bin/ps"
  mkdir -p "$cleanup_lock"
  printf '99999999\n' >"$cleanup_lock/pid"
  printf '2000-01-01T00:00:00Z\n' >"$cleanup_lock/started-at"
  printf 'changed-operation\n' >"$cleanup_lock/operation"
  printf 'old\n' >"$cleanup_lock/process-start"
  printf 'snapshot-token\n' >"$cleanup_lock/token"
  set +e
  HOME="$cleanup_home" \
    bash -c 'source "$1"; groundwork_lock_remove_stale 99999999 "2000-01-01T00:00:00Z" snapshot-operation snapshot-token old' \
    _ "$cleanup_home/.local/lib/groundwork/update-lock.sh"
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -ne 0 ]] \
    || fail "stale-lock removal ignored a changed operation snapshot"
  test -d "$cleanup_lock" \
    || fail "stale-lock removal deleted metadata that changed during inspection"
  touch -t 200001010000 "$cleanup_lock"
  env "${cleanup_env[@]}" GROUNDWORK_UPDATE_LOCK_INCOMPLETE_GRACE_SECONDS=1 \
    "$cleanup_command" --yes --force >/dev/null
  set +e
  env "${cleanup_env[@]}" GROUNDWORK_UPDATE_LOCK_HELD=1 \
    GROUNDWORK_UPDATE_LOCK_TOKEN=forged "$cleanup_command" --yes --force \
    >"$cleanup_fixture/forged-inherited-lock" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 75 ]] \
    || fail "a forged inherited maintenance lock was accepted"

  # Lock ownership is never declared when the process-start identity cannot be
  # observed. The failed acquisition removes its newly created empty directory.
  cat >"$cleanup_bin/ps" <<'SH'
#!/usr/bin/env bash
exit 1
SH
  chmod +x "$cleanup_bin/ps"
  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force \
    >"$cleanup_fixture/lock-identity-unavailable" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 75 ]] \
    || fail "missing lock-owner identity returned $cleanup_status instead of 75"
  grep -qF 'could not establish update lock-owner identity' \
    "$cleanup_fixture/lock-identity-unavailable"
  test ! -d "$cleanup_lock" \
    || fail "failed lock identity left a reclaimable lock directory behind"
  test ! -s "$cleanup_log" \
    || fail "maintenance mutated state without a validated lock-owner identity"
  rm -f "$cleanup_bin/ps"

  # Observation failures that carry conventional signal statuses are
  # authoritative. They must stop before the first package-manager mutation
  # instead of being converted into an unavailable measurement or review item.
  mv "$cleanup_bin/groundwork-repos" "$cleanup_fixture/groundwork-repos.real"
  cat >"$cleanup_bin/groundwork-repos" <<'SH'
#!/usr/bin/env bash
exit "${REPOSITORY_DISCOVERY_STATUS:-0}"
SH
  chmod +x "$cleanup_bin/groundwork-repos"
  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" REPOSITORY_DISCOVERY_STATUS=129 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/observation-discovery-signal" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 129 ]] \
    || fail "repository-discovery signal status became $cleanup_status, expected 129"
  test ! -s "$cleanup_log" \
    || fail "repository-discovery interruption allowed package-manager mutation"
  mv "$cleanup_fixture/groundwork-repos.real" "$cleanup_bin/groundwork-repos"

  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" PNPM_STORE_PATH_STATUS=130 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/observation-store-signal" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 130 ]] \
    || fail "pnpm store-path signal status became $cleanup_status, expected 130"
  test ! -s "$cleanup_log" \
    || fail "pnpm store-path interruption allowed package-manager mutation"

  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" DU_STATUS=143 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/observation-du-signal" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 143 ]] \
    || fail "du signal status became $cleanup_status, expected 143"
  test ! -s "$cleanup_log" \
    || fail "size-observation interruption allowed package-manager mutation"

  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" BREW_CACHE_STATUS=129 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/observation-brew-signal" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 129 ]] \
    || fail "Homebrew cache signal status became $cleanup_status, expected 129"
  test ! -s "$cleanup_log" \
    || fail "Homebrew-cache interruption allowed package-manager mutation"

  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" NPM_CONFIG_STATUS=130 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/observation-npm-signal" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 130 ]] \
    || fail "npm cache signal status became $cleanup_status, expected 130"
  test ! -s "$cleanup_log" \
    || fail "npm-cache interruption allowed package-manager mutation"

  check "groundwork-cleanup: real deadline, signal, and process-tree runtime"
  install_fixture_runtime_runner \
    "$cleanup_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_runtime_clock "$cleanup_bin/date"
  cp "$cleanup_home/.config/groundwork/repos.conf" \
    "$cleanup_fixture/repos.runtime.saved"
  cat >"$cleanup_home/.config/groundwork/repos.conf" <<EOF
root = $cleanup_code/no-pin
max_depth = 1
include_worktrees = true
cache_ttl_seconds = 0
EOF

  # A real TERM during a bounded observation follows the same path and releases
  # the lock without creating pending mutation state.
  brew_cache_sentinel="$cleanup_fixture/brew-cache-observation.started"
  rm -f "$brew_cache_sentinel"
  : >"$cleanup_log"
  env "${cleanup_env[@]}" BREW_CACHE_SENTINEL="$brew_cache_sentinel" \
    BREW_CACHE_DELAY=30 "$cleanup_command" --yes --force \
    >"$cleanup_fixture/observation-real-term" 2>&1 &
  cleanup_signal_pid=$!
  for _ in {1..100}; do
    [[ -f "$brew_cache_sentinel" ]] && break
    sleep 0.1
  done
  test -f "$brew_cache_sentinel" \
    || fail "the delayed Homebrew cache observation never started"
  kill -TERM "$cleanup_signal_pid"
  set +e
  wait "$cleanup_signal_pid"
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 143 ]] \
    || fail "TERM during observation returned $cleanup_status, expected 143"
  test ! -s "$cleanup_log" \
    || fail "TERM during observation allowed package-manager mutation"
  test ! -d "$cleanup_home/.local/state/groundwork/update-all.lock" \
    || fail "TERM during observation left the maintenance lock behind"

  # The local signal traps exist before launch. A maintenance child that signals
  # its parent immediately is still cancelled, returns 143, records pending
  # state, and cannot escape through the launch window.
  rm -rf "$cleanup_home/.local/state/groundwork/update-all-pending"
  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" BREW_SIGNAL_PARENT_ON_START=1 \
    "$cleanup_command" --yes --force \
    >"$cleanup_fixture/signal-launch-window" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 143 ]] \
    || fail "TERM in the child-launch window returned $cleanup_status, expected 143"
  grep -qF 'interrupted (exit 143)' \
    "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "launch-window TERM did not preserve Homebrew state"
  test ! -d "$cleanup_home/.local/state/groundwork/update-all.lock" \
    || fail "launch-window TERM left the maintenance lock behind"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null

  # A healthy command that stays quiet long enough emits a heartbeat and still
  # succeeds before its hard deadline.
  env "${cleanup_env[@]}" GROUNDWORK_MAINTENANCE_POLL_SECONDS=1 \
    GROUNDWORK_MAINTENANCE_DEADLINE_SECONDS=5 \
    BREW_MAINTENANCE_DELAY=2 "$cleanup_command" --yes --force \
    >"$cleanup_fixture/heartbeat" 2>&1 \
    || fail "a healthy slow maintenance command failed before its deadline"
  grep -qF 'Still running: brew autoremove' "$cleanup_fixture/heartbeat" \
    || fail "a quiet maintenance command emitted no heartbeat"

  # A timed-out package-manager stage cancels descendants in its process group,
  # not only the direct shell process.
  descendant_pid_file="$cleanup_fixture/descendant.pid"
  set +e
  # Leave enough time for the command's bounded preflight operations to finish
  # on a loaded CI runner. The 30-second descendant remains the operation that
  # must cross this deadline and exercise process-group cancellation.
  env "${cleanup_env[@]}" GROUNDWORK_MAINTENANCE_POLL_SECONDS=1 \
    GROUNDWORK_MAINTENANCE_DEADLINE_SECONDS=5 \
    BREW_SPAWN_DESCENDANT=1 BREW_DESCENDANT_PID_FILE="$descendant_pid_file" \
    "$cleanup_command" --yes >"$cleanup_fixture/process-tree-timeout" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 124 ]] \
    || fail "a timed-out process tree returned $cleanup_status instead of deadline status 124"
  grep -qF 'brew autoremove was incomplete (exit 124)' \
    "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "the hard deadline was not preserved in Homebrew pending state"
  test -s "$descendant_pid_file" \
    || fail "the process-tree timeout did not reach the descendant fixture"
  descendant_pid="$(<"$descendant_pid_file")"
  for _ in {1..20}; do
    descendant_state="$(ps -o stat= -p "$descendant_pid" 2>/dev/null | tr -d '[:space:]' || true)"
    [[ -z "$descendant_state" || "$descendant_state" == Z* ]] && break
    sleep 0.1
  done
  if [[ -n "$descendant_state" && "$descendant_state" != Z* ]]; then
    fail "a package-manager descendant survived the hard deadline"
  fi
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null

  # Acting mode records manager intent before the first mutation. Once the
  # successful cleanup stub has logged its work, a TERM before post-measurement
  # cannot erase that durable "completion not proven" state.
  rm -rf "$cleanup_home/.local/state/groundwork/update-all-pending"
  brew_success_sentinel="$cleanup_fixture/brew-cleanup-success.started"
  rm -f "$brew_success_sentinel"
  : >"$cleanup_log"
  env "${cleanup_env[@]}" BREW_CLEANUP_SUCCESS_SENTINEL="$brew_success_sentinel" \
    BREW_CLEANUP_POST_SUCCESS_DELAY=30 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/pre-marked-term" 2>&1 &
  cleanup_signal_pid=$!
  for _ in {1..200}; do
    [[ -f "$brew_success_sentinel" ]] && break
    sleep 0.05
  done
  test -f "$brew_success_sentinel" \
    || fail "the successful Homebrew mutation sentinel never appeared"
  grep -qF 'maintenance started' \
    "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "Homebrew intent was not durable before post-maintenance measurement"
  kill -TERM "$cleanup_signal_pid"
  set +e
  wait "$cleanup_signal_pid"
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 143 ]] \
    || fail "TERM after a successful mutation returned $cleanup_status, expected 143"
  test -f "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "TERM after a successful mutation lost Homebrew pending state"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null

  # A group leader cannot declare success while a background descendant remains.
  # After the post-leader drain grace, the helper identifies and cancels the
  # TERM-resistant descendant without waiting for the larger operation deadline.
  orphan_descendant_pid_file="$cleanup_fixture/orphan-descendant.pid"
  rm -f "$orphan_descendant_pid_file"
  set +e
  env "${cleanup_env[@]}" GROUNDWORK_MAINTENANCE_POLL_SECONDS=0.1 \
    GROUNDWORK_MAINTENANCE_DEADLINE_SECONDS=8 \
    GROUNDWORK_MAINTENANCE_ORPHAN_GRACE_SECONDS=1 \
    BREW_EXIT_WITH_DESCENDANT=1 BREW_DESCENDANT_PID_FILE="$orphan_descendant_pid_file" \
    "$cleanup_command" --yes --force >"$cleanup_fixture/orphan-process-tree" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 70 ]] \
    || fail "a successful command with a surviving background process returned $cleanup_status instead of leak status 70"
  grep -qF 'brew autoremove was incomplete (exit 70)' \
    "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "the process-leak status was not preserved in Homebrew pending state"
  grep -qF 'package-manager maintenance is incomplete' \
    "$cleanup_fixture/orphan-process-tree" \
    || fail "the process-leak result omitted the consolidated failure footer"
  grep -qF 'after the 1s drain grace' "$cleanup_fixture/orphan-process-tree" \
    || fail "a surviving background process was not governed by the orphan grace"
  grep -qE 'PID [0-9]+: executable (.+/)?sleep$' "$cleanup_fixture/orphan-process-tree" \
    || fail "the orphan failure did not identify the remaining PID and executable"
  assert_not_contains 'sleep 30' "$cleanup_fixture/orphan-process-tree" \
    "the shared runner exposed full process arguments in orphan diagnostics"
  orphan_descendant_pid="$(<"$orphan_descendant_pid_file")"
  orphan_descendant_state="$(ps -o stat= -p "$orphan_descendant_pid" 2>/dev/null | tr -d '[:space:]' || true)"
  [[ -z "$orphan_descendant_state" || "$orphan_descendant_state" == Z* ]] \
    || fail "a background maintenance process survived after its leader exited"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null

  # A failed leader remains authoritative even when the same invocation leaves
  # a descendant. Cleanup succeeds, the original status is reported, and the
  # helper does not recast the failure as either a timeout or a process leak.
  rm -f "$orphan_descendant_pid_file"
  set +e
  env "${cleanup_env[@]}" GROUNDWORK_MAINTENANCE_POLL_SECONDS=0.1 \
    GROUNDWORK_MAINTENANCE_DEADLINE_SECONDS=8 \
    GROUNDWORK_MAINTENANCE_ORPHAN_GRACE_SECONDS=1 \
    BREW_EXIT_WITH_DESCENDANT=1 BREW_DESCENDANT_LEADER_STATUS=7 \
    BREW_DESCENDANT_PID_FILE="$orphan_descendant_pid_file" \
    "$cleanup_command" --yes --force >"$cleanup_fixture/failed-orphan-process-tree" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 7 ]] \
    || fail "a failed command with a surviving background process lost status 7 as $cleanup_status"
  grep -qF 'preserving original child status 7' \
    "$cleanup_fixture/failed-orphan-process-tree" \
    || fail "the shared runner did not report the failed leader status it preserved"
  assert_not_contains 'hard deadline|returning 70' \
    "$cleanup_fixture/failed-orphan-process-tree" \
    "a failed leader with a leaked descendant was misclassified"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null

  # A short-lived subprocess that drains naturally after its leader exits is not
  # an orphan and must not synthesize a Homebrew failure. A nonzero leader keeps
  # its own status after the same natural drain.
  rm -rf "$cleanup_home/.local/state/groundwork/update-all-pending"
  env "${cleanup_env[@]}" GROUNDWORK_MAINTENANCE_POLL_SECONDS=0.1 \
    GROUNDWORK_MAINTENANCE_DEADLINE_SECONDS=8 \
    GROUNDWORK_MAINTENANCE_ORPHAN_GRACE_SECONDS=3 \
    BREW_EXIT_WITH_SHORT_DESCENDANT=1 BREW_SHORT_DESCENDANT_DELAY=1 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/short-descendant" 2>&1 \
    || fail "a naturally draining Homebrew subprocess created a false maintenance failure"
  assert_not_contains 'left a background process|exceeded its .* hard deadline' \
    "$cleanup_fixture/short-descendant" \
    "a naturally draining Homebrew subprocess was reported as an orphan"
  test ! -e "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "a naturally draining Homebrew subprocess left false pending state"

  set +e
  env "${cleanup_env[@]}" GROUNDWORK_MAINTENANCE_POLL_SECONDS=0.1 \
    GROUNDWORK_MAINTENANCE_DEADLINE_SECONDS=8 \
    GROUNDWORK_MAINTENANCE_ORPHAN_GRACE_SECONDS=3 \
    BREW_EXIT_WITH_SHORT_DESCENDANT=1 BREW_SHORT_DESCENDANT_DELAY=1 \
    BREW_DESCENDANT_LEADER_STATUS=7 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/nonzero-short-descendant" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -ne 0 ]] \
    || fail "a nonzero Homebrew leader became successful after its child drained"
  grep -qF 'brew autoremove was incomplete (exit 7)' \
    "$cleanup_fixture/nonzero-short-descendant" \
    || fail "the bounded runner did not preserve the nonzero leader status"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null

  # The bounded runner is a shared library: it restores the caller's exact trap,
  # including an ignored signal used to protect a cleanup transaction. A
  # hardcoded generic exit trap would let a second signal interrupt cleanup.
  RUNNER_LIB="$PWD/home/dot_local/share/groundwork/lib/maintenance-runner.sh" \
    /bin/bash -c '
    set -euo pipefail
    deadline=5 observe_deadline=5 heartbeat=1 cancel_grace=1 poll_seconds=0.1 orphan_grace=1
    source "$RUNNER_LIB"
    trap "" TERM
    before="$(trap -p TERM)"
    run_bounded_internal "trap restoration probe" 5 "" /usr/bin/true
    after="$(trap -p TERM)"
    [[ "$before" == "$after" ]]
    set -m
    run_bounded_internal "monitor-on restoration probe" 5 "" /usr/bin/true
    [[ "$-" == *m* ]]
    set +m
    run_bounded_internal "monitor-off restoration probe" 5 "" /usr/bin/true
    [[ "$-" != *m* ]]
  ' || fail "the shared bounded runner did not restore the caller's exact TERM trap and monitor state"

  check "groundwork-cleanup: post-mutation and terminal-status policy matrices"
  install_fixture_policy_runner \
    "$cleanup_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_policy_clock "$cleanup_bin/date"

  # A direct cleanup interrupted only during post-mutation measurement keeps an
  # honest manager record: the command ended, but its final receipt did not.
  cp "$cleanup_home/.config/groundwork/repos.conf" "$cleanup_fixture/repos.post-measure.saved"
  cat >"$cleanup_home/.config/groundwork/repos.conf" <<EOF
root = $cleanup_code/no-pin
max_depth = 1
include_worktrees = true
cache_ttl_seconds = 30
trusted_pnpm_store_root = $cleanup_fixture/stores
EOF
  du_call_count_file="$cleanup_fixture/post-measure-du.count"
  rm -f "$du_call_count_file" "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew"
  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" DU_CALL_COUNT_FILE="$du_call_count_file" \
    DU_SIGNAL_ON_CALL=2 DU_SIGNAL_STATUS=130 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/post-measure-signal" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 130 ]] \
    || fail "post-mutation measurement signal returned $cleanup_status, expected 130"
  grep -qF 'command completed, but post-maintenance measurement was interrupted' \
    "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "direct cleanup lost post-mutation interruption context"
  grep -qxF 'brew autoremove' "$cleanup_log"
  grep -qxF 'brew cleanup --prune=all' "$cleanup_log"
  mv "$cleanup_fixture/repos.post-measure.saved" "$cleanup_home/.config/groundwork/repos.conf"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null

  # A child reporting interrupt status preserves pending state and propagates the
  # conventional 130 result.
  rm -rf "$cleanup_home/.local/state/groundwork/update-all-pending"
  set +e
  env "${cleanup_env[@]}" BREW_MAINTENANCE_STATUS=130 \
    "$cleanup_command" --yes --force >"$cleanup_fixture/signal-INT" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 130 ]] \
    || fail "an interrupted maintenance child returned $cleanup_status, expected 130"
  grep -qF 'interrupted (exit 130)' \
    "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "an interrupted maintenance child did not preserve Homebrew state"

  check "groundwork-cleanup: real TERM-to-KILL escalation runtime"
  install_fixture_runtime_runner \
    "$cleanup_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_runtime_clock "$cleanup_bin/date"

  # TERM delivered to the helper cancels the active process group, preserves
  # pending state, escalates after a bounded grace when both child and grandchild
  # resist TERM, returns 143, and releases the transaction lock.
  rm -rf "$cleanup_home/.local/state/groundwork/update-all-pending"
  : >"$cleanup_log"
  resistant_parent_pid_file="$cleanup_fixture/resistant-parent.pid"
  resistant_descendant_pid_file="$cleanup_fixture/resistant-descendant.pid"
  env "${cleanup_env[@]}" BREW_RESIST_TERM=1 \
    BREW_PARENT_PID_FILE="$resistant_parent_pid_file" \
    BREW_DESCENDANT_PID_FILE="$resistant_descendant_pid_file" \
    "$cleanup_command" --yes --force \
    >"$cleanup_fixture/signal-TERM" 2>&1 &
  cleanup_signal_pid=$!
  for _ in {1..100}; do
    [[ -s "$resistant_parent_pid_file" && -s "$resistant_descendant_pid_file" ]] && break
    sleep 0.1
  done
  test -s "$resistant_parent_pid_file" \
    || fail "the TERM-resistant maintenance child never started"
  test -s "$resistant_descendant_pid_file" \
    || fail "the TERM-resistant maintenance grandchild never started"
  kill -TERM "$cleanup_signal_pid"
  set +e
  wait "$cleanup_signal_pid"
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 143 ]] \
    || fail "TERM returned $cleanup_status, expected 143"
  grep -qF 'interrupted (exit 143)' \
    "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "TERM did not preserve interrupted Homebrew state"
  test ! -d "$cleanup_home/.local/state/groundwork/update-all.lock" \
    || fail "TERM left the machine-maintenance lock behind"
  for resistant_pid_file in "$resistant_parent_pid_file" "$resistant_descendant_pid_file"; do
    resistant_pid="$(<"$resistant_pid_file")"
    resistant_state="$(ps -o stat= -p "$resistant_pid" 2>/dev/null | tr -d '[:space:]' || true)"
    [[ -z "$resistant_state" || "$resistant_state" == Z* ]] \
      || fail "a TERM-resistant maintenance process survived cancellation"
  done

  # If even KILL cannot be confirmed (simulated by a fixture-only Bash function),
  # the helper returns its internal terminal status 125 and aborts before another
  # manager can mutate. The validator then cleans up the deliberately surviving
  # fixture group itself.
  kill_failure_env="$cleanup_fixture/kill-failure.bashenv"
  cat >"$kill_failure_env" <<'SH'
kill() {
  if [[ "${1:-}" == "-KILL" ]]; then
    return 0
  fi
  builtin kill "$@"
}
SH
  kill_failure_parent="$cleanup_fixture/kill-failure-parent.pid"
  kill_failure_descendant="$cleanup_fixture/kill-failure-descendant.pid"
  rm -f "$kill_failure_parent" "$kill_failure_descendant"
  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" BASH_ENV="$kill_failure_env" \
    GROUNDWORK_MAINTENANCE_DEADLINE_SECONDS=1 \
    GROUNDWORK_MAINTENANCE_CANCEL_GRACE_SECONDS=1 \
    BREW_RESIST_TERM=1 BREW_PARENT_PID_FILE="$kill_failure_parent" \
    BREW_DESCENDANT_PID_FILE="$kill_failure_descendant" \
    "$cleanup_command" --yes --force >"$cleanup_fixture/kill-unconfirmed" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 125 ]] \
    || fail "an unconfirmed KILL returned $cleanup_status instead of 125"
  grep -qF 'process tree could not be fully stopped' "$cleanup_fixture/kill-unconfirmed" \
    || fail "an unconfirmed KILL did not report the surviving process tree"
  assert_not_contains 'npm cache verify|pnpm store prune' "$cleanup_log" \
    "maintenance continued after a process tree could not be stopped"
  grep -qF 'could not stop its complete process tree' \
    "$cleanup_home/.local/state/groundwork/update-all-pending/homebrew" \
    || fail "an unconfirmed KILL did not preserve Homebrew pending state"
  kill_failure_pgid="$(<"$kill_failure_parent")"
  kill -KILL -- "-$kill_failure_pgid" 2>/dev/null || true
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null

  # If the leader has already failed when closure becomes unconfirmable, status
  # 125 remains the terminal runner result while the original status stays in
  # bounded diagnostic evidence. Reap before returning, then clean the known
  # descendant by PID so the fixture itself does not perform a post-reap killpg.
  failed_kill_descendant="$cleanup_fixture/failed-kill-descendant.pid"
  rm -f "$failed_kill_descendant"
  : >"$cleanup_log"
  set +e
  env "${cleanup_env[@]}" BASH_ENV="$kill_failure_env" \
    GROUNDWORK_MAINTENANCE_DEADLINE_SECONDS=8 \
    GROUNDWORK_MAINTENANCE_CANCEL_GRACE_SECONDS=1 \
    GROUNDWORK_MAINTENANCE_ORPHAN_GRACE_SECONDS=1 \
    BREW_EXIT_WITH_DESCENDANT=1 BREW_DESCENDANT_LEADER_STATUS=7 \
    BREW_DESCENDANT_PID_FILE="$failed_kill_descendant" \
    "$cleanup_command" --yes --force >"$cleanup_fixture/failed-kill-unconfirmed" 2>&1
  cleanup_status=$?
  set -e
  [[ "$cleanup_status" -eq 125 ]] \
    || fail "an unconfirmed failed-leader cleanup returned $cleanup_status instead of 125"
  grep -qF 'original child status: 7' "$cleanup_fixture/failed-kill-unconfirmed" \
    || fail "unconfirmed maintenance cleanup lost original child status 7"
  failed_kill_pid="$(<"$failed_kill_descendant")"
  kill -KILL "$failed_kill_pid" 2>/dev/null || true
  for _ in {1..20}; do
    failed_kill_state="$(ps -o stat= -p "$failed_kill_pid" 2>/dev/null | tr -d '[:space:]' || true)"
    [[ -z "$failed_kill_state" || "$failed_kill_state" == Z* ]] && break
    sleep 0.05
  done
  [[ -z "$failed_kill_state" || "$failed_kill_state" == Z* ]] \
    || fail "the validator could not clean up the failed unconfirmed descendant"
  env "${cleanup_env[@]}" "$cleanup_command" --yes --force >/dev/null
  mv "$cleanup_fixture/repos.runtime.saved" \
    "$cleanup_home/.config/groundwork/repos.conf"

  check "groundwork-pnpm-store-tidy: hostile arguments, dry-run default, receipt"
  pnpm_tidy="$PWD/home/dot_local/bin/executable_groundwork-pnpm-store-tidy"
  test -x "$pnpm_tidy"
  pnpm_fixture="$out_dir/pnpm-tidy-fixture"
  pnpm_bin="$pnpm_fixture/bin"
  pnpm_store_root="$pnpm_fixture/pnpm store"
  mkdir -p "$pnpm_bin" "$pnpm_store_root/v10/files" "$pnpm_store_root/v11/files"
  # Selection provenance is judged from the working directory, so every case
  # runs from a fixture directory whose ancestry this test controls; out_dir
  # lives under the system temp tree, which carries no package.json above it.
  mkdir -p "$pnpm_fixture/proj-none" "$pnpm_fixture/proj-pinned/child" \
    "$pnpm_fixture/proj-yarn" "$pnpm_fixture/proj-badjson" "$pnpm_fixture/proj-malformed" \
    "$pnpm_fixture/proj-vmajor" "$pnpm_fixture/proj-integrity" "$pnpm_fixture/proj-mismatch"
  printf '{"packageManager":"pnpm@11.4.0"}\n' >"$pnpm_fixture/proj-pinned/package.json"
  printf '{"packageManager":"yarn@4.1.0"}\n' >"$pnpm_fixture/proj-yarn/package.json"
  printf '{ not json\n' >"$pnpm_fixture/proj-badjson/package.json"
  printf '{"packageManager":"pnpm"}\n' >"$pnpm_fixture/proj-malformed/package.json"
  printf '{"packageManager":"pnpm@11"}\n' >"$pnpm_fixture/proj-vmajor/package.json"
  printf '{"packageManager":"pnpm@11.4.0+sha512.abc123"}\n' >"$pnpm_fixture/proj-integrity/package.json"
  printf '{"packageManager":"pnpm@10.0.0"}\n' >"$pnpm_fixture/proj-mismatch/package.json"
  run_tidy() {
    local dir="$1"
    shift
    (cd "$dir" && "$@")
  }
  # Spaces in the store path on purpose; sizes seeded with random bytes for the
  # same block-accounting reasons as the Homebrew cache fixtures.
  dd if=/dev/urandom of="$pnpm_store_root/v11/files/pkg.blob" bs=1024 count=2048 >/dev/null 2>&1
  dd if=/dev/urandom of="$pnpm_store_root/v10/files/pkg.blob" bs=1024 count=1024 >/dev/null 2>&1
  cat >"$pnpm_bin/pnpm" <<SH
#!/usr/bin/env bash
if [[ "\${1:-}" == "--version" ]]; then
  # Models a pnpm that changes between the report and the prune.
  if [[ -n "\${PNPM_VERSION_CALLS_FILE:-}" ]]; then
    vcalls=0
    [[ ! -f "\$PNPM_VERSION_CALLS_FILE" ]] || vcalls="\$(<"\$PNPM_VERSION_CALLS_FILE")"
    vcalls=\$((vcalls + 1))
    printf '%s\n' "\$vcalls" >"\$PNPM_VERSION_CALLS_FILE"
    if [[ "\$vcalls" -ge 2 ]]; then
      echo "12.0.0"
      exit 0
    fi
  fi
  echo "11.4.0"
  exit 0
fi
if [[ "\${1:-}" == "store" && "\${2:-}" == "path" ]]; then
  # The probe records whether the caller disabled Corepack networking: a
  # read-only query must never let Corepack download a package manager.
  [[ -z "\${PNPM_ENV_PROBE:-}" ]] \\
    || printf 'corepack_net=%s\n' "\${COREPACK_ENABLE_NETWORK:-unset}" >"\$PNPM_ENV_PROBE"
  [[ "\${PNPM_STORE_PATH_FAIL:-0}" == "0" ]] || exit 1
  if [[ -n "\${PNPM_STORE_PATH_OVERRIDE:-}" ]]; then
    printf '%s\n' "\$PNPM_STORE_PATH_OVERRIDE"
    exit 0
  fi
  # Models a selection that MOVES between the report and the prune: the
  # second query answers with a different generation.
  if [[ -n "\${PNPM_PATH_CALLS_FILE:-}" ]]; then
    calls=0
    [[ ! -f "\$PNPM_PATH_CALLS_FILE" ]] || calls="\$(<"\$PNPM_PATH_CALLS_FILE")"
    calls=\$((calls + 1))
    printf '%s\n' "\$calls" >"\$PNPM_PATH_CALLS_FILE"
    if [[ "\$calls" -ge 2 ]]; then
      printf '%s\n' "$pnpm_store_root/v10"
      exit 0
    fi
  fi
  printf '%s\n' "$pnpm_store_root/v11"
  exit 0
fi
printf 'pnpm %s\n' "\$*" >>"\$GROUNDWORK_TEST_LOG"
if [[ "\${1:-}" == "store" && "\${2:-}" == "prune" ]]; then
  [[ "\${PNPM_PRUNE_STATUS:-0}" == "0" ]] || exit "\$PNPM_PRUNE_STATUS"
  # A prune shrinks the SELECTED store; the other generation must be untouched.
  rm -f "$pnpm_store_root/v11/files/pkg.blob"
fi
exit 0
SH
  chmod +x "$pnpm_bin/pnpm"
  pnpm_log="$pnpm_fixture/commands.log"
  pnpm_path="$pnpm_bin:/usr/bin:/bin"

  # --help mutates nothing and exits 0; hostile arguments exit 64 with zero
  # external invocations. Zero mutation is proven by the empty command log.
  : >"$pnpm_log"
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" "$pnpm_tidy" --help \
    >"$pnpm_fixture/help-output" 2>&1 \
    || fail "groundwork-pnpm-store-tidy --help must exit 0"
  grep -qF -- '--yes' "$pnpm_fixture/help-output"
  test ! -s "$pnpm_log" || fail "--help invoked external commands"
  for hostile in --nope --yes-please extra "two words"; do
    : >"$pnpm_log"
    set +e
    PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" "$pnpm_tidy" "$hostile" \
      >"$pnpm_fixture/hostile-output" 2>&1
    pnpm_status=$?
    set -e
    [[ "$pnpm_status" -eq 64 ]] \
      || fail "groundwork-pnpm-store-tidy '$hostile' must exit 64, got $pnpm_status"
    test ! -s "$pnpm_log" || fail "hostile argument '$hostile' invoked external commands"
  done
  : >"$pnpm_log"
  set +e
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" "$pnpm_tidy" --dry-run --yes \
    >/dev/null 2>&1
  pnpm_status=$?
  set -e
  [[ "$pnpm_status" -eq 64 ]] || fail "conflicting modes must exit 64"
  test ! -s "$pnpm_log" || fail "conflicting modes invoked external commands"

  # Dry run is the default and prunes nothing: the selection context (working
  # directory, selected store) is printed, both generations are sized, the
  # selected one marked, the other explicitly protected — and the store-path
  # query runs with Corepack networking OFF, because a run that promises
  # "nothing was changed" must not download a package manager.
  : >"$pnpm_log"
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" \
    PNPM_ENV_PROBE="$pnpm_fixture/env-probe" \
    run_tidy "$pnpm_fixture/proj-none" "$pnpm_tidy" \
    >"$pnpm_fixture/dry-output" 2>&1 \
    || fail "the dry run must succeed"
  grep -qF 'dry run — nothing was changed' "$pnpm_fixture/dry-output"
  grep -qF 'Working directory:' "$pnpm_fixture/dry-output" \
    || fail "the dry run must print the directory the selection followed"
  grep -qF 'Selected store:' "$pnpm_fixture/dry-output" \
    || fail "the dry run must print which store the directory selects"
  grep -qF 'Selected pnpm:     11.4.0' "$pnpm_fixture/dry-output" \
    || fail "the dry run must print the selected pnpm version"
  # No pin anywhere: the provenance must say so plainly, never invent a
  # packageManager that does not exist.
  grep -qF 'Selection source:  no pnpm packageManager declaration' "$pnpm_fixture/dry-output" \
    || fail "an unpinned run must name its state instead of claiming a packageManager selected the store"
  grep -qE 'selected.*v11: [0-9.]+ MiB' "$pnpm_fixture/dry-output" \
    || fail "the dry run must size the selected store"
  grep -qE 'other.*v10: [0-9.]+ MiB' "$pnpm_fixture/dry-output" \
    || fail "the dry run must size the other store generation"
  grep -qF 'packageManager' "$pnpm_fixture/dry-output" \
    || fail "the dry run must explain why other generations are protected"
  grep -qxF 'corepack_net=0' "$pnpm_fixture/env-probe" \
    || fail "the dry run's store-path query must disable Corepack networking"
  test ! -s "$pnpm_log" || fail "the dry run invoked a mutating pnpm command"
  test -f "$pnpm_store_root/v11/files/pkg.blob" || fail "the dry run pruned the store"

  # Aliases deduplicate by canonical path; symlinks are never skipped as such:
  # two names for one store report once, while a symlink to a DISTINCT store is
  # a real generation and is reported.
  ln -s "$pnpm_store_root/v11" "$pnpm_store_root/v-alias"
  mkdir -p "$pnpm_fixture/external-store"
  dd if=/dev/urandom of="$pnpm_fixture/external-store/pkg.blob" bs=1024 count=256 >/dev/null 2>&1
  ln -s "$pnpm_fixture/external-store" "$pnpm_store_root/v9"
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" \
    run_tidy "$pnpm_fixture/proj-none" "$pnpm_tidy" \
    >"$pnpm_fixture/alias-output" 2>&1 \
    || fail "the dry run must succeed with symlinked store entries present"
  assert_not_contains 'v-alias' "$pnpm_fixture/alias-output" \
    "a symlinked alias of an already-reported store was reported again"
  grep -qE 'other.*v9: [0-9.]+ KiB' "$pnpm_fixture/alias-output" \
    || fail "a symlink to a distinct store is a real generation and must be reported"
  rm -f "$pnpm_store_root/v-alias" "$pnpm_store_root/v9"

  # Selection provenance, judged from the working directory: a pin in the
  # directory, a pin in an ancestor, a non-pnpm declaration, a malformed pnpm
  # declaration, and unreadable JSON each name their state truthfully.
  # The walk reports cd-normalized paths (macOS TMPDIR carries a double slash
  # that cd collapses), so expectations use the normalized fixture prefix.
  pnpm_fixture_pwd="$(cd "$pnpm_fixture" && pwd)"
  for provenance_case in \
    'proj-pinned:Selection source:  '"$pnpm_fixture_pwd"'/proj-pinned/package.json → pnpm@11.4.0' \
    'proj-pinned/child:Selection source:  '"$pnpm_fixture_pwd"'/proj-pinned/package.json → pnpm@11.4.0' \
    'proj-yarn:declares yarn@4.1.0 (not pnpm)' \
    'proj-malformed:malformed pnpm declaration' \
    'proj-vmajor:malformed pnpm version' \
    'proj-badjson:unreadable as JSON'; do
    provenance_dir="${provenance_case%%:*}"
    provenance_expected="${provenance_case#*:}"
    PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" \
      run_tidy "$pnpm_fixture/$provenance_dir" "$pnpm_tidy" \
      >"$pnpm_fixture/provenance-output" 2>&1 \
      || fail "the dry run must succeed from $provenance_dir"
    grep -qF "$provenance_expected" "$pnpm_fixture/provenance-output" \
      || fail "provenance from $provenance_dir must report: $provenance_expected"
  done
  # These provenance fixtures exercise the tidy's own manifest walk and parser
  # — they do not claim to prove Corepack's internal selection behavior, which
  # the pin-vs-resolved comparison below turns into checked evidence.

  # A valid pin that matches the resolved pnpm passes cleanly — the integrity
  # suffix is stripped before comparison, never treated as a mismatch.
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" \
    run_tidy "$pnpm_fixture/proj-integrity" "$pnpm_tidy" \
    >"$pnpm_fixture/integrity-output" 2>&1 \
    || fail "a matching pin with an integrity suffix must pass"
  grep -qF 'pnpm@11.4.0+sha512.abc123 (nearest observed declaration)' "$pnpm_fixture/integrity-output" \
    || fail "the integrity-suffixed pin must be reported as the observed declaration"
  assert_not_contains 'WARNING' "$pnpm_fixture/integrity-output" \
    "a matching pin was reported as launcher drift"

  # A valid pin that DISAGREES with the resolved pnpm is launcher drift: the
  # dry run warns, and --yes refuses before any query is even close to a prune.
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" \
    run_tidy "$pnpm_fixture/proj-mismatch" "$pnpm_tidy" \
    >"$pnpm_fixture/mismatch-dry-output" 2>&1 \
    || fail "the dry run must succeed under launcher drift (it warns, not fails)"
  grep -qF 'WARNING: the declared pin (pnpm@10.0.0) does not match the pnpm that resolved (11.4.0)' \
    "$pnpm_fixture/mismatch-dry-output" \
    || fail "the dry run must name the pin/resolved mismatch"
  : >"$pnpm_log"
  set +e
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" \
    run_tidy "$pnpm_fixture/proj-mismatch" "$pnpm_tidy" --yes \
    >"$pnpm_fixture/mismatch-yes-output" 2>&1
  pnpm_status=$?
  set -e
  [[ "$pnpm_status" -ne 0 ]] \
    || fail "--yes must refuse when the pin and the resolved pnpm disagree"
  grep -qF 'refusing to prune under a drifted launcher' "$pnpm_fixture/mismatch-yes-output" \
    || fail "the drift refusal must explain itself"
  test ! -s "$pnpm_log" \
    || fail "a drift refusal must precede any mutating pnpm command"

  # Without jq anywhere on PATH, provenance degrades to honestly not-determined
  # — never a guessed declaration. The shim carries every external tool the dry
  # run needs except jq.
  pnpm_nojq_bin="$pnpm_fixture/nojq-bin"
  mkdir -p "$pnpm_nojq_bin"
  # bash is included because the stubs' /usr/bin/env shebangs resolve it via
  # PATH; jq is the one tool deliberately absent.
  for nojq_tool in bash cat du awk dirname basename; do
    ln -s "$(command -v "$nojq_tool")" "$pnpm_nojq_bin/$nojq_tool"
  done
  PATH="$pnpm_bin:$pnpm_nojq_bin" GROUNDWORK_TEST_LOG="$pnpm_log" \
    run_tidy "$pnpm_fixture/proj-pinned" "$pnpm_tidy" \
    >"$pnpm_fixture/nojq-output" 2>&1 \
    || fail "the dry run must succeed without jq"
  grep -qF 'not determined (jq not installed)' "$pnpm_fixture/nojq-output" \
    || fail "provenance without jq must be honestly not-determined, not guessed"

  # A custom store-dir outside the v* layout is still reported directly, with
  # its real size — never as "not created yet" — and with no invented siblings.
  mkdir -p "$pnpm_fixture/solo/custom store"
  dd if=/dev/urandom of="$pnpm_fixture/solo/custom store/pkg.blob" bs=1024 count=512 >/dev/null 2>&1
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" \
    PNPM_STORE_PATH_OVERRIDE="$pnpm_fixture/solo/custom store" \
    run_tidy "$pnpm_fixture/proj-none" "$pnpm_tidy" \
    >"$pnpm_fixture/custom-output" 2>&1 \
    || fail "the dry run must succeed with a custom store-dir"
  grep -qE 'selected.*custom store: [0-9.]+ KiB \(selected here\)' "$pnpm_fixture/custom-output" \
    || fail "a custom store-dir must be sized directly, not forced through the v* layout"
  assert_not_contains 'not created yet' "$pnpm_fixture/custom-output" \
    "an existing custom store was reported as not created yet"
  grep -qF 'sibling generation discovery not attempted (custom store layout' "$pnpm_fixture/custom-output" \
    || fail "a custom store layout must say sibling discovery was not attempted"
  assert_not_contains 'other.*v1[01]' "$pnpm_fixture/custom-output" \
    "v* siblings of an unrecognized parent were misclassified as store generations"

  # A pnpm that changes between the report and the prune is refused even when
  # the store path stays the same.
  : >"$pnpm_log"
  rm -f "$pnpm_fixture/version-calls"
  set +e
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" \
    PNPM_VERSION_CALLS_FILE="$pnpm_fixture/version-calls" \
    run_tidy "$pnpm_fixture/proj-none" "$pnpm_tidy" --yes \
    >"$pnpm_fixture/version-moved-output" 2>&1
  pnpm_status=$?
  set -e
  [[ "$pnpm_status" -ne 0 ]] \
    || fail "a pnpm that changed before the prune must be refused"
  grep -qF 'selected pnpm changed between the report and the prune' \
    "$pnpm_fixture/version-moved-output" \
    || fail "the version-moved refusal must say what happened"
  test ! -s "$pnpm_log" \
    || fail "a version-moved refusal must precede any prune: $(cat "$pnpm_log")"
  rm -f "$pnpm_fixture/version-calls"

  # When the selected pnpm is not cached, the dry run refuses to download one
  # and says so, rather than silently mutating Corepack state.
  : >"$pnpm_log"
  set +e
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" PNPM_STORE_PATH_FAIL=1 \
    run_tidy "$pnpm_fixture/proj-none" "$pnpm_tidy" \
    >"$pnpm_fixture/offline-output" 2>&1
  pnpm_status=$?
  set -e
  [[ "$pnpm_status" -ne 0 ]] || fail "an offline-unavailable pnpm must fail the dry run"
  grep -qF 'available offline' "$pnpm_fixture/offline-output" \
    || fail "the offline refusal must explain that the selected pnpm is unavailable offline"
  test ! -s "$pnpm_log" || fail "the offline refusal invoked a mutating pnpm command"

  # A selection that MOVES between the report and the prune is refused: the
  # user authorized the store they saw, not whatever pnpm resolves later.
  : >"$pnpm_log"
  rm -f "$pnpm_fixture/path-calls"
  set +e
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" \
    PNPM_PATH_CALLS_FILE="$pnpm_fixture/path-calls" \
    run_tidy "$pnpm_fixture/proj-none" "$pnpm_tidy" --yes \
    >"$pnpm_fixture/moved-output" 2>&1
  pnpm_status=$?
  set -e
  [[ "$pnpm_status" -ne 0 ]] \
    || fail "a store selection that moved before the prune must be refused"
  grep -qF 'selection changed between the report and the prune' "$pnpm_fixture/moved-output" \
    || fail "the moved-selection refusal must say what happened"
  test ! -s "$pnpm_log" \
    || fail "a moved selection must refuse BEFORE any prune: $(cat "$pnpm_log")"
  rm -f "$pnpm_fixture/path-calls"

  # --yes prunes the selected store only, with a measured receipt; the other
  # generation survives byte-for-byte.
  : >"$pnpm_log"
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" \
    run_tidy "$pnpm_fixture/proj-none" "$pnpm_tidy" --yes \
    >"$pnpm_fixture/yes-output" 2>&1 \
    || fail "--yes must succeed"
  diff -u <(printf 'pnpm store prune\n') "$pnpm_log"
  grep -qF 'Working directory:' "$pnpm_fixture/yes-output" \
    || fail "--yes must print the selection context before acting"
  grep -qE '^  Store before:    [0-9.]+ MiB$' "$pnpm_fixture/yes-output" \
    || fail "--yes must report the measured store size before the prune"
  grep -qE '^  Store reclaimed: [0-9.]+ MiB$' "$pnpm_fixture/yes-output" \
    || fail "--yes must report the measured reclaim"
  test -f "$pnpm_store_root/v10/files/pkg.blob" \
    || fail "the prune touched another store generation"

  # A failed prune reports honestly and propagates the status.
  : >"$pnpm_log"
  set +e
  PATH="$pnpm_path" GROUNDWORK_TEST_LOG="$pnpm_log" PNPM_PRUNE_STATUS=7 \
    run_tidy "$pnpm_fixture/proj-none" "$pnpm_tidy" --yes \
    >"$pnpm_fixture/fail-output" 2>&1
  pnpm_status=$?
  set -e
  [[ "$pnpm_status" -eq 7 ]] || fail "a failed prune must propagate its status, got $pnpm_status"
  grep -qF 'was not fully pruned' "$pnpm_fixture/fail-output" \
    || fail "a failed prune must say the store was not fully pruned"

  # No pnpm at all: nothing to tidy, exit 0, zero invocations.
  : >"$pnpm_log"
  PATH="/usr/bin:/bin" GROUNDWORK_TEST_LOG="$pnpm_log" "$pnpm_tidy" \
    >"$pnpm_fixture/no-pnpm-output" 2>&1 \
    || fail "a machine without pnpm must exit 0"
  grep -qF 'nothing to tidy' "$pnpm_fixture/no-pnpm-output"
  test ! -s "$pnpm_log"

  check "groundwork-doctor --storage stays read-only, opt-in, and honest"
  storage_fixture="$out_dir/doctor-storage-fixture"
  storage_home="$storage_fixture/home"
  storage_bin="$storage_fixture/bin"
  mkdir -p "$storage_bin" "$storage_home/.nvm/versions" "$storage_home/.npm/_cacache"
  dd if=/dev/urandom of="$storage_home/.nvm/versions/node.blob" bs=1024 count=512 >/dev/null 2>&1
  storage_brew_cache="$storage_fixture/brew cache"
  mkdir -p "$storage_brew_cache/downloads"
  dd if=/dev/urandom of="$storage_brew_cache/downloads/big.blob" bs=1024 count=1024 >/dev/null 2>&1
  storage_pnpm_root="$storage_fixture/pnpm-store"
  mkdir -p "$storage_pnpm_root/v10" "$storage_pnpm_root/v11"
  dd if=/dev/urandom of="$storage_pnpm_root/v11/pkg.blob" bs=1024 count=1024 >/dev/null 2>&1
  # An alias of the selected store: canonical dedup must report it exactly once.
  ln -s "$storage_pnpm_root/v11" "$storage_pnpm_root/v-alias"
  dd if=/dev/urandom of="$storage_home/.npm/_cacache/data.blob" bs=1024 count=1024 >/dev/null 2>&1
  cat >"$storage_bin/brew" <<SH
#!/usr/bin/env bash
if [[ "\${1:-}" == "--cache" ]]; then
  printf '%s\n' "$storage_brew_cache"
  exit 0
fi
printf 'brew %s\n' "\$*" >>"\$GROUNDWORK_TEST_LOG"
SH
  cat >"$storage_bin/pnpm" <<SH
#!/usr/bin/env bash
if [[ "\${1:-}" == "store" && "\${2:-}" == "path" ]]; then
  [[ -z "\${PNPM_ENV_PROBE:-}" ]] \\
    || printf 'corepack_net=%s\n' "\${COREPACK_ENABLE_NETWORK:-unset}" >"\$PNPM_ENV_PROBE"
  [[ "\${PNPM_STORE_PATH_FAIL:-0}" == "0" ]] || exit 1
  printf '%s\n' "$storage_pnpm_root/v11"
  exit 0
fi
printf 'pnpm %s\n' "\$*" >>"\$GROUNDWORK_TEST_LOG"
SH
  cat >"$storage_bin/npm" <<SH
#!/usr/bin/env bash
if [[ "\${1:-}" == "config" && "\${2:-}" == "get" && "\${3:-}" == "cache" ]]; then
  [[ "\${NPM_CONFIG_FAIL:-0}" == "0" ]] || exit 1
  if [[ "\${NPM_CACHE_MISSING:-0}" != "0" ]]; then
    printf '%s\n' "$storage_home/uncreated-npm-cache"
    exit 0
  fi
  printf '%s\n' "$storage_home/.npm"
  exit 0
fi
printf 'npm %s\n' "\$*" >>"\$GROUNDWORK_TEST_LOG"
SH
  cat >"$storage_bin/mise" <<'SH'
#!/usr/bin/env bash
if [[ "${1:-}" == "which" ]]; then
  exit "${MISE_WHICH_NPM_STATUS:-1}"
fi
if [[ "${1:-}" == "exec" ]]; then
  shift
  [[ "${1:-}" == "--" ]] && shift
  exec "$@"
fi
exit 0
SH
  # du passthrough that can be told to fail for one path — how else would a
  # doctor prove that a broken measurement is not reported as healthy?
  cat >"$storage_bin/du" <<'SH'
#!/usr/bin/env bash
if [[ -n "${DU_FAIL_GLOB:-}" ]]; then
  for arg in "$@"; do
    [[ "$arg" == *"$DU_FAIL_GLOB"* ]] && exit 1
  done
fi
exec /usr/bin/du "$@"
SH
  chmod +x "$storage_bin/brew" "$storage_bin/pnpm" "$storage_bin/npm" \
    "$storage_bin/mise" "$storage_bin/du"
  storage_log="$storage_fixture/commands.log"
  run_storage_doctor() {
    local output="$1"
    shift
    : >"$storage_log"
    env HOME="$storage_home" PATH="$storage_bin:/usr/bin:/bin" \
      GROUNDWORK_TEST_LOG="$storage_log" "$@" \
      /bin/bash home/dot_local/bin/executable_groundwork-doctor --storage \
      >"$output" 2>&1
  }

  run_storage_doctor "$storage_fixture/output" PNPM_ENV_PROBE="$storage_fixture/env-probe" \
    || fail "groundwork-doctor --storage must succeed"
  # Read-only is the contract: every brew/pnpm/npm call other than the size
  # queries would have been logged.
  test ! -s "$storage_log" \
    || fail "doctor --storage invoked a non-query command: $(cat "$storage_log")"
  grep -qF 'read-only report' "$storage_fixture/output"
  grep -qF 'not a full disk scan' "$storage_fixture/output" \
    || fail "the storage report must say it is curated, not exhaustive"
  grep -qxF 'corepack_net=0' "$storage_fixture/env-probe" \
    || fail "the doctor's pnpm query must disable Corepack networking"
  grep -qE 'Homebrew cache: [0-9.]+ MiB' "$storage_fixture/output" \
    || fail "the storage report must size the Homebrew cache"
  grep -qF 'pnpm store v10 (other generation)' "$storage_fixture/output" \
    || fail "other pnpm store generations must not be called inactive — Corepack selects per repository"
  grep -qF 'pnpm store v11 (selected here)' "$storage_fixture/output" \
    || fail "the storage report must mark the store selected by the current directory"
  grep -qE 'working directory .* selects: ' "$storage_fixture/output" \
    || fail "the storage report must say which directory the selection followed"
  grep -qF 'legacy runtime manager: ~/.nvm' "$storage_fixture/output" \
    || fail "a legacy nvm install must be reported"
  grep -qF "Groundwork's intended Node owner: mise" "$storage_fixture/output" \
    || fail "the nvm finding must state intent, not assert the live Node owner"
  grep -qF -- '--node-toolchain' "$storage_fixture/output" \
    || fail "the nvm finding must point at the section that verifies the live owner"
  assert_not_contains 'v-alias' "$storage_fixture/output" \
    "an alias of the selected pnpm store was counted as a second generation"
  # npm resolves exactly as update-all resolves it, and the report names the
  # provider that answered — here mise owns no npm, so the PATH npm answers.
  grep -qE 'npm cache via PATH npm \([^)]*\) \(.*\.npm\): [0-9.]+ MiB' "$storage_fixture/output" \
    || fail "the storage report must size npm's configured cache and name the provider"
  run_storage_doctor "$storage_fixture/mise-npm-output" MISE_WHICH_NPM_STATUS=0 \
    || fail "doctor --storage must succeed with a mise-owned npm"
  grep -qF 'npm cache via mise-managed npm' "$storage_fixture/mise-npm-output" \
    || fail "a mise-owned npm must be reported as the provider update-all uses"
  # A failed cache-path query stays unknown: ~/.npm is mentioned but never
  # relabeled as the configured cache.
  run_storage_doctor "$storage_fixture/npm-fail-output" NPM_CONFIG_FAIL=1 \
    || fail "doctor --storage must survive a failed npm config get cache"
  grep -qF 'npm cache path unavailable' "$storage_fixture/npm-fail-output" \
    || fail "a failed npm cache query must be reported as unavailable"
  grep -qF 'NOT verified as the active cache' "$storage_fixture/npm-fail-output" \
    || fail "an unverified ~/.npm must be labeled unverified, not configured"
  grep -qF 'groundwork-cleanup' "$storage_fixture/output" \
    || fail "the storage report must point at the automatic maintenance report"
  # Absent areas stay silent rather than being invented: no Xcode or Parallels
  # directories exist in this fixture HOME.
  assert_not_contains 'Parallels' "$storage_fixture/output" \
    "the storage report invented a Parallels area that does not exist"
  assert_not_contains 'DeviceSupport' "$storage_fixture/output" \
    "the storage report invented an Xcode area that does not exist"

  # Thresholds are policy with boundaries: forced to 0 GiB, the same data warns.
  run_storage_doctor "$storage_fixture/warn-output" \
    GROUNDWORK_STORAGE_BREW_WARN_GIB=0 GROUNDWORK_STORAGE_PNPM_WARN_GIB=0 \
    GROUNDWORK_STORAGE_NPM_WARN_GIB=0 \
    || fail "doctor --storage must succeed at a zero threshold"
  grep -qE 'warn.*Homebrew cache.*above the 0 GiB threshold' "$storage_fixture/warn-output" \
    || fail "a Homebrew cache above threshold must warn and name the threshold"
  grep -qE 'warn.*pnpm stores total.*above the 0 GiB threshold' "$storage_fixture/warn-output" \
    || fail "a pnpm store total above threshold must warn and name the threshold"
  grep -qE 'warn.*npm cache via.*above the 0 GiB threshold' "$storage_fixture/warn-output" \
    || fail "an npm cache above threshold must warn and name the threshold"

  # A FAILED measurement is never healthy: broken du on the Homebrew cache must
  # not produce ok, and a partial pnpm total must not be judged at all.
  run_storage_doctor "$storage_fixture/du-fail-output" DU_FAIL_GLOB="brew cache" \
    || fail "doctor --storage must survive a failed du"
  grep -qF 'Homebrew cache: size unavailable' "$storage_fixture/du-fail-output" \
    || fail "a failed Homebrew measurement must be reported as unavailable"
  assert_not_contains 'ok    Homebrew cache' "$storage_fixture/du-fail-output" \
    "a failed Homebrew measurement was reported as healthy"
  run_storage_doctor "$storage_fixture/partial-output" DU_FAIL_GLOB="v10" \
    || fail "doctor --storage must survive a partial pnpm measurement"
  grep -qF 'pnpm store total incomplete' "$storage_fixture/partial-output" \
    || fail "a partial pnpm total must be reported incomplete, threshold unevaluated"
  assert_not_contains 'ok    pnpm stores total' "$storage_fixture/partial-output" \
    "a partial pnpm total was reported as complete and healthy"

  # A configured npm cache path that does not exist yet is a valid zero-state,
  # distinct from a failed query.
  run_storage_doctor "$storage_fixture/npm-uncreated-output" NPM_CACHE_MISSING=1 \
    || fail "doctor --storage must survive an uncreated npm cache path"
  grep -qE 'npm cache via PATH npm .*uncreated-npm-cache\): not created yet' \
    "$storage_fixture/npm-uncreated-output" \
    || fail "a configured-but-uncreated npm cache must be reported, not dropped"

  # Discovery does not depend on the launcher: with the selected pnpm
  # unavailable offline, the known store roots are still found and sized.
  mkdir -p "$storage_home/Library/pnpm/store/v7"
  dd if=/dev/urandom of="$storage_home/Library/pnpm/store/v7/pkg.blob" bs=1024 count=512 >/dev/null 2>&1
  run_storage_doctor "$storage_fixture/offline-output" PNPM_STORE_PATH_FAIL=1 \
    || fail "doctor --storage must survive an offline-unavailable pnpm"
  grep -qF 'selected-for-this-directory store: unavailable' "$storage_fixture/offline-output" \
    || fail "an offline-unavailable selection must be named, not silently absent"
  grep -qE 'pnpm store v7 \(other generation\): [0-9.]+ KiB' "$storage_fixture/offline-output" \
    || fail "known store roots must be sized even when pnpm cannot answer"

  # pnpm removed entirely, stores left behind: still found and sized.
  storage_nopnpm_bin="$storage_fixture/nopnpm-bin"
  mkdir -p "$storage_nopnpm_bin"
  for storage_tool in brew npm mise du; do
    ln -s "$storage_bin/$storage_tool" "$storage_nopnpm_bin/$storage_tool"
  done
  : >"$storage_log"
  env HOME="$storage_home" PATH="$storage_nopnpm_bin:/usr/bin:/bin" \
    GROUNDWORK_TEST_LOG="$storage_log" \
    /bin/bash home/dot_local/bin/executable_groundwork-doctor --storage \
    >"$storage_fixture/nopnpm-output" 2>&1 \
    || fail "doctor --storage must succeed with pnpm removed"
  grep -qF 'pnpm not installed; known store roots are still sized' "$storage_fixture/nopnpm-output" \
    || fail "a removed pnpm must not hide the stores it left behind"
  grep -qE 'pnpm store v7 \(other generation\): [0-9.]+ KiB' "$storage_fixture/nopnpm-output" \
    || fail "stores that outlived pnpm must still be sized"

  # Storage never runs in the default doctor: du over VM bundles and simulator
  # trees can take minutes, and the routine health check must stay quick.
  : >"$storage_log"
  env HOME="$storage_home" PATH="$storage_bin:/usr/bin:/bin" \
    GROUNDWORK_TEST_LOG="$storage_log" \
    /bin/bash home/dot_local/bin/executable_groundwork-doctor \
    >"$storage_fixture/default-output" 2>&1 \
    || fail "the default doctor run must succeed"
  assert_not_contains '== Storage ==' "$storage_fixture/default-output" \
    "the default doctor ran the storage section"
  grep -qF -- '--storage for the (slower)' "$storage_fixture/default-output" \
    || fail "the default doctor must point at the opt-in storage report"

  check "shell self-reload preserves background jobs"
  # BEHAVIORAL, not a source grep. The guard used "$(jobs)", which forks — and a
  # forked child has no job table, so the test was ALWAYS true and every reload
  # exec'd straight through running background jobs. Source matching cannot
  # catch that class of bug; only running the real hook with a real job can.
  # The function under test is EXTRACTED FROM THE RENDERED TEMPLATE, so this
  # exercises the shipped implementation rather than a copy of it.
  if ! command -v zsh >/dev/null 2>&1; then
    skip_current_check zsh-missing "zsh is required to run the self-reload hook"
  else
    reload_dir="$out_dir/shell-reload"
    mkdir -p "$reload_dir"
    render darwin false arm64 home/dot_zshrc.tmpl "$reload_dir/rendered-zshrc"
    # The hook plus its module gate; nothing else from the rendered file runs.
    sed -n '/^zmodload -F zsh\/stat b:zstat/,/^fi$/p' "$reload_dir/rendered-zshrc" \
      >"$reload_dir/hook.zsh"
    grep -qF '_groundwork_config_refresh_precmd' "$reload_dir/hook.zsh" \
      || fail "could not extract the self-reload hook from the rendered .zshrc"
    cat >"$reload_dir/drive.zsh" <<'ZSH'
set -e
ZDOTDIR="$1"; export ZDOTDIR
: >"$ZDOTDIR/.zshrc"
source "$2"
sleep 30 &
job_pid=$!
print -r -- "$job_pid" >"$ZDOTDIR/job.pid"
# Make the config look rewritten, exactly as `chezmoi apply` would.
sleep 1
: >"$ZDOTDIR/.zshrc"
# If the guard is broken this exec's and the marker below is never written.
_groundwork_config_refresh_precmd
print -r -- held >"$ZDOTDIR/outcome"
kill "$job_pid" 2>/dev/null || true
ZSH
    reload_home="$reload_dir/home"
    mkdir -p "$reload_home"
    rm -f "$reload_home/outcome" "$reload_home/job.pid"
    zsh -f "$reload_dir/drive.zsh" "$reload_home" "$reload_dir/hook.zsh" \
      </dev/null >"$reload_dir/drive.out" 2>&1 || true
    [[ -f "$reload_home/outcome" ]] \
      || fail "the self-reload hook exec'd while a background job was running, replacing the shell out from under it"
    grep -qxF held "$reload_home/outcome" \
      || fail "the self-reload hook did not hold off while a background job was running"
    # ...and with no jobs it must still actually reload, or the guard is just off.
    cat >"$reload_dir/drive-clean.zsh" <<'ZSH'
set -e
ZDOTDIR="$1"; export ZDOTDIR
: >"$ZDOTDIR/.zshrc"
source "$2"
sleep 1
: >"$ZDOTDIR/.zshrc"
_groundwork_config_refresh_precmd
print -r -- "did-not-reload" >"$ZDOTDIR/outcome"
ZSH
    reload_clean="$reload_dir/clean"
    mkdir -p "$reload_clean"
    SHELL="$(command -v zsh)" zsh -f "$reload_dir/drive-clean.zsh" \
      "$reload_clean" "$reload_dir/hook.zsh" </dev/null >"$reload_dir/clean.out" 2>&1 || true
    if [[ -f "$reload_clean/outcome" ]]; then
      fail "the self-reload hook never reloads, so the job guard is masking a dead feature"
    fi
    grep -qF 'shell config updated' "$reload_dir/clean.out" \
      || fail "the self-reload hook did not announce the reload it performed"
  fi

  check "update-all migration notice"
  migration_home="$out_dir/update-all-migration-home"
  migration_flag="$migration_home/.local/state/groundwork/update-all-migration-pending"
  mkdir -p "$migration_home"
  HOME="$migration_home" /bin/bash home/run_once_after_97-package-maintenance-notice.sh \
    >"$out_dir/package-maintenance-migration-notice"
  grep -qF 'update-all now includes automatic package-manager maintenance' \
    "$out_dir/package-maintenance-migration-notice"
  grep -qF 'Whole pnpm store generations remain' \
    "$out_dir/package-maintenance-migration-notice"
  assert_not_contains 'Docker data remain owner-confirmed' \
    "$out_dir/package-maintenance-migration-notice" \
    "the package-maintenance notice retained the obsolete Docker contract"
  HOME="$migration_home" /bin/bash home/run_once_after_98-docker-scratch-maintenance-notice.sh \
    >"$out_dir/docker-maintenance-migration-notice"
  grep -qF 'update-all now includes automatic Docker scratch maintenance' \
    "$out_dir/docker-maintenance-migration-notice"
  grep -qF 'groundwork-doctor --docker' "$out_dir/docker-maintenance-migration-notice"
  grep -qF 'groundwork-docker-cache-tidy' "$out_dir/docker-maintenance-migration-notice"
  grep -qF -- '--rm-after' "$out_dir/docker-maintenance-migration-notice"
  grep -qF 'scripts/verify-docker-image' "$out_dir/docker-maintenance-migration-notice"
  cat >"$migration_home/.zshrc" <<'EOF'
update-all() {
  echo old
}
EOF
  HOME="$migration_home" /bin/bash home/run_once_before_07-update-all-command-migration.sh \
    >"$out_dir/update-all-migration-notice"
  grep -qF 'moved update-all from an in-memory shell function' "$out_dir/update-all-migration-notice"
  grep -qF "Run \`exec zsh\` once" "$out_dir/update-all-migration-notice"
  test -f "$migration_flag"
  # The end-of-apply reminder repeats the one required action after Homebrew
  # output has scrolled the first notice away, then clears the flag so it
  # never repeats.
  # A noninteractive apply (piped/CI) cannot deliver the reminder to anyone, so
  # it must print nothing and leave the flag pending for the next interactive run.
  HOME="$migration_home" /bin/bash home/run_after_98-update-all-migration-reminder.sh \
    >"$out_dir/update-all-migration-noninteractive"
  test ! -s "$out_dir/update-all-migration-noninteractive" \
    || fail "the migration reminder printed to a non-terminal"
  test -f "$migration_flag" \
    || fail "a noninteractive apply consumed the migration reminder"
  # Interactive: shown, then the flag is cleared so it never repeats.
  HOME="$migration_home" GROUNDWORK_REMINDER_ASSUME_TTY=1 \
    /bin/bash home/run_after_98-update-all-migration-reminder.sh \
    >"$out_dir/update-all-migration-reminder"
  grep -qF 'one step left' "$out_dir/update-all-migration-reminder"
  grep -qF 'exec zsh' "$out_dir/update-all-migration-reminder"
  test ! -e "$migration_flag"
  HOME="$migration_home" GROUNDWORK_REMINDER_ASSUME_TTY=1 \
    /bin/bash home/run_after_98-update-all-migration-reminder.sh \
    >"$out_dir/update-all-migration-reminder-repeat"
  test ! -s "$out_dir/update-all-migration-reminder-repeat"
  # Color keys on the run-wide signal update-all exports, not on a per-stage
  # TTY probe: with GROUNDWORK_COLOR=1 the reminder emits ANSI even though
  # stdout is a file here; with it 0 (or NO_COLOR and no signal) it stays plain.
  reminder_esc="$(printf '\033')"
  : >"$migration_flag"
  HOME="$migration_home" GROUNDWORK_REMINDER_ASSUME_TTY=1 GROUNDWORK_COLOR=1 \
    /bin/bash home/run_after_98-update-all-migration-reminder.sh \
    >"$out_dir/update-all-migration-color-on"
  grep -qF "${reminder_esc}[1;33m" "$out_dir/update-all-migration-color-on" \
    || fail "the migration reminder must emit color when GROUNDWORK_COLOR=1, even behind a capture"
  : >"$migration_flag"
  HOME="$migration_home" GROUNDWORK_REMINDER_ASSUME_TTY=1 GROUNDWORK_COLOR=0 \
    /bin/bash home/run_after_98-update-all-migration-reminder.sh \
    >"$out_dir/update-all-migration-color-off"
  grep -qF 'one step left' "$out_dir/update-all-migration-color-off"
  assert_not_contains "$reminder_esc" "$out_dir/update-all-migration-color-off" \
    "the migration reminder emitted color although GROUNDWORK_COLOR=0"
  : >"$migration_flag"
  HOME="$migration_home" GROUNDWORK_REMINDER_ASSUME_TTY=1 NO_COLOR=1 GROUNDWORK_COLOR='' \
    /bin/bash home/run_after_98-update-all-migration-reminder.sh \
    >"$out_dir/update-all-migration-no-color"
  assert_not_contains "$reminder_esc" "$out_dir/update-all-migration-no-color" \
    "the migration reminder emitted color although NO_COLOR was set and no signal decided otherwise"
  printf '# fresh install has no old function\n' >"$migration_home/.zshrc"
  HOME="$migration_home" /bin/bash home/run_once_before_07-update-all-command-migration.sh \
    >"$out_dir/update-all-fresh-notice"
  test ! -s "$out_dir/update-all-fresh-notice"
  test ! -e "$migration_flag"

}

validate_static_configuration() {
  check "Herdr/tmux selection and ownership"
  test -x scripts/test-terminal-multiplexer
  scripts/test-terminal-multiplexer

  check "Yazi ownership and hidden-filesystem visibility"
  test -x scripts/test-developer-tool-visibility
  test -x scripts/run-yazi-manual-acceptance
  scripts/test-developer-tool-visibility

  check "platform support contract"
  # groundwork-platform reports exactly darwin/linux/wsl2/wsl1/wsl-unknown/
  # unsupported. Default WSL2 kernels carry microsoft-standard (older ones
  # without any WSL2 suffix); WSL1 kernels say Microsoft without either; a WSL
  # environment variable with an unrecognizable kernel is ambiguous and must
  # come back wsl-unknown, never silently wsl2.
  test -x home/dot_local/bin/executable_groundwork-platform
  platform_fixture="$out_dir/platform-fixture"
  mkdir -p "$platform_fixture/bin"
  cat >"$platform_fixture/bin/uname" <<'SH'
#!/usr/bin/env bash
echo "$FAKE_UNAME"
SH
  chmod +x "$platform_fixture/bin/uname"
  printf '6.8.0-generic\n' >"$platform_fixture/osrelease-generic"
  printf '5.15.167.4-microsoft-standard-WSL2\n' >"$platform_fixture/osrelease-wsl2"
  printf '4.19.104-microsoft-standard\n' >"$platform_fixture/osrelease-wsl2-old"
  printf '4.4.0-19041-Microsoft\n' >"$platform_fixture/osrelease-wsl1"
  platform_cmd=(env -u WSL_INTEROP -u WSL_DISTRO_NAME PATH="$platform_fixture/bin:/usr/bin:/bin")
  platform_result="$("${platform_cmd[@]}" FAKE_UNAME=Darwin home/dot_local/bin/executable_groundwork-platform)"
  [[ "$platform_result" == "darwin" ]] || fail "groundwork-platform reported '$platform_result' for Darwin"
  platform_result="$("${platform_cmd[@]}" FAKE_UNAME=Linux \
    GROUNDWORK_OSRELEASE_FILE="$platform_fixture/osrelease-generic" home/dot_local/bin/executable_groundwork-platform)"
  [[ "$platform_result" == "linux" ]] || fail "groundwork-platform reported '$platform_result' for generic Linux"
  platform_result="$("${platform_cmd[@]}" FAKE_UNAME=Linux \
    GROUNDWORK_OSRELEASE_FILE="$platform_fixture/osrelease-wsl2" home/dot_local/bin/executable_groundwork-platform)"
  [[ "$platform_result" == "wsl2" ]] || fail "groundwork-platform missed the WSL2-suffixed kernel release"
  platform_result="$("${platform_cmd[@]}" FAKE_UNAME=Linux \
    GROUNDWORK_OSRELEASE_FILE="$platform_fixture/osrelease-wsl2-old" home/dot_local/bin/executable_groundwork-platform)"
  [[ "$platform_result" == "wsl2" ]] \
    || fail "groundwork-platform misclassified an older microsoft-standard WSL2 kernel as '$platform_result'"
  platform_result="$("${platform_cmd[@]}" FAKE_UNAME=Linux \
    GROUNDWORK_OSRELEASE_FILE="$platform_fixture/osrelease-wsl1" home/dot_local/bin/executable_groundwork-platform)"
  [[ "$platform_result" == "wsl1" ]] || fail "groundwork-platform must report unsupported WSL1 distinctly, got '$platform_result'"
  platform_result="$("${platform_cmd[@]}" FAKE_UNAME=Linux WSL_INTEROP=/run/WSL/1_interop \
    GROUNDWORK_OSRELEASE_FILE="$platform_fixture/osrelease-generic" home/dot_local/bin/executable_groundwork-platform)"
  [[ "$platform_result" == "wsl-unknown" ]] \
    || fail "an interop variable without a recognizable kernel must be wsl-unknown, got '$platform_result'"
  platform_result="$("${platform_cmd[@]}" FAKE_UNAME=Linux WSL_DISTRO_NAME=Ubuntu \
    GROUNDWORK_OSRELEASE_FILE="$platform_fixture/osrelease-generic" home/dot_local/bin/executable_groundwork-platform)"
  [[ "$platform_result" == "wsl-unknown" ]] \
    || fail "WSL_DISTRO_NAME without a recognizable kernel must be wsl-unknown, got '$platform_result'"
  platform_result="$("${platform_cmd[@]}" FAKE_UNAME=MINGW64_NT-10.0 home/dot_local/bin/executable_groundwork-platform)"
  [[ "$platform_result" == "unsupported" ]] || fail "groundwork-platform must report Git Bash/native Windows as unsupported"

  # groundwork-distro reports the distribution ID verbatim (a derivative is
  # itself, not its parent) and --family reports the bootstrap-prerequisite
  # family from ID/ID_LIKE; platform and distro are separate dimensions, and
  # only bootstrap prerequisites may branch on the family.
  test -x home/dot_local/bin/executable_groundwork-distro
  for distro_case in 'ubuntu:ubuntu' 'debian:debian' 'linuxmint:linuxmint' 'gentoo:gentoo'; do
    distro_id="${distro_case%%:*}"
    distro_expected="${distro_case#*:}"
    printf 'ID=%s\nNAME="Fixture"\n' "$distro_id" >"$platform_fixture/os-release"
    distro_result="$(GROUNDWORK_OS_RELEASE_FILE="$platform_fixture/os-release" \
      /bin/bash home/dot_local/bin/executable_groundwork-distro)"
    [[ "$distro_result" == "$distro_expected" ]] \
      || fail "groundwork-distro reported '$distro_result' for ID=$distro_id (expected $distro_expected)"
  done
  for family_case in 'ubuntu::debian' 'debian::debian' 'linuxmint:ubuntu debian:debian' \
    'pop:ubuntu debian:debian' 'fedora::fedora' 'centos:rhel fedora:fedora' 'arch::arch' \
    'manjaro:arch:arch' 'opensuse-leap:suse opensuse:opensuse' 'gentoo::unknown'; do
    IFS=':' read -r family_id family_like family_expected <<<"$family_case"
    {
      printf 'ID=%s\n' "$family_id"
      [[ -n "$family_like" ]] && printf 'ID_LIKE="%s"\n' "$family_like"
    } >"$platform_fixture/os-release"
    distro_result="$(GROUNDWORK_OS_RELEASE_FILE="$platform_fixture/os-release" \
      /bin/bash home/dot_local/bin/executable_groundwork-distro --family)"
    [[ "$distro_result" == "$family_expected" ]] \
      || fail "groundwork-distro --family reported '$distro_result' for ID=$family_id ID_LIKE='$family_like' (expected $family_expected)"
  done
  for distro_mode in '' '--family'; do
    distro_result="$(GROUNDWORK_OS_RELEASE_FILE="$platform_fixture/missing-os-release" \
      /bin/bash home/dot_local/bin/executable_groundwork-distro $distro_mode)"
    [[ "$distro_result" == "unknown" ]] || fail "groundwork-distro $distro_mode must report unknown without /etc/os-release"
  done

  # Native Windows fails closed at the entry point with WSL2 guidance instead of
  # rendering a partial configuration.
  if chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" \
    --override-data '{"chezmoi":{"os":"windows","arch":"amd64"}}' \
    execute-template --init <home/.chezmoi.toml.tmpl >"$out_dir/windows-init" 2>&1; then
    fail "chezmoi config template rendered on native Windows instead of failing closed"
  fi
  grep -qF 'requires macOS, Linux, or WSL2' "$out_dir/windows-init"
  grep -qF 'install WSL2 with Ubuntu' "$out_dir/windows-init"

  # WSL1 fails closed at the entry point with conversion instructions; a WSL2
  # kernel renders past the guard.
  if chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" \
    --override-data '{"chezmoi":{"os":"linux","arch":"amd64","kernel":{"osrelease":"4.4.0-19041-Microsoft"}}}' \
    execute-template --init <home/.chezmoi.toml.tmpl >"$out_dir/wsl1-init" 2>&1; then
    fail "chezmoi config template rendered on WSL1 instead of failing closed"
  fi
  grep -qF 'supports WSL2, not WSL1' "$out_dir/wsl1-init"
  grep -qF 'wsl --set-version' "$out_dir/wsl1-init"
  chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" \
    --override-data '{"chezmoi":{"os":"linux","arch":"amd64","kernel":{"osrelease":"5.15.167.4-microsoft-standard-WSL2"}}}' \
    execute-template --init \
    --promptBool work=false,headless=true,reset_existing_configs=false,game_dev=false,xcode=false \
    --promptString name=Test,email_personal=test@example.com,email_work=,code_dir=~/code,signingkey=,obsidian_vault_name= \
    --promptChoice password_manager=none,terminal_multiplexer=herdr \
    <home/.chezmoi.toml.tmpl >"$out_dir/wsl2-init" 2>&1 \
    || fail "chezmoi config template must render on a WSL2 kernel"
  grep -qF 'sourceDir' "$out_dir/wsl2-init"
  # Older WSL2 kernels carry microsoft-standard without any WSL2 suffix and are
  # valid WSL2 installations; they must render, not fail as WSL1.
  chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" \
    --override-data '{"chezmoi":{"os":"linux","arch":"amd64","kernel":{"osrelease":"4.19.104-microsoft-standard"}}}' \
    execute-template --init \
    --promptBool work=false,headless=true,reset_existing_configs=false,game_dev=false,xcode=false \
    --promptString name=Test,email_personal=test@example.com,email_work=,code_dir=~/code,signingkey=,obsidian_vault_name= \
    --promptChoice password_manager=none,terminal_multiplexer=herdr \
    <home/.chezmoi.toml.tmpl >"$out_dir/wsl2-old-init" 2>&1 \
    || fail "chezmoi config template must render on an older microsoft-standard WSL2 kernel"
  grep -qF 'sourceDir' "$out_dir/wsl2-old-init"

  # On WSL2, new-project refuses Windows-mounted drives; repositories belong in
  # the WSL Linux filesystem.
  # new-project resolves the helper absolutely (a stripped PATH must not make the
  # guard fail open), so the fixture supplies it through HOME.
  wsl_home="$out_dir/wsl-home"
  mkdir -p "$wsl_home/.local/bin"
  cat >"$wsl_home/.local/bin/groundwork-platform" <<'SH'
#!/usr/bin/env bash
echo wsl2
SH
  chmod +x "$wsl_home/.local/bin/groundwork-platform"
  set +e
  HOME="$wsl_home" PATH="/usr/bin:/bin" /bin/bash home/dot_local/bin/executable_new-project /mnt/c/demo \
    >"$out_dir/new-project-mnt" 2>&1
  mnt_status=$?
  set -e
  [[ "$mnt_status" -ne 0 ]] || fail "new-project accepted a repository on a Windows-mounted drive under WSL"
  grep -qF 'Windows-mounted drive' "$out_dir/new-project-mnt"
  test ! -e /mnt/c/demo
  # A relative path that traverses to the mount is canonicalized and rejected
  # too — the guard is not purely lexical on the argument.
  groundwork_repo_root="$PWD"
  set +e
  (cd /usr/bin && HOME="$wsl_home" PATH="/usr/bin:/bin" \
    /bin/bash "$groundwork_repo_root/home/dot_local/bin/executable_new-project" ../../mnt/c/demo) \
    >"$out_dir/new-project-mnt-relative" 2>&1
  mnt_status=$?
  set -e
  [[ "$mnt_status" -ne 0 ]] || fail "new-project accepted a relative path traversing into /mnt under WSL"
  grep -qF 'Windows-mounted drive' "$out_dir/new-project-mnt-relative"
  # A normal Linux-filesystem project still scaffolds under WSL.
  HOME="$wsl_home" PATH="/usr/bin:/bin" /bin/bash home/dot_local/bin/executable_new-project \
    "$wsl_home/wsl-ok-project" >"$out_dir/new-project-wsl-ok" 2>&1 \
    || fail "new-project refused a Linux-filesystem path under WSL"
  test -f "$wsl_home/wsl-ok-project/AGENTS.md"

  # The Linux/WSL2 runner never carries the macOS cask policy; casks are a
  # macOS concern (the darwin render is asserted in the beta channel profile).
  static_linux_runner="$out_dir/static-linux-update-runner"
  render linux false amd64 home/dot_local/bin/executable_groundwork-update-run.tmpl \
    "$static_linux_runner"
  grep -qF "HOMEBREW_NO_AUTO_UPDATE=1" "$static_linux_runner" \
    || fail "the Linux Homebrew upgrade lost its no-auto-update policy"
  grep -qF 'run_homebrew_upgrade_lane "Homebrew formula upgrade" 0' \
    "$static_linux_runner" \
    || fail "the Linux Homebrew upgrade bypassed the bounded runner"
  grep -qF "brew upgrade --formula \"\${formula_tokens[@]}\"" "$static_linux_runner" \
    || fail "the Linux Homebrew upgrade lost its exact installed formula set"
  assert_not_contains "gw_brew_classify_stream \"\\\$upgrade_log\"" \
    "$static_linux_runner" \
    "the Linux Homebrew upgrade bypassed the shared output runner"
  assert_not_contains '^[^#]*brew upgrade[^#]*--greedy' "$static_linux_runner" \
    "a --greedy cask flag leaked into the Linux update runner"

  check "setup prompt wording"
  # chezmoi renders its own hint under every prompt ("> bool, default false") and
  # appends its own "?" to the prompt text. So a hand-written [y/N] duplicates the
  # type hint, and trailing punctuation renders as "??" or ".?".
  assert_no_matches "setup prompts must not hand-write [y/N]; chezmoi already shows 'bool, default <x>'" \
    rg -n '\[y/N\]|\[Y/n\]' home/.chezmoi.toml.tmpl
  prompt_texts="$(rg --no-config -o 'prompt(Bool|String|Choice)Once \. "[^"]+" "[^"]+"' home/.chezmoi.toml.tmpl \
    | sed -E 's/.*" "([^"]+)"$/\1/')"
  while IFS= read -r prompt_text; do
    [[ -n "$prompt_text" ]] || continue
    case "$prompt_text" in
      *\?*)
        fail "setup prompt must not contain '?' anywhere (chezmoi appends the '?'; phrase it as one question with no internal question mark): $prompt_text"
        ;;
      *[.!])
        fail "setup prompt must not end with punctuation (chezmoi appends its own '?', giving '??' or '.?'): $prompt_text"
        ;;
    esac
  done <<<"$prompt_texts"

  # Every yes/no question carries its own affordance and names its default,
  # because chezmoi's only hint is a dim 'bool, default false' placeholder that
  # reads as "type true or false" — the exact confusion behind "do I hit yN or
  # tF?". The named default must match the literal default argument, so the two
  # can never drift apart (the Linux headless prompt is two literal prompts for
  # exactly this reason).
  # --no-config: a user ripgrep config with max-columns would silently truncate
  # these long prompt lines and make the checks pass or fail on elided text.
  bool_prompts="$(rg --no-config -o 'promptBoolOnce \. "[^"]+" "[^"]+" (true|false)' home/.chezmoi.toml.tmpl)"
  [[ -n "$bool_prompts" ]] || fail "no promptBoolOnce prompts found to check in home/.chezmoi.toml.tmpl"
  while IFS= read -r bool_prompt; do
    [[ -n "$bool_prompt" ]] || continue
    bool_default="${bool_prompt##* }"
    bool_text="$(sed -E 's/.*" "([^"]+)" (true|false)$/\1/' <<<"$bool_prompt")"
    bool_named="no"
    [[ "$bool_default" == "true" ]] && bool_named="yes"
    [[ "$bool_text" == *"Enter keeps the default: $bool_named)" ]] \
      || fail "every bool setup prompt must end by naming its real default ('... Enter keeps the default: $bool_named)'): $bool_prompt"
    [[ "$bool_text" == *"y/t"*"n/f"* ]] \
      || fail "every bool setup prompt must show the accepted answers (y/t ... n/f ...): $bool_prompt"
  done <<<"$bool_prompts"

  # Regex over the template proves the source, not the UI. Drive a real
  # `chezmoi init` in a real terminal and assert the rendered prompt: chezmoi
  # appends its own "?" and its own "> bool, default false" hint, so a stray
  # "[y/N]" or trailing punctuation shows up as "[y/N]?" / "??" only here.
  if command -v tmux >/dev/null 2>&1; then
    prompt_socket="groundwork-prompt-$$"
    prompt_dir="$out_dir/prompt-render"
    mkdir -p "$prompt_dir/home" "$prompt_dir/src"
    cp home/.chezmoi.toml.tmpl "$prompt_dir/src/.chezmoi.toml.tmpl"
    tmux -L "$prompt_socket" new-session -d -x 120 -y 24 -c "$prompt_dir" /bin/sh
    # HOME alone does not isolate chezmoi: Groundwork exports XDG_CONFIG_HOME,
    # and chezmoi reads its config from there first, so the machine's real saved
    # answers would silently satisfy every promptOnce and no prompt would render
    # — and worse, `chezmoi init` would REGENERATE the real config pointing at
    # the scratch source (this happened; see the sentinel below). Every XDG dir
    # is scoped into the fixture home.
    real_chezmoi_config="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/chezmoi.toml"
    real_config_before="none"
    [[ ! -f "$real_chezmoi_config" ]] || real_config_before="$(cksum <"$real_chezmoi_config")"
    tmux -L "$prompt_socket" send-keys \
      "HOME=$prompt_dir/home XDG_CONFIG_HOME=$prompt_dir/home/.config XDG_DATA_HOME=$prompt_dir/home/.local/share XDG_STATE_HOME=$prompt_dir/home/.local/state XDG_CACHE_HOME=$prompt_dir/home/.cache chezmoi init --source $prompt_dir/src" Enter
    prompt_rendered=""
    for _ in $(seq 1 50); do
      prompt_rendered="$(tmux -L "$prompt_socket" capture-pane -p 2>/dev/null || true)"
      grep -qF 'bool, default' <<<"$prompt_rendered" && break
      sleep 0.2
    done
    tmux -L "$prompt_socket" kill-server 2>/dev/null || true
    grep -qF 'bool, default' <<<"$prompt_rendered" \
      || fail "chezmoi init never rendered a prompt (cannot verify the setup UI)"
    grep -qF 'Is this a work machine (y/t = yes, n/f = no; Enter keeps the default: no)?' <<<"$prompt_rendered" \
      || fail "the first setup prompt did not render with its answer affordance and named default"
    if grep -qE '\?\?|\.\?|\[y/N\]|\[Y/n\]' <<<"$prompt_rendered"; then
      printf '%s\n' "$prompt_rendered" >&2
      fail "the rendered setup prompt has doubled punctuation or a hand-written [y/N] (chezmoi adds its own '?' and 'bool, default <x>' hint)"
    fi
    # Sentinel: validation must NEVER touch the machine's real chezmoi config.
    # An earlier version of this check leaked through XDG_CONFIG_HOME and
    # rewrote the real config to point at the scratch source; this assertion
    # makes that class of regression fail loudly instead of corrupting state.
    real_config_after="none"
    [[ ! -f "$real_chezmoi_config" ]] || real_config_after="$(cksum <"$real_chezmoi_config")"
    [[ "$real_config_before" == "$real_config_after" ]] \
      || fail "the setup-UI check MUTATED the real chezmoi config at $real_chezmoi_config — its isolation is broken"
  fi

  check "chezmoi interview: release preferences stay out of bootstrap"
  # Stable versus preview and Xcode beta are mutable preferences, not facts
  # required to render a usable first install. Fresh setup derives a stable
  # profile from the bootstrap-critical work answer; existing saved preferences
  # survive regeneration and remain editable through groundwork-configure.
  assert_no_matches "chezmoi init must not ask for a release profile" \
    rg -n 'promptChoiceOnce \. "profile_preset"|Starting profile' home/.chezmoi.toml.tmpl
  assert_no_matches "chezmoi init must not ask for an Xcode beta preference" \
    rg -n 'promptBoolOnce \. "beta"' home/.chezmoi.toml.tmpl
  _profile_render() {
    local override_data="$1"
    chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" \
      --override-data "$override_data" \
      execute-template --init \
      --promptBool work=false,headless=false,reset_existing_configs=false,game_dev=false,xcode=false \
      --promptString name=Test,email_personal=test@example.com,email_work=,code_dir=~/code,signingkey=,obsidian_vault_name= \
      --promptChoice password_manager=none,key_repeat=fast,terminal_multiplexer=herdr \
      <home/.chezmoi.toml.tmpl 2>&1
  }
  preset_out="$(_profile_render '{"work":false,"chezmoi":{"os":"darwin","arch":"arm64","osRelease":{}}}')" \
    || fail "fresh stable profile did not render"
  grep -qF 'profile_preset = "personal-current"' <<<"$preset_out" \
    || fail "a fresh personal install must seed personal-current without another prompt"
  grep -qF 'release_posture = "current"' <<<"$preset_out" \
    || fail "a fresh install must default to stable/current release posture"
  preset_out="$(_profile_render '{"work":true,"chezmoi":{"os":"darwin","arch":"arm64","osRelease":{}}}')" \
    || fail "fresh work profile did not render"
  grep -qF 'profile_preset = "work-managed"' <<<"$preset_out" \
    || fail "a fresh work install must seed work-managed from the work answer"
  grep -qF 'release_posture = "current"' <<<"$preset_out" \
    || fail "a fresh work install must default to stable/current release posture"
  preset_out="$(_profile_render '{"work":false,"profile_preset":"personal-preview","release_posture":"preview","xcode":true,"beta":true,"chezmoi":{"os":"darwin","arch":"arm64","osRelease":{}}}')" \
    || fail "stored preview preferences did not render"
  grep -qF 'profile_preset = "personal-preview"' <<<"$preset_out" \
    || fail "an existing personal-preview preset must survive regeneration"
  grep -qF 'release_posture = "preview"' <<<"$preset_out" \
    || fail "an existing preview posture must survive regeneration"
  grep -qF 'beta = true' <<<"$preset_out" \
    || fail "an existing Xcode beta preference must survive regeneration"
  grep -qF 'environment_role = "personal"' <<<"$preset_out" \
    || fail "changing posture must not change the personal role"

  check "chezmoi interview: key repeat menu, dual return domain, and where it is asked"
  # Key repeat keeps its existing numbered-menu contract plus a scope rule: key
  # repeat is a property of the machine holding the PHYSICAL keyboard, so it is
  # asked on desktops only. DISPLAY is set throughout so `headless` resolves false
  # on Linux — otherwise a passing "not asked" result would prove only that the
  # headless branch fired, never that the WSL guard works.
  _kr_render() { # $1 = override data for key_repeat (may be empty), $2 = os, $3 = kernel osrelease
    DISPLAY=:0 chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" \
      --override-data "{${1}\"chezmoi\":{\"os\":\"$2\",\"arch\":\"arm64\",\"osRelease\":{},\"kernel\":{\"osrelease\":\"$3\"}}}" \
      execute-template --init \
      --promptBool work=false,headless=false,reset_existing_configs=false,game_dev=false,xcode=false \
      --promptString name=Test,email_personal=test@example.com,email_work=,code_dir=~/code,signingkey=,obsidian_vault_name= \
      --promptChoice password_manager=none,terminal_multiplexer=herdr \
      <home/.chezmoi.toml.tmpl 2>&1
  }
  # Digit domain: a fresh or `--prompt` run returns the menu number.
  for kr_pair in '1:fast' '2:standard' '3:aggressive'; do
    kr_num="${kr_pair%%:*}"
    kr_want="${kr_pair##*:}"
    kr_out="$(_kr_render "\"key_repeat\":\"$kr_num\"," darwin "")" \
      || fail "key repeat menu did not render (choice $kr_num)"
    grep -qF "key_repeat = \"$kr_want\"" <<<"$kr_out" \
      || {
        printf '%s\n' "$kr_out" >&2
        fail "key repeat menu choice $kr_num must store $kr_want"
      }
  done
  # Stored-value domain: an ordinary existing-config run returns the value itself.
  for kr_want in fast standard aggressive; do
    kr_out="$(_kr_render "\"key_repeat\":\"$kr_want\"," darwin "")" \
      || fail "key repeat prompt did not render a stored-value answer ($kr_want)"
    grep -qF "key_repeat = \"$kr_want\"" <<<"$kr_out" \
      || fail "a stored key_repeat ($kr_want) must pass through unchanged, not be dropped as a non-digit"
  done
  # An unrecognized stored value must fall back to the recommendation, not render
  # a value no apply path knows how to honor.
  kr_out="$(_kr_render '"key_repeat":"bogus",' darwin "")" || fail "key repeat prompt must render with an invalid stored value"
  grep -qF 'key_repeat = "fast"' <<<"$kr_out" \
    || fail "an unrecognized stored key_repeat must fall back to fast"
  # Asked on a real Linux desktop...
  kr_out="$(_kr_render '"key_repeat":"3",' linux "6.8.0-generic")" || fail "key repeat prompt must render on a Linux desktop"
  grep -qF 'headless = false' <<<"$kr_out" \
    || fail "the Linux desktop key-repeat fixture must resolve headless=false, or it proves nothing"
  grep -qF 'key_repeat = "aggressive"' <<<"$kr_out" \
    || fail "a Linux desktop must be asked for key repeat (GNOME and X11 can honor it)"
  # ...and never under WSL2, where Windows owns the keyboard. WSLg sets a display,
  # so these reach the prompt as non-headless desktops and only the WSL guard stops them.
  for kr_kernel in "5.15.167.4-microsoft-standard-WSL2" "4.19.104-microsoft-standard"; do
    kr_out="$(_kr_render '"key_repeat":"3",' linux "$kr_kernel")" \
      || fail "key repeat template must render under WSL2 ($kr_kernel)"
    grep -qF 'headless = false' <<<"$kr_out" \
      || fail "the WSL2 key-repeat fixture must resolve headless=false, or the guard is untested"
    grep -qF 'key_repeat = "fast"' <<<"$kr_out" \
      || {
        printf '%s\n' "$kr_out" >&2
        fail "WSL2 must not be asked for key repeat: Windows owns the keyboard ($kr_kernel)"
      }
  done

  check "key repeat: rendered apply paths honor the choice on both platforms"
  _kr_apply() { # $1 = template, $2 = os, $3 = key_repeat override (may be empty)
    chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" \
      --override-data "{${3}\"headless\":false,\"work\":false,\"password_manager\":\"none\",\"chezmoi\":{\"os\":\"$2\",\"arch\":\"arm64\",\"osRelease\":{}}}" \
      execute-template <"$1" 2>&1
  }
  # macOS: KeyRepeat is the interval between repeats, InitialKeyRepeat the delay
  # before they start. Assert the PAIRS, since a profile that changed only one of
  # them would still look plausible in isolation.
  kr_tmpl=home/run_onchange_after_30-macos-defaults.sh.tmpl
  for kr_case in 'fast:1:15' 'standard:2:15' 'aggressive:1:10'; do
    kr_name="${kr_case%%:*}"
    kr_rest="${kr_case#*:}"
    kr_interval="${kr_rest%%:*}"
    kr_delay="${kr_rest##*:}"
    kr_out="$(_kr_apply "$kr_tmpl" darwin "\"key_repeat\":\"$kr_name\",")" \
      || fail "macOS defaults must render for key_repeat=$kr_name"
    grep -qF "defaults write NSGlobalDomain KeyRepeat -int $kr_interval" <<<"$kr_out" \
      || fail "key_repeat=$kr_name must write KeyRepeat $kr_interval"
    grep -qF "defaults write NSGlobalDomain InitialKeyRepeat -int $kr_delay" <<<"$kr_out" \
      || fail "key_repeat=$kr_name must write InitialKeyRepeat $kr_delay"
    bash -n <(printf '%s\n' "$kr_out") || fail "rendered macOS defaults (key_repeat=$kr_name) must be valid bash"
  done
  # MIGRATION SAFETY. Groundwork shipped 2/15 unconditionally before this question
  # existed, so an already-installed machine has no key_repeat in its data. If
  # "absent" meant "fast", every existing user's keyboard would silently speed up
  # on their next apply — a change presented as a choice they were never offered.
  # Absent must mean "keep what you had".
  kr_out="$(_kr_apply "$kr_tmpl" darwin "")" || fail "macOS defaults must render when key_repeat is absent (existing installs)"
  grep -qF 'defaults write NSGlobalDomain KeyRepeat -int 2' <<<"$kr_out" \
    || fail "a config with no key_repeat must PRESERVE the legacy 2/15, not silently switch the user to fast"
  grep -qF 'defaults write NSGlobalDomain InitialKeyRepeat -int 15' <<<"$kr_out" \
    || fail "the legacy fallback must keep InitialKeyRepeat 15"
  # A malformed value takes the same conservative path: when the answer cannot be
  # read, changing someone's typing speed is the wrong guess.
  kr_out="$(_kr_apply "$kr_tmpl" darwin '"key_repeat":"bogus",')" || fail "macOS defaults must render with an invalid key_repeat"
  grep -qF 'defaults write NSGlobalDomain KeyRepeat -int 2' <<<"$kr_out" \
    || fail "an unreadable key_repeat must preserve the legacy setting, not pick a faster one"
  grep -qF 'defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false' <<<"$kr_out" \
    || fail "press-and-hold must stay disabled regardless of key repeat choice (vim motions depend on it)"

  check "key repeat: the Linux path is scoped, isolated, and never touches this host"
  kr_lin=home/run_after_31-linux-input-defaults.sh.tmpl
  # Linux: the same three intents expressed natively.
  for kr_case in 'fast:225:15' 'standard:225:30' 'aggressive:150:15'; do
    kr_name="${kr_case%%:*}"
    kr_rest="${kr_case#*:}"
    kr_out="$(_kr_apply "$kr_lin" linux "\"key_repeat\":\"$kr_name\",")" \
      || fail "linux input defaults must render for key_repeat=$kr_name"
    grep -qF "delay_ms=${kr_rest%%:*}" <<<"$kr_out" || fail "linux key_repeat=$kr_name must set delay_ms ${kr_rest%%:*}"
    grep -qF "interval_ms=${kr_rest##*:}" <<<"$kr_out" || fail "linux key_repeat=$kr_name must set interval_ms ${kr_rest##*:}"
    bash -n <(printf '%s\n' "$kr_out") || fail "rendered linux input defaults (key_repeat=$kr_name) must be valid bash"
  done
  # Scope: nothing renders on macOS, on WSL2 (WSLg supplies a display, so the
  # headless check alone does NOT exclude it), or for a config predating the
  # question — Groundwork never set Linux key repeat before, so there is nothing
  # to preserve and no basis for guessing.
  kr_out="$(_kr_apply "$kr_lin" darwin '"key_repeat":"fast",')" || fail "linux input template must render on darwin"
  assert_no_matches "linux input defaults leaked onto darwin" rg -n 'gsettings|xset' <(printf '%s\n' "$kr_out")
  for kr_kernel in "5.15.167.4-microsoft-standard-WSL2" "4.19.104-microsoft-standard"; do
    kr_out="$(chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" \
      --override-data "{\"key_repeat\":\"fast\",\"headless\":false,\"work\":false,\"password_manager\":\"none\",\"chezmoi\":{\"os\":\"linux\",\"arch\":\"amd64\",\"osRelease\":{},\"kernel\":{\"osrelease\":\"$kr_kernel\"}}}" \
      execute-template <"$kr_lin" 2>&1)" || fail "linux input template must render under WSL2 ($kr_kernel)"
    assert_no_matches "key repeat must not be APPLIED under WSL2 ($kr_kernel): Windows owns the keyboard" \
      rg -n 'gsettings|xset' <(printf '%s\n' "$kr_out")
  done
  kr_out="$(_kr_apply "$kr_lin" linux "")" || fail "linux input template must render with no key_repeat answer"
  assert_no_matches "a config predating the key-repeat question must not touch Linux input state" \
    rg -n 'gsettings|xset' <(printf '%s\n' "$kr_out")

  # BEHAVIORAL fixtures. These EXECUTE the rendered script, so they must never be
  # able to reach this host's real desktop: a stray /usr/bin/gsettings on a Linux
  # developer machine would rewrite that developer's own dconf keyboard settings
  # from a repository validator. Everything runs against fake executables in a
  # scratch PATH, with HOME, DISPLAY, and the session-bus variables isolated.
  kr_fix="$out_dir/kr-fixture"
  rm -rf "$kr_fix"
  mkdir -p "$kr_fix/bin" "$kr_fix/home"
  cat >"$kr_fix/bin/gsettings" <<'KRGS'
#!/usr/bin/env bash
case "$1" in
  list-schemas) [[ -n "${FAKE_GNOME_SCHEMA:-}" ]] && echo org.gnome.desktop.peripherals.keyboard; exit 0 ;;
  set) [[ -n "${FAKE_GNOME_FAIL:-}" ]] && exit 1; echo "gsettings $*" >>"$FAKE_LOG"; exit 0 ;;
esac
exit 0
KRGS
  cat >"$kr_fix/bin/xset" <<'KRXS'
#!/usr/bin/env bash
[[ "$1" == "q" ]] && { [[ -n "${FAKE_X11:-}" ]] && exit 0; exit 1; }
[[ -n "${FAKE_X11:-}" ]] || exit 1
echo "xset $*" >>"$FAKE_LOG"
exit 0
KRXS
  chmod +x "$kr_fix/bin/gsettings" "$kr_fix/bin/xset"
  _kr_run() { # $1 = rendered script, rest = env assignments
    local script="$1"
    shift
    env -i PATH="$kr_fix/bin:/usr/bin:/bin" HOME="$kr_fix/home" FAKE_LOG="$kr_fix/log" \
      "$@" bash "$script"
  }
  _kr_apply "$kr_lin" linux '"key_repeat":"aggressive",' >"$kr_fix/aggressive.sh"
  _kr_apply "$kr_lin" linux '"key_repeat":"standard",' >"$kr_fix/standard.sh"

  # 1. No mechanism at all: must exit 0, or a non-zero run_ script aborts the apply.
  : >"$kr_fix/log"
  kr_out="$(_kr_run "$kr_fix/aggressive.sh" 2>&1)" \
    || fail "linux input defaults must exit 0 when no key-repeat mechanism is present, or it aborts the apply"
  grep -qF 'NOT applied' <<<"$kr_out" || fail "with no mechanism available the script must say key repeat was not applied"
  grep -qF 'KDE' <<<"$kr_out" || fail "with no mechanism available the script must name the desktops that set this themselves"
  [[ ! -s "$kr_fix/log" ]] || fail "no mechanism was available, yet a keyboard command was issued"

  # 2. GNOME available: exact commands and values, and NO xset fallback alongside it.
  : >"$kr_fix/log"
  kr_out="$(_kr_run "$kr_fix/aggressive.sh" FAKE_GNOME_SCHEMA=1 FAKE_X11=1 DISPLAY=:0 2>&1)" \
    || fail "linux input defaults must exit 0 on the GNOME path"
  grep -qF 'gsettings set org.gnome.desktop.peripherals.keyboard delay 150' "$kr_fix/log" \
    || fail "GNOME path must set delay 150 for the aggressive profile"
  grep -qF 'gsettings set org.gnome.desktop.peripherals.keyboard repeat-interval 15' "$kr_fix/log" \
    || fail "GNOME path must set repeat-interval 15 for the aggressive profile"
  grep -qF 'gsettings set org.gnome.desktop.peripherals.keyboard repeat true' "$kr_fix/log" \
    || fail "GNOME path must enable repeat"
  assert_no_matches "X11 must not also run once GNOME has persisted the setting" rg -n '^xset' "$kr_fix/log"
  grep -qF 'persists' <<<"$kr_out" || fail "the GNOME path must report that the setting persists"
  # Undo guidance must cover EVERY key the script writes, `repeat` included.
  for kr_key in repeat delay repeat-interval; do
    grep -qF "gsettings reset org.gnome.desktop.peripherals.keyboard $kr_key" <<<"$kr_out" \
      || fail "undo guidance must reset $kr_key — every field Groundwork changed"
  done

  # 3. GNOME schema present but the write fails: fall through to X11 AND still
  #    surface the recorded GNOME reason rather than dropping it.
  : >"$kr_fix/log"
  kr_out="$(_kr_run "$kr_fix/standard.sh" FAKE_GNOME_SCHEMA=1 FAKE_GNOME_FAIL=1 FAKE_X11=1 DISPLAY=:0 2>&1)" \
    || fail "linux input defaults must exit 0 when the GNOME write fails"
  grep -qF 'xset r rate 225 33' "$kr_fix/log" \
    || fail "a failed GNOME write must fall back to xset (standard = 1000/30 = 33 repeats per second)"
  grep -qF 'SESSION ONLY' <<<"$kr_out" || fail "the X11 path must state that it does not persist"
  grep -qF 'session bus' <<<"$kr_out" \
    || fail "a recorded GNOME failure must still be reported, not silently dropped once another path succeeds"

  # 4. X11 reachable but no GNOME schema: xset only.
  : >"$kr_fix/log"
  kr_out="$(_kr_run "$kr_fix/aggressive.sh" FAKE_X11=1 DISPLAY=:0 2>&1)" \
    || fail "linux input defaults must exit 0 on the X11-only path"
  grep -qF 'xset r rate 150 66' "$kr_fix/log" \
    || fail "X11-only path must set the aggressive rate (1000/15 = 66 repeats per second)"
  assert_no_matches "no GNOME schema was present, so no gsettings write may occur" rg -n '^gsettings' "$kr_fix/log"

  # 5. DISPLAY set but no X server answering: xset must not be used.
  : >"$kr_fix/log"
  kr_out="$(_kr_run "$kr_fix/aggressive.sh" DISPLAY=:0 2>&1)" \
    || fail "linux input defaults must exit 0 when DISPLAY is set but no server answers"
  [[ ! -s "$kr_fix/log" ]] || fail "DISPLAY alone is not proof of a reachable X server; xset q must gate it"

  # 6. A forwarded display over SSH is the WORST case: DISPLAY is set and an X
  #    server answers, but it is the OPERATOR's screen, not this host's. The
  #    guard that saves us is that a remote host is headless, so the template
  #    renders inert — prove the rendered script is empty rather than trusting it.
  kr_out="$(chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" \
    --override-data '{"key_repeat":"aggressive","headless":true,"work":false,"password_manager":"none","chezmoi":{"os":"linux","arch":"amd64","osRelease":{},"kernel":{"osrelease":"6.8.0-generic"}}}' \
    execute-template <"$kr_lin" 2>&1)" || fail "linux input template must render for a headless host"
  assert_no_matches "a headless host must never configure a keyboard, even with a forwarded DISPLAY" \
    rg -n 'gsettings|xset' <(printf '%s\n' "$kr_out")

  check "groundwork-configure exposes all three key-repeat values"
  # The editor is what moves an EXISTING user off the preserved legacy setting, so
  # the field has to be selectable there, not only answerable at install time.
  # Set locally: the shared gc_bin is assigned further down, after this check.
  kr_gc_bin=home/dot_local/bin/executable_groundwork-configure
  gc_bin="$kr_gc_bin"
  grep -qE '^keyrepeat_values=\(fast standard aggressive\)$' "$gc_bin" \
    || fail "groundwork-configure must offer exactly fast, standard, and aggressive"
  grep -qE '^fields_key=\(.*\bkey_repeat\b' "$gc_bin" \
    || fail "key_repeat must appear in the groundwork-configure field registry"
  gc_kr_kind="$(
    sed -n 's/^fields_key=(\(.*\))[[:space:]]*$/\1/p' "$gc_bin" | tr ' ' '\n' | grep -n '^key_repeat$' | cut -d: -f1
  )"
  [[ -n "$gc_kr_kind" ]] || fail "could not locate key_repeat in the field registry"
  gc_kr_kind="$(sed -n 's/^fields_kind=(\(.*\))[[:space:]]*$/\1/p' "$gc_bin" | tr ' ' '\n' | sed -n "${gc_kr_kind}p")"
  [[ "$gc_kr_kind" == "keyrepeat" ]] \
    || fail "key_repeat must use the keyrepeat menu kind, not '$gc_kr_kind' (parallel arrays drifted)"

  check "groundwork-configure settings editor"
  gc_bin=home/dot_local/bin/executable_groundwork-configure
  test -x "$gc_bin" || fail "groundwork-configure must exist and be executable"
  bash -n "$gc_bin" || fail "groundwork-configure must be valid bash"
  # Argument contract: parse before any side effect. --help exits 0; unknown
  # options and unexpected positionals exit 64; none of these mutate anything.
  gc_rc=0
  bash "$gc_bin" --help >/dev/null 2>&1 || gc_rc=$?
  [[ "$gc_rc" -eq 0 ]] || fail "groundwork-configure --help must exit 0"
  gc_rc=0
  bash "$gc_bin" --bogus >/dev/null 2>&1 || gc_rc=$?
  [[ "$gc_rc" -eq 64 ]] || fail "groundwork-configure must reject an unknown option with exit 64"
  gc_rc=0
  bash "$gc_bin" extra arg >/dev/null 2>&1 || gc_rc=$?
  [[ "$gc_rc" -eq 64 ]] || fail "groundwork-configure must reject positional arguments with exit 64"
  gc_rc=0
  bash "$gc_bin" --release-posture sideways >/dev/null 2>&1 || gc_rc=$?
  [[ "$gc_rc" -eq 64 ]] || fail "groundwork-configure must reject an invalid release posture with exit 64"
  grep -qE '^fields_key=\(release_posture environment_role terminal_multiplexer beta work ' "$gc_bin" \
    || fail "groundwork-configure must expose independent posture/role and dependent Xcode beta settings"
  grep -qE '^fields_kind=\(posture role multiplexer bool bool ' "$gc_bin" \
    || fail "release posture, environment role, terminal multiplexer, and Xcode beta must use the matching guarded field types"
  grep -qE '^role_values=\(personal managed disposable\)$' "$gc_bin" \
    || fail "groundwork-configure must keep every supported environment role reachable"
  grep -qF 'pending_origin=()' "$gc_bin" \
    || fail "groundwork-configure must distinguish user and dependency-created pending changes"
  assert_no_matches "profile_preset is bootstrap history, not a live settings master" \
    rg -n '^fields_key=.*profile_preset' "$gc_bin"
  assert_no_matches "changing one preference must never silently reseed independent role or posture" \
    rg -n 'data\.pop\("environment_role"|data\.pop\("release_posture"' "$gc_bin"
  # Safe machine-state handling: candidate via isolated init, no sed on TOML,
  # compare-before-swap + lock + atomic 0600 promotion, apply with the exact config.
  grep -qF 'init --config-path' "$gc_bin" || fail "groundwork-configure must render a candidate via 'init --config-path'"
  grep -qF -- '--persistent-state' "$gc_bin" || fail "groundwork-configure must isolate persistent-state for the candidate render"
  assert_no_matches "groundwork-configure must not edit TOML with sed" rg -n 'sed -i' "$gc_bin"
  grep -qF 'cksum' "$gc_bin" || fail "groundwork-configure must compare the config digest before swapping (no clobber of newer answers)"
  grep -qE 'mkdir .*lock_dir' "$gc_bin" || fail "groundwork-configure must take a promotion lock"
  grep -qF 'chmod 600' "$gc_bin" || fail "the promoted config must be written mode 0600"
  grep -qE 'mv -f .*config_path' "$gc_bin" || fail "config promotion must be an atomic rename"
  grep -qE 'config .*config_path.* apply' "$gc_bin" || fail "groundwork-configure must apply with the exact promoted config path"
  # Refusal is state-specific across the four TTY/config states, and every refusal
  # is environment-independent so it stays deterministic on a bare CI runner. Drive
  # the two NON-TTY states hermetically with an isolated XDG_CONFIG_HOME (the TTY
  # states run through a pty below). This class of check leaked the developer's
  # real config once and passed locally while failing in CI; isolating the config
  # dir is what keeps local == CI.
  gc_states="$out_dir/gw-configure-states"
  mkdir -p "$gc_states/noconfig" "$gc_states/withconfig/chezmoi"
  : >"$gc_states/withconfig/chezmoi/chezmoi.toml" # existence is all these guards read
  # non-TTY + MISSING config: the missing config is the deeper problem; advising a
  # user to edit a file that does not exist is not actionable, so it must win.
  gc_out_noconf="$(XDG_CONFIG_HOME="$gc_states/noconfig" bash "$gc_bin" </dev/null 2>&1 || true)"
  grep -qF 'no Groundwork configuration' <<<"$gc_out_noconf" \
    || {
      printf '%s\n' "$gc_out_noconf" >&2
      fail "groundwork-configure (non-TTY, no config) must report the missing configuration, not point at a nonexistent file"
    }
  # non-TTY + PRESENT config: refuse as interactive, pointing at the real file.
  gc_out_conf="$(XDG_CONFIG_HOME="$gc_states/withconfig" bash "$gc_bin" </dev/null 2>&1 || true)"
  grep -qF 'interactive settings editor' <<<"$gc_out_conf" \
    || {
      printf '%s\n' "$gc_out_conf" >&2
      fail "groundwork-configure (non-TTY, config present) must refuse with interactive-terminal guidance"
    }
  # End-to-end through a real pty against a SYNTHETIC config: change release posture,
  # reach the Apply confirmation (the P0 regression never did), DECLINE, and leave
  # the config untouched.
  if command -v tmux >/dev/null 2>&1; then
    wait_for_gc_output() { # output literal expected-count; ten-second deadline
      local output="$1" literal="$2" expected="$3" attempt observed
      for ((attempt = 0; attempt < 100; attempt++)); do
        observed="$(grep -aF -c -- "$literal" "$output" 2>/dev/null || true)"
        [[ "$observed" -ge "$expected" ]] && return 0
        sleep 0.1
      done
      return 1
    }
    await_gc_output() { # socket output literal expected-count failure-message
      local socket="$1" output="$2" literal="$3" expected="$4" message="$5"
      wait_for_gc_output "$output" "$literal" "$expected" && return 0
      tmux -L "$socket" kill-server 2>/dev/null || true
      [[ ! -f "$output" ]] || cat "$output" >&2
      fail "$message"
    }
    # TTY + MISSING config: a real terminal but no config points at setup, NOT the
    # interactive-terminal message (the terminal is already interactive). The lead
    # `sleep 1` lets pipe-pane attach before the fast-exiting output prints.
    gc_ttync="$out_dir/gw-configure-ttync"
    mkdir -p "$gc_ttync/xdg"
    gc_ncsock="groundwork-gcnc-$$"
    gc_ncout="$gc_ttync/out"
    tmux -L "$gc_ncsock" new-session -d -x 100 -y 30 \
      "sleep 1; XDG_CONFIG_HOME='$gc_ttync/xdg' bash '$PWD/$gc_bin'; sleep 2"
    tmux -L "$gc_ncsock" pipe-pane -t 0 -o "cat >> '$gc_ncout'"
    await_gc_output "$gc_ncsock" "$gc_ncout" 'no Groundwork configuration' 1 \
      "groundwork-configure (TTY, no config) did not report its terminal state within ten seconds"
    tmux -L "$gc_ncsock" kill-server 2>/dev/null || true
    grep -aqF 'no Groundwork configuration' "$gc_ncout" \
      || {
        cat "$gc_ncout" >&2
        fail "groundwork-configure (TTY, no config) must report the missing configuration and point at setup"
      }
    # TTY + PRESENT config: the full receipt / apply-decline flow.
    gc_dir="$out_dir/gw-configure"
    mkdir -p "$gc_dir/xdg/chezmoi"
    {
      echo "sourceDir = \"$PWD/home\""
      echo '[data]'
      printf '    %s\n' 'work = false' 'headless = false' 'name = "Test User"' \
        'email_personal = "test@example.com"' 'email_work = ""' 'code_dir = "~/code"' \
        'reset_existing_configs = false' 'password_manager = "bitwarden"' 'signingkey = ""' \
        'obsidian_vault_name = "test"' 'install_chrome = false' 'profile_preset = "personal-current"' \
        'environment_role = "personal"' 'release_posture = "current"' 'terminal_multiplexer = "tmux"' 'game_dev = false' \
        'xcode = true' 'beta = false' 'key_repeat = "fast"'
    } >"$gc_dir/xdg/chezmoi/chezmoi.toml"
    # Derive the Apply entry's number from the field registry instead of hardcoding
    # it. It is (number of fields + 1), so every field ADDED to the editor silently
    # renumbered this fixture's keystrokes onto the wrong menu entry — which is how
    # adding key_repeat first surfaced, as a failure in an unrelated signing-key
    # assertion rather than anywhere near the change.
    gc_field_count="$(sed -n 's/^fields_key=(\(.*\))[[:space:]]*$/\1/p' "$gc_bin" | tr ' ' '\n' | grep -c .)"
    [[ "$gc_field_count" -ge 2 ]] \
      || fail "could not read the groundwork-configure field registry (expected fields_key=(...))"
    gc_apply_index=$((gc_field_count + 1))
    gc_sock="groundwork-gc-$$"
    gc_out="$gc_dir/out"
    tmux -L "$gc_sock" new-session -d -x 115 -y 45 \
      "XDG_CONFIG_HOME='$gc_dir/xdg' bash '$PWD/$gc_bin'; sleep 8"
    tmux -L "$gc_sock" pipe-pane -t 0 -o "cat >> '$gc_out'"
    await_gc_output "$gc_sock" "$gc_out" 'Choose a setting to change' 1 \
      "groundwork-configure did not reach its initial settings menu within ten seconds"
    tmux -L "$gc_sock" send-keys -t 0 1 Enter
    await_gc_output "$gc_sock" "$gc_out" 'Choose 1-2 (Enter keeps current)' 1 \
      "groundwork-configure did not reach the release-posture choice within ten seconds"
    tmux -L "$gc_sock" send-keys -t 0 2 Enter
    await_gc_output "$gc_sock" "$gc_out" 'Choose a setting to change' 2 \
      "groundwork-configure did not return to its settings menu within ten seconds"
    tmux -L "$gc_sock" send-keys -t 0 "$gc_apply_index" Enter
    await_gc_output "$gc_sock" "$gc_out" 'Preview the dotfiles this would change?' 1 \
      "groundwork-configure did not reach preview consent within ten seconds"
    tmux -L "$gc_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_sock" "$gc_out" 'Apply these changes?' 1 \
      "groundwork-configure did not reach apply consent within ten seconds"
    tmux -L "$gc_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_sock" "$gc_out" 'Not applied' 1 \
      "groundwork-configure did not finish the declined transaction within ten seconds"
    tmux -L "$gc_sock" kill-server 2>/dev/null || true
    grep -aqF 'Proposed changes:' "$gc_out" \
      || {
        cat "$gc_out" >&2
        fail "groundwork-configure must print a structured receipt of the change"
      }
    grep -aqF 'Release posture:' "$gc_out" \
      || fail "groundwork-configure must identify the release-posture change in its receipt"
    grep -aqF 'Apply these changes?' "$gc_out" \
      || {
        cat "$gc_out" >&2
        fail "groundwork-configure must reach the Apply confirmation (P0: the diff logic once returned early)"
      }
    grep -aqF 'Not applied' "$gc_out" \
      || fail "declining must report the configuration was not applied"
    grep -qF 'profile_preset = "personal-current"' "$gc_dir/xdg/chezmoi/chezmoi.toml" \
      || fail "declining must leave the live config unchanged"

    # Focused release-posture path: use the real candidate renderer and diff,
    # but intercept the final apply so this test never writes the developer's
    # home. The promoted config is still real evidence for the transaction.
    gc_focus="$out_dir/gw-configure-focus"
    gc_focus_real_chezmoi="$(command -v chezmoi)"
    gc_bash=/bin/bash
    [[ -x "$gc_bash" ]] || gc_bash="$(command -v bash)"
    mkdir -p "$gc_focus/bin" "$gc_focus/home" "$gc_focus/xdg/chezmoi"
    cat >"$gc_focus/bin/chezmoi" <<'STUB'
#!/usr/bin/env bash
seen_init=false
for argument in "$@"; do
  [[ "$argument" == "apply" ]] && {
    printf 'apply\n' >"$GROUNDWORK_CONFIGURE_APPLY_LOG"
    exit 0
  }
  [[ "$argument" == "init" ]] && seen_init=true
done
if [[ "$seen_init" == "true" && "${GROUNDWORK_CONFIGURE_FAIL_INIT:-0}" == "1" ]]; then
  echo "injected candidate-render failure" >&2
  exit 77
fi
exec "$GROUNDWORK_REAL_CHEZMOI" "$@"
STUB
    chmod +x "$gc_focus/bin/chezmoi"
    write_gc_focus_config() { # directory posture xcode beta role
      local directory="$1" posture="$2" xcode_value="$3" beta_value="$4" role_value="$5"
      mkdir -p "$directory/xdg/chezmoi" "$directory/home"
      cat >"$directory/xdg/chezmoi/chezmoi.toml" <<EOF
sourceDir = "$PWD/home"
[data]
    work = false
    headless = false
    name = "Test User"
    email_personal = "test@example.com"
    email_work = ""
    code_dir = "~/code"
    reset_existing_configs = false
    password_manager = "bitwarden"
    signingkey = ""
    obsidian_vault_name = "test"
    install_chrome = false
    profile_preset = "personal-current"
    environment_role = "$role_value"
    release_posture = "$posture"
    game_dev = false
    xcode = $xcode_value
    beta = $beta_value
    key_repeat = "fast"
EOF
    }
    run_gc_focus_session() { # fixture name extra-env
      local directory="$1" extra_env="${2:-}" socket="groundwork-gcf-${RANDOM}-$$"
      local output="$directory/out"
      tmux -L "$socket" new-session -d -x 115 -y 45 \
        "sleep 1; env HOME='$directory/home' XDG_CONFIG_HOME='$directory/xdg' PATH='$gc_focus/bin:$PATH' GROUNDWORK_REAL_CHEZMOI='$gc_focus_real_chezmoi' GROUNDWORK_CONFIGURE_APPLY_LOG='$directory/apply-log' $extra_env '$gc_bash' '$PWD/$gc_bin' --release-posture preview && echo complete > '$directory/session-complete'; sleep 4"
      tmux -L "$socket" pipe-pane -t 0 -o "cat >> '$output'"
      printf '%s\n' "$socket"
    }
    run_gc_main_session() { # fixture directory
      local directory="$1" socket="groundwork-gcm-${RANDOM}-$$"
      local output="$directory/out"
      tmux -L "$socket" new-session -d -x 115 -y 45 \
        "sleep 1; env HOME='$directory/home' XDG_CONFIG_HOME='$directory/xdg' PATH='$gc_focus/bin:$PATH' GROUNDWORK_REAL_CHEZMOI='$gc_focus_real_chezmoi' GROUNDWORK_CONFIGURE_APPLY_LOG='$directory/apply-log' '$gc_bash' '$PWD/$gc_bin' && echo complete > '$directory/session-complete'; sleep 4"
      tmux -L "$socket" pipe-pane -t 0 -o "cat >> '$output'"
      printf '%s\n' "$socket"
    }
    # Accept: only posture moves. Preset and independently stored role survive.
    gc_focus_accept="$gc_focus/accept"
    write_gc_focus_config "$gc_focus_accept" current false false managed
    gc_focus_sock="$(run_gc_focus_session "$gc_focus_accept")"
    await_gc_output "$gc_focus_sock" "$gc_focus_accept/out" \
      'Preview the dotfiles this would change?' 1 \
      "focused release-posture transaction did not reach preview consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 Enter
    await_gc_output "$gc_focus_sock" "$gc_focus_accept/out" 'Apply these changes?' 1 \
      "focused release-posture transaction did not reach apply consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 y Enter
    await_gc_output "$gc_focus_sock" "$gc_focus_accept/session-complete" complete 1 \
      "focused release-posture transaction did not exit successfully within ten seconds"
    tmux -L "$gc_focus_sock" kill-server 2>/dev/null || true
    grep -aqF 'Release posture:' "$gc_focus_accept/out" \
      || fail "focused release-posture transaction must print the selected change"
    assert_not_contains 'Environment profile:|Role:' "$gc_focus_accept/out" \
      "focused release-posture receipt included an unselected independent field"
    grep -qF 'release_posture = "preview"' "$gc_focus_accept/xdg/chezmoi/chezmoi.toml" \
      || fail "accepted focused transaction did not persist preview posture"
    grep -qF 'environment_role = "managed"' "$gc_focus_accept/xdg/chezmoi/chezmoi.toml" \
      || fail "focused posture change rewrote the independent environment role"
    grep -qF 'profile_preset = "personal-current"' "$gc_focus_accept/xdg/chezmoi/chezmoi.toml" \
      || fail "focused posture change rewrote the bootstrap preset history"
    [[ -f "$gc_focus_accept/apply-log" ]] \
      || fail "accepted focused transaction did not invoke the final apply"
    gc_focus_accept_posture="$(
      "$gc_focus_real_chezmoi" --config "$gc_focus_accept/xdg/chezmoi/chezmoi.toml" \
        data --format=json | jq -r '.release_posture'
    )"
    render darwin false arm64 home/dot_config/homebrew/Brewfile.browser.tmpl \
      "$gc_focus_accept/Brewfile.browser" false false false false bitwarden \
      personal-current managed "$gc_focus_accept_posture"
    grep -qx 'cask "google-chrome@beta"' "$gc_focus_accept/Brewfile.browser" \
      || fail "accepted preview posture did not select Chrome Beta for the immediate apply"

    # Already-active posture is a true no-op: no receipt, preview, or apply.
    gc_focus_noop="$gc_focus/noop"
    write_gc_focus_config "$gc_focus_noop" preview false false managed
    gc_focus_sock="$(run_gc_focus_session "$gc_focus_noop")"
    await_gc_output "$gc_focus_sock" "$gc_focus_noop/out" 'No changes to apply.' 1 \
      "focused no-op transaction did not finish within ten seconds"
    tmux -L "$gc_focus_sock" kill-server 2>/dev/null || true
    grep -aqF 'No changes to apply.' "$gc_focus_noop/out" \
      || fail "focused release-posture transaction must report an already-active posture as a no-op"
    [[ ! -e "$gc_focus_noop/apply-log" ]] \
      || fail "focused no-op transaction must not invoke apply"

    # EOF is non-consent and leaves the configuration byte-for-byte unchanged.
    gc_focus_eof="$gc_focus/eof"
    write_gc_focus_config "$gc_focus_eof" current false false personal
    cp "$gc_focus_eof/xdg/chezmoi/chezmoi.toml" "$gc_focus_eof/before.toml"
    gc_focus_sock="$(run_gc_focus_session "$gc_focus_eof")"
    await_gc_output "$gc_focus_sock" "$gc_focus_eof/out" \
      'Preview the dotfiles this would change?' 1 \
      "focused EOF transaction did not reach preview consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 C-d
    await_gc_output "$gc_focus_sock" "$gc_focus_eof/out" 'Cancelled; nothing changed.' 1 \
      "focused EOF transaction did not stop cleanly within ten seconds"
    tmux -L "$gc_focus_sock" kill-server 2>/dev/null || true
    cmp -s "$gc_focus_eof/before.toml" "$gc_focus_eof/xdg/chezmoi/chezmoi.toml" \
      || fail "EOF during focused posture change mutated the configuration"
    [[ ! -e "$gc_focus_eof/apply-log" ]] \
      || fail "EOF during focused posture change invoked apply"

    # Candidate-render failure is authoritative and cannot promote a config.
    gc_focus_fail="$gc_focus/render-failure"
    write_gc_focus_config "$gc_focus_fail" current false false personal
    cp "$gc_focus_fail/xdg/chezmoi/chezmoi.toml" "$gc_focus_fail/before.toml"
    gc_focus_sock="$(run_gc_focus_session "$gc_focus_fail" 'GROUNDWORK_CONFIGURE_FAIL_INIT=1')"
    await_gc_output "$gc_focus_sock" "$gc_focus_fail/out" \
      'could not render the candidate configuration' 1 \
      "focused render-failure transaction did not fail within ten seconds"
    tmux -L "$gc_focus_sock" kill-server 2>/dev/null || true
    grep -aqF 'could not render the candidate configuration' "$gc_focus_fail/out" \
      || fail "focused posture path did not report a candidate-render failure"
    cmp -s "$gc_focus_fail/before.toml" "$gc_focus_fail/xdg/chezmoi/chezmoi.toml" \
      || fail "candidate-render failure promoted a focused posture change"

    # A concurrent writer wins: compare-before-swap refuses this stale editor.
    gc_focus_race="$gc_focus/concurrent-change"
    write_gc_focus_config "$gc_focus_race" current false false personal
    gc_focus_sock="$(run_gc_focus_session "$gc_focus_race")"
    await_gc_output "$gc_focus_sock" "$gc_focus_race/out" \
      'Preview the dotfiles this would change?' 1 \
      "focused concurrent-change transaction did not reach preview consent within ten seconds"
    echo '# concurrent owner update' >>"$gc_focus_race/xdg/chezmoi/chezmoi.toml"
    tmux -L "$gc_focus_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_focus_sock" "$gc_focus_race/out" 'Apply these changes?' 1 \
      "focused concurrent-change transaction did not reach apply consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 y Enter
    await_gc_output "$gc_focus_sock" "$gc_focus_race/out" \
      'changed since this editor opened' 1 \
      "focused concurrent-change transaction did not reject stale state within ten seconds"
    tmux -L "$gc_focus_sock" kill-server 2>/dev/null || true
    grep -aqF 'changed since this editor opened' "$gc_focus_race/out" \
      || fail "focused posture path did not refuse a concurrently changed config"
    grep -qF '# concurrent owner update' "$gc_focus_race/xdg/chezmoi/chezmoi.toml" \
      || fail "focused posture path overwrote the concurrent owner update"
    grep -qF 'release_posture = "current"' "$gc_focus_race/xdg/chezmoi/chezmoi.toml" \
      || fail "focused posture race changed posture despite compare-before-swap refusal"

    # Xcode beta is a dependent setting. It is hidden while Xcode is disabled,
    # disabling Xcode stages beta=false in the same visible receipt, and an old
    # impossible state is normalized only through a confirmed transaction.
    gc_xcode_index="$(sed -n 's/^fields_key=(\(.*\))[[:space:]]*$/\1/p' "$gc_bin" | tr ' ' '\n' | grep -n '^xcode$' | cut -d: -f1)"
    [[ -n "$gc_xcode_index" ]] || fail "could not locate Xcode in the configure field registry"
    gc_beta_index="$(sed -n 's/^fields_key=(\(.*\))[[:space:]]*$/\1/p' "$gc_bin" | tr ' ' '\n' | grep -n '^beta$' | cut -d: -f1)"
    gc_role_index="$(sed -n 's/^fields_key=(\(.*\))[[:space:]]*$/\1/p' "$gc_bin" | tr ' ' '\n' | grep -n '^environment_role$' | cut -d: -f1)"
    [[ -n "$gc_beta_index" && -n "$gc_role_index" ]] \
      || fail "could not locate beta and environment role in the configure field registry"

    gc_xcode_disable="$gc_focus/xcode-disable"
    write_gc_focus_config "$gc_xcode_disable" current true true personal
    gc_focus_sock="$(run_gc_main_session "$gc_xcode_disable")"
    await_gc_output "$gc_focus_sock" "$gc_xcode_disable/out" \
      'Choose a setting to change' 1 \
      "Xcode-disable transaction did not reach the settings menu within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$gc_xcode_index" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_disable/out" \
      'New value [y/n]' 1 \
      "Xcode-disable transaction did not reach the value prompt within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_disable/out" \
      'Choose a setting to change' 2 \
      "Xcode-disable transaction did not return to the settings menu within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$gc_field_count" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_disable/out" \
      'Preview the dotfiles this would change?' 1 \
      "Xcode-disable transaction did not reach preview consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_disable/out" 'Apply these changes?' 1 \
      "Xcode-disable transaction did not reach apply consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 y Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_disable/session-complete" complete 1 \
      "Xcode-disable transaction did not finish within ten seconds"
    tmux -L "$gc_focus_sock" kill-server 2>/dev/null || true
    grep -aqF 'Xcode:' "$gc_xcode_disable/out" \
      || fail "disabling Xcode must include Xcode in the receipt"
    grep -aqF 'Xcode beta channel:' "$gc_xcode_disable/out" \
      || fail "disabling Xcode must include the dependent beta change in the receipt"
    grep -qF 'xcode = false' "$gc_xcode_disable/xdg/chezmoi/chezmoi.toml" \
      || fail "confirmed Xcode disable did not persist"
    grep -qF 'beta = false' "$gc_xcode_disable/xdg/chezmoi/chezmoi.toml" \
      || fail "disabling Xcode left a latent beta preference"

    # Dependency reconciliation follows the final effective Xcode state. Undoing
    # Xcode off -> on removes only the dependency-created beta change.
    gc_xcode_undo="$gc_focus/xcode-undo"
    write_gc_focus_config "$gc_xcode_undo" current true true personal
    cp "$gc_xcode_undo/xdg/chezmoi/chezmoi.toml" "$gc_xcode_undo/before.toml"
    gc_focus_sock="$(run_gc_main_session "$gc_xcode_undo")"
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo/out" \
      'Choose a setting to change' 1 \
      "Xcode-undo transaction did not reach the settings menu within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$gc_xcode_index" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo/out" 'New value [y/n]' 1 \
      "Xcode-undo transaction did not reach the disable prompt within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo/out" \
      'Choose a setting to change' 2 \
      "Xcode-undo transaction did not return after disabling Xcode within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$((gc_xcode_index - 1))" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo/out" 'New value [y/n]' 2 \
      "Xcode-undo transaction did not reach the re-enable prompt within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 y Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo/out" \
      'Choose a setting to change' 3 \
      "Xcode-undo transaction did not return after re-enabling Xcode within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$((gc_field_count + 1))" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo/out" 'No changes to apply.' 1 \
      "Xcode off then on in one transaction did not reach a no-op within ten seconds"
    tmux -L "$gc_focus_sock" kill-server 2>/dev/null || true
    grep -aqF 'No changes to apply.' "$gc_xcode_undo/out" \
      || fail "Xcode off then on in one transaction must be a complete no-op"
    cmp -s "$gc_xcode_undo/before.toml" "$gc_xcode_undo/xdg/chezmoi/chezmoi.toml" \
      || fail "Xcode off then on left a hidden beta change"
    [[ ! -e "$gc_xcode_undo/apply-log" ]] \
      || fail "Xcode off then on invoked apply despite a no-op final state"

    gc_xcode_undo_explicit="$gc_focus/xcode-undo-explicit-beta"
    write_gc_focus_config "$gc_xcode_undo_explicit" current true true personal
    gc_focus_sock="$(run_gc_main_session "$gc_xcode_undo_explicit")"
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo_explicit/out" \
      'Choose a setting to change' 1 \
      "explicit-beta transaction did not reach the settings menu within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$gc_xcode_index" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo_explicit/out" 'New value [y/n]' 1 \
      "explicit-beta transaction did not reach the Xcode-disable prompt within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo_explicit/out" \
      'Choose a setting to change' 2 \
      "explicit-beta transaction did not return after disabling Xcode within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$((gc_xcode_index - 1))" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo_explicit/out" 'New value [y/n]' 2 \
      "explicit-beta transaction did not reach the Xcode-enable prompt within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 y Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo_explicit/out" \
      'Choose a setting to change' 3 \
      "explicit-beta transaction did not return after enabling Xcode within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$gc_beta_index" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo_explicit/out" 'New value [y/n]' 3 \
      "explicit-beta transaction did not reach the beta prompt within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo_explicit/out" \
      'Choose a setting to change' 4 \
      "explicit-beta transaction did not return after the beta choice within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$((gc_field_count + 1))" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo_explicit/out" \
      'Preview the dotfiles this would change?' 1 \
      "explicit-beta transaction did not reach preview consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo_explicit/out" \
      'Apply these changes?' 1 \
      "explicit-beta transaction did not reach apply consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 y Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_undo_explicit/session-complete" complete 1 \
      "explicit-beta transaction did not finish within ten seconds"
    tmux -L "$gc_focus_sock" kill-server 2>/dev/null || true
    grep -aqF 'Xcode beta channel:' "$gc_xcode_undo_explicit/out" \
      || fail "an explicit beta change after Xcode undo must remain in the receipt"
    assert_not_contains '  Xcode:' "$gc_xcode_undo_explicit/out" \
      "Xcode off then on leaked into the explicit-beta receipt"
    grep -qF 'xcode = true' "$gc_xcode_undo_explicit/xdg/chezmoi/chezmoi.toml" \
      || fail "explicit beta change rewrote the restored Xcode state"
    grep -qF 'beta = false' "$gc_xcode_undo_explicit/xdg/chezmoi/chezmoi.toml" \
      || fail "explicit beta=false was discarded after Xcode undo"

    gc_xcode_enable="$gc_focus/xcode-enable"
    write_gc_focus_config "$gc_xcode_enable" current false false personal
    gc_focus_sock="$(run_gc_main_session "$gc_xcode_enable")"
    await_gc_output "$gc_focus_sock" "$gc_xcode_enable/out" \
      'Choose a setting to change' 1 \
      "Xcode-enable transaction did not reach the settings menu within ten seconds"
    assert_not_contains 'Xcode beta channel' "$gc_xcode_enable/out" \
      "Xcode beta must not be offered while Xcode is disabled"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$((gc_xcode_index - 1))" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_enable/out" 'New value [y/n]' 1 \
      "Xcode-enable transaction did not reach the value prompt within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 y Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_enable/out" \
      'Choose a setting to change' 2 \
      "Xcode-enable transaction did not return to the settings menu within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$((gc_field_count + 1))" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_enable/out" \
      'Preview the dotfiles this would change?' 1 \
      "Xcode-enable transaction did not reach preview consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_enable/out" 'Apply these changes?' 1 \
      "Xcode-enable transaction did not reach apply consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 y Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_enable/session-complete" complete 1 \
      "Xcode-enable transaction did not finish within ten seconds"
    tmux -L "$gc_focus_sock" kill-server 2>/dev/null || true
    grep -qF 'xcode = true' "$gc_xcode_enable/xdg/chezmoi/chezmoi.toml" \
      || fail "confirmed Xcode enable did not persist"
    grep -qF 'beta = false' "$gc_xcode_enable/xdg/chezmoi/chezmoi.toml" \
      || fail "enabling Xcode revived a stale beta preference"

    gc_xcode_invalid="$gc_focus/xcode-invalid"
    write_gc_focus_config "$gc_xcode_invalid" current false true personal
    gc_focus_sock="$(run_gc_main_session "$gc_xcode_invalid")"
    await_gc_output "$gc_focus_sock" "$gc_xcode_invalid/out" \
      'Choose a setting to change' 1 \
      "Xcode-normalization transaction did not reach the settings menu within ten seconds"
    grep -aqF 'will clear that inactive preference' "$gc_xcode_invalid/out" \
      || fail "groundwork-configure must explain normalization of xcode=false plus beta=true"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$gc_field_count" Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_invalid/out" \
      'Preview the dotfiles this would change?' 1 \
      "Xcode-normalization transaction did not reach preview consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_invalid/out" 'Apply these changes?' 1 \
      "Xcode-normalization transaction did not reach apply consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 y Enter
    await_gc_output "$gc_focus_sock" "$gc_xcode_invalid/session-complete" complete 1 \
      "Xcode-normalization transaction did not finish within ten seconds"
    tmux -L "$gc_focus_sock" kill-server 2>/dev/null || true
    grep -qF 'beta = false' "$gc_xcode_invalid/xdg/chezmoi/chezmoi.toml" \
      || fail "confirmed normalization did not clear inactive Xcode beta"

    # Environment role is independently mutable and must not reseed posture or
    # rewrite the historical profile preset.
    gc_role_change="$gc_focus/role-change"
    write_gc_focus_config "$gc_role_change" current false false personal
    gc_focus_sock="$(run_gc_main_session "$gc_role_change")"
    await_gc_output "$gc_focus_sock" "$gc_role_change/out" \
      'Choose a setting to change' 1 \
      "role-change transaction did not reach the settings menu within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$gc_role_index" Enter
    await_gc_output "$gc_focus_sock" "$gc_role_change/out" \
      'Choose 1-3 (Enter keeps current)' 1 \
      "role-change transaction did not reach the role choice within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 3 Enter
    await_gc_output "$gc_focus_sock" "$gc_role_change/out" \
      'Choose a setting to change' 2 \
      "role-change transaction did not return to the settings menu within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 "$gc_field_count" Enter
    await_gc_output "$gc_focus_sock" "$gc_role_change/out" \
      'Preview the dotfiles this would change?' 1 \
      "role-change transaction did not reach preview consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 n Enter
    await_gc_output "$gc_focus_sock" "$gc_role_change/out" 'Apply these changes?' 1 \
      "role-change transaction did not reach apply consent within ten seconds"
    tmux -L "$gc_focus_sock" send-keys -t 0 y Enter
    await_gc_output "$gc_focus_sock" "$gc_role_change/session-complete" complete 1 \
      "role-change transaction did not finish within ten seconds"
    tmux -L "$gc_focus_sock" kill-server 2>/dev/null || true
    grep -aqF 'Environment role:' "$gc_role_change/out" \
      || fail "role change must appear in the transaction receipt"
    assert_not_contains 'Release posture:' "$gc_role_change/out" \
      "role change silently rewrote independent release posture"
    grep -qF 'environment_role = "disposable"' "$gc_role_change/xdg/chezmoi/chezmoi.toml" \
      || fail "guided configuration did not make the disposable role reachable"
    grep -qF 'release_posture = "current"' "$gc_role_change/xdg/chezmoi/chezmoi.toml" \
      || fail "role change rewrote release posture"
    grep -qF 'profile_preset = "personal-current"' "$gc_role_change/xdg/chezmoi/chezmoi.toml" \
      || fail "role change rewrote the historical bootstrap seed"
  fi

  check "groundwork-github-ssh fallback (hostile arguments, semantics, transactions, revert)"
  gh_bin="$PWD/home/dot_local/bin/executable_groundwork-github-ssh"
  test -x "$gh_bin" || fail "groundwork-github-ssh must exist and be executable"
  bash -n "$gh_bin" || fail "groundwork-github-ssh must be valid bash"
  assert_no_matches "groundwork-github-ssh must never reference identity files or private keys" \
    rg -n 'IdentityFile|id_rsa|id_ed25519|id_ecdsa' "$gh_bin"
  grep -qF 'PreferredAuthentications=none' "$gh_bin" \
    || fail "transport probes must never offer authentication material"
  gh_dir="$out_dir/ghssh"
  mkdir -p "$gh_dir/bin"
  # Two fixture key pairs let the suite exercise fingerprint match, mismatch, and
  # rotation. The stub ssh delegates -G to the real OpenSSH parser (the command
  # rewrites the managed include to an absolute path first, so this is the REAL
  # config semantics, not an approximation) and answers probes per port.
  ssh-keygen -q -t ed25519 -N '' -f "$gh_dir/key1" </dev/null
  ssh-keygen -q -t ed25519 -N '' -f "$gh_dir/key2" </dev/null
  gh_key1="$(awk '{ print $1 " " $2 }' "$gh_dir/key1.pub")"
  gh_key2="$(awk '{ print $1 " " $2 }' "$gh_dir/key2.pub")"
  gh_fp1="$(ssh-keygen -lf "$gh_dir/key1.pub" | awk '{ print $2 }' | sed 's/^SHA256://')"
  gh_fp2="$(ssh-keygen -lf "$gh_dir/key2.pub" | awk '{ print $2 }' | sed 's/^SHA256://')"
  cat >"$gh_dir/bin/ssh" <<'SH'
#!/bin/sh
if [ "$1" = "-G" ]; then exec /usr/bin/ssh "$@"; fi
port=22
fcfg=/dev/null
prev=""
transport=0
for a in "$@"; do
  [ "$prev" = "-p" ] && port="$a"
  [ "$prev" = "-F" ] && fcfg="$a"
  [ "$a" = "PreferredAuthentications=none" ] && transport=1
  prev="$a"
done
if [ "$transport" = 1 ] && [ "$fcfg" != "/dev/null" ]; then
  # auth-disabled probe through a real config file = the live route check
  case "${GH_SSH_STUB_ROUTE:-ok}" in
    hostkey)
      echo "Host key verification failed." >&2
      exit 255
      ;;
    *)
      echo "git@stub: Permission denied (none)." >&2
      exit 255
      ;;
  esac
fi
if [ "$transport" = 1 ]; then
  if [ "$port" = 443 ]; then v="${GH_SSH_STUB_443:-reachable}"; else v="${GH_SSH_STUB_22:-reachable}"; fi
  case "$v" in
    stall) exec sleep 60 ;;
    unreachable)
      echo "ssh: connect to host stub port $port: Connection refused" >&2
      exit 255
      ;;
    *)
      echo "git@stub: Permission denied (none)." >&2
      exit 255
      ;;
  esac
fi
case "${GH_SSH_STUB_AUTH:-auth}" in
  noauth)
    echo "git@stub: Permission denied (publickey)." >&2
    exit 255
    ;;
  *)
    echo "Hi tester! You've successfully authenticated, but GitHub does not provide shell access." >&2
    exit 1
    ;;
esac
SH
  chmod +x "$gh_dir/bin/ssh"
  cat >"$gh_dir/bin/curl" <<SH
#!/bin/sh
case "\${GH_CURL_STUB:-ok}" in
  bad) printf '{"no_keys":true}' ;;
  mismatch) printf '{"ssh_keys":["$gh_key1"],"ssh_key_fingerprints":{"SHA256_ED25519":"$gh_fp2"}}' ;;
  rotated) printf '{"ssh_keys":["$gh_key2"],"ssh_key_fingerprints":{"SHA256_ED25519":"$gh_fp2"}}' ;;
  *) printf '{"ssh_keys":["$gh_key1"],"ssh_key_fingerprints":{"SHA256_ED25519":"$gh_fp1"}}' ;;
esac
SH
  chmod +x "$gh_dir/bin/curl"
  gh_home=""
  run_ghssh() { # scripted-verdict run under the scenario HOME; stdin is not a tty
    HOME="$gh_home" PATH="$gh_dir/bin:/usr/bin:/bin" \
      GROUNDWORK_GITHUB_SSH_PROBE_DEADLINE=1 "$gh_bin" "$@"
  }
  # --- Scenario 1: hostile arguments and fail-closed paths on an empty HOME ---
  gh_home="$gh_dir/home1"
  mkdir -p "$gh_home"
  run_ghssh --help >/dev/null || fail "groundwork-github-ssh --help must exit 0"
  gh_rc=0
  run_ghssh --bogus >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 64 ]] || fail "groundwork-github-ssh must reject an unknown option with exit 64"
  gh_rc=0
  run_ghssh enable-443 extra >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 64 ]] || fail "groundwork-github-ssh must reject unexpected positionals with exit 64"
  gh_rc=0
  run_ghssh status --yes >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 64 ]] || fail "groundwork-github-ssh must reject --yes on status (inert flags are errors)"
  gh_rc=0
  run_ghssh >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 64 ]] || fail "groundwork-github-ssh must require a subcommand with exit 64"
  gh_rc=0
  run_ghssh enable-443 </dev/null >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 2 ]] || fail "groundwork-github-ssh enable-443 without a TTY or --yes must refuse with exit 2"
  gh_rc=0
  GH_CURL_STUB=bad run_ghssh enable-443 --yes >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 1 ]] || fail "groundwork-github-ssh must fail on malformed GitHub metadata"
  gh_rc=0
  GH_CURL_STUB=mismatch run_ghssh enable-443 --yes >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 1 ]] || fail "groundwork-github-ssh must refuse keys whose fingerprints do not match the published set"
  gh_rc=0
  GH_SSH_STUB_443=stall run_ghssh enable-443 --yes >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 2 ]] || fail "groundwork-github-ssh must refuse enable when 443 times out (got $gh_rc)"
  [[ ! -e "$gh_home/.ssh/config" && ! -e "$gh_home/.ssh/groundwork/github-443.conf" ]] \
    || fail "refused/hostile/failed invocations must not install anything"
  GH_SSH_STUB_443=stall run_ghssh status >"$gh_dir/out.stall" \
    || fail "status must survive timed-out probes and still report"
  grep -qF 'timed out (no SSH answer' "$gh_dir/out.stall" \
    || fail "status must report a watchdog timeout as timed out, not as a proven post-connect stall"
  GH_SSH_STUB_AUTH=noauth run_ghssh status >"$gh_dir/out.noauth"
  grep -qF 'not a routing problem' "$gh_dir/out.noauth" \
    || fail "status must separate transport from authentication"
  # The field failure itself: port 22 dead, 443 alive — enable must work.
  GH_SSH_STUB_22=stall run_ghssh enable-443 --yes >"$gh_dir/out.enable1" \
    || fail "enable-443 must succeed when 22 times out but 443 answers"
  head -n 3 "$gh_home/.ssh/config" >"$gh_dir/head3"
  printf '%s\n%s\n%s\n' '# >>> groundwork-github-ssh >>>' 'Include ~/.ssh/groundwork/github-443.conf' '# <<< groundwork-github-ssh <<<' \
    | diff -q - "$gh_dir/head3" >/dev/null \
    || fail "the managed block must be exactly the first three lines"
  grep -qF '[ssh.github.com]:443' "$gh_home/.ssh/groundwork/github-known-hosts" \
    || fail "host keys must use the [ssh.github.com]:443 identity"
  test -f "$gh_home/.local/state/groundwork/github-ssh-443/post_config_sha256" \
    || fail "enable must write the per-field receipt"
  # GNU first: BSD stat rejects -c and fails cleanly, but GNU stat treats -f as
  # "filesystem status" and SUCCEEDS with the wrong output, so -f must be the
  # fallback, never the first attempt.
  gh_perm="$(stat -c '%a' "$gh_home/.ssh/config" 2>/dev/null || stat -f '%Lp' "$gh_home/.ssh/config")"
  [[ "$gh_perm" == "600" ]] || fail "the rewritten config must stay 0600 (got $gh_perm)"
  run_ghssh revert-443 --yes >"$gh_dir/out.revert1" || fail "revert-443 --yes must succeed"
  [[ ! -e "$gh_home/.ssh/config" ]] \
    || fail "revert on a config that did not exist before enable must remove it (exact restore of nonexistence)"
  [[ ! -e "$gh_home/.ssh/groundwork/github-443.conf" && ! -e "$gh_home/.local/state/groundwork/github-ssh-443" ]] \
    || fail "revert must remove the managed snippet and receipt"
  # --- Scenario 2: real OpenSSH semantics on a complex config ---
  gh_home="$gh_dir/home2"
  mkdir -p "$gh_home/.ssh"
  cat >"$gh_home/.ssh/config" <<'CFG'
AddKeysToAgent yes
Include ~/.ssh/groundwork-test-nonexistent-include.conf

Host github.com
  User olduser

Host workalias
  HostName github.com
  Port 2222

Match host matchhost
  ForwardAgent yes

Host *
  ServerAliveInterval 30
CFG
  cp "$gh_home/.ssh/config" "$gh_dir/complex.orig"
  for gh_host in otherhost workalias matchhost; do
    /usr/bin/ssh -G -F "$gh_dir/complex.orig" "$gh_host" >"$gh_dir/before.$gh_host" 2>/dev/null \
      || fail "real ssh -G must evaluate the fixture config"
  done
  run_ghssh enable-443 --yes >"$gh_dir/out.enable2" \
    || fail "enable-443 must succeed on a complex existing config"
  sed "s|^Include ~/.ssh/groundwork/github-443.conf\$|Include $gh_home/.ssh/groundwork/github-443.conf|" \
    "$gh_home/.ssh/config" >"$gh_dir/complex.after"
  for gh_host in otherhost workalias matchhost; do
    /usr/bin/ssh -G -F "$gh_dir/complex.after" "$gh_host" >"$gh_dir/after.$gh_host" 2>/dev/null \
      || fail "real ssh -G must evaluate the enabled config"
    diff -q "$gh_dir/before.$gh_host" "$gh_dir/after.$gh_host" >/dev/null \
      || fail "enable changed real ssh -G semantics for unrelated host '$gh_host' (scope leak)"
  done
  /usr/bin/ssh -G -F "$gh_dir/complex.after" github.com >"$gh_dir/after.github" 2>/dev/null
  grep -qx 'port 443' "$gh_dir/after.github" \
    || fail "real ssh -G must route github.com to port 443 after enable"
  grep -qx 'hostname ssh.github.com' "$gh_dir/after.github" \
    || fail "real ssh -G must route github.com to ssh.github.com after enable"
  grep -qx 'stricthostkeychecking true' "$gh_dir/after.github" \
    || fail "the managed stanza must enforce strict host-key checking"
  # Regression, real parser, overridden HOME: UserKnownHostsFile ~ resolves
  # against the passwd home while Include follows $HOME, so the snippet must pin
  # the absolute path or ssh reads keys from a different account's directory.
  grep -q "^userknownhostsfile $gh_home/.ssh/groundwork/github-known-hosts" "$gh_dir/after.github" \
    || fail "real ssh -G must resolve the FIRST known-hosts file to the fixture HOME's managed key file (tilde/passwd-home leak)"
  grep -qF "UserKnownHostsFile \"$gh_home/.ssh/groundwork/github-known-hosts\" \"$gh_home/.ssh/known_hosts\"" \
    "$gh_home/.ssh/groundwork/github-443.conf" \
    || fail "the snippet must pin absolute quoted known-hosts paths, never the ~ form"
  tail -n +4 "$gh_home/.ssh/config" | diff -q - "$gh_dir/complex.orig" >/dev/null \
    || fail "enable must preserve the existing config verbatim below the managed block"
  run_ghssh enable-443 --yes >"$gh_dir/out.idem"
  grep -qF 'already enabled' "$gh_dir/out.idem" \
    || fail "a second enable with current keys must be an idempotent no-op"
  GH_CURL_STUB=rotated run_ghssh enable-443 --yes >"$gh_dir/out.rotate" \
    || fail "enable on a healthy install with rotated keys must refresh"
  grep -qF 'Refreshed' "$gh_dir/out.rotate" || fail "the key refresh must say so"
  grep -qF "${gh_key2#ssh-ed25519 }" "$gh_home/.ssh/groundwork/github-known-hosts" \
    || fail "the refresh must install the rotated key"
  run_ghssh revert-443 --yes >"$gh_dir/out.revert2" || fail "revert after refresh must succeed"
  diff -q "$gh_home/.ssh/config" "$gh_dir/complex.orig" >/dev/null \
    || fail "revert on an unedited config must restore it byte-for-byte"
  # Surgical revert: user edits and an identical user-owned Include survive.
  run_ghssh enable-443 --yes >/dev/null || fail "re-enable for the surgical case must succeed"
  printf '# user edit after enable\nInclude ~/.ssh/groundwork/github-443.conf\n' >>"$gh_home/.ssh/config"
  run_ghssh revert-443 --yes >"$gh_dir/out.surgical"
  grep -qF 'surgical' "$gh_dir/out.surgical" \
    || fail "revert after user edits must report the surgical path"
  grep -qF '# user edit after enable' "$gh_home/.ssh/config" \
    || fail "revert must preserve user edits made after enable"
  grep -qxF 'Include ~/.ssh/groundwork/github-443.conf' "$gh_home/.ssh/config" \
    || fail "revert must not delete a user-owned duplicate include outside the marked block"
  ! grep -qF '>>> groundwork-github-ssh >>>' "$gh_home/.ssh/config" \
    || fail "revert must remove the managed block"
  sed -i.bak '/^Include ~\/.ssh\/groundwork\/github-443.conf$/d;/^# user edit after enable$/d' "$gh_home/.ssh/config" \
    && rm -f "$gh_home/.ssh/config.bak"
  # Modified managed file: preserved with a warning, never deleted.
  run_ghssh enable-443 --yes >/dev/null || fail "re-enable for the modified-snippet case must succeed"
  printf '# local tweak\n' >>"$gh_home/.ssh/groundwork/github-443.conf"
  gh_rc=0
  run_ghssh enable-443 --yes >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 2 ]] || fail "enable on a drifted install must fail closed (got $gh_rc)"
  run_ghssh revert-443 --yes >"$gh_dir/out.kept"
  grep -qF 'KEPT' "$gh_dir/out.kept" \
    || fail "revert must preserve, not delete, a managed file edited by the user"
  ls "$gh_home"/.ssh/groundwork/github-443.conf.user-modified-* >/dev/null 2>&1 \
    || fail "the preserved snippet must exist under a .user-modified name"
  rm -f "$gh_home"/.ssh/groundwork/github-443.conf.user-modified-*
  diff -q "$gh_home/.ssh/config" "$gh_dir/complex.orig" >/dev/null \
    || fail "the drifted-install revert must still restore the unedited config exactly"
  # Tampered backup: exact restore must refuse; surgical removal still works.
  run_ghssh enable-443 --yes >/dev/null || fail "re-enable for the tampered-backup case must succeed"
  gh_backup="$(cat "$gh_home/.local/state/groundwork/github-ssh-443/backup_path")"
  printf '# tampered\n' >>"$gh_backup"
  run_ghssh revert-443 --yes >"$gh_dir/out.tamper"
  grep -qF 'surgical' "$gh_dir/out.tamper" \
    || fail "revert must fall back to surgical when the backup fails SHA-256 verification"
  diff -q "$gh_home/.ssh/config" "$gh_dir/complex.orig" >/dev/null \
    || fail "the surgical fallback must still leave the original content intact"
  # --- Scenario 3: partial installs fail closed; lock contention refuses ---
  gh_home="$gh_dir/home3"
  mkdir -p "$gh_home/.ssh"
  printf '# >>> groundwork-github-ssh >>>\nInclude ~/.ssh/groundwork/github-443.conf\n# <<< groundwork-github-ssh <<<\n' \
    >"$gh_home/.ssh/config"
  gh_rc=0
  run_ghssh enable-443 --yes >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 2 ]] \
    || fail "enable must refuse to adopt a partial install as baseline (got $gh_rc)"
  run_ghssh revert-443 --yes >/dev/null || fail "revert must clean a partial install"
  ! grep -qF 'groundwork-github-ssh' "$gh_home/.ssh/config" \
    || fail "revert must remove the dangling managed block from a partial install"
  mkdir -p "$gh_home/.ssh/groundwork/.lock"
  gh_rc=0
  run_ghssh enable-443 --yes >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 1 ]] || fail "enable must refuse while another run holds the lock (got $gh_rc)"
  rmdir "$gh_home/.ssh/groundwork/.lock"
  # --- Scenario 4: a failed live route check rolls the whole transaction back ---
  gh_home="$gh_dir/home4"
  mkdir -p "$gh_home"
  gh_rc=0
  GH_SSH_STUB_ROUTE=hostkey run_ghssh enable-443 --yes >/dev/null 2>&1 || gh_rc=$?
  [[ "$gh_rc" -eq 1 ]] || fail "enable must fail when the live route check reports a host-key failure (got $gh_rc)"
  [[ ! -e "$gh_home/.ssh/config" && ! -e "$gh_home/.ssh/groundwork/github-443.conf" && ! -e "$gh_home/.local/state/groundwork/github-ssh-443" ]] \
    || fail "a failed route check must roll the whole transaction back (no config, snippet, or receipt may survive)"

  check "groundwork-source-preflight branch-state model"
  pf_helper="$PWD/home/dot_local/bin/executable_groundwork-source-preflight"
  test -x "$pf_helper" || fail "groundwork-source-preflight must exist and be executable"
  bash -n "$pf_helper" || fail "groundwork-source-preflight must be valid bash"
  # It must classify configured tracking, never mutate, and read the CONFIGURED
  # upstream (for-each-ref), not @{u} (which fails when a tracked ref is [gone]).
  grep -qF 'upstream:remotename' "$pf_helper" || fail "preflight must read the configured upstream via for-each-ref, not @{u}"
  pf_root="$out_dir/preflight"
  pf_bin="$pf_root/bin"
  mkdir -p "$pf_bin"
  cat >"$pf_bin/chezmoi" <<'SH'
#!/usr/bin/env bash
case "${1:-}" in
  source-path) [[ "${PF_SRC_FAIL:-0}" == 1 ]] && exit 1; printf '%s\n' "${PF_SRC:-}" ;;
  *) exit 0 ;;
esac
SH
  chmod +x "$pf_bin/chezmoi"
  pf_git=(git -c user.email=t@example.com -c user.name=Test -c init.defaultBranch=main -c commit.gpgsign=false)
  pf_out=""
  pf_run() { # want-exit  src  [src-fail]
    local want="$1" rc=0
    pf_out="$(PATH="$pf_bin:$PATH" PF_SRC="${2:-}" PF_SRC_FAIL="${3:-0}" bash "$pf_helper" 2>&1)" || rc=$?
    [[ "$rc" -eq "$want" ]] || {
      printf '%s\n' "$pf_out" >&2
      fail "preflight exit $rc, expected $want"
    }
  }
  # Fixtures: a seed repo with one commit, cloned so the clone tracks origin/main.
  "${pf_git[@]}" init -q "$pf_root/seed" || fail "preflight fixture: git init failed"
  (cd "$pf_root/seed" && "${pf_git[@]}" commit -q --allow-empty -m init) || fail "preflight fixture: seed commit failed"
  "${pf_git[@]}" clone -q "$pf_root/seed" "$pf_root/clone" 2>/dev/null || fail "preflight fixture: clone failed"
  # tracked main -> 0
  pf_run 0 "$pf_root/clone"
  # untracked feature branch -> 2, with the local-dev lane
  (cd "$pf_root/clone" && "${pf_git[@]}" checkout -q -b feature) || fail "preflight fixture: feature branch"
  pf_run 2 "$pf_root/clone"
  grep -qF 'has no upstream' <<<"$pf_out" || fail "untracked branch must be diagnosed as having no upstream"
  grep -qF 'chezmoi init' <<<"$pf_out" || fail "untracked branch must offer the init/apply lane"
  grep -qF 'push -u origin HEAD' <<<"$pf_out" || fail "untracked branch must suggest pushing HEAD to the single remote"
  # Behavioral no-mutation: running the preflight must not switch or change the repo.
  [[ "$("${pf_git[@]}" -C "$pf_root/clone" symbolic-ref --short HEAD)" == feature ]] \
    || fail "the preflight must be read-only (it changed the current branch)"
  # detached HEAD -> 2
  (cd "$pf_root/clone" && "${pf_git[@]}" checkout -q --detach) || fail "preflight fixture: detach"
  pf_run 2 "$pf_root/clone"
  grep -qiF 'detached' <<<"$pf_out" || fail "detached HEAD must be diagnosed as such"
  # configured upstream whose local remote-tracking ref is gone -> STILL 0 (not misclassified)
  (cd "$pf_root/clone" && "${pf_git[@]}" checkout -q main && "${pf_git[@]}" update-ref -d refs/remotes/origin/main) || fail "preflight fixture: gone upstream"
  pf_run 0 "$pf_root/clone"
  # untracked branch on a non-origin remote -> 2, guidance names that remote
  (cd "$pf_root/clone" && "${pf_git[@]}" remote rename origin upstream && "${pf_git[@]}" checkout -q -b feature2) || fail "preflight fixture: non-origin remote"
  pf_run 2 "$pf_root/clone"
  grep -qF 'push -u upstream HEAD' <<<"$pf_out" || fail "guidance must name the single configured remote"
  # source-path failure -> 1 (fail closed)
  pf_run 1 "" 1
  # non-Git source -> 1 (fail closed)
  mkdir -p "$pf_root/notgit"
  pf_run 1 "$pf_root/notgit"

}

validate_platform_terminal() {
  check "shell self-refresh waits for active jobs"
  shell_refresh_dir="$out_dir/shell-self-refresh"
  shell_refresh_zdot="$shell_refresh_dir/zdot"
  shell_refresh_bin="$shell_refresh_dir/bin"
  shell_refresh_zsh="$(command -v zsh 2>/dev/null || true)"
  [[ -n "$shell_refresh_zsh" ]] \
    || fail "the shell self-refresh fixture requires zsh"
  mkdir -p "$shell_refresh_zdot" "$shell_refresh_bin"
  render darwin false arm64 home/dot_zshrc.tmpl "$shell_refresh_zdot/.zshrc"
  cat >"$shell_refresh_bin/zsh" <<'SH'
#!/usr/bin/env bash
printf 'exec zsh\n' >>"$GROUNDWORK_REFRESH_EXEC_LOG"
SH
  chmod +x "$shell_refresh_bin/zsh"
  cat >"$shell_refresh_dir/scenario.zsh" <<'ZSH'
source "$ZDOTDIR/.zshrc"
PATH="$GROUNDWORK_REFRESH_STUB_BIN:/usr/bin:/bin"
/bin/sleep 30 &
job_pid=$!
print -r -- "$job_pid" >"$GROUNDWORK_REFRESH_JOB_PID_FILE"
/usr/bin/touch -t 203001010101 "$ZDOTDIR/.zshrc"
_groundwork_config_refresh_precmd
_groundwork_config_refresh_precmd
kill -0 "$job_pid" || exit 91
print -r -- JOB_ALIVE
kill "$job_pid"
wait "$job_pid" 2>/dev/null
_groundwork_config_refresh_precmd
exit 92
ZSH
  shell_refresh_exec_log="$shell_refresh_dir/exec-log"
  shell_refresh_job_pid_file="$shell_refresh_dir/job-pid"
  set +e
  PATH="$shell_refresh_bin:/usr/bin:/bin" \
    HOME="$shell_refresh_dir/home" ZDOTDIR="$shell_refresh_zdot" \
    GROUNDWORK_REFRESH_STUB_BIN="$shell_refresh_bin" \
    GROUNDWORK_REFRESH_EXEC_LOG="$shell_refresh_exec_log" \
    GROUNDWORK_REFRESH_JOB_PID_FILE="$shell_refresh_job_pid_file" \
    "$shell_refresh_zsh" -f "$shell_refresh_dir/scenario.zsh" \
    >"$shell_refresh_dir/out" 2>"$shell_refresh_dir/err"
  shell_refresh_status=$?
  set -e
  if [[ -f "$shell_refresh_job_pid_file" ]]; then
    shell_refresh_job_pid="$(<"$shell_refresh_job_pid_file")"
    kill "$shell_refresh_job_pid" 2>/dev/null || true
  fi
  [[ "$shell_refresh_status" -eq 0 ]] \
    || fail "the shell self-refresh fixture failed"
  grep -qxF 'JOB_ALIVE' "$shell_refresh_dir/out" \
    || fail "the refresh hook replaced a shell while its background job was alive"
  [[ "$(grep -cF 'reloads when background jobs finish' "$shell_refresh_dir/out")" -eq 1 ]] \
    || fail "the refresh hook must warn exactly once for one changed config mtime"
  [[ -f "$shell_refresh_exec_log" && "$(wc -l <"$shell_refresh_exec_log" | tr -d ' ')" -eq 1 ]] \
    || fail "the refresh hook must exec zsh once after the background job finishes"

  check "bracketed paste stays editable until explicit submit"
  paste_dir="$out_dir/bracketed-paste"
  paste_socket="groundwork-paste-$$"
  paste_marker="$paste_dir/submitted"
  paste_buffer="$paste_dir/buffer"
  paste_capture="$paste_dir/capture"
  paste_fail() {
    tmux -L "$paste_socket" kill-server 2>/dev/null || true
    fail "$1"
  }
  mkdir -p "$paste_dir"
  printf "printf 'PASTE-SUBMITTED\\n' >'%s'\n" "$paste_marker" >"$paste_buffer"
  tmux -L "$paste_socket" -f /dev/null new-session -d -x 100 -y 20 \
    "env PS1='GROUNDWORK-PASTE> ' zsh -f" \
    || paste_fail "the bracketed-paste fixture could not start an isolated zsh"
  for _ in {1..50}; do
    tmux -L "$paste_socket" capture-pane -p >"$paste_capture" 2>/dev/null || true
    grep -qF 'GROUNDWORK-PASTE>' "$paste_capture" && break
    sleep 0.05
  done
  grep -qF 'GROUNDWORK-PASTE>' "$paste_capture" \
    || paste_fail "the bracketed-paste fixture did not reach an interactive prompt"
  tmux -L "$paste_socket" load-buffer -b groundwork-paste "$paste_buffer" \
    || paste_fail "the bracketed-paste fixture could not load the observed command"
  tmux -L "$paste_socket" paste-buffer -p -b groundwork-paste -t 0 \
    || paste_fail "the bracketed-paste fixture could not paste through zsh's safety boundary"
  for _ in {1..50}; do
    tmux -L "$paste_socket" capture-pane -p >"$paste_capture" 2>/dev/null || true
    grep -qF 'PASTE-SUBMITTED' "$paste_capture" && break
    sleep 0.05
  done
  grep -qF 'PASTE-SUBMITTED' "$paste_capture" \
    || paste_fail "zsh did not display the pasted command for review"
  # Pane output can expose the pasted payload before zsh has consumed the
  # closing bracketed-paste marker. Round-trip a reversible sentinel through
  # normal ZLE editing so the later Enter cannot race that marker.
  paste_ready='GROUNDWORK_ZLE_READY'
  tmux -L "$paste_socket" send-keys -t 0 -l "$paste_ready" \
    || paste_fail "the bracketed-paste fixture could not probe normal editing"
  for _ in {1..50}; do
    tmux -L "$paste_socket" capture-pane -p >"$paste_capture" 2>/dev/null || true
    grep -qF "$paste_ready" "$paste_capture" && break
    sleep 0.05
  done
  grep -qF "$paste_ready" "$paste_capture" \
    || paste_fail "zsh did not return to normal editing after bracketed paste"
  for ((paste_key = 0; paste_key < ${#paste_ready}; paste_key++)); do
    tmux -L "$paste_socket" send-keys -t 0 BSpace \
      || paste_fail "the bracketed-paste fixture could not erase its editing probe"
  done
  for _ in {1..50}; do
    tmux -L "$paste_socket" capture-pane -p >"$paste_capture" 2>/dev/null || true
    ! grep -qF "$paste_ready" "$paste_capture" && break
    sleep 0.05
  done
  ! grep -qF "$paste_ready" "$paste_capture" \
    || paste_fail "the bracketed-paste editing probe was not erased"
  [[ ! -e "$paste_marker" ]] \
    || paste_fail "a pasted trailing newline executed without an explicit Enter"
  paste_shell_pid="$(tmux -L "$paste_socket" display-message -p -t 0 '#{pane_pid}')"
  paste_children="$(ps -axo ppid=,stat=,command= 2>/dev/null \
    | awk -v parent="$paste_shell_pid" '$1 == parent && $2 !~ /^Z/ { print }')"
  [[ -z "$paste_children" ]] \
    || paste_fail "an editable paste was misreported as a running child process: $paste_children"
  tmux -L "$paste_socket" send-keys -t 0 Enter \
    || paste_fail "the bracketed-paste fixture could not submit with explicit Enter"
  for _ in {1..50}; do
    [[ -f "$paste_marker" ]] && break
    sleep 0.05
  done
  [[ -f "$paste_marker" && "$(<"$paste_marker")" == 'PASTE-SUBMITTED' ]] \
    || paste_fail "explicit Enter did not execute the reviewed pasted command"
  tmux -L "$paste_socket" kill-server 2>/dev/null || true

  check "terminal copy model (effective tmux server + helper safety)"
  # Source greps accept a syntactically valid but wrong binding; assert the
  # EFFECTIVE behavior in a real isolated server, and prove the cwd helper cannot
  # be shell-injected. See specs/terminal-copy-model.md.
  test -x home/dot_local/bin/executable_tmux-copy-cwd \
    || fail "tmux-copy-cwd helper must exist and be executable"
  grep -qF 'bind C-y run-shell -b' home/dot_config/tmux/tmux.conf.tmpl \
    || fail "prefix+C-y must call the tmux-copy-cwd helper via run-shell -b"
  assert_no_matches "prefix+C-y must not interpolate the pane path through /bin/sh" \
    rg -n "set-buffer -w '#\{pane_current_path\}'" home/dot_config/tmux/tmux.conf.tmpl
  # Ghostty copy model differs by platform: explicit copy on macOS, selection
  # convention preserved on Linux. Render both and assert they diverge.
  gcfg_mac="$(chezmoi --config "$empty_config" --source "$PWD" --override-data '{"chezmoi":{"os":"darwin"}}' execute-template <home/dot_config/ghostty/config.tmpl)"
  gcfg_lin="$(chezmoi --config "$empty_config" --source "$PWD" --override-data '{"chezmoi":{"os":"linux"}}' execute-template <home/dot_config/ghostty/config.tmpl)"
  grep -qxF 'copy-on-select = false' <<<"$gcfg_mac" \
    || fail "Ghostty on macOS must set copy-on-select = false (explicit copy)"
  grep -qxF 'copy-on-select = true' <<<"$gcfg_lin" \
    || fail "Ghostty on Linux must keep copy-on-select = true (selection convention)"
  grep -qxF 'mouse-shift-capture = never' <<<"$gcfg_lin" \
    || fail "mouse-shift-capture = never must apply on every platform"
  if command -v tmux >/dev/null 2>&1; then
    tcm_dir="$out_dir/terminal-copy-model"
    mkdir -p "$tcm_dir"
    chezmoi --config "$empty_config" --source "$PWD" \
      --override-data '{"headless":false,"chezmoi":{"os":"darwin"}}' \
      execute-template <home/dot_config/tmux/tmux.conf.tmpl >"$tcm_dir/full.conf" 2>/dev/null \
      || fail "tmux.conf.tmpl must render"
    grep -vE "run '.*tpm'|@plugin|@continuum|@resurrect|@catppuccin|@vim_navigator|source-file .*plugins|catppuccin|status-left|status-right|status-interval" \
      "$tcm_dir/full.conf" >"$tcm_dir/core.conf"
    tcm_sock="groundwork-tcm-$$"
    if tmux -L "$tcm_sock" -f "$tcm_dir/core.conf" new-session -d -x 80 -y 24 2>"$tcm_dir/err"; then
      [[ "$(tmux -L "$tcm_sock" show -sv set-clipboard)" == external ]] \
        || fail "set-clipboard must resolve to external in a live server"
      [[ "$(tmux -L "$tcm_sock" show -gv allow-passthrough)" == off ]] \
        || fail "allow-passthrough must be off globally (pane-scoped for yazi via the y function)"
      tmux -L "$tcm_sock" show -gv update-environment | grep -qw TERM_PROGRAM \
        || fail "update-environment must propagate TERM_PROGRAM for yazi"
      # Drag-release copies (tmux's own default), so Cmd+C-after-drag muscle
      # memory is not silently swallowed — amended 2026-07-26, superseding the
      # persistent-selection decision (specs/terminal-copy-model.md). Asserting the
      # ACTION, not merely that the key is bound: a bare `bind` to the wrong
      # command would otherwise pass.
      tmux -L "$tcm_sock" list-keys -T copy-mode-vi 2>/dev/null \
        | grep -qE 'MouseDragEnd1Pane .*copy-selection-and-cancel' \
        || fail "MouseDragEnd1Pane must copy-selection-and-cancel in copy-mode-vi (drag copies on release)"
      # The keyboard path must survive the mouse convenience, or the taught model
      # (keys first) quietly stops being true.
      tmux -L "$tcm_sock" list-keys -T copy-mode-vi 2>/dev/null \
        | grep -qE '^bind-key +-T copy-mode-vi +v +send-keys -X begin-selection' \
        || fail "copy-mode-vi v must still begin-selection (keyboard path)"
      tmux -L "$tcm_sock" list-keys -T copy-mode-vi 2>/dev/null \
        | grep -qE '^bind-key +-T copy-mode-vi +y +send-keys -X copy-selection-and-cancel' \
        || fail "copy-mode-vi y must still copy-selection-and-cancel (keyboard path)"
      tmux -L "$tcm_sock" list-keys -T root 2>/dev/null | grep -qw MouseDown3Pane \
        || fail "the conditional right-click (MouseDown3Pane) must be bound"
      tmux -L "$tcm_sock" list-keys -T root 2>/dev/null | grep -qw M-MouseDown3Pane \
        || fail "the Option+right-click pane menu (M-MouseDown3Pane) must be bound"
      # Stale tmux-yank keys must be cleared so an upgraded live server drops the
      # external pbcopy path.
      if tmux -L "$tcm_sock" list-keys -T prefix 2>/dev/null | grep -qE ' -T prefix +y '; then
        fail "stale tmux-yank prefix y binding must be cleared"
      fi
      if tmux -L "$tcm_sock" list-keys -T copy-mode-vi 2>/dev/null | grep -qE ' -T copy-mode-vi +M-y '; then
        fail "stale tmux-yank copy-mode-vi M-y binding must be cleared"
      fi
      # BEHAVIOR, not just the key table: drive the exact copy-mode action over
      # known pane text and assert the paste buffer holds it. A binding can name
      # the right command and still copy the wrong region.
      tmux -L "$tcm_sock" send-keys "printf 'COPYPROBE-ALPHA\\n'" Enter
      sleep 0.3
      tmux -L "$tcm_sock" copy-mode
      tmux -L "$tcm_sock" send-keys -X search-backward COPYPROBE-ALPHA
      tmux -L "$tcm_sock" send-keys -X begin-selection
      tmux -L "$tcm_sock" send-keys -X end-of-line
      tmux -L "$tcm_sock" send-keys -X copy-selection-and-cancel
      tcm_buffer="$(tmux -L "$tcm_sock" show-buffer 2>/dev/null || true)"
      case "$tcm_buffer" in
        *COPYPROBE-ALPHA*) ;;
        *) fail "copy-selection-and-cancel must place the selected pane text in the tmux buffer (got: ${tcm_buffer:-<empty>})" ;;
      esac
      # …and it must leave copy mode, or the pane stays frozen after a drag.
      [[ "$(tmux -L "$tcm_sock" display-message -p '#{pane_in_mode}')" == 0 ]] \
        || fail "copy-selection-and-cancel must exit copy mode (pane left in mode)"
      tmux -L "$tcm_sock" kill-server 2>/dev/null || true

      # Convergence on an ALREADY-RUNNING server that carries the previous
      # unbind. This is why the config states the binding explicitly instead of
      # deleting the old `unbind`: a fresh server passes either way, so only this
      # fixture catches a future "just remove the unbind" regression.
      tcm_legacy="groundwork-tcm-legacy-$$"
      if tmux -L "$tcm_legacy" -f /dev/null new-session -d -x 80 -y 24 2>/dev/null; then
        tmux -L "$tcm_legacy" unbind-key -T copy-mode-vi MouseDragEnd1Pane 2>/dev/null || true
        if tmux -L "$tcm_legacy" list-keys -T copy-mode-vi 2>/dev/null | grep -qw MouseDragEnd1Pane; then
          tmux -L "$tcm_legacy" kill-server 2>/dev/null || true
          fail "legacy fixture must START with drag-release unbound, or it proves nothing"
        fi
        tmux -L "$tcm_legacy" source-file "$tcm_dir/core.conf" 2>/dev/null || true
        tmux -L "$tcm_legacy" list-keys -T copy-mode-vi 2>/dev/null \
          | grep -qE 'MouseDragEnd1Pane .*copy-selection-and-cancel' \
          || fail "sourcing the config into a server that carries the old unbind must restore drag-release copy"
        tmux -L "$tcm_legacy" kill-server 2>/dev/null || true
      else
        fail "legacy convergence fixture must start a tmux server"
      fi
    else
      fail "rendered tmux copy-model config must parse in a live server: $(cat "$tcm_dir/err")"
    fi
  fi
  # Injection safety (hermetic, no real server needed): a pane path full of shell
  # metacharacters must be handled as DATA. A stub tmux returns a hostile path from
  # display-message; the helper must copy it literally and NEVER execute it.
  cwd_helper="$PWD/home/dot_local/bin/executable_tmux-copy-cwd"
  stub="$out_dir/tmux-copy-cwd-stub"
  mkdir -p "$stub/bin"
  # shellcheck disable=SC2016,SC2006 # the metacharacters are literal attack payload, not expansions
  hostile_value='evil$(touch INJECTED-CMD)`touch INJECTED-BT`;${z};#end'
  printf '%s' "$hostile_value" >"$stub/hostile"
  cat >"$stub/bin/tmux" <<'STUB'
#!/usr/bin/env bash
case "$1" in
  display-message) [[ "$*" == *pane_current_path* ]] && cat "$STUB_HOSTILE" ;;
  load-buffer) cat > "$STUB_LOADED" ;;
  *) : ;;
esac
exit 0
STUB
  chmod +x "$stub/bin/tmux"
  (
    cd "$stub" || exit 0
    PATH="$stub/bin:$PATH" TMUX=fake STUB_HOSTILE="$stub/hostile" STUB_LOADED="$stub/loaded" \
      bash "$cwd_helper" '%9' 'c0' >/dev/null 2>&1 || true
  )
  if [[ -e "$stub/INJECTED-CMD" || -e "$stub/INJECTED-BT" ]]; then
    fail "tmux-copy-cwd executed shell code embedded in the pane path (injection)"
  fi
  [[ "$(cat "$stub/loaded" 2>/dev/null)" == "$hostile_value" ]] \
    || fail "tmux-copy-cwd must copy the pane path literally (got: '$(cat "$stub/loaded" 2>/dev/null)')"

}

validate_static_runtime() {
  check "shell prompt convention (bootstrap and brew repair)"
  # Groundwork's own shell prompts follow one convention: a bracketed affordance
  # with the default capitalized, a blocking read on the controlling terminal
  # even when stdin is a pipe (curl | bash), Enter takes the default, and a run
  # with no terminal at all takes the default and says so. The seams
  # (GROUNDWORK_BOOTSTRAP_SELFTEST, GROUNDWORK_PROMPT_TTY) let this drive the
  # real helpers without a real terminal.
  grep -qF '[KEEP/switch/login]' bootstrap-mac.sh \
    || fail "the bootstrap GitHub prompt must keep its bracketed affordance with the capitalized default"
  prompt_fixture="$out_dir/prompt-fixture"
  mkdir -p "$prompt_fixture/bin"
  # 1. No terminal anywhere: the default is taken and announced, not silent.
  printf '' | GROUNDWORK_BOOTSTRAP_SELFTEST=prompt GROUNDWORK_PROMPT_TTY=/nonexistent-groundwork-tty \
    /bin/bash bootstrap-mac.sh "GitHub account choice [KEEP/switch/login]: " keep \
    >"$prompt_fixture/no-tty-out" 2>"$prompt_fixture/no-tty-err" \
    || fail "the bootstrap prompt helper failed outright without a terminal"
  grep -qxF 'keep' "$prompt_fixture/no-tty-out" \
    || fail "without any terminal the bootstrap prompt must return the default"
  grep -qF 'no terminal' "$prompt_fixture/no-tty-err" \
    || fail "without any terminal the bootstrap prompt must say it has no terminal"
  grep -qF 'defaulting to "keep"' "$prompt_fixture/no-tty-err" \
    || fail "without any terminal the bootstrap prompt must name the default it takes"
  # 2. Enter takes the default (the controlling-terminal seam delivers a bare newline).
  printf '\n' >"$prompt_fixture/tty-enter"
  printf '' | GROUNDWORK_BOOTSTRAP_SELFTEST=prompt GROUNDWORK_PROMPT_TTY="$prompt_fixture/tty-enter" \
    /bin/bash bootstrap-mac.sh "GitHub account choice [KEEP/switch/login]: " keep \
    >"$prompt_fixture/enter-out" 2>/dev/null \
    || fail "the bootstrap prompt helper failed on a bare Enter"
  grep -qxF 'keep' "$prompt_fixture/enter-out" \
    || fail "a bare Enter must take the prompt default"
  # 3. A typed answer on the controlling terminal wins even when stdin is a pipe.
  printf 'switch\n' >"$prompt_fixture/tty-switch"
  printf '' | GROUNDWORK_BOOTSTRAP_SELFTEST=prompt GROUNDWORK_PROMPT_TTY="$prompt_fixture/tty-switch" \
    /bin/bash bootstrap-mac.sh "GitHub account choice [KEEP/switch/login]: " keep \
    >"$prompt_fixture/switch-out" 2>/dev/null \
    || fail "the bootstrap prompt helper failed reading the controlling terminal"
  grep -qxF 'switch' "$prompt_fixture/switch-out" \
    || fail "an answer typed on the controlling terminal must win over the default"

  # groundwork-brew-repair keeps the same convention around its [y/N] gate.
  cat >"$prompt_fixture/bin/brew" <<'SH'
#!/usr/bin/env bash
if [[ "${1:-}" == "fetch" ]]; then
  printf 'brew %s conc=%s\n' "$*" "${HOMEBREW_DOWNLOAD_CONCURRENCY:-unset}" >>"$GROUNDWORK_TEST_LOG"
else
  printf 'brew %s\n' "$*" >>"$GROUNDWORK_TEST_LOG"
fi
exit "${GROUNDWORK_TEST_BREW_STATUS:-0}"
SH
  chmod +x "$prompt_fixture/bin/brew"
  repair_log="$prompt_fixture/bundle.log"
  cat >"$repair_log" <<'EOF'
Error: some formula is in a known-broken state
Please run the following commands and try again:
  brew update
EOF
  repair_cmd_log="$prompt_fixture/repair-commands.log"
  # No terminal: default N (skip), said explicitly, exit nonzero, nothing runs.
  : >"$repair_cmd_log"
  set +e
  printf '' | env PATH="$prompt_fixture/bin:/usr/bin:/bin" GROUNDWORK_TEST_LOG="$repair_cmd_log" \
    GROUNDWORK_PROMPT_TTY=/nonexistent-groundwork-tty \
    /bin/bash home/dot_local/bin/executable_groundwork-brew-repair "$repair_log" \
    >"$prompt_fixture/repair-no-tty" 2>&1
  repair_status=$?
  set -e
  [[ "$repair_status" -eq 2 ]] \
    || fail "brew-repair without a terminal must exit 2 (declined), got $repair_status"
  grep -qF 'no terminal; defaulting to N (skip)' "$prompt_fixture/repair-no-tty" \
    || fail "brew-repair must name the default it takes when no terminal exists"
  test ! -s "$repair_cmd_log" || fail "brew-repair ran commands without consent"
  # Enter takes the default: N (skip).
  printf '\n' >"$prompt_fixture/tty-repair-enter"
  : >"$repair_cmd_log"
  set +e
  printf '' | env PATH="$prompt_fixture/bin:/usr/bin:/bin" GROUNDWORK_TEST_LOG="$repair_cmd_log" \
    GROUNDWORK_PROMPT_TTY="$prompt_fixture/tty-repair-enter" \
    /bin/bash home/dot_local/bin/executable_groundwork-brew-repair "$repair_log" \
    >"$prompt_fixture/repair-enter" 2>&1
  repair_status=$?
  set -e
  [[ "$repair_status" -eq 2 ]] \
    || fail "a bare Enter must take the [y/N] default and exit 2 (declined), got $repair_status"
  grep -qF 'skipped' "$prompt_fixture/repair-enter"
  test ! -s "$repair_cmd_log" || fail "brew-repair ran commands on a bare Enter"
  # y on the controlling terminal runs exactly the suggested commands — and the
  # log may carry ANSI color now that update-all forces brew color through the
  # tee, so the colored variant must parse identically.
  repair_esc="$(printf '\033')"
  printf '%s[31mError:%s[0m some formula is in a known-broken state\nPlease run the following commands and try again:\n  brew update\n' \
    "$repair_esc" "$repair_esc" >"$prompt_fixture/bundle-colored.log"
  printf 'y\n' >"$prompt_fixture/tty-repair-yes"
  for repair_variant in "$repair_log" "$prompt_fixture/bundle-colored.log"; do
    : >"$repair_cmd_log"
    printf '' | env PATH="$prompt_fixture/bin:/usr/bin:/bin" GROUNDWORK_TEST_LOG="$repair_cmd_log" \
      GROUNDWORK_PROMPT_TTY="$prompt_fixture/tty-repair-yes" \
      /bin/bash home/dot_local/bin/executable_groundwork-brew-repair "$repair_variant" \
      >"$prompt_fixture/repair-yes" 2>&1 \
      || fail "brew-repair must succeed after consent on $repair_variant"
    grep -qxF 'brew update' "$repair_cmd_log" \
      || fail "brew-repair must run exactly the suggested command from $repair_variant"
  done
  # The per-cask "cannot be upgraded as-is" warning is the second remediation
  # shape Homebrew prints. It does NOT fail the run, so unhandled it repeats on
  # every refresh forever; repeated warnings must dedupe to one command.
  cat >"$prompt_fixture/cask-warning.log" <<'EOF'
Warning: The cask 'dotnet-sdk' cannot be upgraded as-is. To fix this, run:
  brew reinstall --cask --force dotnet-sdk
==> Upgraded 3 outdated packages
Warning: The cask 'dotnet-sdk' cannot be upgraded as-is. To fix this, run:
  brew reinstall --cask --force dotnet-sdk
EOF
  : >"$repair_cmd_log"
  printf '' | env PATH="$prompt_fixture/bin:/usr/bin:/bin" GROUNDWORK_TEST_LOG="$repair_cmd_log" \
    GROUNDWORK_PROMPT_TTY="$prompt_fixture/tty-repair-yes" \
    /bin/bash home/dot_local/bin/executable_groundwork-brew-repair "$prompt_fixture/cask-warning.log" \
    >"$prompt_fixture/repair-cask" 2>&1 \
    || fail "brew-repair must handle the cask cannot-be-upgraded-as-is warning"
  diff -u <(printf 'brew reinstall --cask --force dotnet-sdk\n') "$repair_cmd_log" \
    || fail "brew-repair must run the deduplicated cask fix exactly once"
  # An APPROVED repair whose command fails must exit 3 — callers must be able
  # to tell "the fix you consented to failed" apart from "nothing to do", or a
  # broken machine gets reported as a successful update.
  set +e
  printf '' | env PATH="$prompt_fixture/bin:/usr/bin:/bin" GROUNDWORK_TEST_LOG="$repair_cmd_log" \
    GROUNDWORK_TEST_BREW_STATUS=1 GROUNDWORK_PROMPT_TTY="$prompt_fixture/tty-repair-yes" \
    /bin/bash home/dot_local/bin/executable_groundwork-brew-repair "$repair_log" \
    >"$prompt_fixture/repair-failed" 2>&1
  repair_status=$?
  set -e
  [[ "$repair_status" -eq 3 ]] \
    || fail "an approved repair that failed must exit 3 (attempted and failed), got $repair_status"
  grep -qF 'FAILED at' "$prompt_fixture/repair-failed" \
    || fail "a failed approved repair must say which command failed"
  # A recognized marker whose suggested command is not a plain brew invocation
  # must exit 4 and run NOTHING.
  cat >"$prompt_fixture/malformed.log" <<'EOF'
Please run the following commands and try again:
  rm -rf /somewhere
EOF
  : >"$repair_cmd_log"
  set +e
  printf '' | env PATH="$prompt_fixture/bin:/usr/bin:/bin" GROUNDWORK_TEST_LOG="$repair_cmd_log" \
    GROUNDWORK_PROMPT_TTY="$prompt_fixture/tty-repair-yes" \
    /bin/bash home/dot_local/bin/executable_groundwork-brew-repair "$prompt_fixture/malformed.log" \
    >/dev/null 2>&1
  repair_status=$?
  set -e
  [[ "$repair_status" -eq 4 ]] \
    || fail "a non-brew suggestion must exit 4 (malformed), got $repair_status"
  test ! -s "$repair_cmd_log" || fail "brew-repair ran a command from a malformed suggestion"

  # groundwork-brew-refetch: curl's ordinary --retry does not cover the
  # curl-92 stream errors from the field transcript, so failed downloads get a
  # targeted, serial re-fetch — and ONLY the failed ones.
  cat >"$prompt_fixture/refetch.log" <<'EOF'
✘ Cask chatgpt (26.715.31925)
Error: Download failed on Cask 'chatgpt' with message: curl: (92) HTTP/2 stream 1 was not closed cleanly: PROTOCOL_ERROR (err 1)
✔︎ Cask zed (1.11.3)
✘ Cask whatsapp (26.28.22)
✘ Bottle atuin (18.17.1)
EOF
  : >"$repair_cmd_log"
  env PATH="$prompt_fixture/bin:/usr/bin:/bin" GROUNDWORK_TEST_LOG="$repair_cmd_log" \
    /bin/bash home/dot_local/bin/executable_groundwork-brew-refetch "$prompt_fixture/refetch.log" \
    >/dev/null 2>&1 \
    || fail "brew-refetch must exit 0 when every failed download re-fetches"
  diff -u <(printf 'brew fetch --retry --cask chatgpt conc=1\nbrew fetch --retry --cask whatsapp conc=1\nbrew fetch --retry --formula atuin conc=1\n') "$repair_cmd_log" \
    || fail "brew-refetch must re-fetch exactly the failed artifacts, serially (concurrency 1)"
  printf 'everything succeeded\n' >"$prompt_fixture/refetch-clean.log"
  set +e
  env PATH="$prompt_fixture/bin:/usr/bin:/bin" GROUNDWORK_TEST_LOG="$repair_cmd_log" \
    /bin/bash home/dot_local/bin/executable_groundwork-brew-refetch "$prompt_fixture/refetch-clean.log" \
    >/dev/null 2>&1
  repair_status=$?
  set -e
  [[ "$repair_status" -eq 1 ]] \
    || fail "brew-refetch with no failed downloads must exit 1, got $repair_status"
  set +e
  env PATH="$prompt_fixture/bin:/usr/bin:/bin" GROUNDWORK_TEST_LOG="$repair_cmd_log" \
    GROUNDWORK_TEST_BREW_STATUS=1 \
    /bin/bash home/dot_local/bin/executable_groundwork-brew-refetch "$prompt_fixture/refetch.log" \
    >/dev/null 2>&1
  repair_status=$?
  set -e
  [[ "$repair_status" -eq 2 ]] \
    || fail "brew-refetch must exit 2 when a re-fetch still fails, got $repair_status"
  # Both brew stages feed the repair helper their logs and retry curl on
  # transient CDN stream errors; losing either wiring brings back the
  # repeats-forever cask warning and the one-shot download failures.
  grep -qF 'HOMEBREW_CURL_RETRIES=3' home/run_onchange_after_10-brew-bundle.sh.tmpl \
    || fail "the brew bundle hook must export HOMEBREW_CURL_RETRIES"
  grep -qF 'HOMEBREW_CURL_RETRIES=3' home/dot_local/bin/executable_groundwork-update-run.tmpl \
    || fail "the update runner must export HOMEBREW_CURL_RETRIES"
  grep -qF "groundwork-brew-repair\" \"\$lane_log\"" home/dot_local/bin/executable_groundwork-update-run.tmpl \
    || fail "the update runner must feed the active lane log to groundwork-brew-repair"
  grep -qF "groundwork-brew-repair\" \"\$bundle_log\"" home/run_onchange_after_10-brew-bundle.sh.tmpl \
    || fail "the brew bundle hook must feed the bundle log to groundwork-brew-repair"
  grep -qF "groundwork-brew-refetch\" \"\$lane_log\"" home/dot_local/bin/executable_groundwork-update-run.tmpl \
    || fail "the update runner must feed the active failed lane to groundwork-brew-refetch"
  grep -qF "groundwork-brew-refetch\" \"\$bundle_log\"" home/run_onchange_after_10-brew-bundle.sh.tmpl \
    || fail "the brew bundle hook must feed failed downloads to groundwork-brew-refetch"
  # Both callers must treat repair exit 3 (approved but FAILED) as a failure —
  # never fold it into "nothing to do".
  grep -qF "\"\$repair_status\" -eq 3" home/dot_local/bin/executable_groundwork-update-run.tmpl \
    || fail "the update runner must handle repair exit 3 (approved repair failed)"
  grep -qF "\"\$repair_status\" -eq 3" home/run_onchange_after_10-brew-bundle.sh.tmpl \
    || fail "the brew bundle hook must handle repair exit 3 (approved repair failed)"

  # A cancelled Homebrew stage must stop the caller, never fall through into
  # repair, refetch, and a retry — those prompt or start more Homebrew work
  # against a terminal the person just asked to have back. update-all's runner
  # proves this behaviorally above; assert the same ORDERING in both callers so
  # the guard cannot be moved below the repair call or lose a status.
  #
  # 124 hard deadline · 125 unconfirmed cancellation · 129/130/143 HUP/INT/TERM.
  for cancel_caller in \
    home/dot_local/bin/executable_groundwork-update-run.tmpl \
    home/run_onchange_after_10-brew-bundle.sh.tmpl; do
    grep -qF '124 | 125 | 129 | 130 | 143)' "$cancel_caller" \
      || fail "$cancel_caller does not treat every cancellation status as cancellation"
    awk '
      /^[[:space:]]*#/ { next }
      /124 \| 125 \| 129 \| 130 \| 143\)/ { if (!guard) guard = NR }
      /\$HOME\/\.local\/bin\/groundwork-brew-repair"/ { if (!repair) repair = NR }
      END { exit !(guard && repair && guard < repair) }
    ' "$cancel_caller" \
      || fail "$cancel_caller runs the Homebrew repair before its cancellation guard"
  done

  check "Homebrew cask policy (rendered installer behavior)"
  # The NETWORK audit (scripts/audit-brew-casks) owns upstream cask metadata.
  # THIS owns profile resolution and the bounded installer, offline and
  # deterministically. Stable remains the preview compatibility fallback.
  browser_current="$out_dir/browser-current"
  browser_preview="$out_dir/browser-preview"
  browser_managed="$out_dir/browser-managed"
  browser_headless="$out_dir/browser-headless"
  render darwin false arm64 home/dot_config/homebrew/Brewfile.browser.tmpl "$browser_current" \
    false false false false bitwarden personal-current personal current
  render darwin false arm64 home/dot_config/homebrew/Brewfile.browser.tmpl "$browser_preview" \
    false false false false bitwarden personal-preview personal preview
  render darwin false arm64 home/dot_config/homebrew/Brewfile.browser.tmpl "$browser_managed" \
    true false false false 1password work-managed managed current
  render darwin true arm64 home/dot_config/homebrew/Brewfile.browser.tmpl "$browser_headless" \
    false false false false none personal-current personal current

  grep -qxF 'cask "google-chrome"' "$browser_current" \
    || fail "Personal Current must select Chrome stable"
  assert_not_contains 'google-chrome@beta' "$browser_current" \
    "Personal Current selected Chrome Beta"
  diff -u <(printf 'cask "google-chrome"\ncask "google-chrome@beta"\n') \
    <(grep '^cask ' "$browser_preview") \
    || fail "Personal Preview must select Chrome Beta with stable retained first"
  grep -qxF 'cask "google-chrome"' "$browser_managed" \
    || fail "Work Managed must select Chrome stable"
  assert_not_contains 'google-chrome@beta' "$browser_managed" \
    "Work Managed selected a preview browser"
  assert_not_contains '^cask ' "$browser_headless" \
    "a headless Mac selected a GUI browser"

  browser_extensions="$out_dir/browser-extensions"
  render darwin false arm64 home/dot_local/bin/executable_browser-extensions.tmpl "$browser_extensions" \
    false false false false bitwarden personal-current personal current
  /bin/bash -n "$browser_extensions"
  browser_extensions_out="$(GROUNDWORK_BROWSER_EXTENSIONS_CATALOG="$PWD/home/dot_local/share/groundwork/browser-extensions.tsv" \
    /bin/bash "$browser_extensions")"
  grep -qF 'chrome' <<<"$browser_extensions_out" \
    || fail "the browser extension helper must continue to list Chrome links"
  browser_extensions_rc=0
  GROUNDWORK_BROWSER_EXTENSIONS_CATALOG="$PWD/home/dot_local/share/groundwork/browser-extensions.tsv" \
    /bin/bash "$browser_extensions" --browser unsupported >/dev/null 2>&1 || browser_extensions_rc=$?
  [[ "$browser_extensions_rc" -eq 2 ]] \
    || fail "the browser extension helper must reject an unsupported browser target"

  chrome_current="$out_dir/brew-bundle-chrome-current"
  chrome_preview="$out_dir/brew-bundle-chrome-preview"
  render darwin false arm64 home/run_onchange_after_10-brew-bundle.sh.tmpl "$chrome_current" \
    false false false false bitwarden personal-current personal current
  render darwin false arm64 home/run_onchange_after_10-brew-bundle.sh.tmpl "$chrome_preview" \
    false false false false bitwarden personal-preview personal preview
  /bin/bash -n "$chrome_current"
  /bin/bash -n "$chrome_preview"

  # A legacy install_chrome answer is tolerated and ignored. It cannot disable
  # or widen the posture-selected browser set, and regeneration preserves it.
  render_legacy_chrome() {
    chezmoi --config "$empty_config" --source "$PWD" --destination "$out_dir/home" \
      --override-data "{${base_data},\"work\":false,\"headless\":false,\"xcode\":false,\"beta\":false,\"install_chrome\":$1,\"chezmoi\":{\"os\":\"darwin\",\"arch\":\"arm64\"}}" \
      execute-template <home/run_onchange_after_10-brew-bundle.sh.tmpl >"$2"
  }
  render_legacy_chrome false "$out_dir/chrome-legacy-false"
  render_legacy_chrome true "$out_dir/chrome-legacy-true"
  cmp -s "$out_dir/chrome-legacy-false" "$out_dir/chrome-legacy-true" \
    || fail "the obsolete install_chrome field still changes browser behavior"

  grep -qF "HOMEBREW_CASK_OPTS=\"\$safe_cask_opts\"" "$chrome_current" \
    || fail "brew bundle must run under the --require-sha cask policy"
  grep -qF -- '--require-sha' "$chrome_current"
  # Noninteractive runs still use a classified pipe, while interactive macOS
  # runs keep Homebrew attached to a PTY. Color therefore keys on the run-wide
  # GROUNDWORK_COLOR signal (with a TTY fallback for a direct apply).
  grep -qF 'GROUNDWORK_COLOR' "$chrome_current" \
    || fail "the brew bundle stage must key color on the run-wide GROUNDWORK_COLOR signal"
  grep -qF 'export HOMEBREW_COLOR=1' "$chrome_current" \
    || fail "the brew bundle stage must preserve Homebrew color when the color signal is on"
  grep -qF "gw_brew_run_logged \"\$bundle_log\" \"\$bundle_receipt\" reset \"Homebrew bundle\" --" "$chrome_current" \
    || fail "the brew bundle stage must preserve terminal ownership through the bounded Homebrew runner"
  grep -qF 'brew bundle install --no-upgrade --verbose' "$chrome_current" \
    || fail "chezmoi apply must install missing Brewfile entries without upgrading existing casks"
  [[ "$(grep -cF 'brew bundle install --no-upgrade --verbose' "$chrome_current")" -eq 2 ]] \
    || fail "the initial Homebrew bundle and its retry must share the install-only policy"
  assert_not_contains "gw_brew_classify_stream \"\\\$bundle_log\"" \
    "$chrome_current" \
    "brew bundle bypassed the terminal-preserving Homebrew runner"
  # The user's own cask options are preserved, never replaced.
  grep -qF "user_cask_opts=\"\${HOMEBREW_CASK_OPTS-}\"" "$chrome_current" \
    || fail "the user's HOMEBREW_CASK_OPTS must be preserved, not overwritten"
  grep -qF "HOMEBREW_CASK_OPTS=\"\$user_cask_opts\" brew install --cask \"\$browser_cask\"" "$chrome_current" \
    || fail "the Chrome exception must run under the USER's cask options"
  # Ordering: a failed safe lane must never reach the unsafe exception lane.
  chrome_exit_line="$(grep -n "exit \"\$bundle_status\"" "$chrome_current" | head -n 1 | cut -d: -f1)"
  chrome_install_line="$(grep -nF "brew install --cask \"\$browser_cask\"" "$chrome_current" | head -n 1 | cut -d: -f1)"
  ((chrome_exit_line < chrome_install_line)) \
    || fail "google-chrome is installed BEFORE the bundle-failure exit — a failed safe lane must not trigger the unsafe lane"
  # A conflicting user policy is a real failure, not a silent skip that never retries.
  grep -qF 'this apply is incomplete' "$chrome_current" \
    || fail "a user --require-sha policy conflict must fail explicitly, not disappear"
  grep -qF 'unsupported browser manifest entry' "$chrome_current" \
    || fail "the browser installer must reject any manifest entry outside its exact allowlist"

  # Chrome exceptions must never enter the checksum-safe Brewfile.
  for chrome_profile in 'false false' 'true false' 'false true'; do
    read -r chrome_work chrome_game <<<"$chrome_profile"
    render darwin false arm64 home/dot_config/homebrew/Brewfile.tmpl \
      "$out_dir/brewfile-chrome-$chrome_work-$chrome_game" "$chrome_work"
    assert_not_contains '^cask "google-chrome(@beta)?"' "$out_dir/brewfile-chrome-$chrome_work-$chrome_game" \
      "a Chrome exception is in the checksum-safe Brewfile (work=$chrome_work)"
  done

  # The retired browser contract is repository-wide and red-proven against a
  # hostile scratch tree. No application, profile, preference, documentation,
  # migration, or deletion target may reclaim that ownership accidentally.
  scripts/check-retired-browser >/dev/null
  retired_fixture="$out_dir/retired-browser-hostile"
  mkdir -p "$retired_fixture"
  retired_name='ze''n'
  printf 'cask "%s"\n' "$retired_name" >"$retired_fixture/Brewfile"
  if scripts/check-retired-browser "$retired_fixture" >/dev/null 2>&1; then
    fail "the retired-browser guard accepted a reintroduced cask"
  fi

  check "runtime release-age reporting"
  # A cooldown filters what you ACQUIRE; it never rolls back what is already
  # installed. Nothing else surfaces a runtime adopted inside the floor, so this
  # check must actually fire — and it must read the release date from the tool's
  # backend, NOT from mise's upgrade warning, which only appears when mise's
  # version cache happens to be cold (a check that passes by luck is not a check).
  grep -qF 'GROUNDWORK_RELEASE_FLOOR' home/dot_local/bin/executable_groundwork-doctor
  assert_no_matches "the runtime age check must not depend on mise's cache-dependent upgrade warning" \
    rg -n 'minimum_release_age' home/dot_local/bin/executable_groundwork-doctor
  # The doctor's floor and the floor update-all enforces must agree.
  grep -qF -- '--minimum-release-age 5d' home/dot_local/bin/executable_groundwork-update-run.tmpl
  grep -qF 'GROUNDWORK_RELEASE_FLOOR:-5d' home/dot_local/bin/executable_groundwork-doctor \
    || fail "groundwork-doctor's release floor must match the 5d floor update-all enforces"

  runtime_fixture="$out_dir/runtime-fixture"
  mkdir -p "$runtime_fixture/bin"
  cat >"$runtime_fixture/bin/mise" <<'SH'
#!/usr/bin/env bash
if [[ "$1" == "upgrade" && "$2" == "--help" ]]; then
  echo "      --minimum-release-age <MINIMUM_RELEASE_AGE>"
  exit 0
fi
if [[ "$1" == "ls" ]]; then
  printf '%s\n' "$GROUNDWORK_TEST_MISE_JSON"
fi
SH
  chmod +x "$runtime_fixture/bin/mise"
  # A version released two days ago must be flagged, with the remedy named.
  runtime_recent="$(jq -rn '(now - (2 * 86400)) | todateiso8601')"
  cat >"$runtime_fixture/bin/curl" <<SH
#!/usr/bin/env bash
printf '{"time":{"9.9.9":"%s"}}\n' "$runtime_recent"
SH
  chmod +x "$runtime_fixture/bin/curl"
  PATH="$runtime_fixture/bin:$PATH" \
    GROUNDWORK_TEST_MISE_JSON='{"pnpm":[{"version":"9.9.9","active":true}]}' \
    /bin/bash home/dot_local/bin/executable_groundwork-doctor --runtimes \
    >"$out_dir/doctor-runtimes-young" 2>&1
  grep -qF 'younger than the 5d release floor' "$out_dir/doctor-runtimes-young" \
    || fail "the doctor did not flag a runtime adopted inside the release floor"
  grep -qF 'mise use -g pnpm@' "$out_dir/doctor-runtimes-young" \
    || fail "the doctor must name the command that pins a vetted version"
  grep -qF 'never rolls back what you already have' "$out_dir/doctor-runtimes-young" \
    || fail "the doctor must explain WHY the floor did not fix this by itself"
  # A version past the floor must NOT be flagged.
  runtime_old="$(jq -rn '(now - (30 * 86400)) | todateiso8601')"
  cat >"$runtime_fixture/bin/curl" <<SH
#!/usr/bin/env bash
printf '{"time":{"9.9.9":"%s"}}\n' "$runtime_old"
SH
  chmod +x "$runtime_fixture/bin/curl"
  PATH="$runtime_fixture/bin:$PATH" \
    GROUNDWORK_TEST_MISE_JSON='{"pnpm":[{"version":"9.9.9","active":true}]}' \
    /bin/bash home/dot_local/bin/executable_groundwork-doctor --runtimes \
    >"$out_dir/doctor-runtimes-old" 2>&1
  assert_not_contains 'younger than' "$out_dir/doctor-runtimes-old" \
    "the doctor flagged a runtime that is past the release floor"
  grep -qF 'past the 5d floor' "$out_dir/doctor-runtimes-old"

  check "shell runtime ownership"
  # Groundwork owns the interactive zsh runtime: Homebrew installs it, update-all
  # upgrades it, and adoption is an explicit step that never touches the OS shell.
  grep -qF 'brew "zsh"' home/dot_config/homebrew/Brewfile.tmpl
  test -x home/dot_local/bin/executable_groundwork-shell-adopt
  # Never hard-code a Homebrew prefix: it differs on Apple Silicon, Intel, and
  # Linuxbrew. Resolve it with brew --prefix.
  # Fact-gathering lives in ONE shared read-only library. Three private copies had
  # already drifted into security-relevant differences (one executed the candidate
  # zsh before proving Homebrew owned it; another consumed its one-shot state
  # without checking ownership at all), so the duplication is guarded against.
  shell_lib=home/dot_local/share/groundwork/lib/shell-runtime.sh
  test -f "$shell_lib"
  for shell_consumer in home/dot_local/bin/executable_groundwork-shell-adopt \
    home/dot_local/bin/executable_groundwork-doctor \
    home/run_after_99-shell-adopt-notice.sh; do
    grep -qF 'lib/shell-runtime.sh' "$shell_consumer" \
      || fail "$shell_consumer must use the shared shell-runtime probe, not its own copy"
    assert_no_matches "shell-runtime facts must come from the shared probe, not a private reimplementation ($shell_consumer)" \
      rg -n 'dscl \. -read|brew --prefix zsh' "$shell_consumer"
  done
  grep -qF 'brew --prefix' "$shell_lib"
  # The probe must never run the candidate binary to identify it — that is exactly
  # what a replaced binary wants. Only gw_managed_zsh_version (gated on proven
  # ownership) may execute it.
  grep -qF 'gw_managed_zsh_version' "$shell_lib"
  grep -qF 'GW_OWNERSHIP' "$shell_lib"
  assert_no_matches "Homebrew prefix must be resolved, not hard-coded (Intel and Linuxbrew differ)" \
    rg -n '/opt/homebrew|/home/linuxbrew' home/dot_local/bin/executable_groundwork-shell-adopt "$shell_lib"
  assert_no_matches "Groundwork must never modify or remove the OS fallback shell" \
    rg -n 'rm .*(/bin/zsh|/bin/sh)|mv .*/bin/zsh' home/dot_local/bin/executable_groundwork-shell-adopt
  # An installer must never re-exec the shell the user is sitting in.
  assert_no_matches "shell adoption must not exec over the user's running shell" \
    rg -n '^[[:space:]]*exec[[:space:]]+[$"/]' home/dot_local/bin/executable_groundwork-shell-adopt

  adopt_fixture="$out_dir/shell-adopt"
  mkdir -p "$adopt_fixture/bin" "$adopt_fixture/brew-prefix/bin" "$adopt_fixture/state" \
    "$adopt_fixture/nobrew-bin"
  # Fake managed zsh, OS fallback, and the account-record + chsh + sudo surface.
  # The managed path is a SYMLINK into the Cellar, exactly as Homebrew installs it:
  # adoption must prove the stable path resolves into Homebrew's zsh formula, not
  # merely that something executable sits there.
  mkdir -p "$adopt_fixture/brew-prefix/Cellar/zsh/5.9.2/bin"
  printf '#!/bin/sh\necho "zsh 5.9.2 (fixture)"\n' >"$adopt_fixture/brew-prefix/Cellar/zsh/5.9.2/bin/zsh"
  chmod +x "$adopt_fixture/brew-prefix/Cellar/zsh/5.9.2/bin/zsh"
  ln -sf "$adopt_fixture/brew-prefix/Cellar/zsh/5.9.2/bin/zsh" "$adopt_fixture/brew-prefix/bin/zsh"
  # A stray, non-Homebrew binary at the same stable path — must NOT be adopted.
  printf '#!/bin/sh\necho "zsh 9.9 (impostor)"\n' >"$adopt_fixture/impostor-zsh"
  printf '#!/bin/sh\necho "zsh 5.9 (os-fixture)"\n' >"$adopt_fixture/os-zsh"
  chmod +x "$adopt_fixture/impostor-zsh" "$adopt_fixture/os-zsh"
  cat >"$adopt_fixture/bin/brew" <<SH
#!/usr/bin/env bash
# Models Homebrew's ownership surface: --prefix, --prefix zsh, list --versions.
case "\${1:-}" in
  --prefix)
    if [[ "\${2:-}" == "zsh" ]]; then
      [[ "\${BREW_OWNS_ZSH:-1}" == "1" ]] || exit 1
      echo "$adopt_fixture/brew-prefix/Cellar/zsh/5.9.2"
    else
      echo "$adopt_fixture/brew-prefix"
    fi
    ;;
  list)
    [[ "\${BREW_OWNS_ZSH:-1}" == "1" ]] || exit 1
    echo "zsh 5.9.2"
    ;;
esac
SH
  cat >"$adopt_fixture/bin/chsh" <<SH
#!/usr/bin/env bash
printf 'chsh %s\n' "\$*" >>"$adopt_fixture/state/log"
[[ "\${CHSH_STATUS:-0}" == "0" ]] || exit "\$CHSH_STATUS"
# CHSH_NOOP models the nasty case: chsh exits 0 but the account never changes.
[[ "\${CHSH_NOOP:-0}" == "1" ]] && exit 0
# A real chsh updates the account record; the fixture records it the same way.
printf '%s\n' "\$2" >"$adopt_fixture/state/login-shell"
SH
  # dscl is the macOS account-record reader; the fixture answers from state.
  cat >"$adopt_fixture/bin/dscl" <<SH
#!/usr/bin/env bash
printf 'UserShell: %s\n' "\$(cat "$adopt_fixture/state/login-shell" 2>/dev/null)"
SH
  cat >"$adopt_fixture/bin/sudo" <<'SH'
#!/usr/bin/env bash
"$@"
SH
  chmod +x "$adopt_fixture/bin/brew" "$adopt_fixture/bin/chsh" "$adopt_fixture/bin/dscl" "$adopt_fixture/bin/sudo"
  # The "Homebrew is gone" PATH keeps the account-record surface (chsh/dscl/sudo)
  # and drops only brew — otherwise the test would exercise the real chsh.
  for adopt_tool in chsh dscl sudo; do
    ln -sf "$adopt_fixture/bin/$adopt_tool" "$adopt_fixture/nobrew-bin/$adopt_tool"
  done
  adopt_zsh="$adopt_fixture/brew-prefix/bin/zsh"
  adopt_shells="$adopt_fixture/state/shells"
  adopt_state="$adopt_fixture/state/groundwork"
  adopt_previous="$adopt_state/previous-login-shell"
  # The user's real previous shell — deliberately NOT zsh, because on Linux and
  # WSL2 it is usually bash. Reverting must restore this exact shell, not a
  # guessed platform default.
  adopt_prev_shell="$adopt_fixture/os-bash"
  printf '#!/bin/sh\necho "GNU bash, version 5.2 (os-fixture)"\n' >"$adopt_prev_shell"
  chmod +x "$adopt_prev_shell"
  adopt_env=(
    PATH="$adopt_fixture/bin:/usr/bin:/bin"
    GROUNDWORK_SHELL_LIB="$PWD/home/dot_local/share/groundwork/lib/shell-runtime.sh"
    GROUNDWORK_LOGIN_SHELL_FILE="$adopt_fixture/state/login-shell"
    GROUNDWORK_SHELLS_FILE="$adopt_shells"
    GROUNDWORK_STATE_DIR="$adopt_state"
  )
  adopt_reset() {
    rm -rf "$adopt_state"
    # A real login shell is registered in the shells file — chsh requires it —
    # so the fixture models that.
    printf '/bin/sh\n%s\n' "$adopt_prev_shell" >"$adopt_shells"
    printf '%s\n' "$adopt_prev_shell" >"$adopt_fixture/state/login-shell"
    : >"$adopt_fixture/state/log"
  }

  # The intermediate tmux copy must never touch the clipboard or the buffer stack:
  # without -C -P, tmux pushes the RAW selection (uncapped, unheadered) to the
  # system clipboard before any of the safety logic runs.
  grep -qF 'copy-pipe-and-cancel -C -P' home/dot_local/bin/executable_tmux-copy-last \
    || fail "the intermediate copy must use -C -P (no clipboard, no paste buffer)"
  # The final buffer must target the invoking client, or tmux guesses which
  # terminal gets the clipboard.
  grep -qF "load_args+=(-t \"\$client\")" home/dot_local/bin/executable_tmux-copy-last \
    || fail "the final load-buffer must target the invoking client"
  # Byte accounting must use wc -c, never ${#var} (which counts characters under a
  # UTF-8 locale and would blow the byte cap on emoji/CJK paths).
  assert_no_matches "byte accounting must use wc -c, not character counts" \
    rg -n '\$\{#(header|notice|head_part)\}' home/dot_local/bin/executable_tmux-copy-last
  grep -qF 'LC_ALL=C awk' home/dot_local/bin/executable_tmux-copy-last \
    || fail "the tail budget must run under LC_ALL=C so awk length() counts bytes"

  # Migration from the user's own shell: records it, registers the managed zsh,
  # chsh's, verifies the account record, and says how to switch this terminal.
  adopt_reset
  env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    >"$out_dir/shell-adopt-migrate" 2>&1 \
    || {
      sed 's/^/    /' "$out_dir/shell-adopt-migrate" >&2
      fail "groundwork-shell-adopt failed to migrate from the user's shell"
    }
  grep -qF "chsh -s $adopt_zsh" "$adopt_fixture/state/log" \
    || fail "groundwork-shell-adopt did not chsh to the managed zsh"
  grep -qxF "$adopt_zsh" "$adopt_shells" \
    || fail "groundwork-shell-adopt did not register the managed zsh in the shells file"
  grep -qxF "$adopt_prev_shell" "$adopt_previous" \
    || fail "groundwork-shell-adopt did not record the previous login shell"
  grep -qF 'exec' "$out_dir/shell-adopt-migrate" \
    || fail "groundwork-shell-adopt must tell the user how to switch the current terminal"
  grep -qF 'revert' "$out_dir/shell-adopt-migrate" \
    || fail "groundwork-shell-adopt must state the undo path"
  test -x "$adopt_prev_shell" || fail "the user's previous shell must never be modified"

  # Idempotent: a second run neither duplicates the shells entry, re-chsh's, nor
  # overwrites the recorded previous shell with the managed zsh.
  : >"$adopt_fixture/state/log"
  env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    >"$out_dir/shell-adopt-again" 2>&1
  [[ "$(grep -cxF "$adopt_zsh" "$adopt_shells")" -eq 1 ]] \
    || fail "groundwork-shell-adopt duplicated the shells-file entry"
  test ! -s "$adopt_fixture/state/log" \
    || fail "groundwork-shell-adopt ran chsh again when the shell was already adopted"
  grep -qxF "$adopt_prev_shell" "$adopt_previous" \
    || fail "a rerun overwrote the recorded previous login shell"
  grep -qF 'already' "$out_dir/shell-adopt-again"

  # Already adopted but the managed zsh's registration was lost (a system update
  # can rewrite the shells file): repair it instead of reporting all-clear.
  printf '/bin/sh\n%s\n' "$adopt_prev_shell" >"$adopt_shells"
  : >"$adopt_fixture/state/log"
  env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    >"$out_dir/shell-adopt-repair" 2>&1
  grep -qxF "$adopt_zsh" "$adopt_shells" \
    || fail "groundwork-shell-adopt did not repair a lost shells-file registration"

  # --status changes nothing, and never calls $SHELL "this process".
  : >"$adopt_fixture/state/log"
  env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt --status \
    >"$out_dir/shell-adopt-status" 2>&1
  test ! -s "$adopt_fixture/state/log" || fail "groundwork-shell-adopt --status changed the login shell"
  grep -qF "$adopt_zsh" "$out_dir/shell-adopt-status"
  grep -qF 'login shell' "$out_dir/shell-adopt-status"

  # --revert restores the recorded previous shell (bash here), not a guessed zsh,
  # and verifies the account record afterwards.
  : >"$adopt_fixture/state/log"
  env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt --revert \
    >"$out_dir/shell-adopt-revert" 2>&1 \
    || fail "groundwork-shell-adopt --revert failed"
  grep -qF "chsh -s $adopt_prev_shell" "$adopt_fixture/state/log" \
    || fail "--revert did not restore the recorded previous shell"

  # Recovery must not need Homebrew — that is the incident it exists for.
  printf '%s\n' "$adopt_zsh" >"$adopt_fixture/state/login-shell"
  : >"$adopt_fixture/state/log"
  env PATH="$adopt_fixture/nobrew-bin:/usr/bin:/bin" \
    GROUNDWORK_SHELL_LIB="$PWD/home/dot_local/share/groundwork/lib/shell-runtime.sh" \
    GROUNDWORK_LOGIN_SHELL_FILE="$adopt_fixture/state/login-shell" \
    GROUNDWORK_SHELLS_FILE="$adopt_shells" GROUNDWORK_STATE_DIR="$adopt_state" \
    /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt --revert \
    >"$out_dir/shell-revert-nobrew" 2>&1 \
    || fail "groundwork-shell-adopt --revert failed without Homebrew — the escape hatch must work when brew is gone"
  grep -qF "chsh -s $adopt_prev_shell" "$adopt_fixture/state/log" \
    || fail "--revert without Homebrew did not restore the previous shell"
  # --status must survive a missing Homebrew too.
  env PATH="$adopt_fixture/nobrew-bin:/usr/bin:/bin" \
    GROUNDWORK_SHELL_LIB="$PWD/home/dot_local/share/groundwork/lib/shell-runtime.sh" \
    GROUNDWORK_LOGIN_SHELL_FILE="$adopt_fixture/state/login-shell" \
    GROUNDWORK_SHELLS_FILE="$adopt_shells" GROUNDWORK_STATE_DIR="$adopt_state" \
    /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt --status \
    >"$out_dir/shell-status-nobrew" 2>&1 \
    || fail "groundwork-shell-adopt --status failed without Homebrew"

  # No recorded previous shell: refuse to guess, and name the explicit escape.
  adopt_reset
  printf '%s\n' "$adopt_zsh" >"$adopt_fixture/state/login-shell"
  if env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt --revert \
    >"$out_dir/shell-revert-norecord" 2>&1; then
    fail "--revert guessed a shell when no previous one was recorded"
  fi
  grep -qF -- '--revert-to' "$out_dir/shell-revert-norecord" \
    || fail "--revert must point at --revert-to when it has nothing recorded"
  # --revert-to restores an explicit shell.
  : >"$adopt_fixture/state/log"
  env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    --revert-to "$adopt_prev_shell" >"$out_dir/shell-revert-to" 2>&1 \
    || fail "--revert-to failed"
  grep -qF "chsh -s $adopt_prev_shell" "$adopt_fixture/state/log"

  # chsh succeeds but the account record does not change: never claim success.
  adopt_reset
  if env "${adopt_env[@]}" CHSH_NOOP=1 /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    >"$out_dir/shell-adopt-noop" 2>&1; then
    fail "groundwork-shell-adopt reported success although the account record never changed"
  fi
  grep -qF 'still' "$out_dir/shell-adopt-noop"

  # A failed/interrupted chsh must not claim success and must not move the shell.
  adopt_reset
  if env "${adopt_env[@]}" CHSH_STATUS=1 /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    >"$out_dir/shell-adopt-chsh-fail" 2>&1; then
    fail "groundwork-shell-adopt reported success after chsh failed"
  fi
  grep -qxF "$adopt_prev_shell" "$adopt_fixture/state/login-shell" \
    || fail "a failed chsh must leave the login shell unchanged"

  # Ownership, not mere existence: a binary at the managed path that Homebrew does
  # not own must never be adopted as "Groundwork-managed".
  adopt_reset
  if env "${adopt_env[@]}" BREW_OWNS_ZSH=0 /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    >"$out_dir/shell-adopt-unowned" 2>&1; then
    fail "groundwork-shell-adopt adopted a zsh that Homebrew does not own"
  fi
  grep -qF 'not Homebrew' "$out_dir/shell-adopt-unowned"
  test ! -s "$adopt_fixture/state/log" || fail "an unowned zsh still reached chsh"

  # The recovery invariant: never change the login shell without a durable,
  # readable rollback record. An unusable current shell must refuse adoption.
  adopt_reset
  printf '\n' >"$adopt_fixture/state/login-shell"
  if env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    >"$out_dir/shell-adopt-noprev" 2>&1; then
    fail "groundwork-shell-adopt adopted without a usable previous shell to record"
  fi
  grep -qF 'No account change was attempted' "$out_dir/shell-adopt-noprev"
  test ! -s "$adopt_fixture/state/log" || fail "adoption ran chsh with no rollback recorded"
  # A state directory that cannot be written must also refuse.
  adopt_reset
  if env PATH="$adopt_fixture/bin:/usr/bin:/bin" GROUNDWORK_SHELLS_FILE="$adopt_shells" \
    GROUNDWORK_SHELL_LIB="$PWD/home/dot_local/share/groundwork/lib/shell-runtime.sh" \
    GROUNDWORK_LOGIN_SHELL_FILE="$adopt_fixture/state/login-shell" \
    GROUNDWORK_STATE_DIR=/proc/nonexistent-groundwork-state \
    /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    >"$out_dir/shell-adopt-nostate" 2>&1; then
    fail "groundwork-shell-adopt adopted although the rollback record could not be written"
  fi
  grep -qF 'Refusing to adopt' "$out_dir/shell-adopt-nostate"

  # A failing account-directory lookup (dscl/getent down) must not kill the
  # command silently under set -e: status still reports, revert and adopt refuse
  # with an explanation rather than vanishing.
  adopt_reset
  cat >"$adopt_fixture/bin/dscl" <<SH
#!/usr/bin/env bash
printf 'UserShell: %s\n' "\$(cat "$adopt_fixture/state/login-shell" 2>/dev/null)"
SH
  chmod +x "$adopt_fixture/bin/dscl"
  env "${adopt_env[@]}" GROUNDWORK_LOGIN_SHELL_FILE="$adopt_fixture/state/no-such-record" \
    /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt --status \
    >"$out_dir/shell-status-brokendir" 2>&1 \
    || fail "--status died silently when the account directory was unreadable"
  test -s "$out_dir/shell-status-brokendir" \
    || fail "--status printed nothing when the account directory was unreadable"
  if env "${adopt_env[@]}" GROUNDWORK_LOGIN_SHELL_FILE="$adopt_fixture/state/no-such-record" \
    /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt --revert \
    >"$out_dir/shell-revert-brokendir" 2>&1; then
    fail "--revert proceeded although the account's current login shell was unreadable"
  fi
  grep -qF 'No account change was attempted' "$out_dir/shell-revert-brokendir"
  # --revert-to routes through the same guard, so it must NOT be offered as the
  # way out of an unreadable account record — every change is verified against
  # that record, which is precisely what is broken.
  assert_not_contains 'revert-to <shell>' "$out_dir/shell-revert-brokendir" \
    "a broken account lookup must not recommend --revert-to, which hits the same guard"
  if env "${adopt_env[@]}" GROUNDWORK_LOGIN_SHELL_FILE="$adopt_fixture/state/no-such-record" \
    /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    --revert-to "$adopt_prev_shell" >"$out_dir/shell-revertto-brokendir" 2>&1; then
    fail "--revert-to proceeded although the account record was unreadable (the result could not be verified)"
  fi
  test ! -s "$adopt_fixture/state/log" || fail "--revert-to ran chsh with an unverifiable account record"

  # An unreadable shells file must fail closed, not skip the membership check and
  # call chsh anyway.
  adopt_reset
  printf '%s\n' "$adopt_zsh" >"$adopt_fixture/state/login-shell"
  if env "${adopt_env[@]}" GROUNDWORK_SHELLS_FILE="$adopt_fixture/state/missing-shells" \
    /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt --revert-to "$adopt_prev_shell" \
    >"$out_dir/shell-revertto-noshells" 2>&1; then
    fail "--revert-to proceeded although the shells file was unreadable"
  fi
  grep -qF 'unreadable' "$out_dir/shell-revertto-noshells"
  test ! -s "$adopt_fixture/state/log" || fail "--revert-to ran chsh without verifying shells-file membership"
  if env "${adopt_env[@]}" GROUNDWORK_LOGIN_SHELL_FILE="$adopt_fixture/state/no-such-record" \
    /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    >"$out_dir/shell-adopt-brokendir" 2>&1; then
    fail "adoption proceeded although the account's current login shell was unreadable"
  fi
  grep -qF 'No account change was attempted' "$out_dir/shell-adopt-brokendir"
  test ! -s "$adopt_fixture/state/log" || fail "a broken account lookup still reached chsh"

  # Conflicting or malformed options are errors, not last-flag-wins.
  adopt_reset
  if env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    --status --revert >"$out_dir/shell-adopt-conflict" 2>&1; then
    fail "groundwork-shell-adopt accepted conflicting modes"
  fi
  grep -qF 'mutually exclusive' "$out_dir/shell-adopt-conflict"
  if env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    --revert-to 'relative/zsh' >"$out_dir/shell-adopt-relative" 2>&1; then
    fail "--revert-to accepted a relative path"
  fi
  grep -qF 'absolute path' "$out_dir/shell-adopt-relative"
  # EVERY control character, including the newline — grep would never match that
  # one, because it splits its input on newlines in the first place.
  for ctrl_case in newline:$'/bin/ba\nsh' cr:$'/bin/ba\rsh' tab:$'/bin/ba\tsh' \
    esc:$'/bin/ba\x1bsh' del:$'/bin/ba\x7fsh'; do
    ctrl_name="${ctrl_case%%:*}"
    ctrl_value="${ctrl_case#*:}"
    if env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
      --revert-to "$ctrl_value" >"$out_dir/shell-adopt-ctrl-$ctrl_name" 2>&1; then
      fail "--revert-to accepted a shell path containing an embedded $ctrl_name"
    fi
    grep -qF 'control characters' "$out_dir/shell-adopt-ctrl-$ctrl_name"
  done
  # --revert and --revert-to both mean "revert", so exclusivity must key on the
  # OPTION the user typed, not the resulting mode.
  if env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    --revert --revert-to /bin/sh >"$out_dir/shell-adopt-bothrevert" 2>&1; then
    fail "--revert and --revert-to were accepted together"
  fi
  grep -qF 'mutually exclusive' "$out_dir/shell-adopt-bothrevert"

  # A missing shared probe must be an explained failure for adoption, and must NOT
  # take out the doctor's unrelated Docker diagnostics.
  if env "${adopt_env[@]}" GROUNDWORK_SHELL_LIB=/nonexistent-groundwork-lib \
    /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt --status \
    >"$out_dir/shell-adopt-nolib" 2>&1; then
    fail "groundwork-shell-adopt ran without its shell-runtime probe"
  fi
  grep -qF 'shell-runtime probe is missing' "$out_dir/shell-adopt-nolib"
  env GROUNDWORK_SHELL_LIB=/nonexistent-groundwork-lib \
    GROUNDWORK_LOGIN_SHELL_FILE="$adopt_fixture/state/login-shell" \
    /bin/bash home/dot_local/bin/executable_groundwork-doctor --shell \
    >"$out_dir/doctor-nolib" 2>&1 \
    || fail "groundwork-doctor --shell crashed instead of reporting the missing probe"
  grep -qF 'shell-runtime probe is missing' "$out_dir/doctor-nolib"
  env GROUNDWORK_SHELL_LIB=/nonexistent-groundwork-lib \
    /bin/bash home/dot_local/bin/executable_groundwork-doctor --docker \
    >"$out_dir/doctor-nolib-docker" 2>&1 \
    || fail "a missing shell probe broke the doctor's unrelated Docker section"

  # An unowned binary at the stable path must never be summarized as "Groundwork's
  # zsh is your login shell" — path equality is not ownership.
  adopt_reset
  printf '%s\n' "$adopt_zsh" >"$adopt_fixture/state/login-shell"
  env "${adopt_env[@]}" BREW_OWNS_ZSH=0 /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    --status >"$out_dir/shell-status-unowned" 2>&1
  assert_not_contains "Groundwork's verified Homebrew zsh is your login shell" "$out_dir/shell-status-unowned" \
    "--status called an unowned binary Groundwork's zsh"
  grep -qF 'NOT a verified Homebrew zsh' "$out_dir/shell-status-unowned" \
    || fail "--status must say the login shell's binary is unverified"

  # Adoption itself does need Homebrew: refuse clearly, change nothing.
  adopt_reset
  if env PATH="$adopt_fixture/nobrew-bin:/usr/bin:/bin" GROUNDWORK_SHELLS_FILE="$adopt_shells" \
    GROUNDWORK_SHELL_LIB="$PWD/home/dot_local/share/groundwork/lib/shell-runtime.sh" \
    GROUNDWORK_LOGIN_SHELL_FILE="$adopt_fixture/state/login-shell" \
    GROUNDWORK_STATE_DIR="$adopt_state" \
    /bin/bash home/dot_local/bin/executable_groundwork-shell-adopt \
    >"$out_dir/shell-adopt-nobrew" 2>&1; then
    fail "groundwork-shell-adopt proceeded without Homebrew"
  fi
  grep -qF 'Homebrew is not available' "$out_dir/shell-adopt-nobrew"
  test ! -s "$adopt_fixture/state/log" || fail "a Homebrew-less adopt still ran chsh"

  # The doctor reports the runtime read-only, distinguishes failure states, and
  # never labels $SHELL as the running process.
  grep -qF 'shell_section' home/dot_local/bin/executable_groundwork-doctor
  assert_no_matches "groundwork-doctor must not present \$SHELL as the invoking process" \
    rg -n 'this process:.*SHELL' home/dot_local/bin/executable_groundwork-doctor
  adopt_reset
  env "${adopt_env[@]}" /bin/bash home/dot_local/bin/executable_groundwork-doctor --shell \
    >"$out_dir/doctor-shell" 2>&1
  grep -qF 'Shell runtime' "$out_dir/doctor-shell"
  # The green "managed zsh" line may only appear AFTER ownership is proven — and
  # the candidate must never be executed before that, or a replaced binary gets
  # run by the very command meant to identify it.
  grep -qF 'managed zsh: Homebrew owns it' "$out_dir/doctor-shell" \
    || fail "the doctor must confirm Homebrew ownership, not just that a zsh exists"
  # A zsh at the stable path that Homebrew does NOT own must never be called
  # "managed", and must not be executed.
  adopt_reset
  if env "${adopt_env[@]}" BREW_OWNS_ZSH=0 /bin/bash home/dot_local/bin/executable_groundwork-doctor --shell \
    >"$out_dir/doctor-unowned" 2>&1; then :; fi
  assert_not_contains 'ok +managed zsh' "$out_dir/doctor-unowned" \
    "the doctor called an unowned binary 'managed zsh'"
  grep -qF 'ownership is not established' "$out_dir/doctor-unowned" \
    || fail "the doctor must say ownership is not established for an unowned zsh"
  grep -qF 'login shell (account)' "$out_dir/doctor-shell"
  grep -qF 'invoking process' "$out_dir/doctor-shell"
  grep -qF 'groundwork-shell-adopt' "$out_dir/doctor-shell" \
    || fail "groundwork-doctor must name the adoption command when the login shell is not the managed zsh"
  # A damaged Homebrew is something a diagnostic reports, not something it dies on.
  mkdir -p "$adopt_fixture/badbrew-bin"
  printf '#!/bin/sh\nexit 1\n' >"$adopt_fixture/badbrew-bin/brew"
  chmod +x "$adopt_fixture/badbrew-bin/brew"
  env PATH="$adopt_fixture/badbrew-bin:/usr/bin:/bin" GROUNDWORK_SHELLS_FILE="$adopt_shells" \
    GROUNDWORK_SHELL_LIB="$PWD/home/dot_local/share/groundwork/lib/shell-runtime.sh" \
    GROUNDWORK_LOGIN_SHELL_FILE="$adopt_fixture/state/login-shell" \
    GROUNDWORK_STATE_DIR="$adopt_state" \
    /bin/bash home/dot_local/bin/executable_groundwork-doctor --shell \
    >"$out_dir/doctor-shell-badbrew" 2>&1 \
    || fail "groundwork-doctor crashed on a damaged Homebrew instead of reporting it"
  grep -qF 'damaged' "$out_dir/doctor-shell-badbrew"

  # The one-time adoption notice: shown once interactively, never again, and
  # never when the shell is already adopted.
  notice_state="$adopt_fixture/notice-state"
  printf '%s\n' "$adopt_prev_shell" >"$adopt_fixture/state/login-shell"
  env "${adopt_env[@]}" GROUNDWORK_STATE_DIR="$notice_state" GROUNDWORK_REMINDER_ASSUME_TTY=1 \
    /bin/bash home/run_after_99-shell-adopt-notice.sh >"$out_dir/adopt-notice" 2>&1
  grep -qF 'groundwork-shell-adopt' "$out_dir/adopt-notice" \
    || fail "the adoption notice must name the command"
  env "${adopt_env[@]}" GROUNDWORK_STATE_DIR="$notice_state" GROUNDWORK_REMINDER_ASSUME_TTY=1 \
    /bin/bash home/run_after_99-shell-adopt-notice.sh >"$out_dir/adopt-notice-2" 2>&1
  test ! -s "$out_dir/adopt-notice-2" || fail "the adoption notice repeated after being shown"
  # Noninteractive: say nothing and stay pending.
  rm -rf "$notice_state"
  env "${adopt_env[@]}" GROUNDWORK_STATE_DIR="$notice_state" \
    /bin/bash home/run_after_99-shell-adopt-notice.sh >"$out_dir/adopt-notice-tty" 2>&1
  test ! -s "$out_dir/adopt-notice-tty" || fail "the adoption notice printed to a non-terminal"
  test ! -e "$notice_state/shell-adopt-notice-shown" \
    || fail "a noninteractive run consumed the adoption notice"

  check "annotation escaping"
  # Toolkit-exact, and byte-for-byte what @roost/ci-diagnostics renders for the
  # same inputs (its src/vectors.json is the shared case list). % escapes first,
  # so the % introduced by the CR/LF escapes is not escaped again; CR/LF become
  # %0D/%0A rather than spaces, which keeps the annotation multi-line-faithful.
  [[ "$(annotation_escape_message $'50% done\r\n::error fake::injected')" == '50%25 done%0D%0A::error fake::injected' ]] \
    || fail "annotation message escaping changed for %, CR, LF, or embedded workflow-command text"
  [[ "$(annotation_escape_title $'rendered zsh: a,b\r\nc % ::set-output')" == 'rendered zsh%3A a%2Cb%0D%0Ac %25 %3A%3Aset-output' ]] \
    || fail "annotation title escaping changed for colon, comma, %, or control characters"
  # A pre-escaped sequence must not be double-unescaped back into a real newline.
  [[ "$(annotation_escape_message '%0A is a literal, not a newline')" == '%250A is a literal, not a newline' ]] \
    || fail "annotation escaping must not let a literal %0A survive as a real escape"
  # U+2028/U+2029 end a line for the runner's command parser exactly like LF.
  [[ "$(annotation_escape_message $'before\342\200\250::error title=x::y\342\200\251after')" == 'before%0A::error title=x::y%0Aafter' ]] \
    || fail "U+2028/U+2029 must escape to %0A, or content could open a new line"
  # The property that makes the escaping injection-safe, asserted directly rather
  # than inferred from the strings above: a workflow command is only recognized at
  # the start of a line, and no escaped output can contain a line break at all.
  ann_hostile="$(annotation_escape_title $'x\r\n::error fake::injected\342\200\250::notice a::b')"
  [[ "$ann_hostile" != *$'\n'* && "$ann_hostile" != *$'\r'* && "$ann_hostile" != *$'\342\200\250'* ]] \
    || fail "escaped annotation content kept a line break, so an injected ::error could start its own line"

  # The 500-code-point display cap, matching @roost/ci-diagnostics'
  # WORKFLOW_COMMAND_MAX_LENGTH: at the cap, unchanged; over it, 499 kept plus an
  # ellipsis marker.
  ann_a500="$(printf '%500s' '' | tr ' ' a)"
  ann_a499="${ann_a500:0:499}"
  ann_a498="${ann_a500:0:498}"
  [[ "$(annotation_escape_message "$ann_a500")" == "$ann_a500" ]] \
    || fail "an annotation message exactly at the 500-code-point cap must not be truncated"
  [[ "$(annotation_escape_message "${ann_a500}x")" == "${ann_a499}…" ]] \
    || fail "an over-long annotation message must truncate to 499 code points plus an ellipsis"
  [[ "$(annotation_escape_title "${ann_a500}x")" == "${ann_a499}…" ]] \
    || fail "an over-long annotation title must truncate to 499 code points plus an ellipsis"
  # CODE POINTS, not bytes. The rocket sits at code point 499 — the last character
  # the cap keeps — but at BYTE 499 of the payload, so a byte-wise cut would slice
  # it in half and emit a broken character. bash only counts code points under a
  # UTF-8 locale, which is why annotation_cap resolves one.
  ann_rocket=$'\360\237\232\200'
  [[ "$(annotation_escape_message "${ann_a498}${ann_rocket}zz")" == "${ann_a498}${ann_rocket}…" ]] \
    || fail "the annotation cap split a multibyte character (it must count code points, not bytes)"
  # And with no UTF-8 locale on the machine at all, bash counts bytes: the cap then
  # backs off the partial character rather than emitting half of it. Stricter than
  # the contract (the whole rocket is dropped), never broken output.
  ann_no_utf8="$(
    annotation_utf8_locale=""
    annotation_escape_message "${ann_a498}${ann_rocket}zz"
  )"
  [[ "$ann_no_utf8" == "${ann_a498}…" ]] \
    || fail "without a UTF-8 locale the annotation cap must drop the partial character, not split it"

}

validate_platform_tmux() {
  check "tmux-copy-last helper"
  test -x home/dot_local/bin/executable_tmux-copy-last
  # The OSC 133 prompt mark must be part of PROMPT, not emitted from a precmd
  # hook: zle redraws the prompt line and wipes a mark written before the
  # redraw, so a precmd version silently records no marks at all.
  grep -qF '133;A' home/dot_zshrc.tmpl
  grep -qF "PROMPT=\"%{\${_groundwork_osc133_mark}%}\${PROMPT}\"" home/dot_zshrc.tmpl
  # Idempotency must be by inspecting PROMPT, not a "already ran" flag: starship's
  # init replaces PROMPT on every source, so a flag would skip the re-add and
  # leave the shell with no marks at all.
  grep -qF "\"\$PROMPT\" != *\"\$_groundwork_osc133_mark\"*" home/dot_zshrc.tmpl
  assert_no_matches "OSC 133 prompt marks must live in PROMPT, not a precmd hook (zle's redraw wipes them)" \
    rg -n 'add-zsh-hook precmd .*osc133' home/dot_zshrc.tmpl
  # Outside tmux, with no target pane, it refuses — no server needed.
  if TMUX='' /bin/bash home/dot_local/bin/executable_tmux-copy-last >"$out_dir/copylast-notmux" 2>&1; then
    fail "tmux-copy-last ran outside tmux"
  fi
  grep -qF 'not inside tmux' "$out_dir/copylast-notmux"
  # The suite needs tmux 3.6+ — the version tmux-copy-last itself requires, since
  # the -C/-P copy flags are what keep the raw selection off the clipboard. An
  # older tmux cannot exercise the real contract. A skip must never be invisible:
  # GROUNDWORK_REQUIRE_TMUX=1 (set on the macOS CI job, which supplies a current
  # tmux) turns "cannot test" into a failure.
  tmux_suite_version=""
  tmux_suite_ok=0
  if command -v tmux >/dev/null 2>&1; then
    tmux_suite_version="$(tmux -V 2>/dev/null | awk '{print $2}')"
    suite_major="${tmux_suite_version%%.*}"
    suite_minor="${tmux_suite_version#*.}"
    suite_minor="${suite_minor%%[!0-9]*}"
    if [[ "$suite_major" =~ ^[0-9]+$ && "$suite_minor" =~ ^[0-9]+$ ]] \
      && ((suite_major > 3 || (suite_major == 3 && suite_minor >= 6))); then
      tmux_suite_ok=1
    fi
  fi
  if ((tmux_suite_ok == 0)); then
    if [[ "${GROUNDWORK_REQUIRE_TMUX:-0}" == "1" ]]; then
      fail "the tmux-copy-last behavior suite requires tmux 3.6+ (found: ${tmux_suite_version:-none}). A skipped clipboard/buffer suite must not pass as green."
    fi
    skip_current_check requires-tmux-3-6 \
      "tmux 3.6+ is unavailable; the required macOS lane owns this behavior proof"
  else
    copylast_socket="groundwork-validate-$$"
    copylast_dir="$out_dir/copylast"
    # CI runners leave LANG unset. Without a UTF-8 locale tmux can mangle multibyte
    # pane content before the helper ever sees it, which would make the multibyte
    # test assert the runner's locale instead of our truncation. Pick one if the
    # machine has it.
    copylast_locale=""
    for candidate_locale in en_US.UTF-8 C.UTF-8; do
      if locale -a 2>/dev/null | grep -qix "$candidate_locale"; then
        copylast_locale="$candidate_locale"
        break
      fi
    done
    mkdir -p "$copylast_dir/bin"
    printf 'set -g history-limit 20000\nset -g escape-time 0\n' >"$copylast_dir/tmux.conf"
    # The helper calls plain `tmux`; this PATH shim pins every call to the
    # private test server so the tests never touch a user's real session.
    real_tmux="$(command -v tmux)"
    cat >"$copylast_dir/bin/tmux" <<SH
#!/bin/sh
exec "$real_tmux" -L "$copylast_socket" "\$@"
SH
    chmod +x "$copylast_dir/bin/tmux"
    run_copylast() {
      TMUX='validate,0,0' PATH="$copylast_dir/bin:/usr/bin:/bin" \
        /bin/bash home/dot_local/bin/executable_tmux-copy-last "$1"
    }
    copylast_wait() { # poll until the scenario pane finished rendering
      # 30s, not 5: the 6,000-line scenario can take a while to render on a loaded
      # machine or a CI runner, and a required lane must not fail by timing.
      local pane="$1" sentinel="$2"
      for _ in $(seq 1 300); do
        if tmux -L "$copylast_socket" capture-pane -p -S - -t "$pane" | grep -qF "$sentinel"; then
          return 0
        fi
        sleep 0.1
      done
      fail "tmux fixture pane never printed $sentinel"
    }
    copylast_window() { # start a scenario script as a pane's only process
      tmux -L "$copylast_socket" new-window -c "$copylast_dir" "$copylast_dir/$1"
      tmux -L "$copylast_socket" display-message -p '#{pane_id}'
    }
    # Each scenario script is the pane's only process and prints OSC 133 prompt
    # marks exactly where a shell with integration would, so no interactive
    # shell noise pollutes the history. A trailing sleep keeps the pane alive.
    cat >"$copylast_dir/scenario-completed.sh" <<'SH'
#!/bin/sh
mark() { printf '\033]133;A\033\\'; }
mark; printf '~/demo $ echo hello\n'; printf 'hello\n'
mark; printf '~/demo $ cat trap.txt\n'
printf ' 󰀵  …/groundwork ❯ rm -rf fake-prompt-in-output\n'
printf 'badge 󰀵 in output text\n'
printf 'READY-A\n'
mark; printf '~/demo $ '
sleep 300
SH
    # Same history, but the newest mark is a command still producing output —
    # an open block with no closing mark.
    cat >"$copylast_dir/scenario-running.sh" <<'SH'
#!/bin/sh
mark() { printf '\033]133;A\033\\'; }
mark; printf '~/demo $ echo hello\n'; printf 'hello\n'
mark; printf '~/demo $ cat trap.txt\n'
printf ' 󰀵  …/groundwork ❯ rm -rf fake-prompt-in-output\n'
printf 'badge 󰀵 in output text\n'
printf 'READY-A\n'
mark; printf '~/demo $ ./long-task\n'
printf 'partial output 1\npartial output 2\n'
printf 'READY-B\n'
sleep 300
SH
    cat >"$copylast_dir/scenario-fresh.sh" <<'SH'
#!/bin/sh
printf 'READY-C\n'
printf '\033]133;A\033\\'; printf '~/demo $ '
sleep 300
SH
    cat >"$copylast_dir/scenario-nomarks.sh" <<'SH'
#!/bin/sh
printf 'plain output, no prompt marks\n'
printf 'READY-D\n'
sleep 300
SH
    # Output with NO trailing newline: the closing prompt begins on the SAME row,
    # so a naive "step up a row" would swallow the last output.
    cat >"$copylast_dir/scenario-nonewline.sh" <<'SH'
#!/bin/sh
mark() { printf '\033]133;A\033\\'; }
mark; printf '\n~/demo $ printf tail-value\n'
printf 'tail-value'
mark; printf '\n~/demo $ READY-F\n'
sleep 300
SH
    # A realistic multi-line prompt: the mark lands at the START of the prompt,
    # which for starship (add_newline + line_break) is a blank row above the row
    # carrying the typed command. Truncation must still keep that command.
    cat >"$copylast_dir/scenario-huge.sh" <<'SH'
#!/bin/sh
printf '\033]133;A\033\\'; printf '\n'
printf '~/demo $ seq 1 6000\n'
seq 1 6000
printf 'READY-E\n'
printf '\033]133;A\033\\'; printf '\n~/demo $ READY-E-IDLE\n'
sleep 300
SH
    chmod +x "$copylast_dir"/scenario-*.sh
    cat >"$copylast_dir/expected-block" <<'EOF'
~/demo $ cat trap.txt
 󰀵  …/groundwork ❯ rm -rf fake-prompt-in-output
badge 󰀵 in output text
READY-A
EOF
    # shellcheck disable=SC2097,SC2098
    LC_ALL="${copylast_locale:-${LC_ALL:-}}" LANG="${copylast_locale:-${LANG:-}}" \
      tmux -L "$copylast_socket" -f "$copylast_dir/tmux.conf" new-session -d -x 200 -y 50 \
      -c "$copylast_dir" "$copylast_dir/scenario-completed.sh"
    # The last completed command is selected even though the newest block is an
    # idle prompt; hostile prompt-looking text and OS badge glyphs inside the
    # output are copied through, never treated as block boundaries.
    completed_pane="$(tmux -L "$copylast_socket" display-message -p '#{pane_id}')"
    copylast_wait "$completed_pane" 'READY-A'
    # Pre-existing paste buffers must survive: the helper reads and deletes its
    # own selection buffer, never one the user put there.
    tmux -L "$copylast_socket" set-buffer 'USER-BUFFER-ONE'
    tmux -L "$copylast_socket" set-buffer 'USER-BUFFER-TWO'
    run_copylast "$completed_pane" >"$copylast_dir/msg-a" 2>&1 \
      || fail "tmux-copy-last failed on a pane with a completed command"
    copylast_all="$(tmux -L "$copylast_socket" list-buffers -F '#{buffer_sample}')"
    grep -qF 'USER-BUFFER-ONE' <<<"$copylast_all" \
      || fail "tmux-copy-last destroyed a pre-existing user paste buffer"
    grep -qF 'USER-BUFFER-TWO' <<<"$copylast_all" \
      || fail "tmux-copy-last destroyed a pre-existing user paste buffer"
    tmux -L "$copylast_socket" save-buffer -b groundwork-copy-last - >"$copylast_dir/buffer-a"
    head -n 1 "$copylast_dir/buffer-a" | grep -Eq '^\[tmux-copy-last · [a-z0-9-]+ · /' \
      || fail "tmux-copy-last did not prepend the platform + directory context line"
    diff -u "$copylast_dir/expected-block" <(tail -n +2 "$copylast_dir/buffer-a")
    # Buffer hygiene: the automatic selection buffer is cleaned up, so the helper
    # adds exactly one buffer of its own on top of the two the user already had.
    copylast_buffers="$(tmux -L "$copylast_socket" list-buffers | wc -l | tr -d ' ')"
    [[ "$copylast_buffers" -eq 3 ]] \
      || fail "tmux-copy-last left $copylast_buffers buffers (expected 3: two user buffers + one headered copy)"
    tmux -L "$copylast_socket" list-buffers -F '#{buffer_name}' | grep -qxF 'groundwork-copy-last' \
      || fail "tmux-copy-last did not write its stable named buffer"
    # A running command — newest mark with output below and no closing mark —
    # is never selected; the previous completed block is copied instead.
    running_pane="$(copylast_window scenario-running.sh)"
    copylast_wait "$running_pane" 'READY-B'
    run_copylast "$running_pane" >"$copylast_dir/msg-b" 2>&1 \
      || fail "tmux-copy-last failed on a pane with a running command"
    tmux -L "$copylast_socket" save-buffer -b groundwork-copy-last - >"$copylast_dir/buffer-b"
    diff -u "$copylast_dir/expected-block" <(tail -n +2 "$copylast_dir/buffer-b")
    # A pane whose only mark is the idle prompt has no completed command.
    fresh_pane="$(copylast_window scenario-fresh.sh)"
    copylast_wait "$fresh_pane" 'READY-C'
    if run_copylast "$fresh_pane" >"$copylast_dir/msg-c" 2>&1; then
      fail "tmux-copy-last selected something in a pane with no completed command"
    fi
    grep -qF 'no completed command' "$copylast_dir/msg-c"
    # A pane with no marks at all fails with copy-mode guidance, never a guess.
    nomarks_pane="$(copylast_window scenario-nomarks.sh)"
    copylast_wait "$nomarks_pane" 'READY-D'
    if run_copylast "$nomarks_pane" >"$copylast_dir/msg-d" 2>&1; then
      fail "tmux-copy-last selected something in a pane without prompt marks"
    fi
    grep -qF 'prompt marks' "$copylast_dir/msg-d"
    grep -qF 'copy-mode' "$copylast_dir/msg-d"
    # Oversized output is truncated visibly, never silently.
    huge_pane="$(copylast_window scenario-huge.sh)"
    # Wait for evidence after the closing prompt mark, not merely for the
    # final output line that precedes it. tmux-copy-last must never race the
    # shell integration sequence that closes the command block.
    copylast_wait "$huge_pane" 'READY-E-IDLE'
    run_copylast "$huge_pane" >"$copylast_dir/msg-e" 2>&1 \
      || fail "tmux-copy-last failed on oversized output"
    tmux -L "$copylast_socket" save-buffer -b groundwork-copy-last - >"$copylast_dir/buffer-e"
    grep -qF '[tmux-copy-last: truncated' "$copylast_dir/buffer-e"
    # The cap covers the FINAL payload — header and truncation notice included —
    # not just the copied block. 5,000 means 5,000.
    huge_lines="$(wc -l <"$copylast_dir/buffer-e" | tr -d ' ')"
    ((huge_lines <= 5000)) || fail "tmux-copy-last exceeded its documented line cap ($huge_lines lines)"
    grep -qF 'truncated' "$copylast_dir/msg-e"
    # Truncation must never drop the command itself — without it, pasted output
    # tells nobody (and no agent) what produced it.
    grep -qF 'seq 1 6000' "$copylast_dir/buffer-e" \
      || fail "tmux-copy-last truncation discarded the command line it claims to keep"
    tail -n 1 "$copylast_dir/buffer-e" | grep -qxF 'READY-E' \
      || fail "tmux-copy-last truncation did not keep the tail (end) of the output"
    grep -qxF '6000' "$copylast_dir/buffer-e" \
      || fail "tmux-copy-last truncation dropped the most recent output lines"
    # The cap applies to the FINAL payload (header + head + notice + tail), not
    # just the tail slice.
    huge_bytes="$(wc -c <"$copylast_dir/buffer-e" | tr -d ' ')"
    ((huge_bytes <= 512 * 1024)) \
      || fail "tmux-copy-last exceeded its documented byte cap ($huge_bytes bytes)"
    # A tight byte budget must still keep whole lines (never split a multibyte
    # character) and still keep the command.
    # 8192, not a hair above the header: a CI checkout path is long, and a cap the
    # header alone cannot fit is a correct REFUSAL, not a bug — testing that here
    # would only assert the runner's path length.
    GROUNDWORK_COPY_MAX_BYTES=8192 run_copylast "$huge_pane" >/dev/null 2>&1 \
      || fail "tmux-copy-last failed under a tight byte budget"
    tmux -L "$copylast_socket" save-buffer -b groundwork-copy-last - >"$copylast_dir/buffer-tiny"
    tiny_bytes="$(wc -c <"$copylast_dir/buffer-tiny" | tr -d ' ')"
    ((tiny_bytes <= 8192)) || fail "tmux-copy-last ignored a tight byte cap ($tiny_bytes bytes)"
    grep -qF 'seq 1 6000' "$copylast_dir/buffer-tiny" \
      || fail "a tight byte cap dropped the command line"
    iconv -f UTF-8 -t UTF-8 "$copylast_dir/buffer-tiny" >/dev/null 2>&1 \
      || fail "tmux-copy-last truncation split a multibyte character"

    # Multibyte output AND a multibyte working directory: byte accounting that
    # counts characters would sail past the cap here while passing on ASCII.
    mkdir -p "$copylast_dir/ünïcode 🚀"
    cat >"$copylast_dir/scenario-utf8.sh" <<'SH'
#!/bin/sh
printf '\033]133;A\033\\'; printf '\n~/demo $ emit-unicode\n'
i=0
while [ "$i" -lt 400 ]; do
  printf 'тест 日本語 🎉 ünïcode line %s\n' "$i"
  i=$((i + 1))
done
printf 'READY-U\n'
printf '\033]133;A\033\\'; printf '\n~/demo $ '
sleep 300
SH
    chmod +x "$copylast_dir/scenario-utf8.sh"
    tmux -L "$copylast_socket" new-window -c "$copylast_dir/ünïcode 🚀" \
      "$copylast_dir/scenario-utf8.sh"
    utf8_pane="$(tmux -L "$copylast_socket" display-message -p '#{pane_id}')"
    copylast_wait "$utf8_pane" 'READY-U'
    GROUNDWORK_COPY_MAX_BYTES=4096 run_copylast "$utf8_pane" >/dev/null 2>&1 \
      || fail "tmux-copy-last failed on multibyte output"
    tmux -L "$copylast_socket" save-buffer -b groundwork-copy-last - >"$copylast_dir/buffer-utf8"
    utf8_bytes="$(wc -c <"$copylast_dir/buffer-utf8" | tr -d ' ')"
    ((utf8_bytes <= 4096)) \
      || fail "tmux-copy-last blew the byte cap on multibyte content ($utf8_bytes bytes) — is it counting characters?"
    # Judge the helper, not the environment: if tmux itself could not render the
    # multibyte pane (no UTF-8 locale on this machine), there is no valid input to
    # preserve. When the capture IS valid, our output must be too — that is the
    # truncation-boundary contract.
    tmux -L "$copylast_socket" capture-pane -p -S - -t "$utf8_pane" >"$copylast_dir/utf8-capture"
    if iconv -f UTF-8 -t UTF-8 "$copylast_dir/utf8-capture" >/dev/null 2>&1; then
      iconv -f UTF-8 -t UTF-8 "$copylast_dir/buffer-utf8" >/dev/null 2>&1 \
        || fail "tmux-copy-last split a multibyte character at the truncation boundary"
    else
      echo "  (this machine has no UTF-8 locale, so tmux could not render the multibyte pane; the byte cap is still asserted)"
    fi
    head -n 1 "$copylast_dir/buffer-utf8" | grep -qF '🚀' \
      || fail "the context header lost the multibyte working directory"
    # The header stays one line even when the path carries control characters.
    [[ "$(head -n 1 "$copylast_dir/buffer-utf8" | wc -l | tr -d ' ')" -eq 1 ]]

    # A hostile TMPDIR must not break or inject: the scratch path is interpolated
    # into a command string that tmux hands to a SHELL.
    hostile_tmp="$copylast_dir/tmp dir 'quote'; \$(touch $copylast_dir/PWNED) #"
    mkdir -p "$hostile_tmp"
    TMPDIR="$hostile_tmp" run_copylast "$completed_pane" >"$copylast_dir/msg-hostile" 2>&1 \
      || fail "tmux-copy-last failed with spaces/quotes/metacharacters in TMPDIR"
    test ! -e "$copylast_dir/PWNED" \
      || fail "tmux-copy-last executed injected shell code from TMPDIR"
    tmux -L "$copylast_socket" save-buffer -b groundwork-copy-last - >"$copylast_dir/buffer-hostile"
    diff -u "$copylast_dir/expected-block" <(tail -n +2 "$copylast_dir/buffer-hostile")

    # Malformed or impossibly small limits are refused up front, not discovered
    # halfway through (and never silently exceeded).
    for bad_limit in 0 abc -5; do
      if GROUNDWORK_COPY_MAX_LINES="$bad_limit" run_copylast "$completed_pane" \
        >"$copylast_dir/msg-badlimit" 2>&1; then
        fail "tmux-copy-last accepted an invalid line limit: $bad_limit"
      fi
    done
    if GROUNDWORK_COPY_MAX_BYTES=100 run_copylast "$completed_pane" \
      >"$copylast_dir/msg-smallcap" 2>&1; then
      fail "tmux-copy-last accepted a byte cap too small to honor"
    fi
    grep -qF 'between 1024 and' "$copylast_dir/msg-smallcap"
    # Bounded above too: a huge value overflows bash arithmetic.
    if GROUNDWORK_COPY_MAX_BYTES=999999999999999999999 run_copylast "$completed_pane" \
      >"$copylast_dir/msg-hugecap" 2>&1; then
      fail "tmux-copy-last accepted an unbounded byte cap"
    fi
    # The cap is absolute: when the header and command alone cannot fit, copy
    # NOTHING rather than publish an oversized payload while promising a maximum.
    if GROUNDWORK_COPY_MAX_BYTES=1024 GROUNDWORK_COPY_MAX_LINES=5 \
      run_copylast "$huge_pane" >"$copylast_dir/msg-cap-absolute" 2>&1; then
      tmux -L "$copylast_socket" save-buffer -b groundwork-copy-last - >"$copylast_dir/buffer-cap" 2>/dev/null || true
      cap_bytes="$(wc -c <"$copylast_dir/buffer-cap" | tr -d ' ')"
      ((cap_bytes <= 1024)) \
        || fail "tmux-copy-last published $cap_bytes bytes against a 1024-byte cap"
    else
      grep -qF 'nothing was copied' "$copylast_dir/msg-cap-absolute" \
        || fail "when the cap cannot be honored, tmux-copy-last must refuse and say so"
    fi

    # Client targeting, proven behaviorally rather than by grep. Two clients are
    # attached; the buffer must be delivered for the INVOKING one. Without -t,
    # a backgrounded run-shell leaves tmux to infer a client and it can pick the
    # wrong terminal's clipboard.
    copylast_client_log="$copylast_dir/client.log"
    : >"$copylast_client_log"
    # A fake tmux that records the load-buffer invocation, then delegates.
    mkdir -p "$copylast_dir/spy"
    cat >"$copylast_dir/spy/tmux" <<SPY
#!/bin/sh
if [ "\$1" = "load-buffer" ]; then
  printf '%s\n' "\$*" >>"$copylast_client_log"
fi
exec "$real_tmux" -L "$copylast_socket" "\$@"
SPY
    chmod +x "$copylast_dir/spy/tmux"
    # TWO genuinely attached clients, so "which client?" is a real question: a
    # detached server is not a client, and targeting the only client would pass
    # even if the code ignored the argument. Control-mode clients (-C) attach
    # without a pty, which is what makes this receipt runnable on a CI runner
    # instead of quietly skipping there. A tracked FIFO writer keeps each stdin
    # open; both sides are stopped and reaped after the targeting proof.
    for control_index in 1 2; do
      control_fifo="$copylast_dir/control-client-$control_index.fifo"
      mkfifo "$control_fifo"
      sleep 120 >"$control_fifo" &
      copylast_control_pids+=("$!")
      "$real_tmux" -L "$copylast_socket" -C attach -t 0 \
        <"$control_fifo" >/dev/null 2>&1 &
      copylast_control_pids+=("$!")
    done
    for _ in $(seq 1 30); do
      copylast_client_count="$(tmux -L "$copylast_socket" list-clients -F '#{client_name}' 2>/dev/null | wc -l | tr -d ' ')"
      [[ "$copylast_client_count" -ge 2 ]] && break
      sleep 0.2
    done
    if [[ "${copylast_client_count:-0}" -lt 2 ]]; then
      # A required receipt must not evaporate: on the CI lane that owns this
      # property, "could not attach two clients" is a failure, not a skip.
      if [[ "${GROUNDWORK_REQUIRE_TMUX:-0}" == "1" ]]; then
        fail "could not attach two tmux clients, so the clipboard client-targeting receipt could not run (it must not silently skip on the lane that owns it)"
      fi
      mark_current_check_skipped requires-two-tmux-clients \
        "two tmux clients could not attach; the required macOS lane owns this behavior proof"
    else
      # Target the SECOND client, not whichever happens to be first: picking the
      # only/first client would pass even if the code ignored the argument.
      copylast_other="$(tmux -L "$copylast_socket" list-clients -F '#{client_name}' | head -n 1)"
      copylast_target="$(tmux -L "$copylast_socket" list-clients -F '#{client_name}' | sed -n '2p')"
      : >"$copylast_client_log"
      TMUX='validate,0,0' PATH="$copylast_dir/spy:/usr/bin:/bin" \
        /bin/bash home/dot_local/bin/executable_tmux-copy-last "$completed_pane" "$copylast_target" \
        >/dev/null 2>&1 || fail "tmux-copy-last failed when given an explicit client"
      grep -qF -- "-t $copylast_target" "$copylast_client_log" \
        || fail "the final load-buffer did not target the invoking client (the clipboard could land on the wrong terminal)"
      assert_not_contains "\-t $copylast_other" "$copylast_client_log" \
        "the final load-buffer targeted the WRONG client"
    fi
    stop_copylast_control_clients

    # Fault injection: once copy-mode is entered and a scratch dir exists, EVERY
    # later tmux call can fail. Each failure must leave copy-mode and remove the
    # scratch directory — no stranded pane, no leaked selection on disk.
    mkdir -p "$copylast_dir/faulty"
    for fault in previous-prompt next-prompt copy-pipe-and-cancel load-buffer; do
      cat >"$copylast_dir/faulty/tmux" <<FAULT
#!/bin/sh
for arg in "\$@"; do
  if [ "\$arg" = "$fault" ]; then
    echo "injected failure: $fault" >&2
    exit 1
  fi
done
exec "$real_tmux" -L "$copylast_socket" "\$@"
FAULT
      chmod +x "$copylast_dir/faulty/tmux"
      scratch_before="$(find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'tmux-copy-last.*' 2>/dev/null | wc -l | tr -d ' ')"
      set +e
      TMUX='validate,0,0' PATH="$copylast_dir/faulty:/usr/bin:/bin" \
        /bin/bash home/dot_local/bin/executable_tmux-copy-last "$completed_pane" \
        >"$copylast_dir/fault-$fault" 2>&1
      fault_status=$?
      set -e
      [[ "$fault_status" -ne 0 ]] \
        || fail "tmux-copy-last reported success although '$fault' failed"
      # The pane must not be stranded in copy-mode.
      in_mode="$(tmux -L "$copylast_socket" display-message -p -t "$completed_pane" '#{pane_in_mode}' 2>/dev/null || echo 0)"
      [[ "$in_mode" == "0" ]] \
        || fail "a failure at '$fault' left the pane stuck in copy-mode"
      # And it must not leave its scratch directory (the raw selection) behind.
      scratch_after="$(find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'tmux-copy-last.*' 2>/dev/null | wc -l | tr -d ' ')"
      [[ "$scratch_after" -le "$scratch_before" ]] \
        || fail "a failure at '$fault' leaked a scratch directory holding the raw selection"
    done

    # A command whose output has no trailing newline: the closing prompt shares
    # the last output row, so the output must survive and the prompt must not
    # leak into the copy.
    nonewline_pane="$(copylast_window scenario-nonewline.sh)"
    copylast_wait "$nonewline_pane" 'READY-F'
    run_copylast "$nonewline_pane" >"$copylast_dir/msg-f" 2>&1 \
      || fail "tmux-copy-last failed on output with no trailing newline"
    tmux -L "$copylast_socket" save-buffer -b groundwork-copy-last - >"$copylast_dir/buffer-f"
    grep -qF 'tail-value' "$copylast_dir/buffer-f" \
      || fail "tmux-copy-last dropped output that had no trailing newline"
    grep -qF 'READY-F' "$copylast_dir/buffer-f" \
      && fail "tmux-copy-last leaked the next prompt into the copy"

    # Repeated use must not accumulate buffers: one stable named buffer is reused.
    copylast_before="$(tmux -L "$copylast_socket" list-buffers | wc -l | tr -d ' ')"
    run_copylast "$completed_pane" >/dev/null 2>&1
    run_copylast "$completed_pane" >/dev/null 2>&1
    copylast_after="$(tmux -L "$copylast_socket" list-buffers | wc -l | tr -d ' ')"
    [[ "$copylast_before" -eq "$copylast_after" ]] \
      || fail "repeated tmux-copy-last runs accumulate buffers ($copylast_before -> $copylast_after)"
    # The scenario panes above script the marks. This one proves the real
    # integration: an interactive zsh loading the rendered .zshrc must actually
    # register prompt marks that survive zle's redraw. A precmd-emitted mark
    # passes every scripted test and records nothing here.
    render darwin false arm64 home/dot_zshrc.tmpl "$copylast_dir/zshrc"
    mkdir -p "$copylast_dir/zdot"
    cp "$copylast_dir/zshrc" "$copylast_dir/zdot/.zshrc"
    tmux -L "$copylast_socket" new-window -c "$copylast_dir" \
      "env ZDOTDIR='$copylast_dir/zdot' HOME='$copylast_dir/zdot' zsh -i"
    zsh_pane="$(tmux -L "$copylast_socket" display-message -p '#{pane_id}')"
    # Sentinels + bounded polling, never fixed sleeps: a slow CI box must not
    # turn this into a flaky test.
    zsh_send() { # command sentinel — run it, then wait for its OUTPUT to land
      tmux -L "$copylast_socket" send-keys -t "$zsh_pane" "$1" Enter
      copylast_wait "$zsh_pane" "$2"
    }
    # The sentinel must not appear in the typed command itself, or the wait
    # returns before zsh has even run it and the whole test races.
    zsh_send "printf 'ZPROBE%s\n' 0" 'ZPROBE0'
    zsh_send "printf 'ZPROBE%s\n' 1" 'ZPROBE1'
    zsh_send "printf 'ZPROBE%s\n' 2" 'ZPROBE2'
    zsh_marks() { # how many distinct prompt marks previous-prompt can reach
      local seen=0 last="" now
      tmux -L "$copylast_socket" copy-mode -t "$zsh_pane"
      while ((seen < 12)); do
        tmux -L "$copylast_socket" send-keys -t "$zsh_pane" -X previous-prompt
        now="$(tmux -L "$copylast_socket" display-message -p -t "$zsh_pane" '#{copy_cursor_y}')"
        [[ "$now" != "$last" ]] || break
        last="$now"
        seen=$((seen + 1))
      done
      tmux -L "$copylast_socket" send-keys -t "$zsh_pane" -X cancel
      printf '%s\n' "$seen"
    }
    zsh_mark_count="$(zsh_marks)"
    ((zsh_mark_count >= 2)) \
      || fail "an interactive zsh with the rendered .zshrc registered no OSC 133 prompt marks (is the mark in a precmd hook instead of PROMPT?)"
    # Re-sourcing .zshrc (or the shell's own self-refresh) must not stack a second
    # mark onto PROMPT: duplicate marks give tmux two prompt positions per prompt
    # and make previous-prompt navigation unpredictable. Count the marks in PROMPT
    # itself rather than inferring from cursor movement.
    # grep -o | wc -l, never grep -c: grep -c counts matching LINES, so five marks
    # stacked on one prompt line would still report 1 and the test would pass.
    # shellcheck disable=SC2016 # this is zsh source text sent to a pane, not bash
    zsh_resource_cmd='source ~/.zshrc; source ~/.zshrc; printf "MK%s\n" "$(print -rn -- "$PROMPT" | grep -o "133;A" | wc -l | tr -d " ")"'
    tmux -L "$copylast_socket" send-keys -t "$zsh_pane" "$zsh_resource_cmd" Enter
    # Wait on a SEPARATE sentinel: any token inside the measurement command also
    # appears in the echoed command line, which would race the assertion.
    zsh_send "printf 'ZPROBE%s\n' 3" 'ZPROBE3'
    tmux -L "$copylast_socket" capture-pane -p -S - -t "$zsh_pane" >"$copylast_dir/zsh-marks"
    grep -qxF 'MK1' "$copylast_dir/zsh-marks" \
      || fail "re-sourcing .zshrc must leave exactly one OSC 133 mark in PROMPT (saw $(grep -oE '^MK[0-9]+$' "$copylast_dir/zsh-marks" | tail -n 1))"
    tmux -L "$copylast_socket" kill-server 2>/dev/null || true
    copylast_socket=""
  fi

}

validate_static_helpers() {
  check "Groundwork local docs resolver"
  test -x home/dot_local/bin/executable_groundwork-docs
  scripts/test-groundwork-docs

  check "Karabiner diagnostics and verified restart"
  test -x home/dot_local/bin/executable_groundwork-karabiner-restart
  test -x home/dot_local/bin/executable_groundwork-karabiner-postflight
  test -x scripts/test-karabiner-diagnostics
  scripts/test-karabiner-diagnostics

  check "largest helper"
  test -x home/dot_local/bin/executable_largest
  largest_fixture="$out_dir/largest-fixture"
  largest_bin="$out_dir/largest-bin"
  mkdir -p "$largest_fixture" "$largest_bin"
  cat >"$largest_bin/dust" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$@" >"$DUST_ARGS_FILE"
SH
  chmod +x "$largest_bin/dust"
  DUST_ARGS_FILE="$out_dir/dust-args" PATH="$largest_bin:$PATH" \
    home/dot_local/bin/executable_largest --files -n 7 "$largest_fixture" >"$out_dir/largest-output"
  cat >"$out_dir/expected-dust-args" <<EOF
-x
-r
-n
7
-F
--
$largest_fixture
EOF
  diff -u "$out_dir/expected-dust-args" "$out_dir/dust-args"
  grep -qF 'Cleanup guide: match each result to its owner' "$out_dir/largest-output"
  grep -qF 'groundwork-help largest' < <(home/dot_local/bin/executable_largest --help)
  DUST_ARGS_FILE="$out_dir/dust-args" PATH="$largest_bin:$PATH" \
    home/dot_local/bin/executable_largest --no-advice "$largest_fixture" >"$out_dir/largest-no-advice"
  assert_not_contains 'Cleanup guide' "$out_dir/largest-no-advice" "largest --no-advice printed cleanup guidance"
  if home/dot_local/bin/executable_largest --files --folders "$largest_fixture" >/dev/null 2>&1; then
    fail "largest accepted mutually exclusive --files and --folders"
  fi
}

validate_docker() {
  check "Colima instance template"
  # This remains in the Linux Docker suite so macOS template behavior is
  # covered cross-platform. Chezmoi's output function resolves commands from
  # PATH, so provide deterministic macOS sysctl observations instead of asking
  # the Linux host for hw.* keys it does not have.
  colima_fixture_bin="$out_dir/colima-template-bin"
  mkdir -p "$colima_fixture_bin"
  cat >"$colima_fixture_bin/sysctl" <<'SH'
#!/usr/bin/env bash
case "$*" in
  '-n hw.ncpu') printf '12\n' ;;
  '-n hw.memsize') printf '25769803776\n' ;;
  *) printf 'unexpected sysctl fixture arguments: %s\n' "$*" >&2; exit 64 ;;
esac
SH
  chmod +x "$colima_fixture_bin/sysctl"
  for colima_arch in arm64 amd64; do
    colima_rendered="$out_dir/colima-$colima_arch.yaml"
    PATH="$colima_fixture_bin:$PATH" \
      render darwin false "$colima_arch" \
      home/dot_colima/_templates/default.yaml.tmpl "$colima_rendered"
    grep -qE '^runtime:[[:space:]]*docker$' "$colima_rendered" \
      || fail "the rendered Colima template ($colima_arch) does not pin runtime: docker"
    grep -qE '^vmType:[[:space:]]*vz$' "$colima_rendered" \
      || fail "the rendered Colima template ($colima_arch) lost its vz virtualization choice"
    grep -qE '^cpu:[[:space:]]*6$' "$colima_rendered" \
      || fail "the rendered Colima template ($colima_arch) did not use the controlled CPU observation"
    grep -qE '^memory:[[:space:]]*8$' "$colima_rendered" \
      || fail "the rendered Colima template ($colima_arch) did not use the controlled memory observation"

    if python3 -c 'import yaml' >/dev/null 2>&1; then
      python3 - "$colima_rendered" <<'PY'
import sys
import yaml

document = yaml.safe_load(open(sys.argv[1], encoding="utf-8"))
expected = {
    "runtime": "docker",
    "vmType": "vz",
    "mountType": "virtiofs",
    "cpu": 6,
    "memory": 8,
}
for key, value in expected.items():
    if document.get(key) != value:
        raise SystemExit(f"rendered Colima YAML has {key}={document.get(key)!r}, expected {value!r}")
PY
    else
      # PyYAML is not guaranteed on every validator host. This is deliberately
      # a structural top-level scalar check, not a claim that it parses YAML.
      python3 - "$colima_rendered" <<'PY'
import sys

lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
top = {
    line.split(":", 1)[0]: line.split(":", 1)[1].strip()
    for line in lines
    if line and not line[0].isspace() and ":" in line and not line.startswith("#")
}
expected = {
    "runtime": "docker",
    "vmType": "vz",
    "mountType": "virtiofs",
    "cpu": "6",
    "memory": "8",
}
for key, value in expected.items():
    if top.get(key) != value:
        raise SystemExit(f"rendered Colima scalar has {key}={top.get(key)!r}, expected {value!r}")
PY
    fi
  done

  check "docker helper suite setup"
  # One scriptable docker stub serves the doctor, the tidy, the cache tidy, and
  # the build wrapper. Its state is plain TSV files a test writes per case —
  # images.tsv (id, tags comma-joined or -, ephemeral label, built label,
  # created, size) and containers.tsv (id, image id, running|exited, name,
  # ephemeral label, status text, created) — so each scenario is a declared
  # policy state, not a hand-crafted case statement. Every argv is recorded one
  # line per call, `image rm`/`container rm` mutate the state the way docker
  # would (refusing multi-tag ID deletes and container-referenced deletes), and
  # a trip hook can swap the image or container state mid-run to prove the
  # apply-time re-checks.
  docker_lib="$PWD/home/dot_local/share/groundwork/lib/docker-scan.sh"
  docker_runner_lib="$PWD/home/dot_local/share/groundwork/lib/maintenance-runner.sh"
  test -f "$docker_lib"
  test -f "$docker_runner_lib"
  docker_stub_bin="$out_dir/docker-stub"
  docker_home="$out_dir/docker-home"
  docker_pending_file="$docker_home/.local/state/groundwork/docker-tidy-pending"
  mkdir -p "$docker_stub_bin"
  mkdir -p "$docker_home/.local/bin" "$docker_home/.local/lib/groundwork" \
    "$docker_home/.local/share/groundwork/lib"
  cp home/dot_local/lib/groundwork/update-lock.sh \
    "$docker_home/.local/lib/groundwork/update-lock.sh"
  cp "$docker_lib" "$docker_home/.local/share/groundwork/lib/docker-scan.sh"
  install_fixture_policy_runner \
    "$docker_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_policy_clock "$docker_stub_bin/date"
  cp home/dot_local/bin/executable_groundwork-docker-build-scratch \
    "$docker_home/.local/bin/groundwork-docker-build-scratch"
  # Production accepts Docker and jq only from platform-owned roots. The fixture
  # HOME owns a canonical test library whose final definition resolves the
  # declared stub PATH instead; no production environment seam is introduced.
  cat >>"$docker_home/.local/share/groundwork/lib/docker-scan.sh" <<'SH'
gw_docker_resolve_trusted_executable() {
  type -P "$1" 2>/dev/null
}
SH
  cat >"$docker_stub_bin/docker" <<'SH'
#!/bin/bash
set -eu
state="${DOCKER_STATE:?}"
printf '%s\n' "$*" >>"$state/argv.log"
imgs="$state/images.tsv"; ctrs="$state/containers.tsv"
if [ -f "$state/fail.conf" ]; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$*" in *"$f"*) exit 1 ;; esac
  done <"$state/fail.conf"
fi
if [ -f "$state/trip.conf" ]; then
  # shellcheck disable=SC1091
  . "$state/trip.conf"
  case "$*" in
    *"$TRIP_SUBSTR"*)
      tc="$(cat "$state/trip.count" 2>/dev/null || echo 0)"; tc=$((tc + 1))
      printf '%s\n' "$tc" >"$state/trip.count"
      if [ "$tc" -eq "$TRIP_AT" ]; then
        if [ -n "${TRIP_IMAGES:-}" ]; then cp "$TRIP_IMAGES" "$imgs"; fi
        if [ -n "${TRIP_CONTAINERS:-}" ]; then cp "$TRIP_CONTAINERS" "$ctrs"; fi
        if [ -n "${TRIP_FAIL_PATTERN:-}" ]; then printf '%s\n' "$TRIP_FAIL_PATTERN" >"$state/fail.conf"; fi
        if [ -n "${TRIP_EXIT:-}" ]; then exit "$TRIP_EXIT"; fi
      fi
      ;;
  esac
fi
if [ -f "$state/delay.conf" ]; then
  # shellcheck disable=SC1091
  . "$state/delay.conf"
  case "$*" in
    *"$DELAY_SUBSTR"*)
      should_delay=1
      if [[ -n "${DELAY_AT:-}" || -n "${DELAY_AFTER:-}" ]]; then
        delay_count="$(cat "$state/delay.count" 2>/dev/null || echo 0)"
        delay_count=$((delay_count + 1))
        printf '%s\n' "$delay_count" >"$state/delay.count"
        if [[ -n "${DELAY_AT:-}" ]]; then
          [[ "$delay_count" -eq "$DELAY_AT" ]] || should_delay=0
        elif [[ "$delay_count" -le "$DELAY_AFTER" ]]; then
          should_delay=0
        fi
      fi
      if [[ "$should_delay" -eq 1 ]]; then
        [[ -z "${DELAY_SENTINEL:-}" ]] || : >"$DELAY_SENTINEL"
        if [[ "${DELAY_SPAWN_DESCENDANT:-0}" == "1" ]]; then
          (trap '' TERM; sleep "${DELAY_DESCENDANT_SECONDS:-30}") &
          delayed_child=$!
          [[ -z "${DELAY_PID_FILE:-}" ]] || printf '%s\n' "$delayed_child" >"$DELAY_PID_FILE"
          wait "$delayed_child"
        else
          sleep "${DELAY_SECONDS:-30}"
        fi
      fi
      ;;
  esac
fi
img_field() { awk -F'\t' -v id="$1" -v n="$2" '$1 == id { print $n; exit }' "$imgs"; }
img_exists() { awk -F'\t' -v id="$1" 'BEGIN { r = 1 } $1 == id { r = 0 } END { exit r }' "$imgs"; }
resolve_img() {
  if img_exists "$1"; then
    printf '%s\n' "$1"
    return 0
  fi
  awk -F'\t' -v ref="$1" '{
    n = split($2, tags, ",")
    for (i = 1; i <= n; i++) if (tags[i] == ref) { print $1; exit }
  }' "$imgs"
}
last_arg() { eval "printf '%s\n' \"\${$#}\""; }
case "$*" in
  info) exit 0 ;;
  'context inspect --format {{.Endpoints.docker.Host}}')
    cat "$state/context-host" 2>/dev/null || echo 'unix:///var/run/docker.sock' ;;
  'info --format {{.LoggingDriver}}') cat "$state/log-driver" 2>/dev/null || echo local ;;
  'info --format {{.Driver}}') echo overlayfs ;;
  'system df --format'*) printf 'Build Cache\t7.2GB\t7.2GB\n' ;;
  'system df') printf 'TYPE TOTAL ACTIVE SIZE RECLAIMABLE\n' ;;
  'images --no-trunc --filter label=dev.roost.ephemeral=true --format {{.ID}}')
    awk -F'\t' '$3 == "true" { print $1 }' "$imgs" ;;
  'images --no-trunc --filter label=dev.roost.ephemeral=true --format {{.ID}}'*)
    awk -F'\t' '$3 == "true" { n = split($2, t, ","); if ($2 == "-") n = 1; for (i = 1; i <= n; i++) print $1 "\t" $6 }' "$imgs" ;;
  'images --no-trunc --format {{.Repository}}:{{.Tag}}	{{.ID}}')
    awk -F'\t' '$2 != "-" { n = split($2, t, ","); for (i = 1; i <= n; i++) print t[i] "\t" $1 }' "$imgs" ;;
  'images --no-trunc --format {{.Repository}}:{{.Tag}}')
    awk -F'\t' '$2 != "-" { n = split($2, t, ","); for (i = 1; i <= n; i++) print t[i] }' "$imgs" ;;
  'images --all --no-trunc --quiet')
    awk -F'\t' '!seen[$1]++ { print $1 }' "$imgs" ;;
  'images --no-trunc --format {{.ID}}'*)
    awk -F'\t' '$2 != "-" { n = split($2, t, ","); for (i = 1; i <= n; i++) { split(t[i], p, ":"); repo = substr(t[i], 1, length(t[i]) - length(p[length(p)]) - 1); print $1 "\t" repo "\t" p[length(p)] "\t" $6 } }' "$imgs" ;;
  'images -q --filter dangling=true')
    awk -F'\t' '$2 == "-" { print substr($1, 8, 12) }' "$imgs" ;;
  'ps -aq --no-trunc' | 'ps -aq')
    awk -F'\t' '{ print $1 }' "$ctrs" ;;
  'ps -a --no-trunc --format {{.ID}}	{{.Names}}')
    awk -F'\t' '{ print $1 "\t" $4 }' "$ctrs" ;;
  'ps -aq --filter status=exited')
    awk -F'\t' '$3 == "exited" { print $1 }' "$ctrs" ;;
  'ps -a --no-trunc --filter status=exited --filter label=dev.roost.ephemeral=true --format {{.ID}}'*)
    awk -F'\t' '$3 == "exited" && $5 == "true" { print $1 "\t" $4 "\t" $6 }' "$ctrs" ;;
  'volume ls -q --filter dangling=true')
    cat "$state/volumes.txt" 2>/dev/null || true ;;
  'container inspect --format {{.Image}}'*)
    cid="$(last_arg "$@")"
    awk -F'\t' -v c="$cid" '$1 == c { print $2 "\t/" $4 "\t" $3; f = 1 } END { exit f ? 0 : 1 }' "$ctrs" ;;
  'container inspect --format {{.Created}}'*)
    cid="$(last_arg "$@")"
    awk -F'\t' -v c="$cid" '$1 == c { print ($7 == "" ? "-" : $7) "\t" $3 "\t" $2; f = 1 } END { exit f ? 0 : 1 }' "$ctrs" ;;
  'container inspect --format {{.Id}} '*)
    cref="$(last_arg "$@")"
    awk -F'\t' -v c="$cref" '($1 == c || $4 == c) { print $1; f = 1; exit } END { exit f ? 0 : 1 }' "$ctrs" ;;
  'container create '*)
    name=""; image_ref=""; cidfile=""; prev=""
    for a in "$@"; do
      case "$prev" in
        --name) name="$a" ;;
        --cidfile) cidfile="$a" ;;
      esac
      case "$a" in
        --rm | --name | --cidfile | container | create) ;;
        *)
          if [ -n "$name" ] && [ -z "$image_ref" ] && [ "$prev" != "--name" ] && [ "$prev" != "--cidfile" ]; then image_ref="$a"; fi
          ;;
      esac
      prev="$a"
    done
    if [ -n "$cidfile" ] && [ -e "$cidfile" ]; then
      echo "container ID file found before create" >&2
      exit 1
    fi
    awk -F'\t' -v n="$name" '$4 == n { found = 1 } END { exit found ? 0 : 1 }' "$ctrs" \
      && { echo "container name is already in use" >&2; exit 1; }
    image_id="$(resolve_img "$image_ref")"; [ -n "$image_id" ] || exit 1
    cid="dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
    CREATE_APPEARS=1
    CREATE_EXIT=0
    CREATE_CID_MODE=valid
    CREATE_STDOUT_MODE=valid
    if [ -f "$state/create.conf" ]; then
      # shellcheck disable=SC1091
      . "$state/create.conf"
    fi
    if [ "$CREATE_APPEARS" -eq 1 ]; then
      printf '%s\t%s\tcreated\t%s\ttrue\tCreated\t%s\n' \
        "$cid" "$image_id" "$name" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$ctrs"
    fi
    case "$CREATE_CID_MODE" in
      valid) [ -z "$cidfile" ] || printf '%s\n' "$cid" >"$cidfile" ;;
      empty) [ -z "$cidfile" ] || : >"$cidfile" ;;
      malformed) [ -z "$cidfile" ] || printf 'not-an-id\n' >"$cidfile" ;;
      two-lines) [ -z "$cidfile" ] || printf '%s\n%s\n' "$cid" "$cid" >"$cidfile" ;;
    esac
    case "$CREATE_STDOUT_MODE" in
      valid) printf '%s\n' "$cid" ;;
      empty) ;;
      malformed) printf 'not-an-id\n' ;;
      two-lines) printf '%s\n%s\n' "$cid" "$cid" ;;
    esac
    exit "$CREATE_EXIT" ;;
  'container start --attach '*)
    cid="$(last_arg "$@")"
    awk -F'\t' -v c="$cid" '$1 == c { found = 1 } END { exit found ? 0 : 1 }' "$ctrs" || exit 1
    awk -F'\t' -v c="$cid" '$1 != c' "$ctrs" >"$ctrs.tmp"
    mv "$ctrs.tmp" "$ctrs"
    echo OK ;;
  'container stop --time 2 '*)
    cid="$(last_arg "$@")"
    awk -F'\t' -v c="$cid" '$1 == c { found = 1 } END { exit found ? 0 : 1 }' "$ctrs" || exit 1
    awk -F'\t' -v OFS='\t' -v c="$cid" '$1 == c { $3 = "exited"; $6 = "Exited (143)" } { print }' \
      "$ctrs" >"$ctrs.tmp"
    mv "$ctrs.tmp" "$ctrs"
    printf '%s\n' "$cid" ;;
  'image inspect --format {{.Id}} '*)
    id="$(resolve_img "$(last_arg "$@")")"; [ -n "$id" ] || exit 1; printf '%s\n' "$id" ;;
  'image inspect --format {{index .Config.Labels "dev.roost.ephemeral"}} '*)
    id="$(resolve_img "$(last_arg "$@")")"; [ -n "$id" ] || exit 1
    v="$(img_field "$id" 3)"; [ "$v" = "-" ] && v="<no value>"; printf '%s\n' "$v" ;;
  'image inspect --format {{index .Config.Labels "dev.roost.built"}} '*)
    id="$(resolve_img "$(last_arg "$@")")"; [ -n "$id" ] || exit 1
    v="$(img_field "$id" 4)"; [ "$v" = "-" ] && v="<no value>"; printf '%s\n' "$v" ;;
  'image inspect --format {{range .RepoTags}}{{println .}}{{end}} '*)
    id="$(resolve_img "$(last_arg "$@")")"; [ -n "$id" ] || exit 1
    tags="$(img_field "$id" 2)"; [ "$tags" = "-" ] || printf '%s\n' "$tags" | tr ',' '\n' ;;
  'image inspect --format {{.Created}} '*)
    id="$(resolve_img "$(last_arg "$@")")"; [ -n "$id" ] || exit 1; img_field "$id" 5 ;;
  'image inspect '*)
    id="$(resolve_img "$(last_arg "$@")")"; [ -n "$id" ] || exit 1
    tags="$(img_field "$id" 2)"
    eph="$(img_field "$id" 3)"
    built="$(img_field "$id" 4)"
    created="$(img_field "$id" 5)"
    if [ "$tags" = "-" ]; then
      tags_json='[]'
    else
      tags_json="$(printf '%s\n' "$tags" | awk -F, '{
        printf "["
        for (i = 1; i <= NF; i++) printf "%s\"%s\"", (i == 1 ? "" : ","), $i
        printf "]"
      }')"
    fi
    if grep -qxF "$id" "$state/inspect-empty-repotags" 2>/dev/null; then
      tags_json='[]'
    fi
    printf '[{"Id":"%s",' "$id"
    if ! grep -qxF "$id" "$state/inspect-omit-repotags" 2>/dev/null; then
      printf '"RepoTags":%s,' "$tags_json"
    fi
    printf '"Created":"%s","Config":{"Labels":{"dev.roost.ephemeral":%s,"dev.roost.built":%s}}}]\n' \
      "$created" "$([ "$eph" = "-" ] && printf null || printf '"%s"' "$eph")" \
      "$([ "$built" = "-" ] && printf null || printf '"%s"' "$built")" ;;
  'container rm '*)
    cid="$(last_arg "$@")"
    grep -q "^$cid	" "$ctrs" || { echo "no such container" >&2; exit 1; }
    grep -v "^$cid	" "$ctrs" >"$ctrs.tmp" || true
    mv "$ctrs.tmp" "$ctrs"; printf '%s\n' "$cid" ;;
  'image rm '*)
    ref="$(last_arg "$@")"
    if img_exists "$ref"; then
      id="$ref"
      if awk -F'\t' -v i="$id" 'BEGIN { r = 1 } $2 == i { r = 0 } END { exit r }' "$ctrs"; then
        echo "conflict: image is being used by a container" >&2; exit 1
      fi
      tags="$(img_field "$id" 2)"
      case "$tags" in
        *,*) echo "conflict: image is referenced in multiple repositories" >&2; exit 1 ;;
      esac
      grep -v "^$id	" "$imgs" >"$imgs.tmp" || true
      mv "$imgs.tmp" "$imgs"; echo "Deleted: $id"
    else
      row="$(awk -F'\t' -v t="$ref" '{ n = split($2, a, ","); for (i = 1; i <= n; i++) if (a[i] == t) { print $1; exit } }' "$imgs")"
      [ -n "$row" ] || { echo "no such image: $ref" >&2; exit 1; }
      tags="$(img_field "$row" 2)"
      case "$tags" in
        *,*)
          newtags="$(printf '%s\n' "$tags" | tr ',' '\n' | grep -vx "$ref" | paste -sd, -)"
          awk -F'\t' -v OFS='\t' -v id="$row" -v nt="$newtags" '$1 == id { $2 = nt } { print }' "$imgs" >"$imgs.tmp"
          mv "$imgs.tmp" "$imgs"; echo "Untagged: $ref"
          ;;
        *)
          if awk -F'\t' -v i="$row" 'BEGIN { r = 1 } $2 == i { r = 0 } END { exit r }' "$ctrs"; then
            echo "conflict: image is being used by a container" >&2; exit 1
          fi
          grep -v "^$row	" "$imgs" >"$imgs.tmp" || true
          mv "$imgs.tmp" "$imgs"; echo "Deleted: $row"
          ;;
      esac
    fi ;;
  'build '*)
    iid=""; tag=""; prev=""
    for a in "$@"; do
      case "$prev" in
        --iidfile) iid="$a" ;;
        -t) tag="$a" ;;
      esac
      prev="$a"
    done
    [ -n "$iid" ] && printf 'sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n' >"$iid"
    if [ -n "$tag" ]; then
      printf 'sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\t%s\ttrue\t2026-01-01T00:00:00Z\t2026-01-01T00:00:00Z\t1.0GB\n' "$tag" >>"$imgs"
    fi
    echo "stub build ok" ;;
  *'prune'*) echo pruned ;;
  *) exit 0 ;;
esac
SH
  chmod +x "$docker_stub_bin/docker"
  # A hermetic tool PATH for the missing-jq case: the stub plus symlinks to the
  # exact real tools the tidy and the scanner may use — and no jq.
  docker_tools_nojq="$out_dir/docker-tools-nojq"
  mkdir -p "$docker_tools_nojq"
  for docker_tool in awk bash cat cp cut date dirname grep head mkdir mktemp mv paste ps rm rmdir sed sleep sort stat tr wc; do
    docker_tool_path="$(command -v "$docker_tool")" \
      || fail "docker suite: required tool missing: $docker_tool"
    ln -s "$docker_tool_path" "$docker_tools_nojq/$docker_tool"
  done
  unset docker_tool docker_tool_path
  docker_state_init() {
    rm -rf "$1"
    mkdir -p "$1"
    : >"$1/images.tsv"
    : >"$1/containers.tsv"
    : >"$1/argv.log"
  }
  docker_run() {
    local state="$1" path_env="$2" script="$3"
    shift 3
    local script_path="home/dot_local/bin/executable_$script"
    if [[ "$script" == "groundwork-docker-build-scratch" ]]; then
      script_path="$docker_home/.local/bin/groundwork-docker-build-scratch"
    fi
    HOME="$docker_home" DOCKER_STATE="$state" PATH="$path_env" \
      /bin/bash "$script_path" "$@"
  }
  docker_run_automatic() {
    local state="$1" path_env="$2"
    shift 2
    env -u GROUNDWORK_DOCKER_LIB -u GROUNDWORK_MAINTENANCE_RUNNER_LIB \
      -u GROUNDWORK_DOCKER_TIDY_MAX_AGE_HOURS \
      -u DOCKER_HOST -u DOCKER_CONTEXT -u DOCKER_CONFIG \
      HOME="$docker_home" DOCKER_STATE="$state" PATH="$path_env" \
      /bin/bash home/dot_local/bin/executable_groundwork-docker-tidy --automatic "$@"
  }
  docker_now="$("$docker_stub_bin/date" -u +%Y-%m-%dT%H:%M:%SZ)"

  check "groundwork-doctor helper"
  test -x home/dot_local/bin/executable_groundwork-doctor
  # The doctor reuses the shared scanner — the four scratch-image counts come
  # from the same facts the tidy acts on, reported separately: a fresh in-grace
  # image is NOT a leftover.
  grep -qF 'lib/docker-scan.sh' home/dot_local/bin/executable_groundwork-doctor
  doctor_state="$out_dir/doctor-state"
  docker_state_init "$doctor_state"
  printf 'sha256:young9999\tgroundwork/scratch:fresh\ttrue\t%s\t%s\t500MB\n' \
    "$docker_now" "$docker_now" >"$doctor_state/images.tsv"
  printf 'c-plain\tsha256:otherbase\texited\told-c\t-\tExited (0) 3 days ago\n' >"$doctor_state/containers.tsv"
  printf 'vol1\nvol2\n' >"$doctor_state/volumes.txt"
  echo json-file >"$doctor_state/log-driver"
  docker_run "$doctor_state" "$docker_stub_bin:$PATH" groundwork-doctor --docker >"$out_dir/doctor-output"
  grep -qF 'read-only report; nothing is changed or deleted' "$out_dir/doctor-output"
  grep -qF "log-driver is 'json-file'" "$out_dir/doctor-output"
  grep -qF 'containerd image store is enabled' "$out_dir/doctor-output"
  grep -qF 'stopped containers: 1' "$out_dir/doctor-output"
  grep -qF 'dangling volumes:   2' "$out_dir/doctor-output"
  grep -qF 'tidy-eligible (past grace):     0' "$out_dir/doctor-output"
  grep -qF 'in grace (fresh, not leftover): 1' "$out_dir/doctor-output"
  grep -qF 'groundwork-docker-cache-tidy' "$out_dir/doctor-output"
  grep -qF "avoid blanket" "$out_dir/doctor-output"
  assert_no_matches "the doctor must never prune or remove" grep -n 'prune\|rm ' "$doctor_state/argv.log"
  # Old ad hoc Groundwork proof tags are visible for owner review, while the
  # documented runnable groundwork:latest tag and another project's test tag
  # are not guessed disposable. The doctor remains read-only.
  docker_state_init "$doctor_state"
  {
    printf 'sha256:legacy01\tgroundwork:test\t-\t-\t2001-01-01T00:00:00Z\t1.2GB\n'
    printf 'sha256:legacy02\tgroundwork:dust-test\t-\t-\t2001-01-01T00:00:00Z\t1.8GB\n'
    printf 'sha256:legacy03\tgroundwork:review-fix\t-\t-\t2001-01-01T00:00:00Z\t2.7GB\n'
    printf 'sha256:labeled1\tgroundwork:verify-labeled\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t2.1GB\n'
    printf 'sha256:runnable\tgroundwork:latest\t-\t-\t2001-01-01T00:00:00Z\t2.7GB\n'
    printf 'sha256:foreign1\tother:test\t-\t-\t2001-01-01T00:00:00Z\t3.0GB\n'
  } >"$doctor_state/images.tsv"
  docker_run "$doctor_state" "$docker_stub_bin:$PATH" groundwork-doctor --docker \
    >"$out_dir/doctor-legacy"
  grep -qF 'Legacy tagged validation images' "$out_dir/doctor-legacy"
  grep -qF 'groundwork:test' "$out_dir/doctor-legacy"
  grep -qF 'groundwork:dust-test' "$out_dir/doctor-legacy"
  grep -qF 'groundwork:review-fix' "$out_dir/doctor-legacy"
  grep -qF 'docker image rm groundwork:test' "$out_dir/doctor-legacy"
  assert_not_contains 'groundwork:latest|other:test|groundwork:verify-labeled' "$out_dir/doctor-legacy" \
    "doctor guessed a runnable, labeled, or foreign image was a legacy Groundwork proof build"
  assert_no_matches "legacy-image reporting must never remove an image" \
    grep -n 'image rm ' "$doctor_state/argv.log"
  # A machine whose only labeled image is fresh and in grace is CLEAN: no
  # cleanup guidance, because an in-grace image is not a leftover.
  docker_state_init "$doctor_state"
  printf 'sha256:young9999\tgroundwork/scratch:fresh\ttrue\t%s\t%s\t500MB\n' \
    "$docker_now" "$docker_now" >"$doctor_state/images.tsv"
  docker_run "$doctor_state" "$docker_stub_bin:$PATH" groundwork-doctor --docker >"$out_dir/doctor-fresh"
  grep -qF 'in grace (fresh, not leftover): 1' "$out_dir/doctor-fresh"
  assert_not_contains 'Cleanup guidance' "$out_dir/doctor-fresh" \
    "doctor flagged a fresh in-grace image as a leftover"
  # A failed query is "unknown", never silently zero.
  printf 'ps -aq --filter status=exited\n' >"$doctor_state/fail.conf"
  docker_run "$doctor_state" "$docker_stub_bin:$PATH" groundwork-doctor --docker >"$out_dir/doctor-unknown"
  grep -qF 'stopped containers: unknown' "$out_dir/doctor-unknown"
  rm -f "$doctor_state/fail.conf"
  # A failed labeled-image enumeration keeps all four scanner counts unknown;
  # it must never turn an unavailable observation into four clean zeroes.
  printf 'images --no-trunc --filter label=dev.roost.ephemeral=true\n' \
    >"$doctor_state/fail.conf"
  docker_run "$doctor_state" "$docker_stub_bin:$PATH" groundwork-doctor --docker \
    >"$out_dir/doctor-scan-unknown"
  grep -qF 'tidy-eligible (past grace):     unknown' "$out_dir/doctor-scan-unknown"
  grep -qF 'in grace (fresh, not leftover): unknown' "$out_dir/doctor-scan-unknown"
  grep -qF 'protected (tag/container ref):  unknown' "$out_dir/doctor-scan-unknown"
  grep -qF 'unverified (retained):          unknown' "$out_dir/doctor-scan-unknown"
  rm -f "$doctor_state/fail.conf"
  grep -qF 'groundwork-help doctor' < <(home/dot_local/bin/executable_groundwork-doctor --help)
  printf 'info\n' >"$doctor_state/fail.conf"
  docker_run "$doctor_state" "$docker_stub_bin:$PATH" groundwork-doctor --docker >"$out_dir/doctor-down"
  grep -qF 'Docker daemon not reachable' "$out_dir/doctor-down"
  assert_not_contains 'Disk usage' "$out_dir/doctor-down" "doctor probed a down docker daemon"
  if home/dot_local/bin/executable_groundwork-doctor --bogus >/dev/null 2>&1; then
    fail "groundwork-doctor accepted an unknown option"
  fi

  check "groundwork-docker-tidy helper"
  test -x home/dot_local/bin/executable_groundwork-docker-tidy
  grep -qF 'lib/docker-scan.sh' home/dot_local/bin/executable_groundwork-docker-tidy
  # The default tidy acts BY ENUMERATION only. No prune of any kind may even
  # appear in its source: candidate images are inspected, re-checked, and
  # deleted by explicit image ID.
  assert_no_matches "tidy must never hand deletion to a broad prune" \
    rg -n 'image prune|container prune|builder prune|system prune' \
    home/dot_local/bin/executable_groundwork-docker-tidy "$docker_lib"
  grep -qF '*/scratch:*' "$docker_lib"
  tidy_mixed_state() {
    # The policy-state fixture behind most scenarios, one image per rule:
    #   old1     old + labeled + scratch tag             -> eligible
    #   young1   labeled + scratch tag, built just now   -> retained (grace)
    #   hostile  ONE image ID tagged groundwork/scratch:review AND
    #            groundwork:latest (the retag hazard)    -> protected
    #   multi    two scratch tags on one image ID        -> ONE candidate
    #   runref   referenced by a RUNNING container       -> protected
    #   stopref  referenced by a STOPPED container       -> protected
    #   badts    malformed dev.roost.built               -> unverified
    #   nots     no dev.roost.built label                -> unverified
    #   dang1    unlabeled dangling image                -> not a candidate at all
    # plus two exited containers carrying the label: c-eph00 created long past
    # the grace (removed first) and c-ephyng created just now (retained — the
    # container grace policy matches the image grace policy).
    docker_state_init "$1"
    {
      printf 'sha256:old1000\tgroundwork/scratch:old\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00.000000000Z\t1.8GB\n'
      printf 'sha256:young100\tgroundwork/scratch:fresh\ttrue\t%s\t%s\t500MB\n' "$docker_now" "$docker_now"
      printf 'sha256:hostile0\tgroundwork/scratch:review,groundwork:latest\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t2.0GB\n'
      printf 'sha256:multi000\tgroundwork/scratch:a,groundwork/scratch:b\ttrue\t2001-01-02\t2001-01-02T00:00:00Z\t1.1GB\n'
      printf 'sha256:runref00\tgroundwork/scratch:runref\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t900MB\n'
      printf 'sha256:stopref0\tgroundwork/scratch:stopref\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t800MB\n'
      printf 'sha256:badts000\tgroundwork/scratch:badts\ttrue\tnot-a-date\t2001-01-01T00:00:00Z\t700MB\n'
      printf 'sha256:nots0000\tgroundwork/scratch:nots\ttrue\t-\t2001-01-01T00:00:00Z\t600MB\n'
      printf 'sha256:dang1000\t-\t-\t-\t2001-01-01T00:00:00Z\t300MB\n'
    } >"$1/images.tsv"
    {
      printf 'c-run00\tsha256:runref00\trunning\tkeeper\t-\tUp 2 hours\n'
      printf 'c-stop0\tsha256:stopref0\texited\tstopped-keeper\t-\tExited (0) 1 day ago\n'
      printf 'c-eph00\tsha256:otherbase\texited\ttidy-me\ttrue\tExited (0) 5 days ago\t2001-01-01T00:00:00.123456789Z\n'
      printf 'c-ephyng\tsha256:otherbase\texited\tfresh-exit\ttrue\tExited (0) 1 minute ago\t%s\n' "$docker_now"
    } >"$1/containers.tsv"
  }
  tidy_state="$out_dir/tidy-state"

  # Scenario: dry run. Every verdict appears with its reason; the copy never
  # claims "would remove"; nothing is mutated.
  tidy_mixed_state "$tidy_state"
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy >"$out_dir/tidy-dry"
  grep -qF 'dry run — nothing was changed' "$out_dir/tidy-dry"
  grep -F 'groundwork/scratch:old —' "$out_dir/tidy-dry" | grep -qF 'eligible'
  grep -F 'groundwork/scratch:fresh' "$out_dir/tidy-dry" | grep -qF 'retained'
  grep -F 'groundwork/scratch:fresh' "$out_dir/tidy-dry" | grep -qF 'grace'
  grep -F 'groundwork:latest' "$out_dir/tidy-dry" | grep -qF 'protected'
  grep -F 'groundwork:latest' "$out_dir/tidy-dry" | grep -qF 'tag outside the scratch namespace'
  grep -F 'groundwork/scratch:runref' "$out_dir/tidy-dry" | grep -qF 'keeper (running)'
  grep -F 'groundwork/scratch:stopref' "$out_dir/tidy-dry" | grep -qF 'stopped-keeper (exited)'
  grep -F 'groundwork/scratch:badts' "$out_dir/tidy-dry" | grep -qF 'unverified'
  grep -F 'groundwork/scratch:badts' "$out_dir/tidy-dry" | grep -qF 'malformed'
  grep -F 'groundwork/scratch:nots' "$out_dir/tidy-dry" | grep -qF 'unverified'
  test "$(grep -cF 'sha256:multi000' "$out_dir/tidy-dry")" = 1 \
    || fail "a multi-scratch-tag image must be ONE candidate, not one per tag"
  grep -qF 'counts: 1 eligible, 1 retained (in grace), 4 protected, 2 unverified.' "$out_dir/tidy-dry"
  grep -F 'groundwork/scratch:a, groundwork/scratch:b' "$out_dir/tidy-dry" \
    | grep -qF 'multiple scratch tags require owner or creating-session cleanup'
  grep -qF 'Docker may retain an item if another reference exists' "$out_dir/tidy-dry"
  # Containers get the SAME grace policy, and the dry run enumerates each with
  # id, name, age, and image — the old one eligible, the young one retained.
  grep -F 'tidy-me' "$out_dir/tidy-dry" | grep -qF 'eligible'
  grep -F 'fresh-exit' "$out_dir/tidy-dry" | grep -qF 'retained'
  grep -F 'fresh-exit' "$out_dir/tidy-dry" | grep -qF 'grace'
  grep -qF 'id c-eph00, age ' "$out_dir/tidy-dry"
  grep -qF 'image sha256:otherbase' "$out_dir/tidy-dry"
  grep -qF 'disposable only after the grace window' "$out_dir/tidy-dry"
  grep -qF 'Never touched' "$out_dir/tidy-dry"
  grep -qF 'groundwork-docker-cache-tidy' "$out_dir/tidy-dry"
  assert_not_contains 'would remove' "$out_dir/tidy-dry" \
    "dry run claimed 'would remove' — the vocabulary is eligible/retained/protected/unverified"
  assert_no_matches "tidy dry run must not remove or prune anything" \
    grep -nE ' rm |prune' "$tidy_state/argv.log"

  # Scenario: apply. The labeled stopped container past the grace goes first
  # (the young one is retained — same grace as images), each eligible image is
  # re-checked and deleted by explicit image ID, a multi-tag image is untagged
  # then ID-deleted once, and nothing protected, unverified, in grace,
  # unlabeled, or daemon-wide is touched.
  tidy_mixed_state "$tidy_state"
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes >"$out_dir/tidy-yes"
  grep -qF 'container rm c-eph00' "$tidy_state/argv.log"
  assert_no_matches "apply removed a young exited labeled container inside the grace" \
    grep -n 'container rm c-ephyng' "$tidy_state/argv.log"
  grep -qF 'c-ephyng' "$tidy_state/containers.tsv" \
    || fail "young exited labeled container vanished despite being inside the grace"
  grep -F 'fresh-exit' "$out_dir/tidy-yes" | grep -qF 'retained'
  grep -qF 'image rm sha256:old1000' "$tidy_state/argv.log"
  assert_no_matches "automatic tidy untagged or deleted a multi-tag scratch image" \
    grep -nE 'image rm (groundwork/scratch:b|sha256:multi000)' "$tidy_state/argv.log"
  if [[ "$(grep -n 'container rm c-eph00' "$tidy_state/argv.log" | cut -d: -f1)" -gt "$(grep -n 'image rm' "$tidy_state/argv.log" | head -n 1 | cut -d: -f1)" ]]; then
    fail "the labeled exited container must be removed BEFORE image deletion"
  fi
  for tidy_kept in hostile0 runref00 stopref0 young100 badts000 nots0000 dang1000; do
    assert_no_matches "apply deleted a non-eligible image (sha256:$tidy_kept)" \
      grep -n "image rm sha256:$tidy_kept" "$tidy_state/argv.log"
  done
  unset tidy_kept
  assert_no_matches "default --yes must not prune anything (no dangling/builder/daemon-wide cleanup)" \
    grep -n 'prune' "$tidy_state/argv.log"
  assert_no_matches "tidy must never touch volumes" grep -n 'volume' "$tidy_state/argv.log"
  grep -qF 'removed 1 container(s) and 1 image(s)' "$out_dir/tidy-yes"
  if grep -qF 'sha256:old1000' "$tidy_state/images.tsv"; then
    fail "eligible image survived apply"
  fi
  grep -qF 'sha256:hostile0' "$tidy_state/images.tsv" || fail "protected image was deleted"
  grep -qF 'sha256:multi000' "$tidy_state/images.tsv" || fail "multi-tag scratch image was deleted"
  grep -qF 'sha256:dang1000' "$tidy_state/images.tsv" || fail "unlabeled dangling image was deleted"

  # Scenario: the apply-time re-check. The image is eligible at scan time; the
  # trip hook retags it groundwork:latest just before the re-check reads it, so
  # deletion must be refused.
  docker_state_init "$tidy_state"
  printf 'sha256:reck0000\tgroundwork/scratch:reck\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.5GB\n' \
    >"$tidy_state/images.tsv"
  printf 'sha256:reck0000\tgroundwork/scratch:reck,groundwork:latest\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.5GB\n' \
    >"$tidy_state/images-tripped.tsv"
  cat >"$tidy_state/trip.conf" <<EOF
TRIP_SUBSTR='image inspect sha256:reck0000'
TRIP_AT=2
TRIP_IMAGES=$tidy_state/images-tripped.tsv
EOF
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes >"$out_dir/tidy-recheck"
  grep -qF 'state changed since the scan' "$out_dir/tidy-recheck"
  assert_no_matches "apply deleted a candidate that changed after the scan" \
    grep -n 'image rm' "$tidy_state/argv.log"
  grep -qF 'sha256:reck0000' "$tidy_state/images.tsv" || fail "re-check failed to protect the retagged image"

  # Every deletion fact comes from one complete image inspection. Missing
  # RepoTags, a generic first-inspect error, or a failed apply-time recheck makes
  # the scan incomplete and cannot remove even one tag.
  docker_state_init "$tidy_state"
  printf 'sha256:notags01\tgroundwork:latest\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t2.0GB\n' \
    >"$tidy_state/images.tsv"
  printf 'sha256:notags01\n' >"$tidy_state/inspect-omit-repotags"
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-incomplete-tags" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -ne 0 ]] || fail "an image inspection without RepoTags returned success"
  assert_no_matches "an incomplete RepoTags observation removed or untagged the image" \
    grep -n 'image rm' "$tidy_state/argv.log"
  grep -qF 'groundwork:latest' "$tidy_state/images.tsv" \
    || fail "an incomplete RepoTags observation deleted the real image tag"

  docker_state_init "$tidy_state"
  printf 'sha256:inspect1\tgroundwork/scratch:inspect\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n' \
    >"$tidy_state/images.tsv"
  printf 'image inspect sha256:inspect1\n' >"$tidy_state/fail.conf"
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-first-inspect-failure" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -ne 0 ]] || fail "a generic first image-inspect failure returned success"
  assert_no_matches "a generic first image-inspect failure still deleted the image" \
    grep -n 'image rm' "$tidy_state/argv.log"
  rm -f "$tidy_state/fail.conf"

  docker_state_init "$tidy_state"
  printf 'sha256:recheck1\tgroundwork/scratch:recheck-fail\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n' \
    >"$tidy_state/images.tsv"
  cat >"$tidy_state/trip.conf" <<EOF
TRIP_SUBSTR='image inspect sha256:recheck1'
TRIP_AT=1
TRIP_FAIL_PATTERN='image inspect sha256:recheck1'
EOF
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-recheck-inspect-failure" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -ne 0 ]] || fail "a failed authoritative recheck returned success"
  grep -qF 'authoritative image inspection was incomplete' \
    "$out_dir/tidy-recheck-inspect-failure"
  assert_no_matches "a failed authoritative recheck still deleted the image" \
    grep -n 'image rm' "$tidy_state/argv.log"
  rm -f "$tidy_state/trip.conf" "$tidy_state/trip.count" "$tidy_state/fail.conf"

  # A listed container is a mandatory reference fact. If its inspect fails, the
  # full snapshot is incomplete and a multi-tag scratch image must not even be
  # partially untagged before Docker's final reference check.
  docker_state_init "$tidy_state"
  printf 'sha256:referr01\tgroundwork/scratch:ref-a,groundwork/scratch:ref-b\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n' \
    >"$tidy_state/images.tsv"
  printf 'c-referr\tsha256:referr01\texited\tinspect-fails\t-\tExited (0) 3 days ago\t2001-01-01T00:00:00Z\n' \
    >"$tidy_state/containers.tsv"
  printf 'container inspect --format {{.Image}}\n' >"$tidy_state/fail.conf"
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-reference-inspect-failure" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -ne 0 ]] || fail "a failed container-reference inspection returned success"
  assert_no_matches "an incomplete container-reference snapshot removed a tag" \
    grep -n 'image rm' "$tidy_state/argv.log"
  grep -qF 'groundwork/scratch:ref-a,groundwork/scratch:ref-b' "$tidy_state/images.tsv" \
    || fail "an incomplete reference snapshot partially changed the image tags"
  rm -f "$tidy_state/fail.conf" "$tidy_state/inspect-omit-repotags"

  # Scenario: the container re-check. An old exited labeled container is
  # eligible at scan time; the trip hook restarts it just before the pre-rm
  # status re-check reads it, so removal must be refused.
  docker_state_init "$tidy_state"
  printf 'c-trip00\tsha256:otherbase\texited\ttrip-me\ttrue\tExited (0) 9 days ago\t2001-01-01T00:00:00Z\n' \
    >"$tidy_state/containers.tsv"
  printf 'c-trip00\tsha256:otherbase\trunning\ttrip-me\ttrue\tUp 1 second\t2001-01-01T00:00:00Z\n' \
    >"$tidy_state/containers-tripped.tsv"
  cat >"$tidy_state/trip.conf" <<EOF
TRIP_SUBSTR='container inspect --format {{.Created}}'
TRIP_AT=2
TRIP_CONTAINERS=$tidy_state/containers-tripped.tsv
EOF
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes >"$out_dir/tidy-ctr-recheck"
  grep -qF 'state changed since the scan' "$out_dir/tidy-ctr-recheck"
  assert_no_matches "apply removed a container whose status changed after the scan" \
    grep -n 'container rm' "$tidy_state/argv.log"
  grep -qF 'c-trip00' "$tidy_state/containers.tsv" || fail "status re-check failed to protect the restarted container"
  rm -f "$tidy_state/trip.conf" "$tidy_state/trip.count"

  # A failed exited-container inspect has three states. A fresh complete listing
  # that omits the ID proves a race-to-absence; an ID that remains listed (or an
  # unavailable relist) makes cleanup incomplete and records pending state.
  docker_state_init "$tidy_state"
  printf 'c-gone00\tsha256:otherbase\texited\tdisappears\ttrue\tExited (0) 9 days ago\t2001-01-01T00:00:00Z\n' \
    >"$tidy_state/containers.tsv"
  : >"$tidy_state/containers-gone.tsv"
  cat >"$tidy_state/trip.conf" <<EOF
TRIP_SUBSTR='container inspect --format {{.Created}}'
TRIP_AT=1
TRIP_CONTAINERS=$tidy_state/containers-gone.tsv
EOF
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-ctr-disappeared"
  grep -qF 'already gone' "$out_dir/tidy-ctr-disappeared" \
    || grep -qF 'no longer present' "$out_dir/tidy-ctr-disappeared"
  assert_no_matches "a container proven absent was still sent to docker rm" \
    grep -n 'container rm c-gone00' "$tidy_state/argv.log"
  rm -f "$tidy_state/trip.conf" "$tidy_state/trip.count"

  docker_state_init "$tidy_state"
  printf 'c-still0\tsha256:otherbase\texited\tinspect-unavailable\ttrue\tExited (0) 9 days ago\t2001-01-01T00:00:00Z\n' \
    >"$tidy_state/containers.tsv"
  printf 'container inspect --format {{.Created}}\n' >"$tidy_state/fail.conf"
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-ctr-inspect-incomplete" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -ne 0 ]] \
    || fail "a still-listed container with failed inspect returned success"
  grep -qF 'current container facts could not be completed' \
    "$out_dir/tidy-ctr-inspect-incomplete"
  grep -qF 'c-still0' "$tidy_state/containers.tsv" \
    || fail "an incompletely observed container was removed"
  test -f "$docker_pending_file" \
    || fail "incomplete exited-container observation recorded no pending state"
  rm -f "$tidy_state/fail.conf" "$docker_pending_file"

  # Multiple scratch tags are owner/session cleanup, never an automatic untag.
  # Both tag relations and the image ID survive an acting pass unchanged.
  docker_state_init "$tidy_state"
  printf 'sha256:parti000\tgroundwork/scratch:pa,groundwork/scratch:pb\ttrue\t2001-01-02\t2001-01-02T00:00:00Z\t1.1GB\n' \
    >"$tidy_state/images.tsv"
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy \
    >"$out_dir/tidy-multitag-protected"
  grep -qF 'multiple scratch tags require owner or creating-session cleanup' \
    "$out_dir/tidy-multitag-protected"
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-multitag-yes"
  assert_no_matches "acting tidy mutated a protected multi-tag image" \
    grep -n 'image rm' "$tidy_state/argv.log"
  grep -qxF $'sha256:parti000\tgroundwork/scratch:pa,groundwork/scratch:pb\ttrue\t2001-01-02\t2001-01-02T00:00:00Z\t1.1GB' \
    "$tidy_state/images.tsv" || fail "acting tidy changed protected multi-tag state"

  # Scenario: no jq. Age cannot be verified, so the verdict is unverified —
  # retained and explained, never "would remove", and never deleted.
  tidy_nojq_state="$out_dir/tidy-nojq-state"
  docker_state_init "$tidy_nojq_state"
  printf 'sha256:oldnojq0\tgroundwork/scratch:nojq\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.8GB\n' \
    >"$tidy_nojq_state/images.tsv"
  printf 'c-nojq00\tsha256:otherbase\texited\tnojq-c\ttrue\tExited (0) 9 days ago\t2001-01-01T00:00:00Z\n' \
    >"$tidy_nojq_state/containers.tsv"
  docker_run "$tidy_nojq_state" "$docker_stub_bin:$docker_tools_nojq" groundwork-docker-tidy >"$out_dir/tidy-nojq"
  grep -F 'sha256:oldnojq0' "$out_dir/tidy-nojq" | grep -qF 'unverified'
  grep -F 'nojq-c' "$out_dir/tidy-nojq" | grep -qF 'unverified'
  grep -qF 'jq' "$out_dir/tidy-nojq"
  grep -qF 'counts: 0 eligible, 0 retained (in grace), 0 protected, 1 unverified.' "$out_dir/tidy-nojq"
  assert_not_contains 'would remove' "$out_dir/tidy-nojq" \
    "an unverifiable image must never be presented as removable"
  docker_run "$tidy_nojq_state" "$docker_stub_bin:$docker_tools_nojq" groundwork-docker-tidy --yes >/dev/null
  assert_no_matches "apply deleted an image whose age could not be verified (no jq)" \
    grep -n 'image rm' "$tidy_nojq_state/argv.log"
  assert_no_matches "apply removed a container whose age could not be verified (no jq)" \
    grep -n 'container rm' "$tidy_nojq_state/argv.log"

  # --summary nudges on eligible/unverified leftovers and stays silent when the
  # only labeled image is fresh and in grace.
  tidy_mixed_state "$tidy_state"
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --summary >"$out_dir/tidy-summary"
  grep -qF 'tidy-eligible' "$out_dir/tidy-summary"
  # Only the past-grace container counts; the young exited one is not a leftover.
  grep -qF '1 tidy-eligible exited ephemeral container(s)' "$out_dir/tidy-summary"
  grep -qF 'groundwork-docker-tidy --yes' "$out_dir/tidy-summary"
  assert_no_matches "tidy --summary must not remove or prune anything" \
    grep -nE ' rm |prune' "$tidy_state/argv.log"
  docker_state_init "$tidy_state"
  printf 'sha256:young9999\tgroundwork/scratch:fresh\ttrue\t%s\t%s\t500MB\n' \
    "$docker_now" "$docker_now" >"$tidy_state/images.tsv"
  printf 'c-ephyng\tsha256:otherbase\texited\tfresh-exit\ttrue\tExited (0) 1 minute ago\t%s\n' \
    "$docker_now" >"$tidy_state/containers.tsv"
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --summary >"$out_dir/tidy-summary-clean"
  test ! -s "$out_dir/tidy-summary-clean"
  # Read-only modes also distinguish an incomplete observation from a clean
  # zero result. They never mutate pending state, but they return nonzero so a
  # caller cannot publish an unproved clean receipt.
  printf 'images --no-trunc --filter label=dev.roost.ephemeral=true\n' \
    >"$tidy_state/fail.conf"
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy \
    >"$out_dir/tidy-dry-scan-failure" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 1 ]] || fail "an incomplete Docker dry-run scan returned $tidy_status"
  grep -qF 'reported as unknown, not zero' "$out_dir/tidy-dry-scan-failure"
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --summary \
    >"$out_dir/tidy-summary-scan-failure" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 1 ]] || fail "an incomplete Docker summary returned $tidy_status"
  rm -f "$tidy_state/fail.conf"

  # Daemon down, option hygiene, conflicting modes, garbled policy env, and the
  # missing shared scanner all fail the safe way.
  docker_state_init "$tidy_state"
  printf 'info\n' >"$tidy_state/fail.conf"
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy >"$out_dir/tidy-down"
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 3 ]] \
    || fail "an unavailable Docker daemon returned $tidy_status, expected 3"
  grep -qF 'Docker daemon not reachable' "$out_dir/tidy-down"
  rm -f "$tidy_state/fail.conf"

  # Unavailable is an explicit status, not proof that older work completed. With
  # no prior pending record it is an honest skip; with one, the exact record is
  # retained until cleanup succeeds or the owner explicitly acknowledges that
  # Docker was removed.
  rm -f "$docker_pending_file"
  printf 'info\n' >"$tidy_state/fail.conf"
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-down-no-pending" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 3 ]] || fail "acting tidy did not preserve unavailable status 3"
  test ! -e "$docker_pending_file" \
    || fail "an unavailable daemon invented new pending state without attempted cleanup"
  mkdir -p "$(dirname "$docker_pending_file")"
  printf 'old failure must survive\n' >"$docker_pending_file"
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-down-with-pending" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 3 ]] || fail "pending unavailable tidy did not return status 3"
  grep -qxF 'old failure must survive' "$docker_pending_file" \
    || fail "an unavailable daemon falsely cleared or rewrote prior Docker failure state"
  rm -f "$tidy_state/fail.conf"
  : >"$tidy_state/argv.log"
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy \
    --yes --clear-pending >"$out_dir/tidy-clear-pending"
  test ! -e "$docker_pending_file" || fail "explicit Docker acknowledgement left the reminder active"
  grep -qF 'No Docker cleanup was performed' "$out_dir/tidy-clear-pending"
  grep -qF 'owner\ cleared\ Docker\ reminder\ without\ running\ cleanup:' \
    "$docker_home/.local/state/groundwork/docker-tidy-pending-cleared.log"
  test ! -s "$tidy_state/argv.log" \
    || fail "Docker pending acknowledgement queried or mutated the daemon"

  # Automatic mode uses the managed scanner, canonical grace, and a verified
  # local endpoint. It removes an eligible opted-in image, but refuses both a
  # remote context and ambient attempts to redirect its code or policy.
  docker_trust_home="$out_dir/docker-trust-home"
  docker_fake_bin="$out_dir/docker-fake-bin"
  docker_fake_marker="$out_dir/docker-fake-ran"
  mkdir -p "$docker_trust_home/.local/lib/groundwork" \
    "$docker_trust_home/.local/share/groundwork/lib" "$docker_fake_bin"
  cp home/dot_local/lib/groundwork/update-lock.sh \
    "$docker_trust_home/.local/lib/groundwork/update-lock.sh"
  cp "$docker_lib" "$docker_trust_home/.local/share/groundwork/lib/docker-scan.sh"
  cp "$docker_runner_lib" \
    "$docker_trust_home/.local/share/groundwork/lib/maintenance-runner.sh"
  cat >"$docker_fake_bin/docker" <<EOF
#!/bin/sh
printf ran >'$docker_fake_marker'
exit 0
EOF
  chmod +x "$docker_fake_bin/docker"
  set +e
  HOME="$docker_trust_home" PATH="$docker_fake_bin:/usr/bin:/bin" \
    /bin/bash home/dot_local/bin/executable_groundwork-docker-tidy --automatic \
    >"$out_dir/tidy-untrusted-docker" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 3 ]] || fail "automatic mode accepted a repository-controlled Docker executable"
  grep -qF 'no trusted Docker CLI was found' "$out_dir/tidy-untrusted-docker"
  test ! -e "$docker_fake_marker" || fail "automatic mode invoked an untrusted Docker executable"

  # Canonicalization itself runs before Docker's process bound, so it must be
  # finite even when a platform-owned executable link is broken or cyclic.
  resolver_state="$out_dir/docker-resolver-links"
  mkdir -p "$resolver_state"
  ln -s self "$resolver_state/self"
  ln -s two-b "$resolver_state/two-a"
  ln -s two-a "$resolver_state/two-b"
  ln -s missing "$resolver_state/broken"
  ln -s /bin/sh "$resolver_state/good-target"
  ln -s good-target "$resolver_state/good-relative"
  for resolver_bad in self two-a broken; do
    if RESOLVER_PATH="$resolver_state/$resolver_bad" DOCKER_LIB="$docker_lib" /bin/bash -c '
    source "$DOCKER_LIB"
    gw_docker_canonical_executable "$RESOLVER_PATH"
  ' >/dev/null 2>&1; then
      fail "trusted-executable canonicalization accepted $resolver_bad symlink state"
    fi
  done
  resolver_good="$(RESOLVER_PATH="$resolver_state/good-relative" DOCKER_LIB="$docker_lib" /bin/bash -c '
  source "$DOCKER_LIB"
  gw_docker_canonical_executable "$RESOLVER_PATH"
')"
  resolver_expected="$(DOCKER_LIB="$docker_lib" /bin/bash -c '
  source "$DOCKER_LIB"
  gw_docker_canonical_executable /bin/sh
')"
  [[ -n "$resolver_expected" && "$resolver_good" == "$resolver_expected" ]] \
    || fail "trusted-executable canonicalization rejected a legitimate relative link chain"
  for resolver_hop in {41..1}; do
    if [[ "$resolver_hop" -eq 41 ]]; then
      ln -s /bin/sh "$resolver_state/hop-$resolver_hop"
    else
      ln -s "hop-$((resolver_hop + 1))" "$resolver_state/hop-$resolver_hop"
    fi
  done
  if RESOLVER_PATH="$resolver_state/hop-1" DOCKER_LIB="$docker_lib" /bin/bash -c '
  source "$DOCKER_LIB"
  gw_docker_canonical_executable "$RESOLVER_PATH"
' >/dev/null 2>&1; then
    fail "trusted-executable canonicalization followed more than 40 symlinks"
  fi
  unset resolver_bad resolver_expected resolver_good resolver_hop

  docker_state_init "$tidy_state"
  printf 'sha256:auto0001\tgroundwork/scratch:auto\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.5GB\n' \
    >"$tidy_state/images.tsv"
  docker_run_automatic "$tidy_state" "$docker_stub_bin:$PATH" >"$out_dir/tidy-automatic"
  grep -qF 'image rm sha256:auto0001' "$tidy_state/argv.log"
  test ! -s "$tidy_state/images.tsv" || fail "automatic mode left an eligible scratch image"
  test ! -e "$docker_pending_file" || fail "successful automatic mode left pending state"

  docker_state_init "$tidy_state"
  printf 'tcp://shared.example:2376\n' >"$tidy_state/context-host"
  set +e
  docker_run_automatic "$tidy_state" "$docker_stub_bin:$PATH" >"$out_dir/tidy-remote" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 3 ]] || fail "automatic mode did not refuse a remote endpoint with status 3"
  grep -qF 'refuses non-local Docker endpoint' "$out_dir/tidy-remote"
  assert_no_matches "automatic mode queried or deleted through a refused remote endpoint" \
    grep -nE '^info$|image rm|container rm' "$tidy_state/argv.log"

  # Endpoint text is untrusted daemon metadata. Embedded line/control content is
  # rejected before it can enter pending state or terminal output.
  docker_state_init "$tidy_state"
  printf 'unix:///var/run/docker.sock\nforged-endpoint-line' >"$tidy_state/context-host"
  set +e
  docker_run_automatic "$tidy_state" "$docker_stub_bin:$PATH" \
    >"$out_dir/tidy-hostile-endpoint" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 3 ]] || fail "automatic mode accepted a multiline Docker endpoint"
  grep -qF 'unsafe or incomplete Docker endpoint' "$out_dir/tidy-hostile-endpoint"
  assert_not_contains 'forged-endpoint-line' "$out_dir/tidy-hostile-endpoint" \
    "hostile Docker endpoint content reached terminal output"
  test ! -e "$docker_pending_file" \
    || fail "hostile Docker endpoint content reached pending state"
  assert_no_matches "hostile endpoint validation reached Docker info or mutation" \
    grep -nE '^info$|image rm|container rm' "$tidy_state/argv.log"

  docker_state_init "$tidy_state"
  for automatic_override in \
    'GROUNDWORK_DOCKER_LIB=/tmp/repository-controlled-scan.sh' \
    'GROUNDWORK_MAINTENANCE_RUNNER_LIB=/tmp/repository-controlled-runner.sh' \
    'GROUNDWORK_DOCKER_TIDY_MAX_AGE_HOURS=1' \
    'GROUNDWORK_DOCKER_TOTAL_DEADLINE_SECONDS=1' \
    'DOCKER_HOST=tcp://shared.example:2376' \
    'DOCKER_CONTEXT=project-context' \
    'DOCKER_CONFIG=/tmp/repository-docker-config'; do
    : >"$tidy_state/argv.log"
    set +e
    env HOME="$docker_home" DOCKER_STATE="$tidy_state" PATH="$docker_stub_bin:$PATH" \
      "$automatic_override" \
      /bin/bash home/dot_local/bin/executable_groundwork-docker-tidy --automatic \
      >"$out_dir/tidy-ambient-refused" 2>&1
    tidy_status=$?
    set -e
    [[ "$tidy_status" -eq 3 ]] \
      || fail "automatic mode accepted ambient override: $automatic_override"
    automatic_name="${automatic_override%%=*}"
    grep -qF "refuses ambient $automatic_name" "$out_dir/tidy-ambient-refused"
    test ! -s "$tidy_state/argv.log" \
      || fail "automatic mode reached Docker after refusing $automatic_name"
  done
  unset automatic_override automatic_name

  # The recommended maintenance-only retry uses the same canonical code, grace,
  # endpoint rule, and pending namespace as update-all. Ambient daemon or policy
  # selectors are refused before Docker is queried and cannot clear an older
  # local automatic record.
  docker_state_init "$tidy_state"
  mkdir -p "$(dirname "$docker_pending_file")"
  printf 'local automatic failure must survive\n' >"$docker_pending_file"
  set +e
  HOME="$docker_home" DOCKER_STATE="$tidy_state" PATH="$docker_stub_bin:$PATH" \
    DOCKER_HOST=tcp://shared.example:2376 \
    /bin/bash home/dot_local/bin/executable_groundwork-docker-tidy --yes \
    >"$out_dir/tidy-direct-ambient-refused" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 3 ]] \
    || fail "the routine direct repair accepted an ambient remote Docker host"
  grep -qxF 'local automatic failure must survive' "$docker_pending_file" \
    || fail "a refused noncanonical direct repair altered local pending state"
  test ! -s "$tidy_state/argv.log" \
    || fail "a noncanonical direct repair reached Docker before refusal"

  # Acting mode is a single writer. An already-held update lock returns 75
  # before the helper performs even a Docker query.
  docker_state_init "$tidy_state"
  docker_lock_dir="$docker_home/.local/state/groundwork/update-all.lock"
  rm -rf "$docker_lock_dir"

  # Failure to persist pre-mutation intent aborts before any removal, but the
  # EXIT path still releases an owned lock and cleans its temporary state.
  docker_state_init "$tidy_state"
  rm -f "$docker_pending_file"
  mkdir -p "$docker_pending_file"
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-pending-write-failure" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -ne 0 ]] || fail "a failed Docker pending-state write returned success"
  grep -qF 'could not persist intent before Docker cleanup' \
    "$out_dir/tidy-pending-write-failure"
  assert_no_matches "Docker mutation occurred without durable pre-mutation intent" \
    grep -nE 'image rm|container rm' "$tidy_state/argv.log"
  test ! -d "$docker_lock_dir" \
    || fail "a failed Docker pending-state write left the machine lock behind"
  rmdir "$docker_pending_file"

  # A helper invoked as update-all's direct child validates and borrows the
  # inherited lock token. It does not race a second lock or release its parent's
  # transaction when the Docker lane completes.
  docker_state_init "$tidy_state"
  mkdir -p "$docker_lock_dir"
  docker_lock_start="$(LC_ALL=C ps -o lstart= -p "$$" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  printf '%s\n' "$$" >"$docker_lock_dir/pid"
  printf '2001-01-01T00:00:00Z\n' >"$docker_lock_dir/started-at"
  printf 'update-all\n' >"$docker_lock_dir/operation"
  printf 'borrow-token\n' >"$docker_lock_dir/token"
  printf '%s\n' "$docker_lock_start" >"$docker_lock_dir/process-start"
  GROUNDWORK_UPDATE_LOCK_HELD=1 GROUNDWORK_UPDATE_LOCK_TOKEN=borrow-token \
    docker_run_automatic "$tidy_state" "$docker_stub_bin:$PATH" \
    >"$out_dir/tidy-lock-borrowed"
  test -d "$docker_lock_dir" \
    || fail "a borrowed Docker tidy released update-all's parent-owned lock"
  grep -qxF 'borrow-token' "$docker_lock_dir/token"
  rm -rf "$docker_lock_dir"
  : >"$tidy_state/argv.log"
  mkdir -p "$docker_lock_dir"
  docker_lock_start="$(LC_ALL=C ps -o lstart= -p "$$" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  printf '%s\n' "$$" >"$docker_lock_dir/pid"
  printf '2001-01-01T00:00:00Z\n' >"$docker_lock_dir/started-at"
  printf 'update-all\n' >"$docker_lock_dir/operation"
  printf 'validator-token\n' >"$docker_lock_dir/token"
  printf '%s\n' "$docker_lock_start" >"$docker_lock_dir/process-start"
  set +e
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-lock-busy" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 75 ]] || fail "a concurrent acting Docker tidy returned $tidy_status, expected 75"
  test ! -s "$tidy_state/argv.log" || fail "a lock-refused Docker tidy queried the daemon"
  rm -rf "$docker_lock_dir"

  check "groundwork-docker-tidy: real deadline, signal, and process-tree runtime"
  install_fixture_runtime_runner \
    "$docker_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_runtime_clock "$docker_stub_bin/date"

  # A stalled Docker observation is bounded as a process group. The helper kills
  # its descendant, returns 124, and preserves pending repair state.
  docker_state_init "$tidy_state"
  docker_timeout_pid_file="$tidy_state/delayed-child.pid"
  docker_timeout_sentinel="$tidy_state/delayed-command.started"
  cat >"$tidy_state/delay.conf" <<EOF
DELAY_SUBSTR='images --no-trunc --filter label=dev.roost.ephemeral=true'
DELAY_SPAWN_DESCENDANT=1
DELAY_DESCENDANT_SECONDS=30
DELAY_PID_FILE='$docker_timeout_pid_file'
DELAY_SENTINEL='$docker_timeout_sentinel'
EOF
  set +e
  GROUNDWORK_DOCKER_OBSERVE_DEADLINE_SECONDS=5 \
    GROUNDWORK_DOCKER_CANCEL_GRACE_SECONDS=1 GROUNDWORK_DOCKER_POLL_SECONDS=0.1 \
    docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-timeout" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 124 ]] || fail "a stalled Docker observation returned $tidy_status, expected 124"
  test -f "$docker_timeout_sentinel" \
    || fail "the Docker timeout fixture did not reach the intended stalled image listing"
  grep -qF 'exceeded its 5s hard deadline' "$out_dir/tidy-timeout"
  test -f "$docker_pending_file" || fail "a timed-out Docker tidy recorded no pending state"
  docker_timeout_pid="$(<"$docker_timeout_pid_file")"
  for _ in {1..20}; do
    docker_timeout_state="$(ps -o stat= -p "$docker_timeout_pid" 2>/dev/null | tr -d '[:space:]' || true)"
    [[ -z "$docker_timeout_state" || "$docker_timeout_state" == Z* ]] && break
    sleep 0.1
  done
  [[ -z "$docker_timeout_state" || "$docker_timeout_state" == Z* ]] \
    || fail "a Docker CLI descendant survived the helper deadline"
  rm -f "$tidy_state/delay.conf"
  docker_state_init "$tidy_state"
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes >/dev/null
  test ! -e "$docker_pending_file" || fail "successful retry did not clear timeout pending state"

  # Per-call bounds are not the lane bound: enough individually healthy slow
  # candidates must exhaust the total budget before their cumulative runtime can
  # stretch update-all indefinitely.
  docker_state_init "$tidy_state"
  for total_candidate in 1 2 3 4 5; do
    printf 'sha256:total000%s\tgroundwork/scratch:total-%s\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n' \
      "$total_candidate" "$total_candidate" >>"$tidy_state/images.tsv"
  done
  total_deadline_sentinel="$tidy_state/total-deadline-candidate.started"
  cat >"$tidy_state/delay.conf" <<EOF
DELAY_SUBSTR='image inspect sha256:total'
DELAY_AFTER=5
DELAY_SECONDS=30
DELAY_SENTINEL='$total_deadline_sentinel'
EOF
  set +e
  GROUNDWORK_DOCKER_OBSERVE_DEADLINE_SECONDS=30 \
    GROUNDWORK_DOCKER_TOTAL_DEADLINE_SECONDS=20 \
    GROUNDWORK_DOCKER_POLL_SECONDS=0.1 \
    docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-total-deadline" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 124 ]] \
    || fail "many individually bounded Docker candidates returned $tidy_status instead of total-deadline status 124"
  test -f "$total_deadline_sentinel" \
    || fail "the total-deadline fixture expired before reaching the intended post-enumeration candidate"
  grep -qF 'total Docker lane deadline expired' "$out_dir/tidy-total-deadline"
  grep -qE 'Progress: [0-4] of 5 eligible-image candidates completed; [1-5] remained\.' \
    "$out_dir/tidy-total-deadline" \
    || fail "the total Docker deadline did not report completed and remaining candidates"
  [[ "$(grep -c '^image rm sha256:total' "$tidy_state/argv.log" || true)" -lt 5 ]] \
    || fail "the total Docker deadline allowed every slow candidate to be mutated"
  test -f "$docker_pending_file" || fail "the total Docker lane deadline recorded no pending state"
  unset total_candidate
  rm -f "$tidy_state/delay.conf"
  docker_state_init "$tidy_state"
  docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes >/dev/null
  test ! -e "$docker_pending_file" || fail "successful retry did not clear total-deadline pending state"

  # Terminal Docker statuses stop the transaction immediately. No later query
  # or mutation may run after a timeout or owner cancellation.
  docker_state_init "$tidy_state"
  printf 'sha256:termlist\tgroundwork/scratch:term-list\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n' \
    >"$tidy_state/images.tsv"
  tidy_term_sentinel="$tidy_state/exited-list.started"
  cat >"$tidy_state/delay.conf" <<EOF
DELAY_SUBSTR='ps -a --no-trunc --filter status=exited'
DELAY_SECONDS=30
DELAY_SENTINEL='$tidy_term_sentinel'
EOF
  # Launch the helper itself in the background so the recorded PID owns both the
  # signal trap and the maintenance lock. Backgrounding docker_run would record
  # an intermediate function subshell and could kill that wrapper instead.
  HOME="$docker_home" DOCKER_STATE="$tidy_state" PATH="$docker_stub_bin:$PATH" \
    /bin/bash home/dot_local/bin/executable_groundwork-docker-tidy --yes \
    >"$out_dir/tidy-term-exited-list" 2>&1 &
  tidy_signal_pid=$!
  for _ in {1..100}; do
    [[ -f "$tidy_term_sentinel" ]] && break
    sleep 0.1
  done
  test -f "$tidy_term_sentinel" || fail "TERM fixture never reached exited-container listing"
  kill -TERM "$tidy_signal_pid"
  set +e
  wait "$tidy_signal_pid"
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 143 ]] || fail "TERM during exited-container listing returned $tidy_status"
  test ! -d "$docker_lock_dir" \
    || fail "TERM during exited-container listing left the machine lock behind"
  assert_no_matches "TERM during exited-container listing allowed later image work" \
    grep -nE 'images --no-trunc|image rm' "$tidy_state/argv.log"

  docker_state_init "$tidy_state"
  printf 'sha256:firstinspect\tgroundwork/scratch:first-inspect\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n' \
    >"$tidy_state/images.tsv"
  first_inspect_sentinel="$tidy_state/first-inspect.started"
  cat >"$tidy_state/delay.conf" <<EOF
DELAY_SUBSTR='image inspect sha256:firstinspect'
DELAY_SECONDS=30
DELAY_SENTINEL='$first_inspect_sentinel'
EOF
  set +e
  GROUNDWORK_DOCKER_OBSERVE_DEADLINE_SECONDS=5 \
    GROUNDWORK_DOCKER_CANCEL_GRACE_SECONDS=1 GROUNDWORK_DOCKER_POLL_SECONDS=0.1 \
    docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-timeout-first-inspect" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 124 ]] || fail "first image-inspect timeout returned $tidy_status"
  test -f "$first_inspect_sentinel" \
    || fail "the image-inspect timeout fixture did not reach the intended stalled command"
  first_inspect_line="$(grep -nF 'image inspect sha256:firstinspect' "$tidy_state/argv.log" | head -n 1 | cut -d: -f1)"
  [[ "$(wc -l <"$tidy_state/argv.log" | tr -d '[:space:]')" -eq "$first_inspect_line" ]] \
    || fail "timeout during first image inspection allowed a later Docker call"

  docker_state_init "$tidy_state"
  {
    printf 'sha256:intfirst\tgroundwork/scratch:int-first\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n'
    printf 'sha256:intsecond\tgroundwork/scratch:int-second\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n'
  } >"$tidy_state/images.tsv"
  tidy_int_sentinel="$tidy_state/recheck.started"
  cat >"$tidy_state/delay.conf" <<EOF
DELAY_SUBSTR='image inspect sha256:intfirst'
DELAY_AT=2
DELAY_SECONDS=30
DELAY_SENTINEL='$tidy_int_sentinel'
EOF
  rm -f "$tidy_int_sentinel"
  test ! -d "$docker_lock_dir" || fail "the prior Docker fixture left the machine lock behind"
  # Background jobs inherit SIGINT ignored. Keep the helper in the foreground and
  # let a sender read its exact owned PID from the lock after the delayed command
  # starts, so this exercises the helper's real INT trap instead of a shell quirk.
  (
    for _ in {1..100}; do
      [[ -f "$tidy_int_sentinel" ]] && break
      sleep 0.1
    done
    [[ -f "$tidy_int_sentinel" ]] || exit 1
    IFS= read -r tidy_signal_pid <"$docker_lock_dir/pid"
    [[ "$tidy_signal_pid" =~ ^[0-9]+$ ]] || exit 1
    kill -INT "$tidy_signal_pid"
  ) &
  tidy_signal_sender=$!
  set +e
  HOME="$docker_home" DOCKER_STATE="$tidy_state" PATH="$docker_stub_bin:$PATH" \
    /bin/bash home/dot_local/bin/executable_groundwork-docker-tidy --yes \
    >"$out_dir/tidy-int-recheck" 2>&1
  tidy_status=$?
  tidy_signal_sender_status=0
  wait "$tidy_signal_sender" || tidy_signal_sender_status=$?
  set -e
  [[ "$tidy_signal_sender_status" -eq 0 ]] || fail "INT fixture never reached candidate inspection"
  [[ "$tidy_status" -eq 130 ]] || fail "INT during candidate inspection returned $tidy_status"
  assert_no_matches "INT during one candidate allowed image deletion" \
    grep -n 'image rm' "$tidy_state/argv.log"

  docker_state_init "$tidy_state"
  {
    printf 'sha256:rmfirst0\tgroundwork/scratch:rm-first\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n'
    printf 'sha256:rmsecond\tgroundwork/scratch:rm-second\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n'
  } >"$tidy_state/images.tsv"
  image_delete_sentinel="$tidy_state/image-delete.started"
  cat >"$tidy_state/delay.conf" <<EOF
DELAY_SUBSTR='image rm sha256:rmfirst0'
DELAY_SECONDS=30
DELAY_SENTINEL='$image_delete_sentinel'
EOF
  set +e
  GROUNDWORK_DOCKER_DEADLINE_SECONDS=5 \
    GROUNDWORK_DOCKER_CANCEL_GRACE_SECONDS=1 GROUNDWORK_DOCKER_POLL_SECONDS=0.1 \
    docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes \
    >"$out_dir/tidy-timeout-image-delete" 2>&1
  tidy_status=$?
  set -e
  [[ "$tidy_status" -eq 124 ]] || fail "image-deletion timeout returned $tidy_status"
  test -f "$image_delete_sentinel" \
    || fail "the image-deletion timeout fixture did not reach the intended stalled command"
  assert_no_matches "timeout deleting one image continued to the next candidate" \
    grep -n 'image rm sha256:rmsecond' "$tidy_state/argv.log"

  check "groundwork-docker-tidy: remaining policy matrices"
  install_fixture_policy_runner \
    "$docker_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_policy_clock "$docker_stub_bin/date"

  rm -f "$tidy_state/delay.conf" "$tidy_state/delay.count" \
    "$docker_pending_file"

  grep -qF 'groundwork-help docker' < <(home/dot_local/bin/executable_groundwork-docker-tidy --help)
  if docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --bogus >/dev/null 2>&1; then
    fail "groundwork-docker-tidy accepted an unknown option"
  fi
  if docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy --yes --summary \
    >"$out_dir/tidy-conflict" 2>&1; then
    fail "groundwork-docker-tidy accepted conflicting modes instead of rejecting them"
  fi
  grep -qF 'mutually exclusive' "$out_dir/tidy-conflict"
  if GROUNDWORK_DOCKER_TIDY_MAX_AGE_HOURS=abc \
    docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy \
    >"$out_dir/tidy-badenv" 2>&1; then
    fail "groundwork-docker-tidy acted on a garbled grace-window policy"
  fi
  grep -qF 'invalid GROUNDWORK_DOCKER_TIDY_MAX_AGE_HOURS' "$out_dir/tidy-badenv"
  if GROUNDWORK_DOCKER_TIDY_MAX_AGE_HOURS=99999 \
    docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy \
    >/dev/null 2>&1; then
    fail "groundwork-docker-tidy accepted an out-of-range grace window"
  fi

  # Installed read-only surfaces ignore ambient source paths. Repository or
  # direnv variables cannot execute shell code merely by running a report.
  ambient_scan_marker="$out_dir/ambient-scan-ran"
  ambient_runner_marker="$out_dir/ambient-runner-ran"
  cat >"$out_dir/ambient-scan.sh" <<EOF
printf ran >'$ambient_scan_marker'
EOF
  cat >"$out_dir/ambient-runner.sh" <<EOF
printf ran >'$ambient_runner_marker'
EOF
  docker_state_init "$tidy_state"
  GROUNDWORK_DOCKER_LIB="$out_dir/ambient-scan.sh" \
    GROUNDWORK_MAINTENANCE_RUNNER_LIB="$out_dir/ambient-runner.sh" \
    docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-docker-tidy \
    >"$out_dir/tidy-ambient-readonly"
  GROUNDWORK_DOCKER_LIB="$out_dir/ambient-scan.sh" \
    GROUNDWORK_MAINTENANCE_RUNNER_LIB="$out_dir/ambient-runner.sh" \
    docker_run "$tidy_state" "$docker_stub_bin:$PATH" groundwork-doctor --docker \
    >"$out_dir/doctor-ambient-readonly"
  test ! -e "$ambient_scan_marker" || fail "read-only Docker report sourced ambient scanner code"
  test ! -e "$ambient_runner_marker" || fail "read-only Docker report sourced ambient runner code"

  check "groundwork-docker-cache-tidy helper"
  # Daemon-wide cleanup is a SEPARATE, owner-only command: it says it reaches
  # every project, it dry-runs by default, and no refresh or scheduled path may
  # ever invoke it.
  test -x home/dot_local/bin/executable_groundwork-docker-cache-tidy
  grep -qF 'lib/docker-scan.sh' home/dot_local/bin/executable_groundwork-docker-cache-tidy
  assert_no_matches "the daemon-wide cache tidy leaked into a scheduled or refresh path" \
    rg -n 'docker-cache-tidy' \
    home/dot_local/bin/executable_update-all \
    home/dot_local/bin/executable_groundwork-update-run.tmpl \
    home/dot_zshrc.tmpl home/run_after_20-tools.sh.tmpl \
    home/run_onchange_after_10-brew-bundle.sh.tmpl
  # update-all runs only the label-scoped tidy in acting mode. The helper owns
  # ordinary reachability and cleanup policy. The runner has exactly one
  # separate probe: bounded readiness after an owner-approved temporary backend
  # start, before it retries the unchanged tidy.
  grep -qF 'groundwork-docker-tidy" --automatic' home/dot_local/bin/executable_groundwork-update-run.tmpl
  assert_not_contains 'groundwork-docker-tidy" --summary' \
    home/dot_local/bin/executable_groundwork-update-run.tmpl \
    "update-all only reported Docker leftovers instead of maintaining the opted-in scratch lane"
  [[ "$(rg -c 'docker info' home/dot_local/bin/executable_groundwork-update-run.tmpl)" -eq 1 ]] \
    || fail "update-run must keep exactly one post-start Docker readiness probe"
  docker_readiness_source="$(sed -n '/^wait_for_docker_ready() {/,/^}/p' \
    home/dot_local/bin/executable_groundwork-update-run.tmpl)"
  grep -qF 'run_bounded_internal "probe Docker readiness"' <<<"$docker_readiness_source" \
    || fail "the post-start Docker readiness probe is not bounded"
  grep -qF 'docker info' <<<"$docker_readiness_source" \
    || fail "Docker readiness moved outside its temporary-start function"
  cache_state="$out_dir/cache-state"
  docker_state_init "$cache_state"
  printf 'sha256:dangx000\t-\t-\t-\t2001-01-01T00:00:00Z\t300MB\n' >"$cache_state/images.tsv"
  printf 'c-plain\tsha256:otherbase\texited\told-c\t-\tExited (0) 3 days ago\n' >"$cache_state/containers.tsv"
  GROUNDWORK_DOCKER_LIB="$out_dir/ambient-scan.sh" \
    GROUNDWORK_MAINTENANCE_RUNNER_LIB="$out_dir/ambient-runner.sh" \
    docker_run "$cache_state" "$docker_stub_bin:$PATH" groundwork-docker-cache-tidy \
    >"$out_dir/cache-ambient-readonly"
  test ! -e "$ambient_scan_marker" || fail "read-only Docker cache report sourced ambient scanner code"
  test ! -e "$ambient_runner_marker" || fail "read-only Docker cache report sourced ambient runner code"
  docker_run "$cache_state" "$docker_stub_bin:$PATH" groundwork-docker-cache-tidy >"$out_dir/cache-dry"
  grep -qF 'DAEMON-WIDE' "$out_dir/cache-dry"
  grep -qF 'ALL projects' "$out_dir/cache-dry"
  grep -qF 'Dry run — nothing was changed' "$out_dir/cache-dry"
  grep -qF 'does not guarantee' "$out_dir/cache-dry"
  assert_no_matches "cache tidy dry run must not prune anything" grep -n 'prune' "$cache_state/argv.log"
  docker_run "$cache_state" "$docker_stub_bin:$PATH" groundwork-docker-cache-tidy --yes >"$out_dir/cache-yes"
  grep -qF 'container prune --force' "$cache_state/argv.log"
  grep -qF 'image prune --force' "$cache_state/argv.log"
  grep -qF 'builder prune --force --keep-storage 5GB' "$cache_state/argv.log"
  grep -qF 'retention target' "$out_dir/cache-yes"
  assert_no_matches "cache tidy must never touch volumes" grep -n 'volume' "$cache_state/argv.log"

  docker_state_init "$cache_state"
  printf 'tcp://shared.example:2376\n' >"$cache_state/context-host"
  set +e
  docker_run "$cache_state" "$docker_stub_bin:$PATH" groundwork-docker-cache-tidy --yes \
    >"$out_dir/cache-remote-refused" 2>&1
  cache_status=$?
  set -e
  [[ "$cache_status" -eq 3 ]] || fail "daemon-wide cache cleanup accepted a remote endpoint"
  grep -qF 'refusing daemon-wide cleanup on non-local endpoint' "$out_dir/cache-remote-refused"
  assert_no_matches "remote cache cleanup reached a prune operation" \
    grep -n 'prune' "$cache_state/argv.log"

  docker_state_init "$cache_state"
  set +e
  DOCKER_HOST=tcp://shared.example:2376 \
    docker_run "$cache_state" "$docker_stub_bin:$PATH" groundwork-docker-cache-tidy --yes \
    >"$out_dir/cache-ambient-remote-refused" 2>&1
  cache_status=$?
  set -e
  [[ "$cache_status" -eq 3 ]] || fail "daemon-wide cache cleanup accepted ambient DOCKER_HOST"
  test ! -s "$cache_state/argv.log" \
    || fail "daemon-wide cache cleanup queried Docker after refusing ambient DOCKER_HOST"

  check "groundwork-docker-cache-tidy: real deadline runtime"
  install_fixture_runtime_runner \
    "$docker_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_runtime_clock "$docker_stub_bin/date"

  docker_state_init "$cache_state"
  cache_prune_sentinel="$cache_state/container-prune.started"
  cat >"$cache_state/delay.conf" <<EOF
DELAY_SUBSTR='container prune --force'
DELAY_SECONDS=30
DELAY_SENTINEL='$cache_prune_sentinel'
EOF
  set +e
  GROUNDWORK_DOCKER_CACHE_TIDY_OPERATION_DEADLINE_SECONDS=5 \
    docker_run "$cache_state" "$docker_stub_bin:$PATH" groundwork-docker-cache-tidy --yes \
    >"$out_dir/cache-prune-timeout" 2>&1
  cache_status=$?
  set -e
  [[ "$cache_status" -eq 124 ]] || fail "bounded daemon-wide prune returned $cache_status"
  test -f "$cache_prune_sentinel" \
    || fail "the cache-prune timeout fixture did not reach the intended stalled command"
  assert_no_matches "cache cleanup continued after a prune deadline" \
    grep -nE 'image prune|builder prune' "$cache_state/argv.log"
  rm -f "$cache_state/delay.conf"

  docker_state_init "$cache_state"
  cat >"$cache_state/delay.conf" <<'EOF'
DELAY_SUBSTR='prune --force'
DELAY_SECONDS=1.2
EOF
  set +e
  GROUNDWORK_DOCKER_CACHE_TIDY_OPERATION_DEADLINE_SECONDS=5 \
    GROUNDWORK_DOCKER_CACHE_TIDY_TOTAL_DEADLINE_SECONDS=2 \
    docker_run "$cache_state" "$docker_stub_bin:$PATH" groundwork-docker-cache-tidy --yes \
    >"$out_dir/cache-total-timeout" 2>&1
  cache_status=$?
  set -e
  [[ "$cache_status" -eq 124 ]] || fail "daemon-wide total deadline returned $cache_status"
  grep -qF 'total deadline expired' "$out_dir/cache-total-timeout"
  [[ "$(grep -c 'prune --force' "$cache_state/argv.log" || true)" -lt 3 ]] \
    || fail "daemon-wide cleanup completed every slow prune after its total deadline"
  rm -f "$cache_state/delay.conf"

  check "groundwork-docker-cache-tidy: remaining policy matrices"
  install_fixture_policy_runner \
    "$docker_home/.local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_policy_clock "$docker_stub_bin/date"

  : >"$cache_state/argv.log"
  GROUNDWORK_DOCKER_CACHE_TIDY_KEEP_STORAGE=20GiB \
    docker_run "$cache_state" "$docker_stub_bin:$PATH" groundwork-docker-cache-tidy --yes >/dev/null
  grep -qF 'builder prune --force --keep-storage 20GiB' "$cache_state/argv.log"
  if GROUNDWORK_DOCKER_CACHE_TIDY_KEEP_STORAGE=lots \
    docker_run "$cache_state" "$docker_stub_bin:$PATH" groundwork-docker-cache-tidy \
    >"$out_dir/cache-badenv" 2>&1; then
    fail "groundwork-docker-cache-tidy accepted a keep-storage value outside the closed size format"
  fi
  grep -qF 'invalid GROUNDWORK_DOCKER_CACHE_TIDY_KEEP_STORAGE' "$out_dir/cache-badenv"
  if docker_run "$cache_state" "$docker_stub_bin:$PATH" groundwork-docker-cache-tidy --yes --dry-run \
    >/dev/null 2>&1; then
    fail "groundwork-docker-cache-tidy accepted conflicting modes"
  fi
  if docker_run "$cache_state" "$docker_stub_bin:$PATH" groundwork-docker-cache-tidy --bogus >/dev/null 2>&1; then
    fail "groundwork-docker-cache-tidy accepted an unknown option"
  fi
  grep -qF 'groundwork-help docker' < <(home/dot_local/bin/executable_groundwork-docker-cache-tidy --help)
  unset cache_status

  check "groundwork-docker-build-scratch helper"
  # The wrapper owns the contract's syntax: both labels, a generated RFC 3339
  # build clock, the scratch-namespace tag, a printed image ID — and it refuses
  # forwarded arguments that could break any of that.
  test -x home/dot_local/bin/executable_groundwork-docker-build-scratch
  build_state="$out_dir/build-state"
  build_ctx="$out_dir/buildctx"
  docker_state_init "$build_state"
  mkdir -p "$build_ctx"
  printf 'FROM scratch\n' >"$build_ctx/Dockerfile"
  docker_run "$build_state" "$docker_stub_bin:$PATH" groundwork-docker-build-scratch \
    review "$build_ctx" -- --build-arg FOO=bar >"$out_dir/build-out"
  grep -qF -- '--label dev.roost.ephemeral=true' "$build_state/argv.log"
  grep -qE -- '--label dev\.roost\.built=[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z ' "$build_state/argv.log"
  grep -qF -- '-t buildctx/scratch:review' "$build_state/argv.log"
  grep -qF -- '--build-arg FOO=bar' "$build_state/argv.log"
  grep -qF 'image id: sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' "$out_dir/build-out"
  docker_state_init "$build_state"
  docker_run "$build_state" "$docker_stub_bin:$PATH" groundwork-docker-build-scratch \
    review "$build_ctx" --project myproj --rm-after >"$out_dir/build-rmafter"
  grep -qF -- '-t myproj/scratch:review' "$build_state/argv.log"
  grep -qF 'image rm sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' "$build_state/argv.log"
  grep -qF 'removed after build' "$out_dir/build-rmafter"

  docker_state_init "$build_state"
  printf 'image rm sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n' \
    >"$build_state/fail.conf"
  set +e
  docker_run "$build_state" "$docker_stub_bin:$PATH" groundwork-docker-build-scratch \
    review "$build_ctx" --project myproj --rm-after \
    >"$out_dir/build-rmafter-failed" 2>&1
  build_status=$?
  set -e
  [[ "$build_status" -ne 0 ]] || fail "failed --rm-after exact-ID cleanup returned success"
  grep -qF 'docker image inspect sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' \
    "$out_dir/build-rmafter-failed"
  grep -qF 'docker image rm sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' \
    "$out_dir/build-rmafter-failed"
  assert_not_contains 'docker rmi myproj/scratch:review' "$out_dir/build-rmafter-failed" \
    "scratch builder recommended mutable-tag recovery after exact-ID cleanup failed"

  docker_state_init "$build_state"
  printf 'tcp://shared.example:2376\n' >"$build_state/context-host"
  set +e
  docker_run "$build_state" "$docker_stub_bin:$PATH" groundwork-docker-build-scratch \
    review "$build_ctx" >"$out_dir/build-remote-refused" 2>&1
  build_status=$?
  set -e
  [[ "$build_status" -ne 0 ]] || fail "scratch builder accepted a remote Docker endpoint"
  assert_no_matches "remote scratch build reached docker build" grep -n '^build ' "$build_state/argv.log"

  docker_state_init "$build_state"
  set +e
  DOCKER_HOST=tcp://shared.example:2376 \
    docker_run "$build_state" "$docker_stub_bin:$PATH" groundwork-docker-build-scratch \
    review "$build_ctx" >"$out_dir/build-ambient-refused" 2>&1
  build_status=$?
  set -e
  [[ "$build_status" -eq 2 ]] || fail "scratch builder accepted ambient DOCKER_HOST"
  test ! -s "$build_state/argv.log" || fail "ambient-refused scratch build queried Docker"

  rm -f "$docker_fake_marker"
  set +e
  HOME="$docker_home" PATH="$docker_fake_bin:/usr/bin:/bin" \
    /bin/bash home/dot_local/bin/executable_groundwork-docker-build-scratch \
    review "$build_ctx" >"$out_dir/build-untrusted-docker" 2>&1
  build_status=$?
  set -e
  [[ "$build_status" -eq 2 ]] || fail "scratch builder accepted a repository-controlled Docker executable"
  test ! -e "$docker_fake_marker" || fail "scratch builder invoked an untrusted Docker executable"
  docker_state_init "$build_state"
  if docker_run "$build_state" "$docker_stub_bin:$PATH" groundwork-docker-build-scratch \
    'bad purpose!' "$build_ctx" >"$out_dir/build-badpurpose" 2>&1; then
    fail "groundwork-docker-build-scratch accepted an illegal tag component as the purpose"
  fi
  grep -qF 'invalid purpose' "$out_dir/build-badpurpose"
  assert_no_matches "an invalid purpose still reached docker build" grep -n 'build' "$build_state/argv.log"
  for build_bad_arg in '-t' '--tag=evil' '--iidfile'; do
    if docker_run "$build_state" "$docker_stub_bin:$PATH" groundwork-docker-build-scratch \
      review "$build_ctx" -- "$build_bad_arg" evil >/dev/null 2>&1; then
      fail "groundwork-docker-build-scratch forwarded '$build_bad_arg', which breaks the contract it owns"
    fi
  done
  unset build_bad_arg
  if docker_run "$build_state" "$docker_stub_bin:$PATH" groundwork-docker-build-scratch \
    review "$build_ctx" -- --label dev.roost.ephemeral=false >/dev/null 2>&1; then
    fail "groundwork-docker-build-scratch let a forwarded --label override the lifecycle labels"
  fi
  # Forwarding is a closed allowlist. Allowed options pass through in both
  # separate-value and = forms; --output/-o/--push are refused by name (the
  # contract requires a local inspectable image); unknown options are refused
  # rather than trusted.
  docker_state_init "$build_state"
  docker_run "$build_state" "$docker_stub_bin:$PATH" groundwork-docker-build-scratch \
    review "$build_ctx" -- --file "$build_ctx/Dockerfile" --target=final --no-cache \
    --platform linux/arm64 >/dev/null
  grep -qF -- "--file $build_ctx/Dockerfile" "$build_state/argv.log"
  grep -qF -- '--target=final' "$build_state/argv.log"
  grep -qF -- '--no-cache' "$build_state/argv.log"
  grep -qF -- '--platform linux/arm64' "$build_state/argv.log"
  for build_out_arg in '--output' '-o' '--push' '--output=type=local,dest=/tmp/x'; do
    docker_state_init "$build_state"
    if docker_run "$build_state" "$docker_stub_bin:$PATH" groundwork-docker-build-scratch \
      review "$build_ctx" -- "$build_out_arg" dest >"$out_dir/build-output-refused" 2>&1; then
      fail "groundwork-docker-build-scratch forwarded '$build_out_arg', which exports the image away from local inspection"
    fi
    grep -qF 'unsupported' "$out_dir/build-output-refused"
    grep -qF 'local inspectable image' "$out_dir/build-output-refused"
    assert_no_matches "a refused '$build_out_arg' still reached docker build" \
      grep -n 'build' "$build_state/argv.log"
  done
  unset build_out_arg
  docker_state_init "$build_state"
  if docker_run "$build_state" "$docker_stub_bin:$PATH" groundwork-docker-build-scratch \
    review "$build_ctx" -- --squash >"$out_dir/build-unknown-refused" 2>&1; then
    fail "groundwork-docker-build-scratch forwarded an option outside the allowlist"
  fi
  grep -qF 'not in the allowlist' "$out_dir/build-unknown-refused"
  assert_no_matches "an option outside the allowlist still reached docker build" \
    grep -n 'build' "$build_state/argv.log"
  grep -qF 'groundwork-help docker' < <(home/dot_local/bin/executable_groundwork-docker-build-scratch --help)

  check "repository Docker image verification transaction"
  test -x scripts/verify-docker-image
  scripts/verify-docker-image --help >"$out_dir/verify-docker-help"
  grep -qF 'Build, run, and remove' "$out_dir/verify-docker-help"
  verify_fixture_root="$out_dir/verify-repository"
  mkdir -p "$verify_fixture_root/scripts" "$verify_fixture_root/home/dot_local/bin" \
    "$verify_fixture_root/home/dot_local/share/groundwork/lib"
  cp scripts/verify-docker-image "$verify_fixture_root/scripts/verify-docker-image"
  cp home/dot_local/bin/executable_groundwork-docker-build-scratch \
    "$verify_fixture_root/home/dot_local/bin/executable_groundwork-docker-build-scratch"
  install_fixture_policy_runner \
    "$verify_fixture_root/home/dot_local/share/groundwork/lib/maintenance-runner.sh"
  cp home/dot_local/share/groundwork/lib/docker-scan.sh \
    "$verify_fixture_root/home/dot_local/share/groundwork/lib/docker-scan.sh"
  # The production resolver is tested independently against hostile PATH state.
  # This isolated dependency copy supplies the Docker fixture without adding a
  # production bypass to the exact verification script under test.
  cat >>"$verify_fixture_root/home/dot_local/share/groundwork/lib/docker-scan.sh" <<'SH'
gw_docker_resolve_trusted_executable() {
  type -P "$1" 2>/dev/null
}
SH
  cmp -s scripts/verify-docker-image "$verify_fixture_root/scripts/verify-docker-image" \
    || fail "the Docker verification fixture changed the repository script under test"
  verify_docker_run() {
    HOME="$docker_home" DOCKER_STATE="$build_state" PATH="$docker_stub_bin:$PATH" \
      GROUNDWORK_DOCKER_VERIFY_CONTAINER_NONCE=fixture \
      "$verify_fixture_root/scripts/verify-docker-image" "$@"
  }

  docker_state_init "$build_state"
  set +e
  verify_docker_run --bogus >"$out_dir/verify-docker-invalid" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -eq 64 ]] \
    || fail "invalid Docker verification arguments returned $verify_docker_status, expected 64"
  test ! -s "$build_state/argv.log" \
    || fail "invalid Docker verification arguments reached Docker"

  rm -f "$docker_fake_marker"
  set +e
  HOME="$docker_home" PATH="$docker_fake_bin:/usr/bin:/bin" \
    scripts/verify-docker-image --purpose untrusted-cli \
    >"$out_dir/verify-docker-untrusted-cli" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] \
    || fail "repository Docker verification accepted an untrusted executable"
  test ! -e "$docker_fake_marker" \
    || fail "repository Docker verification invoked an untrusted executable"

  docker_state_init "$build_state"
  printf 'tcp://shared.example:2376\n' >"$build_state/context-host"
  set +e
  verify_docker_run --purpose remote-endpoint \
    >"$out_dir/verify-docker-remote-endpoint" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] \
    || fail "repository Docker verification accepted a remote endpoint"
  assert_no_matches "remote repository verification reached a build" \
    grep -n '^build ' "$build_state/argv.log"

  docker_state_init "$build_state"
  set +e
  DOCKER_HOST=tcp://shared.example:2376 \
    verify_docker_run --purpose ambient-endpoint \
    >"$out_dir/verify-docker-ambient-endpoint" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -eq 64 ]] \
    || fail "repository Docker verification accepted ambient DOCKER_HOST"
  test ! -s "$build_state/argv.log" \
    || fail "ambient-refused repository verification queried Docker"

  # Preflight absence is enumeration-backed. A generic observation failure is
  # unavailable, not shorthand for a free container name or image tag.
  docker_state_init "$build_state"
  printf 'ps -a --no-trunc --format {{.ID}}\n' >"$build_state/fail.conf"
  set +e
  verify_docker_run --purpose container-list-unavailable \
    >"$out_dir/verify-docker-container-list-unavailable" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] \
    || fail "unavailable container-name enumeration was treated as absence"
  assert_no_matches "container-name preflight failure still reached build" \
    grep -n '^build ' "$build_state/argv.log"

  docker_state_init "$build_state"
  printf 'images --no-trunc --format {{.Repository}}:{{.Tag}}\n' >"$build_state/fail.conf"
  set +e
  verify_docker_run --purpose tag-list-unavailable \
    >"$out_dir/verify-docker-tag-list-unavailable" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] \
    || fail "unavailable image-tag enumeration was treated as absence"
  assert_no_matches "image-tag preflight failure still reached build" \
    grep -n '^build ' "$build_state/argv.log"

  # The normal path mechanically owns build, run, and exact-tag removal.
  docker_state_init "$build_state"
  verify_docker_run --purpose validator-ok \
    >"$out_dir/verify-docker-ok" 2>&1
  grep -qF -- '-t groundwork/scratch:validator-ok' "$build_state/argv.log"
  grep -qF -- '--label dev.roost.ephemeral=true' "$build_state/argv.log"
  grep -qE 'container create --rm --cidfile [^ ]+ --name groundwork-verify-validator-ok-fixture sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' \
    "$build_state/argv.log"
  [[ "$(grep -cF -- '--name groundwork-verify-validator-ok-fixture' \
    "$build_state/argv.log")" -eq 1 ]] \
    || fail "Docker verification created its smoke container more than once"
  grep -qF 'container start --attach dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd' "$build_state/argv.log"
  grep -qF 'image rm sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' "$build_state/argv.log"
  test ! -s "$build_state/images.tsv" \
    || fail "the repository Docker verification command left its proof image behind"
  test ! -s "$build_state/containers.tsv" \
    || fail "the repository Docker verification command left its proof container behind"
  grep -qF 'images --all --no-trunc --quiet' "$build_state/argv.log" \
    || fail "successful verification did not prove exact image-ID absence"
  grep -qF 'ps -aq --no-trunc' "$build_state/argv.log" \
    || fail "successful verification did not prove exact container-ID absence"
  grep -qF 'removed image sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' "$out_dir/verify-docker-ok"

  # Container ownership comes from Docker's CID-file receipt, not stdout.
  # Successful creates remain self-cleaning when stdout is empty, malformed, or
  # duplicated; a malformed CID file falls back to exact-name enumeration only
  # because this transaction proved the name absent and create returned success.
  for create_stdout_mode in empty malformed two-lines; do
    docker_state_init "$build_state"
    cat >"$build_state/create.conf" <<EOF
CREATE_STDOUT_MODE=$create_stdout_mode
EOF
    verify_docker_run --purpose "stdout-$create_stdout_mode" \
      >"$out_dir/verify-docker-stdout-$create_stdout_mode" 2>&1
    test ! -s "$build_state/containers.tsv" \
      || fail "successful create with $create_stdout_mode stdout leaked its CID-file-owned container"
    test ! -s "$build_state/images.tsv" \
      || fail "successful create with $create_stdout_mode stdout leaked its proof image"
  done
  for create_cid_mode in empty malformed two-lines; do
    docker_state_init "$build_state"
    cat >"$build_state/create.conf" <<EOF
CREATE_CID_MODE=$create_cid_mode
CREATE_STDOUT_MODE=empty
EOF
    verify_docker_run --purpose "cid-$create_cid_mode" \
      >"$out_dir/verify-docker-cid-$create_cid_mode" 2>&1
    test ! -s "$build_state/containers.tsv" \
      || fail "successful create with $create_cid_mode CID receipt escaped exact-name recovery"
    test ! -s "$build_state/images.tsv" \
      || fail "successful create with $create_cid_mode CID receipt leaked its proof image"
  done
  unset create_stdout_mode create_cid_mode

  docker_state_init "$build_state"
  cat >"$build_state/create.conf" <<'EOF'
CREATE_APPEARS=0
CREATE_EXIT=1
CREATE_CID_MODE=empty
CREATE_STDOUT_MODE=empty
EOF
  set +e
  verify_docker_run --purpose create-fails-cleanly \
    >"$out_dir/verify-docker-create-fails-cleanly" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] || fail "failed container create returned success"
  test ! -s "$build_state/containers.tsv" \
    || fail "failed create without a container invented cleanup ownership"

  docker_state_init "$build_state"
  cat >"$build_state/create.conf" <<'EOF'
CREATE_APPEARS=1
CREATE_EXIT=1
CREATE_CID_MODE=empty
CREATE_STDOUT_MODE=malformed
EOF
  set +e
  verify_docker_run --purpose create-fails-with-name \
    >"$out_dir/verify-docker-create-fails-with-name" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] \
    || fail "failed create with an exact-name container returned success"
  grep -qF 'ownership was not proven, so it was left untouched' \
    "$out_dir/verify-docker-create-fails-with-name"
  grep -qF $'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\t' \
    "$build_state/containers.tsv" \
    || fail "failed create deleted a same-name container without a durable receipt"
  assert_no_matches "failed create without a receipt mutated the same-name container" \
    grep -nE 'container (stop|rm) dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd' \
    "$build_state/argv.log"

  # A failed build never reaches container creation, and the cleanup trap proves
  # that the invocation's unique scratch tag is absent.
  docker_state_init "$build_state"
  printf 'build \n' >"$build_state/fail.conf"
  set +e
  verify_docker_run --purpose validator-build-fail \
    >"$out_dir/verify-docker-build-fail" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] || fail "a failed Docker build returned success"
  assert_no_matches "a failed Docker build still created a verification container" \
    grep -n 'container create' "$build_state/argv.log"
  test ! -s "$build_state/images.tsv" \
    || fail "a failed Docker build left a proof image behind"
  rm -f "$build_state/fail.conf"

  # A failed smoke command still runs the same exact cleanup and preserves the
  # smoke failure. Cleanup is a trap-owned outcome, not a third command an agent
  # can forget after seeing the test fail.
  docker_state_init "$build_state"
  printf 'container start --attach\n' >"$build_state/fail.conf"
  set +e
  verify_docker_run --purpose validator-fail \
    >"$out_dir/verify-docker-run-fail" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] || fail "a failed Docker smoke run returned success"
  grep -qF 'image rm sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' "$build_state/argv.log"
  failed_verify_id="$(awk '/container start --attach / { print $NF; exit }' "$build_state/argv.log")"
  [[ -n "$failed_verify_id" ]] || fail "failed smoke fixture captured no created container ID"
  grep -qF "container stop --time 2 $failed_verify_id" "$build_state/argv.log"
  grep -qF "container rm $failed_verify_id" "$build_state/argv.log"
  test ! -s "$build_state/containers.tsv" \
    || fail "a failed Docker smoke run left its exact container behind"
  test ! -s "$build_state/images.tsv" \
    || fail "a failed Docker smoke run left its proof image behind"
  rm -f "$build_state/fail.conf"

  # Runner status 125 means its previous process tree may still be alive. The
  # cleanup trap reports exact manual inspection and issues no later Docker
  # query or mutation.
  docker_state_init "$build_state"
  set +e
  GROUNDWORK_TEST_RUNNER_125_MATCH='stop verification container' \
    verify_docker_run --purpose cleanup-tree-uncertain \
    >"$out_dir/verify-docker-cleanup-125" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] || fail "cleanup runner status 125 returned success"
  grep -qF 'no later Docker command was issued' "$out_dir/verify-docker-cleanup-125"
  cleanup_125_start_line="$(grep -nF 'container start --attach' "$build_state/argv.log" | tail -n 1 | cut -d: -f1)"
  [[ -n "$cleanup_125_start_line" ]] || fail "cleanup status-125 fixture never ran its container"
  [[ "$(wc -l <"$build_state/argv.log" | tr -d '[:space:]')" -eq "$cleanup_125_start_line" ]] \
    || fail "cleanup continued with Docker work after runner status 125"
  test -s "$build_state/images.tsv" \
    || fail "cleanup status 125 mutated the proof image after losing process-tree certainty"
  unset cleanup_125_start_line

  check "repository Docker image verification real signal runtime"
  install_fixture_runtime_runner \
    "$verify_fixture_root/home/dot_local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_runtime_clock "$docker_stub_bin/date"

  # An interrupt cancels the run process group, then the EXIT trap still removes
  # the exact owned resources and returns the conventional signal status.
  docker_state_init "$build_state"
  verify_signal_sentinel="$build_state/run.started"
  cat >"$build_state/delay.conf" <<EOF
DELAY_SUBSTR='container start --attach'
DELAY_SECONDS=30
DELAY_SENTINEL='$verify_signal_sentinel'
EOF
  HOME="$docker_home" DOCKER_STATE="$build_state" PATH="$docker_stub_bin:$PATH" \
    GROUNDWORK_DOCKER_VERIFY_CONTAINER_NONCE=fixture \
    "$verify_fixture_root/scripts/verify-docker-image" --purpose validator-signal \
    >"$out_dir/verify-docker-signal" 2>&1 &
  verify_docker_pid=$!
  for _ in {1..100}; do
    [[ -f "$verify_signal_sentinel" ]] && break
    sleep 0.1
  done
  test -f "$verify_signal_sentinel" || fail "the delayed Docker smoke run never started"
  kill -TERM "$verify_docker_pid"
  set +e
  wait "$verify_docker_pid"
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -eq 143 ]] \
    || fail "TERM during Docker verification returned $verify_docker_status, expected 143"
  signal_verify_id="$(awk '/container start --attach / { print $NF; exit }' "$build_state/argv.log")"
  [[ -n "$signal_verify_id" ]] || fail "interrupted smoke fixture captured no created container ID"
  grep -qF "container stop --time 2 $signal_verify_id" "$build_state/argv.log"
  grep -qF "container rm $signal_verify_id" "$build_state/argv.log"
  test ! -s "$build_state/containers.tsv" \
    || fail "an interrupted Docker smoke run left its exact container behind"
  grep -qF 'image rm sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' "$build_state/argv.log"
  test ! -s "$build_state/images.tsv" \
    || fail "an interrupted Docker smoke run left its proof image behind"
  rm -f "$build_state/delay.conf"

  check "repository Docker image verification remaining policy matrices"
  install_fixture_policy_runner \
    "$verify_fixture_root/home/dot_local/share/groundwork/lib/maintenance-runner.sh"
  install_fixture_policy_clock "$docker_stub_bin/date"

  # Cleanup re-snapshots the exact owned image ID. A real tag added after the
  # smoke run revokes deletion consent; a generic inspect failure while the ID
  # remains listed is incomplete; an image that a fresh listing proves absent is
  # accepted as an already-completed race.
  docker_state_init "$build_state"
  printf 'sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\tgroundwork/scratch:ownership-retag,groundwork:latest\ttrue\t2026-01-01T00:00:00Z\t2026-01-01T00:00:00Z\t1.0GB\n' \
    >"$build_state/images-tripped.tsv"
  cat >"$build_state/trip.conf" <<EOF
TRIP_SUBSTR='image inspect sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'
TRIP_AT=1
TRIP_IMAGES=$build_state/images-tripped.tsv
EOF
  set +e
  verify_docker_run --purpose ownership-retag \
    >"$out_dir/verify-docker-ownership-retag" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] \
    || fail "verification cleanup deleted through a newly added real tag"
  grep -qF 'gained another tag: groundwork:latest' \
    "$out_dir/verify-docker-ownership-retag"
  assert_no_matches "verification cleanup mutated an image after a real retag" \
    grep -n 'image rm' "$build_state/argv.log"
  grep -qF 'groundwork:latest' "$build_state/images.tsv" \
    || fail "verification cleanup removed a newly real-tagged image"

  docker_state_init "$build_state"
  cat >"$build_state/trip.conf" <<EOF
TRIP_SUBSTR='image inspect sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'
TRIP_AT=1
TRIP_EXIT=1
EOF
  set +e
  verify_docker_run --purpose ownership-inspect-fail \
    >"$out_dir/verify-docker-ownership-inspect-fail" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] \
    || fail "a generic cleanup inspect failure was treated as image absence"
  grep -qF 'could not prove the state of owned image ID' \
    "$out_dir/verify-docker-ownership-inspect-fail"
  assert_no_matches "failed exact-ID observation still removed an image tag" \
    grep -n 'image rm' "$build_state/argv.log"

  docker_state_init "$build_state"
  : >"$build_state/images-gone.tsv"
  cat >"$build_state/trip.conf" <<EOF
TRIP_SUBSTR='image inspect sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'
TRIP_AT=1
TRIP_IMAGES=$build_state/images-gone.tsv
EOF
  verify_docker_run --purpose ownership-disappears \
    >"$out_dir/verify-docker-ownership-disappears" 2>&1
  test ! -s "$build_state/images.tsv" \
    || fail "image proven absent during cleanup reappeared in fixture state"
  assert_no_matches "cleanup tried to remove an image already proven absent" \
    grep -n 'image rm' "$build_state/argv.log"

  docker_state_init "$build_state"
  {
    printf 'sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\t-\ttrue\t2026-01-01T00:00:00Z\t2026-01-01T00:00:00Z\t1.0GB\n'
    printf 'sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\tgroundwork/scratch:ownership-repoint\ttrue\t2026-01-01T00:00:00Z\t2026-01-01T00:00:00Z\t1.0GB\n'
  } >"$build_state/images-repointed.tsv"
  cat >"$build_state/trip.conf" <<EOF
TRIP_SUBSTR='image rm sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'
TRIP_AT=1
TRIP_IMAGES=$build_state/images-repointed.tsv
EOF
  set +e
  verify_docker_run --purpose ownership-repoint \
    >"$out_dir/verify-docker-ownership-repoint" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] \
    || fail "a repointed verification tag was reported as fully cleaned"
  grep -qF 'now points to different image sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff; left untouched' \
    "$out_dir/verify-docker-ownership-repoint"
  grep -qF $'sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\tgroundwork/scratch:ownership-repoint' \
    "$build_state/images.tsv" || fail "verification cleanup removed a repointed tag from its new image"
  assert_no_matches "verification cleanup deleted the image that received a repointed tag" \
    grep -n 'image rm sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff' \
    "$build_state/argv.log"

  # A pre-existing same-purpose container is not ours. The deterministic fixture
  # nonce lets the test occupy the exact generated name; the command refuses it
  # before build and never stops or removes that container.
  docker_state_init "$build_state"
  printf 'aaaaaaaaaaaa\tsha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\trunning\tgroundwork-verify-container-collision-fixture\t-\tUp 2 hours\t2001-01-01T00:00:00Z\n' \
    >"$build_state/containers.tsv"
  set +e
  verify_docker_run --purpose container-collision \
    >"$out_dir/verify-docker-container-collision" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -eq 64 ]] \
    || fail "an occupied verification-container name returned $verify_docker_status, expected 64"
  grep -qF 'aaaaaaaaaaaa' "$build_state/containers.tsv" \
    || fail "the verification trap deleted a container it did not create"
  assert_no_matches "a refused container collision still mutated Docker" \
    grep -nE '^build |container (stop|rm|create|start)' "$build_state/argv.log"

  # The command also refuses to overwrite an existing tag. CI's explicit
  # --existing lane accepts only a correctly labeled scratch artifact, then owns
  # its run and cleanup too.
  docker_state_init "$build_state"
  printf 'sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\tgroundwork/scratch:occupied\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n' \
    >"$build_state/images.tsv"
  set +e
  verify_docker_run --purpose occupied \
    >"$out_dir/verify-docker-occupied" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -eq 64 ]] \
    || fail "an existing scratch-tag collision returned $verify_docker_status, expected 64"
  grep -qF 'sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' "$build_state/images.tsv" \
    || fail "the verification command removed a pre-existing image it did not create"
  assert_no_matches "a refused tag collision still built or ran an image" \
    grep -nE '^build |^run ' "$build_state/argv.log"

  docker_state_init "$build_state"
  printf 'sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\tgroundwork/scratch:ci-fixture\ttrue\t2001-01-01T00:00:00Z\t2001-01-01T00:00:00Z\t1.0GB\n' \
    >"$build_state/images.tsv"
  verify_docker_run --existing --purpose ci-fixture \
    >"$out_dir/verify-docker-existing" 2>&1
  grep -qE 'container create --rm --cidfile [^ ]+ --name groundwork-verify-ci-fixture-fixture sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee' \
    "$build_state/argv.log"
  grep -qF 'image rm sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee' "$build_state/argv.log"
  test ! -s "$build_state/images.tsv" \
    || fail "the cache-aware existing-image verification lane left its scratch image"

  docker_state_init "$build_state"
  printf 'sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\tgroundwork/scratch:unowned\t-\t-\t2001-01-01T00:00:00Z\t1.0GB\n' \
    >"$build_state/images.tsv"
  set +e
  verify_docker_run --existing --purpose unowned \
    >"$out_dir/verify-docker-unowned" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -eq 64 ]] \
    || fail "--existing accepted an image outside the lifecycle contract"
  grep -qF 'sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc' "$build_state/images.tsv" \
    || fail "--existing removed an image without lifecycle consent"

  docker_state_init "$build_state"
  printf 'sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\tgroundwork/scratch:empty-built\ttrue\t-\t2001-01-01T00:00:00Z\t1.0GB\n' \
    >"$build_state/images.tsv"
  set +e
  verify_docker_run --existing --purpose empty-built \
    >"$out_dir/verify-docker-empty-built" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -eq 64 ]] \
    || fail "--existing accepted an empty lifecycle timestamp"
  grep -qF 'invalid dev.roost.built timestamp' "$out_dir/verify-docker-empty-built"
  test -s "$build_state/images.tsv" || fail "empty built-label rejection removed the image"

  docker_state_init "$build_state"
  printf 'sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\tgroundwork/scratch:empty-tags\ttrue\t2026-01-01T00:00:00Z\t2026-01-01T00:00:00Z\t1.0GB\n' \
    >"$build_state/images.tsv"
  printf 'sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\n' \
    >"$build_state/inspect-empty-repotags"
  set +e
  verify_docker_run --existing --purpose empty-tags \
    >"$out_dir/verify-docker-empty-tags" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -eq 64 ]] \
    || fail "--existing accepted a snapshot with an empty final RepoTags field"
  grep -qF 'must have exactly the expected scratch tag' "$out_dir/verify-docker-empty-tags"
  test -s "$build_state/images.tsv" || fail "empty RepoTags rejection removed the image"

  docker_state_init "$build_state"
  printf 'sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\tgroundwork/scratch:bad-clock\ttrue\t2026-99-99T00:00:00Z\t2026-01-01T00:00:00Z\t1.0GB\n' \
    >"$build_state/images.tsv"
  set +e
  verify_docker_run --existing --purpose bad-clock \
    >"$out_dir/verify-docker-bad-clock" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -eq 64 ]] \
    || fail "--existing accepted a malformed lifecycle timestamp"
  grep -qF 'invalid dev.roost.built timestamp' "$out_dir/verify-docker-bad-clock"
  grep -qF 'sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee' \
    "$build_state/images.tsv" || fail "timestamp rejection removed an unowned existing image"

  docker_state_init "$build_state"
  printf 'sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\tgroundwork/scratch:multi-owned,groundwork/scratch:other\ttrue\t2026-01-01T00:00:00Z\t2026-01-01T00:00:00Z\t1.0GB\n' \
    >"$build_state/images.tsv"
  set +e
  verify_docker_run --existing --purpose multi-owned \
    >"$out_dir/verify-docker-multi-owned" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -eq 64 ]] \
    || fail "--existing accepted an image with multiple tags"
  assert_no_matches "multiple-tag ownership refusal mutated Docker" \
    grep -n 'image rm' "$build_state/argv.log"

  # If Docker refuses exact-ID cleanup after an otherwise green proof, cleanup
  # becomes the failure and the retained ID plus exact retry command are explicit.
  docker_state_init "$build_state"
  printf 'image rm sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n' >"$build_state/fail.conf"
  set +e
  verify_docker_run --purpose cleanup-refused \
    >"$out_dir/verify-docker-cleanup-refused" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] \
    || fail "a refused verification-image cleanup returned success"
  grep -qF 'could not prove owned image ID' \
    "$out_dir/verify-docker-cleanup-refused"
  grep -qF 'groundwork/scratch:cleanup-refused' "$build_state/images.tsv" \
    || fail "the cleanup-refusal fixture did not retain the reported image"
  rm -f "$build_state/fail.conf"

  # A failed removal plus a failed confirming inspection is not proof of
  # absence. The independent tag relist must also complete; if it cannot, a
  # green smoke test becomes a cleanup failure rather than a false success.
  docker_state_init "$build_state"
  cat >"$build_state/trip.conf" <<'EOF'
TRIP_SUBSTR='image rm sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'
TRIP_AT=1
TRIP_FAIL_PATTERN='images --no-trunc --format {{.Repository}}:{{.Tag}}	{{.ID}}'
TRIP_EXIT=1
EOF
  set +e
  verify_docker_run --purpose cleanup-unproved \
    >"$out_dir/verify-docker-cleanup-unproved" 2>&1
  verify_docker_status=$?
  set -e
  [[ "$verify_docker_status" -ne 0 ]] \
    || fail "unproved verification-image cleanup returned success"
  grep -qF 'could not prove owned image ID' \
    "$out_dir/verify-docker-cleanup-unproved"
  grep -qF 'groundwork/scratch:cleanup-unproved' "$build_state/images.tsv" \
    || fail "the cleanup-proof failure did not retain the image it reported"
  rm -f "$build_state/trip.conf"

  # Catalog rows for the whole docker family stay discoverable.
  grep -qF $'daily\tgroundwork-docker-tidy\tcommand\t' home/dot_local/share/groundwork/commands.tsv
  grep -qF $'daily\tgroundwork-docker-tidy --yes --clear-pending\tcommand\t' \
    home/dot_local/share/groundwork/commands.tsv
  grep -qF $'daily\tgroundwork-docker-cache-tidy\tcommand\t' home/dot_local/share/groundwork/commands.tsv
  grep -qF $'project\tgroundwork-docker-build-scratch <purpose> <context> --rm-after\tcommand\t' \
    home/dot_local/share/groundwork/commands.tsv
  grep -qF $'project\tscripts/verify-docker-image\tcommand\t' \
    home/dot_local/share/groundwork/commands.tsv

}

validate_static_repository() {
  check "dependency coverage inventory"
  python3 - "$repo/dependency-coverage.json" "$repo" <<'PY'
import json
import pathlib
import re
import sys

inventory_path = pathlib.Path(sys.argv[1])
root = pathlib.Path(sys.argv[2]).resolve()
with inventory_path.open(encoding="utf-8") as source:
    inventory = json.load(source)

if inventory.get("schemaVersion") != 2:
    raise SystemExit("dependency coverage schemaVersion must be 2")
if inventory.get("repository") != "jasondockery/groundwork":
    raise SystemExit("dependency coverage inventory names the wrong repository")

allowed = {"built-in", "custom-manager", "derived", "intentional-manual"}
scan_patterns = {
    "digest",
    "version-assignment",
    "release-download",
    "container-reference",
    "workflow-reference",
    "runtime-literal",
    "plugin-reference",
}
required_ids = {
    "container-images",
    "github-actions-runners-and-containers",
    "shared-preset-reference",
    "shell-quality-tools",
    "homebrew-packages",
    "mise-runtime-channels",
    "corepack-runtime",
    "aider-python-compatibility",
    "tmux-plugin-release",
    "workflow-policy-fixtures",
    "headless-release-assets",
}
seen = set()
for surface in inventory.get("surfaces", []):
    surface_id = surface.get("id")
    if not isinstance(surface_id, str) or not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", surface_id):
        raise SystemExit(f"invalid dependency coverage id: {surface_id!r}")
    if surface_id in seen:
        raise SystemExit(f"duplicate dependency coverage id: {surface_id}")
    seen.add(surface_id)
    if surface.get("classification") not in allowed:
        raise SystemExit(f"{surface_id}: unsupported or missing coverage classification")
    for field in ("manager", "canonical", "compensatingControl", "note"):
        if not isinstance(surface.get(field), str) or not surface[field].strip():
            raise SystemExit(f"{surface_id}: {field} must be non-empty")
    if surface.get("agePolicy") not in {
        "renovate-minimum-release-age",
        "unsupported-by-renovate",
        "external-tool-policy",
        "not-applicable",
    }:
        raise SystemExit(f"{surface_id}: agePolicy is invalid")
    extraction_matchers = surface.get("extractionMatchers", [])
    if not isinstance(extraction_matchers, list):
        raise SystemExit(f"{surface_id}: extractionMatchers must be an array")
    if surface.get("classification") in {"built-in", "custom-manager"} and not extraction_matchers:
        raise SystemExit(f"{surface_id}: automated surfaces require extraction matchers")
    for index, matcher in enumerate(extraction_matchers):
        label = f"{surface_id}.extractionMatchers[{index}]"
        if not isinstance(matcher, dict):
            raise SystemExit(f"{label}: matcher must be an object")
        if not isinstance(matcher.get("manager"), str) or not matcher["manager"].strip():
            raise SystemExit(f"{label}: manager must be non-empty")
        for field in ("packageFilePattern", "depNamePattern"):
            if not isinstance(matcher.get(field), str) or not matcher[field]:
                raise SystemExit(f"{label}: {field} must be non-empty")
            try:
                re.compile(matcher[field])
            except re.error as error:
                raise SystemExit(f"{label}: {field} is invalid: {error}") from error
    scan_matchers = surface.get("scanMatchers", [])
    if not isinstance(scan_matchers, list):
        raise SystemExit(f"{surface_id}: scanMatchers must be an array")
    for index, matcher in enumerate(scan_matchers):
        label = f"{surface_id}.scanMatchers[{index}]"
        if not isinstance(matcher, dict):
            raise SystemExit(f"{label}: matcher must be an object")
        if matcher.get("pattern") not in scan_patterns:
            raise SystemExit(f"{label}: pattern is invalid")
        if not isinstance(matcher.get("pathPattern"), str) or not matcher["pathPattern"]:
            raise SystemExit(f"{label}: pathPattern must be non-empty")
        if "linePattern" in matcher and (not isinstance(matcher["linePattern"], str) or not matcher["linePattern"]):
            raise SystemExit(f"{label}: linePattern must be non-empty when present")
        for field in ("pathPattern", "linePattern"):
            if field in matcher:
                try:
                    re.compile(matcher[field])
                except (re.error, TypeError) as error:
                    raise SystemExit(f"{label}: {field} is invalid: {error}") from error
        if "optional" in matcher and not isinstance(matcher["optional"], bool):
            raise SystemExit(f"{label}: optional must be boolean")
    paths = surface.get("paths")
    if not isinstance(paths, list) or not paths:
        raise SystemExit(f"{surface_id}: paths must be non-empty")
    for relative in paths:
        candidate = pathlib.PurePosixPath(relative)
        if candidate.is_absolute() or ".." in candidate.parts or not (root / candidate).exists():
            raise SystemExit(f"{surface_id}: unsafe or missing path {relative!r}")

for index, suppression in enumerate(inventory.get("scanSuppressions", [])):
    label = f"scanSuppressions[{index}]"
    if not isinstance(suppression, dict):
        raise SystemExit(f"{label}: suppression must be an object")
    if suppression.get("pattern") not in scan_patterns:
        raise SystemExit(f"{label}: pattern is invalid")
    if not isinstance(suppression.get("reason"), str) or not suppression["reason"].strip():
        raise SystemExit(f"{label}: reason must be non-empty")
    if not isinstance(suppression.get("linePattern"), str) or not suppression["linePattern"]:
        raise SystemExit(f"{label}: linePattern must be non-empty")
    if not isinstance(suppression.get("pathPattern"), str) or not suppression["pathPattern"]:
        raise SystemExit(f"{label}: pathPattern must be non-empty")
    if not isinstance(suppression.get("expectedMatches"), int) or suppression["expectedMatches"] < 1:
        raise SystemExit(f"{label}: expectedMatches must be a positive integer")
    for field in ("pathPattern", "linePattern"):
        try:
            re.compile(suppression[field])
        except (re.error, TypeError) as error:
            raise SystemExit(f"{label}: {field} is invalid: {error}") from error

missing = sorted(required_ids - seen)
if missing:
    raise SystemExit(f"dependency coverage inventory is missing required surfaces: {', '.join(missing)}")
manager_by_id = {surface["id"]: surface["manager"] for surface in inventory["surfaces"]}
if manager_by_id["container-images"] != "dockerfile":
    raise SystemExit("container images must remain assigned to Renovate's dockerfile manager")
if manager_by_id["github-actions-runners-and-containers"] != "github-actions":
    raise SystemExit("workflow dependencies must remain assigned to Renovate's github-actions manager")
if manager_by_id["mise-runtime-channels"] != "update-all-mise":
    raise SystemExit("declared mise runtimes must remain assigned to update-all")
shared = next(surface for surface in inventory["surfaces"] if surface["id"] == "shared-preset-reference")
if shared.get("classification") != "intentional-manual" or shared.get("manager") != "versioned-distribution-owner-gate":
    raise SystemExit("the unversioned shared preset must remain owner-gated/manual")
renovate_config = json.loads((root / "renovate.json").read_text(encoding="utf-8"))
if renovate_config.get("ignorePaths") != [".nvmrc", "mise.toml", "home/dot_config/mise/config.toml"]:
    raise SystemExit("Renovate must exclude derived toolchain mirrors and the mise config owned by update-all")
gitleaks_age_rules = [
    rule
    for rule in renovate_config.get("packageRules", [])
    if rule.get("matchDepNames") == ["ghcr.io/gitleaks/gitleaks"]
]
if len(gitleaks_age_rules) != 1:
    raise SystemExit("Renovate must define exactly one Gitleaks age-policy exception")
gitleaks_age_rule = gitleaks_age_rules[0]
if (
    gitleaks_age_rule.get("matchDatasources") != ["docker"]
    or "minimumReleaseAge" not in gitleaks_age_rule
    or gitleaks_age_rule["minimumReleaseAge"] is not None
    or set(gitleaks_age_rule) != {"description", "matchDatasources", "matchDepNames", "minimumReleaseAge"}
):
    raise SystemExit("the Gitleaks age-policy exception must stay exact, Docker-only, and disabled only by null")

ubuntu_major_rules = [
    rule
    for rule in renovate_config.get("packageRules", [])
    if rule.get("matchDepNames") == ["ubuntu"]
]
if len(ubuntu_major_rules) != 1:
    raise SystemExit("Renovate must define exactly one Ubuntu base-image policy rule")
ubuntu_major_rule = ubuntu_major_rules[0]
expected_ubuntu_major_rule = {
    "description": "Ubuntu base-image majors change Groundwork's supported platform contract; require explicit Dependency Dashboard approval before branch and PR creation.",
    "matchManagers": ["dockerfile"],
    "matchDatasources": ["docker"],
    "matchDepNames": ["ubuntu"],
    "matchFileNames": ["Dockerfile"],
    "matchUpdateTypes": ["major"],
    "dependencyDashboardApproval": True,
}
if ubuntu_major_rule != expected_ubuntu_major_rule:
    raise SystemExit("the Ubuntu major rule must stay exact, Dockerfile-only, and approval-gated")

non_major_rules = [
    rule
    for rule in renovate_config.get("packageRules", [])
    if rule.get("groupName") == "non-major dependencies"
]
if len(non_major_rules) != 1 or non_major_rules[0] != {
    "groupName": "non-major dependencies",
    "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
}:
    raise SystemExit("ordinary minor, patch, digest, and pin maintenance must remain enabled and grouped")
if "vulnerabilityAlerts" in renovate_config:
    raise SystemExit("Groundwork-local policy must not override the shared vulnerability-alert bypass")

container_surface = next(surface for surface in inventory["surfaces"] if surface["id"] == "container-images")
if "Ubuntu base-image majors additionally require Dependency Dashboard approval" not in container_surface["compensatingControl"]:
    raise SystemExit("container coverage must distinguish Ubuntu major approval from routine image maintenance")
if "routine Dockerfile frontend and Ubuntu tag/digest maintenance" not in container_surface["note"]:
    raise SystemExit("container coverage must preserve routine Renovate ownership")
PY

  check "groundwork-repos helper"
  test -x home/dot_local/bin/executable_groundwork-repos
  # file_mtime must emit ONLY a number under any stat variant. On GNU stat,
  # `-f` means "filesystem status" and can exit 0 printing a block that starts
  # with "File:" — which broke CI with "File: unbound variable" the moment it
  # reached arithmetic. Drive the extracted function with a GNU-like stub and
  # a pathological always-garbage stub.
  repos_stat_fixture="$out_dir/repos-stat"
  mkdir -p "$repos_stat_fixture/gnu-bin" "$repos_stat_fixture/bsd-bin" "$repos_stat_fixture/weird-bin"
  cat >"$repos_stat_fixture/gnu-bin/stat" <<'SH'
#!/usr/bin/env bash
if [[ "$1" == "-c" ]]; then echo 1752900000; exit 0; fi
printf '  File: "/some/path"\n    ID: 100000 Namelen: 255\n'
SH
  # BSD/macOS: -c is an invalid flag; -f %m answers. Stubbing it keeps the
  # test independent of whichever real stat this machine happens to have.
  cat >"$repos_stat_fixture/bsd-bin/stat" <<'SH'
#!/usr/bin/env bash
if [[ "$1" == "-c" ]]; then exit 1; fi
if [[ "$1" == "-f" ]]; then echo 1752900001; exit 0; fi
exit 1
SH
  cat >"$repos_stat_fixture/weird-bin/stat" <<'SH'
#!/usr/bin/env bash
printf '  File: "/some/path"\n'
SH
  chmod +x "$repos_stat_fixture/gnu-bin/stat" "$repos_stat_fixture/bsd-bin/stat" \
    "$repos_stat_fixture/weird-bin/stat"
  sed -n '/^file_mtime()/,/^}/p' home/dot_local/bin/executable_groundwork-repos \
    >"$repos_stat_fixture/file_mtime.sh"
  grep -q 'file_mtime()' "$repos_stat_fixture/file_mtime.sh" \
    || fail "could not extract file_mtime from groundwork-repos for the stat-variant test"
  repos_mtime="$(PATH="$repos_stat_fixture/gnu-bin:/usr/bin:/bin" bash -uc \
    ". '$repos_stat_fixture/file_mtime.sh'; file_mtime /tmp")" \
    || fail "file_mtime failed under a GNU-like stat"
  [[ "$repos_mtime" == "1752900000" ]] \
    || fail "file_mtime under GNU-like stat must return the -c %Y value, got: $repos_mtime"
  repos_mtime="$(PATH="$repos_stat_fixture/bsd-bin:/usr/bin:/bin" bash -uc \
    ". '$repos_stat_fixture/file_mtime.sh'; file_mtime /tmp")" \
    || fail "file_mtime failed under a BSD-like stat"
  [[ "$repos_mtime" == "1752900001" ]] \
    || fail "file_mtime under BSD-like stat must fall back to -f %m, got: $repos_mtime"
  repos_mtime="$(PATH="$repos_stat_fixture/weird-bin:/usr/bin:/bin" bash -uc \
    ". '$repos_stat_fixture/file_mtime.sh'; file_mtime /tmp")" \
    || fail "file_mtime failed under a garbage-emitting stat"
  [[ "$repos_mtime" == "0" ]] \
    || fail "file_mtime must emit 0 when no stat variant yields a number, got: $repos_mtime"
  test -f home/dot_config/groundwork/repos.conf.tmpl
  test -f home/dot_config/lazygit/config.yml
  # Discovery stays dynamic: the managed config configures ROOTS, never names.
  grep -qF 'root = {{ .code_dir }}' home/dot_config/groundwork/repos.conf.tmpl
  grep -qF 'max_depth' home/dot_config/groundwork/repos.conf.tmpl
  grep -qF 'include_worktrees' home/dot_config/groundwork/repos.conf.tmpl
  grep -qF 'cache_ttl_seconds' home/dot_config/groundwork/repos.conf.tmpl
  grep -qF 'exclude = node_modules' home/dot_config/groundwork/repos.conf.tmpl
  # The deliberately simple config format documents its own limitation.
  grep -qF 'paths containing' home/dot_config/groundwork/repos.conf.tmpl
  # Inspection safety: the safe_git wrapper and the fzf preview both disable
  # repository hooks and the fsmonitor; the behavior proof is the fsmonitor
  # tripwire below.
  grep -qF 'core.hooksPath=/dev/null' home/dot_local/bin/executable_groundwork-repos
  grep -F -- '--preview' home/dot_local/bin/executable_groundwork-repos | grep -qF 'core.fsmonitor=false'
  # Docs promise the precise guarantee, not a blanket "never executed", and
  # the honest cache timing (TTL or --refresh), not "next run".
  assert_no_matches "docs/config claim a blanket never-executed guarantee for discovery" \
    rg -n 'ever executed|never executes code' docs/repo-navigation.html home/dot_config/groundwork/repos.conf.tmpl
  assert_no_matches "stale 'next run' cache claim survived" \
    rg -n 'next run' docs/repo-navigation.html docs/commands.html \
    home/dot_config/groundwork/repos.conf.tmpl home/dot_local/share/groundwork/commands.tsv \
    home/dot_local/bin/executable_groundwork-repos
  # lazygit defaults keep their agent-inspection and accessibility contract.
  grep -qF 'editPreset: nvim' home/dot_config/lazygit/config.yml
  grep -qF 'language: auto' home/dot_config/lazygit/config.yml
  grep -qF 'showBottomLine: true' home/dot_config/lazygit/config.yml
  grep -qF 'showPanelJumps: true' home/dot_config/lazygit/config.yml
  grep -qF '    - [status]' home/dot_config/lazygit/config.yml
  grep -qF '    - [files, worktrees, submodules]' home/dot_config/lazygit/config.yml
  grep -qF '    - [branches, remotes, tags]' home/dot_config/lazygit/config.yml
  grep -qF '    - [commits, reflog]' home/dot_config/lazygit/config.yml
  grep -qF '    - [stash]' home/dot_config/lazygit/config.yml
  grep -qF 'switchTabsWithPanelJumpKeys: true' home/dot_config/lazygit/config.yml
  grep -qF 'skipSwitchWorktreeOnCheckoutWarning: false' home/dot_config/lazygit/config.yml
  grep -qF 'animateExplosion: false' home/dot_config/lazygit/config.yml
  grep -qF 'Open repository in Neovim' home/dot_config/lazygit/config.yml
  grep -qF 'press the active panel' docs/lazygit.html
  grep -qF '&lt;configured-root&gt;/.worktrees/&lt;unique-repo-slug&gt;/&lt;lane&gt;' docs/worktrees.html
  # lazygit only reads ~/.config on macOS when XDG_CONFIG_HOME says so; the
  # export lives in the login shell so tmux servers and tool runners inherit it.
  grep -qF "export XDG_CONFIG_HOME=\"\${XDG_CONFIG_HOME:-\$HOME/.config}\"" home/dot_zprofile.tmpl
  # tmux: the picker and dirty-repo bindings exist, call the helper by absolute
  # path, and the current-repo lazygit popup (prefix g) stays.
  grep -qF 'bind -N "repo picker" R display-popup' home/dot_config/tmux/tmux.conf.tmpl
  grep -qF "\"\$HOME/.local/bin/groundwork-repos\" pick" home/dot_config/tmux/tmux.conf.tmpl
  grep -qF 'bind -N "lazygit for every dirty repo" G run-shell -b' home/dot_config/tmux/tmux.conf.tmpl
  grep -qF "\"\$HOME/.local/bin/groundwork-repos\" changed" home/dot_config/tmux/tmux.conf.tmpl
  grep -qF 'bind g display-popup' home/dot_config/tmux/tmux.conf.tmpl
  # Catalog rows stay discoverable.
  grep -qF $'project\tgroundwork-repos\tcommand\t' home/dot_local/share/groundwork/commands.tsv
  grep -qF $'tmux\tCtrl+a then Shift+R\tkey\t' home/dot_local/share/groundwork/commands.tsv
  grep -qF $'tmux\tCtrl+a then Shift+G\tkey\t' home/dot_local/share/groundwork/commands.tsv
  # The skill that guards this surface keeps its central rule verbatim.
  grep -qF 'Repository behavior is discovered dynamically. Never hardcode a user'"'"'s current repository list into tmux, shell, Lazygit, or documentation.' skills/developer-workspace-navigation/SKILL.md

  # Behavior suite. Fixtures are real throwaway git repos (git is already a
  # dependency of this script and discovery is read-only data inspection);
  # tmux, fzf, and lazygit are PATH stubs that record argv one word per line,
  # so quoting mistakes (a path with spaces splitting into two words) are
  # provable, not assumed. The tool PATH is hermetic: only the stubs plus
  # symlinks to the exact real binaries the helper is allowed to need.
  repos_dir="$out_dir/repos"
  repos_root="$repos_dir/root"
  repos_root2="$repos_dir/root2"
  repos_xdg="$repos_dir/xdg"
  repos_cache="$repos_dir/cache"
  repos_stub="$repos_dir/stub"
  repos_stub_nofzf="$repos_dir/stub-nofzf"
  repos_tools="$repos_dir/tools"
  repos_tmux_log="$repos_dir/tmux-log"
  repos_fzf_in="$repos_dir/fzf-in"
  repos_fzf_args="$repos_dir/fzf-args"
  mkdir -p "$repos_root" "$repos_root2" "$repos_xdg/groundwork" "$repos_cache" \
    "$repos_stub" "$repos_stub_nofzf" "$repos_tools"
  repos_dir="$(cd "$repos_dir" && pwd -P)"
  repos_root="$(cd "$repos_root" && pwd -P)"
  repos_root2="$(cd "$repos_root2" && pwd -P)"

  for repos_tool in git find sort awk grep head uniq stat date mktemp mv mkdir cat rm tr; do
    repos_tool_path="$(command -v "$repos_tool")" \
      || fail "groundwork-repos suite: required tool missing: $repos_tool"
    ln -s "$repos_tool_path" "$repos_tools/$repos_tool"
  done
  unset repos_tool repos_tool_path

  # /bin/sh shebangs: the stubs run under the hermetic PATH, where an
  # `env bash` lookup would find nothing.
  cat >"$repos_stub/tmux" <<'SH'
#!/bin/sh
printf '%s\n' "$@" >>"${REPOS_TMUX_LOG:?}"
case "${1:-}" in
  has-session) exit 1 ;;
esac
exit 0
SH
  cat >"$repos_stub/lazygit" <<'SH'
#!/bin/sh
exit 0
SH
  cat >"$repos_stub/fzf" <<'SH'
#!/bin/sh
printf '%s\n' "$@" >"${REPOS_FZF_ARGS:?}"
cat >"${REPOS_FZF_INPUT:?}"
grep -F -- "${REPOS_FZF_CHOOSE:?}" "$REPOS_FZF_INPUT" | head -n 1
SH
  chmod +x "$repos_stub/tmux" "$repos_stub/lazygit" "$repos_stub/fzf"
  cp "$repos_stub/tmux" "$repos_stub_nofzf/tmux"
  cp "$repos_stub/lazygit" "$repos_stub_nofzf/lazygit"
  chmod +x "$repos_stub_nofzf/tmux" "$repos_stub_nofzf/lazygit"

  repos_git() {
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
      git -c init.defaultBranch=main -c user.name=groundwork \
      -c user.email=groundwork@example.invalid "$@"
  }
  repos_mk() {
    mkdir -p "$1"
    repos_git -C "$1" init -q
    repos_git -C "$1" commit -q --allow-empty -m init
  }
  repos_mk "$repos_root/alpha"
  repos_mk "$repos_root/space repo"
  repos_mk "$repos_root/one/app"
  repos_mk "$repos_root/two/app"
  repos_mk "$repos_root/outer"
  # The nested repo must exercise nesting, not dirtiness: without this ignore,
  # inner/ would be untracked content that makes outer permanently dirty.
  printf 'inner/\n' >"$repos_root/outer/.gitignore"
  repos_git -C "$repos_root/outer" add .gitignore
  repos_git -C "$repos_root/outer" commit -q -m ignore-inner
  repos_mk "$repos_root/outer/inner"
  repos_mk "$repos_root/node_modules/hidden"
  repos_mk "$repos_root/d1/d2/d3/d4/toodeep"
  repos_git -C "$repos_root/alpha" worktree add -q "$repos_root/alpha-wt"
  repos_git -C "$repos_root/alpha" worktree add -q -b agent-one \
    "$repos_root/.worktrees/example-alpha/agent-one"
  echo change >"$repos_root/.worktrees/example-alpha/agent-one/untracked.txt"
  mkdir -p "$repos_root/loop"
  ln -s .. "$repos_root/loop/back"
  echo change >"$repos_root/space repo/untracked.txt"
  # Cross-root collisions for shortest-unique-suffix window naming: identical
  # basename AND parent across two roots (client/app under both), plus a
  # triple-depth collision (aa/bb/deep under both) that only the root
  # directory itself disambiguates.
  repos_mk "$repos_root/client/app"
  repos_mk "$repos_root2/client/app"
  repos_mk "$repos_root/aa/bb/deep"
  repos_mk "$repos_root2/aa/bb/deep"
  # The fsmonitor tripwire: a repo whose own config points core.fsmonitor at a
  # script that writes a sentinel. Discovery and status must never trigger it.
  repos_mk "$repos_root/fsmon"
  repos_fsmon_sentinel="$repos_dir/fsmon-sentinel"
  cat >"$repos_dir/fsmon-hook" <<SH
#!/bin/sh
echo ran >>"$repos_fsmon_sentinel"
echo "/"
SH
  chmod +x "$repos_dir/fsmon-hook"
  repos_git -C "$repos_root/fsmon" config core.fsmonitor "$repos_dir/fsmon-hook"

  cat >"$repos_xdg/groundwork/repos.conf" <<EOF
root = $repos_root
root = $repos_root2
max_depth = 4
include_worktrees = true
cache_ttl_seconds = 0
exclude = node_modules
exclude = .cache
exclude = dist
exclude = vendor
EOF

  # repos_run <TMUX value> <PATH> <args...>
  repos_run() {
    local tmux_env="$1" path_env="$2"
    shift 2
    TMUX="$tmux_env" PATH="$path_env" \
      XDG_CONFIG_HOME="$repos_xdg" XDG_CACHE_HOME="$repos_cache" \
      GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
      REPOS_TMUX_LOG="$repos_tmux_log" REPOS_FZF_INPUT="$repos_fzf_in" \
      REPOS_FZF_ARGS="$repos_fzf_args" \
      REPOS_FZF_CHOOSE="${REPOS_FZF_CHOOSE:-}" NO_COLOR=1 \
      /bin/bash home/dot_local/bin/executable_groundwork-repos "$@"
  }
  repos_path="$repos_stub:$repos_tools"

  # Discovery: repos with .git dirs AND .git files (worktrees), spaces,
  # duplicate basenames, and nested repos all appear; excluded dirs and
  # repos beyond max_depth do not; the symlink loop terminates and the
  # canonical dedupe leaves every repo listed exactly once.
  repos_tmp="$repos_dir/tmp"
  mkdir -p "$repos_tmp"
  TMPDIR="$repos_tmp" repos_run '' "$repos_path" list >"$repos_dir/list-out"
  if compgen -G "$repos_tmp/groundwork-repos-*" >/dev/null; then
    fail "ordinary repository discovery leaked temporary files"
  fi
  grep -qF "$repos_root/alpha"$'\t' "$repos_dir/list-out"
  grep -qF "$repos_root/space repo"$'\t' "$repos_dir/list-out"
  grep -qF "$repos_root/one/app"$'\t' "$repos_dir/list-out"
  grep -qF "$repos_root/two/app"$'\t' "$repos_dir/list-out"
  grep -qF "$repos_root/client/app"$'\t' "$repos_dir/list-out"
  grep -qF "$repos_root2/client/app"$'\t' "$repos_dir/list-out"
  grep -qF "$repos_root/outer"$'\t' "$repos_dir/list-out"
  grep -qF "$repos_root/outer/inner"$'\t' "$repos_dir/list-out"
  grep -qF "$repos_root/alpha-wt"$'\t'"wt" "$repos_dir/list-out"
  grep -qF "$repos_root/.worktrees/example-alpha/agent-one"$'\t'"wt" "$repos_dir/list-out"
  assert_no_matches "excluded directory leaked into discovery" grep -n 'node_modules' "$repos_dir/list-out"
  assert_no_matches "repo beyond max_depth leaked into discovery" grep -n 'toodeep' "$repos_dir/list-out"
  assert_no_matches "symlink-loop paths leaked past canonical dedupe" grep -n '/loop/back/' "$repos_dir/list-out"
  if [[ -n "$(awk -F'\t' '{print $1}' "$repos_dir/list-out" | sort | uniq -d)" ]]; then
    fail "groundwork-repos listed a repository more than once"
  fi

  # Strict live discovery is all-or-nothing. Even when find emits a valid prefix,
  # a nonzero traversal status produces no list and names the failed root.
  cat >"$repos_stub/find" <<'SH'
#!/bin/sh
printf '%s\0' "${STRICT_FIND_GIT_PATH:?}"
echo "fixture traversal failed" >&2
exit 7
SH
  chmod +x "$repos_stub/find"
  export STRICT_FIND_GIT_PATH="$repos_root/alpha/.git"
  set +e
  TMPDIR="$repos_tmp" repos_run '' "$repos_path" --strict --no-cache list \
    >"$repos_dir/strict-partial-list" 2>"$repos_dir/strict-partial-error"
  repos_status=$?
  set -e
  [[ "$repos_status" -ne 0 ]] \
    || fail "strict repository discovery accepted a partial find result"
  test ! -s "$repos_dir/strict-partial-list" \
    || fail "strict repository discovery emitted a partial repository inventory"
  grep -qF 'repository discovery failed for' "$repos_dir/strict-partial-error"
  grep -qF 'fixture\ traversal\ failed' "$repos_dir/strict-partial-error"
  TMPDIR="$repos_tmp" repos_run '' "$repos_path" list \
    >"$repos_dir/non-strict-partial-list" \
    || fail "interactive repository discovery rejected a safe partial inventory"
  grep -qF "$repos_root/alpha"$'\t' "$repos_dir/non-strict-partial-list" \
    || fail "interactive repository discovery lost its safe partial inventory"
  if compgen -G "$repos_tmp/groundwork-repos-*" >/dev/null; then
    fail "failed interactive discovery leaked temporary files"
  fi
  # The loop has already proved bounded, canonical non-strict discovery above.
  # GNU find correctly reports a followed symlink loop as a traversal error, so
  # remove that fixture before the later strict tests isolate cache and missing
  # root failures.
  rm -f "$repos_stub/find" "$repos_root/loop/back"
  unset STRICT_FIND_GIT_PATH
  set +e
  repos_run '' "$repos_path" --strict list \
    >"$repos_dir/strict-cache-list" 2>"$repos_dir/strict-cache-error"
  repos_status=$?
  set -e
  [[ "$repos_status" -ne 0 ]] \
    || fail "strict repository discovery accepted a cache-backed inventory"
  grep -qF 'requires --no-cache' "$repos_dir/strict-cache-error"
  printf 'root = %s\n' "$repos_dir/missing-root" \
    >"$repos_xdg/groundwork/repos.local.conf"
  set +e
  repos_run '' "$repos_path" --strict --no-cache list \
    >"$repos_dir/strict-missing-list" 2>"$repos_dir/strict-missing-error"
  repos_status=$?
  set -e
  [[ "$repos_status" -ne 0 ]] \
    || fail "strict repository discovery accepted a missing configured root"
  test ! -s "$repos_dir/strict-missing-list" \
    || fail "strict repository discovery emitted an inventory with a missing root"
  grep -qF 'strict discovery requires configured root' "$repos_dir/strict-missing-error" \
    || fail "strict repository discovery did not report the missing configured root"
  repos_run '' "$repos_path" --no-cache list >/dev/null \
    || fail "interactive non-strict discovery stopped treating missing roots as optional"
  rm -f "$repos_xdg/groundwork/repos.local.conf"

  # A fresh clone appears with zero config changes.
  repos_mk "$repos_root/charlie"
  repos_run '' "$repos_path" list | grep -qF "$repos_root/charlie"

  # The include_worktrees toggle is honored via the unmanaged local overlay.
  echo 'include_worktrees = false' >"$repos_xdg/groundwork/repos.local.conf"
  repos_run '' "$repos_path" list >"$repos_dir/list-nowt"
  assert_no_matches "worktree listed despite include_worktrees=false" grep -n 'alpha-wt' "$repos_dir/list-nowt"
  rm -f "$repos_xdg/groundwork/repos.local.conf"

  # The status table: dirty/clean as symbol + word (never color-only; NO_COLOR
  # is set for the whole suite), shortest-unique-suffix repo names, the
  # worktree marker, and the branch.
  repos_run '' "$repos_path" status >"$repos_dir/status-out"
  grep -F 'space repo' "$repos_dir/status-out" | grep -qF '● dirty'
  grep -- '/alpha$' "$repos_dir/status-out" | grep -qF '✓ clean'
  grep -qF 'one/app' "$repos_dir/status-out"
  grep -qF 'two/app' "$repos_dir/status-out"
  grep -- '/alpha-wt$' "$repos_dir/status-out" | grep -qF ' wt '
  grep -F 'agent-one' "$repos_dir/status-out" | grep -qF '● dirty'
  grep -F 'agent-one' "$repos_dir/status-out" | grep -qF ' wt '
  grep -qF 'main' "$repos_dir/status-out"
  assert_no_matches "status table must not emit color under NO_COLOR" grep -n $'\033\[' "$repos_dir/status-out"
  # Shortest-unique-suffix names: identical basename+parent across two roots
  # extends to the root component; a triple-depth collision extends further;
  # nothing keeps an ambiguous shorter name; and every name is unique.
  awk '{ print $1 }' "$repos_dir/status-out" >"$repos_dir/status-names"
  grep -qxF 'root/client/app' "$repos_dir/status-names"
  grep -qxF 'root2/client/app' "$repos_dir/status-names"
  grep -qxF 'root/aa/bb/deep' "$repos_dir/status-names"
  grep -qxF 'root2/aa/bb/deep' "$repos_dir/status-names"
  assert_no_matches "an ambiguous shorter name survived (client/app)" grep -nxF 'client/app' "$repos_dir/status-names"
  assert_no_matches "an ambiguous shorter name survived (bb/deep)" grep -nxF 'bb/deep' "$repos_dir/status-names"
  assert_no_matches "an ambiguous shorter name survived (deep)" grep -nxF 'deep' "$repos_dir/status-names"
  if [[ -n "$(sort "$repos_dir/status-names" | uniq -d)" ]]; then
    fail "groundwork-repos status produced duplicate repo names"
  fi

  # Clean/dirty transitions show immediately: the cache stores paths only,
  # state is always read live.
  rm "$repos_root/space repo/untracked.txt"
  repos_run '' "$repos_path" status | grep -F 'space repo' | grep -qF '✓ clean'

  # The fsmonitor tripwire. First prove the fixture is LIVE: plain git status
  # in that repo executes the configured core.fsmonitor script.
  rm -f "$repos_fsmon_sentinel"
  repos_git -C "$repos_root/fsmon" status --porcelain >/dev/null
  if [[ ! -f "$repos_fsmon_sentinel" ]]; then
    fail "fsmonitor fixture is not live: plain git status did not run the configured core.fsmonitor"
  fi
  # Now every groundwork-repos mode walks the same repo, and the safe wrapper
  # (hooks and fsmonitor disabled per git call) must keep the script silent.
  rm -f "$repos_fsmon_sentinel"
  repos_run '' "$repos_path" list >/dev/null
  repos_run '' "$repos_path" status >/dev/null
  : >"$repos_tmux_log"
  REPOS_FZF_CHOOSE='alpha' repos_run 'validate,0,0' "$repos_path" pick
  repos_run 'validate,0,0' "$repos_path" changed >/dev/null
  if [[ -f "$repos_fsmon_sentinel" ]]; then
    fail "a groundwork-repos mode executed a discovered repo's core.fsmonitor — inspection must disable repository hooks and the fsmonitor"
  fi
  # The fzf preview runs git OUTSIDE the helper process; it must carry the
  # same neutralizing flags — asserted on the recorded fzf argv, then proven
  # by executing the preview command against the tripwire repo.
  repos_preview_cmd="$(awk 'found { print; exit } $0 == "--preview" { found = 1 }' "$repos_fzf_args")"
  [[ -n "$repos_preview_cmd" ]] || fail "the picker no longer passes an fzf --preview command"
  case "$repos_preview_cmd" in
    *GIT_OPTIONAL_LOCKS=0*core.fsmonitor=false*core.untrackedCache=false*core.hooksPath=/dev/null*) : ;;
    *) fail "the fzf preview git command lost its hook/fsmonitor-disabling flags: $repos_preview_cmd" ;;
  esac
  rm -f "$repos_fsmon_sentinel"
  repos_fsmon_quoted="'$repos_root/fsmon'"
  repos_preview_run="${repos_preview_cmd//\{2\}/$repos_fsmon_quoted}"
  GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null PATH="$repos_path" \
    /bin/sh -c "$repos_preview_run" >/dev/null
  if [[ -f "$repos_fsmon_sentinel" ]]; then
    fail "the fzf preview command executed a discovered repo's core.fsmonitor"
  fi

  # The picker, inside tmux: fzf sees every repo, and the selected repo's
  # window opens via new-window -S (reuse, never duplicate) with the path
  # travelling as ONE argv word — spaces intact.
  : >"$repos_tmux_log"
  REPOS_FZF_CHOOSE='space repo' repos_run 'validate,0,0' "$repos_path" pick
  grep -qF "$repos_root/alpha" "$repos_fzf_in"
  grep -qxF -- 'new-window' "$repos_tmux_log"
  grep -qxF -- '-S' "$repos_tmux_log"
  grep -qxF -- 'space repo' "$repos_tmux_log"
  grep -qxF -- "$repos_root/space repo" "$repos_tmux_log"
  grep -qxF -- 'lazygit' "$repos_tmux_log"
  assert_no_matches "picker inside tmux must not create sessions" grep -n 'new-session' "$repos_tmux_log"

  # The picker, outside tmux: it creates the repos session and attaches.
  : >"$repos_tmux_log"
  REPOS_FZF_CHOOSE='alpha' repos_run '' "$repos_path" pick
  grep -qxF -- 'new-session' "$repos_tmux_log"
  grep -qxF -- 'repos' "$repos_tmux_log"
  grep -qxF -- 'attach-session' "$repos_tmux_log"

  # Window names in tmux carry the shortest unique suffix: two dirty repos
  # with identical basename+parent across roots open under distinct names.
  echo dirt >"$repos_root/client/app/wip.txt"
  echo dirt >"$repos_root2/client/app/wip.txt"
  : >"$repos_tmux_log"
  repos_run 'validate,0,0' "$repos_path" changed >/dev/null
  grep -qxF -- 'root/client/app' "$repos_tmux_log"
  grep -qxF -- 'root2/client/app' "$repos_tmux_log"
  rm "$repos_root/client/app/wip.txt" "$repos_root2/client/app/wip.txt"

  # changed: one window per dirty repo, including the persistent agent
  # worktree under .worktrees, and none for clean repos.
  echo dirt >"$repos_root/alpha/wip.txt"
  echo dirt >"$repos_root/one/app/wip.txt"
  : >"$repos_tmux_log"
  repos_run 'validate,0,0' "$repos_path" changed >"$repos_dir/changed-out"
  test "$(grep -cxF -- 'new-window' "$repos_tmux_log")" = 3
  grep -qxF -- 'one/app' "$repos_tmux_log"
  grep -qxF -- 'agent-one' "$repos_tmux_log"
  assert_no_matches "changed opened a window for a clean repo" grep -n "$repos_root/two/app" "$repos_tmux_log"
  grep -qF 'opened 3 lazygit window(s)' "$repos_dir/changed-out"

  # changed with everything clean opens nothing and says so.
  rm "$repos_root/alpha/wip.txt" "$repos_root/one/app/wip.txt" \
    "$repos_root/.worktrees/example-alpha/agent-one/untracked.txt"
  : >"$repos_tmux_log"
  repos_run 'validate,0,0' "$repos_path" changed >"$repos_dir/changed-clean"
  grep -qF 'every discovered repository is clean' "$repos_dir/changed-clean"
  test ! -s "$repos_tmux_log"

  # Without fzf the picker degrades to a message plus the list, not a stack trace.
  if repos_run 'validate,0,0' "$repos_stub_nofzf:$repos_tools" pick \
    >"$repos_dir/pick-nofzf" 2>&1; then
    fail "groundwork-repos pick succeeded without fzf"
  fi
  grep -qF 'needs fzf' "$repos_dir/pick-nofzf"
  grep -qF "$repos_root/alpha" "$repos_dir/pick-nofzf"

  # The discovery cache honors its TTL, and paths (not state) are what it holds.
  cat >"$repos_xdg/groundwork/repos.local.conf" <<'EOF'
cache_ttl_seconds = 300
EOF
  repos_run '' "$repos_path" list >/dev/null
  rm -rf "$repos_root/charlie"
  repos_run '' "$repos_path" list | grep -qF "$repos_root/charlie" \
    || fail "warm cache inside TTL should still list the removed repo"
  # Maintenance discovery needs the same canonical roots without trusting or
  # rewriting interactive cache state. --no-cache sees live removal, and the
  # following plain run proves it did not replace the still-warm cache.
  repos_run '' "$repos_path" --no-cache list >"$repos_dir/list-no-cache"
  assert_no_matches "--no-cache still served the stale cache" \
    grep -nF "$repos_root/charlie" "$repos_dir/list-no-cache"
  repos_run '' "$repos_path" list | grep -qF "$repos_root/charlie" \
    || fail "--no-cache rewrote the interactive discovery cache"
  if repos_run '' "$repos_path" --no-cache status >/dev/null 2>&1; then
    fail "groundwork-repos accepted --no-cache outside list mode"
  fi
  if repos_run '' "$repos_path" --no-cache --refresh list >/dev/null 2>&1; then
    fail "groundwork-repos accepted conflicting cache controls"
  fi
  # The list protocol is deliberately tab-delimited, and every emitted path also
  # reaches a terminal-facing report. Real repositories containing either a
  # record delimiter or a terminal escape make live discovery fail closed.
  for repos_control_path in "$repos_root/control"$'\t'"repo" "$repos_root/control"$'\033'"repo"; do
    repos_mk "$repos_control_path"
    if repos_run '' "$repos_path" --no-cache list >/dev/null 2>&1; then
      fail "groundwork-repos serialized a terminal-control repository path"
    fi
    rm -rf "$repos_control_path"
  done
  # --refresh bypasses AND rewrites the cache: the change shows immediately,
  # and the next plain run reads the rewritten cache, not the stale one.
  repos_run '' "$repos_path" --refresh list >"$repos_dir/list-refresh"
  assert_no_matches "--refresh still served the stale cache" \
    grep -nF "$repos_root/charlie" "$repos_dir/list-refresh"
  repos_run '' "$repos_path" list >"$repos_dir/list-after-refresh"
  assert_no_matches "--refresh did not rewrite the cache for the next run" \
    grep -nF "$repos_root/charlie" "$repos_dir/list-after-refresh"
  rm -f "$repos_xdg/groundwork/repos.local.conf" "$repos_cache/groundwork/repos.list"

  # The same cache path under a GNU-like stat — the exact CI failure: Ubuntu's
  # stat answered `-f %m` with a "File:" block and exit 0, which reached the
  # TTL arithmetic as "File: unbound variable". Shadow stat with a GNU-like
  # stub (delegating -c %Y to python for a real mtime) and run the REAL helper
  # twice: warm the cache, then evaluate its freshness end to end.
  repos_python="$(command -v python3)" || fail "groundwork-repos suite: python3 missing"
  repos_gnu_bin="$repos_dir/gnu-stat-bin"
  mkdir -p "$repos_gnu_bin"
  cat >"$repos_gnu_bin/stat" <<SH
#!/bin/sh
if [ "\$1" = "-c" ] && [ "\$2" = "%Y" ]; then
  exec "$repos_python" -c 'import os,sys;print(int(os.stat(sys.argv[1]).st_mtime))' "\$3"
fi
printf '  File: "irrelevant"\n    ID: 100000 Namelen: 255\n'
exit 0
SH
  chmod +x "$repos_gnu_bin/stat"
  cat >"$repos_xdg/groundwork/repos.local.conf" <<'EOF'
cache_ttl_seconds = 300
EOF
  repos_run '' "$repos_gnu_bin:$repos_path" list >"$repos_dir/gnu-cache-warm" \
    || fail "groundwork-repos failed discovery under a GNU-like stat"
  grep -qF "$repos_root/alpha"$'\t' "$repos_dir/gnu-cache-warm" \
    || fail "discovery under a GNU-like stat lost a repository"
  repos_run '' "$repos_gnu_bin:$repos_path" list \
    >"$repos_dir/gnu-cache-hit" 2>"$repos_dir/gnu-cache-err" \
    || fail "groundwork-repos failed evaluating a warm cache under a GNU-like stat"
  grep -qF "$repos_root/alpha"$'\t' "$repos_dir/gnu-cache-hit" \
    || fail "the warm-cache run under a GNU-like stat lost a repository"
  assert_no_matches "the GNU-stat cache path hit an unbound-variable error" \
    grep -n 'unbound variable' "$repos_dir/gnu-cache-err"
  rm -f "$repos_xdg/groundwork/repos.local.conf" "$repos_cache/groundwork/repos.list"

  # Help and option hygiene, same contract as the other helpers.
  repos_run '' "$repos_path" --help | grep -qF 'groundwork-help repos'
  if repos_run '' "$repos_path" --bogus >/dev/null 2>&1; then
    fail "groundwork-repos accepted an unknown option"
  fi

  check "chezmoi root"
  test "$(cat .chezmoiroot)" = "home"
  grep -q '^2\.70\.0$' .chezmoiversion
  test -f home/.chezmoi.toml.tmpl
  test ! -f .chezmoi.toml.tmpl
  test -f home/dot_zprofile.tmpl
  test -x home/dot_codex/modify_private_config.toml
  grep -qF 'mise activate zsh --shims' home/dot_zprofile.tmpl
  grep -qF 'experimental_use_profile = true' home/dot_codex/modify_private_config.toml
  grep -qF 'config.global.show_in_menu_bar = true;' home/dot_config/private_karabiner/modify_karabiner.json
  assert_no_matches "Karabiner menu bar icon must stay visible for setup/debugging" rg -n 'show_in_menu_bar[[:space:]]*=[[:space:]]*false|show_in_menu_bar"[[:space:]]*:[[:space:]]*false' home/dot_config/private_karabiner
  # Karabiner-Elements chmods ~/.config/karabiner to 700, so the source dir must
  # carry the private_ attribute; without it every apply wants the mode back to
  # 755 and prompts ".config/karabiner has changed since chezmoi last wrote it".
  test -d home/dot_config/private_karabiner \
    || fail "karabiner must live at home/dot_config/private_karabiner (private_ = mode 700, matching what the app enforces)"
  test ! -e home/dot_config/karabiner \
    || fail "home/dot_config/karabiner must not exist alongside private_karabiner"
  # The modify script must pass a semantically settled config through
  # byte-for-byte — in Karabiner's own serialization (4-space, alphabetized
  # keys), not just its own: anything else rewrites the file and prompts on
  # every apply forever. JXA needs macOS, so this only runs where osascript is.
  if command -v osascript >/dev/null 2>&1; then
    karabiner_fixture="$out_dir/karabiner-idempotence"
    mkdir -p "$karabiner_fixture"
    /bin/bash home/dot_config/private_karabiner/modify_karabiner.json \
      </dev/null >"$karabiner_fixture/seeded.json" \
      || fail "karabiner modify failed on an empty config"
    grep -qF 'Groundwork: Caps Lock' "$karabiner_fixture/seeded.json" \
      || fail "karabiner modify must add the Groundwork rule to an empty config"
    # The Caps Lock escape hatch, and the ORDER that makes it work. Once caps_lock
    # is remapped, the physical key can never emit a real Caps Lock again — so if
    # the system state is switched on by anything else, the LED stays lit with no
    # way back except disabling the rule. Right Shift + Caps Lock is the deliberate
    # toggle (it turns the state ON as readily as off; it is not a one-way clear).
    python3 -c 'import json,sys
config = json.load(open(sys.argv[1]))
profile = next((p for p in config["profiles"] if p.get("selected")), config["profiles"][0])
rules = [r for r in profile["complex_modifications"]["rules"] if "Caps Lock" in r.get("description", "")]
if len(rules) != 1:
    sys.exit("expected exactly one Groundwork Caps Lock rule, got %d" % len(rules))
manipulators = rules[0]["manipulators"]
if len(manipulators) != 2:
    sys.exit("expected 2 manipulators (escape hatch + tap/hold), got %d" % len(manipulators))
hatch, generic = manipulators
# Karabiner takes the FIRST match, so the specific rule must come first or the
# generic one swallows every caps_lock press and the hatch is dead code.
if hatch["from"].get("modifiers", {}).get("mandatory") != ["right_shift"]:
    sys.exit("the first manipulator must be the right_shift escape hatch")
if [t.get("key_code") for t in hatch["to"]] != ["caps_lock", "vk_none"]:
    sys.exit("the escape hatch must send a real caps_lock followed by vk_none")
if hatch["to"][0].get("hold_down_milliseconds") != 200:
    sys.exit("the synthetic caps_lock needs a hold duration to register reliably")
if generic["from"].get("modifiers", {}).get("mandatory"):
    sys.exit("the generic tap/hold manipulator must not require a modifier")
if [t.get("key_code") for t in generic["to"]] != ["left_control"]:
    sys.exit("the generic manipulator must map hold to left_control")
if [t.get("key_code") for t in generic.get("to_if_alone", [])] != ["escape"]:
    sys.exit("the generic manipulator must map tap to escape")' \
      "$karabiner_fixture/seeded.json" \
      || fail "the Caps Lock rule must carry a right_shift escape hatch BEFORE the generic tap/hold manipulator"
    # Suppressing the LED would hide the symptom and remove the only signal that
    # real Caps Lock is active — the escape hatch is the fix, not disabling it.
    assert_no_matches "Karabiner's Caps Lock LED manipulation must stay enabled (the escape hatch is the fix, not hiding the light)" \
      rg -n 'manipulate_caps_lock_led' home/dot_config/private_karabiner
    python3 -c 'import json,sys
config = json.load(open(sys.argv[1]))
open(sys.argv[2], "w").write(json.dumps(config, indent=4, sort_keys=True) + "\n")' \
      "$karabiner_fixture/seeded.json" "$karabiner_fixture/app-format.json"
    /bin/bash home/dot_config/private_karabiner/modify_karabiner.json \
      <"$karabiner_fixture/app-format.json" >"$karabiner_fixture/app-format-out.json" \
      || fail "karabiner modify failed on an app-formatted config"
    cmp -s "$karabiner_fixture/app-format.json" "$karabiner_fixture/app-format-out.json" \
      || fail "karabiner modify must pass an already-settled app-formatted config through byte-for-byte"
    # A rule the user added themselves — even one Karabiner appended AFTER the
    # Groundwork rule — must survive byte-for-byte and keep its position.
    python3 -c 'import json,sys
config = json.load(open(sys.argv[1]))
profile = next(p for p in config["profiles"] if p.get("selected")) if any(p.get("selected") for p in config["profiles"]) else config["profiles"][0]
profile["complex_modifications"]["rules"].append({"description": "user rule", "manipulators": []})
open(sys.argv[2], "w").write(json.dumps(config, indent=4, sort_keys=True) + "\n")' \
      "$karabiner_fixture/seeded.json" "$karabiner_fixture/user-rule.json"
    /bin/bash home/dot_config/private_karabiner/modify_karabiner.json \
      <"$karabiner_fixture/user-rule.json" >"$karabiner_fixture/user-rule-out.json" \
      || fail "karabiner modify failed on a config with a user rule"
    cmp -s "$karabiner_fixture/user-rule.json" "$karabiner_fixture/user-rule-out.json" \
      || fail "karabiner modify must preserve user rules byte-for-byte, in position"
    # A corrupt existing file must FAIL the merge, never be silently replaced.
    printf 'not json {' >"$karabiner_fixture/corrupt.json"
    if /bin/bash home/dot_config/private_karabiner/modify_karabiner.json \
      <"$karabiner_fixture/corrupt.json" >/dev/null 2>&1; then
      fail "karabiner modify must refuse (exit nonzero) on a corrupt existing file"
    fi
  fi
  test -f home/dot_local/bin/executable_groundwork-apps-start
  test -x home/dot_local/bin/executable_groundwork-apps-start
  grep -qF 'groundwork-apps-start' home/run_onchange_after_10-brew-bundle.sh.tmpl
  grep -qF 'groundwork-apps-start' home/dot_local/bin/executable_groundwork-update-run.tmpl
  # Every always-on app stays in the relaunch guard; Homebrew quits them on
  # cask upgrades and never brings them back.
  for always_on_app in Karabiner-Elements Raycast BetterDisplay Anybox; do
    grep -qF "start_app \"$always_on_app\"" home/dot_local/bin/executable_groundwork-apps-start \
      || {
        echo "groundwork-apps-start must relaunch $always_on_app" >&2
        exit 1
      }
  done
  grep -qxF '.local/bin/groundwork-karabiner-start' home/.chezmoiremove
  # update-all is a stable disk-backed launcher that syncs and then execs the
  # freshly applied runner; .zshrc must never regain a substantive in-memory
  # implementation, and the launcher must never regain update stages.
  test -x home/dot_local/bin/executable_update-all
  test -x home/dot_local/bin/executable_groundwork-update-run.tmpl
  grep -qF 'chezmoi update --apply=false' home/dot_local/bin/executable_update-all
  grep -qF 'chezmoi init' home/dot_local/bin/executable_update-all
  # shellcheck disable=SC2016 # Match literal launcher source; these variables belong to that file.
  grep -qF 'exec "$runner" "${forward_args[@]}"' home/dot_local/bin/executable_update-all
  assert_no_matches "update stages leaked into the stable update-all launcher" \
    rg -n 'brew upgrade|mise upgrade|groundwork-brew-update' home/dot_local/bin/executable_update-all
  # Reconfigure-vs-regenerate UX: the launcher runs the source-branch preflight
  # helper before git pull, and nudges (never prompts) to groundwork-configure
  # after the config regenerates. See specs/interactive-cli-and-chezmoi-interview.
  grep -qF 'groundwork-source-preflight' home/dot_local/bin/executable_update-all \
    || fail "update-all must run the groundwork-source-preflight helper before syncing"
  grep -qF 'To review or change a setting: groundwork-configure' home/dot_local/bin/executable_update-all \
    || fail "update-all must nudge to groundwork-configure after config regeneration"
  # A question the interview SKIPS on this platform must still carry its stored
  # answer through regeneration. A stored machine baseline and mutable preference
  # must survive even where bootstrap no longer asks them; `update-all` regenerates
  # on every refresh, so a missing carry-forward would discard a recorded answer.
  # Prove the result by rendering rather than only reading the template.
  interview_in="$out_dir/interview-stored.toml"
  interview_out="$out_dir/interview-rendered.toml"
  cat >"$interview_in" <<EOF
sourceDir = "$repo/home"
[data]
    beta = true
    code_dir = "~/code"
    email_personal = "t@example.com"
    email_work = ""
    game_dev = false
    headless = true
    install_chrome = false
    key_repeat = "standard"
    name = "Test"
    obsidian_vault_name = "v"
    password_manager = "none"
    profile_preset = "personal-preview"
    terminal_multiplexer = "tmux"
    reset_existing_configs = false
    signingkey = ""
    work = false
    xcode = true
EOF
  chezmoi --config "$interview_in" --source "$repo/home" \
    --persistent-state "$out_dir/interview-state.boltdb" --cache "$out_dir/interview-cache" \
    init --config-path "$interview_out" </dev/null \
    || fail "the chezmoi interview could not regenerate a stored config"
  grep -qF 'profile_preset = "personal-preview"' "$interview_out" \
    || fail "a stored profile_preset was discarded when the interview skipped its question"
  grep -qF 'release_posture = "preview"' "$interview_out" \
    || fail "when independent posture is absent, the preserved bootstrap seed must supply its migration default"
  grep -qF 'key_repeat = "standard"' "$interview_out" \
    || fail "a stored key_repeat was discarded when the interview skipped its question"
  grep -qF 'beta = true' "$interview_out" \
    || fail "a stored Xcode beta preference was discarded during regeneration"
  grep -qF 'install_chrome = false' "$interview_out" \
    || fail "the obsolete install_chrome field must survive regeneration as ignored compatibility input"
  grep -qF 'terminal_multiplexer = "tmux"' "$interview_out" \
    || fail "a stored terminal multiplexer selection was discarded during regeneration"
  # ...and a config that never answered still takes the documented default.
  interview_fresh_in="$out_dir/interview-fresh.toml"
  interview_fresh_out="$out_dir/interview-fresh-rendered.toml"
  grep -vE 'profile_preset|key_repeat|beta|terminal_multiplexer' "$interview_in" >"$interview_fresh_in"
  chezmoi --config "$interview_fresh_in" --source "$repo/home" \
    --persistent-state "$out_dir/interview-fresh-state.boltdb" --cache "$out_dir/interview-fresh-cache" \
    init --no-tty --promptDefaults --config-path "$interview_fresh_out" </dev/null \
    || fail "the chezmoi interview could not regenerate a config with no stored preset"
  grep -qF 'profile_preset = "personal-current"' "$interview_fresh_out" \
    || fail "an unanswered profile_preset must fall back to the documented default"
  grep -qF 'key_repeat = "fast"' "$interview_fresh_out" \
    || fail "an unanswered key_repeat must fall back to the documented default"
  grep -qF 'beta = false' "$interview_fresh_out" \
    || fail "a fresh install must default the mutable Xcode beta preference to false"
  grep -qF 'terminal_multiplexer = "herdr"' "$interview_fresh_out" \
    || fail "a fresh install must recommend Herdr while preserving an explicit choice"
  # A real older Groundwork config has profile_preset but predates the new
  # multiplexer field. It must migrate silently to its established tmux
  # workflow instead of taking the fresh-install recommendation.
  interview_legacy_in="$out_dir/interview-legacy.toml"
  interview_legacy_out="$out_dir/interview-legacy-rendered.toml"
  grep -v 'terminal_multiplexer' "$interview_in" >"$interview_legacy_in"
  chezmoi --config "$interview_legacy_in" --source "$repo/home" \
    --persistent-state "$out_dir/interview-legacy-state.boltdb" --cache "$out_dir/interview-legacy-cache" \
    init --config-path "$interview_legacy_out" </dev/null \
    || fail "the chezmoi interview could not migrate a pre-multiplexer config"
  grep -qF 'terminal_multiplexer = "tmux"' "$interview_legacy_out" \
    || fail "a pre-field stored config must retain the established tmux workflow"
  # groundwork-configure offers every mutable field on every platform, which is
  # honest because the template preserves stored answers that bootstrap does not ask.
  # If that preservation is ever removed, the editor starts printing "Proposed
  # changes" receipts for values that never move — so the two are asserted
  # together, right here, rather than in separate places that can drift apart.
  grep -qE '^fields_key=\(release_posture environment_role terminal_multiplexer beta work .*\bkey_repeat\b' home/dot_local/bin/executable_groundwork-configure \
    || fail "groundwork-configure must own mutable role/release preferences and preserve existing baseline settings"
  # Role and posture are stored separately from the preset PRECISELY so they can
  # diverge (specs/environment-profiles-and-release-posture.md): a managed
  # machine may take preview posture without becoming personal. Deriving them on
  # every render silently reverted a hand-edited posture, so prove independence.
  interview_role_in="$out_dir/interview-role.toml"
  interview_role_out="$out_dir/interview-role-rendered.toml"
  sed 's/profile_preset = "personal-preview"/profile_preset = "work-managed"/' "$interview_in" >"$interview_role_in"
  printf '    environment_role = "managed"\n    release_posture = "preview"\n' >>"$interview_role_in"
  chezmoi --config "$interview_role_in" --source "$repo/home" \
    --persistent-state "$out_dir/interview-role-state.boltdb" --cache "$out_dir/interview-role-cache" \
    init --config-path "$interview_role_out" </dev/null \
    || fail "the chezmoi interview could not regenerate a divergent role/posture config"
  grep -qF 'environment_role = "managed"' "$interview_role_out" \
    || fail "a stored environment_role must survive regeneration, not be re-derived from the preset"
  grep -qF 'release_posture = "preview"' "$interview_role_out" \
    || fail "a stored release_posture must survive regeneration so it can diverge from the preset"
  interview_posture_in="$out_dir/interview-posture.toml"
  interview_posture_out="$out_dir/interview-posture-rendered.toml"
  cp "$interview_in" "$interview_posture_in"
  printf '    environment_role = "personal"\n    release_posture = "current"\n' >>"$interview_posture_in"
  chezmoi --config "$interview_posture_in" --source "$repo/home" \
    --persistent-state "$out_dir/interview-posture-state.boltdb" --cache "$out_dir/interview-posture-cache" \
    init --config-path "$interview_posture_out" </dev/null \
    || fail "the chezmoi interview could not regenerate an independently current posture"
  grep -qF 'profile_preset = "personal-preview"' "$interview_posture_out" \
    || fail "regeneration rewrote the historical bootstrap seed"
  grep -qF 'release_posture = "current"' "$interview_posture_out" \
    || fail "regeneration re-derived an independently stored current posture from the preview seed"
  # ...and with no stored role/posture the preset still seeds both.
  grep -qF 'environment_role = "personal"' "$interview_out" \
    || fail "an unstored environment_role must be seeded from the preset"
  # groundwork-profile must not send a posture-only change through the preset:
  # that would move environment_role too and turn a managed machine personal.
  assert_no_matches "groundwork-profile must not route a posture change through profile_preset" \
    rg -n 'Environment profile  ->|set profile_preset' home/dot_local/bin/executable_groundwork-profile.tmpl
  assert_no_matches "groundwork-profile must not tell users to set release_posture through a promptChoice that does not exist" \
    rg -n 'promptChoice release_posture' home/dot_local/bin/executable_groundwork-profile.tmpl
  # Source-level guard intentionally matches the literal variable reference.
  # shellcheck disable=SC2016
  grep -qF 'exec "$configure_command" --release-posture "$argument"' home/dot_local/bin/executable_groundwork-profile.tmpl \
    || fail "groundwork-profile set must delegate to the canonical managed settings helper"
  notice_current="$out_dir/release-posture-notice-current"
  notice_preview="$out_dir/release-posture-notice-preview"
  notice_xcode_beta="$out_dir/release-posture-notice-xcode-beta"
  render darwin false arm64 home/run_once_after_96-release-posture-notice.sh.tmpl "$notice_current" \
    false false false false none personal-current personal current
  render darwin false arm64 home/run_once_after_96-release-posture-notice.sh.tmpl "$notice_preview" \
    false false false false none personal-preview personal preview
  render darwin false arm64 home/run_once_after_96-release-posture-notice.sh.tmpl "$notice_xcode_beta" \
    false true true false none personal-current personal current
  bash -n "$notice_current" || fail "the rendered current release-posture notice must be valid bash"
  bash -n "$notice_preview" || fail "the rendered preview release-posture notice must be valid bash"
  bash -n "$notice_xcode_beta" || fail "the rendered Xcode beta notice must be valid bash"
  grep -qF 'groundwork-configure' "$notice_current" \
    || fail "the one-time release-posture notice must point to groundwork-configure"
  grep -qF 'Current release posture:' "$notice_current" \
    || fail "the one-time release-posture notice must label the current posture"
  grep -qF 'stable' "$notice_current" \
    || fail "the one-time release-posture notice must report a current posture as stable"
  grep -qF 'Your existing preview preference was preserved.' "$notice_preview" \
    || fail "the one-time release-posture notice must preserve and report an existing preview posture"
  grep -qF 'Xcode beta channel: enabled' "$notice_xcode_beta" \
    || fail "the one-time notice must report an enabled Xcode beta preference"
  commands_file="$PWD/home/dot_local/share/groundwork/commands.tsv"
  help_bin="$PWD/home/dot_local/bin/executable_groundwork-help"
  for release_query in beta preview; do
    help_out="$(GROUNDWORK_COMMANDS="$commands_file" /bin/bash "$help_bin" "$release_query")" \
      || fail "groundwork-help $release_query must succeed"
    grep -qF 'groundwork-configure' <<<"$help_out" \
      || fail "groundwork-help $release_query must route mutable preferences to groundwork-configure"
  done
  assert_no_matches "update-all must never prompt or launch a settings interview" \
    rg -n 'change settings now|read -[a-z]* .*groundwork-configure|exec .*groundwork-configure' home/dot_local/bin/executable_update-all
  grep -qF "\"\$HOME/.local/bin/groundwork-brew-update\"" home/dot_local/bin/executable_groundwork-update-run.tmpl
  assert_no_matches "substantive update-all shell function returned" rg -n '^update-all\(\) \{' home/dot_zshrc.tmpl
  grep -qF $'daily\tupdate-all\tcommand\t' home/dot_local/share/groundwork/commands.tsv
  test -f home/run_once_before_07-update-all-command-migration.sh
  test -f home/run_after_98-update-all-migration-reminder.sh
  test -x home/dot_local/bin/executable_groundwork-cleanup
