  # The safe lane must never silently fall back when a checksum check fails:
  # every macOS `brew upgrade` invocation — including the post-repair retry —
  # must carry --require-sha. Capturing status with `|| upgrade_status=$?` is
  # fine; a flagless retry is the bypass this exists to block.
  # Command position only (optionally after env assignments): prose in error
  # messages may mention `brew upgrade <formula>` without being the cask lane.
  flagless_upgrade="$(grep -nE '^[[:space:]]*([A-Z_]+=[^[:space:]]*[[:space:]]+)*brew upgrade --cask' "$out_dir/darwin-beta/update-run" | grep -v -- '--require-sha' || true)"
