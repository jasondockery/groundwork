    "$adoption_fixture/homebrew-inventory-failed"
  if env "${adoption_env[@]}" ADOPT_RUNNING=1 \
    /bin/bash home/dot_local/bin/executable_groundwork-app-adopt --yes chatgpt \
    >"$adoption_fixture/running" 2>&1; then
    fail "groundwork-app-adopt changed ownership while the app was running"
  fi
  rm -f "$adoption_home/.adopt-plutil-count" "$adoption_home/.adopt-ps-count"
  : >"$adoption_fixture/commands.log"
  env "${adoption_env[@]}" \
    /bin/bash home/dot_local/bin/executable_groundwork-app-adopt --check chatgpt \
    >"$adoption_fixture/check-only"
  grep -qF 'ready for a separate consent-gated adoption' \
    "$adoption_fixture/check-only" \
    || fail "groundwork-app-adopt --check did not report its nonmutating result"
  assert_not_contains '^brew install' "$adoption_fixture/commands.log" \
    "groundwork-app-adopt --check reached mutation"

  : >"$adoption_fixture/commands.log"
  if env "${adoption_env[@]}" ADOPT_TEAM_ID=HOSTILETEAM \
    /bin/bash home/dot_local/bin/executable_groundwork-app-adopt --yes chatgpt \
