#!/usr/bin/env python3
"""Dependency-free static quality gate for Groundwork's committed docs."""

from __future__ import annotations

import argparse
import html
from html.parser import HTMLParser
import pathlib
import re
import sys


SITE_MARKER = 'property="og:site_name" content="Groundwork"'
MAX_SITE_PAGES = 100
MAX_PAGE_BYTES = 96 * 1024
MAX_TOTAL_HTML_BYTES = 1536 * 1024
MAX_STYLE_BYTES = 32 * 1024
MAX_SCRIPT_BYTES = 10 * 1024
VAGUE_LINKS = {"click here", "here", "learn more", "more", "read more"}


class PageAudit(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.html_attrs: dict[str, str] = {}
        self.main_count = 0
        self.h1_count = 0
        self.site_nav_count = 0
        self.nav_group_sections = 0
        self.nav_group_headings = 0
        self.nav_toggles: list[dict[str, str]] = []
        self.problems: list[str] = []
        self.anchor_stack: list[list[str]] = []

    @staticmethod
    def attrs(values: list[tuple[str, str | None]]) -> dict[str, str]:
        return {name: value or "" for name, value in values}

    def handle_starttag(self, tag: str, values: list[tuple[str, str | None]]) -> None:
        attrs = self.attrs(values)
        classes = set(attrs.get("class", "").split())
        if tag == "html":
            self.html_attrs = attrs
        elif tag == "main":
            self.main_count += 1
        elif tag == "h1":
            self.h1_count += 1
        elif tag == "nav" and "site-nav" in classes:
            self.site_nav_count += 1
            if not attrs.get("aria-label", "").strip():
                self.problems.append("documentation navigation has no accessible name")
        elif tag == "section" and "nav-group" in classes:
            self.nav_group_sections += 1
        elif tag == "h2" and "nav-heading" in classes:
            self.nav_group_headings += 1
        elif tag == "nav" and "nav-group" in classes:
            self.problems.append("navigation groups must be sections inside one named navigation")
        elif tag == "button" and "data-nav-toggle" in attrs:
            self.nav_toggles.append(attrs)
        elif tag == "img" and "alt" not in attrs:
            self.problems.append("image is missing alt text")
        elif tag == "svg" and (attrs.get("role") != "img" or not attrs.get("aria-label", "").strip()):
            self.problems.append("meaningful inline SVG needs role=img and an accessible name")
        if tag == "a":
            self.anchor_stack.append([attrs.get("href", ""), attrs.get("aria-label", ""), ""])

    def handle_startendtag(self, tag: str, values: list[tuple[str, str | None]]) -> None:
        self.handle_starttag(tag, values)

    def handle_data(self, data: str) -> None:
        if self.anchor_stack:
            self.anchor_stack[-1][2] += data

    def handle_endtag(self, tag: str) -> None:
        if tag != "a" or not self.anchor_stack:
            return
        href, aria_label, content = self.anchor_stack.pop()
        name = " ".join((aria_label or html.unescape(content)).split()).strip().lower()
        if href and not name:
            self.problems.append(f"link {href!r} has no accessible name")
        elif name in VAGUE_LINKS:
            self.problems.append(f"link {href!r} uses vague text {name!r}")


def parse_variables(block: str) -> dict[str, str]:
    return dict(re.findall(r"--([a-z0-9-]+):\s*([^;]+);", block))


def resolve_color(name: str, variables: dict[str, str], trail: tuple[str, ...] = ()) -> str:
    if name in trail:
        raise ValueError(f"cyclic CSS variable: {' -> '.join((*trail, name))}")
    value = variables.get(name, "").strip()
    reference = re.fullmatch(r"var\(--([a-z0-9-]+)\)", value)
    if reference:
        return resolve_color(reference.group(1), variables, (*trail, name))
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        raise ValueError(f"--{name} is not a resolvable six-digit color: {value!r}")
    return value


def luminance(color: str) -> float:
    channels = [int(color[index : index + 2], 16) / 255 for index in (1, 3, 5)]
    linear = [value / 12.92 if value <= 0.04045 else ((value + 0.055) / 1.055) ** 2.4 for value in channels]
    return 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2]


def contrast(left: str, right: str) -> float:
    high, low = sorted((luminance(left), luminance(right)), reverse=True)
    return (high + 0.05) / (low + 0.05)


def audit_theme(name: str, variables: dict[str, str], problems: list[str]) -> None:
    broad_text = ("text", "subtext1", "accent", "success-text", "attention-text", "info-text", "blue-text")
    broad_backgrounds = ("base", "mantle", "crust", "surface0")
    quieter_text = ("subtext0", "quiet-text")
    quieter_backgrounds = ("base", "mantle", "crust")
    for text_tokens, backgrounds in ((broad_text, broad_backgrounds), (quieter_text, quieter_backgrounds)):
        for text_token in text_tokens:
            for background in backgrounds:
                try:
                    ratio = contrast(resolve_color(text_token, variables), resolve_color(background, variables))
                except ValueError as error:
                    problems.append(f"{name}: {error}")
                    continue
                if ratio < 4.5:
                    problems.append(
                        f"{name}: --{text_token} on --{background} has {ratio:.2f}:1 contrast; expected at least 4.5:1"
                    )


def require(pattern: str, text: str, message: str, problems: list[str]) -> None:
    if not re.search(pattern, text, re.S):
        problems.append(message)


def audit(root: pathlib.Path) -> list[str]:
    docs = root / "docs"
    style_path = docs / "assets" / "style.css"
    script_path = docs / "assets" / "site.js"
    problems: list[str] = []
    if not docs.is_dir():
        return [f"docs directory is missing: {docs}"]

    pages: list[tuple[pathlib.Path, str, int]] = []
    for page in sorted(docs.glob("*.html")):
        size = page.stat().st_size
        try:
            text = page.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            problems.append(f"{page}: not valid UTF-8")
            continue
        if SITE_MARKER in text:
            pages.append((page, text, size))
    if not pages:
        problems.append("no Groundwork site pages were discovered")
    if len(pages) > MAX_SITE_PAGES:
        problems.append(f"site page count {len(pages)} exceeds {MAX_SITE_PAGES}")
    total_html = sum(size for _, _, size in pages)
    if total_html > MAX_TOTAL_HTML_BYTES:
        problems.append(f"site HTML is {total_html} bytes; budget is {MAX_TOTAL_HTML_BYTES}")

    for page, text, size in pages:
        if size > MAX_PAGE_BYTES:
            problems.append(f"{page}: {size} bytes exceeds the {MAX_PAGE_BYTES}-byte page budget")
        parser = PageAudit()
        parser.feed(text)
        parser.close()
        lang = parser.html_attrs.get("lang", "")
        direction = parser.html_attrs.get("dir", "")
        if not re.fullmatch(r"[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*", lang):
            problems.append(f"{page}: html lang is not a BCP 47-shaped language tag")
        if direction not in {"ltr", "rtl"}:
            problems.append(f"{page}: html dir must be ltr or rtl")
        if parser.main_count != 1:
            problems.append(f"{page}: expected one main landmark, found {parser.main_count}")
        if parser.h1_count != 1:
            problems.append(f"{page}: expected one h1, found {parser.h1_count}")
        if parser.site_nav_count != 1:
            problems.append(f"{page}: expected one named documentation nav, found {parser.site_nav_count}")
        if parser.nav_group_sections != 9:
            problems.append(f"{page}: expected nine headed navigation groups, found {parser.nav_group_sections}")
        if parser.nav_group_headings != 9:
            problems.append(f"{page}: expected nine navigation group headings, found {parser.nav_group_headings}")
        if len(parser.nav_toggles) != 2:
            problems.append(f"{page}: expected open and close navigation controls, found {len(parser.nav_toggles)}")
        for toggle in parser.nav_toggles:
            if toggle.get("aria-controls") != "site-sidebar" or toggle.get("aria-expanded") != "false":
                problems.append(f"{page}: navigation toggle state contract is incomplete")
            if not toggle.get("aria-label", "").strip():
                problems.append(f"{page}: navigation toggle has no accessible name")
        if 'class="cursor"' in text and 'class="cursor" aria-hidden="true"' not in text:
            problems.append(f"{page}: decorative hero cursor is exposed to assistive technology")
        problems.extend(f"{page}: {problem}" for problem in parser.problems)

    for asset, limit in ((style_path, MAX_STYLE_BYTES), (script_path, MAX_SCRIPT_BYTES)):
        if not asset.is_file():
            problems.append(f"required docs asset is missing: {asset}")
        elif asset.stat().st_size > limit:
            problems.append(f"{asset}: {asset.stat().st_size} bytes exceeds the {limit}-byte resource budget")
    if problems and (not style_path.is_file() or not script_path.is_file()):
        return problems

    style = style_path.read_text(encoding="utf-8")
    script = script_path.read_text(encoding="utf-8")
    root_block = re.search(r":root\s*\{(.*?)\n\}", style, re.S)
    light_block = re.search(r':root\[data-theme="light"\]\s*\{(.*?)\n\}', style, re.S)
    fallback_block = re.search(r'@media \(prefers-color-scheme: light\).*?:root:not\(\[data-theme\]\)\s*\{(.*?)\n  \}', style, re.S)
    if not root_block or not light_block or not fallback_block:
        problems.append("docs CSS must define dark and light theme token blocks")
    else:
        audit_theme("dark", parse_variables(root_block.group(1)), problems)
        light_variables = parse_variables(light_block.group(1))
        audit_theme("light", light_variables, problems)
        if parse_variables(fallback_block.group(1)) != light_variables:
            problems.append("explicit and OS-selected light themes must use identical tokens")

    required_style = {
        r"@media\s*\(prefers-reduced-motion:\s*reduce\)": "docs CSS must honor reduced motion",
        r"@media\s*\(forced-colors:\s*active\)": "docs CSS must preserve a forced-colors boundary",
        r":focus-visible\s*\{[^}]*outline": "docs CSS must expose visible keyboard focus",
        r"\.sidebar\s*\{[^}]*visibility:\s*hidden;[^}]*pointer-events:\s*none": "closed mobile sidebar must be visually and pointer hidden",
        r"\.hero \.prompt-line \.cursor\s*\{[^}]*opacity:[^}]*\}": "hero cursor must be bounded and static",
        r"\.muted\s*\{[^}]*var\(--subtext0\)": "muted text must use the measured text token",
        r"\.terminal \.comment\s*\{[^}]*var\(--quiet-text\)": "terminal comments must use the measured quiet-text token",
        r"\.stage \.when\s*\{[^}]*var\(--attention-text\)": "stage timing text must use the measured attention token",
        r"\.yourturn b\s*\{[^}]*var\(--attention-text\)": "practice labels must use the measured attention token",
        r"\.chop \.do\s*\{[^}]*var\(--attention-text\)": "action text must use the measured attention token",
        r"footer\.site\s*\{[^}]*var\(--quiet-text\)": "footer text must use the measured quiet-text token",
        r"\.nav-group span\.soon\s*\{[^}]*var\(--quiet-text\)": "soon metadata must use the measured quiet-text token",
    }
    for pattern, message in required_style.items():
        require(pattern, style, message, problems)
    if "@keyframes blink" in style or re.search(r"\.hero \.prompt-line \.cursor\s*\{[^}]*animation", style, re.S):
        problems.append("decorative hero cursor must not animate indefinitely")

    required_script = {
        r'setInert\(sidebar, true\)': "closed mobile sidebar must be inert",
        r'setUnderlayInert\(true\)': "open mobile drawer must inert underlying content",
        r'closeButton\.focus\(\)': "opening the mobile drawer must move focus inside",
        r'opener\.focus\(\)': "closing the mobile drawer must restore the exact opener",
        r'mobile\.addEventListener\("change", syncNavForViewport\)': "desktop breakpoint must clear mobile drawer state",
        r'status\.setAttribute\("role", "status"\)': "copy feedback must expose a status role",
        r'status\.setAttribute\("aria-live", "polite"\)': "copy feedback must use a polite live region",
        r'Copy failed\. Select and copy the command manually\.': "copy failure must include textual recovery",
    }
    for pattern, message in required_script.items():
        require(pattern, script, message, problems)
    if ".blur(" in script:
        problems.append("mobile navigation must restore focus, not blur it")
    return problems


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=pathlib.Path, default=pathlib.Path(__file__).resolve().parent.parent)
    arguments = parser.parse_args()
    problems = audit(arguments.root.resolve())
    if problems:
        print("Public docs quality check failed:", file=sys.stderr)
        for problem in problems:
            print(f"- {problem}", file=sys.stderr)
        return 1
    print("Public docs static quality passed: structure, language/direction, contrast tokens, interaction contracts, and resource budgets.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
