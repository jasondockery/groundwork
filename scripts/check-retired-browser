#!/usr/bin/env bash
set -euo pipefail

root="${1:-$(cd "$(dirname "$0")/.." && pwd -P)}"
[[ -d "$root" ]] || {
  echo "check-retired-browser: not a directory: $root" >&2
  exit 64
}

# Construct the retired product identifiers so this guard does not exempt
# itself from the repository-wide rule it enforces.
retired_family='ze''n'
retired_preview='tw''ilight'
pattern="(^|[^[:alnum:]_])(${retired_family}|${retired_preview}|${retired_family}-browser|${retired_family}@${retired_preview})([^[:alnum:]_]|$)"

matches=""
if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  matches="$(git -C "$root" grep -n -I -i -E "$pattern" -- . 2>/dev/null || true)"
  path_matches="$(
    git -C "$root" ls-files | while IFS= read -r tracked_path; do
      [[ -e "$root/$tracked_path" || -L "$root/$tracked_path" ]] && printf '%s\n' "$tracked_path"
    done | rg -n -i "$pattern" || true
  )"
else
  matches="$(rg --hidden -n -i -g '!.git' "$pattern" "$root" || true)"
  path_matches="$(rg --hidden --files -g '!.git' "$root" | rg -n -i "$pattern" || true)"
fi

if [[ -n "$matches" || -n "$path_matches" ]]; then
  echo "Retired browser ownership remains in tracked content or paths:" >&2
  [[ -z "$path_matches" ]] || printf '%s\n' "$path_matches" >&2
  [[ -z "$matches" ]] || printf '%s\n' "$matches" >&2
  exit 1
fi

echo "ok: retired browser casks, mappings, hooks, aliases, and guidance are absent"
