DOCS = ROOT / "docs"
CATALOG = ROOT / "home/dot_local/share/groundwork/commands.tsv"
METADATA = ROOT / "data/docs-command-surfaces.tsv"
PROFILES = ROOT / "data/render-profiles.tsv"
INVENTORY = ROOT / "data/docs-coverage.tsv"
NON_SITE_HTML = {"google6981ccb57c5e5a37.html"}
SITE_BASE = "https://jasondockery.github.io/groundwork"

