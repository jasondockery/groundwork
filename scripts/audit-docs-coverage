#!/usr/bin/env python3
"""Generate and verify Groundwork's documentation coverage inventory.

The audit derives user-facing surfaces from every profile in the shared render
matrix, joins them to explicit documentation metadata, and checks the rendered
site graph. The generated inventory is a mechanical floor; whether a page
teaches a workflow well remains a human docs-alignment review.
"""

from __future__ import annotations

