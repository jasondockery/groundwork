#!/usr/bin/env python3
"""Print an exact, content-addressed snapshot of the current Git working tree."""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

from ci_receipt import ReceiptError, tree_snapshot


def main() -> int:
    parser = argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument("--repo", default=".")
    arguments = parser.parse_args()
    try:
        snapshot = tree_snapshot(pathlib.Path(arguments.repo))
    except ReceiptError as error:
        print(f"tree-fingerprint: {error}", file=sys.stderr)
        return 1
    json.dump(snapshot, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
